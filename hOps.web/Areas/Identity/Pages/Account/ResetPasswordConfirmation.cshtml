@page
@model hOps.web.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-lg-5 text-center">
                <h1 class="h4 mb-3">@ViewData["Title"]</h1>
                <p class="text-muted">
                    Your password has been reset. You can now <a asp-page="./Login">log in</a> with your new credentials.
                </p>
            </div>
        </div>
    </div>
</div>
