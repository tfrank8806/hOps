@page
@model hOps.web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <h4>Request Access</h4>
            <hr />
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Input.FirstName"></label>
                <input asp-for="Input.FirstName" class="form-control" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.LastName"></label>
                <input asp-for="Input.LastName" class="form-control" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.MobilePhone"></label>
                <input asp-for="Input.MobilePhone" class="form-control" />
                <span asp-validation-for="Input.MobilePhone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.PropertyCode"></label>
                <input asp-for="Input.PropertyCode" class="form-control" />
                <span asp-validation-for="Input.PropertyCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <p class="alert alert-info">
                An administrator will review your request and email you a temporary password
                once your account is approved.
            </p>

            @if (Model.IsCaptchaEnabled)
            {
                <div class="form-group mb-3">
                    <div class="g-recaptcha" data-sitekey="@Model.CaptchaSiteKey"></div>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label asp-for="SimpleCaptchaAnswer"></label>
                    <div class="input-group">
                        <span class="input-group-text">@Model.SimpleCaptchaQuestion</span>
                        <input asp-for="SimpleCaptchaAnswer" class="form-control" autocomplete="off" />
                    </div>
                    <input type="hidden" asp-for="SimpleCaptchaToken" />
                    <span asp-validation-for="SimpleCaptchaAnswer" class="text-danger"></span>
                    <small class="form-text text-muted">Answer the question to confirm that you are human.</small>
                </div>
            }

            <button type="submit" class="btn btn-primary">Submit Request</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.IsCaptchaEnabled)
    {
        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    }
}
