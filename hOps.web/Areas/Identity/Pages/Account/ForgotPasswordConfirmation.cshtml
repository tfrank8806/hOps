@page
@model hOps.web.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset link sent";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-lg-5 text-center">
                <h1 class="h4 mb-3">@ViewData["Title"]</h1>
                <p class="text-muted mb-0">
                    If an account exists for the email address you provided, a password reset link is on its way.
                    Please check your inbox and follow the instructions to choose a new password.
                </p>
            </div>
        </div>
    </div>
</div>
