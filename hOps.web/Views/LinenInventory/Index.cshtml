@model hOps.web.ViewModels.Housekeeping.LinenInventory.LinenInventoryPageViewModel
@{
    ViewData["Title"] = "Linen Inventory";
}

<div class="linen-inventory-page">
    <section class="linen-section linen-section--hero">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h1 class="h3 mb-1">Linen Inventory</h1>
                <p class="text-muted mb-0">@Model.PropertyName</p>
            </div>
            <div class="text-md-end">
                <a asp-action="Setup" class="btn btn-outline-primary btn-sm mb-3">Open Setup</a>
                <div class="text-muted small">Last saved</div>
                @if (Model.LastInventoryDate.HasValue)
                {
                    <div class="fw-semibold">@Model.LastInventoryDate.Value.ToString("MMMM d, yyyy")</div>
                }
                else
                {
                    <div class="text-muted">No history yet</div>
                }
                @if (Model.LastSessionTotalCost.HasValue)
                {
                    <div class="small mt-1">
                        Last Spend: <span class="fw-semibold">$@Model.LastSessionTotalCost.Value.ToString("N2")</span>
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
        {
            <div class="alert alert-success alert-dismissible fade show mt-3 mb-0" role="alert">
                @Model.FlashMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3 mb-0" role="alert">
                @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </section>

    <section class="linen-section">
@if (Model.InventoryRows.Any())
{
    <form asp-action="SaveInventory" method="post" class="card mb-4">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h2 class="h5 mb-0">Monthly Inventory Snapshot</h2>
                <small class="text-muted">Modeled after the standard Excel workbook</small>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Save Inventory</button>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Entry.InventoryMonth" class="form-label fw-semibold">Inventory Period</label>
                    <div class="input-group">
                        <select asp-for="Entry.InventoryMonth" class="form-select" aria-label="Inventory Month">
                            @for (var month = 1; month <= 12; month++)
                            {
                                <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                            }
                        </select>
                        <select asp-for="Entry.InventoryYear" class="form-select" aria-label="Inventory Year">
                            @{
                                var currentYear = DateTime.UtcNow.Year;
                                for (var year = currentYear - 1; year <= currentYear + 1; year++)
                                {
                                    <option value="@year">@year</option>
                                }
                            }
                        </select>
                    </div>
                    <span asp-validation-for="Entry.InventoryMonth" class="text-danger small"></span>
                    <span asp-validation-for="Entry.InventoryYear" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Entry.InventoryDate" class="form-label fw-semibold">Inventory Date Recorded</label>
                    <input asp-for="Entry.InventoryDate" class="form-control" type="date" />
                    <span asp-validation-for="Entry.InventoryDate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Entry.PerformedBy" class="form-label fw-semibold">Linen Count Performed By</label>
                    <input asp-for="Entry.PerformedBy" class="form-control" maxlength="200" />
                    <span asp-validation-for="Entry.PerformedBy" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Entry.MonthlyBudget" class="form-label fw-semibold">Monthly Budget</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Entry.MonthlyBudget" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <span asp-validation-for="Entry.MonthlyBudget" class="text-danger small"></span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle inventory-entry-table">
                    <thead class="table-light">
                        <tr class="text-center align-middle">
                            <th class="text-start">Item</th>
                            <th>1 PAR<br />(In Rooms)</th>
                            <th>Laundry Clean</th>
                            <th>Laundry Dirty</th>
                            <th>In Storage</th>
                            <th>On Carts</th>
                            <th>Tot On Hand</th>
                            <th>Last Month</th>
                            <th>Variance</th>
                            <th>Budgeted PAR</th>
                            <th>Order Need</th>
                            <th>ACT / PAR</th>
                            <th># Case To Order</th>
                            <th>$ Per Case</th>
                            <th>$ Need</th>
                            <th>Item #</th>
                            <th>Cases Purchased</th>
                            <th>Order Cost</th>
                        </tr>
                    </thead>
                    <tbody id="inventoryRowsBody">
                        @for (var i = 0; i < Model.Entry.Rows.Count; i++)
                        {
                            var formRow = Model.Entry.Rows[i];
                            var meta = Model.InventoryRows.FirstOrDefault(r => r.ItemId == formRow.ItemId);
                            var budgetedPar = meta?.BudgetedPar ?? 0;
                            var caseCount = meta?.OrderCaseCount ?? 1;
                            var casePrice = meta?.OrderCasePrice ?? 0;
                            var inRooms = meta?.InRooms ?? 0;
                            <tr class="inventory-entry-row" data-row-index="@i" data-budgeted-par="@budgetedPar" data-case-count="@caseCount" data-case-price="@casePrice" data-last-month="@formRow.LastMonthActuals">
                                <td>
                                    <div class="fw-semibold">@meta?.ItemName</div>
                                    <div class="text-muted small">
                                        @if (!string.IsNullOrWhiteSpace(meta?.OrderItemNumber))
                                        {
                                            <span>Order # @meta!.OrderItemNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No item #</span>
                                        }
                                    </div>
                                    <input type="hidden" asp-for="Entry.Rows[i].ItemId" />
                                </td>
                                <td class="text-end fw-semibold">
                                    @inRooms.ToString("0.##")
                                </td>
                                <td>
                                    <input asp-for="Entry.Rows[i].LaundryClean" class="form-control form-control-sm inventory-input" type="number" min="0" step="0.01" data-field="clean" />
                                </td>
                                <td>
                                    <input asp-for="Entry.Rows[i].LaundryDirty" class="form-control form-control-sm inventory-input" type="number" min="0" step="0.01" data-field="dirty" />
                                </td>
                                <td>
                                    <input asp-for="Entry.Rows[i].InStorage" class="form-control form-control-sm inventory-input" type="number" min="0" step="0.01" data-field="storage" />
                                </td>
                                <td>
                                    <input asp-for="Entry.Rows[i].OnCarts" class="form-control form-control-sm inventory-input" type="number" min="0" step="0.01" data-field="carts" />
                                </td>
                                <td class="text-end fw-semibold">
                                    <span data-role="total-on-hand">0</span>
                                </td>
                                <td>
                                    <input asp-for="Entry.Rows[i].LastMonthActuals" class="form-control form-control-sm inventory-input" type="number" min="0" step="0.01" data-field="last-month" />
                                </td>
                                <td class="text-end">
                                    <span data-role="variance">0</span>
                                </td>
                                <td class="text-end fw-semibold">
                                    @budgetedPar.ToString("0.##")
                                </td>
                                <td class="text-end">
                                    <span data-role="order-need">0</span>
                                </td>
                                <td class="text-end">
                                    <span data-role="act-par">0</span>
                                </td>
                                <td class="text-end">
                                    <span data-role="cases-to-order">0</span>
                                </td>
                                <td class="text-end">$@casePrice.ToString("N2")</td>
                                <td class="text-end fw-semibold">
                                    <span data-role="need-cost">$0.00</span>
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(meta?.OrderItemNumber))
                                    {
                                        <span>@meta!.OrderItemNumber</span>
                                    }
                                </td>
                                <td>
                                    <input asp-for="Entry.Rows[i].CasesPurchased" class="form-control form-control-sm inventory-input" type="number" min="0" step="0.01" data-field="cases-purchased" />
                                </td>
                                <td class="text-end fw-semibold">
                                    <span data-role="order-cost">$0.00</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="14" class="text-end fw-semibold">Totals</td>
                            <td class="text-end fw-semibold" data-summary="need-cost">$0.00</td>
                            <td></td>
                            <td></td>
                            <td class="text-end fw-semibold" data-summary="order-cost">$0.00</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="row g-3 mt-3">
                <div class="col-md-4">
                    <div class="p-3 border rounded">
                        <div class="text-muted small">Projected Need</div>
                        <div class="h5 mb-0" data-summary="need-cost-display">$0.00</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 border rounded">
                        <div class="text-muted small">Order Cost (Actual)</div>
                        <div class="h5 mb-0" data-summary="order-cost-display">$0.00</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 border rounded">
                        <div class="text-muted small">Budget Variance</div>
                        <div class="h5 mb-0" data-summary="budget-variance">$0.00</div>
                        <small class="text-muted">Monthly budget: $<span data-summary="budget-amount">@((Model.Entry.MonthlyBudget ?? 0).ToString("N2"))</span></small>
                    </div>
                </div>
            </div>
        </div>
    </form>
}
else
{
    <div class="alert alert-info">
        Configure your linen items in the setup section below to unlock the inventory worksheet.
    </div>
}
    </section>

    <section class="linen-section">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h2 class="h5 mb-0">Inventory History</h2>
                <small class="text-muted">Recent monthly submissions</small>
            </div>
        </div>
        @if (!Model.HistoryEntries.Any())
        {
            <div class="alert alert-info mb-0">
                No history yet. Save your first inventory snapshot to populate this log.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Inventory Date</th>
                            <th>Performed By</th>
                            <th>Budget</th>
                            <th>Projected Need</th>
                            <th>Total Cost</th>
                            <th style="width:170px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.HistoryEntries)
                        {
                            <tr>
                                <td>@entry.DisplayLabel</td>
                                <td>@(string.IsNullOrWhiteSpace(entry.PerformedBy) ? "N/A" : entry.PerformedBy)</td>
                                <td class="text-end">$@entry.MonthlyBudget.ToString("N2")</td>
                                <td class="text-end">$@entry.ProjectedNeedCost.ToString("N2")</td>
                                <td class="text-end">$@entry.TotalCost.ToString("N2")</td>
                                <td class="text-nowrap">
                                    <a asp-action="History" asp-route-id="@entry.SessionId" class="btn btn-link btn-sm">View</a>
                                    <a asp-action="DownloadHistory" asp-route-id="@entry.SessionId" class="btn btn-outline-secondary btn-sm">Download</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/linen-inventory.js" asp-append-version="true"></script>
}
