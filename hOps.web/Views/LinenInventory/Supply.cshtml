@model hOps.web.ViewModels.Housekeeping.LinenInventory.SupplyInventoryPageViewModel
@using System.Globalization
@using System.Text.Json

@{
    ViewData["Title"] = "Supply Inventory";
    var serializerOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    var templateJson = JsonSerializer.Serialize(Model.TemplateItems, serializerOptions);
    var defaultBudget = Model.DefaultMonthlyBudget.ToString("0.##", CultureInfo.InvariantCulture);
}

@section Styles {
    <style>
        .supply-inventory-table tbody tr:nth-child(odd) {
            background-color: #f8fbff;
        }

        .supply-inventory-table tbody tr:nth-child(even) {
            background-color: #ffffff;
        }

        .supply-inventory-table tbody tr:hover {
            background-color: #eef3ff;
        }

        .supply-inventory-table tbody tr + tr td {
            border-top: 1px solid #dee2e6;
        }
    </style>
}

<div class="d-flex justify-content-between align-items-start flex-wrap mb-3">
    <div class="mb-3 mb-md-0">
        <h1 class="h3 mb-1">Supply Inventory</h1>
        <p class="text-muted mb-0">@Model.PropertyName</p>
    </div>
    <div class="text-md-end">
        <button type="button" class="btn btn-primary btn-sm me-2" data-action="add-item">Add Item</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Linen Inventory</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="h5 mb-0">Monthly Budget Overview</h2>
            <small class="text-muted">Same layout as the worksheet summary line</small>
        </div>
        <div class="text-muted small" data-role="save-status">Waiting for changes&hellip;</div>
    </div>
    <div class="card-body">
        <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-xl-4">
            <div class="col">
                <label class="form-label fw-semibold" for="monthlyBudgetInput">Monthly Budget</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number"
                           id="monthlyBudgetInput"
                           class="form-control"
                           data-role="monthly-budget"
                           min="0"
                           step="0.01"
                           value="@(Model.DefaultMonthlyBudget == 0 ? string.Empty : Model.DefaultMonthlyBudget.ToString("0.##"))" />
                </div>
                <div class="form-text">Auto-saves per property in the hOps database.</div>
            </div>
            <div class="col">
                <div class="text-muted text-uppercase small mb-1">Total Inventory Value</div>
                <div class="fw-semibold fs-3" data-role="total-inventory-value">$0.00</div>
                <div class="text-muted small">Inventory Count multiplied by Unit Price.</div>
            </div>
            <div class="col">
                <div class="text-muted text-uppercase small mb-1">Total Order Cost</div>
                <div class="fw-semibold fs-3" data-role="total-order-cost">$0.00</div>
                <div class="text-muted small">Sum of the Order Cost column.</div>
            </div>
            <div class="col">
                <div class="text-muted text-uppercase small mb-1">Variance to Budget</div>
                <div class="fw-semibold fs-3" data-role="budget-variance">$0.00</div>
                <div class="text-muted small">Budget minus Total Order Cost.</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="h5 mb-0">Supply Worksheet</h2>
            <small class="text-muted">Columns mirror Inventory Count &rarr; Order Cost</small>
        </div>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="text-muted small" data-role="item-count">@Model.TemplateItems.Count item(s)</span>
            <button type="button" class="btn btn-outline-primary btn-sm" data-action="save-history">
                Save Snapshot
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="reset-template">
                Reset to Template
            </button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0 supply-inventory-table">
            <thead class="table-light align-middle text-center">
                <tr>
                    <th scope="col">Inventory<br />Count</th>
                    <th scope="col" class="text-start">Item</th>
                    <th scope="col" class="text-start">Description</th>
                    <th scope="col" class="text-start">Part Number</th>
                    <th scope="col">Unit Price</th>
                    <th scope="col">Inventory Value</th>
                    <th scope="col">Qty / Case</th>
                    <th scope="col">Order Case Count</th>
                    <th scope="col">Order Cost</th>
                    <th scope="col" class="text-start">Actions</th>
                </tr>
            </thead>
            <tbody id="supplyInventoryRows"></tbody>
        </table>
    </div>
</div>

<div class="card mt-4" data-role="history-card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="h5 mb-0">Snapshot History</h2>
            <small class="text-muted">Save versions to the server and reload them anytime</small>
        </div>
        <small class="text-muted">Snapshots are scoped to @Model.PropertyName and available anywhere you sign in.</small>
    </div>
    <div class="card-body">
        <div class="alert alert-info mb-0" data-role="history-empty">
            No history yet. Save your first supply snapshot to populate this log.
        </div>
        <div class="table-responsive d-none" data-role="history-table-wrapper">
            <table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Saved On</th>
                        <th class="text-end">Monthly Budget</th>
                        <th class="text-end">Inventory Value</th>
                        <th class="text-end">Order Cost</th>
                        <th style="width:160px;">Actions</th>
                    </tr>
                </thead>
                <tbody data-role="history-rows"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="supplyInventoryAntiforgery" class="d-none">
    @Html.AntiForgeryToken()
</div>

@section Scripts {
    <script>
        window.supplyInventoryConfig = {
            propertyId: @Model.PropertyId,
            defaultBudget: parseFloat("@defaultBudget") || 0,
            templateItems: @Html.Raw(templateJson),
            endpoints: {
                load: '@Url.Action("GetSupplyInventoryState", "LinenInventory")',
                save: '@Url.Action("SaveSupplyInventoryState", "LinenInventory")',
                snapshot: '@Url.Action("SaveSupplyInventorySnapshot", "LinenInventory")',
                deleteSnapshot: '@Url.Action("DeleteSupplyInventorySnapshot", "LinenInventory")'
            }
        };
    </script>
    <script src="~/js/supply-inventory.js" asp-append-version="true"></script>
}
