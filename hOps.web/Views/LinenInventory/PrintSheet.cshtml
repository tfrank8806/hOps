@model hOps.web.ViewModels.Housekeeping.LinenInventory.LinenInventoryPrintSheetViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Linen Count Sheet";
}

<div class="linen-inventory-page">
    <section class="linen-section">
        <div class="d-flex justify-content-between align-items-start flex-wrap mb-3">
            <div>
                <h1 class="h4 mb-1">Linen Count Sheet</h1>
                <p class="text-muted mb-0">@Model.PropertyName</p>
            </div>
            <div class="text-md-end">
                <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">Print</button>
                <a asp-action="Index" class="btn btn-link btn-sm">Back to Inventory</a>
            </div>
        </div>
        <p class="text-muted mb-4">
            Use this printable sheet to collect counts before entering them into the system. Fill in the columns and return to the inventory page to submit.
        </p>

        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead class="table-light">
                    <tr class="text-center">
                        <th class="text-start" style="min-width:220px;">Item</th>
                        <th style="width:150px;">Laundry Clean</th>
                        <th style="width:150px;">Laundry Dirty</th>
                        <th style="width:150px;">In Storage</th>
                        <th style="width:150px;">On Carts</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.ItemName</div>
                                @if (!string.IsNullOrWhiteSpace(item.OrderItemNumber))
                                {
                                    <div class="text-muted small">Order # @item.OrderItemNumber</div>
                                }
                            </td>
                            <td class="text-center align-middle"><span class="count-blank"></span></td>
                            <td class="text-center align-middle"><span class="count-blank"></span></td>
                            <td class="text-center align-middle"><span class="count-blank"></span></td>
                            <td class="text-center align-middle"><span class="count-blank"></span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<style>
    @@media print {
        body {
            background: #fff;
        }

        .linen-inventory-page,
        .linen-section,
        .table {
            box-shadow: none !important;
            border: none !important;
        }

        .btn,
        nav,
        header,
        footer {
            display: none !important;
        }
    }

    .count-blank {
        display: block;
        width: 100%;
        min-height: 32px;
        border-bottom: 1px solid #6c757d;
    }
</style>
