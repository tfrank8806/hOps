@model hOps.web.ViewModels.Housekeeping.LinenInventory.LinenInventoryHistoryDetailViewModel
@{
    ViewData["Title"] = "Inventory History";
}

<div class="linen-inventory-page">
    <section class="linen-section linen-section--hero">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h1 class="h4 mb-1">Inventory Snapshot</h1>
                <p class="text-muted mb-0">@Model.PropertyName &middot; @Model.InventoryDate.ToString("MMMM d, yyyy")</p>
            </div>
            <div class="text-md-end">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">Back to Inventory</a>
                <div>
                    <a asp-action="DownloadHistory" asp-route-id="@Model.SessionId" class="btn btn-primary btn-sm">
                        Download Excel
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="linen-section">
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="p-3 border rounded bg-white">
                    <div class="text-muted small">Performed By</div>
                    <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.PerformedBy) ? Model.PerformedBy : "N/A")</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 border rounded bg-white">
                    <div class="text-muted small">Monthly Budget</div>
                    <div class="fw-semibold">$@Model.MonthlyBudget.ToString("N2")</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 border rounded bg-white">
                    <div class="text-muted small">Projected Need</div>
                    <div class="fw-semibold">$@Model.ProjectedNeedCost.ToString("N2")</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 border rounded bg-white">
                    <div class="text-muted small">Total Cost</div>
                    <div class="fw-semibold">$@Model.TotalCost.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead class="table-light">
                    <tr class="text-center">
                        <th class="text-start">Item</th>
                        <th>Item #</th>
                        <th>Laundry Clean</th>
                        <th>Laundry Dirty</th>
                        <th>In Storage</th>
                        <th>On Carts</th>
                        <th>Total On Hand</th>
                        <th>Last Month</th>
                        <th>Budgeted PAR</th>
                        <th>Order Need</th>
                        <th>Cases To Order</th>
                        <th>Need Cost</th>
                        <th>Cases Purchased</th>
                        <th>Order Cost</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Items)
                    {
                        <tr class="text-end">
                            <td class="text-start">
                                <div class="fw-semibold">@row.ItemName</div>
                            </td>
                            <td class="text-start">@row.ItemNumber</td>
                            <td>@row.LaundryClean.ToString("N2")</td>
                            <td>@row.LaundryDirty.ToString("N2")</td>
                            <td>@row.InStorage.ToString("N2")</td>
                            <td>@row.OnCarts.ToString("N2")</td>
                            <td>@row.TotalOnHand.ToString("N2")</td>
                            <td>@row.LastMonthActuals.ToString("N2")</td>
                            <td>@row.BudgetedPar.ToString("N2")</td>
                            <td>@row.OrderRecommendation.ToString("N2")</td>
                            <td>@row.CasesToOrder.ToString("N2")</td>
                            <td>$@row.NeedCost.ToString("N2")</td>
                            <td>@row.CasesPurchased.ToString("N2")</td>
                            <td>$@row.OrderCost.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
