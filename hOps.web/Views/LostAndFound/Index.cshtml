@using System
@using System.Linq
@using hOps.web.Models
@using hOps.web.Utilities
@model LostAndFoundIndexViewModel

@{
    Func<LostFoundStatus, string> statusBadge = status => status switch
    {
        LostFoundStatus.ReturnedToGuest => "bg-success",
        LostFoundStatus.DisposedOf => "bg-danger",
        _ => "bg-secondary"
    };
    Func<LostFoundEntry, string> matchLabel = entry =>
    {
        if (entry == null)
        {
            return string.Empty;
        }

        if (entry.MatchedEntry != null)
        {
            return entry.MatchedEntry.Type == LostFoundType.Found
                ? (!string.IsNullOrWhiteSpace(entry.MatchedEntry.ItemFound)
                    ? entry.MatchedEntry.ItemFound
                    : $"Found Entry #{entry.MatchedEntry.Id}")
                : (!string.IsNullOrWhiteSpace(entry.MatchedEntry.ItemLost)
                    ? entry.MatchedEntry.ItemLost
                    : $"Lost Entry #{entry.MatchedEntry.Id}");
        }

        return entry.MatchedEntryId.HasValue
            ? $"Entry #{entry.MatchedEntryId}"
            : string.Empty;
    };
}
@{
    ViewData["Title"] = "Lost & Found Log";
    ViewData["MainContainerClass"] = "main-inner--wide lost-found-container";
    var hasActiveFilters =
        !string.Equals(Model.Filters.SortOrder, "newest", StringComparison.OrdinalIgnoreCase) ||
        Model.Filters.DateFrom.HasValue ||
        Model.Filters.DateTo.HasValue ||
        !string.IsNullOrWhiteSpace(Model.Filters.RoomNumber) ||
        !string.IsNullOrWhiteSpace(Model.Filters.GuestName) ||
        !string.IsNullOrWhiteSpace(Model.Filters.FoundBy) ||
        !string.IsNullOrWhiteSpace(Model.Filters.Creator) ||
        !string.IsNullOrWhiteSpace(Model.Filters.Keyword) ||
        Model.Filters.PropertyIds.Count > 0 ||
        Model.Filters.Statuses.Count > 0;
    var actionOptions = Enum.GetValues(typeof(LostFoundStatus)).Cast<LostFoundStatus>().ToList();
    var isAdmin = User.IsInRole("Admin");
}

<div class="lost-found-page d-flex flex-column flex-grow-1">
    <h1 class="mb-4">Lost &amp; Found Log</h1>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 lost-found-entry-card">
        <div class="card-header bg-light fw-semibold">Log Lost &amp; Found Entry</div>
        <div class="card-body py-3">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row g-2 g-lg-3">
                    <div class="col-sm-6 col-lg-3">
                        <label asp-for="Submission.Type" class="form-label">Type</label>
                        <select asp-for="Submission.Type" class="form-select" id="entryType">
                            <option value="@LostFoundType.Found">Found</option>
                            <option value="@LostFoundType.Lost">Lost</option>
                        </select>
                    </div>

                    @if (!Model.ShowPropertySelection && Model.AccessibleProperties.Count == 1)
                    {
                        <input type="hidden" name="Submission.SelectedPropertyIds" value="@Model.AccessibleProperties.First().Id" />
                    }
                    else
                    {
                        <div class="col-12">
                            <label class="form-label" for="propertySelection">Property</label>
                            <select
                                class="form-select"
                                id="propertySelection"
                                name="Submission.SelectedPropertyIds"
                                multiple
                                size="@(Math.Min(Model.AccessibleProperties.Count, 8))">
                                @foreach (var property in Model.AccessibleProperties)
                                {
                                    var isSelected = Model.Submission.SelectedPropertyIds?.Contains(property.Id) ?? false;
                                    if (isSelected)
                                    {
                                        <option value="@property.Id" selected>@property.Name (@property.Code)</option>
                                    }
                                    else
                                    {
                                        <option value="@property.Id">@property.Name (@property.Code)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Submission.SelectedPropertyIds" class="text-danger"></span>
                        </div>
                    }

                    <div class="col-sm-6 col-lg-3 type-field type-found">
                        <label asp-for="Submission.DateFound" class="form-label">Date Found</label>
                        <input asp-for="Submission.DateFound" class="form-control" type="date" />
                        <span asp-validation-for="Submission.DateFound" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 col-lg-3 type-field type-lost">
                        <label asp-for="Submission.DateReportedLost" class="form-label">Date Reported Lost</label>
                        <input asp-for="Submission.DateReportedLost" class="form-control" type="date" />
                        <span asp-validation-for="Submission.DateReportedLost" class="text-danger"></span>
                    </div>

                    <div class="col-sm-6 col-lg-3 type-field type-found">
                        <label asp-for="Submission.FoundBy" class="form-label">Found By</label>
                        <input asp-for="Submission.FoundBy" class="form-control" list="foundByOptions" />
                    </div>

                    <div class="col-sm-6 col-lg-3 type-field type-lost">
                        <label asp-for="Submission.GuestName" class="form-label">Guest Name</label>
                        <input asp-for="Submission.GuestName" class="form-control" />
                    </div>
                    <div class="col-sm-6 col-lg-3 type-field type-lost">
                        <label asp-for="Submission.GuestEmail" class="form-label">Guest Email</label>
                        <input asp-for="Submission.GuestEmail" class="form-control" type="email" />
                        <span asp-validation-for="Submission.GuestEmail" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 col-lg-3 type-field type-lost">
                        <label asp-for="Submission.GuestPhone" class="form-label">Guest Phone</label>
                        <input asp-for="Submission.GuestPhone" class="form-control" />
                    </div>
                    <div class="col-sm-6 col-lg-4 type-field type-lost">
                        <label asp-for="Submission.GuestAddress" class="form-label">Guest Address</label>
                        <input asp-for="Submission.GuestAddress" class="form-control" />
                    </div>

                    <div class="col-sm-6 col-lg-4">
                        <label asp-for="Submission.Location" class="form-label">Location</label>
                        <input asp-for="Submission.Location" class="form-control" list="locationOptions" />
                    </div>

                    <div class="col-sm-6 col-lg-4 type-field type-found">
                        <label asp-for="Submission.ItemFound" class="form-label">Item Found</label>
                        <input asp-for="Submission.ItemFound" class="form-control" />
                        <span asp-validation-for="Submission.ItemFound" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 col-lg-4 type-field type-lost">
                        <label asp-for="Submission.ItemLost" class="form-label">Item Lost</label>
                        <input asp-for="Submission.ItemLost" class="form-control" />
                        <span asp-validation-for="Submission.ItemLost" class="text-danger"></span>
                    </div>

                    <div class="col-sm-6 col-lg-3 type-field type-found">
                        <label asp-for="Submission.Stored" class="form-label">Stored</label>
                        <input asp-for="Submission.Stored" class="form-control" placeholder="Storage location" />
                    </div>

                    <div class="col-lg-6">
                        <label asp-for="Submission.Notes" class="form-label">Notes</label>
                        <textarea asp-for="Submission.Notes" class="form-control" rows="2" data-enable-mentions="true"></textarea>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <label asp-for="Submission.Photo" class="form-label">Photo</label>
                        <input asp-for="Submission.Photo" class="form-control" type="file" accept="image/*" />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">Save Entry</button>
                </div>
            </form>
        </div>
    </div>

    <datalist id="locationOptions">
        @foreach (var option in Model.LocationOptions)
        {
            <option value="@option"></option>
        }
    </datalist>

    <datalist id="foundByOptions">
        @foreach (var option in Model.FoundByOptions)
        {
            <option value="@option"></option>
        }
    </datalist>

    <datalist id="creatorOptions">
        @foreach (var option in Model.CreatorOptions)
        {
            <option value="@option"></option>
        }
    </datalist>

    <div class="card mb-4">
        <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
            <span>Filter Entries</span>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filtersCollapse" aria-expanded="false" aria-controls="filtersCollapse">
                @(hasActiveFilters ? "Show Filters (Active)" : "Show Filters")
            </button>
        </div>
        <div id="filtersCollapse" class="collapse">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label" for="sortOrder">Sort</label>
                        <select id="sortOrder" name="SortOrder" class="form-select">
                            <option value="newest" selected="@(Model.Filters.SortOrder?.Equals("newest", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">Newest</option>
                            <option value="oldest" selected="@(Model.Filters.SortOrder?.Equals("oldest", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">Oldest</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="dateFrom">Date From</label>
                        <input type="date" id="dateFrom" name="DateFrom" class="form-control" value="@(Model.Filters.DateFrom?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="dateTo">Date To</label>
                        <input type="date" id="dateTo" name="DateTo" class="form-control" value="@(Model.Filters.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="roomNumber">Room / Location</label>
                        <input type="text" id="roomNumber" name="RoomNumber" list="locationOptions" class="form-control" value="@Model.Filters.RoomNumber" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="guestName">Guest Name</label>
                        <input type="text" id="guestName" name="GuestName" class="form-control" value="@Model.Filters.GuestName" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="foundBy">Found By</label>
                        <input type="text" id="foundBy" name="FoundBy" list="foundByOptions" class="form-control" value="@Model.Filters.FoundBy" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="creator">Creator</label>
                        <input type="text" id="creator" name="Creator" list="creatorOptions" class="form-control" value="@Model.Filters.Creator" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="keyword">Keyword</label>
                        <input type="text" id="keyword" name="Keyword" class="form-control" value="@Model.Filters.Keyword" placeholder="Search notes, items, storage..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="statusFilter">Action</label>
                        <select id="statusFilter" name="Statuses" class="form-select" multiple size="@actionOptions.Count">
                            @foreach (var status in actionOptions)
                            {
                                var selected = Model.Filters.Statuses.Contains(status);
                                var label = status switch
                                {
                                    LostFoundStatus.ReturnedToGuest => "Returned to Guest",
                                    LostFoundStatus.DisposedOf => "Disposed of",
                                    _ => "Logged"
                                };
                                <option value="@status" selected="@(selected ? "selected" : null)">@label</option>
                            }
                        </select>
                        <div class="form-text">Use Ctrl/Cmd-click to select multiple actions.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="filterPropertyIds">Property</label>
                        <select id="filterPropertyIds"
                                name="PropertyIds"
                                class="form-select js-checkbox-multiselect"
                                multiple
                                data-placeholder="All properties"
                                data-all-label="All properties">
                            @foreach (var property in Model.AccessibleProperties)
                            {
                                var selected = Model.Filters.PropertyIds.Contains(property.Id);
                                var label = string.IsNullOrWhiteSpace(property.Code)
                                    ? property.Name
                                    : $"{property.Name} ({property.Code})";
                                <option value="@property.Id" selected="@(selected ? "selected" : null)">@label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Apply Filters</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="row g-4 lost-found-results flex-grow-1">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                    <span>Found Items (@Model.FoundEntries.Count)</span>
                </div>
                <div class="card-body">
                    @if (!Model.FoundEntries.Any())
                    {
                        <p class="text-muted mb-0">No found items logged for the selected filters.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var entry in Model.FoundEntries)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                        <div>
                                            <button class="btn btn-link p-0 text-start" type="button" data-bs-toggle="modal" data-bs-target="#entryModal-@entry.Id">
                                                <span class="fw-semibold">@(!string.IsNullOrWhiteSpace(entry.ItemFound) ? entry.ItemFound : "Found Item")</span>
                                            </button>
                                            <div class="small text-muted">
                                                @{
                                                    var createdLocal = TimeZoneService.ConvertToUserTime(entry.CreatedAt);
                                                }
                                                @(entry.DateFound?.ToString("MMM d, yyyy") ?? createdLocal.ToString("MMM d, yyyy"))
                                                @if (!string.IsNullOrWhiteSpace(entry.Location))
                                                {
                                                    <span>&nbsp;&middot; @entry.Location</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div>
                                                <span class="badge @statusBadge(entry.Status)">@entry.Status</span>
                                            </div>
                                            @if (entry.MatchedEntryId.HasValue)
                                            {
                                                <div class="small text-info mt-1">Matched to @matchLabel(entry)</div>
                                            }
                                            <div class="d-flex gap-1 flex-wrap justify-content-end mt-2">
                                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editEntryModal-@entry.Id">Edit</button>
                                                @if (entry.Status == LostFoundStatus.Logged)
                                                {
                                                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#matchEntryModal-@entry.Id">
                                                        @(entry.MatchedEntryId.HasValue ? "Update Match" : "Match")
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                    <span>Lost Items (@Model.LostEntries.Count)</span>
                </div>
                <div class="card-body">
                    @if (!Model.LostEntries.Any())
                    {
                        <p class="text-muted mb-0">No lost items logged for the selected filters.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var entry in Model.LostEntries)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                        <div>
                                            <button class="btn btn-link p-0 text-start" type="button" data-bs-toggle="modal" data-bs-target="#entryModal-@entry.Id">
                                                <span class="fw-semibold">@(!string.IsNullOrWhiteSpace(entry.ItemLost) ? entry.ItemLost : "Lost Item")</span>
                                            </button>
                                            <div class="small text-muted">
                                                @{
                                                    var createdLocal = TimeZoneService.ConvertToUserTime(entry.CreatedAt);
                                                }
                                                @(entry.DateReportedLost?.ToString("MMM d, yyyy") ?? createdLocal.ToString("MMM d, yyyy"))
                                                @if (!string.IsNullOrWhiteSpace(entry.GuestName))
                                                {
                                                    <span>&nbsp;&middot; @entry.GuestName</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div>
                                                <span class="badge @statusBadge(entry.Status)">@entry.Status</span>
                                            </div>
                                            @if (entry.MatchedEntryId.HasValue)
                                            {
                                                <div class="small text-info mt-1">Matched to @matchLabel(entry)</div>
                                            }
                                            <div class="d-flex gap-1 flex-wrap justify-content-end mt-2">
                                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editEntryModal-@entry.Id">Edit</button>
                                                @if (entry.Status == LostFoundStatus.Logged)
                                                {
                                                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#matchEntryModal-@entry.Id">
                                                        @(entry.MatchedEntryId.HasValue ? "Update Match" : "Match")
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @foreach (var entry in Model.FoundEntries.Concat(Model.LostEntries))
    {
        <div class="modal fade lost-found-modal" id="entryModal-@entry.Id" tabindex="-1" aria-labelledby="entryModalLabel-@entry.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="entryModalLabel-@entry.Id">@((entry.Type == LostFoundType.Found ? "Found" : "Lost")) Item Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <dl class="row">
                            <dt class="col-sm-4">Property</dt>
                            <dd class="col-sm-8">@entry.Property?.Name (@entry.Property?.Code)</dd>

                            <dt class="col-sm-4">Status</dt>
                            <dd class="col-sm-8">@entry.Status</dd>

                            <dt class="col-sm-4">Logged On</dt>
                            @{
                                var createdLocal = TimeZoneService.ConvertToUserTime(entry.CreatedAt);
                            }
                            <dd class="col-sm-8">@createdLocal.ToString("f")</dd>

                            <dt class="col-sm-4">Logged By</dt>
                            <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(entry.CreatedByDisplayName) ? entry.CreatedByDisplayName : entry.CreatedByUser?.Email)</dd>

                            @if (!string.IsNullOrWhiteSpace(entry.Location))
                            {
                                <dt class="col-sm-4">Location</dt>
                                <dd class="col-sm-8">@entry.Location</dd>
                            }

                            @if (entry.Type == LostFoundType.Found)
                            {
                                <dt class="col-sm-4">Date Found</dt>
                                <dd class="col-sm-8">@entry.DateFound?.ToString("D")</dd>

                                @if (!string.IsNullOrWhiteSpace(entry.FoundBy))
                                {
                                    <dt class="col-sm-4">Found By</dt>
                                    <dd class="col-sm-8">@entry.FoundBy</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.ItemFound))
                                {
                                    <dt class="col-sm-4">Item Found</dt>
                                    <dd class="col-sm-8">@entry.ItemFound</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.Stored))
                                {
                                    <dt class="col-sm-4">Stored</dt>
                                    <dd class="col-sm-8">@entry.Stored</dd>
                                }
                            }
                            else
                            {
                                <dt class="col-sm-4">Date Reported Lost</dt>
                                <dd class="col-sm-8">@entry.DateReportedLost?.ToString("D")</dd>

                                @if (!string.IsNullOrWhiteSpace(entry.GuestName))
                                {
                                    <dt class="col-sm-4">Guest Name</dt>
                                    <dd class="col-sm-8">@entry.GuestName</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.GuestPhone))
                                {
                                    <dt class="col-sm-4">Guest Phone</dt>
                                    <dd class="col-sm-8">@entry.GuestPhone</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.GuestEmail))
                                {
                                    <dt class="col-sm-4">Guest Email</dt>
                                    <dd class="col-sm-8">
                                        <a href="mailto:@entry.GuestEmail">@entry.GuestEmail</a>
                                    </dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.GuestAddress))
                                {
                                    <dt class="col-sm-4">Guest Address</dt>
                                    <dd class="col-sm-8">@entry.GuestAddress</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.ItemLost))
                                {
                                    <dt class="col-sm-4">Item Lost</dt>
                                    <dd class="col-sm-8">@entry.ItemLost</dd>
                                }
                            }

                            @if (entry.MatchedEntryId.HasValue)
                            {
                                <dt class="col-sm-4">Matched With</dt>
                                <dd class="col-sm-8">@matchLabel(entry)</dd>
                            }

                            @if (!string.IsNullOrWhiteSpace(entry.Notes))
                            {
                                <dt class="col-sm-4">Notes</dt>
                                <dd class="col-sm-8">@Html.Raw(MentionMarkupFormatter.ToHtml(entry.Notes))</dd>
                            }
                        </dl>

                        @if (!string.IsNullOrWhiteSpace(entry.PhotoPath))
                        {
                            <div class="mt-3">
                                <img src="@entry.PhotoPath" alt="Item photo" class="img-fluid rounded" />
                            </div>
                        }
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@entry.Id" />
                                <input type="hidden" name="status" value="@LostFoundStatus.ReturnedToGuest" />
                                <button type="submit" class="btn btn-outline-success btn-sm">Returned to Guest</button>
                            </form>
                            <form asp-action="UpdateStatus" method="post" class="d-inline ms-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@entry.Id" />
                                <input type="hidden" name="status" value="@LostFoundStatus.DisposedOf" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Disposed of</button>
                            </form>
                            @if (isAdmin)
                            {
                                <form asp-action="Delete" method="post" class="d-inline ms-2" onsubmit="return confirm('Delete this lost &amp; found entry?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@entry.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">Delete Entry</button>
                                </form>
                            }
                        </div>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade lost-found-modal" id="editEntryModal-@entry.Id" tabindex="-1" aria-labelledby="editEntryModalLabel-@entry.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <form asp-action="EditEntry" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@entry.Id" />
                        <div class="modal-header">
                            <h5 class="modal-title" id="editEntryModalLabel-@entry.Id">Edit @(entry.Type == LostFoundType.Found ? "Found" : "Lost") Entry</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-3">
                                @if (entry.Type == LostFoundType.Found)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label" for="edit-datefound-@entry.Id">Date Found</label>
                                        <input type="date" class="form-control" id="edit-datefound-@entry.Id" name="DateFound" value="@entry.DateFound?.ToString("yyyy-MM-dd")" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="edit-foundby-@entry.Id">Found By</label>
                                        <input type="text" class="form-control" id="edit-foundby-@entry.Id" name="FoundBy" value="@entry.FoundBy" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="edit-itemfound-@entry.Id">Item Found</label>
                                        <input type="text" class="form-control" id="edit-itemfound-@entry.Id" name="ItemFound" value="@entry.ItemFound" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="edit-stored-@entry.Id">Stored</label>
                                        <input type="text" class="form-control" id="edit-stored-@entry.Id" name="Stored" value="@entry.Stored" />
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-6">
                                        <label class="form-label" for="edit-datelost-@entry.Id">Date Reported Lost</label>
                                        <input type="date" class="form-control" id="edit-datelost-@entry.Id" name="DateReportedLost" value="@entry.DateReportedLost?.ToString("yyyy-MM-dd")" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="edit-guestname-@entry.Id">Guest Name</label>
                                        <input type="text" class="form-control" id="edit-guestname-@entry.Id" name="GuestName" value="@entry.GuestName" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="edit-guestemail-@entry.Id">Guest Email</label>
                                        <input type="email" class="form-control" id="edit-guestemail-@entry.Id" name="GuestEmail" value="@entry.GuestEmail" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="edit-guestphone-@entry.Id">Guest Phone</label>
                                        <input type="text" class="form-control" id="edit-guestphone-@entry.Id" name="GuestPhone" value="@entry.GuestPhone" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="edit-guestaddress-@entry.Id">Guest Address</label>
                                        <input type="text" class="form-control" id="edit-guestaddress-@entry.Id" name="GuestAddress" value="@entry.GuestAddress" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="edit-itemlost-@entry.Id">Item Lost</label>
                                        <input type="text" class="form-control" id="edit-itemlost-@entry.Id" name="ItemLost" value="@entry.ItemLost" />
                                    </div>
                                }
                                <div class="col-md-6">
                                    <label class="form-label" for="edit-location-@entry.Id">Location</label>
                                    <input type="text" class="form-control" id="edit-location-@entry.Id" name="Location" value="@entry.Location" />
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label" for="edit-notes-@entry.Id">Notes</label>
                                <textarea class="form-control" id="edit-notes-@entry.Id" name="Notes" rows="3" data-enable-mentions="true">@entry.Notes</textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="modal fade lost-found-modal" id="matchEntryModal-@entry.Id" tabindex="-1" aria-labelledby="matchEntryModalLabel-@entry.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="matchEntryModalLabel-@entry.Id">Match @(entry.Type == LostFoundType.Found ? "Found" : "Lost") Entry</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @if (entry.Status != LostFoundStatus.Logged)
                        {
                            <div class="alert alert-warning mb-0">Only logged entries can be matched.</div>
                        }
                        else
                        {
                            var isFoundEntry = entry.Type == LostFoundType.Found;
                            var potentialMatches = (isFoundEntry ? Model.MatchableLostEntries : Model.MatchableFoundEntries)
                                .Where(e => e.PropertyId == entry.PropertyId && (!e.MatchedEntryId.HasValue || e.MatchedEntryId == entry.Id))
                                .OrderByDescending(e => e.CreatedAt)
                                .ToList();

                            if (entry.MatchedEntryId.HasValue)
                            {
                                <div class="alert alert-info">
                                    Currently matched to <strong>@matchLabel(entry)</strong>.
                                </div>
                            }

                            if (!potentialMatches.Any())
                            {
                                <div class="alert alert-info mb-0">No @(isFoundEntry ? "lost" : "found") items are available to match for this property.</div>
                            }
                            else
                            {
                                <form asp-action="MatchEntries" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="entryId" value="@entry.Id" />
                                    <div class="mb-3">
                                        <label class="form-label" for="match-select-@entry.Id">@(isFoundEntry ? "Lost Item" : "Found Item")</label>
                                        <select class="form-select" id="match-select-@entry.Id" name="matchId" required>
                                            <option value="">Select an item</option>
                                            @foreach (var option in potentialMatches)
                                            {
                                                var description = option.Type == LostFoundType.Found
                                                    ? (!string.IsNullOrWhiteSpace(option.ItemFound) ? option.ItemFound : $"Found Entry #{option.Id}")
                                                    : (!string.IsNullOrWhiteSpace(option.ItemLost) ? option.ItemLost : $"Lost Entry #{option.Id}");
                                                var loggedAt = TimeZoneService.ConvertToUserTime(option.CreatedAt).ToString("g");
                                                <option value="@option.Id">@description (Logged @loggedAt)</option>
                                            }
                                        </select>
                                    </div>
                                    <p class="text-muted small mb-3">Matching links this entry with the selected @((isFoundEntry ? "lost" : "found")) record.</p>
                                    <button type="submit" class="btn btn-primary">Save Match</button>
                                </form>
                            }

                            @if (entry.MatchedEntryId.HasValue)
                            {
                                <form asp-action="UnmatchEntry" method="post" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@entry.Id" />
                                    <button type="submit" class="btn btn-outline-danger">Remove Match</button>
                                </form>
                            }
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const typeSelect = document.getElementById('entryType');
            const toggleFields = () => {
                const value = typeSelect.value;
                document.querySelectorAll('.type-field').forEach(el => {
                    if (value === 'Found') {
                        el.classList.toggle('d-none', el.classList.contains('type-lost'));
                    } else {
                        el.classList.toggle('d-none', el.classList.contains('type-found'));
                    }
                });
            };

            if (typeSelect) {
                typeSelect.addEventListener('change', toggleFields);
                toggleFields();
            }

            const propertySelect = document.getElementById('propertySelection');
            if (propertySelect && propertySelect.options.length > 0 && propertySelect.selectedOptions.length === 0) {
                propertySelect.options[0].selected = true;
            }

            const filterToggleButton = document.querySelector('[data-bs-target="#filtersCollapse"]');
            const filtersCollapseEl = document.getElementById('filtersCollapse');
            if (filterToggleButton && filtersCollapseEl) {
                const updateFilterButtonLabel = () => {
                    filterToggleButton.textContent = filtersCollapseEl.classList.contains('show')
                        ? 'Hide Filters'
                        : 'Show Filters';
                };

                filtersCollapseEl.addEventListener('shown.bs.collapse', updateFilterButtonLabel);
                filtersCollapseEl.addEventListener('hidden.bs.collapse', updateFilterButtonLabel);
                updateFilterButtonLabel();
            }

            document.querySelectorAll('.lost-found-modal').forEach(modalEl => {
                if (modalEl.parentElement !== document.body) {
                    document.body.appendChild(modalEl);
                }
            });
        })();
    </script>
}
