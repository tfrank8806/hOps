@model hOps.web.ViewModels.PhonebookContactFormViewModel
@{
    ViewData["Title"] = Model.Title;
}

<h1 class="h3 mb-4">@Model.Title</h1>

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@(Model.IsEdit ? Model.Contact.Id : null)" method="post">
    @if (Model.IsEdit)
    {
        <input type="hidden" asp-for="Contact.Id" />
    }
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Contact.TypeName" class="form-label"></label>
            <select asp-for="Contact.TypeName" class="form-select">
                @{ var selectedType = Model.Contact?.TypeName?.Trim(); }

                @if (Model.Types.Count == 0)
                {
                    <option value="" selected disabled>No phonebook types available</option>
                }
                else
                {
                    var hasSelection = false;

                    if (!string.IsNullOrWhiteSpace(selectedType))
                    {
                        foreach (var type in Model.Types)
                        {
                            if (string.Equals(type.Name, selectedType, System.StringComparison.OrdinalIgnoreCase))
                            {
                                hasSelection = true;
                                break;
                            }
                        }
                    }

                    if (hasSelection)
                    {
                        <option value="" disabled>Select a type</option>
                    }
                    else
                    {
                        <option value="" selected disabled>Select a type</option>
                    }

                    foreach (var type in Model.Types)
                    {
                        var isSelected = hasSelection && string.Equals(type.Name, selectedType, System.StringComparison.OrdinalIgnoreCase);

                        if (isSelected)
                        {
                            <option value="@type.Name" selected="selected">@type.Name</option>
                        }
                        else
                        {
                            <option value="@type.Name">@type.Name</option>
                        }
                    }
                }
            </select>
            @if (Model.Types.Count == 0)
            {
                <div class="form-text">No phonebook types available. Add types from the Settings &gt; Phonebook Types page.</div>
            }
            <span asp-validation-for="Contact.TypeName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.Company" class="form-label"></label>
            <input asp-for="Contact.Company" class="form-control" />
            <span asp-validation-for="Contact.Company" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.FirstName" class="form-label"></label>
            <input asp-for="Contact.FirstName" class="form-control" />
            <span asp-validation-for="Contact.FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.LastName" class="form-label"></label>
            <input asp-for="Contact.LastName" class="form-control" />
            <span asp-validation-for="Contact.LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.Title" class="form-label"></label>
            <input asp-for="Contact.Title" class="form-control" />
            <span asp-validation-for="Contact.Title" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.PhoneNumber" class="form-label"></label>
            <input asp-for="Contact.PhoneNumber" class="form-control" />
            <span asp-validation-for="Contact.PhoneNumber" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.Email" class="form-label"></label>
            <input asp-for="Contact.Email" class="form-control" />
            <span asp-validation-for="Contact.Email" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.Fax" class="form-label"></label>
            <input asp-for="Contact.Fax" class="form-control" />
            <span asp-validation-for="Contact.Fax" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.Website" class="form-label"></label>
            <input asp-for="Contact.Website" class="form-control" />
            <span asp-validation-for="Contact.Website" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Contact.Address" class="form-label"></label>
            <textarea asp-for="Contact.Address" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Contact.Address" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Contact.Notes" class="form-label"></label>
            <textarea asp-for="Contact.Notes" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Contact.Notes" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Contact</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
