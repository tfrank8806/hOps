@using System
@model hOps.web.ViewModels.PhonebookContactFormViewModel
@{
    ViewData["Title"] = Model.Title;

    string[] BuildEntries(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return new[] { string.Empty };
        }

        var parts = raw.Split(new[] { '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(v => v.Trim())
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .ToArray();

        return parts.Length > 0 ? parts : new[] { string.Empty };
    }

    var phoneEntries = BuildEntries(Model.Contact.PhoneNumber).ToList();
    var phoneTypeEntries = BuildEntries(Model.Contact.PhoneNumberTypes).ToList();
    var maxPhoneEntries = Math.Max(phoneEntries.Count, phoneTypeEntries.Count);
    if (maxPhoneEntries > phoneEntries.Count)
    {
        while (phoneEntries.Count < maxPhoneEntries)
        {
            phoneEntries.Add(string.Empty);
        }
    }
    else if (maxPhoneEntries > phoneTypeEntries.Count)
    {
        while (phoneTypeEntries.Count < maxPhoneEntries)
        {
            phoneTypeEntries.Add(string.Empty);
        }
    }
    var emailEntries = BuildEntries(Model.Contact.Email);
}

<h1 class="h3 mb-4">@Model.Title</h1>

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@(Model.IsEdit ? Model.Contact.Id : null)" method="post">
    @if (Model.IsEdit)
    {
        <input type="hidden" asp-for="Contact.Id" />
    }
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" asp-for="Contact.PhonebookTypeId"></label>
            <select asp-for="Contact.PhonebookTypeId" asp-items="Model.TypeOptions" class="form-select"></select>
            @if (Model.Types.Count == 0)
            {
                <div class="form-text">No phonebook types available. Add types from the Settings &gt; Phonebook Types page.</div>
            }
            <span asp-validation-for="Contact.PhonebookTypeId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.Company" class="form-label"></label>
            <input asp-for="Contact.Company" class="form-control" />
            <span asp-validation-for="Contact.Company" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.FirstName" class="form-label"></label>
            <input asp-for="Contact.FirstName" class="form-control" />
            <span asp-validation-for="Contact.FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.LastName" class="form-label"></label>
            <input asp-for="Contact.LastName" class="form-control" />
            <span asp-validation-for="Contact.LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.Title" class="form-label"></label>
            <input asp-for="Contact.Title" class="form-control" />
            <span asp-validation-for="Contact.Title" class="text-danger"></span>
        </div>
        <div class="col-md-6" id="phoneFields">
            <label class="form-label" for="phoneFieldGroup">Phone Numbers</label>
            <input type="hidden" asp-for="Contact.PhoneNumber" data-field-hidden="phone" />
            <input type="hidden" asp-for="Contact.PhoneNumberTypes" data-field-hidden="phone-types" />
            <div id="phoneFieldGroup" class="phonebook-field-group" data-field-group="phone">
                @for (var i = 0; i < phoneEntries.Count; i++)
                {
                    var phone = phoneEntries[i];
                    var phoneType = phoneTypeEntries[i];
                    <div class="input-group mb-2 flex-nowrap" data-field-row="phone">
                        <input type="text"
                               class="form-control phone-type-input"
                               data-field-meta="phone"
                               value="@phoneType"
                               placeholder="Type (e.g., Mobile)" />
                        <input type="tel"
                               class="form-control"
                               data-field-value="phone"
                               value="@phone"
                               placeholder="(555) 123-4567" />
                        <button type="button"
                                class="btn btn-outline-danger"
                                data-remove-field="phone"
                                aria-label="Remove phone number">&times;</button>
                    </div>
                }
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-add-field="phone">
                + Add phone
            </button>
            <span asp-validation-for="Contact.PhoneNumber" class="text-danger"></span>
            <span asp-validation-for="Contact.PhoneNumberTypes" class="text-danger"></span>
        </div>
        <div class="col-md-6" id="emailFields">
            <label class="form-label" for="emailFieldGroup">Email Addresses</label>
            <input type="hidden" asp-for="Contact.Email" data-field-hidden="email" />
            <div id="emailFieldGroup" class="phonebook-field-group" data-field-group="email">
                @foreach (var email in emailEntries)
                {
                    <div class="input-group mb-2" data-field-row="email">
                        <input type="email"
                               class="form-control"
                               value="@email"
                               placeholder="name@example.com" />
                        <button type="button"
                                class="btn btn-outline-danger"
                                data-remove-field="email"
                                aria-label="Remove email address">&times;</button>
                    </div>
                }
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-add-field="email">
                + Add email
            </button>
            <span asp-validation-for="Contact.Email" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.Fax" class="form-label"></label>
            <input asp-for="Contact.Fax" class="form-control" />
            <span asp-validation-for="Contact.Fax" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Contact.Website" class="form-label"></label>
            <input asp-for="Contact.Website" class="form-control" />
            <span asp-validation-for="Contact.Website" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Contact.Address" class="form-label"></label>
            <textarea asp-for="Contact.Address" class="form-control" rows="2" data-enable-mentions="true"></textarea>
            <span asp-validation-for="Contact.Address" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Contact.Notes" class="form-label"></label>
            <textarea asp-for="Contact.Notes" class="form-control" rows="4" data-enable-mentions="true"></textarea>
            <span asp-validation-for="Contact.Notes" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Contact</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const setupGroup = (fieldName, options = {}) => {
                const metaFieldName = options.metaField ?? null;
                const metaPlaceholder = options.metaPlaceholder ?? 'Type (e.g., Mobile)';
                const container = document.querySelector(`[data-field-group="${fieldName}"]`);
                const hiddenInput = document.querySelector(`[data-field-hidden="${fieldName}"]`);
                const hiddenMetaInput = metaFieldName
                    ? document.querySelector(`[data-field-hidden="${metaFieldName}"]`)
                    : null;
                const addButton = document.querySelector(`[data-add-field="${fieldName}"]`);
                if (!container || !hiddenInput || !addButton) {
                    return;
                }

                const form = hiddenInput.form;

                const createRow = (value = '', metaValue = '') => {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'input-group mb-2 flex-nowrap';
                    wrapper.setAttribute('data-field-row', fieldName);

                    const input = document.createElement('input');
                    input.className = 'form-control';
                    input.type = fieldName === 'email' ? 'email' : 'tel';
                    input.placeholder = fieldName === 'email' ? 'name@example.com' : '(555) 123-4567';
                    input.value = value;
                    input.setAttribute('data-field-value', fieldName);

                    if (hiddenMetaInput) {
                        const metaInput = document.createElement('input');
                        metaInput.type = 'text';
                        metaInput.className = 'form-control phone-type-input';
                        metaInput.placeholder = metaPlaceholder;
                        metaInput.value = metaValue;
                        metaInput.setAttribute('data-field-meta', fieldName);
                        wrapper.append(metaInput);
                    }

                    const removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.className = 'btn btn-outline-danger';
                    removeBtn.setAttribute('data-remove-field', fieldName);
                    removeBtn.setAttribute('aria-label', `Remove ${fieldName}`);
                    removeBtn.innerHTML = '&times;';

                    wrapper.append(input, removeBtn);
                    return wrapper;
                };

                const updateHidden = () => {
                    const rows = Array.from(container.querySelectorAll('[data-field-row]'));
                    const values = [];
                    const metaValues = [];

                    rows.forEach(row => {
                        const valueInput = row.querySelector('[data-field-value]');
                        const value = valueInput?.value.trim();
                        if (!value) {
                            return;
                        }
                        values.push(value);
                        if (hiddenMetaInput) {
                            const metaInput = row.querySelector('[data-field-meta]');
                            metaValues.push(metaInput?.value.trim() ?? '');
                        }
                    });

                    hiddenInput.value = values.join('\n');
                    if (hiddenMetaInput) {
                        hiddenMetaInput.value = metaValues.join('\n');
                    }
                    updateRemoveButtons();
                };

                const updateRemoveButtons = () => {
                    const disable = container.querySelectorAll('[data-field-row]').length <= 1;
                    container.querySelectorAll('[data-remove-field]').forEach(btn => {
                        btn.disabled = disable;
                    });
                };

                addButton.addEventListener('click', () => {
                    const row = createRow();
                    container.appendChild(row);
                    (row.querySelector('[data-field-meta]') ?? row.querySelector('[data-field-value]'))?.focus();
                    updateHidden();
                });

                container.addEventListener('click', (event) => {
                    const target = event.target;
                    if (!target.matches('[data-remove-field]')) {
                        return;
                    }

                    const row = target.closest('[data-field-row]');
                    if (row && container.querySelectorAll('[data-field-row]').length > 1) {
                        row.remove();
                        updateHidden();
                    }
                });

                container.addEventListener('input', updateHidden);
                form?.addEventListener('submit', updateHidden);
                updateHidden();
            };

            setupGroup('phone', { metaField: 'phone-types' });
            setupGroup('email');
        })();
    </script>
}
