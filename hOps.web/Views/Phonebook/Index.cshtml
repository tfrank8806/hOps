@model hOps.web.ViewModels.PhonebookIndexViewModel
@using System.Text.Json
@using System.Text.Encodings.Web
@using System.Linq
@{ 
    ViewData["Title"] = "Phonebook";
    ViewData["MainContainerClass"] = "main-inner--wide";
    var contactsData = Model.Contacts.Select(contact => new
    {
        id = contact.Id,
        name = contact.DisplayName,
        type = contact.TypeName,
        typeColor = contact.PhonebookType?.Color ?? "#6c757d",
        company = contact.Company,
        title = contact.Title,
        phone = contact.PhoneNumber,
        email = contact.Email,
        fax = contact.Fax,
        website = contact.Website,
        address = contact.Address,
        notes = contact.Notes
    });
    var serializedContacts = JsonSerializer.Serialize(contactsData, new JsonSerializerOptions
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    });
    var hasFilters = !string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.SelectedTypeId.HasValue;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Phonebook</h1>
    <a class="btn btn-primary" asp-action="Create">Add Contact</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-6">
                <label class="form-label" for="searchTerm">Search</label>
                <input type="text"
                       class="form-control"
                       id="searchTerm"
                       name="search"
                       value="@Model.SearchTerm"
                       placeholder="Search by name, company, or contact details" />
            </div>
            <div class="col-lg-4">
                <label class="form-label" for="typeFilter">Filter by Type</label>
                <select class="form-select" id="typeFilter" name="typeId">
                    <option value="">All types</option>
                    @foreach (var type in Model.Types.OrderBy(t => t.Name))
                    {
                        <option value="@type.Id" selected="@(Model.SelectedTypeId == type.Id ? "selected" : null)">@type.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Apply</button>
                @if (hasFilters)
                {
                    <a class="btn btn-outline-secondary flex-grow-1" asp-action="Index">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

@if (!Model.Contacts.Any())
{
    if (hasFilters)
    {
        <div class="alert alert-warning">No contacts match the current search or type filter.</div>
    }
    else
    {
        <div class="alert alert-info">There are no contacts yet. Start by adding your first contact.</div>
    }
}
else
{
    <div class="row phonebook-layout">
        <div class="col-lg-4 mb-4 mb-lg-0">
            <div class="list-group phonebook-list" id="phonebookList">
                @foreach (var contact in Model.Contacts)
                {
                    var color = contact.PhonebookType?.Color ?? "#6c757d";
                    <button type="button"
                            class="list-group-item list-group-item-action phonebook-list-item"
                            data-contact-id="@contact.Id"
                            style="border-left: 6px solid @color">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">@contact.DisplayName</div>
                                @if (!string.IsNullOrWhiteSpace(contact.Company))
                                {
                                    <div class="text-muted small">@contact.Company</div>
                                }
                            </div>
                            <span class="badge rounded-pill" style="background-color:@color">@contact.TypeName</span>
                        </div>
                    </button>
                }
            </div>
            @if (Model.Types.Any())
            {
                <div class="mt-3">
                    <div class="text-muted text-uppercase small mb-2">Type legend</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var type in Model.Types)
                        {
                            <span class="badge rounded-pill" style="background-color:@type.Color">@type.Name</span>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h2 class="h4 mb-0" id="contactName">Select a contact</h2>
                            <div class="text-muted" id="contactCompany"></div>
                        </div>
                        <a id="editContactButton" class="btn btn-outline-primary disabled" aria-disabled="true">Edit</a>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <h6 class="text-uppercase text-muted">Type</h6>
                            <span id="contactType" class="badge rounded-pill bg-secondary">-</span>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-uppercase text-muted">Title</h6>
                            <p id="contactTitle">-</p>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-uppercase text-muted">Phone</h6>
                            <p id="contactPhone">-</p>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-uppercase text-muted">Email</h6>
                            <p id="contactEmail">-</p>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-uppercase text-muted">Fax</h6>
                            <p id="contactFax">-</p>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-uppercase text-muted">Website</h6>
                            <p id="contactWebsite">-</p>
                        </div>
                        <div class="col-12">
                            <h6 class="text-uppercase text-muted">Address</h6>
                            <p id="contactAddress">-</p>
                        </div>
                        <div class="col-12">
                            <h6 class="text-uppercase text-muted">Notes</h6>
                            <p id="contactNotes" class="mb-0">-</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script id="contactsData" type="application/json">
    @Html.Raw(serializedContacts)
</script>

@section Scripts {
    <script>
        (() => {
            const dataElement = document.getElementById('contactsData');
            if (!dataElement) {
                return;
            }
            const contacts = JSON.parse(dataElement.textContent || '[]');
            const contactMap = new Map(contacts.map(c => [c.id, c]));

            const list = document.getElementById('phonebookList');
            const detailElements = {
                name: document.getElementById('contactName'),
                company: document.getElementById('contactCompany'),
                type: document.getElementById('contactType'),
                title: document.getElementById('contactTitle'),
                phone: document.getElementById('contactPhone'),
                email: document.getElementById('contactEmail'),
                fax: document.getElementById('contactFax'),
                website: document.getElementById('contactWebsite'),
                address: document.getElementById('contactAddress'),
                notes: document.getElementById('contactNotes'),
                editButton: document.getElementById('editContactButton')
            };

            if (!detailElements.name || !detailElements.editButton) {
                return;
            }

            function formatValue(value, fallback = '-') {
                if (!value) {
                    return fallback;
                }
                return value;
            }

            const basePath = window.location.pathname.replace(/\/$/, '');

            function updateDetails(contact) {
                detailElements.name.textContent = contact.name || 'Unnamed contact';
                detailElements.company.textContent = contact.company || '';
                detailElements.company.style.display = contact.company ? 'block' : 'none';
                detailElements.type.textContent = contact.type || '-';
                detailElements.type.style.backgroundColor = contact.typeColor || '#6c757d';
                detailElements.title.textContent = formatValue(contact.title);
                detailElements.phone.innerHTML = contact.phone ? `<a href="tel:${contact.phone}">${contact.phone}</a>` : '-';
                detailElements.email.innerHTML = contact.email ? `<a href="mailto:${contact.email}">${contact.email}</a>` : '-';
                detailElements.fax.textContent = formatValue(contact.fax);
                detailElements.website.innerHTML = contact.website ? `<a href="${contact.website}" target="_blank" rel="noopener">${contact.website}</a>` : '-';
                detailElements.address.textContent = formatValue(contact.address);
                detailElements.notes.textContent = formatValue(contact.notes, 'No notes');
                detailElements.editButton.href = `${basePath}/Edit/${contact.id}`;
                detailElements.editButton.classList.remove('disabled');
                detailElements.editButton.removeAttribute('aria-disabled');
            }

            function clearSelection() {
                document.querySelectorAll('.phonebook-list-item.active').forEach(item => item.classList.remove('active'));
            }

            if (list) {
                list.addEventListener('click', (event) => {
                    const item = event.target.closest('[data-contact-id]');
                    if (!item) {
                        return;
                    }

                    const id = Number(item.getAttribute('data-contact-id'));
                    const contact = contactMap.get(id);
                    if (!contact) {
                        return;
                    }

                    clearSelection();
                    item.classList.add('active');
                    updateDetails(contact);
                });

                // Pre-select the first contact
                const firstItem = list.querySelector('[data-contact-id]');
                if (firstItem) {
                    firstItem.click();
                }
            }
        })();
    </script>
}
