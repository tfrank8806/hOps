@model hOps.web.ViewModels.PhonebookIndexViewModel
@using System
@using System.Text.Json
@using System.Text.Encodings.Web
@using System.Linq
@{ 
    ViewData["Title"] = "Phonebook";
    ViewData["MainContainerClass"] = "main-inner--wide";
    string[] SplitValues(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Array.Empty<string>();
        }

        return value
            .Split(new[] { '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(v => v.Trim())
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .ToArray();
    }
    IEnumerable<(string number, string type)> BuildPhoneEntries(string? numbers, string? types)
    {
        var numberEntries = SplitValues(numbers);
        var typeEntries = SplitValues(types);
        var max = Math.Max(numberEntries.Length, typeEntries.Length);
        for (var i = 0; i < max; i++)
        {
            var number = i < numberEntries.Length ? numberEntries[i] : string.Empty;
            if (string.IsNullOrWhiteSpace(number))
            {
                continue;
            }
            var type = i < typeEntries.Length ? typeEntries[i] : string.Empty;
            yield return (number, type);
        }
    }
    var contactsData = Model.Contacts.Select(contact => new
    {
        id = contact.Id,
        name = contact.DisplayName,
        type = contact.TypeName,
        typeColor = contact.PhonebookType?.Color ?? "#6c757d",
        company = contact.Company,
        title = contact.Title,
        phone = contact.PhoneNumber,
        phoneEntries = BuildPhoneEntries(contact.PhoneNumber, contact.PhoneNumberTypes)
            .Select(entry => new { number = entry.number, type = entry.type }),
        email = contact.Email,
        emails = SplitValues(contact.Email),
        fax = contact.Fax,
        website = contact.Website,
        address = contact.Address,
        notes = contact.Notes
    });
    var serializedContacts = JsonSerializer.Serialize(contactsData, new JsonSerializerOptions
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    });
    var hasFilters = !string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.SelectedTypeId.HasValue;
}

@section Styles {
    <style>
        @@media (min-width: 992px) {
            .phonebook-detail-card {
                position: sticky;
                top: 1.5rem;
            }
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Phonebook</h1>
    <a class="btn btn-primary" asp-action="Create">Add Contact</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-6">
                <label class="form-label" for="searchTerm">Search</label>
                <input type="text"
                       class="form-control"
                       id="searchTerm"
                       name="search"
                       value="@Model.SearchTerm"
                       placeholder="Search by name, company, or contact details" />
            </div>
            <div class="col-lg-4">
                <label class="form-label" for="typeFilter">Filter by Type</label>
                <select class="form-select" id="typeFilter" name="typeId">
                    <option value="">All types</option>
                    @foreach (var type in Model.Types.OrderBy(t => t.Name))
                    {
                        <option value="@type.Id" selected="@(Model.SelectedTypeId == type.Id ? "selected" : null)">@type.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Apply</button>
                @if (hasFilters)
                {
                    <a class="btn btn-outline-secondary flex-grow-1" asp-action="Index">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

@if (!Model.Contacts.Any())
{
    if (hasFilters)
    {
        <div class="alert alert-warning">No contacts match the current search or type filter.</div>
    }
    else
    {
        <div class="alert alert-info">There are no contacts yet. Start by adding your first contact.</div>
    }
}
else
{
    <div class="row phonebook-layout">
        <div class="col-lg-4 mb-4 mb-lg-0">
            <div class="list-group phonebook-list" id="phonebookList">
                @foreach (var contact in Model.Contacts)
                {
                    var color = contact.PhonebookType?.Color ?? "#6c757d";
                    <button type="button"
                            class="list-group-item list-group-item-action phonebook-list-item"
                            data-contact-id="@contact.Id"
                            style="border-left: 6px solid @color">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">@contact.DisplayName</div>
                                @if (!string.IsNullOrWhiteSpace(contact.Company))
                                {
                                    <div class="text-muted small">@contact.Company</div>
                                }
                            </div>
                            <span class="badge rounded-pill" style="background-color:@color">@contact.TypeName</span>
                        </div>
                    </button>
                }
            </div>
            @if (Model.Types.Any())
            {
                <div class="mt-3">
                    <div class="text-muted text-uppercase small mb-2">Type legend</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var type in Model.Types)
                        {
                            <span class="badge rounded-pill" style="background-color:@type.Color">@type.Name</span>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm phonebook-detail-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h2 class="h4 mb-0" id="contactName">Select a contact</h2>
                            <div class="text-muted" id="contactCompany"></div>
                        </div>
                        <a id="editContactButton" class="btn btn-outline-primary disabled" aria-disabled="true">Edit</a>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <h6 class="text-uppercase text-muted">Type</h6>
                            <span id="contactType" class="badge rounded-pill bg-secondary">-</span>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-uppercase text-muted">Title</h6>
                            <p id="contactTitle">-</p>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="text-uppercase text-muted mb-0">Phone</h6>
                                <a id="addPhoneButton"
                                   class="btn btn-sm btn-outline-secondary phonebook-add-action disabled"
                                   aria-disabled="true">+ Add phone</a>
                            </div>
                            <div id="contactPhoneList" class="phonebook-contact-list text-muted">-</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="text-uppercase text-muted mb-0">Email</h6>
                                <a id="addEmailButton"
                                   class="btn btn-sm btn-outline-secondary phonebook-add-action disabled"
                                   aria-disabled="true">+ Add email</a>
                            </div>
                            <div id="contactEmailList" class="phonebook-contact-list text-muted">-</div>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-uppercase text-muted">Fax</h6>
                            <p id="contactFax">-</p>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-uppercase text-muted">Website</h6>
                            <p id="contactWebsite">-</p>
                        </div>
                        <div class="col-12">
                            <h6 class="text-uppercase text-muted">Address</h6>
                            <p id="contactAddress">-</p>
                        </div>
                        <div class="col-12">
                            <h6 class="text-uppercase text-muted">Notes</h6>
                            <p id="contactNotes" class="mb-0">-</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script id="contactsData" type="application/json">
    @Html.Raw(serializedContacts)
</script>

@section Scripts {
    <script>
        (() => {
            const dataElement = document.getElementById('contactsData');
            if (!dataElement) {
                return;
            }
            const contacts = JSON.parse(dataElement.textContent || '[]');
            const contactMap = new Map(contacts.map(c => [c.id, c]));

            const list = document.getElementById('phonebookList');
            const detailElements = {
                name: document.getElementById('contactName'),
                company: document.getElementById('contactCompany'),
                type: document.getElementById('contactType'),
                title: document.getElementById('contactTitle'),
                phoneList: document.getElementById('contactPhoneList'),
                emailList: document.getElementById('contactEmailList'),
                addPhoneButton: document.getElementById('addPhoneButton'),
                addEmailButton: document.getElementById('addEmailButton'),
                fax: document.getElementById('contactFax'),
                website: document.getElementById('contactWebsite'),
                address: document.getElementById('contactAddress'),
                notes: document.getElementById('contactNotes'),
                editButton: document.getElementById('editContactButton')
            };

            if (!detailElements.name || !detailElements.editButton) {
                return;
            }

            function formatValue(value, fallback = '-') {
                if (!value) {
                    return fallback;
                }
                return value;
            }

            const basePath = window.location.pathname.replace(/\/$/, '');

            function normalizeValues(arrayValue, fallback) {
                if (Array.isArray(arrayValue) && arrayValue.length) {
                    return arrayValue;
                }
                if (!fallback) {
                    return [];
                }
                return fallback
                    .split(/\r?\n/)
                    .map(v => v.trim())
                    .filter(Boolean);
            }

            function escapeHtml(value) {
                const div = document.createElement('div');
                div.textContent = value;
                return div.innerHTML;
            }

            function renderMultiValue(target, values, fallback, type) {
                if (!target) {
                    return;
                }

                const entries = normalizeValues(values, fallback);
                target.innerHTML = '';
                if (!entries.length) {
                    target.classList.add('text-muted');
                    target.textContent = '-';
                    return;
                }

                target.classList.remove('text-muted');
                const list = document.createElement('ul');
                list.className = 'list-unstyled mb-0';
                entries.forEach(entry => {
                    const li = document.createElement('li');
                    const safeValue = escapeHtml(entry);
                    if (type === 'email') {
                        li.innerHTML = `<a href="mailto:${encodeURIComponent(entry)}">${safeValue}</a>`;
                    } else {
                        li.textContent = entry;
                    }
                    list.appendChild(li);
                });
                target.appendChild(list);
            }

            function renderPhoneValues(target, entries, fallback) {
                if (!target) {
                    return;
                }
                const normalized = Array.isArray(entries) && entries.length
                    ? entries
                        .map(entry => ({
                            number: typeof entry.number === 'string' ? entry.number.trim() : '',
                            type: typeof entry.type === 'string' ? entry.type.trim() : ''
                        }))
                        .filter(entry => entry.number)
                    : (typeof fallback === 'string' && fallback.trim()
                        ? fallback
                            .split(/\r?\n/)
                            .map(v => v.trim())
                            .filter(Boolean)
                            .map(number => ({ number, type: '' }))
                        : []);

                target.innerHTML = '';
                if (!normalized.length) {
                    target.classList.add('text-muted');
                    target.textContent = '-';
                    return;
                }

                target.classList.remove('text-muted');
                const list = document.createElement('ul');
                list.className = 'list-unstyled mb-0';
                normalized.forEach(entry => {
                    const li = document.createElement('li');
                    const typeLabel = entry.type
                        ? `<span class="text-muted me-2">${escapeHtml(entry.type)}</span>`
                        : '';
                    li.innerHTML = `${typeLabel}<a href="tel:${encodeURIComponent(entry.number)}">${escapeHtml(entry.number)}</a>`;
                    list.appendChild(li);
                });
                target.appendChild(list);
            }

            function setActionButton(button, url) {
                if (!button) {
                    return;
                }

                if (url) {
                    button.href = url;
                    button.classList.remove('disabled');
                    button.removeAttribute('aria-disabled');
                } else {
                    button.classList.add('disabled');
                    button.setAttribute('aria-disabled', 'true');
                    button.removeAttribute('href');
                }
            }

            function updateDetails(contact) {
                detailElements.name.textContent = contact.name || 'Unnamed contact';
                detailElements.company.textContent = contact.company || '';
                detailElements.company.style.display = contact.company ? 'block' : 'none';
                detailElements.type.textContent = contact.type || '-';
                detailElements.type.style.backgroundColor = contact.typeColor || '#6c757d';
                detailElements.title.textContent = formatValue(contact.title);
                renderPhoneValues(detailElements.phoneList, contact.phoneEntries, contact.phone);
                renderMultiValue(detailElements.emailList, contact.emails, contact.email, 'email');
                detailElements.fax.textContent = formatValue(contact.fax);
                detailElements.website.innerHTML = contact.website ? `<a href="${contact.website}" target="_blank" rel="noopener">${contact.website}</a>` : '-';
                detailElements.address.textContent = formatValue(contact.address);
                detailElements.notes.textContent = formatValue(contact.notes, 'No notes');
                const editUrl = `${basePath}/Edit/${contact.id}`;
                setActionButton(detailElements.editButton, editUrl);
                setActionButton(detailElements.addPhoneButton, `${editUrl}#phoneFields`);
                setActionButton(detailElements.addEmailButton, `${editUrl}#emailFields`);
            }

            function clearSelection() {
                document.querySelectorAll('.phonebook-list-item.active').forEach(item => item.classList.remove('active'));
                renderPhoneValues(detailElements.phoneList, [], null);
                renderMultiValue(detailElements.emailList, [], null, 'email');
                setActionButton(detailElements.editButton, null);
                setActionButton(detailElements.addPhoneButton, null);
                setActionButton(detailElements.addEmailButton, null);
            }

            if (list) {
                list.addEventListener('click', (event) => {
                    const item = event.target.closest('[data-contact-id]');
                    if (!item) {
                        return;
                    }

                    const id = Number(item.getAttribute('data-contact-id'));
                    const contact = contactMap.get(id);
                    if (!contact) {
                        return;
                    }

                    clearSelection();
                    item.classList.add('active');
                    updateDetails(contact);
                });

                // Pre-select the first contact
                const firstItem = list.querySelector('[data-contact-id]');
                if (firstItem) {
                    firstItem.click();
                }
            }
        })();
    </script>
}
