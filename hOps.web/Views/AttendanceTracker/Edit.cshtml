@model hOps.web.ViewModels.Attendance.AttendanceRecordFormViewModel
@{
    ViewData["Title"] = "Edit Attendance Record";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Edit Attendance Record</h1>
    @if (ViewBag.PropertyName is string propertyName && !string.IsNullOrWhiteSpace(propertyName))
    {
        <div class="text-muted small">Property: @propertyName</div>
    }
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label class="form-label" asp-for="MasterEmployeeId"></label>
        <select class="form-select" asp-for="MasterEmployeeId" asp-items="Model.EmployeeOptions">
            <option value="">Select employee</option>
        </select>
        <span class="text-danger" asp-validation-for="MasterEmployeeId"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="AttendanceDate"></label>
        <input class="form-control" asp-for="AttendanceDate" type="date" />
        <span class="text-danger" asp-validation-for="AttendanceDate"></span>
    </div>
    <div class="mb-4">
        <label class="form-label" asp-for="AttendanceType"></label>
        <select class="form-select" asp-for="AttendanceType" asp-items="Model.AttendanceTypeOptions">
            <option value="">Select type</option>
        </select>
        <span class="text-danger" asp-validation-for="AttendanceType"></span>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
