@using System.Text.Json
@model hOps.web.ViewModels.PassOnLogFormViewModel
@{
    var pageTitle = Html.Localize("PassOnLogs.Edit.Title", "Edit Pass On Log").ToString();
    var saveLabel = Html.Localize("PassOnLogs.Edit.SaveButton", "Save Changes").ToString();
    var savingLabel = Html.Localize("PassOnLogs.Edit.SavingLabel", "Saving...").ToString();
    ViewData["Title"] = pageTitle;
}

<h2 class="mb-4">@pageTitle</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="card" id="passOnLogForm">
    <div class="card-body">
        <input type="hidden" asp-for="Id" />
        <partial name="_LogForm" model="Model" />
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">@Html.Localize("Cancel")</a>
        <button type="submit" class="btn btn-primary" data-submit-btn="true" data-loading-text="@savingLabel">@saveLabel</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('passOnLogForm');
            const submitBtn = form?.querySelector('[data-submit-btn="true"]');
            if (!form || !submitBtn) {
                return;
            }

            form.addEventListener('submit', (event) => {
                if (submitBtn.disabled) {
                    event.preventDefault();
                    return;
                }

                submitBtn.disabled = true;
                const loadingText = submitBtn.dataset.loadingText || @JsonSerializer.Serialize(savingLabel);
                submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>${loadingText}`;
            });
        })();
    </script>
}

