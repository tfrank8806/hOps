@using hOps.web.Utilities
@model hOps.web.ViewModels.PassOnLogDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
        <h2>@Model.Title</h2>
    @{
        var createdLocal = TimeZoneService.ConvertToUserTime(Model.CreatedAt);
        var updatedLocal = Model.UpdatedAt.HasValue ? TimeZoneService.ConvertToUserTime(Model.UpdatedAt.Value) : (DateTime?)null;
    }
    <div class="text-muted">Posted by @Model.CreatorName on @createdLocal.ToString("f")</div>
    @if (updatedLocal.HasValue)
    {
        <div class="text-muted">Updated @updatedLocal.Value.ToString("g")</div>
    }
        <div class="text-muted">Properties: @string.Join(", ", Model.PropertyNames)</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.NextLogId.HasValue)
        {
            <a asp-action="Details" asp-route-id="@Model.NextLogId.Value" class="btn btn-outline-primary">
                Next (Newer)
            </a>
        }
        @if (Model.PreviousLogId.HasValue)
        {
            <a asp-action="Details" asp-route-id="@Model.PreviousLogId.Value" class="btn btn-outline-primary">
                Previous (Older)
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Logs</a>
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-body log-body rich-text-output">
        @Html.Raw(RichTextRenderer.ToHtml(Model.Body))
    </div>
</div>

@if (Model.Attachments.Any())
{
    <div class="card mb-4">
        <div class="card-header">Attachments (@Model.Attachments.Count)</div>
        <div class="card-body">
            <ul class="list-unstyled mb-0">
                @foreach (var attachment in Model.Attachments)
                {
                    <li class="mb-2">
                        <a href="@attachment.DownloadUrl" target="_blank" rel="noopener">@attachment.FileName</a>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">Comments (@Model.Comments.Count)</div>
            <div class="card-body">
                @if (Model.Comments.Any())
                {
                    <ul class="list-unstyled mb-4">
                        @foreach (var comment in Model.Comments)
                        {
                            <li class="passon-comment mb-3">
                                @{
                                    var commentLocal = TimeZoneService.ConvertToUserTime(comment.CreatedAt);
                                }
                                <div class="passon-comment__header">
                                    <div class="fw-semibold mb-0">@comment.CreatorName</div>
                                    <div class="text-muted small">@commentLocal.ToString("g")</div>
                                </div>
                                <div class="passon-comment__body rich-text-output">@Html.Raw(RichTextRenderer.ToHtml(comment.Body))</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No comments yet.</p>
                }

                <form asp-action="AddComment" method="post" class="card">
                    <div class="card-body">
                        <input type="hidden" asp-for="NewComment.LogId" />
                        <div class="mb-3">
                            <label asp-for="NewComment.Body" class="form-label"></label>
                            <textarea asp-for="NewComment.Body" class="form-control" rows="3" placeholder="Share an update or clarification..." data-enable-mentions="true" data-rich-text="true"></textarea>
                            <div class="form-text">Basic formatting works here too for quick emphasis.</div>
                            <span asp-validation-for="NewComment.Body" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Post Comment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">Viewed By</div>
            <div class="card-body">
                @if (Model.Viewers.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var viewer in Model.Viewers)
                        {
                            <li class="mb-2">
                                <div>@viewer.Name</div>
                                @{
                                    var viewedLocal = TimeZoneService.ConvertToUserTime(viewer.ViewedAt);
                                }
                                <div class="text-muted small">@viewedLocal.ToString("g")</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">No one has viewed this log yet.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .passon-comment {
            border: 1px solid rgba(13, 110, 253, 0.15);
            border-radius: 0.85rem;
            background-color: #fafbff;
            padding: 0.75rem 0.9rem;
        }

        .passon-comment__header {
            background: linear-gradient(135deg, rgba(13, 110, 253, 0.12), rgba(13, 110, 253, 0.03));
            border-radius: 0.65rem;
            padding: 0.5rem 0.75rem;
            margin-bottom: 0.75rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 0.35rem;
        }

        .passon-comment__body {
            color: #1f2937;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
