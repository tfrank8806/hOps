@model hOps.web.ViewModels.PassOnLogDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
        <h2>@Model.Title</h2>
        <div class="text-muted">Posted by @Model.CreatorName on @Model.CreatedAt.ToLocalTime().ToString("f")</div>
        @if (Model.UpdatedAt.HasValue)
        {
            <div class="text-muted">Updated @Model.UpdatedAt.Value.ToLocalTime().ToString("g")</div>
        }
        <div class="text-muted">Properties: @string.Join(", ", Model.PropertyNames)</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Logs</a>
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-body log-body">
        @Model.Body
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">Comments (@Model.Comments.Count)</div>
            <div class="card-body">
                @if (Model.Comments.Any())
                {
                    <ul class="list-unstyled mb-4">
                        @foreach (var comment in Model.Comments)
                        {
                            <li class="mb-3">
                                <div class="fw-semibold">@comment.CreatorName <span class="text-muted small">@comment.CreatedAt.ToLocalTime().ToString("g")</span></div>
                                <div class="comment-body">@comment.Body</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No comments yet.</p>
                }

                <form asp-action="AddComment" method="post" class="card">
                    <div class="card-body">
                        <input type="hidden" asp-for="NewComment.LogId" />
                        <div class="mb-3">
                            <label asp-for="NewComment.Body" class="form-label"></label>
                            <textarea asp-for="NewComment.Body" class="form-control" rows="3" placeholder="Share an update or clarification..."></textarea>
                            <span asp-validation-for="NewComment.Body" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Post Comment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">Viewed By</div>
            <div class="card-body">
                @if (Model.Viewers.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var viewer in Model.Viewers)
                        {
                            <li class="mb-2">
                                <div>@viewer.Name</div>
                                <div class="text-muted small">@viewer.ViewedAt.ToLocalTime().ToString("g")</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">No one has viewed this log yet.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
