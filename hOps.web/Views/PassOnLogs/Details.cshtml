@using System.Globalization
@using System.Text.Encodings.Web
@using hOps.web.Utilities
@model hOps.web.ViewModels.PassOnLogDetailsViewModel
@{
    var entityId = Model.Id.ToString(CultureInfo.InvariantCulture);
    var displayTitle = await Html.DisplayTranslatedTextAsync("PassOnLog", entityId, "Title", Model.Title);
    var displayBody = await Html.DisplayTranslatedTextAsync("PassOnLog", entityId, "Body", Model.Body);
    ViewData["Title"] = displayTitle;

    var createdLocal = TimeZoneService.ConvertToUserTime(Model.CreatedAt);
    var updatedLocal = Model.UpdatedAt.HasValue ? TimeZoneService.ConvertToUserTime(Model.UpdatedAt.Value) : (DateTime?)null;
    var propertyDisplayNames = new List<string>();
    if (Model.Properties != null)
    {
        foreach (var property in Model.Properties)
        {
            var propertyIdString = property.Id.ToString(CultureInfo.InvariantCulture);
            var translatedPropertyName = await Html.DisplayTranslatedTextAsync("Property", propertyIdString, "Name", property.Name);
            var propertyNameDisplay = string.IsNullOrWhiteSpace(translatedPropertyName) ? property.Name : translatedPropertyName;
        var propertyEntry = string.IsNullOrWhiteSpace(property.Code)
            ? propertyNameDisplay
            : string.Format(CultureInfo.CurrentCulture, "{0} ({1})", propertyNameDisplay, property.Code);
        if (!string.IsNullOrWhiteSpace(propertyEntry))
        {
            propertyDisplayNames.Add(propertyEntry);
        }
        }
    }
    var propertiesDisplay = string.Join(", ", propertyDisplayNames);

    var postedByTemplate = Html.Localize("PassOnLogs.Details.PostedByOn", "Posted by {0} on {1}").ToString();
    var postedByText = string.Format(CultureInfo.CurrentCulture, postedByTemplate, Model.CreatorName, createdLocal.ToString("f"));
    var updatedTemplate = Html.Localize("PassOnLogs.Details.UpdatedOn", "Updated {0}").ToString();
    var updatedText = updatedLocal.HasValue
        ? string.Format(CultureInfo.CurrentCulture, updatedTemplate, updatedLocal.Value.ToString("g"))
        : null;
    var propertiesLabel = Html.Localize("Properties:");
    var attachmentsLabel = Html.Localize("PassOnLogs.Attachments", "Attachments");
    var commentsLabel = Html.Localize("PassOnLogs.Comments", "Comments");
    var viewedByLabel = Html.Localize("PassOnLogs.ViewedBy", "Viewed By");
    var noViewersLabel = Html.Localize("PassOnLogs.NoViewers", "No one has viewed this log yet.");
    var addImagesHelp = Html.Localize("PassOnLogs.Comment.AddImagesHelp", "Attach screenshots or photos. You can also paste them directly into the comment box.");
    var postCommentLabel = Html.Localize("PassOnLogs.Comment.PostButton", "Post Comment");
    var editLabel = Html.Localize("Edit");
    var deleteLabel = Html.Localize("Delete");
    var deleteConfirmMessage = Html.Localize("PassOnLogs.Details.DeleteConfirm", "Are you sure you want to delete this pass on log? This action cannot be undone.").ToString();
    var deleteConfirmMessageEscaped = JavaScriptEncoder.Default.Encode(deleteConfirmMessage);
}

<div class="card mb-4 passon-details-card">
    <div class="card-header passon-details-card__header d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div class="d-flex align-items-start gap-3 flex-grow-1 flex-wrap">
            <div class="flex-shrink-0">
                <partial name="_UserAvatar" model="Model.CreatorAvatar" />
            </div>
            <div>
                <h2 class="mb-2">@displayTitle</h2>
                <div class="text-muted">@postedByText</div>
                @if (!string.IsNullOrWhiteSpace(updatedText))
                {
                    <div class="text-muted">@updatedText</div>
                }
                @if (!string.IsNullOrWhiteSpace(propertiesDisplay))
                {
                    <div class="text-muted">@propertiesLabel @propertiesDisplay</div>
                }
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap passon-details-actions">
            <partial name="_PassOnLogNavigation" model="Model" />
            @if (Model.CanEdit)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@editLabel</a>
            }
            @if (Model.CanDelete)
            {
                <form asp-action="Delete"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('@deleteConfirmMessageEscaped');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">@deleteLabel</button>
                </form>
            }
        </div>
    </div>
    <div class="card-body passon-details-card__body log-body rich-text-output">
        @Html.Raw(RichTextRenderer.ToHtml(displayBody))
        <div class="passon-details-bottom-nav not-rich-text">
            <partial name="_PassOnLogNavigation" model="Model" />
        </div>
    </div>
</div>

@if (Model.Attachments.Any())
{
    <div class="card mb-4">
        <div class="card-header">@attachmentsLabel (@Model.Attachments.Count)</div>
        <div class="card-body">
            <ul class="list-unstyled mb-0">
                @foreach (var attachment in Model.Attachments)
                {
                    <li class="mb-2">
                        <a href="@attachment.DownloadUrl" target="_blank" rel="noopener">@attachment.FileName</a>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">@commentsLabel (@Model.Comments.Count)</div>
            <div class="card-body">
                @if (Model.Comments.Any())
                {
                    <ul class="list-unstyled mb-4">
                        @foreach (var comment in Model.Comments)
                        {
                            <li class="passon-comment mb-3">
                                <div class="d-flex gap-3">
                                    <div class="flex-shrink-0">
                                        <partial name="_UserAvatar" model="comment.CreatorAvatar" />
                                    </div>
                                    <div class="flex-grow-1">
                                        @{
                                            var commentLocal = TimeZoneService.ConvertToUserTime(comment.CreatedAt);
                                            var commentBody = await Html.DisplayTranslatedTextAsync(
                                                "PassOnLogComment",
                                                comment.Id.ToString(CultureInfo.InvariantCulture),
                                                "Body",
                                                comment.Body);
                                        }
                                        <div class="passon-comment__header">
                                            <div class="fw-semibold mb-0">@comment.CreatorName</div>
                                            <div class="text-muted small">@commentLocal.ToString("g")</div>
                                        </div>
                                        <div class="passon-comment__body rich-text-output">@Html.Raw(RichTextRenderer.ToHtml(commentBody))</div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No comments yet.</p>
                }

                <form asp-action="AddComment" method="post" class="card" enctype="multipart/form-data">
                    <div class="card-body">
                        <input type="hidden" asp-for="NewComment.LogId" />
                        <div class="mb-3">
                            <label asp-for="NewComment.Body" class="form-label"></label>
                            <textarea asp-for="NewComment.Body"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Share an update or clarification..."
                                      data-enable-mentions="true"
                                      data-rich-text="true"
                                      data-clipboard-upload-target="#passOnLogCommentFiles"></textarea>
                            <div class="form-text">Basic formatting works here too for quick emphasis. Paste images and they'll be attached below.</div>
                            <span asp-validation-for="NewComment.Body" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label for="passOnLogCommentFiles" class="form-label">Add images</label>
                            <input asp-for="NewComment.Files"
                                   type="file"
                                   id="passOnLogCommentFiles"
                                   class="form-control"
                                   accept="image/*"
                                   multiple />
                            <div class="form-text">@addImagesHelp</div>
                            <span asp-validation-for="NewComment.Files" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">@postCommentLabel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">@viewedByLabel</div>
            <div class="card-body">
                @if (Model.Viewers.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var viewer in Model.Viewers)
                        {
                            <li class="mb-2">
                                <div>@viewer.Name</div>
                                @{
                                    var viewedLocal = TimeZoneService.ConvertToUserTime(viewer.ViewedAt);
                                }
                                <div class="text-muted small">@viewedLocal.ToString("g")</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">@noViewersLabel</p>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .passon-details-card {
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .passon-details-card__header {
            position: sticky;
            top: calc(var(--main-header-height, 72px) + var(--space-card, 1.5rem));
            z-index: 15;
            background: var(--brand-surface, #fff);
            padding: 1.25rem var(--space-card-inner);
            border-bottom: calc(1px * var(--ui-scale, 1)) solid var(--brand-border, #d6dae1);
            box-shadow: 0 calc(16px * var(--ui-scale, 1)) calc(32px * var(--ui-scale, 1)) rgba(10, 34, 71, 0.08);
        }

        .passon-details-card__body {
            min-height: 0;
        }

        .passon-details-actions form {
            display: inline-flex;
        }

        .passon-details-bottom-nav {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            align-items: center;
            padding-top: 1rem;
            margin-top: 1.5rem;
            border-top: 1px solid rgba(13, 110, 253, 0.12);
        }

        .passon-details-bottom-nav .btn {
            max-width: 100%;
        }

        @@media (min-width: 768px) {
            .passon-details-card {
                max-height: calc(100vh - var(--main-header-height, 72px) - (var(--space-card, 1.5rem) * 2) - 1rem);
            }

            .passon-details-card__body {
                flex: 1 1 auto;
                overflow-y: auto;
                padding-right: 0.75rem;
                scrollbar-gutter: stable;
            }
        }

        @@media (max-width: 575.98px) {
            .passon-details-bottom-nav .btn {
                flex: 1 1 100%;
            }
        }

        .passon-comment {
            border: 1px solid rgba(13, 110, 253, 0.15);
            border-radius: 0.85rem;
            background-color: #fafbff;
            padding: 0.75rem 0.9rem;
        }

        .passon-comment__header {
            background: linear-gradient(135deg, rgba(13, 110, 253, 0.12), rgba(13, 110, 253, 0.03));
            border-radius: 0.65rem;
            padding: 0.5rem 0.75rem;
            margin-bottom: 0.75rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 0.35rem;
        }

        .passon-comment__body {
            color: #1f2937;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
