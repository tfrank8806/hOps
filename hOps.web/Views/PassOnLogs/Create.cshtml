@model hOps.web.ViewModels.PassOnLogFormViewModel
@{
    ViewData["Title"] = "New Pass On Log";
}

<h2 class="mb-4">New Pass On Log</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="card" id="passOnLogForm">
    <div class="card-body">
        <partial name="_LogForm" model="Model" />
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">@Html.Localize("Cancel")</a>
        <button type="submit" class="btn btn-primary" data-submit-btn="true" data-loading-text="Saving...">Save Log</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('passOnLogForm');
            const submitBtn = form?.querySelector('[data-submit-btn="true"]');
            if (!form || !submitBtn) {
                return;
            }

            form.addEventListener('submit', (event) => {
                if (submitBtn.disabled) {
                    event.preventDefault();
                    return;
                }

                submitBtn.disabled = true;
                const loadingText = submitBtn.dataset.loadingText || 'Saving...';
                submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>${loadingText}`;
            });
        })();
    </script>
}

