@using System.Globalization
@using System.Text.Json
@model hOps.web.ViewModels.PassOnLogIndexViewModel
@{
    var localizedTitle = Html.Localize("PassOnLogs.Title", "Pass On Logs").ToString();
    ViewData["Title"] = localizedTitle;
    ViewData["MainContainerClass"] = "main-inner--wide";
    var hasActiveFilters =
        Model.Filters.StartDate.HasValue ||
        Model.Filters.EndDate.HasValue ||
        (Model.Filters.CreatorIds?.Any() ?? false) ||
        (Model.Filters.PropertyIds?.Any() ?? false) ||
        !string.IsNullOrWhiteSpace(Model.Filters.SearchTerm) ||
        !string.Equals(Model.Filters.SortOrder, "newest", StringComparison.OrdinalIgnoreCase) ||
        Model.Filters.ShowUnreadOnly;
    var filterCollapseClass = hasActiveFilters ? "collapse show" : "collapse";
    var hideFiltersText = Html.Localize("PassOnLogs.Filters.Hide", "Hide Filters").ToString();
    var showFiltersText = Html.Localize("PassOnLogs.Filters.Show", "Show Filters").ToString();
    var filterToggleText = hasActiveFilters ? hideFiltersText : showFiltersText;
    var sortLabel = Html.Localize("PassOnLogs.Filters.Sort", "Sort").ToString();
    var fromLabel = Html.Localize("PassOnLogs.Filters.From", "From").ToString();
    var toLabel = Html.Localize("PassOnLogs.Filters.To", "To").ToString();
    var creatorLabel = Html.Localize("PassOnLogs.Filters.Creator", "Creator").ToString();
    var propertyLabel = Html.Localize("PassOnLogs.Filters.Property", "Property").ToString();
    var keywordLabel = Html.Localize("PassOnLogs.Filters.Keyword", "Keyword").ToString();
    var allCreatorsLabel = Html.Localize("PassOnLogs.Filters.AllCreators", "All creators").ToString();
    var allPropertiesLabel = Html.Localize("PassOnLogs.Filters.AllProperties", "All properties").ToString();
    var searchPlaceholder = Html.Localize("PassOnLogs.Filters.SearchPlaceholder", "Search title or body").ToString();
    var unreadOnlyLabel = Html.Localize("PassOnLogs.Filters.UnreadOnly", "Unread only").ToString();
    var resetLabel = Html.Localize("Common.Reset", "Reset").ToString();
    var applyLabel = Html.Localize("Common.Apply", "Apply").ToString();
    var newLogLabel = Html.Localize("PassOnLogs.Actions.NewLog", "New Log").ToString();
    var noLogsMessage = Html.Localize("PassOnLogs.Empty", "No logs matched the selected filters.").ToString();
    var byLabel = Html.Localize("PassOnLogs.ByLabel", "By").ToString();
    var propertiesLabel = Html.Localize("PassOnLogs.PropertiesLabel", "Properties:").ToString();
    var unreadLabel = Html.Localize("PassOnLogs.Unread", "Unread").ToString();
    var commentSingularLabel = Html.Localize("PassOnLogs.CommentSingular", "comment").ToString();
    var commentPluralLabel = Html.Localize("PassOnLogs.CommentPlural", "comments").ToString();
}

@section Scripts {
    <script>
        (() => {
            const collapseElement = document.getElementById('passOnLogFilters');
            const toggleButton = document.getElementById('passOnLogFiltersToggle');
            if (!collapseElement || !toggleButton) {
                return;
            }

            const hideLabel = toggleButton.getAttribute('data-hide-label') || @JsonSerializer.Serialize(hideFiltersText);
            const showLabel = toggleButton.getAttribute('data-show-label') || @JsonSerializer.Serialize(showFiltersText);

            const updateLabel = () => {
                const isShown = collapseElement.classList.contains('show');
                toggleButton.textContent = isShown ? hideLabel : showLabel;
                toggleButton.setAttribute('aria-expanded', isShown ? 'true' : 'false');
            };

            collapseElement.addEventListener('shown.bs.collapse', updateLabel);
            collapseElement.addEventListener('hidden.bs.collapse', updateLabel);
            updateLabel();
        })();
    </script>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">@localizedTitle</h2>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#passOnLogFilters"
                aria-expanded="@(hasActiveFilters ? "true" : "false")"
                aria-controls="passOnLogFilters"
                id="passOnLogFiltersToggle"
                data-hide-label="@hideFiltersText"
                data-show-label="@showFiltersText">
            @filterToggleText
        </button>
        @if (Model.CanCreateLog)
        {
            <a asp-action="Create" class="btn btn-primary">@newLogLabel</a>
        }
    </div>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<form method="get" class="card mb-4 @filterCollapseClass" id="passOnLogFilters">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-sm-6 col-md-3 col-lg-2">
                <label class="form-label" for="SortOrder">@sortLabel</label>
                <select class="form-select" id="SortOrder" name="SortOrder">
                    @foreach (var option in Model.Filters.SortOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@Html.Localize($"PassOnLogs.Filters.SortOptions.{option.Value}", option.Text)</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-md-3 col-lg-2">
                <label class="form-label" for="StartDate">@fromLabel</label>
                <input type="date" class="form-control" id="StartDate" name="StartDate" value="@Model.Filters.StartDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-sm-6 col-md-3 col-lg-2">
                <label class="form-label" for="EndDate">@toLabel</label>
                <input type="date" class="form-control" id="EndDate" name="EndDate" value="@Model.Filters.EndDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-sm-6 col-md-6 col-lg-3">
                <label class="form-label" for="CreatorIds">@creatorLabel</label>
                <select class="form-select js-checkbox-multiselect"
                        id="CreatorIds"
                        name="CreatorIds"
                        multiple
                        data-placeholder="@allCreatorsLabel"
                        data-all-label="@allCreatorsLabel">
                    @foreach (var option in Model.Filters.CreatorOptions)
                    {
                        if (string.IsNullOrWhiteSpace(option.Value))
                        {
                            continue;
                        }
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-md-6 col-lg-3">
                <label class="form-label" for="PropertyIds">@propertyLabel</label>
                <select class="form-select js-checkbox-multiselect"
                        id="PropertyIds"
                        name="PropertyIds"
                        multiple
                        data-placeholder="@allPropertiesLabel"
                        data-all-label="@allPropertiesLabel">
                    @foreach (var property in Model.Filters.PropertyOptions)
                    {
                        var propertyIdString = property.Id.ToString(CultureInfo.InvariantCulture);
                        var translatedPropertyName = await Html.DisplayTranslatedTextAsync("Property", propertyIdString, "Name", property.Name);
                        var propertyNameDisplay = string.IsNullOrWhiteSpace(translatedPropertyName) ? property.Name : translatedPropertyName;
                        var label = string.IsNullOrWhiteSpace(property.Code)
                            ? propertyNameDisplay
                            : string.Format(CultureInfo.CurrentCulture, "{0} ({1})", propertyNameDisplay, property.Code);
                        <option value="@property.Id" selected="@(property.IsSelected ? "selected" : null)">@label</option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-4">
                <label class="form-label" for="SearchTerm">@keywordLabel</label>
                <input type="text" class="form-control" id="SearchTerm" name="SearchTerm" value="@Model.Filters.SearchTerm" placeholder="@searchPlaceholder" />
            </div>
            <div class="col-sm-6 col-md-3 col-lg-2 d-flex align-items-center">
                <div class="form-check mt-4 pt-2">
                    <input type="hidden" name="ShowUnreadOnly" value="false" />
                    <input class="form-check-input"
                           type="checkbox"
                           id="ShowUnreadOnly"
                           name="ShowUnreadOnly"
                           value="true"
                           @(Model.Filters.ShowUnreadOnly ? "checked" : null) />
                    <label class="form-check-label" for="ShowUnreadOnly">@unreadOnlyLabel</label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">@resetLabel</a>
        <button type="submit" class="btn btn-primary">@applyLabel</button>
    </div>
</form>

@if (!Model.Logs.Any())
{
    <div class="alert alert-info">@noLogsMessage</div>
}
else
{
    <div class="list-group">
        @foreach (var log in Model.Logs)
        {
            var logId = log.Id.ToString(CultureInfo.InvariantCulture);
            var displayTitle = await Html.DisplayTranslatedTextAsync("PassOnLog", logId, "Title", log.Title);
            var displayPreview = await Html.DisplayTranslatedTextAsync("PassOnLog", logId, "Preview", log.Preview);
            var commentLabel = log.CommentCount == 1 ? commentSingularLabel : commentPluralLabel;
            var createdLocal = TimeZoneService.ConvertToUserTime(log.CreatedAt);
            var propertyDisplayNames = new List<string>();
            if (log.Properties != null)
            {
                foreach (var property in log.Properties)
                {
                    var propertyIdString = property.Id.ToString(CultureInfo.InvariantCulture);
                    var translatedPropertyName = await Html.DisplayTranslatedTextAsync("Property", propertyIdString, "Name", property.Name);
                    var propertyNameDisplay = string.IsNullOrWhiteSpace(translatedPropertyName) ? property.Name : translatedPropertyName;
                    var propertyEntry = string.IsNullOrWhiteSpace(property.Code)
                        ? propertyNameDisplay
                        : string.Format(CultureInfo.CurrentCulture, "{0} ({1})", propertyNameDisplay, property.Code);
                    if (!string.IsNullOrWhiteSpace(propertyEntry))
                    {
                        propertyDisplayNames.Add(propertyEntry);
                    }
                }
            }
            var propertiesDisplay = string.Join(", ", propertyDisplayNames);
            <a asp-action="Details" asp-route-id="@log.Id" class="list-group-item list-group-item-action log-list-item @(log.IsUnread ? "log-unread" : string.Empty)">
                <div class="d-flex gap-3 align-items-start">
                    <div class="flex-shrink-0">
                        <partial name="_UserAvatar" model="log.CreatorAvatar" />
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div>
                                <h5 class="mb-1">@displayTitle</h5>
                                <div class="text-muted small">
                                    @byLabel @log.CreatorName
                                    <span class="text-secondary" aria-hidden="true">&bull;</span>
                                    @createdLocal.ToString("g")
                                </div>
                            </div>
                            @if (log.IsUnread)
                            {
                                <span class="badge bg-primary align-self-start">@unreadLabel</span>
                            }
                        </div>
                        <p class="mb-2 text-muted">@displayPreview</p>
                        <div class="d-flex flex-wrap gap-2 small text-muted">
                            @if (!string.IsNullOrWhiteSpace(propertiesDisplay))
                            {
                                <span><strong>@propertiesLabel</strong> @propertiesDisplay</span>
                                <span class="text-secondary" aria-hidden="true">&bull;</span>
                            }
                            <span>@log.CommentCount @commentLabel</span>
                        </div>
                    </div>
                </div>
            </a>
        }
    </div>
}


