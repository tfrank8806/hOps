@model hOps.web.ViewModels.Home.HomeIndexViewModel
@{
    Layout = null;
    ViewData["Title"] = "Hotel Layout";
    ViewData["HideHotelLayoutLegend"] = true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidgetStyles.cshtml")
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            background: transparent;
            overflow: hidden;
        }

        body {
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
        }

        .hotel-layout-panel-shell {
            height: 100%;
            padding: 0.4rem 0.75rem 0.6rem;
            display: flex;
            flex-direction: column;
        }

        .hotel-layout-panel-shell .content-surface {
            height: 100%;
            margin: 0;
            border-radius: 1.25rem;
            padding: 0.85rem;
            box-shadow: var(--brand-shadow, 0 20px 45px rgba(9, 33, 80, 0.18));
        }

        .hotel-layout-panel-shell .card,
        .hotel-layout-panel-shell .card-body {
            height: 100%;
        }

        .hotel-layout-panel-shell .card-body {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            overflow: hidden;
        }

        .hotel-layout-panel-shell #layoutWidget {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .hotel-layout-panel-shell #layoutWidget .layout-view {
            flex: 1;
            overflow: auto;
        }
    </style>
</head>
<body class="hotel-layout-panel-body">
    <div class="hotel-layout-panel-shell hotel-layout-fullscreen">
        @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidget.cshtml", Model)
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidgetScripts.cshtml")
</body>
</html>
