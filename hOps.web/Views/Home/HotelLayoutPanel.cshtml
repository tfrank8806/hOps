@model hOps.web.ViewModels.Home.HomeIndexViewModel
@{
    Layout = null;
    ViewData["Title"] = "Hotel Layout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidgetStyles.cshtml")
</head>
<body class="bg-transparent">
    <div class="p-2">
        <div class="content-surface shadow-sm rounded-4 p-3">
            @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidget.cshtml", Model)
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidgetScripts.cshtml")
</body>
</html>
