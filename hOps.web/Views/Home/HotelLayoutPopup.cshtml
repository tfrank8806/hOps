@model hOps.web.ViewModels.Home.HomeIndexViewModel
@{
    Layout = null;
    var propertyName = Model.CurrentProperty?.Name;
    ViewData["Title"] = string.IsNullOrWhiteSpace(propertyName)
        ? "Hotel Layout"
        : $"Hotel Layout - {propertyName}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidgetStyles.cshtml")
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            background: var(--brand-page-bg, #eef2fb);
            overflow: hidden;
        }

        body {
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
        }

        .layout-popup-shell {
            min-height: 100%;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .layout-popup-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 1rem;
        }

        .layout-popup-header h1 {
            font-size: 1.5rem;
            margin: 0;
        }

        .layout-popup-surface {
            flex: 1;
            background: #fff;
            border-radius: 1.5rem;
            box-shadow: var(--brand-shadow, 0 24px 60px rgba(9, 33, 80, 0.12));
            padding: 1.25rem;
            overflow: hidden;
        }

        .layout-popup-surface .card,
        .layout-popup-surface .card-body {
            height: 100%;
        }

        .layout-popup-surface .card-body {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            overflow: hidden;
        }

        .layout-popup-surface #layoutWidget {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .layout-popup-surface #layoutWidget .layout-view {
            flex: 1;
            overflow: auto;
        }
    </style>
</head>
<body class="layout-popup-body">
    <div class="layout-popup-shell">
        <div class="layout-popup-header">
            <h1>Hotel Layout</h1>
            @if (!string.IsNullOrWhiteSpace(propertyName))
            {
                <span class="text-muted">@propertyName</span>
            }
        </div>
        <div class="layout-popup-surface hotel-layout-fullscreen">
            @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidget.cshtml", Model)
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidgetScripts.cshtml")
</body>
</html>
