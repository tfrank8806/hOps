@using System.Globalization
@using System.Linq
@using System.Text.Json
@using System.Text.Json.Serialization
@using hOps.web.Utilities
@using hOps.web.ViewModels.Home
@model hOps.web.ViewModels.Home.HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
    var property = Model.CurrentProperty;
    var hasProperty = property != null;
    ViewData["MainContainerClass"] = "main-inner--wide home-main-container";
    ViewData["ContentSurfaceClass"] = "content-surface--flush";
    const int widgetRowUnit = 24;
    const int widgetRowGap = 8;
    var layoutOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        Converters = { new JsonStringEnumConverter(JsonNamingPolicy.CamelCase) }
    };
    var initialLayoutJson = JsonSerializer.Serialize(Model.WidgetLayout ?? new List<HomeWidgetLayoutEntry>(), layoutOptions);
    var sizeOptionsPayload = new Dictionary<string, int>
    {
        ["full"] = 12,
        ["half"] = 6,
        ["third"] = 4,
        ["quarter"] = 3
    };
    var sizeOptionsJson = JsonSerializer.Serialize(sizeOptionsPayload);
    var definitionLookup = (Model.ActiveWidgetDefinitions ?? new List<HomeWidgetDefinition>())
        .ToDictionary(d => d.Id, d => d, System.StringComparer.OrdinalIgnoreCase);
    var heightOptionsPayload = new
    {
        minHeight = Model.WidgetHeightMin,
        maxHeight = Model.WidgetHeightMax,
        step = Model.WidgetHeightStep,
        tolerance = Model.WidgetHeightResetThreshold,
        defaultHeight = Model.WidgetHeightDefault
    };
    var heightOptionsJson = JsonSerializer.Serialize(heightOptionsPayload);
}

<form id="homeLayoutAntiforgery" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div class="home-dashboard">
    @if (TempData["HomeMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status" aria-live="polite">
            <span>@successMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["HomeError"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" aria-live="assertive">
            <span>@errorMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="home-layout-controls d-flex flex-wrap gap-3 mb-3 align-items-center">
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <button type="button" class="btn btn-outline-secondary" data-layout-action="start">Customize Layout</button>
            <div class="btn-group d-none" data-layout-editor>
                <button type="button" class="btn btn-primary" data-layout-action="save">Save Layout</button>
                <button type="button" class="btn btn-outline-secondary" data-layout-action="cancel">Cancel</button>
            </div>
            <button type="button" class="btn btn-link p-0 text-decoration-none" data-layout-help>
                <span class="me-1" aria-hidden="true">💡</span>Layout tips
            </button>
        </div>
        <div class="text-muted" data-layout-hint>
            Drag cards to reorder. Use the resize handle or height slider to change dimensions.
        </div>
    </div>

    <div class="modal fade" id="layoutHelpModal" tabindex="-1" aria-labelledby="layoutHelpModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="layoutHelpModalLabel">Customize your dashboard</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ol class="mb-3">
                        <li>Click <strong>Customize Layout</strong> to unlock drag &amp; resize controls.</li>
                        <li>Use the <em>six-dot</em> handle to drag widgets into a new order.</li>
                        <li>Grab the corner handle or adjust the Height slider for precise sizing.</li>
                        <li>Widgets snap to a 12-column grid—Full = 12, Half = 6, etc.</li>
                        <li>Press <strong>Save Layout</strong> to keep changes or <strong>Cancel</strong> to revert.</li>
                    </ol>
                    <p class="mb-0 text-muted">Tip: your layout is remembered per persona. Switching personas gives each team its own arrangement.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Got it</button>
                </div>
            </div>
        </div>
    </div>

    @if (Model.CanManageWidgets && Model.MarketplaceModules.Any())
    {
        <div class="card mb-3 d-none" data-widget-marketplace>
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h2 class="h6 mb-0">Widget Marketplace</h2>
                    <div class="text-muted small">Enable or disable dashboard modules for everyone.</div>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="UpdateWidgets" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    @foreach (var module in Model.MarketplaceModules)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="WidgetIds" value="@module.WidgetId" id="marketplace_@module.WidgetId" @(module.IsEnabled ? "checked" : string.Empty) />
                                <label class="form-check-label fw-semibold" for="marketplace_@module.WidgetId">@module.DisplayName</label>
                                @if (!string.IsNullOrWhiteSpace(module.Description))
                                {
                                    <div class="text-muted small">@module.Description</div>
                                }
                            </div>
                        </div>
                    }
                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-sm btn-primary">Save Modules</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="home-widget-grid" id="homeWidgetGrid"
         data-initial-layout='@Html.Raw(initialLayoutJson)'
         data-save-url="@(Url.Action("SaveWidgetLayout", "Home") ?? "#")"
         data-size-options='@Html.Raw(sizeOptionsJson)'
         data-height-options='@Html.Raw(heightOptionsJson)'
         data-persona="@Model.SelectedPersona"
         data-row-unit="@widgetRowUnit"
         data-row-gap="@widgetRowGap"
         style="--home-widget-row-size: @(widgetRowUnit)px; --home-widget-row-gap: @(widgetRowGap)px;">
        @foreach (var widget in Model.WidgetLayout)
        {
            var widgetId = widget.WidgetId ?? string.Empty;
            var forceFullWidth = string.Equals(widgetId, HomeWidgetIds.HotelLayout, StringComparison.OrdinalIgnoreCase);
            var effectiveSize = forceFullWidth ? HomeWidgetSize.Full : widget.Size;
            var sizeValue = effectiveSize.ToString().ToLowerInvariant();
            definitionLookup.TryGetValue(widgetId, out var widgetDefinition);
            var overrideSpan = widgetDefinition?.DefaultSpanOverride;
            var defaultSpan = forceFullWidth
                ? 12
                : (overrideSpan.HasValue && widgetDefinition?.DefaultSize == effectiveSize
                    ? overrideSpan.Value
                    : effectiveSize switch
                    {
                        HomeWidgetSize.Full => 12,
                        HomeWidgetSize.Half => 6,
                        HomeWidgetSize.Third => 4,
                        HomeWidgetSize.Quarter => 3,
                        _ => 4
                    });
            var storedSpan = widget.CustomSpan.HasValue ? Math.Clamp(widget.CustomSpan.Value, 1, 12) : (int?)null;
            var appliedSpan = forceFullWidth ? 12 : storedSpan ?? defaultSpan;
            var showCustomLabel = !forceFullWidth && storedSpan.HasValue && appliedSpan != defaultSpan;
            var sizeLabel = showCustomLabel ? $"Custom ({appliedSpan}/12)" : GetSizeLabel(effectiveSize);
            var defaultHeight = definitionLookup.TryGetValue(widgetId, out var definition) && definition?.DefaultHeight > 0
                ? definition.DefaultHeight
                : Model.WidgetHeightDefault;
            var sanitizedDefaultHeight = Math.Clamp(defaultHeight, Model.WidgetHeightMin, Model.WidgetHeightMax);
            var storedHeight = widget.CustomHeight.HasValue ? Math.Clamp(widget.CustomHeight.Value, Model.WidgetHeightMin, Model.WidgetHeightMax) : (int?)null;
            var appliedHeight = storedHeight ?? sanitizedDefaultHeight;
            var sizeLabelText = forceFullWidth ? $"{sizeLabel} (locked)" : sizeLabel;
            var heightLabelText = GetHeightLabel(appliedHeight, sanitizedDefaultHeight, storedHeight.HasValue);
            var rowSpan = Math.Max(1, (int)Math.Ceiling((double)(appliedHeight + widgetRowGap) / (widgetRowUnit + widgetRowGap)));
            var widgetStyle = $"--widget-span: {appliedSpan}; --widget-height: {appliedHeight}px; --widget-row-span: {rowSpan};";
            var spanOverrideAttribute = overrideSpan.HasValue
                ? $" data-span-override-{widgetDefinition?.DefaultSize.ToString().ToLowerInvariant()}=\"{overrideSpan.Value}\""
                : string.Empty;
            <div class="home-widget"
                 data-widget-id="@widget.WidgetId"
                 data-widget-size="@sizeValue"
                 data-grid-span="@appliedSpan"
                 data-grid-height="@appliedHeight"
                 data-grid-rows="@rowSpan"
                 data-default-height="@sanitizedDefaultHeight"
                 @(storedSpan.HasValue ? $"data-custom-span=\"{appliedSpan}\"" : string.Empty)
                 @(storedHeight.HasValue ? $"data-custom-height=\"{appliedHeight}\"" : string.Empty)
                 @(forceFullWidth ? "data-lock-width=\"true\"" : string.Empty)
                 @Html.Raw(spanOverrideAttribute)
                 style="@widgetStyle"
                 draggable="false">
                <div class="home-widget__editor d-flex align-items-center gap-2">
                    <span class="home-widget__drag-handle" role="button" tabindex="0" aria-label="Drag widget" title="Drag widget">⋮⋮</span>
                    <span class="home-widget__size-label" data-size-label>@sizeLabelText</span>
                    <span class="home-widget__height-label" data-height-label>@heightLabelText</span>
                    <div class="home-widget__height-slider">
                        <span class="text-muted small">Height</span>
                        <input type="range"
                               class="form-range form-range-sm"
                               min="@Model.WidgetHeightMin"
                               max="@Model.WidgetHeightMax"
                               step="@Model.WidgetHeightStep"
                               value="@appliedHeight"
                               draggable="false"
                               data-height-slider
                               aria-label="Widget height" />
                    </div>
                </div>
                <div class="home-widget__content">
                    @switch (widget.WidgetId)
                    {
                        case HomeWidgetIds.Announcements:
                            @await Html.PartialAsync("~/Views/Home/Widgets/_AnnouncementsWidget.cshtml", Model)
                            break;
                        case HomeWidgetIds.Bulletins:
                            @await Html.PartialAsync("~/Views/Home/Widgets/_BulletinWidget.cshtml", Model)
                            break;
                        case HomeWidgetIds.PassOnLogs:
                            @await Html.PartialAsync("~/Views/Home/Widgets/_PassOnLogsWidget.cshtml", Model)
                            break;
                        case HomeWidgetIds.PackageLog:
                            @await Html.PartialAsync("_HomeWidgetCard", new HomeWidgetViewModel(
                                "Package Log",
                                Model.PackageLogs.Cast<object>().ToList(),
                                "MailLog",
                                "Index",
                                createControllerName: "MailLog",
                                createActionName: "Index",
                                createButtonText: "+ New Package",
                                createFragment: "mailLogCreateForm"))
                            break;
                        case HomeWidgetIds.UpcomingEvents:
                            @await Html.PartialAsync("_HomeWidgetCard", new HomeWidgetViewModel(
                                "Upcoming Events",
                                Model.UpcomingEvents.Cast<object>().ToList(),
                                "Calendar",
                                "Index",
                                createControllerName: "Calendar",
                                createActionName: "Index",
                                createButtonText: "+ New Event",
                                createFragment: "calendarCreateForm"))
                            break;
                        case HomeWidgetIds.CalendarMonth:
                            @await Html.PartialAsync("~/Views/Home/Widgets/_CalendarMonthWidget.cshtml", Model)
                            break;
                        case HomeWidgetIds.WorkOrders:
                            @await Html.PartialAsync("~/Views/Home/Widgets/_WorkOrdersWidget.cshtml", Model)
                            break;
                        case HomeWidgetIds.OpsFeed:
                            @await Html.PartialAsync("~/Views/Home/Widgets/_OpsFeedWidget.cshtml", Model)
                            break;
                        case HomeWidgetIds.MySchedule:
                            @await Html.PartialAsync("~/Views/Home/Widgets/_MyScheduleWidget.cshtml", Model)
                            break;
                        case HomeWidgetIds.LostFound:
                            @await Html.PartialAsync("_HomeWidgetCard", new HomeWidgetViewModel(
                                "Lost & Found",
                                Model.LostFoundEntries.Cast<object>().ToList(),
                                "LostAndFound",
                                "Index",
                                createControllerName: "LostAndFound",
                                createActionName: "Index",
                                createButtonText: "+ New L&F Entry",
                                createFragment: "lostFoundEntryForm"))
                            break;
                        case HomeWidgetIds.HotelLayout:
                            @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidget.cshtml", Model)
                            break;
                        default:
                            <div class="card shadow-sm"><div class="card-body"><p class="text-muted mb-0">This widget is not supported.</p></div></div>
                            break;
                    }
                </div>
                <div class="home-widget__resize-edge home-widget__resize-edge--right" data-resize-handle data-resize-axis="horizontal" aria-hidden="true"></div>
                <div class="home-widget__resize-edge home-widget__resize-edge--bottom" data-resize-handle data-resize-axis="vertical" aria-hidden="true"></div>
                <button type="button" class="home-widget__resizer" data-resize-handle data-resize-axis="both" aria-label="Resize widget"></button>
            </div>
        }
    </div>
</div>

@functions {
    private static string GetSizeLabel(HomeWidgetSize size) => size switch
    {
        HomeWidgetSize.Full => "Full width",
        HomeWidgetSize.Half => "Half width",
        HomeWidgetSize.Third => "One third",
        HomeWidgetSize.Quarter => "One quarter",
        _ => "Custom width"
    };
    private static string GetHeightLabel(int appliedHeight, int defaultHeight, bool hasCustom) =>
        hasCustom ? $"Height: {appliedHeight}px" : $"Height: Default ({defaultHeight}px)";
}
<script>
    (() => {
        const grid = document.getElementById('homeWidgetGrid');
        if (!grid) {
            return;
        }

        const liveRegion = document.getElementById('pageLiveRegion');
        const announceStatus = (message) => {
            if (!liveRegion || typeof message !== 'string' || !message.trim()) {
                return;
            }
            liveRegion.textContent = '';
            liveRegion.textContent = message.trim();
        };
        const dashboard = grid.closest('.home-dashboard');
        const startButton = document.querySelector('[data-layout-action="start"]');
        const editorGroup = document.querySelector('[data-layout-editor]');
        const saveButton = document.querySelector('[data-layout-action="save"]');
        const cancelButton = document.querySelector('[data-layout-action="cancel"]');
        const hint = document.querySelector('[data-layout-hint]');
        const helpButton = document.querySelector('[data-layout-help]');
        const layoutHelpModalElement = document.getElementById('layoutHelpModal');
        const layoutHelpModal = layoutHelpModalElement && window.bootstrap
            ? bootstrap.Modal.getOrCreateInstance(layoutHelpModalElement)
            : null;
        const layoutTipsStorageKey = 'homeLayoutTipsShown';
        const marketplace = document.querySelector('[data-widget-marketplace]');
        if (marketplace) {
            const marketplaceForm = marketplace.querySelector('form');
            marketplaceForm?.addEventListener('submit', () => {
                announceStatus('Updating widget marketplace modules...');
            });
        }
        const sizeOptions = (() => {
            try {
                return JSON.parse(grid.dataset.sizeOptions || '{}');
            } catch {
                return {};
            }
        })();
        const sizeLabelMap = {
            full: 'Full width',
            half: 'Half width',
            third: 'One third',
            quarter: 'One quarter'
        };
        const selectedPersona = grid.dataset.persona || 'default';
        const sizeEntries = Object.entries(sizeOptions).map(([key, span]) => ({
            key,
            span: Number(span) || 4
        }));
        if (sizeEntries.length === 0) {
            sizeEntries.push(
                { key: 'full', span: 12 },
                { key: 'half', span: 6 },
                { key: 'third', span: 4 },
                { key: 'quarter', span: 3 }
            );
        }
        const heightOptions = (() => {
            try {
                return JSON.parse(grid.dataset.heightOptions || '{}');
            } catch {
                return {};
            }
        })();
        const MIN_HEIGHT = Number(heightOptions.minHeight) || 220;
        const MAX_HEIGHT = Number(heightOptions.maxHeight) || 900;
        const DEFAULT_HEIGHT = Number(heightOptions.defaultHeight) || 300;
        const HEIGHT_STEP = Number(heightOptions.step) || 10;
        const HEIGHT_TOLERANCE = Number(heightOptions.tolerance) || 6;
        const ROW_UNIT = Number(grid.dataset.rowUnit) || 30;
        const ROW_GAP = Number(grid.dataset.rowGap) || 0;
        const computedGridStyles = window.getComputedStyle(grid);
        const COLUMN_GAP = computedGridStyles ? parseFloat(computedGridStyles.columnGap || '0') || 0 : 0;

        const MIN_COLUMNS = 1;
        const MAX_COLUMNS = 12;
        const DEFAULT_SPAN = 4;

        const normalizeSizeKey = (key) => (key || 'third').toLowerCase();
        const clampSpan = (value) => {
            const numeric = Number(value);
            if (!Number.isFinite(numeric)) {
                return DEFAULT_SPAN;
            }
            return Math.min(MAX_COLUMNS, Math.max(MIN_COLUMNS, numeric));
        };
        const getDefaultSpanForSize = (sizeKey) => {
            const normalized = normalizeSizeKey(sizeKey);
            const span = Number(sizeOptions[normalized]);
            if (!Number.isFinite(span)) {
                return DEFAULT_SPAN;
            }
            return clampSpan(span);
        };
        const buildSpanOverrideKey = (sizeKey) => {
            if (typeof sizeKey !== 'string' || !sizeKey.length) {
                return null;
            }
            return `spanOverride${sizeKey.charAt(0).toUpperCase()}${sizeKey.slice(1)}`;
        };
        const getWidgetDefaultSpan = (widget, sizeKey) => {
            const normalized = normalizeSizeKey(sizeKey);
            if (widget) {
                const overrideKey = buildSpanOverrideKey(normalized);
                if (overrideKey && Object.prototype.hasOwnProperty.call(widget.dataset, overrideKey)) {
                    const overrideValue = Number(widget.dataset[overrideKey]);
                    if (Number.isFinite(overrideValue) && overrideValue > 0) {
                        return clampSpan(overrideValue);
                    }
                }
            }
            return getDefaultSpanForSize(normalized);
        };
        const setSizeLabelText = (widget, span) => {
            const label = widget.querySelector('[data-size-label]');
            if (!label) {
                return;
            }
            const sizeKey = normalizeSizeKey(widget.dataset.widgetSize);
            const defaultSpan = getWidgetDefaultSpan(widget, sizeKey);
            if (span === defaultSpan) {
                label.textContent = sizeLabelMap[sizeKey] ?? `~${span} cols`;
            } else {
                label.textContent = `Custom (${span}/12)`;
            }
        };
        const clampHeight = (value) => {
            const numeric = Number(value);
            if (!Number.isFinite(numeric)) {
                return DEFAULT_HEIGHT;
            }
            return Math.min(MAX_HEIGHT, Math.max(MIN_HEIGHT, numeric));
        };
        const syncHeightSlider = (widget, heightValue) => {
            if (!widget) {
                return;
            }
            const slider = widget.querySelector('[data-height-slider]');
            if (!slider) {
                return;
            }
            const nextValue = String(Math.round(heightValue));
            if (slider.value !== nextValue) {
                slider.value = nextValue;
            }
        };
        const initializeHeightSlider = (widget) => {
            if (!widget) {
                return;
            }
            const slider = widget.querySelector('[data-height-slider]');
            if (!slider) {
                return;
            }
            if (slider.dataset.heightSlider === 'true') {
                return;
            }
            const currentHeight = Number(widget.dataset.gridHeight || getDefaultHeight(widget));
            slider.min = slider.min || String(MIN_HEIGHT);
            slider.max = slider.max || String(MAX_HEIGHT);
            slider.step = slider.step || String(HEIGHT_STEP);
            slider.value = String(Math.round(clampHeight(currentHeight)));
            const applySliderValue = () => {
                const parsed = Number(slider.value);
                if (Number.isFinite(parsed)) {
                    updateWidgetHeight(widget, parsed);
                }
            };
            slider.addEventListener('input', applySliderValue);
            slider.addEventListener('change', () => {
                applySliderValue();
                persistLayoutSnapshot();
            });
            slider.dataset.heightSlider = 'true';

            const stopDrag = (event) => event.stopPropagation();
            slider.addEventListener('pointerdown', stopDrag);
            slider.addEventListener('pointermove', stopDrag);
            slider.addEventListener('mousedown', stopDrag);
            slider.addEventListener('touchstart', stopDrag);
            slider.addEventListener('touchmove', stopDrag);
            slider.addEventListener('click', (event) => event.stopPropagation());
        };
        const getDefaultHeight = (widget) => {
            if (!widget) {
                return DEFAULT_HEIGHT;
            }
            const candidate = Number(widget.dataset.defaultHeight);
            if (Number.isFinite(candidate) && candidate > 0) {
                return clampHeight(candidate);
            }
            return DEFAULT_HEIGHT;
        };
        const setHeightLabelText = (widget, heightValue) => {
            const label = widget.querySelector('[data-height-label]');
            if (!label) {
                return;
            }
            const defaultHeight = getDefaultHeight(widget);
            if (Math.abs(heightValue - defaultHeight) <= HEIGHT_TOLERANCE) {
                label.textContent = `Height: Default (${defaultHeight}px)`;
            } else {
                label.textContent = `Height: ${Math.round(heightValue)}px`;
            }
        };
        const computeRowSpan = (heightValue) => {
            const unit = ROW_UNIT > 0 ? ROW_UNIT : 30;
            const gap = ROW_GAP >= 0 ? ROW_GAP : 0;
            return Math.max(1, Math.ceil((heightValue + gap) / (unit + gap)));
        };
        const applyRowSpan = (widget, rows) => {
            if (!widget) {
                return;
            }
            const safeRows = Math.max(1, Math.round(rows));
            widget.dataset.gridRows = String(safeRows);
            widget.style.setProperty('--widget-row-span', safeRows);
        };
        const updateWidgetHeight = (widget, overrideHeight) => {
            if (!widget) {
                return;
            }
            const defaultHeight = getDefaultHeight(widget);
            const heightToApply = typeof overrideHeight === 'number' && Number.isFinite(overrideHeight)
                ? clampHeight(overrideHeight)
                : defaultHeight;
            if (Math.abs(heightToApply - defaultHeight) <= HEIGHT_TOLERANCE) {
                delete widget.dataset.customHeight;
            } else {
                widget.dataset.customHeight = String(Math.round(heightToApply));
            }
            widget.dataset.gridHeight = String(Math.round(heightToApply));
            widget.style.setProperty('--widget-height', `${heightToApply}px`);
            const rowsToApply = computeRowSpan(heightToApply);
            applyRowSpan(widget, rowsToApply);
            setHeightLabelText(widget, heightToApply);
            syncHeightSlider(widget, heightToApply);
        };

        const entryHasCustomizations = (entry) => {
            if (!entry) {
                return false;
            }
            const spanValue = Number(entry.customSpan);
            const heightValue = Number(entry.customHeight);
            return Number.isFinite(spanValue) || Number.isFinite(heightValue);
        };
        const layoutHasCustomizations = (layout) => Array.isArray(layout) && layout.some(entryHasCustomizations);

        grid.querySelectorAll('.home-widget').forEach(widget => {
            const initialHeight = Number(widget.dataset.customHeight || widget.dataset.gridHeight);
            if (Number.isFinite(initialHeight)) {
                updateWidgetHeight(widget, initialHeight);
            } else {
                updateWidgetHeight(widget);
            }
            initializeHeightSlider(widget);
        });

        let isEditing = false;
        let originalLayout = (() => {
            try {
                return JSON.parse(grid.dataset.initialLayout || '[]');
            } catch {
                return [];
            }
        })();
        const serverLayoutHasCustomizations = layoutHasCustomizations(originalLayout);
        let loadStoredLayout = () => null;
        let persistStoredLayout = () => { };
        let getCurrentLayout = () => [];
        let persistLayoutSnapshot = () => { };

        function applyLayout(layout) {
            const widgetMap = {};
            grid.querySelectorAll('.home-widget').forEach(widget => {
                widgetMap[widget.dataset.widgetId] = widget;
            });

            layout.forEach(entry => {
                const widget = widgetMap[entry.widgetId];
                if (!widget) {
                    return;
                }
                updateWidgetSize(
                    widget,
                    entry.size ?? widget.dataset.widgetSize ?? 'third',
                    typeof entry.customSpan === 'number' ? entry.customSpan : undefined);
                updateWidgetHeight(widget, typeof entry.customHeight === 'number' ? entry.customHeight : undefined);
                initializeHeightSlider(widget);
                grid.appendChild(widget);
            });
        }

        try {
            const storage = (() => {
                try {
                    return window.localStorage ?? window.sessionStorage ?? null;
                } catch {
                    return null;
                }
            })();
            const storageKey = `homeLayout:${selectedPersona}`;
            loadStoredLayout = () => {
                if (!storage) {
                    return null;
                }
                try {
                    const raw = storage.getItem(storageKey);
                    if (!raw) {
                        return null;
                    }
                    const parsed = JSON.parse(raw);
                    return Array.isArray(parsed) ? parsed : null;
                } catch {
                    return null;
                }
            };
            persistStoredLayout = (layout) => {
                if (!storage || !Array.isArray(layout) || layout.length === 0) {
                    return;
                }
                try {
                    storage.setItem(storageKey, JSON.stringify(layout));
                } catch {
                    // Ignore storage failures
                }
            };
            getCurrentLayout = () => {
                const layout = [];
                grid.querySelectorAll('.home-widget').forEach(widget => {
                    const customSpanValue = Number(widget.dataset.customSpan);
                    const heightValue = Number(widget.dataset.customHeight);
                    layout.push({
                        widgetId: widget.dataset.widgetId,
                        size: widget.dataset.widgetSize,
                        customSpan: Number.isFinite(customSpanValue) ? clampSpan(customSpanValue) : null,
                        customHeight: Number.isFinite(heightValue) ? clampHeight(heightValue) : null
                    });
                });
                return layout;
            };
            persistLayoutSnapshot = () => {
                const snapshot = getCurrentLayout();
                if (!layoutHasCustomizations(snapshot)) {
                    return;
                }
                persistStoredLayout(snapshot);
                syncLayoutFromCache(snapshot);
                originalLayout = snapshot;
            };

            const cachedLayout = loadStoredLayout();
            if (cachedLayout?.length) {
                applyLayout(cachedLayout);
                originalLayout = cachedLayout;
                if (layoutHasCustomizations(cachedLayout) && !serverLayoutHasCustomizations) {
                    syncLayoutFromCache(cachedLayout);
                }
            } else if (serverLayoutHasCustomizations) {
                persistStoredLayout(originalLayout);
            }
            window.addEventListener('beforeunload', persistLayoutSnapshot);
        } catch (error) {
            console.warn('Home layout persistence disabled:', error);
        }

        const getAntiforgeryToken = () => {
            const form = document.getElementById('homeLayoutAntiforgery');
            return form?.querySelector('input[name="__RequestVerificationToken"]')?.value;
        };

        const getClientStorage = () => {
            try {
                return window.localStorage ?? window.sessionStorage ?? null;
            } catch {
                return null;
            }
        };

        const hasSeenLayoutTips = () => {
            const storage = getClientStorage();
            if (!storage) {
                return false;
            }
            try {
                return storage.getItem(layoutTipsStorageKey) === '1';
            } catch {
                return false;
            }
        };

        const markLayoutTipsSeen = () => {
            const storage = getClientStorage();
            if (!storage) {
                return;
            }
            try {
                storage.setItem(layoutTipsStorageKey, '1');
            } catch {
                // ignore
            }
        };

        const showLayoutTips = (skipRecord = false) => {
            if (!layoutHelpModal) {
                return;
            }
            if (!skipRecord && !hasSeenLayoutTips()) {
                markLayoutTipsSeen();
            }
            layoutHelpModal.show();
        };

        async function syncLayoutFromCache(layout) {
            if (!Array.isArray(layout) || layout.length === 0) {
                return;
            }
            const saveUrl = grid.dataset.saveUrl;
            if (!saveUrl) {
                return;
            }
            const token = getAntiforgeryToken();
            try {
                await fetch(saveUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({
                        persona: selectedPersona,
                        widgets: layout
                    })
                });
                grid.dataset.initialLayout = JSON.stringify(layout);
            } catch {
                // Ignore background sync failures
            }
        }

        const setEditingState = (enabled) => {
            isEditing = enabled;
            grid.querySelectorAll('.home-widget').forEach(widget => {
                widget.setAttribute('draggable', enabled ? 'true' : 'false');
                widget.classList.toggle('home-widget--editing', enabled);
            });
            dashboard?.classList.toggle('home-dashboard--editing', enabled);
            if (marketplace) {
                marketplace.classList.toggle('d-none', !enabled);
            }
            if (enabled) {
                startButton?.classList.add('d-none');
                editorGroup?.classList.remove('d-none');
                hint?.classList.remove('d-none');
            } else {
                startButton?.classList.remove('d-none');
                editorGroup?.classList.add('d-none');
                hint?.classList.add('d-none');
            }
        };

        function updateWidgetSize(widget, sizeKey, overrideSpan) {
            if (!widget) {
                return;
            }
            const normalized = normalizeSizeKey(sizeKey);
            widget.dataset.widgetSize = normalized;
            const defaultSpan = getWidgetDefaultSpan(widget, normalized);
            const spanToApply = typeof overrideSpan === 'number' && Number.isFinite(overrideSpan)
                ? clampSpan(overrideSpan)
                : defaultSpan;
            if (spanToApply === defaultSpan) {
                delete widget.dataset.customSpan;
            } else {
                widget.dataset.customSpan = spanToApply;
            }
            widget.dataset.gridSpan = spanToApply;
            widget.style.setProperty('--widget-span', spanToApply);
            widget.style.gridColumn = `span ${spanToApply}`;
            setSizeLabelText(widget, spanToApply);
        }

        let dragSource = null;

        const getNearestSizeKey = (span) => {
            if (sizeEntries.length === 0) {
                return 'third';
            }

            let best = sizeEntries[0];
            for (const entry of sizeEntries) {
                if (Math.abs(entry.span - span) < Math.abs(best.span - span)) {
                    best = entry;
                }
            }

            return best.key;
        };

        const beginResize = (widget, axis, pointerDownEvent) => {
            if (!widget) {
                return;
            }

            pointerDownEvent.preventDefault();
            const startX = pointerDownEvent.clientX;
            const startY = pointerDownEvent.clientY;
            const initialSpan = Number(widget.dataset.customSpan || widget.dataset.gridSpan || getDefaultSpanForSize(widget.dataset.widgetSize));
            const initialHeight = Number(widget.dataset.gridHeight || getDefaultHeight(widget));
            const gridRect = grid.getBoundingClientRect();
            const usableWidth = gridRect.width - COLUMN_GAP * (MAX_COLUMNS - 1);
            const columnWidth = (MAX_COLUMNS > 0 ? usableWidth / MAX_COLUMNS : gridRect.width) || (gridRect.width / Math.max(1, MAX_COLUMNS));
            const lockWidth = widget.dataset.lockWidth === 'true';
            const allowHorizontal = axis === 'horizontal' || axis === 'both';
            const allowVertical = axis === 'vertical' || axis === 'both';

            const handlePointerMove = (event) => {
                if (!lockWidth && allowHorizontal) {
                    const deltaX = event.clientX - startX;
                    const rawSpan = initialSpan + (deltaX / columnWidth);
                    const constrained = clampSpan(rawSpan);
                    const snapped = clampSpan(Math.round(constrained));
                    const sizeKey = getNearestSizeKey(snapped);
                    updateWidgetSize(widget, sizeKey, snapped);
                }

                if (allowVertical) {
                    const deltaY = event.clientY - startY;
                    if (Math.abs(deltaY) > 0.5) {
                        const rawHeight = initialHeight + deltaY;
                        const snappedHeight = clampHeight(Math.round(rawHeight / HEIGHT_STEP) * HEIGHT_STEP);
                        updateWidgetHeight(widget, snappedHeight);
                    }
                }
            };

            const stopResize = () => {
                document.removeEventListener('pointermove', handlePointerMove);
                document.removeEventListener('pointerup', stopResize);
                document.removeEventListener('pointercancel', stopResize);
                persistLayoutSnapshot();
            };

            document.addEventListener('pointermove', handlePointerMove);
            document.addEventListener('pointerup', stopResize);
            document.addEventListener('pointercancel', stopResize);
        };

        grid.querySelectorAll('[data-resize-handle]').forEach(handle => {
            handle.addEventListener('pointerdown', (event) => {
                if (!isEditing) {
                    return;
                }
                const widget = handle.closest('.home-widget');
                if (!widget) {
                    return;
                }

                const axis = handle.dataset.resizeAxis || 'both';
                beginResize(widget, axis, event);
            });
        });

        grid.addEventListener('dragstart', (event) => {
            if (!isEditing) {
                event.preventDefault();
                return;
            }
            const widget = event.target.closest('.home-widget');
            if (!widget) {
                event.preventDefault();
                return;
            }
            dragSource = widget;
            widget.classList.add('home-widget--dragging');
            event.dataTransfer.effectAllowed = 'move';
            event.dataTransfer.setData('text/plain', widget.dataset.widgetId || '');
        });

        grid.addEventListener('dragend', () => {
            const dragging = grid.querySelector('.home-widget--dragging');
            if (dragging) {
                dragging.classList.remove('home-widget--dragging');
            }
            dragSource = null;
        });

        grid.addEventListener('dragover', (event) => {
            if (!isEditing) {
                return;
            }
            event.preventDefault();
            if (event.dataTransfer) {
                event.dataTransfer.dropEffect = 'move';
            }
            const target = event.target.closest('.home-widget');
            if (!dragSource || !target || dragSource === target) {
                return;
            }

            const bounding = target.getBoundingClientRect();
            const offset = event.clientY - bounding.top;
            const shouldInsertBefore = offset < bounding.height / 2;
            grid.insertBefore(dragSource, shouldInsertBefore ? target : target.nextSibling);
        });

        grid.addEventListener('drop', (event) => {
            if (!isEditing) {
                return;
            }
            event.preventDefault();
            persistLayoutSnapshot();
        });

        startButton?.addEventListener('click', () => {
            originalLayout = getCurrentLayout();
            setEditingState(true);
            if (!hasSeenLayoutTips()) {
                showLayoutTips();
            }
            announceStatus('Dashboard layout editing enabled.');
        });

        cancelButton?.addEventListener('click', () => {
            applyLayout(originalLayout);
            setEditingState(false);
            announceStatus('Layout changes canceled.');
        });

        saveButton?.addEventListener('click', async () => {
            const payload = {
                persona: selectedPersona,
                widgets: getCurrentLayout()
            };
            const token = getAntiforgeryToken();
            const saveUrl = grid.dataset.saveUrl;
            if (!saveUrl) {
                setEditingState(false);
                return;
            }

            try {
                const response = await fetch(saveUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    throw new Error('Unable to save layout.');
                }

                originalLayout = payload.widgets;
                grid.dataset.initialLayout = JSON.stringify(originalLayout);
                persistStoredLayout(originalLayout);
                setEditingState(false);
                announceStatus('Dashboard layout saved successfully.');
            }
            catch {
                alert('Unable to save your layout changes. Please try again.');
                announceStatus('Unable to save layout changes.');
            }
        });
        helpButton?.addEventListener('click', (event) => {
            event.preventDefault();
            if (layoutHelpModal) {
                layoutHelpModal.show();
            }
        });
    })();
</script>
@section Styles {
    @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidgetStyles.cshtml")
}


@section Scripts {
    @await Html.PartialAsync("~/Views/Home/Widgets/_HotelLayoutWidgetScripts.cshtml")
}

