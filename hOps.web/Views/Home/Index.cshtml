@using System.Globalization
@using System.Linq
@using System.Text.Json
@using hOps.web.Utilities
@model hOps.web.ViewModels.Home.HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
    var property = Model.CurrentProperty;
    var hasProperty = property != null;
    ViewData["MainContainerClass"] = "main-inner--wide home-main-container";
    ViewData["ContentSurfaceClass"] = "content-surface--flush";
}

<div class="home-dashboard">
    @if (TempData["HomeMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <span>@successMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["HomeError"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <span>@errorMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-12 col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h2 class="h5 mb-0">Manager Notes &amp; Announcements</h2>
                    @if (Model.CanManageAnnouncements && hasProperty)
                    {
                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#announcementEditor" aria-expanded="false" aria-controls="announcementEditor">
                            Edit
                        </button>
                    }
                </div>
                <div class="card-body">
                    @if (!hasProperty)
                    {
                        <p class="text-muted mb-0">Select a property to view announcements.</p>
                    }
                    else if (string.IsNullOrWhiteSpace(Model.Announcement.Content))
                    {
                        <p class="text-muted mb-0">No announcements yet. Managers and admins can add one using the edit button.</p>
                    }
                    else
                    {
                        <div class="announcement-content rich-text-output">@Html.Raw(RichTextRenderer.ToHtml(Model.Announcement.Content))</div>
                        @if (Model.Announcement.UpdatedAt.HasValue)
                        {
                            var updatedLocal = TimeZoneService.ConvertToUserTime(Model.Announcement.UpdatedAt.Value);
                            <p class="text-muted small mb-0 mt-2">Last updated @updatedLocal.ToString("g") @if (!string.IsNullOrWhiteSpace(Model.Announcement.UpdatedByName)){<text> by @Model.Announcement.UpdatedByName</text>}</p>
                        }
                    }

                    @if (hasProperty && Model.Announcement.Attachments.Any())
                    {
                        <div class="mt-3">
                            <h3 class="h6 mb-2">Attachments</h3>
                            <ul class="list-unstyled mb-0">
                                @foreach (var attachment in Model.Announcement.Attachments)
                                {
                                    <li class="mb-2">
                                        <a href="@attachment.DownloadUrl" target="_blank" rel="noopener">@attachment.FileName</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (Model.CanManageAnnouncements && hasProperty)
                    {
                        <div class="collapse mt-3" id="announcementEditor">
                            <form asp-action="UpdateAnnouncement" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PropertyId" value="@property!.Id" />
                                <div class="mb-3">
                                    <label for="announcementContent" class="form-label">Announcement</label>
                                    <textarea class="form-control" id="announcementContent" name="Content" rows="6" maxlength="4000" data-enable-mentions="true" data-rich-text="true">@Model.Announcement.Content</textarea>
                                    <div class="form-text">Use the toolbar for bold, italic, underline, lists, and quotes. Markdown shortcuts also work.</div>
                                </div>
                                @if (Model.Announcement.Attachments.Any())
                                {
                                    <div class="mb-3">
                                        <label class="form-label">Current Attachments</label>
                                        <ul class="list-unstyled mb-2">
                                            @foreach (var attachment in Model.Announcement.Attachments)
                                            {
                                                var checkboxId = $"announcementRemove_{attachment.Id}";
                                                <li class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-2">
                                                    <a href="@attachment.DownloadUrl" target="_blank" rel="noopener">@attachment.FileName</a>
                                                    <div class="form-check mb-0">
                                                        <input class="form-check-input" type="checkbox" name="AttachmentsToDelete" value="@attachment.Id" id="@checkboxId" />
                                                        <label class="form-check-label" for="@checkboxId">Remove</label>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                        <div class="form-text">Select remove to delete files when you save.</div>
                                    </div>
                                }
                                <div class="mb-3">
                                    <label class="form-label" for="announcementFiles">Add Attachments</label>
                                    <input class="form-control" type="file" id="announcementFiles" name="Files" multiple />
                                    <div class="form-text">Upload photos or documents to share with your team.</div>
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#announcementEditor">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save Announcement</button>
                                </div>
                            </form>
                        </div>
                    }

                    <div id="layoutRoomMenu" class="layout-room-menu shadow" aria-hidden="true">
                        <div class="layout-room-menu__header d-flex align-items-start justify-content-between">
                            <div>
                                <div class="layout-room-menu__title" data-room-name>Select a room</div>
                                <div class="layout-room-menu__meta text-muted small" data-room-floor></div>
                            </div>
                            <button type="button" class="btn-close" aria-label="Close room menu" data-close-room-menu></button>
                        </div>
                        <div class="layout-room-menu__body">
                            <div class="layout-room-menu__section">
                                <h6 class="layout-room-menu__section-title">Open Work Orders</h6>
                                <div class="layout-room-menu__workorders text-muted small" data-room-workorders>
                                    Select a room to review open work orders.
                                </div>
                            </div>
                            <div class="layout-room-menu__actions d-flex flex-column flex-sm-row gap-2">
                                <a class="btn btn-outline-primary btn-sm"
                                   href="@((Url.Action("Index", "WorkOrders") ?? "/WorkOrders"))"
                                   target="_blank"
                                   rel="noopener"
                                   data-view-workorders>
                                    View in Work Orders
                                </a>
                                <button type="button" class="btn btn-primary btn-sm" data-create-workorder disabled>
                                    Create Work Order
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="layoutWorkOrderModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Create Work Order</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <form id="layoutWorkOrderForm" method="post" novalidate>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="PropertyId" value="@(property?.Id ?? 0)" />
                                        <input type="hidden" name="RoomNumber" />
                                        <input type="hidden" name="RoomLabel" />
                                        <div class="mb-3">
                                            <label class="form-label">Room</label>
                                            <div class="form-control-plaintext fw-semibold" data-room-display>
                                                Select a room from the layout.
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="layoutWorkOrderIssue">Issue<span class="text-danger">*</span></label>
                                            <textarea class="form-control" id="layoutWorkOrderIssue" name="Issue" rows="3" required></textarea>
                                        </div>
                                        <div class="row g-3">
                                            <div class="col-sm-6">
                                                <label class="form-label" for="layoutWorkOrderType">Work Order Type</label>
                                                <select class="form-select" id="layoutWorkOrderType" name="WorkOrderTypeId">
                                                    <option value="">Unspecified</option>
                                                    @foreach (var type in Model.WorkOrderTypeOptions)
                                                    {
                                                        <option value="@type.Id">@type.Name</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-sm-6">
                                                <label class="form-label" for="layoutWorkOrderDepartment">Assign To</label>
                                                <select class="form-select" id="layoutWorkOrderDepartment" name="DepartmentId">
                                                    <option value="">Unassigned</option>
                                                    @foreach (var department in Model.DepartmentOptions)
                                                    {
                                                        <option value="@department.Id">@department.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="row g-3 mt-0">
                                            <div class="col-sm-6">
                                                <label class="form-label" for="layoutWorkOrderDueDate">Due Date</label>
                                                <input type="date"
                                                       class="form-control"
                                                       id="layoutWorkOrderDueDate"
                                                       name="DueDate"
                                                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                                       data-default-value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="layoutWorkOrderDetails">Details</label>
                                            <textarea class="form-control" id="layoutWorkOrderDetails" name="Details" rows="3"></textarea>
                                        </div>
                                        <div class="alert d-none" role="alert" data-form-status></div>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary">Submit Work Order</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-8">
            @{
                var showBulletinForm = TempData["ShowBulletinForm"] is bool showFlag && showFlag;
                var bulletinCollapseId = "bulletinFormCollapse";
            }
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex flex-column flex-md-row gap-2 align-items-start align-items-md-center justify-content-between">
                    <div>
                        <h2 class="h5 mb-0">Bulletin Board</h2>
                        @if (hasProperty)
                        {
                            <span class="text-muted small">Visible to everyone at @property!.Name</span>
                        }
                    </div>
                    <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#@bulletinCollapseId" aria-expanded="@(showBulletinForm ? "true" : "false")" aria-controls="@bulletinCollapseId" @(hasProperty ? string.Empty : "disabled")>
                        <span class="me-1" aria-hidden="true">+</span>
                        <span>New Bulletin</span>
                    </button>
                </div>
                <div class="card-body"
                     id="layoutWidget"
                     data-property-id="@(property?.Id ?? 0)"
                     data-room-summary-url="@Url.Action("GetRoomWorkOrders", "WorkOrders")"
                     data-room-create-url="@Url.Action("CreateFromLayout", "WorkOrders")"
                     data-workorders-url="@Url.Action("Index", "WorkOrders")">
                    @if (!hasProperty)
                    {
                        <p class="text-muted mb-0">Select a property to collaborate with your team.</p>
                    }
                    else
                    {
                        <div class="collapse bulletin-form-collapse @(showBulletinForm ? "show" : string.Empty)" id="@bulletinCollapseId">
                            <div class="border rounded-3 bg-light-subtle p-3 p-md-4 mb-4">
                                <form asp-action="CreateBulletin" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="PropertyId" value="@property!.Id" />
                                    <div class="mb-3">
                                        <label for="newBulletinContent" class="form-label">Share an update</label>
                                        <textarea class="form-control" id="newBulletinContent" name="Content" rows="3" maxlength="2000" placeholder="Add a note for the team" required data-enable-mentions="true" data-rich-text="true"></textarea>
                                        <div class="form-text">Formatting supports bold, italic, underline, lists, and quotes to highlight key details. Use Shift + Enter to create a new line.</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="newBulletinFiles">Attachments (optional)</label>
                                        <input class="form-control" type="file" id="newBulletinFiles" name="Files" multiple />
                                        <div class="form-text">Add photos or documents to give more context.</div>
                                    </div>
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#@bulletinCollapseId" aria-controls="@bulletinCollapseId">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Post to Bulletin</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        @if (!Model.BulletinPosts.Any())
                        {
                            <p class="text-muted mb-0">No bulletin posts yet. Start the conversation above.</p>
                        }
                        else
                        {
                            <div class="bulletin-list">
                                @foreach (var post in Model.BulletinPosts)
                                {
                                    var collapseId = $"editBulletin_{post.Id}";
                                    <article class="bulletin-item mb-4 p-3 border rounded-3">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h3 class="h6 mb-1">@(!string.IsNullOrWhiteSpace(post.CreatedByName) ? post.CreatedByName : "Team Member")</h3>
                                                @{
                                                    var createdLocal = TimeZoneService.ConvertToUserTime(post.CreatedAt);
                                                    var updatedLocal = post.UpdatedAt.HasValue ? TimeZoneService.ConvertToUserTime(post.UpdatedAt.Value) : (DateTime?)null;
                                                }
                                                <p class="mb-2 text-muted small">Posted @createdLocal.ToString("g")
                                                @if (post.UpdatedAt.HasValue)
                                                {
                                                    <span class="ms-2">· Updated @updatedLocal?.ToString("g") @if (!string.IsNullOrWhiteSpace(post.UpdatedByName)){<text>by @post.UpdatedByName</text>}</span>
                                                }
                                                </p>
                                            </div>
                                            @if (post.CanEdit)
                                            {
                                                <div class="btn-group">
                                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">Edit</button>
                                                    <form asp-action="DeleteBulletin" method="post" onsubmit="return confirm('Remove this bulletin entry?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@post.Id" />
                                                        <input type="hidden" name="propertyId" value="@property!.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                        <div class="bulletin-content rich-text-output">@Html.Raw(RichTextRenderer.ToHtml(post.Content))</div>

                                        @if (post.Attachments.Any())
                                        {
                                            <div class="mt-2">
                                                <ul class="list-unstyled small mb-0">
                                                    @foreach (var attachment in post.Attachments)
                                                    {
                                                        <li class="mb-1">
                                                            <a href="@attachment.DownloadUrl" target="_blank" rel="noopener">@attachment.FileName</a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }

                                        @if (post.CanEdit)
                                        {
                                            <div class="collapse mt-3" id="@collapseId">
                                                <form asp-action="UpdateBulletin" method="post" enctype="multipart/form-data" class="border-top pt-3">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="Id" value="@post.Id" />
                                                    <input type="hidden" name="PropertyId" value="@property!.Id" />
                                                    <div class="mb-3">
                                                        <label class="form-label" for="bulletinContent_@post.Id">Edit message</label>
                                                        <textarea class="form-control" id="bulletinContent_@post.Id" name="Content" rows="3" maxlength="2000" data-enable-mentions="true" data-rich-text="true">@post.Content</textarea>
                                                        <div class="form-text">Use the toolbar to emphasize changes before saving.</div>
                                                    </div>
                                                    @if (post.Attachments.Any())
                                                    {
                                                        <div class="mb-3">
                                                            <label class="form-label">Current Attachments</label>
                                                            <ul class="list-unstyled mb-2">
                                                                @foreach (var attachment in post.Attachments)
                                                                {
                                                                    var checkboxId = $"bulletinRemove_{post.Id}_{attachment.Id}";
                                                                    <li class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-2">
                                                                        <a href="@attachment.DownloadUrl" target="_blank" rel="noopener">@attachment.FileName</a>
                                                                        <div class="form-check mb-0">
                                                                            <input class="form-check-input" type="checkbox" name="AttachmentsToDelete" value="@attachment.Id" id="@checkboxId" />
                                                                            <label class="form-check-label" for="@checkboxId">Remove</label>
                                                                        </div>
                                                                    </li>
                                                                }
                                                            </ul>
                                                            <div class="form-text">Select remove to delete existing files before saving.</div>
                                                        </div>
                                                    }
                                                    <div class="mb-3">
                                                        <label class="form-label" for="bulletinFiles_@post.Id">Add Attachments</label>
                                                        <input class="form-control" type="file" id="bulletinFiles_@post.Id" name="Files" multiple />
                                                        <div class="form-text">Attach additional files to share updated details.</div>
                                                    </div>
                                                    <div class="d-flex justify-content-end gap-2">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#@collapseId">Cancel</button>
                                                        <button type="submit" class="btn btn-primary">Save Changes</button>
                                                    </div>
                                                </form>
                                            </div>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12 col-xl-3">
            <partial name="_HomeWidgetCard" model='new hOps.web.ViewModels.HomeWidgetViewModel("Work Orders", Model.WorkOrders.Cast<object>().ToList(), "WorkOrders", "Index")' />
        </div>
        <div class="col-12 col-xl-3">
            <partial name="_HomeWidgetCard" model='new hOps.web.ViewModels.HomeWidgetViewModel("Lost & Found", Model.LostFoundEntries.Cast<object>().ToList(), "LostAndFound", "Index")' />
        </div>
        <div class="col-12 col-xl-3">
            <partial name="_HomeWidgetCard" model='new hOps.web.ViewModels.HomeWidgetViewModel("Package Log", Model.PackageLogs.Cast<object>().ToList(), "MailLog", "Index")' />
        </div>
        <div class="col-12 col-xl-3">
            <partial name="_HomeWidgetCard" model='new hOps.web.ViewModels.HomeWidgetViewModel("Upcoming Events", Model.UpcomingEvents.Cast<object>().ToList(), "Calendar", "Index")' />
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12">
            <partial name="_HomeWidgetCard" model='new hOps.web.ViewModels.HomeWidgetViewModel("Pass On Logs", Model.PassOnLogs.Cast<object>().ToList(), "PassOnLogs", "Index")' />
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h2 class="h5 mb-0">Hotel Layout</h2>
                </div>
                <div class="card-body">
                    @if (!hasProperty)
                    {
                        <p class="text-muted mb-0">Select a property to view room layouts and open items.</p>
                    }
                    else if (!Model.RoomTiles.Any())
                    {
                        <p class="text-muted mb-0">No layout has been configured for this property yet.</p>
                    }
                    else
                    {
                        var tilesByFloor = Model.RoomTiles.GroupBy(t => t.Floor).OrderBy(g => g.Key).ToList();
                        var floorLegend = tilesByFloor
                            .Select(g => new { Floor = g.Key, Color = g.First().FloorColor })
                            .ToList();
                        var maxWidthAll = Math.Max(1, tilesByFloor.SelectMany(g => g).Max(t => t.X + t.Width));
                        var maxHeightAll = Math.Max(1, tilesByFloor.SelectMany(g => g).Max(t => t.Y + t.Height));
                        var defaultFloor = tilesByFloor.First().Key;

                        <div class="layout-controls d-flex flex-column flex-lg-row align-items-lg-center justify-content-lg-between gap-3 mb-3">
                            <div class="btn-group btn-group-sm layout-view-toggle" role="group" aria-label="Layout view mode">
                                <input class="btn-check" type="radio" name="layoutViewMode" id="layoutViewOverlay" value="overlay" checked autocomplete="off">
                                <label class="btn btn-outline-primary" for="layoutViewOverlay">All Floors</label>
                                <input class="btn-check" type="radio" name="layoutViewMode" id="layoutViewSingle" value="single" autocomplete="off">
                                <label class="btn btn-outline-primary" for="layoutViewSingle">Individual Floor</label>
                            </div>
                            <div class="layout-legends d-flex flex-column flex-lg-row gap-3 text-muted small">
                                <div class="d-flex align-items-center gap-3">
                                    <span><span class="legend-swatch workorder"></span> Work Orders</span>
                                    <span><span class="legend-swatch lostfound"></span> Lost &amp; Found</span>
                                </div>
                                <div class="layout-floor-legend d-flex align-items-center gap-2 flex-wrap">
                                    @foreach (var floorInfo in floorLegend)
                                    {
                                        <span class="layout-floor-pill" style="--floor-color:@floorInfo.Color">Floor @floorInfo.Floor</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div id="layoutOverlayView" class="layout-view">
                            <div class="layout-canvas multi-floor" style="--layout-width:@maxWidthAll; --layout-height:@maxHeightAll;">
                                @foreach (var tile in Model.RoomTiles)
                                {
                                    var left = Math.Round((double)tile.X / maxWidthAll * 100, 2);
                                    var top = Math.Round((double)tile.Y / maxHeightAll * 100, 2);
                                    var width = Math.Round((double)tile.Width / maxWidthAll * 100, 2);
                                    var height = Math.Round((double)tile.Height / maxHeightAll * 100, 2);
                                    var overlayBg = $"{tile.FloorColor}33";
                                    var navigateUrl = tile.Badges.FirstOrDefault(b => !string.IsNullOrWhiteSpace(b.Url))?.Url ?? string.Empty;
                                    var isConnector = string.Equals(tile.ShapeType, "connector", StringComparison.OrdinalIgnoreCase);
                                    var isCustom = !isConnector && tile.RoomId == 0;
                                    var hasLabel = !string.IsNullOrWhiteSpace(tile.RoomNumber);
                                    var connectorDirection = string.Equals(tile.ShapeData, "horizontal", StringComparison.OrdinalIgnoreCase)
                                        ? "horizontal"
                                        : "vertical";
                                    var connectorDisplay = isConnector
                                        ? (hasLabel ? tile.RoomNumber : "||")
                                        : string.Empty;
                                    var ariaLabelBase = tile.RoomId == 0
                                        ? (isConnector
                                            ? $"Floor {tile.Floor.ToString(CultureInfo.InvariantCulture)} {connectorDirection} connector"
                                            : (hasLabel
                                                ? $"Floor {tile.Floor.ToString(CultureInfo.InvariantCulture)} {tile.RoomNumber}"
                                                : $"Floor {tile.Floor.ToString(CultureInfo.InvariantCulture)} custom area"))
                                        : (hasLabel
                                            ? $"Floor {tile.Floor.ToString(CultureInfo.InvariantCulture)} room {tile.RoomNumber}"
                                            : $"Floor {tile.Floor.ToString(CultureInfo.InvariantCulture)} room");
                                    var ariaLabel = tile.Badges.Any()
                                        ? $"{ariaLabelBase} with {string.Join(", ", tile.Badges.Select(b => b.Text))}"
                                        : ariaLabelBase;
                                    var isInteractiveRoom = tile.RoomId > 0 && !string.IsNullOrWhiteSpace(tile.LocationKey);
                                    <div class="@($"{tile.CssClass} room-tile-overlay{(isInteractiveRoom ? " room-tile-overlay--actionable" : string.Empty)}")"
                                         data-floor="@tile.Floor"
                                         data-shape-type="@tile.ShapeType"
                                         data-shape-data="@tile.ShapeData"
                                         data-room-id="@tile.RoomId"
                                         data-room-label="@tile.RoomNumber"
                                         data-room-number="@tile.LocationKey"
                                         data-room-floor="@tile.Floor"
                                         data-navigate-url="@navigateUrl"
                                         style="left:@left.ToString("0.##", CultureInfo.InvariantCulture)%;top:@top.ToString("0.##", CultureInfo.InvariantCulture)%;width:@width.ToString("0.##", CultureInfo.InvariantCulture)%;height:@height.ToString("0.##", CultureInfo.InvariantCulture)%;border-color:@tile.FloorColor;background-color:@overlayBg;"
                                         aria-label="@ariaLabel"
                                         tabindex="@(isInteractiveRoom || !string.IsNullOrWhiteSpace(navigateUrl) ? "0" : "-1")"
                                         @(isInteractiveRoom ? "role=\"button\" aria-haspopup=\"dialog\"" : (string.IsNullOrWhiteSpace(navigateUrl) ? null : "role=\"link\""))>
                                        @if (tile.Badges.Any())
                                        {
                                            <div class="tile-badges tile-badges--overlay">
                                                @foreach (var badge in tile.Badges)
                                                {
                                                    if (!string.IsNullOrWhiteSpace(badge.Url))
                                                    {
                                                        <a class="badge rounded-pill text-bg-@badge.Variant" href="@badge.Url">@badge.Text</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge rounded-pill text-bg-@badge.Variant">@badge.Text</span>
                                                    }
                                                }
                                            </div>
                                        }
                                        @if (isConnector)
                                        {
                                            <span class="tile-label">@connectorDisplay</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div id="layoutPerFloorView" class="layout-view d-none">
                            <div class="btn-group btn-group-sm layout-floor-selector mb-3" role="group" aria-label="Select floor">
                                @foreach (var floorGroup in tilesByFloor)
                                {
                                    var isActive = floorGroup.Key == defaultFloor;
                                    <input class="btn-check" type="radio" name="singleFloorOption" id="singleFloor_@floorGroup.Key" value="@floorGroup.Key" autocomplete="off" @(isActive ? "checked" : null)>
                                    <label class="btn btn-outline-secondary" for="singleFloor_@floorGroup.Key">Floor @floorGroup.Key</label>
                                }
                            </div>

                            @foreach (var floorGroup in tilesByFloor)
                            {
                                var maxWidth = Math.Max(1, floorGroup.Max(t => t.X + t.Width));
                                var maxHeight = Math.Max(1, floorGroup.Max(t => t.Y + t.Height));
                                var isActive = floorGroup.Key == defaultFloor;
                                <section class="layout-floor-section mb-4 @(isActive ? string.Empty : "d-none")" data-floor="@floorGroup.Key">
                                    <header class="d-flex align-items-center justify-content-between mb-2">
                                        <h3 class="h6 mb-0">Floor @floorGroup.Key</h3>
                                        <span class="text-muted small">@floorGroup.Count() tile@(floorGroup.Count() == 1 ? string.Empty : "s")</span>
                                    </header>
                                    <div class="layout-canvas" style="--layout-width:@maxWidth; --layout-height:@maxHeight;">
                                        @foreach (var tile in floorGroup)
                                        {
                                            var left = Math.Round((double)tile.X / maxWidth * 100, 2);
                                            var top = Math.Round((double)tile.Y / maxHeight * 100, 2);
                                            var width = Math.Round((double)tile.Width / maxWidth * 100, 2);
                                            var height = Math.Round((double)tile.Height / maxHeight * 100, 2);
                                        var isConnector = string.Equals(tile.ShapeType, "connector", StringComparison.OrdinalIgnoreCase);
                                        var isCustom = !isConnector && tile.RoomId == 0;
                                        var hasTileLabel = !string.IsNullOrWhiteSpace(tile.RoomNumber);
                                        var connectorDirection = string.Equals(tile.ShapeData, "horizontal", StringComparison.OrdinalIgnoreCase) ? "horizontal" : "vertical";
                                        var connectorDisplay = isConnector
                                            ? (hasTileLabel ? tile.RoomNumber : "||")
                                            : string.Empty;
                                        var headerHasContent = hasTileLabel || (!isCustom && !string.IsNullOrWhiteSpace(tile.RoomType));
                                        var isInteractiveRoom = !isConnector && tile.RoomId > 0 && !string.IsNullOrWhiteSpace(tile.LocationKey);
                                        var tileClasses = isInteractiveRoom ? $"{tile.CssClass} room-tile--actionable" : tile.CssClass;
                                            <div class="@tileClasses"
                                                 data-shape-type="@tile.ShapeType"
                                                 data-shape-data="@tile.ShapeData"
                                                 data-room-id="@tile.RoomId"
                                                 data-room-label="@tile.RoomNumber"
                                                 data-room-number="@tile.LocationKey"
                                                 data-room-floor="@tile.Floor"
                                                 tabindex="@(isInteractiveRoom ? "0" : "-1")"
                                                 @(isInteractiveRoom ? "role=\"button\" aria-haspopup=\"dialog\"" : null)
                                                 style="left:@left.ToString("0.##", CultureInfo.InvariantCulture)%;top:@top.ToString("0.##", CultureInfo.InvariantCulture)%;width:@width.ToString("0.##", CultureInfo.InvariantCulture)%;height:@height.ToString("0.##", CultureInfo.InvariantCulture)%">
                                                @if (isConnector)
                                                {
                                                    <span class="tile-connector-icon tile-connector-icon--@connectorDirection">@connectorDisplay</span>
                                                }
                                                else
                                                {
                                                    @if (headerHasContent)
                                                    {
                                                        <div class="tile-header">
                                                            @if (hasTileLabel)
                                                            {
                                                                <span class="tile-room">@tile.RoomNumber</span>
                                                            }
                                                            @if (!isCustom && !string.IsNullOrWhiteSpace(tile.RoomType))
                                                            {
                                                                <span class="tile-type">@tile.RoomType</span>
                                                            }
                                                        </div>
                                                    }
                                                    @if (tile.Badges.Any())
                                                    {
                                                        <div class="tile-badges">
                                                            @foreach (var badge in tile.Badges)
                                                            {
                                                                if (!string.IsNullOrEmpty(badge.Url))
                                                                {
                                                                    <a class="badge rounded-pill text-bg-@badge.Variant" href="@badge.Url">@badge.Text</a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge rounded-pill text-bg-@badge.Variant">@badge.Text</span>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

