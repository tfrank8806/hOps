            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            text-align: center;
            line-height: 1.2;
            word-break: break-word;
            transform: rotate(var(--tile-text-rotation, 0deg));
            transform-origin: center;
        }

        .tile-type {
            font-size: 0.85rem;
            color: #64748b;
        }

        .tile-badges {
            display: flex;
            gap: 0.35rem;
            flex-wrap: wrap;
        }

        .room-tile-overlay--actionable,
        .room-tile--actionable {
            cursor: pointer;
        }

        .room-tile-overlay--active,
        .room-tile--active {
            outline: 3px solid rgba(13, 110, 253, 0.35);
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.15);
        }

        .layout-room-menu {
            position: absolute;
            min-width: 300px;
            max-width: 360px;
            background: #fff;
            border-radius: 0.85rem;
            border: 1px solid rgba(15, 46, 97, 0.12);
            box-shadow: 0 24px 50px rgba(15, 46, 97, 0.2);
            padding: 1rem;
            display: none;
            z-index: 1300;
            max-height: min(70vh, 480px);
            overflow-y: auto;
        }

        .layout-room-menu.show {
            display: block;
        }

        .layout-room-menu__title {
            font-weight: 600;
            font-size: 1.05rem;
        }

        .layout-room-menu__section {
            margin-bottom: 0.85rem;
        }

        .layout-room-menu__section-title {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #0f2e61;
            margin-bottom: 0.35rem;
        }

        .layout-room-menu__workorder-list li + li {
            margin-top: 0.6rem;
            padding-top: 0.55rem;
            border-top: 1px dashed rgba(148, 163, 184, 0.35);
        }

        .layout-room-menu__workorder-link {
            display: block;
            text-decoration: none;
            color: inherit;
        }

        .layout-room-menu__workorder-icon {
            width: 0.8rem;
            height: 0.8rem;
            border-radius: 999px;
            background: var(--dept-color, #dc3545);
            display: inline-flex;
