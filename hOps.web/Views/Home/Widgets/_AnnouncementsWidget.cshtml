@using System.Globalization
@using hOps.web.Utilities
@model hOps.web.ViewModels.Home.HomeIndexViewModel

@{
    var property = Model.CurrentProperty;
    var hasProperty = property != null;
    string EscapeTextareaValue(string? value) => string.IsNullOrEmpty(value)
        ? string.Empty
        : value.Replace("</textarea>", "&lt;/textarea&gt;");
    var announcementMarkup = Model.Announcement?.Content ?? string.Empty;
    var announcementInitialHtml = RichTextRenderer.ToHtml(announcementMarkup);
}

<div class="card shadow-sm h-100">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h2 class="h5 mb-0">@Html.Localize("Manager Notes & Announcements")</h2>
        @if (Model.CanManageAnnouncements && hasProperty)
        {
            <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#announcementEditorModal">
                @Html.Localize("Edit")
            </button>
        }
    </div>
    <div class="card-body">
        @if (!hasProperty)
        {
            <p class="text-muted mb-0">@Html.Localize("Select a property to view announcements.")</p>
        }
        else if (string.IsNullOrWhiteSpace(Model.Announcement.Content))
        {
            <p class="text-muted mb-0">@Html.Localize("No announcements yet. Managers and admins can add one using the edit button.")</p>
        }
        else
        {
            var announcementEntityId = Model.Announcement?.Id.HasValue == true
                ? Model.Announcement.Id.Value.ToString(CultureInfo.InvariantCulture)
                : $"property-{property?.Id ?? 0}-announcement";
            var translatedAnnouncement = await Html.DisplayTranslatedTextAsync(
                "ManagerAnnouncement",
                announcementEntityId,
                "Content",
                Model.Announcement.Content ?? string.Empty);
            var renderedAnnouncement = RichTextRenderer.ToHtml(translatedAnnouncement);
            <div class="announcement-content rich-text-output">@Html.Raw(renderedAnnouncement)</div>
            @if (Model.Announcement.UpdatedAt.HasValue)
            {
                var updatedLocal = TimeZoneService.ConvertToUserTime(Model.Announcement.UpdatedAt.Value);
                var lastUpdatedLabel = Html.Localize("Last updated {0}");
                <p class="text-muted small mb-0 mt-2">
                    @string.Format(lastUpdatedLabel, updatedLocal.ToString("g"))
                    @if (!string.IsNullOrWhiteSpace(Model.Announcement.UpdatedByName))
                    {
                        var updatedByLabel = Html.Localize("by {0}");
                        <text> @string.Format(updatedByLabel, Model.Announcement.UpdatedByName)</text>
                    }
                </p>
            }
        }

        @if (hasProperty && Model.Announcement.Attachments.Any())
        {
            <div class="mt-3">
                <h3 class="h6 mb-2">@Html.Localize("Attachments")</h3>
                <ul class="list-unstyled mb-0">
                    @foreach (var attachment in Model.Announcement.Attachments)
                    {
                        <li class="mb-2">
                            <a href="@attachment.DownloadUrl" target="_blank" rel="noopener">@attachment.FileName</a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@if (Model.CanManageAnnouncements && hasProperty)
{
    <div class="modal fade announcement-editor-modal" id="announcementEditorModal" tabindex="-1" aria-labelledby="announcementEditorModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <form asp-action="UpdateAnnouncement" method="post" enctype="multipart/form-data" class="announcement-editor-form">
                    <div class="modal-header">
                        <h5 class="modal-title" id="announcementEditorModalLabel">@Html.Localize("Edit Announcement")</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Html.Localize("Close")'></button>
                    </div>
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PropertyId" value="@property!.Id" />
                        <div class="mb-3 announcement-editor__content-field">
                            <label for="announcementContent" class="form-label">@Html.Localize("Announcement")</label>
                            <textarea class="form-control"
                                      id="announcementContent"
                                      name="Content"
                                      rows="6"
                                      maxlength="4000"
                                      data-enable-mentions="true"
                                      data-rich-text="true"
                                      data-clipboard-upload-target="#announcementFiles"
                                      data-initial-html="@announcementInitialHtml">@Html.Raw(EscapeTextareaValue(announcementMarkup))</textarea>
                            <div class="form-text">@Html.Localize("Use the toolbar for bold, italic, underline, lists, and quotes. Markdown shortcuts also work.")</div>
                        </div>
                        @if (Model.Announcement.Attachments.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label">@Html.Localize("Current Attachments")</label>
                                <ul class="list-unstyled mb-2">
                                    @foreach (var attachment in Model.Announcement.Attachments)
                                    {
                                        var checkboxId = $"announcementRemove_{attachment.Id}";
                                        <li class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-2">
                                            <a href="@attachment.DownloadUrl" target="_blank" rel="noopener">@attachment.FileName</a>
                                            <div class="form-check mb-0">
                                                <input class="form-check-input" type="checkbox" name="AttachmentsToDelete" value="@attachment.Id" id="@checkboxId" />
                                                <label class="form-check-label" for="@checkboxId">@Html.Localize("Remove")</label>
                                            </div>
                                        </li>
                                    }
                                </ul>
                                <div class="form-text">@Html.Localize("Select remove to delete files when you save.")</div>
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label" for="announcementFiles">@Html.Localize("Add Attachments")</label>
                            <input class="form-control" type="file" id="announcementFiles" name="Files" multiple />
                            <div class="form-text">@Html.Localize("Upload photos or documents to share with your team.")</div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Html.Localize("Cancel")</button>
                        <button type="submit" class="btn btn-primary">@Html.Localize("Save Announcement")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}


