@model hOps.web.ViewModels.Home.HomeIndexViewModel

@{
    var property = Model.CurrentProperty;
    var hasProperty = property != null;
    var tilesByFloor = hasProperty ? Model.RoomTiles.GroupBy(t => t.Floor).OrderBy(g => g.Key).ToList() : new List<IGrouping<int, hOps.web.ViewModels.Home.RoomLayoutTileViewModel>>();
    var overlayGroups = hasProperty
        ? Model.RoomTiles
            .GroupBy(t => string.IsNullOrWhiteSpace(t.LocationKey) ? $"room:{t.RoomId}" : t.LocationKey)
            .ToList()
        : new List<IGrouping<string, hOps.web.ViewModels.Home.RoomLayoutTileViewModel>>();
}

<div class="card shadow-sm h-100 hotel-layout-card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h2 class="h5 mb-0">Hotel Layout</h2>
    </div>
    <div class="card-body"
         id="layoutWidget"
         data-property-id="@(property?.Id ?? 0)"
         data-room-summary-url="@Url.Action("GetRoomWorkOrders", "WorkOrders")"
         data-room-create-url="@Url.Action("CreateFromLayout", "WorkOrders")"
         data-workorders-url="@Url.Action("Index", "WorkOrders")">
        @if (!hasProperty)
        {
            <p class="text-muted mb-0">Select a property to view room layouts and open items.</p>
        }
        else if (!Model.RoomTiles.Any())
        {
            <p class="text-muted mb-0">No layout has been configured for this property yet.</p>
        }
        else
        {
            var floorLegend = tilesByFloor
                .Select(g => new
                {
                    Floor = g.Key,
                    Color = g.First().FloorColor,
                    AlertCount = g.Sum(tile => tile.Badges?.Count ?? 0)
                })
                .ToList();
            var totalAlerts = floorLegend.Sum(f => f.AlertCount);
            var maxWidthAll = Math.Max(1, tilesByFloor.SelectMany(g => g).Max(t => t.X + t.Width));
            var maxHeightAll = Math.Max(1, tilesByFloor.SelectMany(g => g).Max(t => t.Y + t.Height));
            var defaultFloor = tilesByFloor.First().Key;

            var hideLegendForPanel = ViewContext.ViewData["HideHotelLayoutLegend"] as bool? ?? false;

            <div class="layout-controls d-flex flex-column flex-lg-row align-items-lg-center justify-content-lg-between gap-2 mb-2">
                <div class="btn-group btn-group-sm layout-view-toggle" role="group" aria-label="Layout view mode">
                    <input class="btn-check" type="radio" name="layoutViewMode" id="layoutView_all" value="all" checked autocomplete="off">
                    <label class="btn btn-outline-primary layout-view-toggle__btn" for="layoutView_all">
                        All Floors
                        @if (totalAlerts > 0)
                        {
                            <span class="layout-floor-badge">@totalAlerts</span>
                        }
                    </label>
                    @foreach (var floorInfo in floorLegend)
                    {
                        var floorId = floorInfo.Floor;
                        var badgeCount = floorInfo.AlertCount;
                        <input class="btn-check" type="radio" name="layoutViewMode" id="layoutView_@floorId" value="@floorId" autocomplete="off">
                        <label class="btn btn-outline-primary layout-view-toggle__btn" for="layoutView_@floorId">
                            Floor @floorId
                            @if (badgeCount > 0)
                            {
                                <span class="layout-floor-badge">@badgeCount</span>
                            }
                        </label>
                    }
                </div>
                @if (!hideLegendForPanel)
                {
                    <div class="layout-legends d-flex flex-column flex-lg-row gap-3 text-muted small">
                        <div class="d-flex align-items-center gap-3">
                            <span><span class="legend-swatch workorder"></span> Work Orders</span>
                            <span><span class="legend-swatch lostfound"></span> Lost &amp; Found</span>
                        </div>
                        <div class="layout-floor-legend d-flex align-items-center gap-2 flex-wrap">
                            @foreach (var floorInfo in floorLegend)
                            {
                                <span class="layout-floor-pill" style="--floor-color:@floorInfo.Color">Floor @floorInfo.Floor</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <div id="layoutOverlayView" class="layout-view">
                <div class="layout-canvas multi-floor" style="--layout-width:@maxWidthAll; --layout-height:@maxHeightAll;">
                    @foreach (var overlayGroup in overlayGroups)
                    {
                        var representative = overlayGroup.First();
                        var minX = overlayGroup.Min(t => t.X);
                        var minY = overlayGroup.Min(t => t.Y);
                        var maxX = overlayGroup.Max(t => t.X + t.Width);
                        var maxY = overlayGroup.Max(t => t.Y + t.Height);
                        var rawWidth = Math.Max(1, maxX - minX);
                        var rawHeight = Math.Max(1, maxY - minY);
                        var left = Math.Round((double)minX / maxWidthAll * 100, 2);
                        var top = Math.Round((double)minY / maxHeightAll * 100, 2);
                        var width = Math.Round((double)rawWidth / maxWidthAll * 100, 2);
                        var height = Math.Round((double)rawHeight / maxHeightAll * 100, 2);
                        var label = string.IsNullOrWhiteSpace(representative.RoomNumber) ? representative.RoomType : representative.RoomNumber;
                        var locationKey = string.IsNullOrWhiteSpace(representative.LocationKey) ? $"room:{representative.RoomId}" : representative.LocationKey;
                        var floors = overlayGroup.Select(t => t.Floor).Distinct().OrderBy(f => f).ToList();
                        var overlayFloor = floors.Count == 1 ? floors[0].ToString() : string.Empty;
                        var overlayBadges = overlayGroup.SelectMany(t => t.Badges).ToList();
                        var displayRoomType = overlayGroup.Select(t => t.RoomType).FirstOrDefault(type => !string.IsNullOrWhiteSpace(type)) ?? representative.RoomType;
                        var overlayClass = representative.CssClass + (floors.Count > 1 ? " room-tile-overlay--multi" : string.Empty);
                        <div class="room-tile-overlay @overlayClass"
                             style="--tile-left:@left%; --tile-top:@top%; --tile-width:@width%; --tile-height:@height%; --tile-text-rotation:@(representative.TextRotation)deg;"
                             data-room-id="@representative.RoomId"
                             data-room-number="@representative.RoomNumber"
                             data-room-label="@label"
                             data-room-floor="@overlayFloor"
                             data-floor-list="@string.Join(",", floors)"
                             data-location-key="@locationKey">
                            <strong class="tile-label" data-room-full-label="@label">@label</strong>
                            @if (floors.Count > 1)
                            {
                                <span class="tile-type text-muted">All Floors</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(displayRoomType))
                            {
                                <span class="tile-type">@displayRoomType</span>
                            }
                            @if (overlayBadges.Any())
                            {
                                <div class="tile-badges">
                                    @foreach (var badge in overlayBadges)
                                    {
                                        <span class="badge bg-@badge.Variant">@badge.Text</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div id="layoutFloorView" class="layout-view d-none">
                @foreach (var floorGroup in tilesByFloor)
                {
                    var maxWidth = Math.Max(1, floorGroup.Max(t => t.X + t.Width));
                    var maxHeight = Math.Max(1, floorGroup.Max(t => t.Y + t.Height));
                    var isActive = floorGroup.Key == defaultFloor;
                    <section class="layout-floor-section mb-4 @(isActive ? string.Empty : "d-none")" data-floor="@floorGroup.Key">
                        <header class="d-flex align-items-center justify-content-between mb-2">
                            <h3 class="h6 mb-0">Floor @floorGroup.Key</h3>
                            <span class="text-muted small">Last refreshed @TimeZoneService.ConvertToUserTime(DateTime.UtcNow).ToString("g")</span>
                        </header>
                        <div class="layout-canvas" style="--layout-width:@maxWidth; --layout-height:@maxHeight;">
                            @foreach (var tile in floorGroup)
                            {
                                var left = Math.Round((double)tile.X / maxWidth * 100, 2);
                                var top = Math.Round((double)tile.Y / maxHeight * 100, 2);
                                var width = Math.Round((double)tile.Width / maxWidth * 100, 2);
                                var height = Math.Round((double)tile.Height / maxHeight * 100, 2);
                                var label = string.IsNullOrWhiteSpace(tile.RoomNumber) ? tile.RoomType : tile.RoomNumber;
                                <div class="room-tile @tile.CssClass"
                                     style="--tile-left:@left%; --tile-top:@top%; --tile-width:@width%; --tile-height:@height%; --tile-text-rotation:@(tile.TextRotation)deg;"
                                     data-room-number="@tile.RoomNumber"
                                     data-room-label="@label"
                                     data-room-id="@tile.RoomId"
                                     data-room-floor="@tile.Floor"
                                     data-location-key="@(string.IsNullOrWhiteSpace(tile.LocationKey) ? $"room:{tile.RoomId}" : tile.LocationKey)">
                                    <span class="tile-room" data-room-full-label="@label">@label</span>
                                    @if (!string.IsNullOrWhiteSpace(tile.RoomType))
                                    {
                                        <span class="tile-type">@tile.RoomType</span>
                                    }
                                    @if (tile.Badges.Any())
                                    {
                                        <div class="tile-badges">
                                            @foreach (var badge in tile.Badges)
                                            {
                                                <span class="badge bg-@badge.Variant">@badge.Text</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>
        }
    </div>
</div>

<div id="layoutRoomMenu" class="layout-room-menu shadow" aria-hidden="true">
    <div class="layout-room-menu__header d-flex align-items-start justify-content-between">
        <div>
            <div class="layout-room-menu__title" data-room-name>Select a room</div>
            <div class="layout-room-menu__meta text-muted small" data-room-floor></div>
        </div>
        <button type="button" class="btn-close" aria-label="Close room menu" data-close-room-menu></button>
    </div>
    <div class="layout-room-menu__body">
        <div class="layout-room-menu__section">
            <h6 class="layout-room-menu__section-title">Open Work Orders</h6>
            <div class="layout-room-menu__workorders text-muted small" data-room-workorders>
                Select a room to review open work orders.
            </div>
        </div>
        <div class="layout-room-menu__actions d-flex flex-column flex-sm-row gap-2">
            <a class="btn btn-outline-primary btn-sm"
               href="@((Url.Action("Index", "WorkOrders") ?? "/WorkOrders"))"
               target="_blank"
               rel="noopener"
               data-view-workorders>
                View in Work Orders
            </a>
            <button type="button" class="btn btn-primary btn-sm" data-create-workorder disabled>
                Create Work Order
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="layoutWorkOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Work Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="layoutWorkOrderForm" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@(property?.Id ?? 0)" />
                    <input type="hidden" name="RoomNumber" />
                    <input type="hidden" name="RoomLabel" />
                    <div class="mb-3">
                        <label class="form-label">Room</label>
                        <div class="form-control-plaintext fw-semibold" data-room-display>
                            Select a room from the layout.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="layoutWorkOrderIssue">Issue<span class="text-danger">*</span></label>
                        <textarea class="form-control" id="layoutWorkOrderIssue" name="Issue" rows="3" required></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="layoutWorkOrderType">Work Order Type</label>
                            <select class="form-select" id="layoutWorkOrderType" name="WorkOrderTypeId">
                                <option value="">Select type</option>
                                @foreach (var type in Model.WorkOrderTypeOptions)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="layoutWorkOrderDepartment">Department</label>
                            <select class="form-select" id="layoutWorkOrderDepartment" name="DepartmentId">
                                <option value="">Select department</option>
                                @foreach (var department in Model.DepartmentOptions)
                                {
                                    <option value="@department.Id">@department.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mt-0">
                        <div class="col-sm-6">
                            <label class="form-label" for="layoutWorkOrderDueDate">Due Date</label>
                            <input type="date"
                                   class="form-control"
                                   id="layoutWorkOrderDueDate"
                                   name="DueDate"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   data-default-value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="layoutWorkOrderDetails">Details</label>
                        <textarea class="form-control" id="layoutWorkOrderDetails" name="Details" rows="3"></textarea>
                    </div>
                    <div class="alert d-none" role="alert" data-form-status></div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Submit Work Order</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
