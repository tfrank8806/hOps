@model hOps.web.ViewModels.Home.HomeIndexViewModel

@{
    var property = Model.CurrentProperty;
    var hasProperty = property != null;
}

<div class="card shadow-sm h-100">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 class="h5 mb-0">Pass On Logs</h2>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-primary btn-sm" href="@(Url.Action("Create", "PassOnLogs") ?? "/PassOnLogs/Create")">
                + New Pass On
            </a>
            <a class="btn btn-outline-secondary btn-sm" href="@(Url.Action("Index", "PassOnLogs") ?? "/PassOnLogs")">
                View All
            </a>
        </div>
    </div>
    <div class="card-body">
        @if (!hasProperty)
        {
            <p class="text-muted mb-0">Select a property to review pass on log updates.</p>
        }
        else if (!Model.PassOnLogs.Any())
        {
            <p class="text-muted mb-0">No entries yet. Capture the latest shift updates in the pass on log.</p>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (var log in Model.PassOnLogs)
                {
                    var createdLocal = TimeZoneService.ConvertToUserTime(log.CreatedAt);
                    <li class="mb-3 pb-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">@log.Title</div>
                                <div class="text-muted small">@createdLocal.ToString("g")</div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(log.DetailUrl))
                            {
                                <a class="btn btn-link btn-sm p-0" href="@log.DetailUrl">Open</a>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(log.Preview))
                        {
                            <p class="mb-0 small text-muted">@log.Preview</p>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>
