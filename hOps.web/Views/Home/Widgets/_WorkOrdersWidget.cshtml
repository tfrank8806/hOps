@using System.Globalization
@model hOps.web.ViewModels.Home.HomeIndexViewModel

@{
    var workOrders = Model.WorkOrders ?? new List<hOps.web.ViewModels.Home.WorkOrderSummaryViewModel>();
    var departmentSummaries = Model.WorkOrderDepartmentSummaries ?? new List<hOps.web.ViewModels.Home.WorkOrderDepartmentSummaryViewModel>();
    var widgetTitle = Html.Localize("Home.WorkOrdersWidget.Title", "Work Orders").ToString();
    var newWorkOrderLabel = Html.Localize("Home.WorkOrdersWidget.NewWorkOrder", "New Work Order").ToString();
    var viewAllLabel = Html.Localize("Home.WorkOrdersWidget.ViewAll", "View All").ToString();
    var emptyStateText = Html.Localize("Home.WorkOrdersWidget.Empty", "No work orders are currently assigned to this property.").ToString();
    var openByDepartmentLabel = Html.Localize("Home.WorkOrdersWidget.OpenByDepartment", "Open work orders by department").ToString();
    var includesStatusesText = Html.Localize("Home.WorkOrdersWidget.IncludesStatuses", "Includes New, In Progress, and Escalated").ToString();
    var openedTemplate = Html.Localize("Home.WorkOrdersWidget.OpenedTemplate", "Opened {0}").ToString();

    string GetDateColor(DateTime dateTime)
    {
        var localDate = TimeZoneService.ConvertToUserTime(dateTime).Date;
        var today = TimeZoneService.ConvertToUserTime(DateTime.UtcNow).Date;

        if (localDate >= today)
        {
            return "#198754";
        }

        if (localDate == today.AddDays(-1))
        {
            return "#fd7e14";
        }

        return "#dc3545";
    }
}

<div class="card shadow-sm h-100 home-widget-card home-widget-card--fill">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2 home-widget-card__header">
        <h2 class="h6 mb-0">@widgetTitle</h2>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a class="btn btn-sm btn-primary"
               asp-controller="WorkOrders"
               asp-action="Index"
               asp-fragment="workOrdersForm">
                <span class="pe-1">+</span>@newWorkOrderLabel
            </a>
            <a class="btn btn-sm btn-outline-primary" asp-controller="WorkOrders" asp-action="Index">@viewAllLabel</a>
        </div>
    </div>
    <div class="card-body home-widget-card__body">
        @if (!workOrders.Any())
        {
            <p class="text-muted mb-0">@emptyStateText</p>
        }
        else
        {
    <style>
        .home-workorder-summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 0.75rem;
        }

        .home-workorder-summary-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #e9ecef;
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            background-color: #fff;
        }

        .home-workorder-summary-item .department-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
            color: #0f172a;
        }

        .home-workorder-summary-item .department-dot {
            width: 0.65rem;
            height: 0.65rem;
            border-radius: 999px;
            background-color: var(--dept-color, #0d6efd);
        }

        .home-workorder-summary-item .department-count {
            font-size: 1.5rem;
            font-weight: 600;
            color: #0f172a;
        }

        @@media (max-width: 575.98px) {
            .home-workorder-summary-grid {
                grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            }
        }
    </style>
            if (departmentSummaries.Any())
            {
                <div class="mb-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <span class="fw-semibold">@openByDepartmentLabel</span>
                        <span class="text-muted small">@includesStatusesText</span>
                    </div>
                    <div class="home-workorder-summary-grid">
                        @foreach (var summary in departmentSummaries)
                        {
                            var deptColor = string.IsNullOrWhiteSpace(summary.DepartmentColor)
                                ? "#0d6efd"
                                : summary.DepartmentColor!;
                            var summaryDisplayName = string.IsNullOrWhiteSpace(summary.TranslatedDepartmentName)
                                ? summary.DepartmentName
                                : summary.TranslatedDepartmentName;
                            <div class="home-workorder-summary-item" style="--dept-color:@deptColor">
                                <div class="department-info">
                                    <span class="department-dot" aria-hidden="true"></span>
                                    <span>@summaryDisplayName</span>
                                </div>
                                <div class="department-count">@summary.OpenCount</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <ul class="list-unstyled mb-0 widget-list">
                @foreach (var order in workOrders)
                {
                    var hasLink = !string.IsNullOrWhiteSpace(order.DetailUrl);
                    var orderIdString = order.Id.ToString(CultureInfo.InvariantCulture);
                    var issueDisplay = await Html.DisplayTranslatedTextAsync("WorkOrder", orderIdString, "Issue", order.Issue);
                    var locationDisplay = await Html.DisplayTranslatedTextAsync("WorkOrder", orderIdString, "Location", order.Location ?? string.Empty);
                    var departmentDisplay = await Html.DisplayTranslatedTextAsync("WorkOrder", orderIdString, "DepartmentName", order.DepartmentName ?? string.Empty);
                    var createdLocal = TimeZoneService.ConvertToUserTime(order.CreatedAt);
                    var openedLabel = string.Format(CultureInfo.CurrentCulture, openedTemplate, createdLocal.ToString("g", CultureInfo.CurrentCulture));
                    <li class="widget-item">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="flex-grow-1">
                                @if (hasLink)
                                {
                                    <a class="fw-semibold" href="@order.DetailUrl">@issueDisplay</a>
                                }
                                else
                                {
                                    <span class="fw-semibold">@issueDisplay</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(locationDisplay))
                                {
                                    <div class="text-muted small">@locationDisplay</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(departmentDisplay))
                                {
                                    var deptColor = string.IsNullOrWhiteSpace(order.DepartmentColor)
                                        ? "#0d6efd"
                                        : order.DepartmentColor;
                                    <div class="text-muted small d-flex align-items-center gap-2 mt-1">
                                        <span class="widget-dept-dot" style="--dept-color:@deptColor" aria-hidden="true"></span>
                                        <span>@departmentDisplay</span>
                                    </div>
                                }
                                <div class="@order.SlaStatusClass mt-1">
                                    <span class="fw-semibold">@Html.Localize(order.SlaStatus ?? string.Empty)</span>
                                    @if (!string.IsNullOrWhiteSpace(order.SlaSummary))
                                    {
                                        <span class="ms-1 text-muted">@Html.Localize(order.SlaSummary)</span>
                                    }
                                </div>
                            </div>
                            @{
                                var statusColor = hOps.web.ViewModels.WorkOrders.WorkOrderStatusOptions.GetColor(order.Status);
                                var statusLabel = hOps.web.ViewModels.WorkOrders.WorkOrderStatusOptions.GetLabel(order.Status);
                                var localizedStatusLabel = Html.Localize(statusLabel ?? string.Empty);
                                var localizedPriorityLabel = Html.Localize(order.PriorityLabel ?? string.Empty);
                            }
                            <div class="d-flex flex-column align-items-end gap-1 text-end flex-shrink-0">
                                <span class="badge" style="background-color:@statusColor">@localizedStatusLabel</span>
                                <span class="@order.PriorityClass">@localizedPriorityLabel</span>
                                <small class="text-muted">@order.DueDate.ToString("d", CultureInfo.CurrentCulture)</small>
                            </div>
                        </div>
                        <div class="small mt-1" style="color:@GetDateColor(order.CreatedAt);">@openedLabel</div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

