@using System
@using System.Collections.Generic
@using System.Linq
@using hOps.web.ViewModels
@using hOps.web.ViewModels.Home
@model HomeWidgetViewModel

@{
    var items = Model.Items ?? Array.Empty<object>();

    string GetDateColor(DateTime dateTime)
    {
        var localDate = TimeZoneService.ConvertToUserTime(dateTime).Date;
        var today = TimeZoneService.ConvertToUserTime(DateTime.UtcNow).Date;

        if (localDate >= today)
        {
            return "#198754"; // bootstrap green
        }

        if (localDate == today.AddDays(-1))
        {
            return "#fd7e14"; // orange
        }

        return "#dc3545"; // bootstrap red
    }
}

<div class="card shadow-sm h-100">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h2 class="h6 mb-0">@Model.Title</h2>
        <a class="btn btn-sm btn-outline-primary" asp-controller="@Model.ControllerName" asp-action="@Model.ActionName">View All</a>
    </div>
    <div class="card-body">
        @if (!items.Any())
        {
            <p class="text-muted mb-0">No records to show.</p>
        }
        else if (items.First() is WorkOrderSummaryViewModel)
        {
            var workOrders = items.OfType<WorkOrderSummaryViewModel>();
            <ul class="list-unstyled mb-0 widget-list">
                @foreach (var order in workOrders)
                {
                    var hasLink = !string.IsNullOrWhiteSpace(order.DetailUrl);
                    <li class="widget-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                @if (hasLink)
                                {
                                    <a class="fw-semibold" href="@order.DetailUrl">@order.Issue</a>
                                }
                                else
                                {
                                    <span class="fw-semibold">@order.Issue</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(order.Location))
                                {
                                    <div class="text-muted small">@order.Location</div>
                                }
                            </div>
                            <span class="badge" style="background-color:@hOps.web.ViewModels.WorkOrders.WorkOrderStatusOptions.GetColor(order.Status)">@order.Status</span>
                        </div>
                        @{
                            var createdLocal = TimeZoneService.ConvertToUserTime(order.CreatedAt);
                        }
                        <div class="small mt-1" style="color:@GetDateColor(order.CreatedAt);">Opened @createdLocal.ToString("g")</div>
                    </li>
                }
            </ul>
        }
        else if (items.First() is LostFoundSummaryViewModel)
        {
            var entries = items.OfType<LostFoundSummaryViewModel>();
            <ul class="list-unstyled mb-0 widget-list">
                @foreach (var entry in entries)
                {
                    var hasLink = !string.IsNullOrWhiteSpace(entry.DetailUrl);
                    <li class="widget-item">
                        @if (hasLink)
                        {
                            <a class="fw-semibold" href="@entry.DetailUrl">@entry.Title</a>
                        }
                        else
                        {
                            <span class="fw-semibold">@entry.Title</span>
                        }
                        <div class="text-muted small">@entry.Type.ToString() &middot; @entry.Status.ToString()</div>
                        @{
                            var loggedLocal = TimeZoneService.ConvertToUserTime(entry.CreatedAt);
                        }
                        <div class="small" style="color:@GetDateColor(entry.CreatedAt);">Logged @loggedLocal.ToString("g")</div>
                    </li>
                }
            </ul>
        }
        else if (items.First() is PackageLogSummaryViewModel)
        {
            var packages = items.OfType<PackageLogSummaryViewModel>();
            <ul class="list-unstyled mb-0 widget-list">
                @foreach (var package in packages)
                {
                    var hasLink = !string.IsNullOrWhiteSpace(package.DetailUrl);
                    <li class="widget-item">
                        @if (hasLink)
                        {
                            <a class="fw-semibold" href="@package.DetailUrl">@package.RecipientName</a>
                        }
                        else
                        {
                            <span class="fw-semibold">@package.RecipientName</span>
                        }
                        @{
                            var metaParts = new List<string>();
                            if (!string.IsNullOrWhiteSpace(package.RoomNumber))
                            {
                                metaParts.Add($"Room {package.RoomNumber}");
                            }
                            if (!string.IsNullOrWhiteSpace(package.Carrier))
                            {
                                metaParts.Add(package.Carrier);
                            }
                            if (!string.IsNullOrWhiteSpace(package.TrackingNumber))
                            {
                                metaParts.Add(package.TrackingNumber);
                            }
                            if (!string.IsNullOrWhiteSpace(package.StorageLocation))
                            {
                                metaParts.Add(package.StorageLocation);
                            }
                        }
                        @if (metaParts.Any())
                        {
                            <div class="text-muted small">
                                @for (var i = 0; i < metaParts.Count; i++)
                                {
                                    if (i > 0)
                                    {
                                        <span class="mx-1" aria-hidden="true">&middot;</span>
                                    }
                                    @metaParts[i]
                                }
                            </div>
                        }
                        @{
                            var packageLoggedLocal = TimeZoneService.ConvertToUserTime(package.LoggedAt);
                        }
                        <div class="small" style="color:@GetDateColor(package.LoggedAt);">Logged @packageLoggedLocal.ToString("g")</div>
                    </li>
                }
            </ul>
        }
        else if (items.First() is CalendarEventSummaryViewModel)
        {
            var events = items.OfType<CalendarEventSummaryViewModel>();
            <ul class="list-unstyled mb-0 widget-list">
                @foreach (var calendarEvent in events)
                {
                    var hasLink = !string.IsNullOrWhiteSpace(calendarEvent.DetailUrl);
                    <li class="widget-item">
                        @if (hasLink)
                        {
                            <a class="fw-semibold" href="@calendarEvent.DetailUrl">@calendarEvent.Title</a>
                        }
                        else
                        {
                            <span class="fw-semibold">@calendarEvent.Title</span>
                        }
                        @{
                            var startLocal = TimeZoneService.ConvertToUserTime(calendarEvent.Start);
                            var endLocal = calendarEvent.End.HasValue ? TimeZoneService.ConvertToUserTime(calendarEvent.End.Value) : (DateTime?)null;
                        }
                        <div class="small" style="color:@GetDateColor(calendarEvent.Start);">@startLocal.ToString("g") @if (endLocal.HasValue){<text>- @endLocal.Value.ToString("g")</text>}</div>
                        @if (!string.IsNullOrWhiteSpace(calendarEvent.CategoryName))
                        {
                            <span class="badge rounded-pill" style="background-color:@(calendarEvent.CategoryColor ?? "#0d6efd");">@calendarEvent.CategoryName</span>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted mb-0">Unsupported widget type.</p>
        }
    </div>
</div>
