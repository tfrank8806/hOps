@using System
@using System.Collections.Generic
@using System.Linq
@using System.Globalization
@using hOps.web.ViewModels
@using hOps.web.ViewModels.Home
@model HomeWidgetViewModel

@{
    var items = Model.Items ?? Array.Empty<object>();

    string GetDateColor(DateTime dateTime)
    {
        var localDate = TimeZoneService.ConvertToUserTime(dateTime).Date;
        var today = TimeZoneService.ConvertToUserTime(DateTime.UtcNow).Date;

        if (localDate >= today)
        {
            return "#198754"; // bootstrap green
        }

        if (localDate == today.AddDays(-1))
        {
            return "#fd7e14"; // orange
        }

        return "#dc3545"; // bootstrap red
    }
}

@{
    var hasCreateAction = !string.IsNullOrWhiteSpace(Model.CreateControllerName) && !string.IsNullOrWhiteSpace(Model.CreateActionName);
    var createButtonLabel = string.IsNullOrWhiteSpace(Model.CreateButtonText)
        ? Html.Localize("+ New")
        : Html.Localize(Model.CreateButtonText!);
    var createController = Model.CreateControllerName ?? string.Empty;
    var createAction = Model.CreateActionName ?? string.Empty;
    var createFragment = Model.CreateFragment ?? string.Empty;
}

@{
    var cardClass = string.IsNullOrWhiteSpace(Model.CardCssClass)
        ? "card shadow-sm h-100 home-widget-card"
        : $"card shadow-sm h-100 home-widget-card {Model.CardCssClass}";
}

<div class="@cardClass">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2 home-widget-card__header">
        <h2 class="h6 mb-0">@Model.Title</h2>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (hasCreateAction)
            {
                <a class="btn btn-sm btn-primary"
                   asp-controller="@createController"
                   asp-action="@createAction"
                   asp-fragment="@createFragment">
                    @createButtonLabel
                </a>
            }
            <a class="btn btn-sm btn-outline-primary" asp-controller="@Model.ControllerName" asp-action="@Model.ActionName">@Html.Localize("View All")</a>
        </div>
    </div>
    <div class="card-body home-widget-card__body">
        @if (!items.Any())
        {
            <p class="text-muted mb-0">@Html.Localize("No records to show.")</p>
        }
        else if (items.First() is WorkOrderSummaryViewModel)
        {
            var workOrders = items.OfType<WorkOrderSummaryViewModel>();
            <ul class="list-unstyled mb-0 widget-list">
                @foreach (var order in workOrders)
                {
                    var hasLink = !string.IsNullOrWhiteSpace(order.DetailUrl);
                    var orderIdString = order.Id.ToString(CultureInfo.InvariantCulture);
                    var issueDisplay = await Html.DisplayTranslatedTextAsync("WorkOrder", orderIdString, "Issue", order.Issue);
                    var locationDisplay = await Html.DisplayTranslatedTextAsync("WorkOrder", orderIdString, "Location", order.Location ?? string.Empty);
                    var departmentDisplay = await Html.DisplayTranslatedTextAsync("WorkOrder", orderIdString, "DepartmentName", order.DepartmentName ?? string.Empty);
                    var createdLocal = TimeZoneService.ConvertToUserTime(order.CreatedAt);
                    var openedLabel = string.Format(CultureInfo.CurrentCulture, Html.Localize("Opened {0}"), createdLocal.ToString("g", CultureInfo.CurrentCulture));
                    <li class="widget-item">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="flex-grow-1">
                                @if (hasLink)
                                {
                                    <a class="fw-semibold" href="@order.DetailUrl">@issueDisplay</a>
                                }
                                else
                                {
                                    <span class="fw-semibold">@issueDisplay</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(locationDisplay))
                                {
                                    <div class="text-muted small">@locationDisplay</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(departmentDisplay))
                                {
                                    var deptColor = string.IsNullOrWhiteSpace(order.DepartmentColor)
                                        ? "#0d6efd"
                                        : order.DepartmentColor;
                                    <div class="text-muted small d-flex align-items-center gap-2 mt-1">
                                        <span class="widget-dept-dot" style="--dept-color:@deptColor" aria-hidden="true"></span>
                                        <span>@departmentDisplay</span>
                                    </div>
                                }
                                <div class="@order.SlaStatusClass mt-1">
                                    <span class="fw-semibold">@Html.Localize(order.SlaStatus ?? string.Empty)</span>
                                    @if (!string.IsNullOrWhiteSpace(order.SlaSummary))
                                    {
                                        <span class="ms-1 text-muted">@Html.Localize(order.SlaSummary)</span>
                                    }
                                </div>
                            </div>
                            @{
                                var statusColor = hOps.web.ViewModels.WorkOrders.WorkOrderStatusOptions.GetColor(order.Status);
                                var statusLabel = hOps.web.ViewModels.WorkOrders.WorkOrderStatusOptions.GetLabel(order.Status);
                                var localizedStatusLabel = Html.Localize(statusLabel ?? string.Empty);
                                var localizedPriorityLabel = Html.Localize(order.PriorityLabel ?? string.Empty);
                            }
                            <div class="d-flex flex-column align-items-end gap-1 text-end flex-shrink-0">
                                <span class="badge" style="background-color:@statusColor">@localizedStatusLabel</span>
                                <span class="@order.PriorityClass">@localizedPriorityLabel</span>
                                <small class="text-muted">@order.DueDate.ToString("d", CultureInfo.CurrentCulture)</small>
                            </div>
                        </div>
                        <div class="small mt-1" style="color:@GetDateColor(order.CreatedAt);">@openedLabel</div>
                    </li>
                }
            </ul>
        }
        else if (items.First() is LostFoundSummaryViewModel)
        {
            var entries = items.OfType<LostFoundSummaryViewModel>();
            <ul class="list-unstyled mb-0 widget-list">
                @foreach (var entry in entries)
                {
                    var hasLink = !string.IsNullOrWhiteSpace(entry.DetailUrl);
                    var entryIdString = entry.Id.ToString(CultureInfo.InvariantCulture);
                    var titleDisplay = await Html.DisplayTranslatedTextAsync("LostFoundEntry", entryIdString, "Title", entry.Title);
                    var typeDisplay = Html.Localize(entry.Type.ToString());
                    var statusDisplay = Html.Localize(entry.Status.ToString());
                    var loggedLocal = TimeZoneService.ConvertToUserTime(entry.CreatedAt);
                    var loggedLabel = string.Format(CultureInfo.CurrentCulture, Html.Localize("Logged {0}"), loggedLocal.ToString("g", CultureInfo.CurrentCulture));
                    <li class="widget-item">
                        @if (hasLink)
                        {
                            <a class="fw-semibold" href="@entry.DetailUrl">@titleDisplay</a>
                        }
                        else
                        {
                            <span class="fw-semibold">@titleDisplay</span>
                        }
                        <div class="text-muted small">@typeDisplay &middot; @statusDisplay</div>
                        <div class="small" style="color:@GetDateColor(entry.CreatedAt);">@loggedLabel</div>
                    </li>
                }
            </ul>
        }
        else if (items.First() is PackageLogSummaryViewModel)
        {
            var packages = items.OfType<PackageLogSummaryViewModel>()
                .Where(package => !package.Delivered)
                .ToList();

            if (packages.Any())
            {
                <ul class="list-unstyled mb-0 widget-list">
                    @foreach (var package in packages)
                    {
                        var hasLink = !string.IsNullOrWhiteSpace(package.DetailUrl);
                        var packageIdString = package.Id.ToString(CultureInfo.InvariantCulture);
                        var recipientDisplay = await Html.DisplayTranslatedTextAsync("PackageLog", packageIdString, "RecipientName", package.RecipientName);
                        var storageDisplay = await Html.DisplayTranslatedTextAsync("PackageLog", packageIdString, "StorageLocation", package.StorageLocation ?? string.Empty);
                        var metaParts = new List<string>();
                        if (!string.IsNullOrWhiteSpace(package.RoomNumber))
                        {
                            metaParts.Add(string.Format(CultureInfo.CurrentCulture, Html.Localize("Room {0}"), package.RoomNumber));
                        }
                        if (!string.IsNullOrWhiteSpace(package.Carrier))
                        {
                            metaParts.Add(Html.Localize(package.Carrier));
                        }
                        if (!string.IsNullOrWhiteSpace(package.TrackingNumber))
                        {
                            metaParts.Add(package.TrackingNumber);
                        }
                        if (!string.IsNullOrWhiteSpace(storageDisplay))
                        {
                            metaParts.Add(storageDisplay);
                        }
                        if (package.PackageReceivedDate.HasValue)
                        {
                            metaParts.Add(string.Format(CultureInfo.CurrentCulture, Html.Localize("Received {0}"), package.PackageReceivedDate.Value.ToString("MMM d", CultureInfo.CurrentCulture)));
                        }
                        var packageLoggedLocal = TimeZoneService.ConvertToUserTime(package.LoggedAt);
                        var loggedLabel = string.Format(CultureInfo.CurrentCulture, Html.Localize("Logged {0}"), packageLoggedLocal.ToString("g", CultureInfo.CurrentCulture));
                        <li class="widget-item">
                            @if (hasLink)
                            {
                                <a class="fw-semibold" href="@package.DetailUrl">@recipientDisplay</a>
                            }
                            else
                            {
                                <span class="fw-semibold">@recipientDisplay</span>
                            }
                            @if (metaParts.Any())
                            {
                                <div class="text-muted small">
                                    @for (var i = 0; i < metaParts.Count; i++)
                                    {
                                        if (i > 0)
                                        {
                                            <span class="mx-1" aria-hidden="true">&middot;</span>
                                        }
                                        @metaParts[i]
                                    }
                                </div>
                            }
                            <div class="small" style="color:@GetDateColor(package.LoggedAt);">@loggedLabel</div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small mb-0">@Html.Localize("No packages are waiting for pickup.")</p>
            }
        }
        else if (items.First() is CalendarEventSummaryViewModel)
        {
            var events = items.OfType<CalendarEventSummaryViewModel>().ToList();
            var todayLocalDate = TimeZoneService.ConvertToUserTime(DateTime.UtcNow).Date;
            var todaysEventCount = events.Count(calendarEvent =>
                calendarEvent.StartDate.Date == todayLocalDate);
            var showMoreTodayButton = todaysEventCount > 5;
            var displayedEvents = events.Take(5).ToList();
            string GetEventBadgeColor(DateTime eventDate)
            {
                if (eventDate.Date >= todayLocalDate)
                {
                    return "#198754";
                }
                if (eventDate.Date == todayLocalDate.AddDays(-1))
                {
                    return "#fd7e14";
                }
                return "#dc3545";
            }

            <ul class="list-unstyled mb-0 widget-list">
                @foreach (var calendarEvent in displayedEvents)
                {
                    var hasLink = !string.IsNullOrWhiteSpace(calendarEvent.DetailUrl);
                    var eventIdString = calendarEvent.Id.ToString(CultureInfo.InvariantCulture);
                    var titleDisplay = await Html.DisplayTranslatedTextAsync("CalendarEvent", eventIdString, "Title", calendarEvent.Title);
                    var categoryDisplay = string.IsNullOrWhiteSpace(calendarEvent.CategoryName) ? string.Empty : Html.Localize(calendarEvent.CategoryName);
                    <li class="widget-item">
                        @if (hasLink)
                        {
                            <a class="fw-semibold" href="@calendarEvent.DetailUrl">@titleDisplay</a>
                        }
                        else
                        {
                            <span class="fw-semibold">@titleDisplay</span>
                        }
                        <div class="small" style="color:@GetEventBadgeColor(calendarEvent.StartDate)">@calendarEvent.DateDisplay</div>
                        @if (!string.IsNullOrWhiteSpace(calendarEvent.TimeDisplay))
                        {
                            <div class="small text-muted">@calendarEvent.TimeDisplay</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(categoryDisplay))
                        {
                            <span class="badge rounded-pill" style="background-color:@(calendarEvent.CategoryColor ?? "#0d6efd");">@categoryDisplay</span>
                        }
                    </li>
                }
            </ul>

            @if (showMoreTodayButton)
            {
                <div class="text-end mt-2">
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Calendar" asp-action="Index">@Html.Localize("More Events Today")</a>
                </div>
            }
        }
        else if (items.First() is PassOnLogSummaryViewModel)
        {
            var logs = items.OfType<PassOnLogSummaryViewModel>();
            <ul class="list-unstyled mb-0 widget-list">
                @foreach (var log in logs)
                {
                    var hasLink = !string.IsNullOrWhiteSpace(log.DetailUrl);
                    var logIdString = log.Id.ToString(CultureInfo.InvariantCulture);
                    var titleDisplay = await Html.DisplayTranslatedTextAsync("PassOnLog", logIdString, "Title", log.Title);
                    var previewDisplay = await Html.DisplayTranslatedTextAsync("PassOnLog", logIdString, "Preview", log.Preview);
                    var postedLocal = TimeZoneService.ConvertToUserTime(log.CreatedAt);
                    var authorName = string.IsNullOrWhiteSpace(log.CreatorName) ? Html.Localize("Unknown") : log.CreatorName;
                    var statusBadgeClass = log.IsRead ? "badge rounded-pill bg-success-subtle text-success" : "badge rounded-pill bg-primary text-white";
                    var statusText = log.IsRead ? Html.Localize("Read") : Html.Localize("Unread");
                    var postedLabel = string.Format(CultureInfo.CurrentCulture, Html.Localize("Posted {0}"), postedLocal.ToString("g", CultureInfo.CurrentCulture));
                    var authorLabel = string.Format(CultureInfo.CurrentCulture, Html.Localize("By {0}"), authorName);
                    <li class="widget-item">
                        <div class="d-flex gap-3 align-items-start">
                            <div class="flex-shrink-0">
                                <partial name="_UserAvatar" model="log.CreatorAvatar" />
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                    @if (hasLink)
                                    {
                                        <a class="fw-semibold" href="@log.DetailUrl">@titleDisplay</a>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">@titleDisplay</span>
                                    }
                                    <span class="@statusBadgeClass">@statusText</span>
                                </div>
                                <div class="text-muted small">@authorLabel</div>
                                @if (!string.IsNullOrWhiteSpace(previewDisplay))
                                {
                                    <div class="small text-muted mt-1">@previewDisplay</div>
                                }
                                <div class="small mt-1" style="color:@GetDateColor(log.CreatedAt);">@postedLabel</div>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted mb-0">@Html.Localize("Unsupported widget type.")</p>
        }
    </div>
</div>


