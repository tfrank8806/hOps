@using hOps.web.Utilities
@model hOps.web.ViewModels.MailLog.MailLogIndexViewModel

@{
    ViewData["Title"] = "Package & Mail Log";
    ViewData["MainContainerClass"] = "main-inner--wide";
}

<div class="row g-4 mail-log-page">
    <div class="col-12">
        @if (TempData["MailLogMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["MailLogError"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="col-12">
        <div class="card shadow-sm mail-log-card">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h2 class="h5 mb-0">Package &amp; Mail Log</h2>
                    @if (Model.HasProperty)
                    {
                        <small class="text-muted">Entries for @Model.CurrentPropertyName</small>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (!Model.HasProperty)
                {
                    <p class="text-muted mb-0">Select a property to view or record package log entries.</p>
                }
                else
                {
                    <form asp-action="Create" method="post" class="row g-3 mb-4">
                        @Html.AntiForgeryToken()
                        <div class="col-12">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.RecipientName" class="form-label"></label>
                            <input asp-for="Form.RecipientName" class="form-control" />
                            <span asp-validation-for="Form.RecipientName" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.Carrier" class="form-label"></label>
                            <input asp-for="Form.Carrier" class="form-control" />
                            <span asp-validation-for="Form.Carrier" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.TrackingNumber" class="form-label"></label>
                            <input asp-for="Form.TrackingNumber" class="form-control" />
                            <span asp-validation-for="Form.TrackingNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.RoomNumber" class="form-label"></label>
                            <input asp-for="Form.RoomNumber" class="form-control" />
                            <span asp-validation-for="Form.RoomNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.StorageLocation" class="form-label"></label>
                            <input asp-for="Form.StorageLocation" class="form-control" />
                            <span asp-validation-for="Form.StorageLocation" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.ArrivalDate" class="form-label"></label>
                            <input asp-for="Form.ArrivalDate" class="form-control" />
                            <span asp-validation-for="Form.ArrivalDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.DepartureDate" class="form-label"></label>
                            <input asp-for="Form.DepartureDate" class="form-control" />
                            <span asp-validation-for="Form.DepartureDate" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Form.Notes" class="form-label"></label>
                            <textarea asp-for="Form.Notes" class="form-control" rows="2" data-enable-mentions="true"></textarea>
                            <span asp-validation-for="Form.Notes" class="text-danger"></span>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-2">
                            <button type="reset" class="btn btn-outline-secondary">Clear</button>
                            <button type="submit" class="btn btn-primary">Add Entry</button>
                        </div>
                    </form>

                    @if (!Model.Entries.Any())
                    {
                        <p class="text-muted mb-0">No packages logged yet for @Model.CurrentPropertyName.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle mail-log-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Logged At</th>
                                        <th scope="col">Recipient</th>
                                        <th scope="col">Courier</th>
                                        <th scope="col">Tracking #</th>
                                        <th scope="col">Room #</th>
                                        <th scope="col">Storage</th>
                                        <th scope="col">Arrival</th>
                                        <th scope="col">Departure</th>
                                        <th scope="col">Notes</th>
                                        <th scope="col">Logged By</th>
                                        <th scope="col">Delivered?</th>
                                        <th scope="col">Delivered At</th>
                                        <th scope="col" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in Model.Entries)
                                    {
                                        var loggedLocal = TimeZoneService.ConvertToUserTime(entry.LoggedAt);
                                        var deliveredLocal = entry.DeliveredAt.HasValue ? TimeZoneService.ConvertToUserTime(entry.DeliveredAt.Value) : (DateTime?)null;
                                        <tr>
                                            <td>@loggedLocal.ToString("g")</td>
                                            <td>@entry.RecipientName</td>
                                            <td>@(string.IsNullOrWhiteSpace(entry.Carrier) ? "-" : entry.Carrier)</td>
                                            <td>@(string.IsNullOrWhiteSpace(entry.TrackingNumber) ? "-" : entry.TrackingNumber)</td>
                                            <td>@(string.IsNullOrWhiteSpace(entry.RoomNumber) ? "-" : entry.RoomNumber)</td>
                                            <td>@(string.IsNullOrWhiteSpace(entry.StorageLocation) ? "-" : entry.StorageLocation)</td>
                                            <td>@(entry.ArrivalDate.HasValue ? entry.ArrivalDate.Value.ToString("MMM d, yyyy") : "-")</td>
                                            <td>@(entry.DepartureDate.HasValue ? entry.DepartureDate.Value.ToString("MMM d, yyyy") : "-")</td>
                                            <td class="notes-cell">
                                                @if (!string.IsNullOrWhiteSpace(entry.Notes))
                                                {
                                                    @Html.Raw(MentionMarkupFormatter.ToHtml(entry.Notes))
                                                }
                                                else
                                                {
                                                    @("-")
                                                }
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(entry.LoggedByName) ? "-" : entry.LoggedByName)</td>
                                            <td class="delivered-cell">
                                                <span class="badge @(entry.Delivered ? "text-bg-success" : "text-bg-secondary")">
                                                    @(entry.Delivered ? "Yes" : "No")
                                                </span>
                                            </td>
                                            <td>@(deliveredLocal.HasValue ? deliveredLocal.Value.ToString("g") : "-")</td>
                                            <td class="text-end actions-cell">
                                                <form asp-action="ToggleDelivered" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@entry.Id" />
                                                    <input type="hidden" name="delivered" value="@(!entry.Delivered)" />
                                                    <button type="submit" class="btn btn-sm @(entry.Delivered ? "btn-outline-warning" : "btn-outline-success")">
                                                        @(entry.Delivered ? "Mark Pending" : "Mark Delivered")
                                                    </button>
                                                </form>
                                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Remove this entry?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@entry.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
