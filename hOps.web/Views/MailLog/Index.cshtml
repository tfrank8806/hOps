@using hOps.web.Utilities
@model hOps.web.ViewModels.MailLog.MailLogIndexViewModel

@{
    ViewData["Title"] = Html.Localize("Package & Mail Log");
    ViewData["MainContainerClass"] = "main-inner--wide";
}

<div class="row g-4 mail-log-page">
    <div class="col-12">
        @if (TempData["MailLogMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label='@Html.Localize("Close")'></button>
            </div>
        }
        @if (TempData["MailLogError"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label='@Html.Localize("Close")'></button>
            </div>
        }
        <div id="mailLogAlertContainer"></div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm mail-log-card">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h2 class="h5 mb-0">@Html.Localize("Package & Mail Log")</h2>
                    @if (Model.HasProperty)
                    {
                        <small class="text-muted">@string.Format(Html.Localize("Entries for {0}"), Model.CurrentPropertyName)</small>
                    }
                </div>
                @if (Model.HasProperty)
                {
                    <form asp-action="Index" method="get" class="form-check form-switch mb-0">
                        <input asp-for="HideDelivered" class="form-check-input" type="checkbox" id="hideDeliveredToggle" onchange="this.form.submit()" />
                        <label class="form-check-label" asp-for="HideDelivered"></label>
                    </form>
                }
            </div>
            <div class="card-body">
                @if (!Model.HasProperty)
                {
                    <p class="text-muted mb-0">@Html.Localize("Select a property to view or record package log entries.")</p>
                }
                else
                {
                    <form asp-action="Create" method="post" class="row g-3 mb-4" id="mailLogCreateForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="hideDelivered" value="@(Model.HideDelivered ? "true" : "false")" />
                        <div class="col-12">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.RecipientName" class="form-label"></label>
                            <input asp-for="Form.RecipientName" class="form-control" />
                            <span asp-validation-for="Form.RecipientName" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.Carrier" class="form-label"></label>
                            <input asp-for="Form.Carrier" class="form-control" />
                            <span asp-validation-for="Form.Carrier" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.TrackingNumber" class="form-label"></label>
                            <input asp-for="Form.TrackingNumber" class="form-control" />
                            <span asp-validation-for="Form.TrackingNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.RoomNumber" class="form-label"></label>
                            <input asp-for="Form.RoomNumber" class="form-control" />
                            <span asp-validation-for="Form.RoomNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.StorageLocation" class="form-label"></label>
                            <input asp-for="Form.StorageLocation" class="form-control" />
                            <span asp-validation-for="Form.StorageLocation" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.ArrivalDate" class="form-label"></label>
                            <input asp-for="Form.ArrivalDate" class="form-control" />
                            <span asp-validation-for="Form.ArrivalDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.DepartureDate" class="form-label"></label>
                            <input asp-for="Form.DepartureDate" class="form-control" />
                            <span asp-validation-for="Form.DepartureDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Form.PackageReceivedDate" class="form-label"></label>
                            <input asp-for="Form.PackageReceivedDate" class="form-control" type="date" />
                            <span asp-validation-for="Form.PackageReceivedDate" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Form.Notes" class="form-label"></label>
                            <textarea asp-for="Form.Notes" class="form-control" rows="2" data-enable-mentions="true"></textarea>
                            <span asp-validation-for="Form.Notes" class="text-danger"></span>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-2">
                            <button type="reset" class="btn btn-outline-secondary">@Html.Localize("Clear")</button>
                            <button type="submit" class="btn btn-primary">@Html.Localize("Add Entry")</button>
                        </div>
                    </form>

                    @if (!Model.Entries.Any())
                    {
                    <p class="text-muted mb-0">
                        @(Model.HideDelivered
                            ? Html.Localize("No packages waiting to be delivered to a guest.")
                            : string.Format(Html.Localize("No packages logged yet for {0}."), Model.CurrentPropertyName))
                    </p>
                }
                else
                {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle mail-log-table">
                                <thead>
                                    <tr>
                                        <th scope="col">@Html.Localize("Logged at")</th>
                                        <th scope="col">@Html.Localize("Recipient")</th>
                                        <th scope="col">@Html.Localize("Courier")</th>
                                        <th scope="col">@Html.Localize("Tracking #")</th>
                                        <th scope="col">@Html.Localize("Room #")</th>
                                        <th scope="col">@Html.Localize("Storage")</th>
                                        <th scope="col">@Html.Localize("Arrival")</th>
                                        <th scope="col">@Html.Localize("Package Received")</th>
                                        <th scope="col">@Html.Localize("Departure")</th>
                                        <th scope="col">@Html.Localize("Notes")</th>
                                        <th scope="col">@Html.Localize("Logged by")</th>
                                        <th scope="col">@Html.Localize("Delivered?")</th>
                                        <th scope="col">@Html.Localize("Delivered At")</th>
                                        <th scope="col" class="text-end">@Html.Localize("Actions")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in Model.Entries)
                                    {
                                        var loggedLocal = TimeZoneService.ConvertToUserTime(entry.LoggedAt);
                                        var deliveredLocal = entry.DeliveredAt.HasValue ? TimeZoneService.ConvertToUserTime(entry.DeliveredAt.Value) : (DateTime?)null;
                                        <tr data-entry-id="@entry.Id">
                                            <td>@loggedLocal.ToString("g")</td>
                                            <td>@entry.RecipientName</td>
                                            <td>@(string.IsNullOrWhiteSpace(entry.Carrier) ? "-" : entry.Carrier)</td>
                                            <td>@(string.IsNullOrWhiteSpace(entry.TrackingNumber) ? "-" : entry.TrackingNumber)</td>
                                            <td>@(string.IsNullOrWhiteSpace(entry.RoomNumber) ? "-" : entry.RoomNumber)</td>
                                            <td>@(string.IsNullOrWhiteSpace(entry.StorageLocation) ? "-" : entry.StorageLocation)</td>
                                            <td>@(entry.ArrivalDate.HasValue ? entry.ArrivalDate.Value.ToString("MMM d, yyyy") : "-")</td>
                                            <td>@(entry.PackageReceivedDate.HasValue ? entry.PackageReceivedDate.Value.ToString("MMM d, yyyy") : "-")</td>
                                            <td>@(entry.DepartureDate.HasValue ? entry.DepartureDate.Value.ToString("MMM d, yyyy") : "-")</td>
                                            <td class="notes-cell">
                                                @if (!string.IsNullOrWhiteSpace(entry.Notes))
                                                {
                                                    @Html.Raw(MentionMarkupFormatter.ToHtml(entry.Notes))
                                                }
                                                else
                                                {
                                                    @("-")
                                                }
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(entry.LoggedByName) ? "-" : entry.LoggedByName)</td>
                                            <td class="delivered-cell">
                                                <span class="badge delivered-badge @(entry.Delivered ? "text-bg-success" : "text-bg-secondary")">
                                                    @(entry.Delivered ? Html.Localize("Yes") : Html.Localize("No"))
                                                </span>
                                            </td>
                                            <td data-col="deliveredAt">@(deliveredLocal.HasValue ? deliveredLocal.Value.ToString("g") : "-")</td>
                                            <td class="text-end actions-cell">
                                                <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#editMailLogModal-@entry.Id">
                                                    @Html.Localize("Edit")
                                                </button>
                                                <form asp-action="ToggleDelivered" method="post" class="d-inline mail-log-toggle-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@entry.Id" />
                                                    <input type="hidden" name="delivered" value="@(entry.Delivered ? "false" : "true")" />
                                                    <input type="hidden" name="hideDelivered" value="@(Model.HideDelivered ? "true" : "false")" />
                                                    <button type="submit" class="btn btn-sm toggle-delivered-button @(entry.Delivered ? "btn-outline-warning" : "btn-outline-success")">
                                                        @(entry.Delivered ? Html.Localize("Mark Pending") : Html.Localize("Mark Delivered"))
                                                    </button>
                                                </form>
                                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm(window.hopsTranslate('MailLogConfirmRemove', 'Remove this entry?'));">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@entry.Id" />
                                                    <input type="hidden" name="hideDelivered" value="@(Model.HideDelivered ? "true" : "false")" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Html.Localize("Remove")</button>
                                                </form>
                                                <div class="modal fade" id="editMailLogModal-@entry.Id" tabindex="-1" aria-labelledby="editMailLogModalLabel-@entry.Id" aria-hidden="true">
                                                    <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title" id="editMailLogModalLabel-@entry.Id">@Html.Localize("Edit Package Entry")</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Html.Localize("Close")'></button>
                                                            </div>
                                                            <form asp-action="Edit" method="post" novalidate>
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="Id" value="@entry.Id" />
                                                                <input type="hidden" name="hideDelivered" value="@(Model.HideDelivered ? "true" : "false")" />
                                                                <div class="modal-body">
                                                                    <div class="row g-3">
                                                                        <div class="col-md-6">
                                                                            <label class="form-label" for="mail-log-edit-recipient-@entry.Id">@Html.Localize("Recipient Name")</label>
                                                                            <input class="form-control" id="mail-log-edit-recipient-@entry.Id" name="RecipientName" value="@entry.RecipientName" maxlength="256" required />
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <label class="form-label" for="mail-log-edit-carrier-@entry.Id">@Html.Localize("Carrier")</label>
                                                                            <input class="form-control" id="mail-log-edit-carrier-@entry.Id" name="Carrier" value="@entry.Carrier" maxlength="128" />
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <label class="form-label" for="mail-log-edit-tracking-@entry.Id">@Html.Localize("Tracking Number")</label>
                                                                            <input class="form-control" id="mail-log-edit-tracking-@entry.Id" name="TrackingNumber" value="@entry.TrackingNumber" maxlength="128" />
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <label class="form-label" for="mail-log-edit-room-@entry.Id">@Html.Localize("Room Number")</label>
                                                                            <input class="form-control" id="mail-log-edit-room-@entry.Id" name="RoomNumber" value="@entry.RoomNumber" maxlength="64" />
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <label class="form-label" for="mail-log-edit-storage-@entry.Id">@Html.Localize("Storage Location")</label>
                                                                            <input class="form-control" id="mail-log-edit-storage-@entry.Id" name="StorageLocation" value="@entry.StorageLocation" maxlength="150" />
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <label class="form-label" for="mail-log-edit-arrival-@entry.Id">@Html.Localize("Arrival Date")</label>
                                                                            <input type="date" class="form-control" id="mail-log-edit-arrival-@entry.Id" name="ArrivalDate" value="@(entry.ArrivalDate.HasValue ? entry.ArrivalDate.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <label class="form-label" for="mail-log-edit-departure-@entry.Id">@Html.Localize("Departure Date")</label>
                                                                            <input type="date" class="form-control" id="mail-log-edit-departure-@entry.Id" name="DepartureDate" value="@(entry.DepartureDate.HasValue ? entry.DepartureDate.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <label class="form-label" for="mail-log-edit-received-@entry.Id">@Html.Localize("Package Received Date")</label>
                                                                            <input type="date" class="form-control" id="mail-log-edit-received-@entry.Id" name="PackageReceivedDate" value="@(entry.PackageReceivedDate.HasValue ? entry.PackageReceivedDate.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                                                                        </div>
                                                                        <div class="col-12">
                                                                            <label class="form-label" for="mail-log-edit-notes-@entry.Id">@Html.Localize("Notes")</label>
                                                                            <textarea class="form-control" id="mail-log-edit-notes-@entry.Id" name="Notes" rows="4" maxlength="512" data-enable-mentions="true">@entry.Notes</textarea>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.Localize("Cancel")</button>
                                                                    <button type="submit" class="btn btn-primary">@Html.Localize("Save changes")</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/mail-log.js" asp-append-version="true"></script>
}

