@{
    ViewData["Title"] = "Package & Mail Log";
}

<div class="row g-4 mail-log-page">
    <div class="col-12">
        <div class="card shadow-sm mail-log-card">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h2 class="h5 mb-0">Package &amp; Mail Log</h2>
                    <small class="text-muted">Record deliveries and pickups for guests.</small>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-lg-8">
                        <p id="mailLogStorageMessage" class="text-muted mb-0">
                            Entries are stored locally in this browser so each device keeps its own package log.
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <span class="badge bg-light text-dark border">Client-side log</span>
                    </div>
                </div>

                <form id="mailLogForm" class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label for="mailLogGuestName" class="form-label">Guest Name <span class="text-muted">(optional)</span></label>
                        <input type="text" class="form-control" id="mailLogGuestName" name="guestName" maxlength="150" placeholder="e.g. Jamie Rivera" />
                    </div>
                    <div class="col-md-3">
                        <label for="mailLogCourier" class="form-label">Courier <span class="text-muted">(optional)</span></label>
                        <input type="text" class="form-control" id="mailLogCourier" name="courier" maxlength="100" placeholder="e.g. FedEx" />
                    </div>
                    <div class="col-md-3">
                        <label for="mailLogTrackingNumber" class="form-label">Tracking Number <span class="text-muted">(optional)</span></label>
                        <input type="text" class="form-control" id="mailLogTrackingNumber" name="trackingNumber" maxlength="100" placeholder="e.g. 1234 5678 9012" />
                    </div>
                    <div class="col-md-3">
                        <label for="mailLogRoomNumber" class="form-label">Room Number <span class="text-muted">(optional)</span></label>
                        <input type="text" class="form-control" id="mailLogRoomNumber" name="roomNumber" maxlength="50" placeholder="e.g. 204" />
                    </div>
                    <div class="col-md-3">
                        <label for="mailLogArrivalDate" class="form-label">Arrival Date <span class="text-muted">(optional)</span></label>
                        <input type="date" class="form-control" id="mailLogArrivalDate" name="arrivalDate" />
                    </div>
                    <div class="col-md-3">
                        <label for="mailLogDepartureDate" class="form-label">Departure Date <span class="text-muted">(optional)</span></label>
                        <input type="date" class="form-control" id="mailLogDepartureDate" name="departureDate" />
                    </div>
                    <div class="col-md-3">
                        <label for="mailLogStorageLocation" class="form-label">Storage Location <span class="text-muted">(optional)</span></label>
                        <input type="text" class="form-control" id="mailLogStorageLocation" name="storageLocation" maxlength="150" placeholder="e.g. Front desk closet" />
                    </div>
                    <div class="col-12">
                        <label for="mailLogNotes" class="form-label">Notes <span class="text-muted">(optional)</span></label>
                        <textarea class="form-control" id="mailLogNotes" name="notes" rows="2" maxlength="500" placeholder="Add any special instructions or identifying details"></textarea>
                    </div>
                    <div class="col-12 d-flex justify-content-end gap-2">
                        <button type="reset" class="btn btn-outline-secondary">Clear</button>
                        <button type="submit" class="btn btn-primary">Add Entry</button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-striped align-middle mail-log-table" id="mailLogTable">
                        <thead>
                            <tr>
                                <th scope="col">Logged At</th>
                                <th scope="col">Guest Name</th>
                                <th scope="col">Courier</th>
                                <th scope="col">Tracking Number</th>
                                <th scope="col">Room #</th>
                                <th scope="col">Arrival Date</th>
                                <th scope="col">Departure Date</th>
                                <th scope="col">Storage Location</th>
                                <th scope="col">Notes</th>
                                <th scope="col" class="text-center">Delivered?</th>
                                <th scope="col">Delivered At</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="mailLogTableBody">
                            <tr id="mailLogEmptyState">
                                <td colspan="12" class="text-center text-muted py-4">
                                    No packages logged yet. Use the form above to record the first delivery.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/mail-log.css" />
}

@section Scripts {
    <script src="~/js/mailLog.js"></script>
}
