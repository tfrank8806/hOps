@using System.Collections.Generic
@using hOps.web.ViewModels.SiteVisit
@model SiteVisitPageViewModel
@{
    ViewData["Title"] = "Site Visit";
    Model.Items ??= new List<SiteVisitChecklistItemViewModel>();
    var nextIndex = Model.Items.Count;
    var statusMetadata = new (SiteVisitChecklistStatus Status, string Label, string Description, string Css)[]
    {
        (SiteVisitChecklistStatus.NotReviewed, "Not Reviewed", "Not yet graded", string.Empty),
        (SiteVisitChecklistStatus.Compliant, "Compliant", "Green - Fully compliant", "status-compliant"),
        (SiteVisitChecklistStatus.NeedsReview, "Needs Review", "Yellow - Follow-up required", "status-needs-review"),
        (SiteVisitChecklistStatus.NotCompliant, "Not Compliant", "Red - Immediate attention", "status-not-compliant")
    };
}

@functions {
    private static string StatusCssClass(SiteVisitChecklistStatus status) => status switch
    {
        SiteVisitChecklistStatus.Compliant => "status-compliant",
        SiteVisitChecklistStatus.NeedsReview => "status-needs-review",
        SiteVisitChecklistStatus.NotCompliant => "status-not-compliant",
        _ => string.Empty
    };
}

<div class="site-visit-page">
    <div class="site-visit-header">
        <div>
            <p class="text-uppercase text-muted fw-semibold small mb-1">Property leadership checklist</p>
            <h1 class="h2 mb-2">Site Visit</h1>
            <p class="text-muted mb-0">
                Capture observations, grade each focus area, and instantly share the completed checklist in Excel.
            </p>
        </div>
        <div class="text-end">
            <div class="text-muted small">
                <div>@(Model.PropertyName ?? (ViewBag.CurrentProperty?.Name as string) ?? "Property TBD")</div>
                <div>@Model.VisitDate.ToString("D")</div>
            </div>
            <div class="d-flex flex-wrap gap-2 justify-content-end mt-2">
                <a class="btn btn-outline-secondary btn-sm" asp-controller="SiteVisit" asp-action="Log">
                    View Site Visit Log
                </a>
                <a class="btn btn-outline-primary btn-sm" asp-controller="SiteVisit" asp-action="Templates">
                    Manage Templates
                </a>
            </div>
        </div>
    </div>

    @if (Model.SubmittedSuccessfully && !string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success d-flex align-items-center gap-2" role="status">
            <span class="fw-semibold">Success</span>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    }

    <form asp-action="Submit" method="post" class="site-visit-form" novalidate>
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card site-visit-card h-100">
                    <div class="card-body">
                        <h2 class="h5 mb-4">Visit overview</h2>
                        <div class="mb-3">
                            <label asp-for="PropertyName" class="form-label"></label>
                            <input asp-for="PropertyName" class="form-control" placeholder="Property or asset name" />
                            <span asp-validation-for="PropertyName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="VisitDate" class="form-label"></label>
                            <input asp-for="VisitDate" type="date" class="form-control" />
                            <span asp-validation-for="VisitDate" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="LeaderName" class="form-label"></label>
                            <input asp-for="LeaderName" class="form-control" placeholder="Leader completing the visit" />
                            <span asp-validation-for="LeaderName" class="text-danger small"></span>
                        </div>
                        <div class="mb-0">
                            <label asp-for="SummaryNotes" class="form-label"></label>
                            <textarea asp-for="SummaryNotes"
                                      rows="4"
                                      class="form-control"
                                      placeholder="Optional high-level notes or action items"></textarea>
                            <span asp-validation-for="SummaryNotes" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card site-visit-card mb-4 mb-lg-0">
                    <div class="card-body d-flex flex-column gap-3">
                        @if (Model.HasTemplateOptions)
                        {
                            <div class="bg-light border rounded-3 p-3">
                                <form method="get"
                                      class="d-flex flex-wrap align-items-end gap-2"
                                      data-template-picker>
                                    <div>
                                        <label class="form-label form-label-sm fw-semibold text-uppercase text-muted small mb-1"
                                               for="templateIdSelect">
                                            Checklist template
                                        </label>
                                        <select class="form-select form-select-sm"
                                                id="templateIdSelect"
                                                name="templateId">
                                            @foreach (var option in Model.TemplateOptions)
                                            {
                                                if (option.Selected)
                                                {
                                                    <option value="@option.Value" selected="selected">@option.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@option.Value">@option.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-primary"
                                            data-template-apply>
                                        Apply template
                                    </button>
                                    <a asp-action="Templates" class="btn btn-link btn-sm text-decoration-none">
                                        Manage templates
                                    </a>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info small mb-0">
                                Want to reuse this checklist later? <a asp-action="Templates" class="alert-link">Create a template</a> from a CSV upload.
                            </div>
                        }
                        <div class="site-visit-actions">
                            <div>
                                <h2 class="h5 mb-1">Checklist</h2>
                                <p class="text-muted mb-0">Update the focus areas below or add your own checkpoints.</p>
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-add-checklist-item>
                                + Add checklist item
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle site-visit-table mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Checklist Item</th>
                                        <th scope="col" style="width: 220px;">Status</th>
                                        <th scope="col">Notes</th>
                                        <th scope="col" class="text-center" style="width: 50px;"></th>
                                    </tr>
                                </thead>
                                <tbody data-checklist-body data-next-index="@nextIndex">
                                    @for (int i = 0; i < Model.Items.Count; i++)
                                    {
                                        var item = Model.Items[i];
                                        var css = StatusCssClass(item.Status);
                                        <tr data-checklist-row data-index="@i">
                                            <td>
                            <input type="hidden" name="Items.Index" value="@i" />
                                                <input asp-for="Items[i].Title"
                                                       class="form-control form-control-sm"
                                                       placeholder="Enter checklist focus" />
                                                <span asp-validation-for="Items[i].Title" class="text-danger small"></span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                <span class="status-dot @(string.IsNullOrWhiteSpace(css) ? string.Empty : css)" data-status-dot aria-hidden="true"></span>
                <select asp-for="Items[i].Status"
                        class="form-select form-select-sm site-visit-status @(string.IsNullOrWhiteSpace(css) ? string.Empty : css)"
                        data-status-select>
                                                        @foreach (var option in statusMetadata)
                                                        {
                                                            <option value="@option.Status">@option.Label</option>
                                                        }
                                                    </select>
                                                </div>
                                                <span asp-validation-for="Items[i].Status" class="text-danger small"></span>
                                            </td>
                                            <td>
                                                <textarea asp-for="Items[i].Notes"
                                                          rows="2"
                                                          class="form-control form-control-sm site-visit-notes"
                                                          data-notes-input
                                                          placeholder="Document what you observed or next steps"></textarea>
                                                <span asp-validation-for="Items[i].Notes" class="text-danger small"></span>
                                            </td>
                                            <td class="text-center">
                                                <button type="button"
                                                        class="btn btn-link btn-sm text-danger"
                                                        title="Remove item"
                                                        data-remove-row>
                                                    Remove
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="site-visit-legend bg-light rounded-3 p-3">
                            @foreach (var entry in statusMetadata)
                            {
                                <div class="site-visit-legend-item">
                                    <span class="status-dot @entry.Css" aria-hidden="true"></span>
                                    <span>
                                        <strong>@entry.Label</strong><br />
                                        <span class="text-muted">@entry.Description</span>
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-1">
            <div class="col-xl-8">
                <div class="card site-visit-card site-visit-email-card">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Share the completed checklist</h2>
                        <div class="mb-3">
                            <label asp-for="RecipientEmails" class="form-label"></label>
                            <input asp-for="RecipientEmails" class="form-control" placeholder="name1@brand.com, name2@brand.com" />
                            <div class="form-text">
                                Enter one or more addresses separated by commas, semicolons, or line breaks. We'll email an Excel copy immediately.
                            </div>
                            <span asp-validation-for="RecipientEmails" class="text-danger small"></span>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">
                                Send checklist via email
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Reset form
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<template id="siteVisitRowTemplate">
    <tr data-checklist-row data-index="__index__">
        <td>
            <input type="hidden" name="Items.Index" value="__index__" />
            <input class="form-control form-control-sm"
                   name="Items[__index__].Title"
                   placeholder="Enter checklist focus" />
        </td>
        <td>
            <div class="d-flex align-items-center gap-2">
                <span class="status-dot" data-status-dot aria-hidden="true"></span>
                <select class="form-select form-select-sm site-visit-status"
                        name="Items[__index__].Status"
                        data-status-select>
                    @foreach (var option in statusMetadata)
                    {
                        <option value="@option.Status">@option.Label</option>
                    }
                </select>
            </div>
        </td>
        <td>
            <textarea class="form-control form-control-sm site-visit-notes"
                      name="Items[__index__].Notes"
                      rows="2"
                      data-notes-input
                      placeholder="Document what you observed or next steps"></textarea>
        </td>
        <td class="text-center">
            <button type="button" class="btn btn-link btn-sm text-danger" data-remove-row>Remove</button>
        </td>
    </tr>
</template>

@section Styles {
    <link rel="stylesheet" href="~/css/site-visit.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site-visit.js" asp-append-version="true"></script>
}
