@using System.Globalization
@model hOps.web.ViewModels.SiteVisit.SiteVisitTemplateManagerViewModel
@{
    ViewData["Title"] = Html.Localize("Site Visit Templates");
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-uppercase text-muted fw-semibold small mb-1">@Html.Localize("Checklist library")</p>
        <h1 class="h2 mb-2">@Html.Localize("Site Visit Templates")</h1>
        <p class="text-muted mb-0">
            @Html.Localize("Upload CSV files with your recurring checkpoints and reuse them when kicking off a new site visit.")
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="DownloadBlankTemplate" class="btn btn-outline-secondary">
            @Html.Localize("Download blank template")
        </a>
        <a asp-action="Index" class="btn btn-primary">
            @Html.Localize("Back to Site Visit")
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status">
        @Model.SuccessMessage
    </div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
     style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">@Html.Localize("Saved templates")</h2>
                @if (Model.Templates.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var template in Model.Templates)
                        {
                            var templateId = template.Id.ToString(CultureInfo.InvariantCulture);
                            var translatedName = await Html.DisplayTranslatedTextAsync("SiteVisitTemplate", templateId, "Name", template.Name);
                            var translatedDescription = string.IsNullOrWhiteSpace(template.Description)
                                ? string.Empty
                                : await Html.DisplayTranslatedTextAsync("SiteVisitTemplate", templateId, "Description", template.Description ?? string.Empty);
                            var itemLabel = template.ItemCount == 1 ? Html.Localize("item") : Html.Localize("items");
                            var lastUpdated = template.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture);
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                    <div>
                                        <div class="fw-semibold">@translatedName</div>
                                        @if (!string.IsNullOrWhiteSpace(translatedDescription))
                                        {
                                            <div class="text-muted small">@translatedDescription</div>
                                        }
                                    </div>
                                    <span class="badge bg-light text-dark">
                                        @template.ItemCount @itemLabel
                                    </span>
                                </div>
                                <div class="text-muted small mt-2 d-flex flex-wrap gap-3">
                                    <span>@Html.Localize("Last updated") @lastUpdated</span>
                                    @if (!string.IsNullOrWhiteSpace(template.CreatedByName))
                                    {
                                        <span>@Html.Localize("Created by") @template.CreatedByName</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        @Html.Localize("No templates yet. Upload a CSV on the right to get started.")
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">@Html.Localize("Upload CSV template")</h2>
                <p class="text-muted small">
                    @Html.Localize("CSV format: columns")
                    <code>Section</code>
                    @Html.Localize("and")
                    <code>Title</code>
                    @Html.Localize("(section may be blank) with one checklist item per row.")
                    <br />
                    @Html.Localize("Up to 200 rows are supported.")
                </p>
                <form asp-action="UploadTemplate" method="post" enctype="multipart/form-data" class="vstack gap-3">
                    @Html.AntiForgeryToken()
                    <div>
                        <label asp-for="Upload.Name" class="form-label"></label>
                        <input asp-for="Upload.Name" class="form-control" />
                        <span asp-validation-for="Upload.Name" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Upload.Description" class="form-label"></label>
                        <textarea asp-for="Upload.Description" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Upload.Description" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Upload.CsvFile" class="form-label"></label>
                        <input asp-for="Upload.CsvFile" type="file" class="form-control" accept=".csv,text/csv" />
                        <div class="form-text">
                            @Html.Localize("CSV files up to 2 MB. We'll trim blank lines and duplicate entries automatically.")
                            @Html.Localize("Use the same section name for consecutive items to group them together.")
                        </div>
                        <span asp-validation-for="Upload.CsvFile" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        @Html.Localize("Upload template")
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
