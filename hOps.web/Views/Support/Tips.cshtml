@{
    ViewData["Title"] ??= "Tips & Tricks";
}

<div class="d-flex flex-column gap-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h2 class="h5 mb-0">Quick wins in hOps</h2>
            <small class="text-muted">Sharpen your workflow with these built-in helpers.</small>
        </div>
        <div class="card-body">
            <div class="row g-4 row-cols-1 row-cols-md-2">
                <div class="col">
                    <div class="p-3 border rounded h-100 bg-light-subtle">
                        <h3 class="h6 text-uppercase text-muted">Mention teammates</h3>
                        <p class="mb-2">Type <code>&#64;</code> followed by a name anywhere you can write rich text (logs, comments, messages). hOps suggests people as you type and sends them a notification.</p>
                        <ul class="small ps-3 mb-0">
                            <li>Use <code>&#64;all</code> to reach everyone with access to the item.</li>
                            <li>Mentions work in Pass On Logs, Package Logs, Work Orders, and Direct Messages.</li>
                        </ul>
                    </div>
                </div>
                <div class="col">
                    <div class="p-3 border rounded h-100 bg-light-subtle">
                        <h3 class="h6 text-uppercase text-muted">Stay on top of logs</h3>
                        <p class="mb-2">Click any log cell and use the toolbar to format text, change colors, or merge cells. Arrow keys move between entries—press <kbd>Enter</kbd> to edit and <kbd>Esc</kbd> to cancel.</p>
                        <ul class="small ps-3 mb-0">
                            <li>Use the sidebar to switch logs or duplicate templates.</li>
                            <li>Export to Excel anytime for offline tracking.</li>
                        </ul>
                    </div>
                </div>
                <div class="col">
                    <div class="p-3 border rounded h-100 bg-light-subtle">
                        <h3 class="h6 text-uppercase text-muted">Work order shortcuts</h3>
                        <p class="mb-2">Assign a department, add photos, and &#64;mention teammates in updates so everyone stays aligned.</p>
                        <ul class="small ps-3 mb-0">
                            <li>Filter the list to show only your departments or open items.</li>
                            <li>Use the timeline to track every status change.</li>
                        </ul>
                    </div>
                </div>
                <div class="col">
                    <div class="p-3 border rounded h-100 bg-light-subtle">
                        <h3 class="h6 text-uppercase text-muted">Calendar & reminders</h3>
                        <p class="mb-2">Create calendar events for inspections, VIP arrivals, and recurring tasks. Attach properties so the right teams see them.</p>
                        <ul class="small ps-3 mb-0">
                            <li>Switch between property calendars with the selector in the header.</li>
                            <li>Add subscribers to send reminders automatically.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h2 class="h5 mb-0">Communication best practices</h2>
        </div>
        <div class="card-body">
            <ul class="list-unstyled d-flex flex-column gap-3 mb-0">
                <li>
                    <h3 class="h6 mb-1 text-uppercase text-muted">Use Pass On Logs for shift notes</h3>
                    <p class="mb-0">Create one log per focus area (Front Desk, Engineering, Housekeeping). Color-code rows to highlight follow-up items.</p>
                </li>
                <li>
                    <h3 class="h6 mb-1 text-uppercase text-muted">Keep the inbox tidy</h3>
                    <p class="mb-0">Direct Messages are great for quick clarifications. Use the "View History" button in logs if you need to review who changed what.</p>
                </li>
                <li>
                    <h3 class="h6 mb-1 text-uppercase text-muted">Bookmark recurring resources</h3>
                    <p class="mb-0">Save key SOPs or vendor info with bookmarks. They surface on the Home dashboard for fast access.</p>
                </li>
            </ul>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h2 class="h5 mb-0">Need a deeper dive?</h2>
                <small class="text-muted">We are building a richer knowledge base—tell us what to cover next.</small>
            </div>
            <a asp-action="Index" class="btn btn-outline-primary btn-sm">Submit a Support Ticket</a>
        </div>
        <div class="card-body">
            <div class="row g-4 row-cols-1 row-cols-md-2">
                <div class="col">
                    <div class="border rounded p-3 h-100">
                        <h3 class="h6 text-uppercase text-muted">Training ideas</h3>
                        <ul class="small ps-3 mb-0">
                            <li>How to build reusable log templates</li>
                            <li>Setting up departments &amp; staffing notifications</li>
                            <li>Automating daily summary emails</li>
                        </ul>
                    </div>
                </div>
                <div class="col">
                    <div class="border rounded p-3 h-100">
                        <h3 class="h6 text-uppercase text-muted">Share your tips</h3>
                        <p class="small mb-2">Have a workflow hack or template that helps your team? Send it via Support so we can add it here.</p>
                        <p class="small mb-0 text-muted">Together we keep operations running smoothly.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
