@model hOps.web.ViewModels.Support.SupportTicketViewModel
@using hOps.web.Models
@{
    ViewData["Title"] ??= "Support";
    var currentProperty = ViewBag.CurrentProperty as Property;
}

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h2 class="h5 mb-0">Submit a Support Ticket</h2>
                    <small class="text-muted">Let us know what you need and the admin team will follow up by email.</small>
                </div>
            </div>
            <div class="card-body">
                @if (Model.SubmittedSuccessfully)
                {
                    <div class="alert alert-success" role="alert">
                        Thanks! Your request has been sent to the admin team.
                    </div>
                }

                <form asp-action="Index" method="post" enctype="multipart/form-data" novalidate>
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(false, "", new { @class = "text-danger fw-semibold" })

                    <div class="mb-3">
                        <label asp-for="Category" class="form-label fw-semibold"></label>
                        <select asp-for="Category" asp-items="Model.CategoryOptions" class="form-select"></select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label fw-semibold"></label>
                        <input asp-for="Subject" class="form-control" placeholder="Short summary of the request" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Message" class="form-label fw-semibold"></label>
                        <textarea asp-for="Message" class="form-control" rows="6" placeholder="Share as much detail as possible so we can help quickly."></textarea>
                        <div class="form-text">You can attach screenshots or paste links to help explain the request.</div>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ContactName" class="form-label fw-semibold"></label>
                            <input asp-for="ContactName" class="form-control" />
                            <span asp-validation-for="ContactName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactEmail" class="form-label fw-semibold"></label>
                            <input asp-for="ContactEmail" class="form-control" placeholder="you@example.com" />
                            <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Attachments" class="form-label fw-semibold"></label>
                        <input asp-for="Attachments" class="form-control" type="file" multiple accept="image/*,.pdf" />
                        <div class="form-text">Upload up to 5 files (images or PDF, max 5&nbsp;MB each). For screen captures, paste into an image file and attach it here.</div>
                        <span asp-validation-for="Attachments" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Support" asp-action="Tips" class="btn btn-outline-secondary">View Tips &amp; Tricks</a>
                        <button type="submit" class="btn btn-primary">Send Ticket</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h3 class="h6 mb-0">Helpful context</h3>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <div>
                    <h4 class="h6 text-uppercase text-muted">Current Property</h4>
                    @if (currentProperty != null)
                    {
                        <p class="mb-0 fw-semibold">@currentProperty.Name</p>
                        <p class="mb-0 text-muted small">@currentProperty.Code</p>
                    }
                    else
                    {
                        <p class="mb-0 text-muted">No property selected</p>
                    }
                </div>
                <div>
                    <h4 class="h6 text-uppercase text-muted">What happens next?</h4>
                    <ul class="small ps-3 mb-0">
                        <li>An email is sent to the admin team with your details.</li>
                        <li>You will receive any follow-up questions at the contact email you provided.</li>
                        <li>Urgent issues? Reach out to a manager directly after submitting this ticket.</li>
                    </ul>
                </div>
                <div>
                    <h4 class="h6 text-uppercase text-muted">Need a refresher?</h4>
                    <p class="small mb-0">
                        Visit the <a asp-controller="Support" asp-action="Tips">Tips &amp; Tricks</a> page for quick guides on mentions, logs, work orders, and more.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
