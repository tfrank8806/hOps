@model hOps.web.ViewModels.MyProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<h2 class="mb-4">My Profile</h2>

@if (TempData["ProfileUpdated"] != null)
{
    <div class="alert alert-success">Your profile has been updated.</div>
}
@if (TempData["PasswordChanged"] != null)
{
    <div class="alert alert-success">Your password has been changed.</div>
}
@if (TempData["EmailPreferencesUpdated"] != null)
{
    <div class="alert alert-success">Your email alert preferences have been updated.</div>
}
@if (TempData["DepartmentAssignmentsUpdated"] != null)
{
    <div class="alert alert-success">Your department assignments have been updated.</div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header fw-bold">Account Information</div>
            <div class="card-body">
                <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="text-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.Profile.ProfilePhotoPath))
                        {
                            <img src="@Model.Profile.ProfilePhotoPath" alt="Profile photo" class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover;" />
                        }
                        else
                        {
                            var initials = string.Empty;
                            if (!string.IsNullOrWhiteSpace(Model.Profile.FirstName))
                            {
                                initials += Model.Profile.FirstName![0].ToString().ToUpperInvariant();
                            }
                            if (!string.IsNullOrWhiteSpace(Model.Profile.LastName))
                            {
                                initials += Model.Profile.LastName![0].ToString().ToUpperInvariant();
                            }
                            if (string.IsNullOrWhiteSpace(initials))
                            {
                                initials = "U";
                            }

                            <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
                                <span class="text-white fw-semibold fs-4">@initials</span>
                            </div>
                        }
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.ProfilePhoto" class="form-label"></label>
                        <input asp-for="Profile.ProfilePhoto" class="form-control" type="file" accept="image/*" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.FirstName" class="form-label"></label>
                        <input asp-for="Profile.FirstName" class="form-control" />
                        <span asp-validation-for="Profile.FirstName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.LastName" class="form-label"></label>
                        <input asp-for="Profile.LastName" class="form-control" />
                        <span asp-validation-for="Profile.LastName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.PhoneNumber" class="form-label"></label>
                        <input asp-for="Profile.PhoneNumber" class="form-control" />
                        <span asp-validation-for="Profile.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.Email" class="form-label"></label>
                        <input asp-for="Profile.Email" class="form-control" />
                        <span asp-validation-for="Profile.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.DefaultPropertyId" class="form-label"></label>
                        @if (Model.PropertyOptions?.Any() == true)
                        {
                            <select asp-for="Profile.DefaultPropertyId" asp-items="Model.PropertyOptions" class="form-select">
                                <option value="">Select a default property</option>
                            </select>
                        }
                        else
                        {
                            <input class="form-control" value="No properties available" disabled />
                        }
                        <span asp-validation-for="Profile.DefaultPropertyId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.TimeZoneId" class="form-label"></label>
                        <select asp-for="Profile.TimeZoneId" asp-items="Model.TimeZoneOptions" class="form-select">
                            <option value="">Select a time zone</option>
                        </select>
                        <span asp-validation-for="Profile.TimeZoneId" class="text-danger"></span>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-header fw-bold d-flex justify-content-between align-items-center">
                <span>Department Assignments</span>
                <span class="text-muted small">Control work order alerts &amp; to-do items</span>
            </div>
            <div class="card-body">
                <form asp-action="UpdateDepartments" method="post">
                    @Html.AntiForgeryToken()
                    @{
                        var departmentOptions = Model.DepartmentAssignments?.Options ?? new List<hOps.web.ViewModels.DepartmentAssignmentOption>();
                        var groupedOptions = departmentOptions
                            .Select((option, index) => new { option, index })
                            .GroupBy(x => string.IsNullOrWhiteSpace(x.option.PropertyLabel) ? "General" : x.option.PropertyLabel)
                            .OrderBy(g => g.Key);
                    }
                    @if (departmentOptions.Any())
                    {
                        <p class="text-muted small">
                            Select every department you belong to. Work orders for these departments will appear in your to-do list and trigger alerts.
                        </p>
                        @foreach (var group in groupedOptions)
                        {
                            <div class="mb-3">
                                <div class="fw-semibold text-muted">@group.Key</div>
                                <div class="d-flex flex-column gap-1">
                                    @foreach (var item in group)
                                    {
                                        var option = item.option;
                                        var checkboxId = $"dept_assign_{option.Id}";
                                        var fieldPrefix = $"DepartmentAssignments.Options[{item.index}]";
                                        <div class="form-check">
                                            <input type="hidden" name="@($"{fieldPrefix}.Id")" value="@option.Id" />
                                            <input type="hidden" name="@($"{fieldPrefix}.Name")" value="@option.Name" />
                                            <input type="hidden" name="@($"{fieldPrefix}.PropertyLabel")" value="@option.PropertyLabel" />
                                            <input type="hidden" name="@($"{fieldPrefix}.Selected")" value="false" />
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="@($"{fieldPrefix}.Selected")"
                                                   value="true"
                                                   id="@checkboxId"
                                                   @(option.Selected ? "checked" : null) />
                                            <label class="form-check-label" for="@checkboxId">@option.Name</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No departments are available for your properties.</p>
                    }
                    <div class="text-end">
                        <button type="submit" class="btn btn-outline-primary">Save Departments</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-header fw-bold">Email Alerts</div>
            <div class="card-body">
                <form asp-action="UpdateEmailPreferences" method="post">
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="EmailPreferences.EmailOnMessage" />
                        <label class="form-check-label" asp-for="EmailPreferences.EmailOnMessage"></label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="EmailPreferences.EmailOnMention" />
                        <label class="form-check-label" asp-for="EmailPreferences.EmailOnMention"></label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="EmailPreferences.EmailOnLogEntry" />
                        <label class="form-check-label" asp-for="EmailPreferences.EmailOnLogEntry"></label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="EmailPreferences.EmailOnWorkOrderDepartment" />
                        <label class="form-check-label" asp-for="EmailPreferences.EmailOnWorkOrderDepartment"></label>
                    </div>
                    @if (Model.EmailPreferences.PropertyOptions?.Any() == true)
                    {
                        for (var i = 0; i < Model.EmailPreferences.PropertyOptions.Count; i++)
                        {
                            var propertyOption = Model.EmailPreferences.PropertyOptions[i];
                            var logCheckboxId = $"prop_{propertyOption.Id}_log";
                            var summaryCheckboxId = $"prop_{propertyOption.Id}_daily";
                            var workOrderCheckboxId = $"prop_{propertyOption.Id}_workorders";
                            <div class="border rounded p-3 mb-4">
                                <input type="hidden" asp-for="EmailPreferences.PropertyOptions[i].Id" />
                                <input type="hidden" asp-for="EmailPreferences.PropertyOptions[i].Name" />
                                <h5 class="mb-3">@propertyOption.Name</h5>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" asp-for="EmailPreferences.PropertyOptions[i].IncludeInLogAlerts" id="@logCheckboxId" />
                                    <label class="form-check-label" for="@logCheckboxId">Email me when new log entries are posted for this property</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" asp-for="EmailPreferences.PropertyOptions[i].IncludeInDailySummary" id="@summaryCheckboxId" />
                                    <label class="form-check-label" for="@summaryCheckboxId">Include this property in my daily summary email</label>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" asp-for="EmailPreferences.PropertyOptions[i].IncludeInWorkOrderAlerts" id="@workOrderCheckboxId" />
                                    <label class="form-check-label" for="@workOrderCheckboxId">Send work order alerts for this property</label>
                                </div>

                                @if (propertyOption.Departments?.Any() == true)
                                {
                                    <div class="mb-2 fw-semibold">Departments for work order alerts</div>
                                    <div class="form-text mb-2">Select departments within this property to watch for new work orders.</div>
                                    <div class="d-flex flex-column gap-1">
                                        @for (var j = 0; j < propertyOption.Departments.Count; j++)
                                        {
                                            var deptOption = propertyOption.Departments[j];
                                            var deptCheckboxId = $"prop_{propertyOption.Id}_dept_{deptOption.Id}";
                                            <div class="form-check">
                                                <input type="hidden" asp-for="EmailPreferences.PropertyOptions[i].Departments[j].Id" />
                                                <input type="hidden" asp-for="EmailPreferences.PropertyOptions[i].Departments[j].Name" />
                                                <input class="form-check-input"
                                                       asp-for="EmailPreferences.PropertyOptions[i].Departments[j].Selected"
                                                       id="@deptCheckboxId" />
                                                <label class="form-check-label" for="@deptCheckboxId">@deptOption.Name</label>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">No departments are available for this property.</p>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small mb-3">You do not have access to any properties.</p>
                    }
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="EmailPreferences.EmailDailySummary" />
                        <label class="form-check-label" asp-for="EmailPreferences.EmailDailySummary"></label>
                        <div class="form-text">Daily summary emails include new or ongoing logs and bulletin posts.</div>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-outline-primary">Save Email Preferences</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header fw-bold">Change Password</div>
            <div class="card-body">
                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="ChangePassword.CurrentPassword" class="form-label"></label>
                        <input asp-for="ChangePassword.CurrentPassword" class="form-control" />
                        <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ChangePassword.NewPassword" class="form-label"></label>
                        <input asp-for="ChangePassword.NewPassword" class="form-control" />
                        <span asp-validation-for="ChangePassword.NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ChangePassword.ConfirmPassword" class="form-label"></label>
                        <input asp-for="ChangePassword.ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ChangePassword.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-outline-primary">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
