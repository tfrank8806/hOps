@using System.Text.Json

@{
    ViewData["Title"] = "Logs";
    ViewData["MainContainerClass"] = "logs-page-container";
    var currentUserInfo = new
    {
        id = ViewBag.CurrentUserId as string ?? string.Empty,
        name = ViewBag.CurrentUserName as string ?? "Unknown user"
    };
}

<div class="logs-page flex-grow-1 d-flex flex-column">
    <div id="logsLayout" class="logs-layout flex-grow-1 d-flex flex-column flex-lg-row gap-3">
        <aside class="logs-sidebar" id="logsSidebar">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="h5 mb-0">Logs</h2>
                        <button type="button" class="btn-close d-lg-none" id="closeLogsSidebarBtn" aria-label="Close logs sidebar"></button>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button class="btn btn-outline-primary btn-sm" type="button" id="importLogBtn">
                            Import Log
                        </button>
                        <input type="file" class="d-none" id="importLogInput" accept=".xls,.xlsx,.csv" />
                        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#createLogFormSection" aria-expanded="false" aria-controls="createLogFormSection">
                            Create New Log
                        </button>
                    </div>
                </div>
                <div class="card-body p-0 d-flex flex-column">
                    <div class="collapse border-bottom" id="createLogFormSection">
                        <form id="createLogForm" class="p-3">
                            <div class="mb-3">
                                <label for="logNameInput" class="form-label">Log Name</label>
                                <input type="text" class="form-control" id="logNameInput" name="logName" placeholder="e.g. Housekeeping" required maxlength="100">
                                <div class="form-text">A clear name makes it easier to find your log later.</div>
                                <div class="invalid-feedback">Please provide a name for the log.</div>
                            </div>
                            <div class="d-flex justify-content-end gap-2">
                                <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#createLogFormSection" aria-expanded="true" aria-controls="createLogFormSection">Cancel</button>
                                <button class="btn btn-primary btn-sm" type="submit">Create Log</button>
                            </div>
                        </form>
                    </div>
                    <div id="logList" class="list-group list-group-flush flex-grow-1 overflow-auto">
                        <div class="list-group-item text-muted" id="logEmptyState">
                            No logs yet. Create one to get started.
                        </div>
                    </div>
                </div>
            </div>
        </aside>
        <div class="logs-sidebar-overlay" id="logsSidebarOverlay" aria-hidden="true"></div>
        <div class="logs-editor flex-grow-1 d-flex flex-column">
            <div class="card shadow-sm flex-fill d-flex flex-column">
                <div class="card-header logs-editor-header d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <button class="btn btn-outline-secondary btn-sm logs-sidebar-toggle" type="button" id="toggleSidebarBtn" aria-controls="logsSidebar" aria-expanded="true" data-open-label="Show Logs" data-close-label="Hide Logs">
                            <span class="sidebar-toggle-icon" aria-hidden="true">&#9776;</span>
                            <span data-sidebar-toggle-label>Hide Logs</span>
                        </button>
                        <div>
                            <h2 class="h5 mb-0" id="logTitle">Select a log</h2>
                            <small class="text-muted" id="logSubtitle">Choose or create a log to start editing.</small>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 justify-content-start justify-content-lg-end logs-editor-actions">
                        <div class="btn-group" role="group" aria-label="Row actions">
                            <button class="btn btn-outline-secondary btn-sm" id="addRowBtn" type="button" disabled>Add Row</button>
                            <button class="btn btn-outline-secondary btn-sm" id="insertRowBtn" type="button" disabled>Insert Row</button>
                            <button class="btn btn-outline-secondary btn-sm" id="deleteRowBtn" type="button" disabled>Delete Row</button>
                        </div>
                        <div class="btn-group" role="group" aria-label="Column actions">
                            <button class="btn btn-outline-secondary btn-sm" id="addColumnBtn" type="button" disabled>Add Column</button>
                            <button class="btn btn-outline-secondary btn-sm" id="deleteColumnBtn" type="button" disabled>Delete Column</button>
                        </div>
                        <div class="btn-group" role="group" aria-label="Log actions">
                            <button class="btn btn-outline-secondary btn-sm" id="clearLogBtn" type="button" disabled>Clear</button>
                            <button class="btn btn-outline-secondary btn-sm" id="undoBtn" type="button" disabled>Undo</button>
                        </div>
                        <div class="btn-group" role="group">
                            <button class="btn btn-outline-secondary btn-sm" id="zoomOutBtn" type="button" disabled title="Zoom out">
                                <span aria-hidden="true">&minus;</span>
                                <span class="visually-hidden">Zoom out</span>
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" id="zoomInBtn" type="button" disabled title="Zoom in">
                                <span aria-hidden="true">+</span>
                                <span class="visually-hidden">Zoom in</span>
                            </button>
                        </div>
                        <button class="btn btn-outline-success btn-sm" id="exportExcelBtn" type="button" disabled>Export Excel</button>
                        <button class="btn btn-outline-primary btn-sm" id="viewAuditLogBtn" type="button" disabled>View History</button>
                        <div class="btn-group" role="group">
                            <button class="btn btn-outline-secondary btn-sm" id="renameLogBtn" type="button" disabled>Rename</button>
                            <button class="btn btn-outline-secondary btn-sm" id="duplicateLogBtn" type="button" disabled>Duplicate</button>
                            <button class="btn btn-outline-danger btn-sm" id="deleteLogBtn" type="button" disabled>Delete</button>
                        </div>
                    </div>
                </div>
                <div class="card-body d-flex flex-column">
                    <div id="spreadsheetContainer" class="spreadsheet-container">
                        <div class="text-center text-muted" id="spreadsheetPlaceholder">
                            <p class="mb-1 fw-semibold">No log selected</p>
                            <p class="mb-0">Pick a log from the list or create a new one to start tracking.</p>
                        </div>
                        <div class="ag-theme-quartz spreadsheet-grid d-none" id="logsGrid" role="grid" aria-label="Custom log grid"></div>
                    </div>
                    <div class="log-tabs-bar mt-3 pt-2 border-top" id="logTabsBar" aria-label="Open logs tabs">
                        <div class="log-tabs-scroll flex-grow-1" id="logTabsScroll">
                            <div class="log-tabs" id="logTabs" role="tablist" aria-label="Available logs"></div>
                            <div class="log-tabs-empty text-muted small d-none" id="logTabsEmptyState">No tabs yet. Select a log or use + to create one.</div>
                        </div>
                        <button class="btn btn-outline-secondary btn-sm log-tabs-add" type="button" id="addTabBtn">
                            <span aria-hidden="true">+</span>
                            <span class="visually-hidden">Add new log tab</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="auditLogModal" tabindex="-1" aria-labelledby="auditLogModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="auditLogModalLabel">Change History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="auditLogEmptyState" class="text-center text-muted py-4">
                    <p class="mb-0">No changes recorded yet.</p>
                </div>
                <div class="list-group" id="auditLogList"></div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@32.2.0/styles/ag-grid.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@32.2.0/styles/ag-theme-quartz.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/logs.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.hOps = window.hOps || {};
        window.hOps.currentUser = @Html.Raw(JsonSerializer.Serialize(currentUserInfo));
    </script>
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@32.2.0/dist/ag-grid-community.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js" crossorigin="anonymous"></script>
    <script src="~/js/logs.js" asp-append-version="true"></script>
}

