@model hOps.web.ViewModels.ReportRequestViewModel
@{
    ViewData["Title"] = "Reports";
    var showPropertyFilters = Model.SelectedReportSupportsPropertyFilter && Model.AvailableProperties.Any();
}

<h1 class="mb-4">Reports</h1>

<div class="row g-4 reports-layout">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <strong>Report Filters</strong>
            </div>
            <div class="card-body">
                <form method="post" class="vstack gap-3" id="reportFiltersForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                    <input asp-for="RefreshFiltersOnly" type="hidden" id="refreshFiltersOnly" value="false" />

                    <div>
                        <label asp-for="SelectedReportType" class="form-label">Report</label>
                        <select asp-for="SelectedReportType" class="form-select" id="reportSelect">
                            <option value="">Select a report...</option>
                            @foreach (var report in Model.AvailableReports)
                            {
                                var reportMetadata = Model.ReportMetadata.FirstOrDefault(m => m.Key == report.Value);
                                var description = reportMetadata?.Description ?? string.Empty;
                                if (report.Selected)
                                {
                                    <option value="@report.Value" data-description="@description" selected>@report.Text</option>
                                }
                                else
                                {
                                    <option value="@report.Value" data-description="@description">@report.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="SelectedReportType" class="text-danger"></span>
                        <div class="form-text @(string.IsNullOrWhiteSpace(Model.SelectedReportDescription) ? "d-none" : string.Empty)" id="reportDescription">
                            @Model.SelectedReportDescription
                        </div>
                    </div>

                    @if (Model.AvailableProperties.Any())
                    {
                        <div class="p-3 bg-light border rounded">
                            @if (showPropertyFilters)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" asp-for="IncludeAllProperties" type="checkbox" id="includeAllProperties" />
                                    <label class="form-check-label" for="includeAllProperties">Include all accessible properties</label>
                                </div>

                                <div id="propertySelection" class="property-selection @(Model.IncludeAllProperties ? "disabled" : string.Empty)">
                                    <label class="form-label">Properties</label>
                                    <div class="border rounded p-2 bg-white" style="max-height: 220px; overflow-y: auto;">
                                        @foreach (var property in Model.AvailableProperties)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input property-checkbox" type="checkbox" name="SelectedPropertyIds" value="@property.Value" id="property_@property.Value" @(property.Selected ? "checked" : string.Empty) />
                                                <label class="form-check-label" for="property_@property.Value">@property.Text</label>
                                            </div>
                                        }
                                    </div>
                                    <div class="form-text">Uncheck "Include all accessible properties" to pick specific locations.</div>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" asp-for="IncludeAllProperties" value="true" />
                                @foreach (var property in Model.AvailableProperties)
                                {
                                    <input type="hidden" name="SelectedPropertyIds" value="@property.Value" />
                                }
                                <div class="alert alert-info mb-0">This report automatically includes all properties you can access.</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            You currently do not have access to any properties. Property-level reports will be empty until access is granted.
                        </div>
                    }

                    @if (Model.SelectedReportSupportsDateRange)
                    {
                        <div class="row g-3">
                            <div class="col-12 col-lg-6">
                                <label asp-for="StartDate" class="form-label">Start date</label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-lg-6">
                                <label asp-for="EndDate" class="form-label">End date</label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
                    }

                    @if (Model.ShowWorkOrderFilters)
                    {
                        <div class="report-filter-group">
                            <h6 class="text-uppercase small fw-bold mb-3">Work Order Filters</h6>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Type Properties</label>
                                    <select asp-for="SelectedWorkOrderTypePropertyIds" asp-items="Model.WorkOrderTypePropertyOptions" class="form-select report-multiselect" multiple size="5"></select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Locations</label>
                                    <select asp-for="SelectedWorkOrderLocations" asp-items="Model.WorkOrderLocationOptions" class="form-select report-multiselect" multiple size="6"></select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Types</label>
                                    <select asp-for="SelectedWorkOrderTypeIds" asp-items="Model.WorkOrderTypeOptions" class="form-select report-multiselect" multiple size="5"></select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Departments</label>
                                    <select asp-for="SelectedWorkOrderDepartmentIds" asp-items="Model.WorkOrderDepartmentOptions" class="form-select report-multiselect" multiple size="5"></select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Statuses</label>
                                    <select asp-for="SelectedWorkOrderStatuses" asp-items="Model.WorkOrderStatusOptions" class="form-select report-multiselect" multiple size="5"></select>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ShowCalendarFilters)
                    {
                        <div class="report-filter-group">
                            <h6 class="text-uppercase small fw-bold mb-3">Calendar Filters</h6>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Categories</label>
                                    <select asp-for="SelectedCalendarCategoryIds" asp-items="Model.CalendarCategoryOptions" class="form-select report-multiselect" multiple size="6"></select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Recurring</label>
                                    <select asp-for="SelectedCalendarRecurrenceValues" asp-items="Model.CalendarRecurrenceOptions" class="form-select report-multiselect" multiple size="5"></select>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ShowPassOnLogFilters)
                    {
                        <div class="report-filter-group">
                            <h6 class="text-uppercase small fw-bold mb-3">Pass On Log Filters</h6>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Creators</label>
                                    <select asp-for="SelectedPassOnLogCreatorIds" asp-items="Model.PassOnLogCreatorOptions" class="form-select report-multiselect" multiple size="6"></select>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ShowPhonebookFilters)
                    {
                        <div class="report-filter-group">
                            <h6 class="text-uppercase small fw-bold mb-3">Phonebook Filters</h6>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Types</label>
                                    <select asp-for="SelectedPhonebookTypeIds" asp-items="Model.PhonebookTypeOptions" class="form-select report-multiselect" multiple size="6"></select>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">Run Report</button>
                        @if (Model.HasResults)
                        {
                            <button type="submit" class="btn btn-outline-secondary" formaction="@Url.Action("Export", "Reports")">
                                Export to Excel
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        @if (Model.Result is null)
        {
            <div class="alert alert-secondary h-100 d-flex align-items-center justify-content-center text-center">
                <div>
                    <strong>Choose a report</strong>
                    <p class="mb-0">Select a report and filters to explore your property data.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@Model.Result.Title</span>
                    <span class="badge bg-secondary">@Model.Result.RowCount @((Model.Result.RowCount == 1) ? "row" : "rows")</span>
                </div>
                <div class="card-body">
                    @if (Model.Result.Rows.Any())
                    {
                        var reportTableClasses = "table table-striped table-bordered align-middle report-table";
                        if (string.Equals(Model.SelectedReportType, "bookmarks", StringComparison.OrdinalIgnoreCase))
                        {
                            reportTableClasses += " report-table--bookmarks";
                        }
                        <div class="table-responsive report-table-wrapper">
                            <table class="@reportTableClasses">
                                <thead class="table-light">
                                    <tr>
                                        @foreach (var header in Model.Result.Headers)
                                        {
                                            <th scope="col">@header</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.Result.Rows)
                                    {
                                        <tr>
                                            @foreach (var cell in row)
                                            {
                                                <td>@cell</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">No data matched the selected filters.</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const includeAllCheckbox = document.getElementById('includeAllProperties');
            const propertySelection = document.getElementById('propertySelection');
            const reportSelect = document.getElementById('reportSelect');
            const reportDescription = document.getElementById('reportDescription');
            const reportForm = document.getElementById('reportFiltersForm');
            const refreshField = document.getElementById('refreshFiltersOnly');
            let isAutoSubmitting = false;

            function syncPropertyState() {
                if (!includeAllCheckbox || !propertySelection) {
                    return;
                }

                const isChecked = includeAllCheckbox.checked;
                propertySelection.classList.toggle('disabled', isChecked);

                if (isChecked) {
                    propertySelection.querySelectorAll('input.property-checkbox').forEach(cb => {
                        cb.checked = true;
                    });
                }
            }

            if (includeAllCheckbox) {
                includeAllCheckbox.addEventListener('change', syncPropertyState);
                syncPropertyState();
            }

            function updateReportDescription() {
                if (!reportSelect || !reportDescription) {
                    return;
                }
                const selectedOption = reportSelect.options[reportSelect.selectedIndex];
                const description = selectedOption?.dataset?.description || '';
                reportDescription.textContent = description;
                reportDescription.classList.toggle('d-none', !description.trim());
            }

            if (reportSelect && reportForm && refreshField) {
                reportSelect.addEventListener('change', () => {
                    updateReportDescription();
                    if (!reportSelect.value) {
                        return;
                    }
                    isAutoSubmitting = true;
                    refreshField.value = 'true';
                    if (typeof reportForm.requestSubmit === 'function') {
                        reportForm.requestSubmit();
                    } else {
                        reportForm.submit();
                    }
                });

                reportForm.addEventListener('submit', () => {
                    if (!isAutoSubmitting) {
                        refreshField.value = 'false';
                    }
                    isAutoSubmitting = false;
                });
            }

            updateReportDescription();
        })();
    </script>
}

<style>
    .property-selection.disabled {
        opacity: 0.6;
        pointer-events: none;
    }

    .reports-layout .col-12,
    .reports-layout .col-lg-4,
    .reports-layout .col-lg-8 {
        min-width: 0;
    }

    .report-filter-group {
        border: 1px solid rgba(15, 46, 97, 0.12);
        border-radius: 0.85rem;
        background-color: #f8fafc;
        padding: 1rem;
    }

    .report-multiselect {
        min-height: 120px;
    }

    .report-table td {
        word-break: break-word;
        white-space: normal;
    }

    .report-table--bookmarks td:nth-child(4),
    .report-table--bookmarks td:nth-child(7),
    .report-table--bookmarks td:nth-child(10) {
        max-width: 220px;
    }

    .report-table-wrapper {
        overflow-x: auto;
    }
</style>
