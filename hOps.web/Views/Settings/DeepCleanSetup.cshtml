
@model hOps.web.ViewModels.DeepCleans.DeepCleanSetupViewModel
@using System.Globalization
@{
    ViewData["Title"] = Html.Localize("Settings.DeepClean.Title", "Deep Clean Setup").ToString();
    var message = TempData["DeepCleanSetupMessage"] as string;
    var error = TempData["DeepCleanSetupError"] as string;
    var properties = Model.AccessibleProperties ?? new List<hOps.web.Models.Property>();
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-0">@Html.Localize("Settings.DeepClean.Heading", "Deep Clean Checklist Setup")</h2>
        <p class="text-muted mb-0 small">@Html.Localize("Settings.DeepClean.Subheading", "Configure the property checklist, drag to reorder, or upload/download CSV templates.")</p>
    </div>
    <div>
        <a asp-controller="DeepCleans" asp-action="Index" class="btn btn-outline-secondary btn-sm">@Html.Localize("Settings.DeepClean.OpenPage", "Open Deep Cleans Page")</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success">@Html.Localize(message, message)</div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-warning">@Html.Localize(error, error)</div>
}

@if (properties.Count > 1)
{
    <div class="mb-3">
        <label for="dcPropertySelect" class="form-label">@Html.Localize("Settings.DeepClean.PropertyLabel", "Property")</label>
        <select id="dcPropertySelect" class="form-select" style="max-width:360px;">
            @foreach (var property in properties)
            {
                var propId = property.Id.ToString(CultureInfo.InvariantCulture);
                var propNameRaw = property.Name ?? string.Empty;
                var propNameTranslated = await Html.DisplayTranslatedTextAsync("Property", propId, "Name", propNameRaw);
                var propName = string.IsNullOrWhiteSpace(propNameTranslated) ? propNameRaw : propNameTranslated;
                var optionUrl = Url.Action("DeepCleanSetup", "Settings", new { propertyId = property.Id });
                if (property.Id == Model.PropertyId)
                {
                    <option selected value="@optionUrl">@string.Format(CultureInfo.CurrentCulture, Html.Localize("Settings.DeepClean.PropertyOption", "{0} ({1})").ToString(), propName, property.Code)</option>
                }
                else
                {
                    <option value="@optionUrl">@string.Format(CultureInfo.CurrentCulture, Html.Localize("Settings.DeepClean.PropertyOption", "{0} ({1})").ToString(), propName, property.Code)</option>
                }
            }
        </select>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h4 class="h5 mb-3">@Html.Localize("Settings.DeepClean.ImportHeading", "Import / Export")</h4>
        <form asp-action="ImportDeepCleanChecklist" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="propertyId" value="@Model.PropertyId" />
            <div class="col-md-6">
                <label for="deepCleanCsvFile" class="form-label">@Html.Localize("Settings.DeepClean.ImportLabel", "Import checklist via CSV")</label>
                <input type="file" id="deepCleanCsvFile" name="csvFile" accept=".csv" class="form-control" />
                <div class="form-text">@Html.Localize("Settings.DeepClean.ImportHelp", "File should include \"Task\" and \"Description\" columns.")</div>
            </div>
            <div class="col-md-6 d-flex flex-wrap align-items-center gap-2">
                <button type="submit" class="btn btn-primary">@Html.Localize("Settings.DeepClean.ImportButton", "Import CSV")</button>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2">
                <a asp-action="DownloadDeepCleanChecklist" asp-route-propertyId="@Model.PropertyId" class="btn btn-outline-primary btn-sm">@Html.Localize("Settings.DeepClean.DownloadCurrent", "Download Current Checklist")</a>
                <a asp-action="DownloadDeepCleanTemplate" class="btn btn-outline-secondary btn-sm">@Html.Localize("Settings.DeepClean.DownloadTemplate", "Download Template")</a>
            </div>
        </form>
    </div>
</div>

<form asp-action="SaveDeepCleanChecklist" method="post" id="deepCleanSetupForm" class="card mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
    <div class="card-body">
        <div class="row g-4 align-items-end">
            <div class="col-md-4">
                <label for="deepCleanFrequency" class="form-label">@Html.Localize("Settings.DeepClean.FrequencyLabel", "Deep Clean Frequency per year")</label>
                <input type="number"
                       class="form-control"
                       id="deepCleanFrequency"
                       name="frequencyPerYear"
                       value="@Model.FrequencyPerYear"
                       min="1"
                       max="52"
                       required />
                <div class="form-text">@Html.Localize("Settings.DeepClean.FrequencyHelp", "How many times per year each room should be deep cleaned.")</div>
            </div>
            <div class="col-md-8">
                <div class="alert alert-info mb-0 small">
                    @Html.Localize("Settings.DeepClean.SortHelp", "Drag rows to reorder tasks. Use the buttons below to add or remove items, then click <strong>Save</strong>.")
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center gap-2 mt-4 mb-2 flex-wrap">
            <button type="button" class="btn btn-secondary" data-dc-action="add-row" data-position="top">@Html.Localize("Settings.DeepClean.AddRowTop", "+ Add Row")</button>
            <div class="d-flex align-items-center gap-2">
                <button type="submit" class="btn btn-success">@Html.Localize("Save")</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle table-striped" id="deepCleanTasksTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px;"></th>
                        <th style="width:35%;">@Html.Localize("Settings.DeepClean.TaskHeader", "Task")</th>
                        <th>@Html.Localize("Settings.DeepClean.DescriptionHeader", "Description")</th>
                        <th class="text-end" style="width:110px;">@Html.Localize("Settings.DeepClean.ActionsHeader", "Action")</th>
                    </tr>
                </thead>
                <tbody id="deepCleanTasksBody"
                       data-empty-text="@Html.Localize("Settings.DeepClean.EmptyState", "No deep clean tasks yet. Add a row to get started.").ToString()">
                    @if (Model.Tasks.Any())
                    {
                        for (var i = 0; i < Model.Tasks.Count; i++)
                        {
                            var taskIdString = Model.Tasks[i].Id.ToString(CultureInfo.InvariantCulture);
                            var rawTask = Model.Tasks[i].Task ?? string.Empty;
                            var rawDescription = Model.Tasks[i].Description ?? string.Empty;
                            var taskTranslated = await Html.DisplayTranslatedTextAsync("DeepCleanTask", taskIdString, "Task", rawTask);
                            var descriptionTranslated = await Html.DisplayTranslatedTextAsync("DeepCleanTask", taskIdString, "Description", rawDescription);
                            <tr draggable="true" class="deep-clean-row">
                                <td class="text-muted text-center cursor-move">
                                    <span class="deep-clean-handle" title="@Html.Localize("Settings.DeepClean.DragHandleTooltip", "Drag to reorder")">&#x2630;</span>
                                </td>
                                <td>
                                    <input type="hidden" name="tasks[@i].Id" value="@Model.Tasks[i].Id" />
                                    <input type="hidden" name="tasks[@i].SortOrder" value="@Model.Tasks[i].SortOrder" />
                                    <input type="text" class="form-control" name="tasks[@i].Task" value="@(string.IsNullOrWhiteSpace(taskTranslated) ? rawTask : taskTranslated)" placeholder="@Html.Localize("Settings.DeepClean.TaskPlaceholder", "Task name")" required />
                                </td>
                                <td>
                                    <textarea class="form-control" name="tasks[@i].Description" rows="2" placeholder="@Html.Localize("Settings.DeepClean.DescriptionPlaceholder", "Describe the task")">@(string.IsNullOrWhiteSpace(descriptionTranslated) ? rawDescription : descriptionTranslated)</textarea>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-dc-action="delete-row">@Html.Localize("Settings.DeepClean.DeleteRow", "Delete")</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr data-dc-empty-state="true">
                            <td colspan="4" class="text-muted text-center py-4">
                                @Html.Localize("Settings.DeepClean.EmptyState", "No deep clean tasks yet. Add a row to get started.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-between align-items-center gap-2 mt-3 flex-wrap">
            <button type="button" class="btn btn-secondary" data-dc-action="add-row" data-position="bottom">@Html.Localize("Settings.DeepClean.AddRowBottom", "+ Add Row")</button>
            <div class="d-flex align-items-center gap-2">
                <button type="submit" class="btn btn-success">@Html.Localize("Save")</button>
            </div>
        </div>
    </div>
</form>

<template id="deepCleanRowTemplate">
    <tr draggable="true" class="deep-clean-row">
        <td class="text-muted text-center cursor-move">
            <span class="deep-clean-handle" title="@Html.Localize("Settings.DeepClean.DragHandleTooltip", "Drag to reorder")">&#x2630;</span>
        </td>
        <td>
            <input type="hidden" name="tasks[#].Id" value="0" />
            <input type="hidden" name="tasks[#].SortOrder" value="0" />
            <input type="text" class="form-control" name="tasks[#].Task" placeholder="@Html.Localize("Settings.DeepClean.TaskPlaceholder", "Task name")" required />
        </td>
        <td>
            <textarea class="form-control" name="tasks[#].Description" rows="2" placeholder="@Html.Localize("Settings.DeepClean.DescriptionPlaceholder", "Describe the task")"></textarea>
        </td>
        <td class="text-end">
            <button type="button" class="btn btn-outline-danger btn-sm" data-dc-action="delete-row">@Html.Localize("Settings.DeepClean.DeleteRow", "Delete")</button>
        </td>
    </tr>
</template>

@section Scripts {
    <script>
        (function () {
            const propertySelect = document.getElementById('dcPropertySelect');
            if (propertySelect) {
                propertySelect.addEventListener('change', (event) => {
                    const value = event.target.value;
                    if (value) {
                        window.location.href = value;
                    }
                });
            }

            const tableBody = document.getElementById('deepCleanTasksBody');
            const rowTemplate = document.getElementById('deepCleanRowTemplate');

            function getRows() {
                return Array.from(tableBody?.querySelectorAll('.deep-clean-row') ?? []);
            }

            function removeEmptyStateRow() {
                const emptyRow = tableBody?.querySelector('[data-dc-empty-state="true"]');
                if (emptyRow) {
                    emptyRow.remove();
                }
            }

            function ensureEmptyStateRow() {
                if (!tableBody) {
                    return;
                }
                if (getRows().length === 0) {
                    const emptyRow = document.createElement('tr');
                    emptyRow.setAttribute('data-dc-empty-state', 'true');
                    const cell = document.createElement('td');
                    cell.colSpan = 4;
                    cell.className = 'text-muted text-center py-4';
                    cell.textContent = tableBody.dataset.emptyText ?? '';
                    emptyRow.appendChild(cell);
                    tableBody.appendChild(emptyRow);
                }
            }

            function addRow(position) {
                if (!tableBody || !rowTemplate) {
                    return;
                }

                removeEmptyStateRow();

                const fragment = rowTemplate.content.cloneNode(true);
                const inputs = fragment.querySelectorAll('input, textarea');
                const nextIndex = getRows().length;
                inputs.forEach(el => {
                    if (el.name?.includes('tasks[#]')) {
                        el.name = el.name.replace('tasks[#]', `tasks[${nextIndex}]`);
                    }
                });

                if (position === 'top') {
                    tableBody.prepend(fragment);
                } else {
                    tableBody.appendChild(fragment);
                }
            }

            function getDragRows() {
                return getRows();
            }

            function setSortOrderValues() {
                getRows().forEach((row, index) => {
                    const sortOrderInput = row.querySelector('input[name$=".SortOrder"]');
                    if (sortOrderInput) {
                        sortOrderInput.value = (index + 1).toString();
                    }
                });
            }

            function enableDragAndDrop() {
                const rows = getDragRows();
                rows.forEach(row => {
                    row.addEventListener('dragstart', () => {
                        row.classList.add('opacity-50');
                        row.dataset.dragging = 'true';
                    });

                    row.addEventListener('dragend', () => {
                        row.classList.remove('opacity-50');
                        delete row.dataset.dragging;
                        setSortOrderValues();
                    });
                });

                tableBody.addEventListener('dragover', (event) => {
                    event.preventDefault();
                    const draggingRow = tableBody.querySelector('[data-dragging="true"]');
                    if (!draggingRow) {
                        return;
                    }
                    const rows = getDragRows();
                    const afterElement = rows.find(row => {
                        const rect = row.getBoundingClientRect();
                        return event.clientY < rect.top + rect.height / 2;
                    });
                    if (afterElement) {
                        tableBody.insertBefore(draggingRow, afterElement);
                    } else {
                        tableBody.appendChild(draggingRow);
                    }
                });
            }

            function bindDeleteButtons() {
                if (!tableBody) {
                    return;
                }
                tableBody.addEventListener('click', (event) => {
                    const target = event.target;
                    if (target && target instanceof HTMLElement && target.dataset.dcAction === 'delete-row') {
                        event.preventDefault();
                        const row = target.closest('.deep-clean-row');
                        if (row) {
                            row.remove();
                            setSortOrderValues();
                            ensureEmptyStateRow();
                        }
                    }
                });
            }

            function bindAddRowButtons() {
                document.querySelectorAll('[data-dc-action="add-row"]').forEach(button => {
                    button.addEventListener('click', () => {
                        const position = button.getAttribute('data-position') || 'bottom';
                        addRow(position);
                        setSortOrderValues();
                        enableDragAndDrop();
                    });
                });
            }

            function bindFormSubmission() {
                const form = document.getElementById('deepCleanSetupForm');
                if (!form) {
                    return;
                }
                form.addEventListener('submit', () => {
                    setSortOrderValues();
                });
            }

            enableDragAndDrop();
            bindDeleteButtons();
            bindAddRowButtons();
            bindFormSubmission();
            ensureEmptyStateRow();
        })();
    </script>
}
