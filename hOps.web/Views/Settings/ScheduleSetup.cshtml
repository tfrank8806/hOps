@model hOps.web.ViewModels.Settings.ScheduleSetupViewModel
@{
    ViewData["Title"] = "Schedule Setup";
    var successMessage = ViewBag.ScheduleSetupMessage as string;
    var dayOptions = Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek>().ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">Schedule Setup</h2>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <a class="btn btn-outline-secondary" asp-controller="Schedules" asp-action="Index">
            &larr; Back to Schedule
        </a>
        @if (Model.PropertyOptions?.Any() == true)
        {
            <form method="get" class="d-flex gap-2">
                <select name="propertyId" class="form-select" style="min-width: 220px;">
                    @foreach (var option in Model.PropertyOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected)">@option.Text</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-secondary">Switch</button>
            </form>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="card">
    <div class="card-body">
        @if (Model.PropertyOptions == null || !Model.PropertyOptions.Any())
        {
            <p class="text-muted mb-0">You do not have access to any properties.</p>
        }
        else
        {
            <form asp-action="ScheduleSetup" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SelectedPropertyId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="StartDayOfWeek" class="form-label"></label>
                    <select asp-for="StartDayOfWeek" class="form-select" style="max-width: 320px;">
                        @foreach (var day in dayOptions)
                        {
                            <option value="@day" selected="@(day == Model.StartDayOfWeek)">@day</option>
                        }
                    </select>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <h5 class="mb-0">Default Shifts</h5>
                    <button class="btn btn-outline-primary btn-sm" type="button" id="addShiftTemplate">
                        + Add Shift
                    </button>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-striped align-middle" id="shiftTemplatesTable">
                        <thead>
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th>Template Name</th>
                                <th>Shift Name</th>
                                <th style="width: 150px;">Start</th>
                                <th style="width: 150px;">End</th>
                                <th style="width: 140px;">Color</th>
                                <th style="width: 140px;">Shift Alert</th>
                                <th style="width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody data-next-index="@(Model.ShiftTemplates?.Count ?? 0)">
                            @if (Model.ShiftTemplates?.Any() == true)
                            {
                                for (var i = 0; i < Model.ShiftTemplates.Count; i++)
                                {
                                    <tr class="shift-template-row">
                                        <td>
                                            <input type="hidden" asp-for="ShiftTemplates[i].Id" />
                                            <input type="hidden" asp-for="ShiftTemplates[i].IsDeleted" data-role="delete-flag" />
                                            <input type="number" asp-for="ShiftTemplates[i].SortOrder" class="form-control form-control-sm" data-role="sort-input" />
                                        </td>
                                        <td>
                                            <input asp-for="ShiftTemplates[i].Name" class="form-control form-control-sm" />
                                        </td>
                                        <td>
                                            <input asp-for="ShiftTemplates[i].ShiftName" class="form-control form-control-sm" />
                                        </td>
                                        <td>
                                            <input asp-for="ShiftTemplates[i].StartTime" class="form-control form-control-sm" type="time" />
                                        </td>
                                        <td>
                                            <input asp-for="ShiftTemplates[i].EndTime" class="form-control form-control-sm" type="time" />
                                        </td>
                                        <td>
                                            <input asp-for="ShiftTemplates[i].ColorHex" class="form-control form-control-sm form-control-color" type="color" value="@(Model.ShiftTemplates[i].ColorHex ?? "#3b82f6")" />
                                        </td>
                                        <td>
                                            <div class="form-check">
                                                <input type="hidden" name="@( $"ShiftTemplates[{i}].AlertIfMissing" )" value="false" />
                                                <input class="form-check-input" asp-for="ShiftTemplates[i].AlertIfMissing" value="true" />
                                                <label asp-for="ShiftTemplates[i].AlertIfMissing" class="form-check-label small text-muted">Alert if missing</label>
                                            </div>
                                        </td>
                                        <td class="text-nowrap">
                                            <div class="btn-group btn-group-sm mb-2" role="group">
                                                <button type="button" class="btn btn-outline-secondary" data-action="move-up" title="Move up">&uarr;</button>
                                                <button type="button" class="btn btn-outline-secondary" data-action="move-down" title="Move down">&darr;</button>
                                            </div>
                                            <div>
                                                <button type="button" class="btn btn-outline-danger btn-sm" data-action="delete" title="Delete shift">Delete</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="shift-template-row">
                                    <td>
                                        <input type="hidden" name="ShiftTemplates[0].Id" value="0" />
                                        <input type="hidden" name="ShiftTemplates[0].IsDeleted" value="false" data-role="delete-flag" />
                                        <input type="number" name="ShiftTemplates[0].SortOrder" value="0" class="form-control form-control-sm" data-role="sort-input" />
                                    </td>
                                    <td>
                                        <input name="ShiftTemplates[0].Name" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input name="ShiftTemplates[0].ShiftName" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input name="ShiftTemplates[0].StartTime" type="time" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input name="ShiftTemplates[0].EndTime" type="time" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input name="ShiftTemplates[0].ColorHex" type="color" value="#3b82f6" class="form-control form-control-sm form-control-color" />
                                    </td>
                                    <td>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="ShiftTemplates_0__AlertIfMissing" name="ShiftTemplates[0].AlertIfMissing" />
                                            <label class="form-check-label small text-muted" for="ShiftTemplates_0__AlertIfMissing">Alert if missing</label>
                                        </div>
                                    </td>
                                    <td class="text-nowrap">
                                        <div class="btn-group btn-group-sm mb-2" role="group">
                                            <button type="button" class="btn btn-outline-secondary" data-action="move-up" title="Move up">&uarr;</button>
                                            <button type="button" class="btn btn-outline-secondary" data-action="move-down" title="Move down">&darr;</button>
                                        </div>
                                        <div>
                                            <button type="button" class="btn btn-outline-danger btn-sm" data-action="delete" title="Delete shift">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <button type="submit" class="btn btn-primary">Save Settings</button>
            </form>

            <div class="mt-5">
                <div class="d-flex justify-content-between flex-wrap gap-2 mb-2 align-items-center">
                    <h5 class="mb-0">Manual Schedule Employees</h5>
                    <small class="text-muted">Remove non-user employees from the roster</small>
                </div>
                @if (Model.ManualEmployees?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th style="width: 240px;">Email</th>
                                    <th style="width: 160px;">Assignments</th>
                                    <th style="width: 120px;">Status</th>
                                    <th style="width: 80px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var employee in Model.ManualEmployees)
                                {
                                    <tr>
                                        <td class="fw-semibold">@employee.DisplayName</td>
                                        <td>@(string.IsNullOrWhiteSpace(employee.Email) ? "—" : employee.Email)</td>
                                        <td>
                                            @if (employee.AssignmentCount > 0)
                                            {
                                                <span class="badge bg-info text-dark">@employee.AssignmentCount shift(s)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No assigned shifts</span>
                                            }
                                        </td>
                                        <td>
                                            @if (employee.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="DeleteManualScheduleEmployee" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="manualEmployeeId" value="@employee.Id" />
                                                <input type="hidden" name="propertyId" value="@Model.SelectedPropertyId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Remove this employee from the schedule?');">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">You do not have any manual employees for this property.</p>
                }
            </div>
        }
    </div>
</div>

<template id="shift-row-template">
    <tr class="shift-template-row">
        <td>
            <input type="hidden" name="ShiftTemplates[{{index}}].Id" value="0" />
            <input type="hidden" name="ShiftTemplates[{{index}}].IsDeleted" value="false" data-role="delete-flag" />
            <input type="number" name="ShiftTemplates[{{index}}].SortOrder" value="{{index}}" class="form-control form-control-sm" data-role="sort-input" />
        </td>
        <td>
            <input name="ShiftTemplates[{{index}}].Name" class="form-control form-control-sm" />
        </td>
        <td>
            <input name="ShiftTemplates[{{index}}].ShiftName" class="form-control form-control-sm" />
        </td>
        <td>
            <input name="ShiftTemplates[{{index}}].StartTime" type="time" class="form-control form-control-sm" />
        </td>
        <td>
            <input name="ShiftTemplates[{{index}}].EndTime" type="time" class="form-control form-control-sm" />
        </td>
        <td>
            <input name="ShiftTemplates[{{index}}].ColorHex" type="color" value="#3b82f6" class="form-control form-control-sm form-control-color" />
        </td>
        <td>
            <div class="form-check">
                <input type="hidden" name="ShiftTemplates[{{index}}].AlertIfMissing" value="false" />
                <input class="form-check-input" type="checkbox" value="true" id="ShiftTemplates_{{index}}__AlertIfMissing" name="ShiftTemplates[{{index}}].AlertIfMissing" />
                <label class="form-check-label small text-muted" for="ShiftTemplates_{{index}}__AlertIfMissing">Alert if missing</label>
            </div>
        </td>
        <td class="text-nowrap">
            <div class="btn-group btn-group-sm mb-2" role="group">
                <button type="button" class="btn btn-outline-secondary" data-action="move-up" title="Move up">&uarr;</button>
                <button type="button" class="btn btn-outline-secondary" data-action="move-down" title="Move down">&darr;</button>
            </div>
            <div>
                <button type="button" class="btn btn-outline-danger btn-sm" data-action="delete" title="Delete shift">Delete</button>
            </div>
        </td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const addButton = document.getElementById('addShiftTemplate');
            const tableBody = document.querySelector('#shiftTemplatesTable tbody');
            const template = document.getElementById('shift-row-template');

            if (!addButton || !tableBody || !template) {
                return;
            }

            const getVisibleRows = () => Array.from(tableBody.querySelectorAll('tr')).filter(row => !row.classList.contains('d-none'));

            const updateSortInputs = () => {
                getVisibleRows().forEach((row, index) => {
                    const sortInput = row.querySelector('[data-role="sort-input"]');
                    if (sortInput) {
                        sortInput.value = index;
                    }
                });
            };

            const findPreviousVisible = (row) => {
                let prev = row.previousElementSibling;
                while (prev && prev.classList.contains('d-none')) {
                    prev = prev.previousElementSibling;
                }
                return prev;
            };

            const findNextVisible = (row) => {
                let next = row.nextElementSibling;
                while (next && next.classList.contains('d-none')) {
                    next = next.nextElementSibling;
                }
                return next;
            };

            const markRowDeleted = (row) => {
                const deleteFlag = row.querySelector('[data-role="delete-flag"]');
                if (deleteFlag) {
                    deleteFlag.value = 'true';
                }
                row.classList.add('d-none');
                updateSortInputs();
            };

            tableBody.addEventListener('click', (event) => {
                const button = event.target.closest('[data-action]');
                if (!button) {
                    return;
                }

                const action = button.getAttribute('data-action');
                const row = button.closest('tr');
                if (!row) {
                    return;
                }

                event.preventDefault();

                if (action === 'delete') {
                    if (confirm('Remove this shift template?')) {
                        markRowDeleted(row);
                    }
                    return;
                }

                if (row.classList.contains('d-none')) {
                    return;
                }

                if (action === 'move-up') {
                    const prev = findPreviousVisible(row);
                    if (prev) {
                        tableBody.insertBefore(row, prev);
                        updateSortInputs();
                    }
                } else if (action === 'move-down') {
                    const next = findNextVisible(row);
                    if (next) {
                        tableBody.insertBefore(next, row);
                        updateSortInputs();
                    }
                }
            });

            const getNextIndex = () => {
                const current = Number(tableBody.getAttribute('data-next-index')) || tableBody.querySelectorAll('tr').length;
                tableBody.setAttribute('data-next-index', (current + 1).toString());
                return current;
            };

            addButton.addEventListener('click', () => {
                const nextIndex = getNextIndex();
                const html = template.innerHTML.replace(/{{index}}/g, nextIndex);
                const wrapper = document.createElement('tbody');
                wrapper.innerHTML = html;
                const newRow = wrapper.firstElementChild;
                if (newRow) {
                    tableBody.appendChild(newRow);
                    updateSortInputs();
                }
            });

            updateSortInputs();
        })();
    </script>
}
