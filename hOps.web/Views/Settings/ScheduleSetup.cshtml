@using System.Collections.Generic
@using Microsoft.AspNetCore.Mvc.Rendering
@model hOps.web.ViewModels.Settings.ScheduleSetupViewModel
@{
    ViewData["Title"] = Html.Localize("Schedule Setup");
    var successMessage = ViewBag.ScheduleSetupMessage as string;
    var dayOptions = Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek>().ToList();
    var propertyOptions = Model.PropertyOptions ?? new List<SelectListItem>();
    var propertyDisplayMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    foreach (var option in propertyOptions)
    {
        var optionValue = option.Value ?? string.Empty;
        var optionText = option.Text ?? string.Empty;
        var displayText = await Html.DisplayTranslatedTextAsync("Property", optionValue, "Name", optionText);
        propertyDisplayMap[optionValue] = displayText;
    }

    var dayDisplayMap = new Dictionary<DayOfWeek, string>();
    foreach (var day in dayOptions)
    {
        dayDisplayMap[day] = Html.Localize(day.ToString());
    }

    var localizedSuccessMessage = string.IsNullOrWhiteSpace(successMessage)
        ? string.Empty
        : await Html.DisplayTranslatedTextAsync(
            "ScheduleSetupMessage",
            Model.SelectedPropertyId.ToString(),
            "Message",
            successMessage);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">@Html.Localize("Schedule Setup")</h2>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <a class="btn btn-outline-secondary" asp-controller="Schedules" asp-action="Index">
            &larr; @Html.Localize("Back to Schedule")
        </a>
        @if (propertyOptions.Any())
        {
            <form method="get" class="d-flex gap-2">
                <select name="propertyId" class="form-select" style="min-width: 220px;">
                    @foreach (var option in propertyOptions)
                    {
                        var optionValue = option.Value ?? string.Empty;
                        var optionDisplay = propertyDisplayMap.TryGetValue(optionValue, out var display)
                            ? display
                            : option.Text ?? string.Empty;
                        <option value="@option.Value" selected="@(option.Selected)">@optionDisplay</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-secondary">@Html.Localize("Switch")</button>
            </form>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(localizedSuccessMessage))
{
    <div class="alert alert-success">@localizedSuccessMessage</div>
}

<div class="card">
    <div class="card-body">
        @if (!propertyOptions.Any())
        {
            <p class="text-muted mb-0">@Html.Localize("You do not have access to any properties.")</p>
        }
        else
        {
            <form asp-action="ScheduleSetup" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SelectedPropertyId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="StartDayOfWeek" class="form-label">@Html.Localize("Week starts on")</label>
                    <select asp-for="StartDayOfWeek" class="form-select" style="max-width: 320px;">
                        @foreach (var day in dayOptions)
                        {
                            var dayLabel = dayDisplayMap.TryGetValue(day, out var label)
                                ? label
                                : Html.Localize(day.ToString());
                            <option value="@day" selected="@(day == Model.StartDayOfWeek)">@dayLabel</option>
                        }
                    </select>
                </div>
                <div class="d-flex justify-content-end mb-4">
                    <button class="btn btn-outline-primary btn-sm" type="button" data-action="add-shift">
                        + @Html.Localize("Add Shift")
                    </button>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <h5 class="mb-0">@Html.Localize("Default Shifts")</h5>
                    <button class="btn btn-outline-primary btn-sm" type="button" data-action="add-shift">
                        + @Html.Localize("Add Shift")
                    </button>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-striped align-middle" id="shiftTemplatesTable">
                        <thead>
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th>@Html.Localize("Template Name")</th>
                                <th>@Html.Localize("Shift Name")</th>
                                <th style="width: 150px;">@Html.Localize("Start")</th>
                                <th style="width: 150px;">@Html.Localize("End")</th>
                                <th style="width: 140px;">@Html.Localize("Color")</th>
                                <th style="width: 140px;">@Html.Localize("Shift Alert")</th>
                                <th style="width: 140px;">@Html.Localize("Actions")</th>
                            </tr>
                        </thead>
                        <tbody data-next-index="@(Model.ShiftTemplates?.Count ?? 0)">
                            @if (Model.ShiftTemplates?.Any() == true)
                            {
                                for (var i = 0; i < Model.ShiftTemplates.Count; i++)
                                {
                                    <tr class="shift-template-row">
                                        <td>
                                            <input type="hidden" asp-for="ShiftTemplates[i].Id" />
                                            <input type="hidden" asp-for="ShiftTemplates[i].IsDeleted" data-role="delete-flag" />
                                            <input type="number" asp-for="ShiftTemplates[i].SortOrder" class="form-control form-control-sm" data-role="sort-input" />
                                        </td>
                                        <td>
                                            <input asp-for="ShiftTemplates[i].Name" class="form-control form-control-sm" data-role="template-name" />
                                        </td>
                                        <td>
                                            <input asp-for="ShiftTemplates[i].ShiftName" class="form-control form-control-sm" />
                                        </td>
                                        <td>
                                            <input asp-for="ShiftTemplates[i].StartTime" class="form-control form-control-sm" type="time" />
                                        </td>
                                        <td>
                                            <input asp-for="ShiftTemplates[i].EndTime" class="form-control form-control-sm" type="time" />
                                        </td>
                                        <td>
                                            <input asp-for="ShiftTemplates[i].ColorHex" class="form-control form-control-sm form-control-color" type="color" value="@(Model.ShiftTemplates[i].ColorHex ?? "#3b82f6")" />
                                        </td>
                                        <td>
                                            @{
                                                var alertInputId = $"ShiftTemplates_{i}__AlertIfMissing";
                                                var isAlertChecked = Model.ShiftTemplates[i].AlertIfMissing;
                                            }
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="@alertInputId"
                                                       name="ShiftTemplates[@i].AlertIfMissing"
                                                       value="true"
                                                       @(isAlertChecked ? "checked" : null)
                                                       data-role="alert-checkbox" />
                                                <input type="hidden"
                                                       name="ShiftTemplates[@i].AlertIfMissing"
                                                       value="@(isAlertChecked ? "true" : "false")"
                                                       data-role="alert-hidden" />
                                                <label class="form-check-label small text-muted" for="@alertInputId">@Html.Localize("Alert if missing")</label>
                                            </div>
                                        </td>
                                        <td class="text-nowrap">
                                            <div class="btn-group btn-group-sm mb-2" role="group">
                                                <button type="button" class="btn btn-outline-secondary" data-action="move-up" title='@Html.Localize("Move Up")' aria-label='@Html.Localize("Move Up")'>&uarr;</button>
                                                <button type="button" class="btn btn-outline-secondary" data-action="move-down" title='@Html.Localize("Move Down")' aria-label='@Html.Localize("Move Down")'>&darr;</button>
                                            </div>
                                            <div>
                                                <button type="button" class="btn btn-outline-danger btn-sm" data-action="delete" title='@Html.Localize("Delete shift")'>@Html.Localize("Delete")</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="shift-template-row">
                                    <td>
                                        <input type="hidden" name="ShiftTemplates[0].Id" value="0" />
                                        <input type="hidden" name="ShiftTemplates[0].IsDeleted" value="false" data-role="delete-flag" />
                                        <input type="number" name="ShiftTemplates[0].SortOrder" value="0" class="form-control form-control-sm" data-role="sort-input" />
                                    </td>
                                    <td>
                                        <input name="ShiftTemplates[0].Name" class="form-control form-control-sm" data-role="template-name" />
                                    </td>
                                    <td>
                                        <input name="ShiftTemplates[0].ShiftName" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input name="ShiftTemplates[0].StartTime" type="time" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input name="ShiftTemplates[0].EndTime" type="time" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input name="ShiftTemplates[0].ColorHex" type="color" value="#3b82f6" class="form-control form-control-sm form-control-color" />
                                    </td>
                                    <td>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="ShiftTemplates_0__AlertIfMissing" name="ShiftTemplates[0].AlertIfMissing" value="true" data-role="alert-checkbox" />
                                            <input type="hidden" name="ShiftTemplates[0].AlertIfMissing" value="false" data-role="alert-hidden" />
                                            <label class="form-check-label small text-muted" for="ShiftTemplates_0__AlertIfMissing">@Html.Localize("Alert if missing")</label>
                                        </div>
                                    </td>
                                    <td class="text-nowrap">
                                        <div class="btn-group btn-group-sm mb-2" role="group">
                                            <button type="button" class="btn btn-outline-secondary" data-action="move-up" title='@Html.Localize("Move Up")' aria-label='@Html.Localize("Move Up")'>&uarr;</button>
                                            <button type="button" class="btn btn-outline-secondary" data-action="move-down" title='@Html.Localize("Move Down")' aria-label='@Html.Localize("Move Down")'>&darr;</button>
                                        </div>
                                        <div>
                                            <button type="button" class="btn btn-outline-danger btn-sm" data-action="delete" title='@Html.Localize("Delete shift")'>@Html.Localize("Delete")</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end mb-4">
                    <button class="btn btn-outline-primary btn-sm" type="button" data-action="add-shift">
                        + @Html.Localize("Add Shift")
                    </button>
                </div>

                <button type="submit" class="btn btn-primary">@Html.Localize("Save Settings")</button>
            </form>

            <div class="mt-5">
                <div class="d-flex justify-content-between flex-wrap gap-2 mb-2 align-items-center">
                    <h5 class="mb-0">@Html.Localize("Manual Schedule Employees")</h5>
                    <small class="text-muted">@Html.Localize("Remove non-user employees from the roster")</small>
                </div>
                @if (Model.ManualEmployees?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.Localize("Name")</th>
                                    <th style="width: 240px;">@Html.Localize("Email")</th>
                                    <th style="width: 160px;">@Html.Localize("Assignments")</th>
                                    <th style="width: 120px;">@Html.Localize("Status")</th>
                                    <th style="width: 80px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var employee in Model.ManualEmployees)
                                {
                                    <tr>
                                        <td class="fw-semibold">@employee.DisplayName</td>
                                        <td>
                                            @if (string.IsNullOrWhiteSpace(employee.Email))
                                            {
                                                @Html.Localize("Not provided")
                                            }
                                            else
                                            {
                                                @employee.Email
                                            }
                                        </td>
                                        <td>
                                            @if (employee.AssignmentCount > 0)
                                            {
                                                <span class="badge bg-info text-dark">@string.Format(Html.Localize("{0} shift(s)"), employee.AssignmentCount)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@Html.Localize("No assigned shifts")</span>
                                            }
                                        </td>
                                        <td>
                                            @if (employee.IsActive)
                                            {
                                                <span class="badge bg-success">@Html.Localize("Active")</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@Html.Localize("Inactive")</span>
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="DeleteManualScheduleEmployee" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="manualEmployeeId" value="@employee.Id" />
                                                <input type="hidden" name="propertyId" value="@Model.SelectedPropertyId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm(window.hopsTranslate('ScheduleSetupRemoveManualEmployee', 'Remove this employee from the schedule?'));">
                                                    @Html.Localize("Delete")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">@Html.Localize("You do not have any manual employees for this property.")</p>
                }
            </div>
        }
    </div>
</div>

<template id="shift-row-template">
    <tr class="shift-template-row">
        <td>
            <input type="hidden" name="ShiftTemplates[{{index}}].Id" value="0" />
            <input type="hidden" name="ShiftTemplates[{{index}}].IsDeleted" value="false" data-role="delete-flag" />
            <input type="number" name="ShiftTemplates[{{index}}].SortOrder" value="{{index}}" class="form-control form-control-sm" data-role="sort-input" />
        </td>
        <td>
            <input name="ShiftTemplates[{{index}}].Name" class="form-control form-control-sm" data-role="template-name" />
        </td>
        <td>
            <input name="ShiftTemplates[{{index}}].ShiftName" class="form-control form-control-sm" />
        </td>
        <td>
            <input name="ShiftTemplates[{{index}}].StartTime" type="time" class="form-control form-control-sm" />
        </td>
        <td>
            <input name="ShiftTemplates[{{index}}].EndTime" type="time" class="form-control form-control-sm" />
        </td>
        <td>
            <input name="ShiftTemplates[{{index}}].ColorHex" type="color" value="#3b82f6" class="form-control form-control-sm form-control-color" />
        </td>
        <td>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="true" id="ShiftTemplates_{{index}}__AlertIfMissing" name="ShiftTemplates[{{index}}].AlertIfMissing" data-role="alert-checkbox" />
                <input type="hidden" name="ShiftTemplates[{{index}}].AlertIfMissing" value="false" data-role="alert-hidden" />
                <label class="form-check-label small text-muted" for="ShiftTemplates_{{index}}__AlertIfMissing">@Html.Localize("Alert if missing")</label>
            </div>
        </td>
        <td class="text-nowrap">
            <div class="btn-group btn-group-sm mb-2" role="group">
                <button type="button" class="btn btn-outline-secondary" data-action="move-up" title='@Html.Localize("Move Up")' aria-label='@Html.Localize("Move Up")'>&uarr;</button>
                <button type="button" class="btn btn-outline-secondary" data-action="move-down" title='@Html.Localize("Move Down")' aria-label='@Html.Localize("Move Down")'>&darr;</button>
            </div>
            <div>
                <button type="button" class="btn btn-outline-danger btn-sm" data-action="delete" title='@Html.Localize("Delete shift")'>@Html.Localize("Delete")</button>
            </div>
        </td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const translate = typeof window.hopsTranslate === "function"
                ? window.hopsTranslate
                : (key, fallback) => (typeof fallback === "string" && fallback.length > 0 ? fallback : key);
            const removeShiftTemplateMessage = translate("ScheduleSetupRemoveShiftTemplate", "Remove this shift template?");

            const addButtons = document.querySelectorAll('[data-action="add-shift"]');
            const tableBody = document.querySelector('#shiftTemplatesTable tbody');
            const template = document.getElementById('shift-row-template');

            if (!addButtons.length || !tableBody || !template) {
                return;
            }

            const getVisibleRows = () =>
                Array.from(tableBody.querySelectorAll('tr')).filter(row => !row.classList.contains('d-none'));

            const getSortInput = (row) => row.querySelector('[data-role="sort-input"]');

            const parseSortValue = (input) => {
                if (!input) {
                    return null;
                }
                const value = Number(input.value);
                return Number.isFinite(value) ? value : null;
            };

            const getNextSortValue = () => {
                const values = getVisibleRows()
                    .map(row => parseSortValue(getSortInput(row)))
                    .filter(value => value !== null);
                const max = values.length ? Math.max(...values) : -1;
                return max + 1;
            };

            const swapSortValues = (rowA, rowB) => {
                const inputA = getSortInput(rowA);
                const inputB = getSortInput(rowB);
                if (!inputA || !inputB) {
                    return;
                }

                const temp = inputA.value;
                inputA.value = inputB.value;
                inputB.value = temp;
            };

            const findPreviousVisible = (row) => {
                let prev = row.previousElementSibling;
                while (prev && prev.classList.contains('d-none')) {
                    prev = prev.previousElementSibling;
                }
                return prev;
            };

            const findNextVisible = (row) => {
                let next = row.nextElementSibling;
                while (next && next.classList.contains('d-none')) {
                    next = next.nextElementSibling;
                }
                return next;
            };

            const markRowDeleted = (row) => {
                const deleteFlag = row.querySelector('[data-role="delete-flag"]');
                if (deleteFlag) {
                    deleteFlag.value = 'true';
                }
                row.classList.add('d-none');
            };

            const getNextIndex = () => {
                const current = Number(tableBody.getAttribute('data-next-index')) || tableBody.querySelectorAll('tr').length;
                tableBody.setAttribute('data-next-index', (current + 1).toString());
                return current;
            };

            const focusTemplateName = (row) => {
                const templateInput = row.querySelector('[data-role="template-name"]');
                if (templateInput) {
                    templateInput.focus();
                }
            };

            const syncAlertHidden = (checkbox) => {
                const row = checkbox.closest('tr');
                if (!row) {
                    return;
                }
                const hidden = row.querySelector('[data-role="alert-hidden"]');
                if (hidden) {
                    hidden.value = checkbox.checked ? 'true' : 'false';
                }
            };

            tableBody.addEventListener('change', (event) => {
                const checkbox = event.target.closest('[data-role="alert-checkbox"]');
                if (checkbox) {
                    syncAlertHidden(checkbox);
                }
            });

            tableBody.addEventListener('click', (event) => {
                const button = event.target.closest('[data-action]');
                if (!button) {
                    return;
                }

                const action = button.getAttribute('data-action');
                const row = button.closest('tr');
                if (!row) {
                    return;
                }

                event.preventDefault();

                if (action === 'delete') {
                    if (confirm(removeShiftTemplateMessage)) {
                        markRowDeleted(row);
                    }
                    return;
                }

                if (row.classList.contains('d-none')) {
                    return;
                }

                if (action === 'move-up') {
                    const prev = findPreviousVisible(row);
                    if (prev) {
                        tableBody.insertBefore(row, prev);
                        swapSortValues(row, prev);
                    }
                } else if (action === 'move-down') {
                    const next = findNextVisible(row);
                    if (next) {
                        tableBody.insertBefore(next, row);
                        swapSortValues(row, next);
                    }
                }
            });

            const addShiftRow = () => {
                const nextIndex = getNextIndex();
                const html = template.innerHTML.replace(/{{index}}/g, nextIndex);
                const wrapper = document.createElement('tbody');
                wrapper.innerHTML = html;
                const newRow = wrapper.firstElementChild;
                if (newRow) {
                    tableBody.appendChild(newRow);
                    const sortInput = getSortInput(newRow);
                    if (sortInput) {
                        sortInput.value = getNextSortValue();
                    }
                    const checkbox = newRow.querySelector('[data-role="alert-checkbox"]');
                    if (checkbox) {
                        checkbox.checked = false;
                        syncAlertHidden(checkbox);
                    }
                    focusTemplateName(newRow);
                }
            };

            addButtons.forEach(button => button.addEventListener('click', addShiftRow));

            tableBody.querySelectorAll('[data-role="alert-checkbox"]').forEach(syncAlertHidden);
        })();
    </script>
}
