@model hOps.web.Models.Department
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Edit Department";
    ViewData["FormAction"] = "EditDepartment";
    var propertyOptions = ViewBag.PropertyOptions as List<SelectListItem> ?? new List<SelectListItem>();
    bool onlyGlobal = ViewBag.OnlyGlobal as bool? ?? false;
    string returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Departments") ?? string.Empty;
}

<h2>@ViewData["Title"]</h2>

<form asp-action="@ViewData["FormAction"]" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="onlyGlobal" value="@(onlyGlobal.ToString().ToLowerInvariant())" />
    <input type="hidden" name="returnUrl" value="@returnUrl" />

    <div class="mb-3">
        <label class="form-label" for="department-property">Applies To</label>
        <select class="form-select" id="department-property" name="selectedPropertyId">
            @foreach (var option in propertyOptions)
            {
                <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
            }
        </select>
        <div class="form-text">Choose "Global" to share this department with every property.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Color" class="form-label"></label>
        <input asp-for="Color" type="color" class="form-control" />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Save</button>
</form>
