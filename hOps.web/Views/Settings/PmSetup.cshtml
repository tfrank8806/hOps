
@model hOps.web.ViewModels.PreventiveMaintenance.PmSetupViewModel
@using System.Globalization
@{
    ViewData["Title"] = Html.Localize("Settings.PmSetup.Title", "PM Setup").ToString();
    var message = TempData["PmSetupMessage"] as string;
    var error = TempData["PmSetupError"] as string;
    var properties = Model.AccessibleProperties ?? new List<hOps.web.Models.Property>();
    var propertyIdString = Model.PropertyId.ToString(CultureInfo.InvariantCulture);
    var propertyNameRaw = ViewBag.PropertyName as string ?? string.Empty;
    var propertyNameTranslated = await Html.DisplayTranslatedTextAsync("Property", propertyIdString, "Name", propertyNameRaw);
    var propertyName = string.IsNullOrWhiteSpace(propertyNameTranslated)
        ? (string.IsNullOrWhiteSpace(propertyNameRaw)
            ? Html.Localize("Settings.PmSetup.PropertyFallback", "Selected property").ToString()
            : propertyNameRaw)
        : propertyNameTranslated;
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-0">@Html.Localize("Settings.PmSetup.Heading", "Preventative Maintenance Setup")</h2>
        <p class="text-muted mb-0 small">@Html.Localize("Settings.PmSetup.Subheading", "Build the checklist that powers the PM workflow and recap reporting.")</p>
    </div>
    <div>
        <a asp-controller="PreventiveMaintenance" asp-action="Index" class="btn btn-outline-secondary btn-sm">@Html.Localize("Settings.PmSetup.OpenPmPage", "Open PMs Page")</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success">@Html.Localize(message, message)</div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-warning">@Html.Localize(error, error)</div>
}

@if (properties.Count > 1)
{
    <div class="mb-3">
        <label for="pmPropertySelect" class="form-label">@Html.Localize("Settings.PmSetup.PropertyLabel", "Property")</label>
        <select id="pmPropertySelect" class="form-select" style="max-width:360px;">
            @foreach (var property in properties)
            {
                var propId = property.Id.ToString(CultureInfo.InvariantCulture);
                var propNameRaw = property.Name ?? string.Empty;
                var propNameTranslated = await Html.DisplayTranslatedTextAsync("Property", propId, "Name", propNameRaw);
                var propName = string.IsNullOrWhiteSpace(propNameTranslated) ? propNameRaw : propNameTranslated;
                var optionUrl = Url.Action("PmSetup", "Settings", new { propertyId = property.Id });
                if (property.Id == Model.PropertyId)
                {
                    <option selected value="@optionUrl">@string.Format(CultureInfo.CurrentCulture, Html.Localize("Settings.PmSetup.PropertyOption", "{0} ({1})").ToString(), propName, property.Code)</option>
                }
                else
                {
                    <option value="@optionUrl">@string.Format(CultureInfo.CurrentCulture, Html.Localize("Settings.PmSetup.PropertyOption", "{0} ({1})").ToString(), propName, property.Code)</option>
                }
            }
        </select>
    </div>
}

<form asp-action="SavePmChecklist" method="post" id="pmSetupForm" class="card mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
    <div class="card-body">
        <div class="row g-4 align-items-end">
            <div class="col-md-4">
                <label for="pmFrequency" class="form-label">@Html.Localize("Settings.PmSetup.FrequencyLabel", "PM Frequency per year")</label>
                <input type="number"
                       class="form-control"
                       id="pmFrequency"
                       name="frequencyPerYear"
                       value="@Model.FrequencyPerYear"
                       min="1"
                       max="52"
                       required />
                <div class="form-text">@Html.Localize("Settings.PmSetup.FrequencyHelp", "How many times per year each room should complete a PM.")</div>
            </div>
            <div class="col-md-8">
                <div class="alert alert-info mb-0 small">
                    @Html.Localize("Settings.PmSetup.SortHelp", "Drag and drop rows to set checklist order. Click <strong>Save</strong> to keep your changes.")
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center gap-2 mt-4 mb-2 flex-wrap">
            <button type="button" class="btn btn-secondary" data-pm-action="add-row" data-position="top">@Html.Localize("Settings.PmSetup.AddRowTop", "+ Add Row")</button>
            <div class="d-flex align-items-center gap-2">
                <button type="submit" class="btn btn-success">@Html.Localize("Save")</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle table-striped" id="pmTasksTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px;"></th>
                        <th>@Html.Localize("Settings.PmSetup.TaskHeader", "Task")</th>
                        <th>@Html.Localize("Settings.PmSetup.DescriptionHeader", "Description")</th>
                        <th class="text-end" style="width:110px;">@Html.Localize("Settings.PmSetup.ActionsHeader", "Action")</th>
                    </tr>
                </thead>
                <tbody id="pmTasksBody">
                    @if (Model.Tasks.Any())
                    {
                        for (var i = 0; i < Model.Tasks.Count; i++)
                        {
                            var taskIdString = Model.Tasks[i].Id.ToString(CultureInfo.InvariantCulture);
                            var titleTranslated = await Html.DisplayTranslatedTextAsync("PmTask", taskIdString, "Title", Model.Tasks[i].Title ?? string.Empty);
                            var descriptionTranslated = await Html.DisplayTranslatedTextAsync("PmTask", taskIdString, "Description", Model.Tasks[i].Description ?? string.Empty);
                            <tr draggable="true" class="pm-task-row">
                                <td class="text-muted text-center cursor-move">
                                    <span class="pm-drag-handle" title="@Html.Localize("Settings.PmSetup.DragHandleTooltip", "Drag to reorder")">&#x2630;</span>
                                </td>
                                <td>
                                    <input type="hidden" name="tasks[@i].Id" value="@Model.Tasks[i].Id" />
                                    <input type="hidden" name="tasks[@i].SortOrder" value="@Model.Tasks[i].SortOrder" />
                                    <input type="text" class="form-control" name="tasks[@i].Title" value="@(string.IsNullOrWhiteSpace(titleTranslated) ? Model.Tasks[i].Title : titleTranslated)" placeholder="@Html.Localize("Settings.PmSetup.TaskPlaceholder", "Task name")" required />
                                </td>
                                <td>
                                    <textarea class="form-control" name="tasks[@i].Description" rows="2" placeholder="@Html.Localize("Settings.PmSetup.DescriptionPlaceholder", "Describe what needs to be done")">@(string.IsNullOrWhiteSpace(descriptionTranslated) ? Model.Tasks[i].Description : descriptionTranslated)</textarea>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-pm-action="delete-row">@Html.Localize("Settings.PmSetup.DeleteRow", "Delete")</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center gap-2 mt-3 flex-wrap">
            <button type="button" class="btn btn-secondary" data-pm-action="add-row" data-position="bottom">@Html.Localize("Settings.PmSetup.AddRowBottom", "+ Add Row")</button>
            <button type="submit" class="btn btn-success">@Html.Localize("Save")</button>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body">
        <h4 class="h5 mb-3">@Html.Localize("Settings.PmSetup.ImportHeading", "Import / Export")</h4>
        <form asp-action="ImportPmChecklist" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="propertyId" value="@Model.PropertyId" />
            <div class="col-md-6">
                <label class="form-label" for="pmImportFile">@Html.Localize("Settings.PmSetup.ImportLabel", "Import checklist via CSV")</label>
                <input type="file" class="form-control" id="pmImportFile" name="csvFile" accept=".csv" />
            </div>
            <div class="col-md-6 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">@Html.Localize("Settings.PmSetup.ImportButton", "Import CSV")</button>
                <a asp-action="DownloadPmChecklist" asp-route-propertyId="@Model.PropertyId" class="btn btn-outline-primary">@Html.Localize("Settings.PmSetup.DownloadCurrent", "Download current checklist")</a>
                <a asp-action="DownloadPmTemplate" class="btn btn-outline-secondary">@Html.Localize("Settings.PmSetup.DownloadTemplate", "Download template")</a>
            </div>
        </form>
    </div>
</div>

<template id="pmTaskTemplate">
    <tr draggable="true" class="pm-task-row">
        <td class="text-muted text-center cursor-move">
            <span class="pm-drag-handle" title="@Html.Localize("Settings.PmSetup.DragHandleTooltip", "Drag to reorder")">&#x2630;</span>
        </td>
        <td>
            <input type="hidden" name="tasks[#].Id" value="0" />
            <input type="hidden" name="tasks[#].SortOrder" value="0" />
            <input type="text" class="form-control" name="tasks[#].Title" placeholder="@Html.Localize("Settings.PmSetup.TaskPlaceholder", "Task name")" required />
        </td>
        <td>
            <textarea class="form-control" name="tasks[#].Description" rows="2" placeholder="@Html.Localize("Settings.PmSetup.DescriptionPlaceholder", "Describe what needs to be done")"></textarea>
        </td>
        <td class="text-end">
            <button type="button" class="btn btn-outline-danger btn-sm" data-pm-action="delete-row">@Html.Localize("Settings.PmSetup.DeleteRow", "Delete")</button>
        </td>
    </tr>
</template>

@section Scripts {
    <script>
        (function () {
            const translate = (key, fallback) => {
                if (typeof window !== 'undefined' && typeof window.hopsTranslate === 'function') {
                    return window.hopsTranslate(key, fallback);
                }
                return fallback;
            };

            const propertySelect = document.getElementById('pmPropertySelect');
            if (propertySelect) {
                propertySelect.addEventListener('change', (event) => {
                    const value = event.target.value;
                    if (value) {
                        window.location.href = value;
                    }
                });
            }

            const tableBody = document.getElementById('pmTasksBody');
            const rowTemplate = document.getElementById('pmTaskTemplate');
            const form = document.getElementById('pmSetupForm');

            function getRows() {
                return Array.from(tableBody?.querySelectorAll('.pm-task-row') ?? []);
            }

            function addRow(position) {
                if (!tableBody || !rowTemplate) {
                    return;
                }
                const fragment = rowTemplate.content.cloneNode(true);
                const placeholder = fragment.querySelectorAll('input, textarea');
                const nextIndex = getRows().length;
                placeholder.forEach(el => {
                    if (el.name?.includes('tasks[#]')) {
                        el.name = el.name.replace('tasks[#]', `tasks[${nextIndex}]`);
                    }
                });

                if (position === 'top') {
                    tableBody.prepend(fragment);
                } else {
                    tableBody.appendChild(fragment);
                }
            }

            function setSortOrderValues() {
                getRows().forEach((row, index) => {
                    const sortOrderInput = row.querySelector('input[name$=".SortOrder"]');
                    if (sortOrderInput) {
                        sortOrderInput.value = (index + 1).toString();
                    }
                });
            }

            function enableDragAndDrop() {
                const rows = getRows();
                rows.forEach(row => {
                    row.addEventListener('dragstart', () => {
                        row.classList.add('opacity-50');
                        row.dataset.dragging = 'true';
                    });

                    row.addEventListener('dragend', () => {
                        row.classList.remove('opacity-50');
                        delete row.dataset.dragging;
                        setSortOrderValues();
                    });
                });

                tableBody.addEventListener('dragover', (event) => {
                    event.preventDefault();
                    const draggingRow = tableBody.querySelector('[data-dragging="true"]');
                    if (!draggingRow) {
                        return;
                    }
                    const rows = getRows();
                    const afterElement = rows.find(row => {
                        const rect = row.getBoundingClientRect();
                        return event.clientY < rect.top + rect.height / 2;
                    });
                    if (afterElement) {
                        tableBody.insertBefore(draggingRow, afterElement);
                    } else {
                        tableBody.appendChild(draggingRow);
                    }
                });
            }

            function bindDeleteButtons() {
                tableBody.addEventListener('click', (event) => {
                    const target = event.target;
                    if (target && target instanceof HTMLElement && target.dataset.pmAction === 'delete-row') {
                        event.preventDefault();
                        const row = target.closest('.pm-task-row');
                        if (row) {
                            row.remove();
                            setSortOrderValues();
                        }
                    }
                });
            }

            function bindAddRowButtons() {
                document.querySelectorAll('[data-pm-action="add-row"]').forEach(button => {
                    button.addEventListener('click', () => {
                        const position = button.getAttribute('data-position') || 'bottom';
                        addRow(position);
                        setSortOrderValues();
                        enableDragAndDrop();
                    });
                });
            }

            function bindFormSubmission() {
                if (!form) {
                    return;
                }
                form.addEventListener('submit', () => {
                    setSortOrderValues();
                });
            }

            enableDragAndDrop();
            bindDeleteButtons();
            bindAddRowButtons();
            bindFormSubmission();
        })();
    </script>
}
