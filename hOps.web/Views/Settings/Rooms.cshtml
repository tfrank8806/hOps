@model List<hOps.web.Models.Room>
@{
    ViewData["Title"] = "Rooms Editor";
    int propertyId = ViewBag.PropertyId;
    var allProps = ViewBag.AllProperties as List<hOps.web.Models.Property> ?? new List<hOps.web.Models.Property>();
    string propertyName = ViewBag.PropertyName as string ?? $"Property {propertyId}";
}

<h2>Rooms Editor for @propertyName</h2>

@if (TempData["RoomsMissing"] is string missingMessage)
{
    <div class="alert alert-warning">@missingMessage</div>
}

@if (TempData["RoomsMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (allProps.Count > 1)
{
    <div class="mb-3">
        <label>Select Property: </label>
        <select id="propertySelect" class="form-select" style="width:auto; display:inline-block;">
            @foreach (var prop in allProps)
            {
                if (prop.Id == propertyId)
                {
                    <option selected value="@Url.Action("Rooms", "Settings", new { propertyId = prop.Id })">@prop.Name</option>
                }
                else
                {
                    <option value="@Url.Action("Rooms", "Settings", new { propertyId = prop.Id })">@prop.Name</option>
                }
            }
        </select>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h4 class="h5 mb-3">Import / Export</h4>
        <form asp-action="ImportRooms" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
            <input type="hidden" name="propertyId" value="@propertyId" />
            <div class="col-md-6">
                <label for="roomsCsvFile" class="form-label">Import rooms via CSV</label>
                <input type="file" id="roomsCsvFile" name="csvFile" accept=".csv" class="form-control" />
            </div>
            <div class="col-md-6 d-flex flex-wrap align-items-center gap-2">
                <button type="submit" class="btn btn-primary">Import CSV</button>
                <a asp-action="DownloadRoomsCsv" asp-route-propertyId="@propertyId" class="btn btn-outline-primary">Download Current Rooms</a>
                <a asp-action="DownloadRoomsTemplate" class="btn btn-outline-secondary">Download Template</a>
            </div>
        </form>
    </div>
</div>

<form asp-action="SaveRooms" method="post" id="roomsForm">
    <input type="hidden" name="propertyId" value="@propertyId" />

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <button type="button" class="btn btn-secondary js-add-row" data-insert-position="top">+ Add Row</button>
        <button type="submit" class="btn btn-success">Save Rooms</button>
    </div>

    <table class="table table-bordered table-striped" id="roomsTable">
        <thead class="table-light">
            <tr>
                <th>
                    <button type="button" class="btn btn-link p-0 text-decoration-none table-sort" data-sort-key="RoomNumber" data-sort-type="text">
                        Room Number <span class="sort-indicator ms-1 small text-muted"></span>
                    </button>
                </th>
                <th>
                    <button type="button" class="btn btn-link p-0 text-decoration-none table-sort" data-sort-key="Abbreviation" data-sort-type="text">
                        Abbreviation <span class="sort-indicator ms-1 small text-muted"></span>
                    </button>
                </th>
                <th>
                    <button type="button" class="btn btn-link p-0 text-decoration-none table-sort" data-sort-key="RoomType" data-sort-type="text">
                        Room Type <span class="sort-indicator ms-1 small text-muted"></span>
                    </button>
                </th>
                <th>
                    <button type="button" class="btn btn-link p-0 text-decoration-none table-sort" data-sort-key="Floor" data-sort-type="number">
                        Floor <span class="sort-indicator ms-1 small text-muted"></span>
                    </button>
                </th>
                <th>
                    <button type="button" class="btn btn-link p-0 text-decoration-none table-sort" data-sort-key="Description" data-sort-type="text">
                        Description <span class="sort-indicator ms-1 small text-muted"></span>
                    </button>
                </th>
                <th style="width:220px;">Maintenance / Actions</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td class="w-25">
                        <input type="hidden" name="rooms[@i].Id" value="@Model[i].Id" />
                        <input type="hidden" name="rooms[@i].PropertyId" value="@propertyId" />
                        <input name="rooms[@i].RoomNumber" value="@Model[i].RoomNumber" class="form-control" />
                    </td>
                    <td class="w-15">
                        <input name="rooms[@i].Abbreviation" value="@Model[i].Abbreviation" class="form-control text-uppercase" maxlength="3" placeholder="2-3 chars" />
                    </td>
                    <td class="w-20">
                        <input name="rooms[@i].RoomType" value="@Model[i].RoomType" class="form-control" />
                    </td>
                    <td class="w-15">
                        <input name="rooms[@i].Floor" value="@Model[i].Floor" class="form-control" />
                    </td>
                    <td class="w-25">
                        <input name="rooms[@i].Description" value="@Model[i].Description" class="form-control" />
                    </td>
                    <td class="align-middle">
                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex flex-wrap gap-3 align-items-center">
                                <div class="form-check form-check-inline mb-0">
                                    <input type="hidden" name="rooms[@i].IncludeInPreventiveMaintenance" value="false" />
                                    <input class="form-check-input" type="checkbox" name="rooms[@i].IncludeInPreventiveMaintenance" value="true" @(Model[i].IncludeInPreventiveMaintenance ? "checked" : null) id="room-@i-pm">
                                    <label class="form-check-label" for="room-@i-pm">PM</label>
                                </div>
                                <div class="form-check form-check-inline mb-0">
                                    <input type="hidden" name="rooms[@i].IncludeInDeepClean" value="false" />
                                    <input class="form-check-input" type="checkbox" name="rooms[@i].IncludeInDeepClean" value="true" @(Model[i].IncludeInDeepClean ? "checked" : null) id="room-@i-dc">
                                    <label class="form-check-label" for="room-@i-dc">Deep Clean</label>
                                </div>
                            </div>
                            <div>
                                <button type="button" class="btn btn-danger btn-sm btn-delete-row">Delete</button>
                            </div>
                        </div>
                    </td>
                </tr>
            }

            <tr id="newRowTemplate" style="display:none;">
                <td>
                    <input type="hidden" name="rooms[#].Id" value="0" />
                    <input type="hidden" name="rooms[#].PropertyId" value="@propertyId" />
                    <input name="rooms[#].RoomNumber" class="form-control" placeholder="Room #" />
                </td>
                <td><input name="rooms[#].Abbreviation" class="form-control text-uppercase" maxlength="3" placeholder="2-3 chars" /></td>
                <td><input name="rooms[#].RoomType" class="form-control" placeholder="Room Type" /></td>
                <td><input name="rooms[#].Floor" class="form-control" placeholder="Floor" /></td>
                <td><input name="rooms[#].Description" class="form-control" placeholder="Description" /></td>
                <td class="align-middle">
                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex flex-wrap gap-3 align-items-center">
                                <div class="form-check form-check-inline mb-0">
                                    <input type="hidden" name="rooms[#].IncludeInPreventiveMaintenance" value="false" />
                                    <input class="form-check-input" type="checkbox" name="rooms[#].IncludeInPreventiveMaintenance" value="true" checked />
                                    <label class="form-check-label">PM</label>
                                </div>
                                <div class="form-check form-check-inline mb-0">
                                    <input type="hidden" name="rooms[#].IncludeInDeepClean" value="false" />
                                    <input class="form-check-input" type="checkbox" name="rooms[#].IncludeInDeepClean" value="true" checked />
                                    <label class="form-check-label">Deep Clean</label>
                                </div>
                            </div>
                            <div>
                                <button type="button" class="btn btn-danger btn-sm btn-delete-row">Delete</button>
                            </div>
                        </div>
                </td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center gap-2 mt-3">
        <button type="button" class="btn btn-secondary js-add-row" data-insert-position="bottom">+ Add Row</button>
        <button type="submit" class="btn btn-success">Save Rooms</button>
    </div>

</form>
@section Scripts {
<script>
    const addRowButtons = document.querySelectorAll(".js-add-row");
    const roomsTable = document.getElementById("roomsTable");
    const roomsTableBody = roomsTable ? roomsTable.querySelector("tbody") : null;
    const newRowTemplate = document.getElementById("newRowTemplate");
    const sortButtons = document.querySelectorAll(".table-sort");
    const sortSelectors = {
        RoomNumber: 'input[name$=".RoomNumber"]',
        Abbreviation: 'input[name$=".Abbreviation"]',
        RoomType: 'input[name$=".RoomType"]',
        Floor: 'input[name$=".Floor"]',
        Description: 'input[name$=".Description"]'
    };
    let currentSortKey = null;
    let currentSortDirection = "asc";

    function addRoomRow(position) {
        if (!roomsTableBody || !newRowTemplate) {
            return;
        }

        var clone = newRowTemplate.cloneNode(true);
        clone.style.display = "";
        clone.removeAttribute("id");

        var rowCount = roomsTableBody.querySelectorAll("tr:not(#newRowTemplate)").length;
        clone.innerHTML = clone.innerHTML.replace(/rooms\[\#\]/g, "rooms[" + rowCount + "]");
        if (position === "top") {
            roomsTableBody.insertBefore(clone, roomsTableBody.firstElementChild);
        } else {
            roomsTableBody.appendChild(clone);
        }
    }

    function sortRoomsTable(key, sortType, direction) {
        if (!roomsTableBody) {
            return;
        }

        const rows = Array.from(roomsTableBody.querySelectorAll("tr"))
            .filter(row => row.id !== "newRowTemplate");

        if (!rows.length) {
            return;
        }

        rows.sort((a, b) => {
            const aValue = getSortValue(a, key);
            const bValue = getSortValue(b, key);

            if (sortType === "number") {
                const aNumber = parseInt(aValue, 10);
                const bNumber = parseInt(bValue, 10);
                const aMissing = Number.isNaN(aNumber);
                const bMissing = Number.isNaN(bNumber);

                if (aMissing && bMissing) {
                    return 0;
                }
                if (aMissing) {
                    return 1;
                }
                if (bMissing) {
                    return -1;
                }

                return direction === "asc" ? aNumber - bNumber : bNumber - aNumber;
            }

            const normalizedA = (aValue || "").toLowerCase();
            const normalizedB = (bValue || "").toLowerCase();

            if (!normalizedA && !normalizedB) {
                return 0;
            }
            if (!normalizedA) {
                return 1;
            }
            if (!normalizedB) {
                return -1;
            }

            return direction === "asc"
                ? normalizedA.localeCompare(normalizedB)
                : normalizedB.localeCompare(normalizedA);
        });

        rows.forEach(row => roomsTableBody.appendChild(row));
    }

    function getSortValue(row, key) {
        const selector = sortSelectors[key];
        if (!selector) {
            return "";
        }

        const input = row.querySelector(selector);
        if (!input) {
            return "";
        }

        return (input.value || "").toString().trim();
    }

    function updateSortIndicators(activeButton, direction) {
        sortButtons.forEach(button => {
            const indicator = button.querySelector(".sort-indicator");
            if (!indicator) {
                return;
            }

            if (button === activeButton) {
                indicator.textContent = direction === "asc" ? "^" : "v";
                indicator.classList.remove("invisible");
            } else {
                indicator.textContent = "";
                indicator.classList.add("invisible");
            }
        });
    }

    addRowButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {
            const position = btn.getAttribute("data-insert-position") || "bottom";
            addRoomRow(position);
        });
    });

    if (roomsTable) {
        roomsTable.addEventListener("click", function (e) {
            if (e.target && e.target.classList.contains("btn-delete-row")) {
                var row = e.target.closest("tr");
                row.remove();
            }
        });
    }

    sortButtons.forEach(function (button) {
        button.addEventListener("click", function () {
            const key = button.getAttribute("data-sort-key");
            const sortType = button.getAttribute("data-sort-type") || "text";
            if (!key) {
                return;
            }

            var nextDirection = "asc";
            if (currentSortKey === key && currentSortDirection === "asc") {
                nextDirection = "desc";
            }

            sortRoomsTable(key, sortType, nextDirection);
            currentSortKey = key;
            currentSortDirection = nextDirection;
            updateSortIndicators(button, nextDirection);
        });
    });

    var select = document.getElementById("propertySelect");
    if (select) {
        select.addEventListener("change", function () {
            window.location.href = this.value;
        });
    }
</script>
}







