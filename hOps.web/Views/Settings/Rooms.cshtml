@model List<hOps.web.Models.Room>
@{
    ViewData["Title"] = "Rooms Editor";
    int propertyId = ViewBag.PropertyId;
    var allProps = ViewBag.AllProperties as List<hOps.web.Models.Property> ?? new List<hOps.web.Models.Property>();
    string propertyName = ViewBag.PropertyName as string ?? $"Property {propertyId}";
}

<h2>Rooms Editor for @propertyName</h2>

@if (TempData["RoomsMissing"] is string missingMessage)
{
    <div class="alert alert-warning">@missingMessage</div>
}

@if (TempData["RoomsMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (allProps.Count > 1)
{
    <div class="mb-3">
        <label>Select Property: </label>
        <select id="propertySelect" class="form-select" style="width:auto; display:inline-block;">
            @foreach (var prop in allProps)
            {
                if (prop.Id == propertyId)
                {
                    <option selected value="@Url.Action("Rooms", "Settings", new { propertyId = prop.Id })">@prop.Name</option>
                }
                else
                {
                    <option value="@Url.Action("Rooms", "Settings", new { propertyId = prop.Id })">@prop.Name</option>
                }
            }
        </select>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h4 class="h5 mb-3">Import / Export</h4>
        <form asp-action="ImportRooms" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
            <input type="hidden" name="propertyId" value="@propertyId" />
            <div class="col-md-6">
                <label for="roomsCsvFile" class="form-label">Import rooms via CSV</label>
                <input type="file" id="roomsCsvFile" name="csvFile" accept=".csv" class="form-control" />
            </div>
            <div class="col-md-6 d-flex flex-wrap align-items-center gap-2">
                <button type="submit" class="btn btn-primary">Import CSV</button>
                <a asp-action="DownloadRoomsCsv" asp-route-propertyId="@propertyId" class="btn btn-outline-primary">Download Current Rooms</a>
                <a asp-action="DownloadRoomsTemplate" class="btn btn-outline-secondary">Download Template</a>
            </div>
        </form>
    </div>
</div>

<form asp-action="SaveRooms" method="post" id="roomsForm">
    <input type="hidden" name="propertyId" value="@propertyId" />

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <button type="button" class="btn btn-secondary js-add-row" data-insert-position="top">+ Add Row</button>
        <button type="submit" class="btn btn-success">Save Rooms</button>
    </div>

    <table class="table table-bordered table-striped" id="roomsTable">
        <thead class="table-light">
            <tr>
                <th>Room Number</th>
                <th>Abbreviation</th>
                <th>Room Type</th>
                <th>Floor</th>
                <th>Description</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td class="w-25">
                        <input type="hidden" name="rooms[@i].Id" value="@Model[i].Id" />
                        <input type="hidden" name="rooms[@i].PropertyId" value="@propertyId" />
                        <input name="rooms[@i].RoomNumber" value="@Model[i].RoomNumber" class="form-control" />
                    </td>
                    <td class="w-15">
                        <input name="rooms[@i].Abbreviation" value="@Model[i].Abbreviation" class="form-control text-uppercase" maxlength="3" placeholder="2-3 chars" />
                    </td>
                    <td class="w-20">
                        <input name="rooms[@i].RoomType" value="@Model[i].RoomType" class="form-control" />
                    </td>
                    <td class="w-15">
                        <input name="rooms[@i].Floor" value="@Model[i].Floor" class="form-control" />
                    </td>
                    <td class="w-25">
                        <input name="rooms[@i].Description" value="@Model[i].Description" class="form-control" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm btn-delete-row">Delete</button>
                    </td>
                </tr>
            }

            <tr id="newRowTemplate" style="display:none;">
                <td>
                    <input type="hidden" name="rooms[#].Id" value="0" />
                    <input type="hidden" name="rooms[#].PropertyId" value="@propertyId" />
                    <input name="rooms[#].RoomNumber" class="form-control" placeholder="Room #" />
                </td>
                <td><input name="rooms[#].Abbreviation" class="form-control text-uppercase" maxlength="3" placeholder="2-3 chars" /></td>
                <td><input name="rooms[#].RoomType" class="form-control" placeholder="Room Type" /></td>
                <td><input name="rooms[#].Floor" class="form-control" placeholder="Floor" /></td>
                <td><input name="rooms[#].Description" class="form-control" placeholder="Description" /></td>
                <td><button type="button" class="btn btn-danger btn-sm btn-delete-row">Delete</button></td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center gap-2 mt-3">
        <button type="button" class="btn btn-secondary js-add-row" data-insert-position="bottom">+ Add Row</button>
        <button type="submit" class="btn btn-success">Save Rooms</button>
    </div>

</form>
@section Scripts {
<script>
    const addRowButtons = document.querySelectorAll(".js-add-row");
    const roomsTable = document.getElementById("roomsTable");
    const roomsTableBody = roomsTable ? roomsTable.querySelector("tbody") : null;
    const newRowTemplate = document.getElementById("newRowTemplate");

    function addRoomRow(position) {
        if (!roomsTableBody || !newRowTemplate) {
            return;
        }

        var clone = newRowTemplate.cloneNode(true);
        clone.style.display = "";
        clone.removeAttribute("id");

        var rowCount = roomsTableBody.querySelectorAll("tr:not(#newRowTemplate)").length;
        clone.innerHTML = clone.innerHTML.replace(/rooms\[\#\]/g, "rooms[" + rowCount + "]");
        if (position === "top") {
            roomsTableBody.insertBefore(clone, roomsTableBody.firstElementChild);
        } else {
            roomsTableBody.appendChild(clone);
        }
    }

    addRowButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {
            const position = btn.getAttribute("data-insert-position") || "bottom";
            addRoomRow(position);
        });
    });

    if (roomsTable) {
        roomsTable.addEventListener("click", function (e) {
            if (e.target && e.target.classList.contains("btn-delete-row")) {
                var row = e.target.closest("tr");
                row.remove();
            }
        });
    }

    var select = document.getElementById("propertySelect");
    if (select) {
        select.addEventListener("change", function () {
            window.location.href = this.value;
        });
    }
</script>
}







