@model List<hOps.web.Models.Room>
@using System.Globalization
@{
    ViewData["Title"] = Html.Localize("Settings.Rooms.Title", "Rooms Editor").ToString();
    int propertyId = ViewBag.PropertyId;
    var allProps = ViewBag.AllProperties as List<hOps.web.Models.Property> ?? new List<hOps.web.Models.Property>();
    var propertyNameRaw = ViewBag.PropertyName as string ?? string.Empty;
    var propertyIdString = propertyId.ToString(CultureInfo.InvariantCulture);
    var propertyNameTranslated = await Html.DisplayTranslatedTextAsync("Property", propertyIdString, "Name", propertyNameRaw);
    var propertyName = string.IsNullOrWhiteSpace(propertyNameTranslated)
        ? (string.IsNullOrWhiteSpace(propertyNameRaw)
            ? string.Format(CultureInfo.CurrentCulture, Html.Localize("Settings.Rooms.PropertyFallback", "Property {0}").ToString(), propertyId)
            : propertyNameRaw)
        : propertyNameTranslated;
}

<h2>@string.Format(CultureInfo.CurrentCulture, Html.Localize("Settings.Rooms.Heading", "Rooms Editor for {0}").ToString(), propertyName)</h2>

@if (TempData["RoomsMissing"] is string missingMessage)
{
    <div class="alert alert-warning">@Html.Localize(missingMessage, missingMessage)</div>
}

@if (TempData["RoomsMessage"] is string successMessage)
{
    <div class="alert alert-success">@Html.Localize(successMessage, successMessage)</div>
}

<div id="roomsAlert"></div>

@if (allProps.Count > 1)
{
    <div class="mb-3">
        <label class="form-label me-2" for="propertySelect">@Html.Localize("Settings.Rooms.SelectProperty", "Select Property:")</label>
        <select id="propertySelect" class="form-select" style="width:auto; display:inline-block;">
            @foreach (var prop in allProps)
            {
                var propIdString = prop.Id.ToString(CultureInfo.InvariantCulture);
                var propNameRaw = prop.Name ?? string.Empty;
                var propNameTranslated = await Html.DisplayTranslatedTextAsync("Property", propIdString, "Name", propNameRaw);
                var propDisplayName = string.IsNullOrWhiteSpace(propNameTranslated) ? propNameRaw : propNameTranslated;
                var optionUrl = Url.Action("Rooms", "Settings", new { propertyId = prop.Id });
                if (prop.Id == propertyId)
                {
                    <option selected value="@optionUrl">@propDisplayName</option>
                }
                else
                {
                    <option value="@optionUrl">@propDisplayName</option>
                }
            }
        </select>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h4 class="h5 mb-3">@Html.Localize("Settings.Rooms.ImportExportHeading", "Import / Export")</h4>
        <form asp-action="ImportRooms" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
            <input type="hidden" name="propertyId" value="@propertyId" />
            <div class="col-md-6">
                <label for="roomsCsvFile" class="form-label">@Html.Localize("Settings.Rooms.ImportCsvLabel", "Import rooms via CSV")</label>
                <input type="file" id="roomsCsvFile" name="csvFile" accept=".csv" class="form-control" />
            </div>
            <div class="col-md-6 d-flex flex-wrap align-items-center gap-2">
                <button type="submit" class="btn btn-primary">@Html.Localize("Settings.Rooms.ImportCsvButton", "Import CSV")</button>
                <a asp-action="DownloadRoomsCsv" asp-route-propertyId="@propertyId" class="btn btn-outline-primary">@Html.Localize("Settings.Rooms.DownloadCurrent", "Download Current Rooms")</a>
                <a asp-action="DownloadRoomsTemplate" class="btn btn-outline-secondary">@Html.Localize("Settings.Rooms.DownloadTemplate", "Download Template")</a>
            </div>
        </form>
    </div>
</div>

<form asp-action="SaveRooms" method="post" id="roomsForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="propertyId" value="@propertyId" />

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <button type="button" class="btn btn-secondary js-add-row" data-insert-position="top">@Html.Localize("Settings.Rooms.AddRowTop", "+ Add Row")</button>
        <button type="submit" class="btn btn-success">@Html.Localize("Settings.Rooms.SaveRooms", "Save Rooms")</button>
    </div>

    <table class="table table-bordered table-striped" id="roomsTable">
        <thead class="table-light">
            <tr>
                <th>
                    <button type="button" class="btn btn-link p-0 text-decoration-none table-sort" data-sort-key="RoomNumber" data-sort-type="text">
                        @Html.Localize("Settings.Rooms.Header.RoomNumber", "Room Number") <span class="sort-indicator ms-1 small text-muted"></span>
                    </button>
                </th>
                <th>
                    <button type="button" class="btn btn-link p-0 text-decoration-none table-sort" data-sort-key="Abbreviation" data-sort-type="text">
                        @Html.Localize("Settings.Rooms.Header.Abbreviation", "Abbreviation") <span class="sort-indicator ms-1 small text-muted"></span>
                    </button>
                </th>
                <th>
                    <button type="button" class="btn btn-link p-0 text-decoration-none table-sort" data-sort-key="RoomType" data-sort-type="text">
                        @Html.Localize("Settings.Rooms.Header.RoomType", "Room Type") <span class="sort-indicator ms-1 small text-muted"></span>
                    </button>
                </th>
                <th>
                    <button type="button" class="btn btn-link p-0 text-decoration-none table-sort" data-sort-key="Floor" data-sort-type="number">
                        @Html.Localize("Settings.Rooms.Header.Floor", "Floor") <span class="sort-indicator ms-1 small text-muted"></span>
                    </button>
                </th>
                <th>
                    <button type="button" class="btn btn-link p-0 text-decoration-none table-sort" data-sort-key="Description" data-sort-type="text">
                        @Html.Localize("Settings.Rooms.Header.Description", "Description") <span class="sort-indicator ms-1 small text-muted"></span>
                    </button>
                </th>
                <th style="width:220px;">@Html.Localize("Settings.Rooms.Header.Actions", "Maintenance / Actions")</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr data-room-id="@Model[i].Id" data-room-number="@Model[i].RoomNumber">
                    <td class="w-25">
                        <input type="hidden" name="rooms[@i].Id" value="@Model[i].Id" />
                        <input type="hidden" name="rooms[@i].PropertyId" value="@propertyId" />
                        <input name="rooms[@i].RoomNumber" value="@Model[i].RoomNumber" class="form-control" />
                    </td>
                    <td class="w-15">
                        <input name="rooms[@i].Abbreviation" value="@Model[i].Abbreviation" class="form-control text-uppercase" maxlength="3" placeholder='@Html.Localize("Settings.Rooms.Placeholder.Abbreviation", "2-3 chars")' />
                    </td>
                    <td class="w-20">
                        <input name="rooms[@i].RoomType" value="@Model[i].RoomType" class="form-control" />
                    </td>
                    <td class="w-15">
                        <input name="rooms[@i].Floor" value="@Model[i].Floor" class="form-control" />
                    </td>
                    <td class="w-25">
                        <input name="rooms[@i].Description" value="@Model[i].Description" class="form-control" />
                    </td>
                    <td class="align-middle">
                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex flex-wrap gap-3 align-items-center">
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="checkbox" name="rooms[@i].IncludeInPreventiveMaintenance" value="true" @(Model[i].IncludeInPreventiveMaintenance ? "checked" : null) id="room-@i-pm">
                                    <input type="hidden" name="rooms[@i].IncludeInPreventiveMaintenance" value="false" />
                                    <label class="form-check-label" for="room-@i-pm">@Html.Localize("Settings.Rooms.Flag.PM", "PM")</label>
                                </div>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="checkbox" name="rooms[@i].IncludeInDeepClean" value="true" @(Model[i].IncludeInDeepClean ? "checked" : null) id="room-@i-dc">
                                    <input type="hidden" name="rooms[@i].IncludeInDeepClean" value="false" />
                                    <label class="form-check-label" for="room-@i-dc">@Html.Localize("Settings.Rooms.Flag.DeepClean", "Deep Clean")</label>
                                </div>
                            </div>
                            <div>
                                <button type="button" class="btn btn-danger btn-sm btn-delete-row">@Html.Localize("Settings.Rooms.DeleteRow", "Delete")</button>
                            </div>
                        </div>
                    </td>
                </tr>
            }

            <tr id="newRowTemplate" style="display:none;" data-room-id="0" data-room-number="">
                <td>
                    <input type="hidden" name="rooms[#].Id" value="0" />
                    <input type="hidden" name="rooms[#].PropertyId" value="@propertyId" />
                    <input name="rooms[#].RoomNumber" class="form-control" placeholder='@Html.Localize("Settings.Rooms.Placeholder.RoomNumber", "Room #")' />
                </td>
                <td><input name="rooms[#].Abbreviation" class="form-control text-uppercase" maxlength="3" placeholder='@Html.Localize("Settings.Rooms.Placeholder.Abbreviation", "2-3 chars")' /></td>
                <td><input name="rooms[#].RoomType" class="form-control" placeholder='@Html.Localize("Settings.Rooms.Placeholder.RoomType", "Room Type")' /></td>
                <td><input name="rooms[#].Floor" class="form-control" placeholder='@Html.Localize("Settings.Rooms.Placeholder.Floor", "Floor")' /></td>
                <td><input name="rooms[#].Description" class="form-control" placeholder='@Html.Localize("Settings.Rooms.Placeholder.Description", "Description")' /></td>
                <td class="align-middle">
                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex flex-wrap gap-3 align-items-center">
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="checkbox" name="rooms[#].IncludeInPreventiveMaintenance" value="true" checked />
                                    <input type="hidden" name="rooms[#].IncludeInPreventiveMaintenance" value="false" />
                                    <label class="form-check-label">@Html.Localize("Settings.Rooms.Flag.PM", "PM")</label>
                                </div>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="checkbox" name="rooms[#].IncludeInDeepClean" value="true" checked />
                                    <input type="hidden" name="rooms[#].IncludeInDeepClean" value="false" />
                                    <label class="form-check-label">@Html.Localize("Settings.Rooms.Flag.DeepClean", "Deep Clean")</label>
                                </div>
                            </div>
                            <div>
                                <button type="button" class="btn btn-danger btn-sm btn-delete-row">@Html.Localize("Settings.Rooms.DeleteRow", "Delete")</button>
                            </div>
                        </div>
                </td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center gap-2 mt-3">
        <button type="button" class="btn btn-secondary js-add-row" data-insert-position="bottom">@Html.Localize("Settings.Rooms.AddRowBottom", "+ Add Row")</button>
        <button type="submit" class="btn btn-success">@Html.Localize("Settings.Rooms.SaveRooms", "Save Rooms")</button>
    </div>

</form>
@section Scripts {
<script>
    const roomsForm = document.getElementById("roomsForm");
    const addRowButtons = document.querySelectorAll(".js-add-row");
    const roomsTable = document.getElementById("roomsTable");
    const roomsTableBody = roomsTable ? roomsTable.querySelector("tbody") : null;
    const newRowTemplate = document.getElementById("newRowTemplate");
    const roomsAlert = document.getElementById("roomsAlert");
    const sortButtons = document.querySelectorAll(".table-sort");
    const sortSelectors = {
        RoomNumber: 'input[name$=".RoomNumber"]',
        Abbreviation: 'input[name$=".Abbreviation"]',
        RoomType: 'input[name$=".RoomType"]',
        Floor: 'input[name$=".Floor"]',
        Description: 'input[name$=".Description"]'
    };
    const deleteRoomUrl = '@Url.Action("DeleteRoom", "Settings")';
    const propertyId = @propertyId;
    let currentSortKey = null;
    let currentSortDirection = "asc";

    function showRoomsAlert(status, message) {
        if (!roomsAlert) {
            return;
        }

        if (!message) {
            roomsAlert.innerHTML = "";
            return;
        }

        const statusClassMap = {
            success: "alert-success",
            error: "alert-danger",
            danger: "alert-danger",
            warning: "alert-warning",
            info: "alert-info"
        };

        const alertClass = statusClassMap[status] ?? "alert-success";
        roomsAlert.innerHTML = `<div class="alert ${alertClass}" role="alert">${message}</div>`;
    }

    function reindexRoomRows() {
        if (!roomsTableBody) {
            return;
        }

        const rows = Array.from(roomsTableBody.querySelectorAll("tr"))
            .filter(row => row.id !== "newRowTemplate");

        rows.forEach((row, index) => {
            row.dataset.rowIndex = index.toString();

            const inputs = row.querySelectorAll("input, textarea, select");
            inputs.forEach(input => {
                const currentName = input.getAttribute("name");
                if (currentName && currentName.includes("rooms[")) {
                    input.setAttribute("name", currentName.replace(/rooms\[\d+\]/g, `rooms[${index}]`));
                }

                const currentId = input.getAttribute("id");
                if (currentId && currentId.includes("room-")) {
                    const updatedId = currentId
                        .replace(/room-\d+-pm/g, `room-${index}-pm`)
                        .replace(/room-\d+-dc/g, `room-${index}-dc`);
                    if (updatedId !== currentId) {
                        input.setAttribute("id", updatedId);
                    }
                }
            });

            row.querySelectorAll("label[for]").forEach(label => {
                const currentFor = label.getAttribute("for");
                if (!currentFor) {
                    return;
                }

                const updatedFor = currentFor
                    .replace(/room-\d+-pm/g, `room-${index}-pm`)
                    .replace(/room-\d+-dc/g, `room-${index}-dc`);
                if (updatedFor !== currentFor) {
                    label.setAttribute("for", updatedFor);
                }
            });

            const roomIdInput = row.querySelector('input[name$=".Id"]');
            const roomNumberInput = row.querySelector('input[name$=".RoomNumber"]');
            const idValue = roomIdInput ? parseInt(roomIdInput.value || "0", 10) : 0;
            row.dataset.roomId = Number.isNaN(idValue) ? "0" : idValue.toString();
            row.dataset.roomNumber = roomNumberInput ? (roomNumberInput.value || "") : "";
        });
    }

    function getAntiForgeryToken() {
        const tokenInput = roomsForm?.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : null;
    }

    async function handleDeleteRow(row) {
        if (!row) {
            return;
        }

        const roomIdValue = parseInt(row.dataset.roomId || "0", 10);
        const roomNumberInput = row.querySelector('input[name$=".RoomNumber"]');
        const roomNumber = (roomNumberInput?.value || row.dataset.roomNumber || "").trim();
        const descriptor = roomNumber ? `room ${roomNumber}` : "this room";

        const confirmationMessage = roomIdValue > 0
            ? `Are you sure you want to delete ${descriptor}?`
            : `Remove ${descriptor}?`;

        if (!window.confirm(confirmationMessage)) {
            showRoomsAlert("", "");
            return;
        }

        let notificationStatus = "success";
        let notificationMessage = `Deleted ${descriptor}.`;

        if (roomIdValue > 0) {
            const token = getAntiForgeryToken();
            if (!token) {
                showRoomsAlert("danger", "Cannot delete the room because the security token is missing. Reload the page and try again.");
                return;
            }

            let response;
            try {
                response = await fetch(deleteRoomUrl, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": token
                    },
                    body: JSON.stringify({ roomId: roomIdValue, propertyId })
                });
            } catch {
                showRoomsAlert("danger", `Network error while deleting ${descriptor}.`);
                return;
            }

            if (!response.ok) {
                let errorMessage = `Failed to delete ${descriptor}.`;
                const contentType = response.headers.get("content-type") || "";
                try {
                    if (contentType.includes("application/json")) {
                        const payload = await response.json();
                        if (payload?.error) {
                            errorMessage = payload.error;
                        } else if (payload?.message) {
                            errorMessage = payload.message;
                        }
                    } else {
                        const text = await response.text();
                        if (text) {
                            errorMessage = text;
                        }
                    }
                } catch {
                    // ignore parsing issues
                }

                showRoomsAlert("danger", errorMessage);
                return;
            }

            const contentType = response.headers.get("content-type") || "";
            if (contentType.includes("application/json")) {
                try {
                    const payload = await response.json();
                    if (payload?.message) {
                        notificationMessage = payload.message;
                    }
                } catch {
                    // ignore parsing issues
                }
            }
        } else {
            notificationStatus = "info";
            notificationMessage = `Removed ${descriptor}.`;
        }

        row.remove();
        reindexRoomRows();
        showRoomsAlert(notificationStatus, notificationMessage);
    }

    function addRoomRow(position) {
        if (!roomsTableBody || !newRowTemplate) {
            return;
        }

        var clone = newRowTemplate.cloneNode(true);
        clone.style.display = "";
        clone.removeAttribute("id");
        clone.dataset.roomId = "0";
        clone.dataset.roomNumber = "";

        var rowCount = roomsTableBody.querySelectorAll("tr:not(#newRowTemplate)").length;
        clone.innerHTML = clone.innerHTML.replace(/rooms\[\#\]/g, "rooms[" + rowCount + "]");

        if (position === "top") {
            roomsTableBody.insertBefore(clone, roomsTableBody.firstElementChild);
        } else {
            roomsTableBody.appendChild(clone);
        }

        reindexRoomRows();
    }

    function sortRoomsTable(key, sortType, direction) {
        if (!roomsTableBody) {
            return;
        }

        const rows = Array.from(roomsTableBody.querySelectorAll("tr"))
            .filter(row => row.id !== "newRowTemplate");

        if (!rows.length) {
            return;
        }

        rows.sort((a, b) => {
            const aValue = getSortValue(a, key);
            const bValue = getSortValue(b, key);

            if (sortType === "number") {
                const aNumber = parseInt(aValue, 10);
                const bNumber = parseInt(bValue, 10);
                const aMissing = Number.isNaN(aNumber);
                const bMissing = Number.isNaN(bNumber);

                if (aMissing && bMissing) {
                    return 0;
                }
                if (aMissing) {
                    return 1;
                }
                if (bMissing) {
                    return -1;
                }

                return direction === "asc" ? aNumber - bNumber : bNumber - aNumber;
            }

            const normalizedA = (aValue || "").toLowerCase();
            const normalizedB = (bValue || "").toLowerCase();

            if (!normalizedA && !normalizedB) {
                return 0;
            }
            if (!normalizedA) {
                return 1;
            }
            if (!normalizedB) {
                return -1;
            }

            return direction === "asc"
                ? normalizedA.localeCompare(normalizedB)
                : normalizedB.localeCompare(normalizedA);
        });

        rows.forEach(row => roomsTableBody.appendChild(row));
        reindexRoomRows();
    }

    function getSortValue(row, key) {
        const selector = sortSelectors[key];
        if (!selector) {
            return "";
        }

        const input = row.querySelector(selector);
        if (!input) {
            return "";
        }

        return (input.value || "").toString().trim();
    }

    function updateSortIndicators(activeButton, direction) {
        sortButtons.forEach(button => {
            const indicator = button.querySelector(".sort-indicator");
            if (!indicator) {
                return;
            }

            if (button === activeButton) {
                indicator.textContent = direction === "asc" ? "^" : "v";
                indicator.classList.remove("invisible");
            } else {
                indicator.textContent = "";
                indicator.classList.add("invisible");
            }
        });
    }

    addRowButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {
            const position = btn.getAttribute("data-insert-position") || "bottom";
            addRoomRow(position);
        });
    });

    if (roomsTable) {
        roomsTable.addEventListener("click", function (e) {
            const target = e.target;
            if (target && target.classList.contains("btn-delete-row")) {
                const row = target.closest("tr");
                handleDeleteRow(row);
            }
        });
    }

    if (roomsTableBody) {
        roomsTableBody.addEventListener("input", function (event) {
            const target = event.target;
            if (target && target.name && target.name.endsWith(".RoomNumber")) {
                const row = target.closest("tr");
                if (row) {
                    row.dataset.roomNumber = target.value || "";
                }
            }
        });
    }

    sortButtons.forEach(function (button) {
        button.addEventListener("click", function () {
            const key = button.getAttribute("data-sort-key");
            const sortType = button.getAttribute("data-sort-type") || "text";
            if (!key) {
                return;
            }

            var nextDirection = "asc";
            if (currentSortKey === key && currentSortDirection === "asc") {
                nextDirection = "desc";
            }

            sortRoomsTable(key, sortType, nextDirection);
            currentSortKey = key;
            currentSortDirection = nextDirection;
            updateSortIndicators(button, nextDirection);
        });
    });

    var select = document.getElementById("propertySelect");
    if (select) {
        select.addEventListener("change", function () {
            window.location.href = this.value;
        });
    }

    reindexRoomRows();
</script>
}







