@model List<hOps.web.Models.RoomType>
@{
    ViewData["Title"] = "Room Types";
}

<h2>@ViewData["Title"]</h2>
<p><a class="btn btn-primary" asp-action="CreateRoomType">Add Room Type</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rt in Model)
        {
            <tr>
                <td>@rt.Name</td>
                <td>@rt.Description</td>
                <td>
                    <a asp-action="EditRoomType" asp-route-id="@rt.Id" class="btn btn-sm btn-warning">Edit</a>
                    <form asp-action="DeleteRoomType" asp-route-id="@rt.Id" method="post" style="display:inline">
                        <button class="btn btn-sm btn-danger" onclick="return confirm('Delete this room type?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
