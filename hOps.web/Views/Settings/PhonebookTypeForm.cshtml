@using System
@model hOps.web.Models.PhonebookType
@{
    var formAction = ViewData["FormAction"] as string ?? string.Empty;
    ViewData["Title"] = formAction.Contains("Edit", StringComparison.OrdinalIgnoreCase)
        ? "Edit Phonebook Type"
        : "Create Phonebook Type";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="@formAction" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger" />
    </div>
    <div class="form-group mt-2">
        <label asp-for="Color"></label>
        <input asp-for="Color" type="color" class="form-control" />
        <span asp-validation-for="Color" class="text-danger" />
    </div>
    <button type="submit" class="btn btn-success mt-3">Save</button>
</form>
