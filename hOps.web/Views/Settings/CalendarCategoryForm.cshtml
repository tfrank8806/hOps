@model hOps.web.Models.CalendarCategory
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var formAction = ViewData["FormAction"] as string ?? "CreateCalendarCategory";
    ViewData["Title"] = formAction.Contains("Edit", System.StringComparison.OrdinalIgnoreCase) ? "Edit Calendar Category" : "Create Calendar Category";
    var propertyOptions = ViewBag.PropertyOptions as List<SelectListItem> ?? new List<SelectListItem>();
    bool onlyGlobal = ViewBag.OnlyGlobal as bool? ?? false;
    string returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("CalendarCategories") ?? string.Empty;
}

<h2>@ViewData["Title"]</h2>

<form asp-action="@formAction" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="onlyGlobal" value="@(onlyGlobal.ToString().ToLowerInvariant())" />
    <input type="hidden" name="returnUrl" value="@returnUrl" />

    <div class="mb-3">
        <label class="form-label" for="calendarCategory-property">Applies To</label>
        <select class="form-select" id="calendarCategory-property" name="selectedPropertyId">
            @foreach (var option in propertyOptions)
            {
                <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
            }
        </select>
        <div class="form-text">Choose "Global" to share this category across all properties.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Color" class="form-label"></label>
        <input asp-for="Color" type="color" class="form-control" />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Save</button>
</form>
