@using System
@using System.Linq
@using System.Text.Json
@model hOps.web.ViewModels.LayoutEditorViewModel

@{
    ViewData["Title"] = "Layout Editor";
    int propertyId = Model.PropertyId;
    int selFloor = Model.SelectedFloor;
    var floors = Model.AllFloors;
}

<h2>Layout Editor — Property @propertyId, Floor @selFloor</h2>

@section Styles {
    <style>
        .layout-editor-controls {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .layout-editor-controls .control-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .room-box .box-controls {
            position: absolute;
            right: 0;
            bottom: 100%;
            display: flex;
            opacity: 0;
            margin-bottom: 4px;
            gap: 4px;
            padding: 2px;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid #333;
            border-radius: 4px;
            transition: opacity 0.2s;
            pointer-events: auto;
            z-index: 5;
        }

        .room-box:hover .box-controls,
        .room-box:focus-within .box-controls {
            opacity: 1;
        }

        .room-box .box-controls button {
            padding: 2px 6px;
            font-size: 0.8em;
        }

        .shape-dialog-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.35);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
        }

        .shape-dialog {
            background: #ffffff;
            border-radius: 8px;
            padding: 1.5rem;
            width: 320px;
            max-width: 90vw;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        }

        .shape-dialog h5 {
            margin-bottom: 1rem;
        }
    </style>
}

@if (floors != null && floors.Count > 1)
{
    <div class="mb-3 d-flex align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2">
            <label for="floorSelect" class="mb-0">Floor:</label>
            <select id="floorSelect" class="form-select form-select-sm" style="width:auto;">
                @foreach (var f in floors)
                {
                    var url = Url.Action("LayoutEditor", "Settings", new { propertyId, floor = f });
                    if (f == selFloor)
                    {
                        <option selected value="@url">Floor @f</option>
                    }
                    else
                    {
                        <option value="@url">Floor @f</option>
                    }
                }
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label for="ghostFloorSelect" class="mb-0">Ghost overlay:</label>
            <select id="ghostFloorSelect" class="form-select form-select-sm" style="width:auto;">
                <option value="">None</option>
                @foreach (var f in floors)
                {
                    if (f == selFloor)
                    {
                        continue;
                    }
                    <option value="@f">Floor @f</option>
                }
            </select>
        </div>
        <button id="btnAddFloor" class="btn btn-sm btn-outline-primary">+ Add Floor</button>
    </div>
}

<div class="layout-editor-controls mb-3">
    <div class="control-group form-check mb-0">
        <input class="form-check-input" type="checkbox" id="chkSnap" />
        <label class="form-check-label" for="chkSnap">Snap to grid</label>
    </div>
    <div class="control-group">
        <button id="zoomInBtn" class="btn btn-sm btn-outline-secondary" type="button">＋</button>
        <button id="zoomOutBtn" class="btn btn-sm btn-outline-secondary" type="button">－</button>
    </div>
    <div class="control-group">
        <button id="undoBtn" class="btn btn-sm btn-outline-secondary" type="button" disabled>Undo</button>
        <button id="redoBtn" class="btn btn-sm btn-outline-secondary" type="button" disabled>Redo</button>
    </div>
</div>

<div style="display:flex; height:650px;">
    <!-- Palette sidebar -->
    <div id="palette" style="width:200px; border:1px solid #ccc; padding:5px; overflow-y: auto;">
        <h4>Palette</h4>
        <!-- Always include custom tile -->
        <div class="pal-shape" data-room-id="0" data-room-label="Custom" draggable="true"
             style="width:50px; height:50px; border:1px solid #333; margin-bottom:10px;
                    display:flex; align-items:center; justify-content:center; cursor: grab;">
            Custom
        </div>
        @foreach (var room in Model.Rooms.Where(r => r.Floor == selFloor))
        {
            <div class="pal-shape"
                 data-room-id="@room.Id"
                 data-room-label="@room.RoomNumber"
                 draggable="true"
                 style="width:50px; height:50px; border:1px solid #333; margin-bottom:10px;
                            display:flex; align-items:center; justify-content:center; cursor: grab;">
                @room.RoomNumber
            </div>
        }
    </div>

    <!-- Editor container wrapper for pan/zoom -->
    <div id="editor-wrapper" style="position: relative; overflow: auto; border:1px solid #333; flex-grow:1;">
        <div id="editor-container" style="
            position: relative;
            width:1600px; height:1200px;
            background-color:#f7f7f7;
            background-image:
                linear-gradient(to right, #ddd 1px, transparent 1px),
                linear-gradient(to bottom, #ddd 1px, transparent 1px);
            background-size:50px 50px;
            transform-origin: 0 0;
        ">
            <div id="ghost-layer" style="position:absolute; inset:0; pointer-events:none; z-index:0;"></div>
            @foreach (var layout in Model.Layouts)
            {
                var label = Model.Rooms.FirstOrDefault(r => r.Id == layout.RoomId)?.RoomNumber
                    ?? (!string.IsNullOrWhiteSpace(layout.Label) ? layout.Label : layout.RoomId.ToString());
                var shapeType = string.IsNullOrWhiteSpace(layout.ShapeType) ? "rectangle" : layout.ShapeType;
                var shapeData = layout.ShapeData ?? string.Empty;
                var clipStyle = string.IsNullOrWhiteSpace(shapeData) ? string.Empty : $"clip-path:{shapeData}; -webkit-clip-path:{shapeData};";
                <div class="room-box"
                     data-room-id="@layout.RoomId"
                     data-room-label="@label"
                     data-shape-type="@shapeType"
                     data-shape-data="@shapeData"
                     style="
                             position:absolute;
                             left:@($"{layout.X}px");
                             top:@($"{layout.Y}px");
                             width:@($"{layout.Width}px");
                             height:@($"{layout.Height}px");
                             border:1px solid #333;
                             background-color:#cce5ff;
                             z-index:1;
                             display:flex; align-items:center; justify-content:center;
                             cursor:move; @clipStyle
                         ">
                    <span class="room-label">@label</span>
                    <div class="box-controls">
                        <button class="btn btn-sm btn-light btn-customize-shape" title="Customize shape">✎</button>
                        <button class="btn btn-sm btn-light btn-move-back" title="Move back">⮐</button>
                        <button class="btn btn-sm btn-light btn-delete-shape" title="Delete">✖</button>
                    </div>
                    <div class="resize-handle" style="
                            position:absolute; right:0; bottom:0;
                            width:12px; height:12px; background:#333; cursor:se-resize;
                            opacity:0.5;
                        "></div>
                </div>
            }
        </div>
    </div>
</div>

<div id="shapeDialogOverlay" class="shape-dialog-overlay">
    <div class="shape-dialog">
        <h5>Customize Shape</h5>
        <div class="mb-3">
            <label for="shapePresetSelect" class="form-label">Preset</label>
            <select id="shapePresetSelect" class="form-select form-select-sm">
                <option value="rectangle">Rectangle</option>
                <option value="l-top-left">L — Top Left</option>
                <option value="l-top-right">L — Top Right</option>
                <option value="l-bottom-left">L — Bottom Left</option>
                <option value="l-bottom-right">L — Bottom Right</option>
                <option value="custom">Custom (clip-path)</option>
            </select>
        </div>
        <div class="mb-3">
            <label for="shapeClipPathInput" class="form-label">CSS clip-path</label>
            <textarea id="shapeClipPathInput" class="form-control" rows="3"
                      placeholder="polygon(0% 0%, 100% 0%, ...)"></textarea>
            <small class="text-muted">Use CSS clip-path syntax to define advanced shapes.</small>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" id="shapeDialogCancel">Cancel</button>
            <button type="button" class="btn btn-primary" id="shapeDialogApply">Apply</button>
        </div>
    </div>
</div>

<button id="save-layout-btn" class="btn btn-primary mt-3">Save Layout</button>

@section Scripts {
    <script>
        (function(){
            const propertyId = @Model.PropertyId;
            const selectedFloor = @Model.SelectedFloor;
            const existingFloors = @Html.Raw(JsonSerializer.Serialize(Model.AllFloors ?? Enumerable.Empty<int>()));
            const baseLayoutUrl = '@Url.Action("LayoutEditor", "Settings")';
            const layoutsByFloorRaw = @Html.Raw(JsonSerializer.Serialize(Model.LayoutsByFloor));
            const roomLabelsRaw = @Html.Raw(JsonSerializer.Serialize(Model.Rooms.ToDictionary(r => r.Id, r => string.IsNullOrWhiteSpace(r.RoomNumber) ? $"Room {r.Id}" : r.RoomNumber)));
            const gridSize = 50;
            let scale = 1.0;
            const scaleStep = 0.1;
            const minScale = 0.5;
            const maxScale = 2.5;

            const wrapper = document.getElementById("editor-wrapper");
            const container = document.getElementById("editor-container");
            const chkSnap = document.getElementById("chkSnap");
            const floorSelect = document.getElementById("floorSelect");
            const addFloorBtn = document.getElementById("btnAddFloor");
            const ghostFloorSelect = document.getElementById("ghostFloorSelect");
            const ghostLayer = document.getElementById("ghost-layer");
            const palette = document.getElementById("palette");
            const undoBtn = document.getElementById("undoBtn");
            const redoBtn = document.getElementById("redoBtn");
            const shapeDialogOverlay = document.getElementById("shapeDialogOverlay");
            const shapePresetSelect = document.getElementById("shapePresetSelect");
            const shapeClipPathInput = document.getElementById("shapeClipPathInput");
            const shapeDialogApply = document.getElementById("shapeDialogApply");
            const shapeDialogCancel = document.getElementById("shapeDialogCancel");

            const shapePresets = new Map([
                ["rectangle", ""],
                ["l-top-left", "polygon(0% 0%, 100% 0%, 100% 30%, 35% 30%, 35% 100%, 0% 100%)"],
                ["l-top-right", "polygon(0% 0%, 100% 0%, 100% 100%, 65% 100%, 65% 30%, 0% 30%, 0% 0%)"],
                ["l-bottom-left", "polygon(0% 0%, 35% 0%, 35% 70%, 100% 70%, 100% 100%, 0% 100%)"],
                ["l-bottom-right", "polygon(65% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 70%, 65% 70%)"]
            ]);

            const initialPaletteRooms = new Map();
            const paletteRoomLabels = new Map();
            if (palette) {
                palette.querySelectorAll(".pal-shape").forEach(tile => {
                    const rid = tile.getAttribute("data-room-id");
                    const label = tile.getAttribute("data-room-label") ?? tile.textContent ?? "";
                    if (!rid) {
                        return;
                    }
                    const trimmedLabel = label.trim();
                    paletteRoomLabels.set(rid, trimmedLabel);
                    if (rid !== "0") {
                        initialPaletteRooms.set(rid, trimmedLabel);
                    }
                });
            }

            const undoStack = [];
            let redoStack = [];
            let isApplyingState = false;
            let shapeDialogTarget = null;

            const layoutsByFloor = new Map();
            if (layoutsByFloorRaw && typeof layoutsByFloorRaw === 'object') {
                Object.entries(layoutsByFloorRaw).forEach(([key, value]) => {
                    const floorNumber = parseInt(key, 10);
                    if (!Number.isNaN(floorNumber)) {
                        layoutsByFloor.set(floorNumber, Array.isArray(value) ? value : []);
                    }
                });
            }

            const roomLabelLookup = (roomLabelsRaw && typeof roomLabelsRaw === 'object') ? roomLabelsRaw : {};
            const ghostStorageKey = `layoutGhostFloor_${propertyId}`;

            if (ghostFloorSelect && ghostLayer) {
                const storedGhost = localStorage.getItem(ghostStorageKey);
                if (storedGhost && storedGhost !== selectedFloor.toString() && ghostFloorSelect.querySelector(`option[value="${storedGhost}"]`)) {
                    ghostFloorSelect.value = storedGhost;
                    renderGhostFloor(parseInt(storedGhost, 10));
                } else {
                    renderGhostFloor(null);
                }

                ghostFloorSelect.addEventListener("change", () => {
                    const value = ghostFloorSelect.value;
                    if (value) {
                        localStorage.setItem(ghostStorageKey, value);
                        renderGhostFloor(parseInt(value, 10));
                    } else {
                        localStorage.removeItem(ghostStorageKey);
                        renderGhostFloor(null);
                    }
                });
            } else if (ghostLayer) {
                renderGhostFloor(null);
            }

            if (floorSelect) {
                floorSelect.addEventListener("change", e => {
                    const target = e.target;
                    if (!(target instanceof HTMLSelectElement)) return;
                    const url = target.value;
                    if (url) {
                        window.location.href = url;
                    }
                });
            }

            if (addFloorBtn) {
                addFloorBtn.addEventListener("click", async () => {
                    const currentFloors = Array.isArray(existingFloors) ? existingFloors : [];
                    const suggestedFloor = currentFloors.length ? Math.max(...currentFloors) + 1 : selectedFloor + 1;
                    const response = prompt("Enter the floor number to add:", suggestedFloor.toString());
                    if (response === null) {
                        return;
                    }
                    const floorNumber = parseInt(response, 10);
                    if (Number.isNaN(floorNumber)) {
                        alert("Please enter a valid number for the floor.");
                        return;
                    }
                    if (currentFloors.includes(floorNumber)) {
                        alert(`Floor ${floorNumber} already exists.`);
                        return;
                    }

                    try {
                        const result = await fetch('@Url.Action("AddFloor", "Settings")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ propertyId, floor: floorNumber })
                        });

                        if (!result.ok) {
                            alert('Unable to add the floor.');
                            return;
                        }

                        window.location.href = `${baseLayoutUrl}?propertyId=${propertyId}&floor=${floorNumber}`;
                    } catch {
                        alert('An unexpected error occurred while adding the floor.');
                    }
                });
            }

            chkSnap.checked = localStorage.getItem("layoutSnap") === "true";
            toggleGrid();
            chkSnap.addEventListener("change", () => {
                localStorage.setItem("layoutSnap", chkSnap.checked);
                toggleGrid();
            });

            function toggleGrid() {
                if (chkSnap.checked) {
                    container.style.backgroundImage =
                        "linear-gradient(to right, #ddd 1px, transparent 1px), " +
                        "linear-gradient(to bottom, #ddd 1px, transparent 1px)";
                } else {
                    container.style.backgroundImage = "none";
                }
            }

            function applyShapeToElement(element, shapeType, shapeData) {
                if (!(element instanceof HTMLElement)) {
                    return;
                }
                const normalizedType = (typeof shapeType === "string" && shapeType.trim().length > 0)
                    ? shapeType.trim()
                    : "rectangle";
                const normalizedData = (typeof shapeData === "string" && shapeData.trim().length > 0)
                    ? shapeData.trim()
                    : "";

                element.setAttribute("data-shape-type", normalizedType);
                element.setAttribute("data-shape-data", normalizedData);

                if (normalizedData.length > 0) {
                    element.style.clipPath = normalizedData;
                    element.style.webkitClipPath = normalizedData;
                } else {
                    element.style.removeProperty("clip-path");
                    element.style.removeProperty("-webkit-clip-path");
                }
            }

            function syncPaletteFromState(state) {
                if (!palette) {
                    return;
                }

                const placedRoomIds = new Set();
                state.forEach(entry => {
                    const rid = entry && typeof entry.roomId !== "undefined" ? String(entry.roomId) : "";
                    if (!rid || rid === "0") {
                        return;
                    }
                    placedRoomIds.add(rid);
                    if (entry.label && entry.label.trim().length > 0) {
                        paletteRoomLabels.set(rid, entry.label.trim());
                    }
                });

                palette.querySelectorAll(".pal-shape").forEach(tile => {
                    const rid = tile.getAttribute("data-room-id");
                    if (rid && rid !== "0") {
                        tile.remove();
                    }
                });

                initialPaletteRooms.forEach((_, rid) => {
                    if (placedRoomIds.has(rid)) {
                        return;
                    }
                    const label = paletteRoomLabels.get(rid)
                        ?? initialPaletteRooms.get(rid)
                        ?? (roomLabelLookup && roomLabelLookup[rid] ? roomLabelLookup[rid] : `Room ${rid}`);
                    moveBackToPalette(rid, label);
                });
            }

            function captureLayoutState() {
                const boxes = Array.from(container.querySelectorAll(".room-box"));
                const state = boxes.map(b => {
                    const ridValue = b.getAttribute("data-room-id");
                    const roomId = parseInt(ridValue ?? "0", 10) || 0;
                    const label = b.getAttribute("data-room-label") ?? "";
                    const x = parseInt(b.style.left) || 0;
                    const y = parseInt(b.style.top) || 0;
                    const width = parseInt(b.style.width) || b.offsetWidth;
                    const height = parseInt(b.style.height) || b.offsetHeight;
                    const shapeType = b.getAttribute("data-shape-type") ?? "rectangle";
                    const shapeData = b.getAttribute("data-shape-data") ?? "";
                    return { roomId, label, x, y, width, height, shapeType, shapeData };
                });

                state.sort((a, b) => {
                    if (a.roomId !== b.roomId) {
                        return a.roomId - b.roomId;
                    }
                    if (a.x !== b.x) {
                        return a.x - b.x;
                    }
                    return a.y - b.y;
                });

                return state;
            }

            function serializeState(state) {
                return JSON.stringify(state.map(entry => [
                    entry.roomId,
                    entry.label,
                    entry.x,
                    entry.y,
                    entry.width,
                    entry.height,
                    entry.shapeType,
                    entry.shapeData
                ]));
            }

            function restoreLayoutState(state) {
                if (!Array.isArray(state)) {
                    return;
                }
                isApplyingState = true;
                container.querySelectorAll(".room-box").forEach(box => box.remove());
                state.forEach(entry => {
                    addBox(
                        String(entry.roomId),
                        entry.label ?? "",
                        entry.x ?? 0,
                        entry.y ?? 0,
                        {
                            width: entry.width ?? gridSize,
                            height: entry.height ?? gridSize,
                            shapeType: entry.shapeType ?? "rectangle",
                            shapeData: entry.shapeData ?? "",
                            skipRecord: true
                        }
                    );
                });
                isApplyingState = false;
                syncPaletteFromState(state);
                updateUndoRedoButtons();
            }

            function recordState(force = false) {
                if (isApplyingState) {
                    return;
                }
                const state = captureLayoutState();
                const serialized = serializeState(state);
                if (!force && undoStack.length > 0) {
                    const last = undoStack[undoStack.length - 1];
                    if (last.serialized === serialized) {
                        syncPaletteFromState(state);
                        return;
                    }
                }
                undoStack.push({ state: JSON.parse(JSON.stringify(state)), serialized });
                if (undoStack.length > 100) {
                    undoStack.shift();
                }
                redoStack = [];
                syncPaletteFromState(state);
                updateUndoRedoButtons();
            }

            function updateUndoRedoButtons() {
                if (undoBtn) {
                    undoBtn.disabled = undoStack.length <= 1;
                }
                if (redoBtn) {
                    redoBtn.disabled = redoStack.length === 0;
                }
            }

            function undo() {
                if (undoStack.length <= 1) {
                    return;
                }
                const current = undoStack.pop();
                redoStack.push(current);
                const previous = undoStack[undoStack.length - 1];
                restoreLayoutState(previous.state);
            }

            function redo() {
                if (redoStack.length === 0) {
                    return;
                }
                const next = redoStack.pop();
                undoStack.push({ state: JSON.parse(JSON.stringify(next.state)), serialized: next.serialized });
                restoreLayoutState(next.state);
            }

            function updateShapeDialogInputs(selectedType, providedData) {
                if (!shapePresetSelect || !shapeClipPathInput) {
                    return;
                }
                const normalizedType = shapePresets.has(selectedType) || selectedType === "custom"
                    ? selectedType
                    : "custom";
                shapePresetSelect.value = normalizedType;
                if (normalizedType === "custom") {
                    shapeClipPathInput.disabled = false;
                    shapeClipPathInput.value = providedData ?? "";
                } else {
                    const presetValue = shapePresets.get(normalizedType) ?? "";
                    shapeClipPathInput.disabled = true;
                    shapeClipPathInput.value = presetValue;
                }
            }

            function openShapeDialog(target) {
                if (!shapeDialogOverlay || !shapePresetSelect || !shapeClipPathInput) {
                    return;
                }
                shapeDialogTarget = target instanceof HTMLElement ? target : null;
                if (!shapeDialogTarget) {
                    return;
                }
                const currentType = shapeDialogTarget.getAttribute("data-shape-type") ?? "rectangle";
                const currentData = shapeDialogTarget.getAttribute("data-shape-data") ?? "";
                if (shapePresets.has(currentType) || currentType === "custom") {
                    updateShapeDialogInputs(currentType, currentData);
                } else {
                    updateShapeDialogInputs("custom", currentData);
                }
                shapeDialogOverlay.style.display = "flex";
                if (!shapeClipPathInput.disabled) {
                    shapeClipPathInput.focus();
                    shapeClipPathInput.select();
                } else if (shapePresetSelect) {
                    shapePresetSelect.focus();
                }
            }

            function closeShapeDialog() {
                if (!shapeDialogOverlay) {
                    return;
                }
                shapeDialogOverlay.style.display = "none";
                shapeDialogTarget = null;
            }

            function resolveLayoutLabel(layout) {
                if (!layout) {
                    return "";
                }
                if (typeof layout.Label === "string" && layout.Label.trim().length > 0) {
                    return layout.Label;
                }
                const roomId = layout.RoomId;
                if (roomId === undefined || roomId === null) {
                    return "";
                }
                const key = String(roomId);
                if (Object.prototype.hasOwnProperty.call(roomLabelLookup, key)) {
                    const label = roomLabelLookup[key];
                    if (typeof label === "string" && label.trim().length > 0) {
                        return label;
                    }
                }
                return String(roomId);
            }

            function renderGhostFloor(floorNumber) {
                if (!ghostLayer) {
                    return;
                }
                ghostLayer.innerHTML = "";
                if (typeof floorNumber !== "number" || Number.isNaN(floorNumber) || floorNumber === selectedFloor) {
                    ghostLayer.style.display = "none";
                    return;
                }

                const layouts = layoutsByFloor.get(floorNumber);
                if (!Array.isArray(layouts) || layouts.length === 0) {
                    ghostLayer.style.display = "none";
                    return;
                }

                ghostLayer.style.display = "block";
                layouts.forEach(layout => {
                    const ghostBox = document.createElement("div");
                    ghostBox.classList.add("ghost-room-box");
                    const left = typeof layout.X === "number" ? layout.X : parseInt(layout.X, 10) || 0;
                    const top = typeof layout.Y === "number" ? layout.Y : parseInt(layout.Y, 10) || 0;
                    const width = typeof layout.Width === "number" ? layout.Width : parseInt(layout.Width, 10) || gridSize;
                    const height = typeof layout.Height === "number" ? layout.Height : parseInt(layout.Height, 10) || gridSize;
                    ghostBox.style.position = "absolute";
                    ghostBox.style.left = `${left}px`;
                    ghostBox.style.top = `${top}px`;
                    ghostBox.style.width = `${width}px`;
                    ghostBox.style.height = `${height}px`;
                    ghostBox.style.border = "1px dashed #6c757d";
                    ghostBox.style.backgroundColor = "rgba(108, 117, 125, 0.25)";
                    ghostBox.style.color = "#495057";
                    ghostBox.style.display = "flex";
                    ghostBox.style.alignItems = "center";
                    ghostBox.style.justifyContent = "center";
                    ghostBox.style.fontSize = "0.8rem";
                    ghostBox.style.pointerEvents = "none";
                    ghostBox.style.zIndex = "0";
                    const ghostShapeData = typeof layout.ShapeData === "string" ? layout.ShapeData : "";
                    if (ghostShapeData && ghostShapeData.trim().length > 0) {
                        ghostBox.style.clipPath = ghostShapeData.trim();
                        ghostBox.style.webkitClipPath = ghostShapeData.trim();
                    }
                    ghostBox.textContent = resolveLayoutLabel(layout);
                    ghostLayer.appendChild(ghostBox);
                });
            }

            if (undoBtn) {
                undoBtn.addEventListener("click", evt => {
                    evt.preventDefault();
                    undo();
                });
            }

            if (redoBtn) {
                redoBtn.addEventListener("click", evt => {
                    evt.preventDefault();
                    redo();
                });
            }

            if (shapePresetSelect) {
                shapePresetSelect.addEventListener("change", () => {
                    const selected = shapePresetSelect.value;
                    const existing = selected === "custom"
                        ? (shapeDialogTarget?.getAttribute("data-shape-data") ?? shapeClipPathInput?.value ?? "")
                        : (shapePresets.get(selected) ?? "");
                    updateShapeDialogInputs(selected, existing);
                });
            }

            if (shapeDialogApply) {
                shapeDialogApply.addEventListener("click", evt => {
                    evt.preventDefault();
                    if (!shapeDialogTarget) {
                        closeShapeDialog();
                        return;
                    }
                    const selectedType = shapePresetSelect ? shapePresetSelect.value : "rectangle";
                    let clipPath = "";
                    if (selectedType === "custom") {
                        clipPath = shapeClipPathInput ? shapeClipPathInput.value.trim() : "";
                        if (clipPath.length === 0) {
                            alert("Please provide a clip-path definition for the custom shape.");
                            return;
                        }
                    } else {
                        clipPath = shapePresets.get(selectedType) ?? "";
                    }
                    applyShapeToElement(shapeDialogTarget, selectedType, clipPath);
                    closeShapeDialog();
                    recordState();
                });
            }

            if (shapeDialogCancel) {
                shapeDialogCancel.addEventListener("click", evt => {
                    evt.preventDefault();
                    closeShapeDialog();
                });
            }

            if (shapeDialogOverlay) {
                shapeDialogOverlay.addEventListener("click", evt => {
                    if (evt.target === shapeDialogOverlay) {
                        closeShapeDialog();
                    }
                });
            }

            document.addEventListener("keydown", evt => {
                if (evt.key === "Escape" && shapeDialogOverlay && shapeDialogOverlay.style.display === "flex") {
                    closeShapeDialog();
                }
            });

            document.getElementById("zoomInBtn").addEventListener("click", () => {
                scale = Math.min(maxScale, scale + scaleStep);
                container.style.transform = `scale(${scale})`;
            });
            document.getElementById("zoomOutBtn").addEventListener("click", () => {
                scale = Math.max(minScale, scale - scaleStep);
                container.style.transform = `scale(${scale})`;
            });

            // Panning
            let isPanning = false, startX = 0, startY = 0, scrollLeft = 0, scrollTop = 0;
            wrapper.addEventListener("mousedown", e => {
                if (e.target === wrapper) {
                    isPanning = true;
                    startX = e.clientX;
                    startY = e.clientY;
                    scrollLeft = wrapper.scrollLeft;
                    scrollTop = wrapper.scrollTop;
                    wrapper.style.cursor = "grabbing";
                    e.preventDefault();
                }
            });
            wrapper.addEventListener("mousemove", e => {
                if (!isPanning) return;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                wrapper.scrollLeft = scrollLeft - dx;
                wrapper.scrollTop = scrollTop - dy;
            });
            wrapper.addEventListener("mouseup", () => {
                isPanning = false;
                wrapper.style.cursor = "default";
            });
            wrapper.addEventListener("mouseleave", () => {
                isPanning = false;
                wrapper.style.cursor = "default";
            });

            // Palette dragstart
            document.querySelectorAll(".pal-shape").forEach(p => {
                p.addEventListener("dragstart", e => {
                    const rid = p.getAttribute("data-room-id");
                    const label = p.getAttribute("data-room-label");
                    e.dataTransfer.setData("text/plain", rid + "|" + label);
                });
            });
            container.addEventListener("dragover", e => e.preventDefault());
            container.addEventListener("drop", e => {
                e.preventDefault();
                const data = e.dataTransfer.getData("text/plain");
                const [rid, label] = data.split("|");
                const rect = container.getBoundingClientRect();
                let x = (e.clientX - rect.left) / scale;
                let y = (e.clientY - rect.top) / scale;
                x -= gridSize / 2;
                y -= gridSize / 2;
                if (chkSnap.checked) {
                    x = Math.round(x / gridSize) * gridSize;
                    y = Math.round(y / gridSize) * gridSize;
                }
                addBox(rid, label, x, y);

                // Remove palette tile only if it's not the custom tile
                document.querySelectorAll(".pal-shape").forEach(p => {
                    const rid2 = p.getAttribute("data-room-id");
                    if (rid2 === rid && rid2 !== "0") {
                        p.remove();
                    }
                });
            });

            function setupBoxInteractions(div) {
                if (!(div instanceof HTMLElement) || div.dataset.initialized === "true") {
                    return;
                }

                div.dataset.initialized = "true";

                applyShapeToElement(
                    div,
                    div.getAttribute("data-shape-type") ?? "rectangle",
                    div.getAttribute("data-shape-data") ?? ""
                );

                const labelSpan = div.querySelector(".room-label");
                if (labelSpan) {
                    labelSpan.addEventListener("dblclick", e => {
                        const newLabel = prompt("Enter new label:", labelSpan.textContent ?? "");
                        if (newLabel !== null) {
                            labelSpan.textContent = newLabel;
                            div.setAttribute("data-room-label", newLabel);
                            recordState();
                        }
                        e.stopPropagation();
                    });
                }

                const handleRemove = () => {
                    const roomId = div.getAttribute("data-room-id") ?? "0";
                    const currentLabel = div.getAttribute("data-room-label")
                        ?? (labelSpan ? labelSpan.textContent ?? "" : "");
                    moveBackToPalette(roomId, currentLabel);
                    div.remove();
                    recordState();
                };

                const customizeBtn = div.querySelector(".btn-customize-shape");
                if (customizeBtn) {
                    customizeBtn.addEventListener("click", evt => {
                        evt.preventDefault();
                        evt.stopPropagation();
                        openShapeDialog(div);
                    });
                }

                const moveBackBtn = div.querySelector(".btn-move-back");
                if (moveBackBtn) {
                    moveBackBtn.addEventListener("click", evt => {
                        evt.stopPropagation();
                        handleRemove();
                    });
                }

                const deleteBtn = div.querySelector(".btn-delete-shape");
                if (deleteBtn) {
                    deleteBtn.addEventListener("click", evt => {
                        evt.stopPropagation();
                        handleRemove();
                    });
                }

                div.addEventListener("mousedown", startDrag);
            }

            function addBox(roomId, roomLabel, x, y, options) {
                const opts = options ?? {};
                const div = document.createElement("div");
                div.classList.add("room-box");
                div.setAttribute("data-room-id", roomId);
                div.setAttribute("data-room-label", roomLabel);

                div.style.left = x + "px";
                div.style.top = y + "px";
                const boxWidth = typeof opts.width === "number" ? opts.width : gridSize;
                const boxHeight = typeof opts.height === "number" ? opts.height : gridSize;
                div.style.width = boxWidth + "px";
                div.style.height = boxHeight + "px";
                div.style.position = "absolute";
                div.style.border = "1px solid #333";
                div.style.backgroundColor = "#cce5ff";
                div.style.zIndex = "1";
                div.style.display = "flex";
                div.style.alignItems = "center";
                div.style.justifyContent = "center";
                div.style.cursor = "move";

                const span = document.createElement("span");
                span.classList.add("room-label");
                span.textContent = roomLabel;
                div.appendChild(span);

                const controls = document.createElement("div");
                controls.classList.add("box-controls");
                controls.style.position = "absolute";
                controls.style.right = "0";
                controls.style.bottom = "100%";
                controls.style.display = "flex";
                controls.style.marginBottom = "4px";

                const btnCustomize = document.createElement("button");
                btnCustomize.classList.add("btn", "btn-sm", "btn-light", "btn-customize-shape");
                btnCustomize.title = "Customize shape";
                btnCustomize.innerText = "✎";
                controls.appendChild(btnCustomize);

                const btnMoveBack = document.createElement("button");
                btnMoveBack.classList.add("btn", "btn-sm", "btn-light", "btn-move-back");
                btnMoveBack.title = "Move back to palette";
                btnMoveBack.innerText = "⮐";
                controls.appendChild(btnMoveBack);

                const btnDel = document.createElement("button");
                btnDel.classList.add("btn", "btn-sm", "btn-light", "btn-delete-shape");
                btnDel.title = "Delete shape";
                btnDel.innerText = "✖";
                controls.appendChild(btnDel);

                div.appendChild(controls);

                const rh = document.createElement("div");
                rh.classList.add("resize-handle");
                rh.style.position = "absolute";
                rh.style.right = "0";
                rh.style.bottom = "0";
                rh.style.width = "12px";
                rh.style.height = "12px";
                rh.style.background = "#333";
                rh.style.cursor = "se-resize";
                div.appendChild(rh);

                container.appendChild(div);
                applyShapeToElement(
                    div,
                    typeof opts.shapeType === "string" ? opts.shapeType : "rectangle",
                    typeof opts.shapeData === "string" ? opts.shapeData : ""
                );
                setupBoxInteractions(div);
                if (!opts.skipRecord) {
                    recordState();
                }
            }

            function moveBackToPalette(roomId, roomLabel) {
                const pal = document.getElementById("palette");
                if (!pal) {
                    return;
                }

                const key = String(roomId);
                paletteRoomLabels.set(key, roomLabel);

                const existing = pal.querySelector(`.pal-shape[data-room-id="${roomId}"]`);
                if (existing) {
                    existing.setAttribute("data-room-label", roomLabel);
                    existing.textContent = roomLabel;
                    return;
                }

                if (roomId === "0") {
                    return;
                }

                const p = document.createElement("div");
                p.classList.add("pal-shape");
                p.setAttribute("data-room-id", roomId);
                p.setAttribute("data-room-label", roomLabel);
                p.draggable = true;
                p.style.width = "50px";
                p.style.height = "50px";
                p.style.border = "1px solid #333";
                p.style.marginBottom = "10px";
                p.style.display = "flex";
                p.style.alignItems = "center";
                p.style.justifyContent = "center";
                p.style.cursor = "grab";
                p.textContent = roomLabel;
                p.addEventListener("dragstart", e => {
                    e.dataTransfer.setData("text/plain", roomId + "|" + roomLabel);
                });
                pal.appendChild(p);
            }

            container.querySelectorAll(".room-box").forEach(box => setupBoxInteractions(box));
            recordState(true);

            // Drag / Resize logic (re-use your existing handlers)
            let dragBox = null, offsetX = 0, offsetY = 0;
            let resizeBox = null, startW = 0, startH = 0, startDX = 0, startDY = 0;

            function startDrag(evt) {
                if (evt.target.classList.contains("resize-handle")) {
                    resizeBox = evt.target.parentElement;
                    startW = parseInt(window.getComputedStyle(resizeBox).width);
                    startH = parseInt(window.getComputedStyle(resizeBox).height);
                    startDX = evt.clientX;
                    startDY = evt.clientY;
                    document.addEventListener("mousemove", onResize);
                    document.addEventListener("mouseup", stopResize);
                } else {
                    dragBox = evt.currentTarget;
                    const rect = dragBox.getBoundingClientRect();
                    offsetX = (evt.clientX - rect.left) / scale;
                    offsetY = (evt.clientY - rect.top) / scale;
                    document.addEventListener("mousemove", onDrag);
                    document.addEventListener("mouseup", stopDrag);
                }
                evt.preventDefault();
                evt.stopPropagation();
            }

            function onDrag(evt) {
                if (!dragBox) return;
                const contRect = container.getBoundingClientRect();
                let x = (evt.clientX - contRect.left) / scale - offsetX;
                let y = (evt.clientY - contRect.top) / scale - offsetY;
                if (x < 0) x = 0;
                if (y < 0) y = 0;
                dragBox.style.left = x + "px";
                dragBox.style.top = y + "px";
            }

            function stopDrag(evt) {
                document.removeEventListener("mousemove", onDrag);
                document.removeEventListener("mouseup", stopDrag);
                let hadDrag = false;
                if (dragBox) {
                    hadDrag = true;
                }
                if (dragBox && chkSnap.checked) {
                    let x = parseInt(dragBox.style.left) || 0;
                    let y = parseInt(dragBox.style.top) || 0;
                    x = Math.round(x / gridSize) * gridSize;
                    y = Math.round(y / gridSize) * gridSize;
                    dragBox.style.left = x + "px";
                    dragBox.style.top = y + "px";
                }
                dragBox = null;
                if (hadDrag) {
                    recordState();
                }
            }

            function onResize(evt) {
                if (!resizeBox) return;
                let dx = (evt.clientX - startDX) / scale;
                let dy = (evt.clientY - startDY) / scale;
                let w = startW + dx;
                let h = startH + dy;
                if (w < gridSize) w = gridSize;
                if (h < gridSize) h = gridSize;
                resizeBox.style.width = w + "px";
                resizeBox.style.height = h + "px";
            }

            function stopResize(evt) {
                document.removeEventListener("mousemove", onResize);
                document.removeEventListener("mouseup", stopResize);
                let hadResize = false;
                if (resizeBox) {
                    hadResize = true;
                }
                if (resizeBox && chkSnap.checked) {
                    let w = parseInt(resizeBox.style.width) || resizeBox.offsetWidth;
                    let h = parseInt(resizeBox.style.height) || resizeBox.offsetHeight;
                    w = Math.round(w / gridSize) * gridSize;
                    h = Math.round(h / gridSize) * gridSize;
                    resizeBox.style.width = w + "px";
                    resizeBox.style.height = h + "px";
                }
                resizeBox = null;
                if (hadResize) {
                    recordState();
                }
            }

            document.getElementById("save-layout-btn").addEventListener("click", async () => {
                const boxes = container.querySelectorAll(".room-box");
                const layoutDtos = [];
                boxes.forEach(b => {
                    const ridValue = b.getAttribute("data-room-id");
                    const roomId = parseInt(ridValue ?? "", 10);
                    const fl = selectedFloor;
                    const x = parseInt(b.style.left) || 0;
                    const y = parseInt(b.style.top) || 0;
                    const w = parseInt(b.style.width) || b.offsetWidth;
                    const h = parseInt(b.style.height) || b.offsetHeight;
                    const label = b.getAttribute("data-room-label") ?? "";
                    const shapeType = b.getAttribute("data-shape-type") ?? "rectangle";
                    const shapeData = b.getAttribute("data-shape-data") ?? "";
                    layoutDtos.push({
                        propertyId: propertyId,
                        roomId: Number.isNaN(roomId) ? 0 : roomId,
                        floor: fl,
                        x,
                        y,
                        width: w,
                        height: h,
                        label: label,
                        shapeType: shapeType,
                        shapeData: shapeData
                    });
                });

                const payload = {
                    propertyId: propertyId,
                    floor: selectedFloor,
                    layouts: layoutDtos
                };

                const resp = await fetch('@Url.Action("SaveLayout", "Settings")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await resp.json();
                if (result.success) {
                    alert("Layout saved!");
                } else {
                    alert("Error saving layout");
                }
            });

        })();
    </script>
}
