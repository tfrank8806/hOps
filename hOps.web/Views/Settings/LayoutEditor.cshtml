@using System
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.Rendering
@model hOps.web.ViewModels.LayoutEditorViewModel

@{
    ViewData["Title"] = Html.Localize("Layout Editor");
    int propertyId = Model.PropertyId;
    string basePropertyName = string.IsNullOrWhiteSpace(Model.PropertyName)
        ? $"Property {propertyId}"
        : Model.PropertyName;
    string displayPropertyName = string.IsNullOrWhiteSpace(Model.PropertyName)
        ? string.Format(Html.Localize("Property {0}"), propertyId)
        : await Html.DisplayTranslatedTextAsync("Property", propertyId.ToString(), "Name", basePropertyName);
    int selFloor = Model.SelectedFloor;
    var floors = Model.AllFloors;
    var propertyOptions = Model.PropertyOptions ?? new List<SelectListItem>();
    var propertyOptionDisplays = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    foreach (var option in propertyOptions)
    {
        var optionValue = option.Value ?? string.Empty;
        var optionText = option.Text ?? string.Empty;
        var optionDisplay = await Html.DisplayTranslatedTextAsync("Property", optionValue, "Name", optionText);
        propertyOptionDisplays[optionValue] = optionDisplay;
    }

    var roomLabelMetadata = new Dictionary<int, (string Raw, string Display)>();
    foreach (var room in Model.Rooms)
    {
        var rawLabel = string.IsNullOrWhiteSpace(room.RoomNumber) ? $"Room {room.Id}" : room.RoomNumber;
        var displayLabel = await Html.DisplayTranslatedTextAsync("Room", room.Id.ToString(), "RoomNumber", rawLabel);
        roomLabelMetadata[room.Id] = (rawLabel, displayLabel);
    }

    var layoutsByFloorExport = new Dictionary<int, List<object>>();
    foreach (var kvp in Model.LayoutsByFloor)
    {
        var projectedLayouts = new List<object>();
        foreach (var layout in kvp.Value)
        {
            roomLabelMetadata.TryGetValue(layout.RoomId, out var layoutRoomMeta);
            var baseLayoutRoomLabel = string.IsNullOrWhiteSpace(layoutRoomMeta.Raw)
                ? Model.Rooms.FirstOrDefault(r => r.Id == layout.RoomId)?.RoomNumber ?? string.Empty
                : layoutRoomMeta.Raw;
            var normalizedShapeType = string.IsNullOrWhiteSpace(layout.ShapeType) ? "rectangle" : layout.ShapeType;
            var isConnectorLayout = string.Equals(normalizedShapeType, "connector", StringComparison.OrdinalIgnoreCase);
            var rawLayoutLabel = isConnectorLayout
                ? (!string.IsNullOrWhiteSpace(layout.Label) ? layout.Label : "||")
                : (!string.IsNullOrWhiteSpace(layout.Label)
                    ? layout.Label
                    : (!string.IsNullOrWhiteSpace(baseLayoutRoomLabel) ? baseLayoutRoomLabel : layout.RoomId.ToString()));
            var displayLayoutLabel = rawLayoutLabel;
            if (!isConnectorLayout)
            {
                var layoutEntityId = layout.Id > 0
                    ? layout.Id.ToString()
                    : $"{layout.PropertyId}-{layout.RoomId}-{layout.Floor}";
                displayLayoutLabel = await Html.DisplayTranslatedTextAsync("LayoutRoomLayout", layoutEntityId, "Label", rawLayoutLabel);
            }

            projectedLayouts.Add(new
            {
                layout.Id,
                layout.PropertyId,
                layout.RoomId,
                layout.Floor,
                layout.X,
                layout.Y,
                layout.Width,
                layout.Height,
                layout.Label,
                layout.ShapeType,
                layout.ShapeData,
                layout.TextRotation,
                DisplayLabel = displayLayoutLabel
            });
        }

        layoutsByFloorExport[kvp.Key] = projectedLayouts;
    }
}

<div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-xl-between gap-3 mb-3">
    <h2 class="h4 mb-0">@Html.Localize("Layout Editor")</h2>
    <div class="d-flex align-items-center gap-2">
        <label for="layoutPropertySelect" class="form-label mb-0">@Html.Localize("Property"):</label>
        <select id="layoutPropertySelect" class="form-select form-select-sm" style="width:auto; min-width:240px;">
            @foreach (var option in propertyOptions)
            {
                var optionValue = option.Value ?? string.Empty;
                var optionDisplay = propertyOptionDisplays.TryGetValue(optionValue, out var displayText)
                    ? displayText
                    : option.Text ?? string.Empty;
                <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@optionDisplay</option>
            }
        </select>
    </div>
    <div class="text-muted small">@string.Format(Html.Localize("{0} - Floor {1}"), displayPropertyName, selFloor)</div>
</div>

@section Styles {
    <style>
        .layout-editor-controls {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .layout-editor-controls .control-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .layout-editor-stage {
            display: flex;
            height: 650px;
            max-width: 100%;
            overflow: hidden;
        }

        .layout-editor-wrapper {
            position: relative;
            overflow: auto;
            border: 1px solid #333;
            flex: 1 1 auto;
            min-width: 0;
            background-color: #f7f7f7;
        }

        .layout-editor-palette {
            flex: 0 0 260px;
            max-width: 260px;
            border: 1px solid #ccc;
            padding: 10px;
            overflow-y: auto;
        }

        .palette-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .palette-grid .pal-shape {
            flex: 0 1 calc(50% - 0.75rem);
            max-width: calc(50% - 0.75rem);
            height: 56px;
            border: 1px solid #9ca3af;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: grab;
            background-color: #fff;
            margin: 0;
        }

        .pal-shape--connector {
            border-style: dashed;
            font-weight: 600;
        }

        .palette-grid .pal-shape--connector-horizontal,
        .palette-grid .pal-shape--connector-vertical {
            transform: none;
        }

        .layout-editor-wrapper {
            position: relative;
            overflow: auto;
            border: 1px solid #333;
            flex: 1 1 auto;
            min-width: 0;
        }

        #palette.is-collapsed {
            display: none;
        }

        .pal-shape--connector {
            background-color: #f8f9fa;
            border-style: dashed;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pal-shape--connector-horizontal {
            transform: rotate(90deg);
            transform-origin: center;
        }

        .room-box--connector {
            background-color: transparent !important;
            border: 1px dashed #6c757d !important;
        }

        .room-box--connector .room-label {
            font-weight: 700;
            letter-spacing: 0.08rem;
            pointer-events: none;
            line-height: 1;
            font-size: clamp(0.75rem, 0.9vw, 1.2rem);
        }

        .room-box .room-label {
            display: inline-block;
            width: 90%;
            text-align: center;
            line-height: 1.2;
            word-break: break-word;
            transform: rotate(var(--text-rotation, 0deg));
            transform-origin: center;
            font-size: clamp(0.65rem, 0.8vw, 1rem);
        }

        .room-box--connector[data-connector-direction="horizontal"] .room-label {
            transform: rotate(calc(var(--text-rotation, 0deg) + 90deg));
        }

        .room-box .box-controls {
            position: absolute;
            right: 0;
            bottom: 100%;
            display: flex;
            opacity: 0;
            margin-bottom: 4px;
            gap: 4px;
            padding: 2px;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid #333;
            border-radius: 4px;
            transition: opacity 0.2s;
            pointer-events: none;
            z-index: 5;
        }

        .room-box:hover .box-controls,
        .room-box:focus-within .box-controls {
            opacity: 1;
            pointer-events: auto;
        }

        .room-box .box-controls:hover {
            opacity: 1;
            pointer-events: auto;
        }

        .room-box .box-controls button {
            padding: 2px 6px;
            font-size: 0.8em;
        }

        .text-rotation-select {
            width: 5.5rem;
        }

        .shape-dialog-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.35);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
        }

        .shape-dialog {
            background: #ffffff;
            border-radius: 8px;
            padding: 1.5rem;
            width: 320px;
            max-width: 90vw;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        }

        .shape-dialog h5 {
            margin-bottom: 1rem;
        }
    </style>
}

@if (floors != null && floors.Count > 1)
{
    <div class="mb-3 d-flex align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2">
        <label for="floorSelect" class="mb-0">@Html.Localize("Floor"):</label>
            <select id="floorSelect" class="form-select form-select-sm" style="width:auto;">
                @foreach (var f in floors)
                {
                    var url = Url.Action("LayoutEditor", "Settings", new { propertyId, floor = f });
                    if (f == selFloor)
                    {
                        <option selected value="@url">@string.Format(Html.Localize("Floor {0}"), f)</option>
                    }
                    else
                    {
                        <option value="@url">@string.Format(Html.Localize("Floor {0}"), f)</option>
                    }
                }
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label for="ghostFloorSelect" class="mb-0">@Html.Localize("Ghost overlay"):</label>
            <select id="ghostFloorSelect" class="form-select form-select-sm" style="width:auto;">
                <option value="">@Html.Localize("None")</option>
                @foreach (var f in floors)
                {
                    if (f == selFloor)
                    {
                        continue;
                    }
                    <option value="@f">@string.Format(Html.Localize("Floor {0}"), f)</option>
                }
            </select>
        </div>
        <button id="btnAddFloor" class="btn btn-sm btn-outline-primary">+ @Html.Localize("Add Floor")</button>
    </div>
}

<div class="layout-editor-controls mb-3">
    <div class="control-group form-check mb-0">
        <input class="form-check-input" type="checkbox" id="chkSnap" />
        <label class="form-check-label" for="chkSnap">@Html.Localize("Snap to grid")</label>
    </div>
    <div class="control-group">
        <button id="zoomInBtn" class="btn btn-sm btn-outline-secondary" type="button" aria-label="@Html.Localize("Zoom in")">+</button>
        <button id="zoomOutBtn" class="btn btn-sm btn-outline-secondary" type="button" aria-label="@Html.Localize("Zoom out")">-</button>
    </div>
    <div class="control-group">
        <button id="togglePaletteBtn" class="btn btn-sm btn-outline-secondary" type="button" aria-controls="palette" aria-expanded="true">@Html.Localize("Hide Palette")</button>
    </div>
    <div class="control-group">
        <button id="undoBtn" class="btn btn-sm btn-outline-secondary" type="button" disabled>@Html.Localize("Undo")</button>
        <button id="redoBtn" class="btn btn-sm btn-outline-secondary" type="button" disabled>@Html.Localize("Redo")</button>
    </div>
    <div class="ms-auto">
        <button id="save-layout-btn" class="btn btn-primary">@Html.Localize("Save Layout")</button>
    </div>
</div>

<div class="layout-editor-stage">
    <!-- Palette sidebar -->
    <div id="palette" class="layout-editor-palette">
        <h4 class="mb-3">@Html.Localize("Palette")</h4>
        <div class="palette-grid">
            <div class="pal-shape" data-room-id="0" data-room-label="@Html.Localize("Custom")" data-room-display-label="@Html.Localize("Custom")" draggable="true">
                @Html.Localize("Custom")
            </div>
            <div class="pal-shape pal-shape--connector pal-shape--connector-vertical" data-room-id="0" data-room-label="||" data-room-display-label="||" data-shape-type="connector" data-shape-data="vertical" data-multi-use="true" draggable="true" title="@Html.Localize("Connecting rooms (vertical)")" aria-label="@Html.Localize("Connecting rooms (vertical)")">
                ||
            </div>
            <div class="pal-shape pal-shape--connector pal-shape--connector-horizontal" data-room-id="0" data-room-label="||" data-room-display-label="||" data-shape-type="connector" data-shape-data="horizontal" data-multi-use="true" draggable="true" title="@Html.Localize("Connecting rooms (horizontal)")" aria-label="@Html.Localize("Connecting rooms (horizontal)")">
                ||
            </div>
            @foreach (var room in Model.Rooms.Where(r => r.Floor == selFloor))
            {
                roomLabelMetadata.TryGetValue(room.Id, out var labelInfo);
                var roomRawLabel = string.IsNullOrWhiteSpace(labelInfo.Raw)
                    ? (string.IsNullOrWhiteSpace(room.RoomNumber) ? $"Room {room.Id}" : room.RoomNumber)
                    : labelInfo.Raw;
                var roomDisplayLabel = string.IsNullOrWhiteSpace(labelInfo.Display) ? roomRawLabel : labelInfo.Display;
                <div class="pal-shape"
                     data-room-id="@room.Id"
                     data-room-label="@roomRawLabel"
                     data-room-display-label="@roomDisplayLabel"
                     draggable="true">
                    @roomDisplayLabel
                </div>
            }
        </div>
    </div>

    <!-- Editor container wrapper for pan/zoom -->
    <div id="editor-wrapper" class="layout-editor-wrapper">
        <div id="editor-container" style="
            position: relative;
            min-width: 1024px;
            min-height: 860px;
            width: 100%;
            height: 100%;
            background-image:
                linear-gradient(to right, #ddd 1px, transparent 1px),
                linear-gradient(to bottom, #ddd 1px, transparent 1px);
            background-size:50px 50px;
            transform-origin: 0 0;
        ">
            <div id="ghost-layer" style="position:absolute; inset:0; pointer-events:none; z-index:0;"></div>
            @foreach (var layout in Model.Layouts)
            {
                roomLabelMetadata.TryGetValue(layout.RoomId, out var layoutRoomLabelInfo);
                var baseRoomLabel = string.IsNullOrWhiteSpace(layoutRoomLabelInfo.Raw)
                    ? Model.Rooms.FirstOrDefault(r => r.Id == layout.RoomId)?.RoomNumber
                    : layoutRoomLabelInfo.Raw;
                var shapeType = string.IsNullOrWhiteSpace(layout.ShapeType) ? "rectangle" : layout.ShapeType;
                var shapeData = layout.ShapeData ?? string.Empty;
                var isConnector = string.Equals(shapeType, "connector", StringComparison.OrdinalIgnoreCase);
                var rawLabel = isConnector
                    ? (!string.IsNullOrWhiteSpace(layout.Label) ? layout.Label : "||")
                    : (!string.IsNullOrWhiteSpace(layout.Label) ? layout.Label : (!string.IsNullOrWhiteSpace(baseRoomLabel) ? baseRoomLabel : layout.RoomId.ToString()));
                var displayLabel = rawLabel;
                if (!isConnector)
                {
                    var layoutEntityId = layout.Id > 0
                        ? layout.Id.ToString()
                        : $"{layout.PropertyId}-{layout.RoomId}-{layout.Floor}";
                    displayLabel = await Html.DisplayTranslatedTextAsync("LayoutRoomLayout", layoutEntityId, "Label", rawLabel);
                }
                var clipStyle = string.IsNullOrWhiteSpace(shapeData) ? string.Empty : $"clip-path:{shapeData}; -webkit-clip-path:{shapeData};";
                var textRotation = layout.TextRotation;
                <div class="room-box @(isConnector ? "room-box--connector" : string.Empty)"
                     data-layout-id="@layout.Id"
                     data-room-id="@layout.RoomId"
                     data-room-label="@rawLabel"
                     data-room-display-label="@displayLabel"
                     data-shape-type="@shapeType"
                     data-shape-data="@shapeData"
                     data-text-rotation="@textRotation"
                     style="
                             position:absolute;
                             left:@($"{layout.X}px");
                             top:@($"{layout.Y}px");
                             width:@($"{layout.Width}px");
                             height:@($"{layout.Height}px");
                             border:1px solid #333;
                             background-color:#cce5ff;
                             z-index:1;
                             display:flex; align-items:center; justify-content:center;
                             cursor:move; @clipStyle
                             --text-rotation:@($"{textRotation}deg");
                         ">
                    <span class="room-label">@displayLabel</span>
                    <div class="box-controls">
                        <button class="btn btn-sm btn-light btn-customize-shape" title="@Html.Localize("Customize Shape")" aria-label="@Html.Localize("Customize Shape")">@Html.Localize("Shape")</button>
                        <button class="btn btn-sm btn-light btn-move-back" title="@Html.Localize("Move back to palette")" aria-label="@Html.Localize("Move back to palette")">@Html.Localize("Back")</button>
                        <select class="form-select form-select-sm text-rotation-select" title="@Html.Localize("Rotate text")" aria-label="@Html.Localize("Rotate text")">
                            <option value="0" selected>0&deg;</option>
                            <option value="45">45&deg;</option>
                            <option value="90">90&deg;</option>
                            <option value="135">135&deg;</option>
                            <option value="180">180&deg;</option>
                            <option value="225">225&deg;</option>
                            <option value="270">270&deg;</option>
                            <option value="315">315&deg;</option>
                        </select>
                        <button class="btn btn-sm btn-light btn-delete-shape" title="@Html.Localize("Delete shape")" aria-label="@Html.Localize("Delete shape")">@Html.Localize("Delete")</button>
                    </div>
                    <div class="resize-handle" style="
                            position:absolute; right:0; bottom:0;
                            width:12px; height:12px; background:#333; cursor:se-resize;
                            opacity:0.5;
                        "></div>
                </div>
            }
        </div>
    </div>
</div>

<div id="shapeDialogOverlay" class="shape-dialog-overlay">
    <div class="shape-dialog">
        <h5>@Html.Localize("Customize Shape")</h5>
        <div class="mb-3">
            <label for="shapePresetSelect" class="form-label">@Html.Localize("Preset")</label>
            <select id="shapePresetSelect" class="form-select form-select-sm">
                <option value="rectangle">@Html.Localize("Rectangle")</option>
                <option value="l-top-left">@Html.Localize("L - Top Left")</option>
                <option value="l-top-right">@Html.Localize("L - Top Right")</option>
                <option value="l-bottom-left">@Html.Localize("L - Bottom Left")</option>
                <option value="l-bottom-right">@Html.Localize("L - Bottom Right")</option>
                <option value="custom">@Html.Localize("Custom (clip-path)")</option>
            </select>
        </div>
        <div class="mb-3">
            <label for="shapeClipPathInput" class="form-label">@Html.Localize("CSS clip-path")</label>
            <textarea id="shapeClipPathInput" class="form-control" rows="3"
                      placeholder="@Html.Localize("LayoutEditor.ClipPathPlaceholder")"></textarea>
            <small class="text-muted">@Html.Localize("Use CSS clip-path syntax to define advanced shapes.")</small>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" id="shapeDialogCancel">@Html.Localize("Cancel")</button>
            <button type="button" class="btn btn-primary" id="shapeDialogApply">@Html.Localize("Apply")</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const translate = typeof window.hopsTranslate === "function"
                ? window.hopsTranslate
                : (key, fallback) => (typeof fallback === "string" && fallback.length > 0 ? fallback : key);

            const propertySelect = document.getElementById("layoutPropertySelect");
            if (propertySelect) {
                propertySelect.addEventListener("change", function () {
                    if (this.value) {
                        window.location.href = this.value;
                    }
                });
            }

            const propertyId = @Model.PropertyId;
            const selectedFloor = @Model.SelectedFloor;
            const existingFloors = @Html.Raw(JsonSerializer.Serialize(Model.AllFloors ?? Enumerable.Empty<int>()));
            const baseLayoutUrl = '@Url.Action("LayoutEditor", "Settings")';
            const layoutsByFloorRaw = @Html.Raw(JsonSerializer.Serialize(layoutsByFloorExport));
            const roomLabelsRaw = @Html.Raw(JsonSerializer.Serialize(roomLabelMetadata.ToDictionary(kvp => kvp.Key, kvp => kvp.Value.Raw)));
            const roomLabelDisplaysRaw = @Html.Raw(JsonSerializer.Serialize(roomLabelMetadata.ToDictionary(kvp => kvp.Key, kvp => string.IsNullOrWhiteSpace(kvp.Value.Display) ? kvp.Value.Raw : kvp.Value.Display)));
            const gridSize = 50;
            let scale = 1.0;
            const scaleStep = 0.1;
            const minScale = 0.5;
            const maxScale = 2.5;
            const hidePaletteText = translate("LayoutEditor.HidePalette", "Hide Palette");
            const showPaletteText = translate("LayoutEditor.ShowPalette", "Show Palette");
            const addFloorPromptText = translate("LayoutEditor.AddFloorPrompt", "Enter the floor number to add:");
            const invalidFloorNumberText = translate("LayoutEditor.InvalidFloorNumber", "Please enter a valid number for the floor.");
            const floorExistsTemplate = translate("LayoutEditor.FloorExists", "Floor {0} already exists.");
            const unableToAddFloorText = translate("LayoutEditor.UnableToAddFloor", "Unable to add the floor.");
            const unexpectedAddFloorText = translate("LayoutEditor.AddFloorUnexpectedError", "An unexpected error occurred while adding the floor.");
            const clipPathRequiredText = translate("LayoutEditor.ClipPathRequired", "Please provide a clip-path definition for the custom shape.");
            const layoutSavedText = translate("LayoutEditor.LayoutSaved", "Layout saved!");
            const saveErrorGenericText = translate("LayoutEditor.SaveErrorGeneric", "Error saving layout");
            const savingText = translate("Saving...", "Saving...");
            const saveLayoutText = translate("Save Layout", "Save Layout");
            const newLabelPromptText = translate("LayoutEditor.NewLabelPrompt", "Enter new label:");
            const saveFailedWithStatusTemplate = translate("LayoutEditor.SaveFailedWithStatus", "Save failed ({0}): {1}");
            const saveFailedUnexpectedText = translate("LayoutEditor.SaveFailedUnexpected", "Save failed (unexpected response).");
            const customizeShapeText = translate("Customize Shape", "Customize Shape");
            const shapeButtonLabel = translate("Shape", "Shape");
            const moveBackToPaletteText = translate("LayoutEditor.MoveBackToPalette", "Move back to palette");
            const backButtonLabel = translate("Back", "Back");
            const rotateTextLabel = translate("LayoutEditor.RotateText", "Rotate text");
            const deleteShapeText = translate("LayoutEditor.DeleteShape", "Delete shape");
            const deleteButtonLabel = translate("Delete", "Delete");
            const rotationDegreesTemplate = translate("LayoutEditor.RotationDegrees", "{0}°");

            const wrapper = document.getElementById("editor-wrapper");
            const container = document.getElementById("editor-container");
            const chkSnap = document.getElementById("chkSnap");
            const floorSelect = document.getElementById("floorSelect");
            const addFloorBtn = document.getElementById("btnAddFloor");
            const ghostFloorSelect = document.getElementById("ghostFloorSelect");
            const ghostLayer = document.getElementById("ghost-layer");
            const palette = document.getElementById("palette");
            const undoBtn = document.getElementById("undoBtn");
            const redoBtn = document.getElementById("redoBtn");
            const shapeDialogOverlay = document.getElementById("shapeDialogOverlay");
            const shapePresetSelect = document.getElementById("shapePresetSelect");
            const shapeClipPathInput = document.getElementById("shapeClipPathInput");
            const shapeDialogApply = document.getElementById("shapeDialogApply");
            const shapeDialogCancel = document.getElementById("shapeDialogCancel");

            const shapePresets = new Map([
                ["rectangle", ""],
                ["l-top-left", "polygon(0% 0%, 100% 0%, 100% 30%, 35% 30%, 35% 100%, 0% 100%)"],
                ["l-top-right", "polygon(0% 0%, 100% 0%, 100% 100%, 65% 100%, 65% 30%, 0% 30%, 0% 0%)"],
                ["l-bottom-left", "polygon(0% 0%, 35% 0%, 35% 70%, 100% 70%, 100% 100%, 0% 100%)"],
                ["l-bottom-right", "polygon(65% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 70%, 65% 70%)"]
            ]);
            const rotationStep = 45;

            function normalizeRotation(value) {
                const numeric = Number.isFinite(value) ? value : 0;
                let normalized = Math.round(numeric / rotationStep) * rotationStep;
                normalized %= 360;
                if (normalized < 0) {
                    normalized += 360;
                }
                return normalized;
            }

            function defaultRotationForShape(shapeType, shapeData) {
                return 0;
            }

            function setTextRotation(element, rotation) {
                if (!(element instanceof HTMLElement)) {
                    return 0;
                }
                const normalized = normalizeRotation(rotation);
                element.setAttribute("data-text-rotation", String(normalized));
                element.style.setProperty("--text-rotation", `${normalized}deg`);
                return normalized;
            }

            function getTextRotation(element) {
                if (!(element instanceof HTMLElement)) {
                    return 0;
                }
                const raw = element.getAttribute("data-text-rotation");
                const parsed = parseInt(raw ?? "0", 10);
                if (Number.isFinite(parsed)) {
                    return normalizeRotation(parsed);
                }
                return 0;
            }

            const initialPaletteRooms = new Map();
            const initialPaletteDisplayLabels = new Map();
            const paletteRoomLabels = new Map();
            const paletteRoomDisplayLabels = new Map();
            const togglePaletteBtn = document.getElementById("togglePaletteBtn");
            let currentDragPayload = null;

            function updatePaletteToggleUi() {
                if (!togglePaletteBtn || !palette) {
                    return;
                }
                const collapsed = palette.classList.contains("is-collapsed");
                const buttonLabel = collapsed ? showPaletteText : hidePaletteText;
                togglePaletteBtn.textContent = buttonLabel;
                togglePaletteBtn.setAttribute("aria-expanded", collapsed ? "false" : "true");
                togglePaletteBtn.setAttribute("aria-label", buttonLabel);
                palette.setAttribute("aria-hidden", collapsed ? "true" : "false");
            }

            if (togglePaletteBtn && palette) {
                togglePaletteBtn.addEventListener("click", () => {
                    palette.classList.toggle("is-collapsed");
                    updatePaletteToggleUi();
                });
                updatePaletteToggleUi();
            }

            if (palette) {
                palette.querySelectorAll(".pal-shape").forEach(tile => {
                    const rid = tile.getAttribute("data-room-id");
                    const rawLabel = tile.getAttribute("data-room-label") ?? tile.textContent ?? "";
                    const displayLabel = tile.getAttribute("data-room-display-label") ?? tile.textContent ?? rawLabel;
                    if (!rid) {
                        return;
                    }
                    const trimmedLabel = rawLabel.trim();
                    const trimmedDisplayLabel = displayLabel.trim().length > 0 ? displayLabel.trim() : trimmedLabel;
                    tile.setAttribute("data-room-label", trimmedLabel);
                    tile.setAttribute("data-room-display-label", trimmedDisplayLabel);
                    paletteRoomLabels.set(rid, trimmedLabel);
                    paletteRoomDisplayLabels.set(rid, trimmedDisplayLabel);
                    if (rid !== "0") {
                        initialPaletteRooms.set(rid, trimmedLabel);
                        initialPaletteDisplayLabels.set(rid, trimmedDisplayLabel);
                    }
                });
                palette.querySelectorAll(".pal-shape").forEach(attachPaletteDragHandlers);
            }

            function attachPaletteDragHandlers(tile) {
                if (!(tile instanceof HTMLElement) || tile.dataset.dragBound === "true") {
                    return;
                }

                tile.dataset.dragBound = "true";
                tile.addEventListener("dragstart", e => {
                    const payload = {
                        roomId: tile.getAttribute("data-room-id") ?? "0",
                        label: tile.getAttribute("data-room-label") ?? "",
                        displayLabel: tile.getAttribute("data-room-display-label") ?? tile.textContent ?? "",
                        shapeType: tile.getAttribute("data-shape-type") ?? "",
                        shapeData: tile.getAttribute("data-shape-data") ?? "",
                        multiUse: tile.getAttribute("data-multi-use") === "true"
                    };
                    currentDragPayload = payload;
                    const jsonPayload = JSON.stringify(payload);
                    try {
                        e.dataTransfer.setData("application/json", jsonPayload);
                    } catch {
                        // Some browsers may not allow custom types; ignore.
                    }
                    e.dataTransfer.setData("text/plain", jsonPayload);
                });

                tile.addEventListener("dragend", () => {
                    currentDragPayload = null;
                });
            }

            const undoStack = [];
            let redoStack = [];
            let isApplyingState = false;
            let shapeDialogTarget = null;

            const layoutsByFloor = new Map();
            if (layoutsByFloorRaw && typeof layoutsByFloorRaw === 'object') {
                Object.entries(layoutsByFloorRaw).forEach(([key, value]) => {
                    const floorNumber = parseInt(key, 10);
                    if (!Number.isNaN(floorNumber)) {
                        layoutsByFloor.set(floorNumber, Array.isArray(value) ? value : []);
                    }
                });
            }

            const roomLabelLookup = (roomLabelsRaw && typeof roomLabelsRaw === 'object') ? roomLabelsRaw : {};
            const roomLabelDisplayLookup = (roomLabelDisplaysRaw && typeof roomLabelDisplaysRaw === 'object') ? roomLabelDisplaysRaw : {};
            const ghostStorageKey = `layoutGhostFloor_${propertyId}`;

            if (ghostFloorSelect && ghostLayer) {
                const storedGhost = localStorage.getItem(ghostStorageKey);
                if (storedGhost && storedGhost !== selectedFloor.toString() && ghostFloorSelect.querySelector(`option[value="${storedGhost}"]`)) {
                    ghostFloorSelect.value = storedGhost;
                    renderGhostFloor(parseInt(storedGhost, 10));
                } else {
                    renderGhostFloor(null);
                }

                ghostFloorSelect.addEventListener("change", () => {
                    const value = ghostFloorSelect.value;
                    if (value) {
                        localStorage.setItem(ghostStorageKey, value);
                        renderGhostFloor(parseInt(value, 10));
                    } else {
                        localStorage.removeItem(ghostStorageKey);
                        renderGhostFloor(null);
                    }
                });
            } else if (ghostLayer) {
                renderGhostFloor(null);
            }

            if (floorSelect) {
                floorSelect.addEventListener("change", e => {
                    const target = e.target;
                    if (!(target instanceof HTMLSelectElement)) return;
                    const url = target.value;
                    if (url) {
                        window.location.href = url;
                    }
                });
            }

            if (addFloorBtn) {
                addFloorBtn.addEventListener("click", async () => {
                    const currentFloors = Array.isArray(existingFloors) ? existingFloors : [];
                    const suggestedFloor = currentFloors.length ? Math.max(...currentFloors) + 1 : selectedFloor + 1;
                    const response = prompt(addFloorPromptText, suggestedFloor.toString());
                    if (response === null) {
                        return;
                    }
                    const floorNumber = parseInt(response, 10);
                    if (Number.isNaN(floorNumber)) {
                        alert(invalidFloorNumberText);
                        return;
                    }
                    if (currentFloors.includes(floorNumber)) {
                        alert(floorExistsTemplate.replace("{0}", String(floorNumber)));
                        return;
                    }

                    try {
                        const result = await fetch('@Url.Action("AddFloor", "Settings")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ propertyId, floor: floorNumber })
                        });

                        if (!result.ok) {
                            alert(unableToAddFloorText);
                            return;
                        }

                        window.location.href = `${baseLayoutUrl}?propertyId=${propertyId}&floor=${floorNumber}`;
                    } catch {
                        alert(unexpectedAddFloorText);
                    }
                });
            }

            chkSnap.checked = localStorage.getItem("layoutSnap") === "true";
            toggleGrid();
            chkSnap.addEventListener("change", () => {
                localStorage.setItem("layoutSnap", chkSnap.checked);
                toggleGrid();
            });

            function toggleGrid() {
                if (chkSnap.checked) {
                    container.style.backgroundImage =
                        "linear-gradient(to right, #ddd 1px, transparent 1px), " +
                        "linear-gradient(to bottom, #ddd 1px, transparent 1px)";
                } else {
                    container.style.backgroundImage = "none";
                }
            }

            function applyShapeToElement(element, shapeType, shapeData) {
                if (!(element instanceof HTMLElement)) {
                    return;
                }
                const normalizedType = (typeof shapeType === "string" && shapeType.trim().length > 0)
                    ? shapeType.trim()
                    : "rectangle";
                const normalizedData = (typeof shapeData === "string" && shapeData.trim().length > 0)
                    ? shapeData.trim()
                    : "";

                element.setAttribute("data-shape-type", normalizedType);
                element.setAttribute("data-shape-data", normalizedData);

                const isConnector = normalizedType.toLowerCase() === "connector";

                if (!isConnector && normalizedData.length > 0) {
                    element.style.clipPath = normalizedData;
                    element.style.webkitClipPath = normalizedData;
                } else {
                    element.style.removeProperty("clip-path");
                    element.style.removeProperty("-webkit-clip-path");
                }
                element.classList.toggle("room-box--connector", isConnector);
                if (isConnector) {
                    const direction = normalizedData.length > 0 ? normalizedData.toLowerCase() : "vertical";
                    element.setAttribute("data-connector-direction", direction);

                    const connectorSymbol = "||";
                    const existingLabel = (element.getAttribute("data-room-label") ?? "").trim();
                    if (existingLabel.length === 0) {
                        element.setAttribute("data-room-label", connectorSymbol);
                        element.setAttribute("data-room-display-label", connectorSymbol);
                    }

                    const labelSpan = element.querySelector(".room-label");
                    if (labelSpan) {
                        const currentText = (labelSpan.textContent ?? "").trim();
                        if (currentText.length === 0) {
                            labelSpan.textContent = connectorSymbol;
                        }
                    }
                } else {
                    element.removeAttribute("data-connector-direction");
                }
            }

            function syncPaletteFromState(state) {
                if (!palette) {
                    return;
                }

                const placedRoomIds = new Set();
                state.forEach(entry => {
                    const rid = entry && typeof entry.roomId !== "undefined" ? String(entry.roomId) : "";
                    if (!rid || rid === "0") {
                        return;
                    }
                    placedRoomIds.add(rid);
                    if (entry.label && entry.label.trim().length > 0) {
                        const trimmed = entry.label.trim();
                        paletteRoomLabels.set(rid, trimmed);
                        const displayCandidate = roomLabelLookup && roomLabelLookup[rid] && roomLabelDisplayLookup && roomLabelDisplayLookup[rid] && trimmed === roomLabelLookup[rid]
                            ? roomLabelDisplayLookup[rid]
                            : trimmed;
                        paletteRoomDisplayLabels.set(rid, displayCandidate);
                    }
                });

                palette.querySelectorAll(".pal-shape").forEach(tile => {
                    const rid = tile.getAttribute("data-room-id");
                    if (rid && rid !== "0") {
                        tile.remove();
                    }
                });

                initialPaletteRooms.forEach((_, rid) => {
                    if (placedRoomIds.has(rid)) {
                        return;
                    }
                    const rawLabel = paletteRoomLabels.get(rid)
                        ?? initialPaletteRooms.get(rid)
                        ?? (roomLabelLookup && roomLabelLookup[rid] ? roomLabelLookup[rid] : `Room ${rid}`);
                    const displayLabel = paletteRoomDisplayLabels.get(rid)
                        ?? initialPaletteDisplayLabels.get(rid)
                        ?? (roomLabelDisplayLookup && roomLabelDisplayLookup[rid] ? roomLabelDisplayLookup[rid] : rawLabel);
                    moveBackToPalette(rid, rawLabel, displayLabel);
                });
            }

            function captureLayoutState() {
                const boxes = Array.from(container.querySelectorAll(".room-box"));
                const state = boxes.map(b => {
                    const ridValue = b.getAttribute("data-room-id");
                    const roomId = parseInt(ridValue ?? "0", 10) || 0;
                    const layoutIdValue = b.getAttribute("data-layout-id");
                    const layoutId = parseInt(layoutIdValue ?? "0", 10) || 0;
                    const label = b.getAttribute("data-room-label") ?? "";
                    const x = parseInt(b.style.left) || 0;
                    const y = parseInt(b.style.top) || 0;
                    const width = parseInt(b.style.width) || b.offsetWidth;
                    const height = parseInt(b.style.height) || b.offsetHeight;
                    const shapeType = b.getAttribute("data-shape-type") ?? "rectangle";
                    const shapeData = b.getAttribute("data-shape-data") ?? "";
                    const textRotation = getTextRotation(b);
                    return { layoutId, roomId, label, x, y, width, height, shapeType, shapeData, textRotation };
                });

                state.sort((a, b) => {
                    if (a.roomId !== b.roomId) {
                        return a.roomId - b.roomId;
                    }
                    if (a.layoutId !== b.layoutId) {
                        return a.layoutId - b.layoutId;
                    }
                    if (a.x !== b.x) {
                        return a.x - b.x;
                    }
                    return a.y - b.y;
                });

                return state;
            }

            function serializeState(state) {
                return JSON.stringify(state.map(entry => [
                    entry.layoutId,
                    entry.roomId,
                    entry.label,
                    entry.x,
                    entry.y,
                    entry.width,
                    entry.height,
                    entry.shapeType,
                    entry.shapeData,
                    entry.textRotation
                ]));
            }

            function restoreLayoutState(state) {
                if (!Array.isArray(state)) {
                    return;
                }
                isApplyingState = true;
                container.querySelectorAll(".room-box").forEach(box => box.remove());
                state.forEach(entry => {
                    addBox(
                        String(entry.roomId),
                        entry.label ?? "",
                        entry.x ?? 0,
                        entry.y ?? 0,
                        {
                            layoutId: entry.layoutId ?? 0,
                            width: entry.width ?? gridSize,
                            height: entry.height ?? gridSize,
                            shapeType: entry.shapeType ?? "rectangle",
                            shapeData: entry.shapeData ?? "",
                            textRotation: entry.textRotation ?? 0,
                            skipRecord: true
                        }
                    );
                });
                isApplyingState = false;
                syncPaletteFromState(state);
                updateUndoRedoButtons();
            }

            function recordState(force = false) {
                if (isApplyingState) {
                    return;
                }
                const state = captureLayoutState();
                const serialized = serializeState(state);
                if (!force && undoStack.length > 0) {
                    const last = undoStack[undoStack.length - 1];
                    if (last.serialized === serialized) {
                        syncPaletteFromState(state);
                        return;
                    }
                }
                undoStack.push({ state: JSON.parse(JSON.stringify(state)), serialized });
                if (undoStack.length > 100) {
                    undoStack.shift();
                }
                redoStack = [];
                syncPaletteFromState(state);
                updateUndoRedoButtons();
            }

            function updateUndoRedoButtons() {
                if (undoBtn) {
                    undoBtn.disabled = undoStack.length <= 1;
                }
                if (redoBtn) {
                    redoBtn.disabled = redoStack.length === 0;
                }
            }

            function undo() {
                if (undoStack.length <= 1) {
                    return;
                }
                const current = undoStack.pop();
                redoStack.push(current);
                const previous = undoStack[undoStack.length - 1];
                restoreLayoutState(previous.state);
            }

            function redo() {
                if (redoStack.length === 0) {
                    return;
                }
                const next = redoStack.pop();
                undoStack.push({ state: JSON.parse(JSON.stringify(next.state)), serialized: next.serialized });
                restoreLayoutState(next.state);
            }

            function updateShapeDialogInputs(selectedType, providedData) {
                if (!shapePresetSelect || !shapeClipPathInput) {
                    return;
                }
                const normalizedType = shapePresets.has(selectedType) || selectedType === "custom"
                    ? selectedType
                    : "custom";
                shapePresetSelect.value = normalizedType;
                if (normalizedType === "custom") {
                    shapeClipPathInput.disabled = false;
                    shapeClipPathInput.value = providedData ?? "";
                } else {
                    const presetValue = shapePresets.get(normalizedType) ?? "";
                    shapeClipPathInput.disabled = true;
                    shapeClipPathInput.value = presetValue;
                }
            }

            function openShapeDialog(target) {
                if (!shapeDialogOverlay || !shapePresetSelect || !shapeClipPathInput) {
                    return;
                }
                shapeDialogTarget = target instanceof HTMLElement ? target : null;
                if (!shapeDialogTarget) {
                    return;
                }
                const currentType = shapeDialogTarget.getAttribute("data-shape-type") ?? "rectangle";
                const currentData = shapeDialogTarget.getAttribute("data-shape-data") ?? "";
                if (shapePresets.has(currentType) || currentType === "custom") {
                    updateShapeDialogInputs(currentType, currentData);
                } else {
                    updateShapeDialogInputs("custom", currentData);
                }
                shapeDialogOverlay.style.display = "flex";
                if (!shapeClipPathInput.disabled) {
                    shapeClipPathInput.focus();
                    shapeClipPathInput.select();
                } else if (shapePresetSelect) {
                    shapePresetSelect.focus();
                }
            }

            function closeShapeDialog() {
                if (!shapeDialogOverlay) {
                    return;
                }
                shapeDialogOverlay.style.display = "none";
                shapeDialogTarget = null;
            }

            function resolveLayoutLabel(layout) {
                if (!layout) {
                    return "";
                }
                if (typeof layout.DisplayLabel === "string" && layout.DisplayLabel.trim().length > 0) {
                    return layout.DisplayLabel;
                }
                if (typeof layout.Label === "string" && layout.Label.trim().length > 0) {
                    return layout.Label;
                }
                const roomId = layout.RoomId;
                if (roomId === undefined || roomId === null) {
                    return "";
                }
                const key = String(roomId);
                if (Object.prototype.hasOwnProperty.call(roomLabelDisplayLookup, key)) {
                    const display = roomLabelDisplayLookup[key];
                    if (typeof display === "string" && display.trim().length > 0) {
                        return display;
                    }
                }
                if (Object.prototype.hasOwnProperty.call(roomLabelLookup, key)) {
                    const label = roomLabelLookup[key];
                    if (typeof label === "string" && label.trim().length > 0) {
                        return label;
                    }
                }
                return String(roomId);
            }

            function renderGhostFloor(floorNumber) {
                if (!ghostLayer) {
                    return;
                }
                ghostLayer.innerHTML = "";
                if (typeof floorNumber !== "number" || Number.isNaN(floorNumber) || floorNumber === selectedFloor) {
                    ghostLayer.style.display = "none";
                    return;
                }

                const layouts = layoutsByFloor.get(floorNumber);
                if (!Array.isArray(layouts) || layouts.length === 0) {
                    ghostLayer.style.display = "none";
                    return;
                }

                ghostLayer.style.display = "block";
                layouts.forEach(layout => {
                    const ghostBox = document.createElement("div");
                    ghostBox.classList.add("ghost-room-box");
                    const left = typeof layout.X === "number" ? layout.X : parseInt(layout.X, 10) || 0;
                    const top = typeof layout.Y === "number" ? layout.Y : parseInt(layout.Y, 10) || 0;
                    const width = typeof layout.Width === "number" ? layout.Width : parseInt(layout.Width, 10) || gridSize;
                    const height = typeof layout.Height === "number" ? layout.Height : parseInt(layout.Height, 10) || gridSize;
                    ghostBox.style.position = "absolute";
                    ghostBox.style.left = `${left}px`;
                    ghostBox.style.top = `${top}px`;
                    ghostBox.style.width = `${width}px`;
                    ghostBox.style.height = `${height}px`;
                    ghostBox.style.border = "1px dashed #6c757d";
                    ghostBox.style.backgroundColor = "rgba(108, 117, 125, 0.25)";
                    ghostBox.style.color = "#495057";
                    ghostBox.style.display = "flex";
                    ghostBox.style.alignItems = "center";
                    ghostBox.style.justifyContent = "center";
                    ghostBox.style.fontSize = "0.8rem";
                    ghostBox.style.pointerEvents = "none";
                    ghostBox.style.zIndex = "0";
                    const ghostShapeData = typeof layout.ShapeData === "string" ? layout.ShapeData : "";
                    if (ghostShapeData && ghostShapeData.trim().length > 0) {
                        ghostBox.style.clipPath = ghostShapeData.trim();
                        ghostBox.style.webkitClipPath = ghostShapeData.trim();
                    }
                    ghostBox.textContent = resolveLayoutLabel(layout);
                    ghostLayer.appendChild(ghostBox);
                });
            }

            if (undoBtn) {
                undoBtn.addEventListener("click", evt => {
                    evt.preventDefault();
                    undo();
                });
            }

            if (redoBtn) {
                redoBtn.addEventListener("click", evt => {
                    evt.preventDefault();
                    redo();
                });
            }

            if (shapePresetSelect) {
                shapePresetSelect.addEventListener("change", () => {
                    const selected = shapePresetSelect.value;
                    const existing = selected === "custom"
                        ? (shapeDialogTarget?.getAttribute("data-shape-data") ?? shapeClipPathInput?.value ?? "")
                        : (shapePresets.get(selected) ?? "");
                    updateShapeDialogInputs(selected, existing);
                });
            }

            if (shapeDialogApply) {
                shapeDialogApply.addEventListener("click", evt => {
                    evt.preventDefault();
                    if (!shapeDialogTarget) {
                        closeShapeDialog();
                        return;
                    }
                    const selectedType = shapePresetSelect ? shapePresetSelect.value : "rectangle";
                    let clipPath = "";
                    if (selectedType === "custom") {
                        clipPath = shapeClipPathInput ? shapeClipPathInput.value.trim() : "";
                        if (clipPath.length === 0) {
                            alert(clipPathRequiredText);
                            return;
                        }
                    } else {
                        clipPath = shapePresets.get(selectedType) ?? "";
                    }
                    applyShapeToElement(shapeDialogTarget, selectedType, clipPath);
                    closeShapeDialog();
                    recordState();
                });
            }

            if (shapeDialogCancel) {
                shapeDialogCancel.addEventListener("click", evt => {
                    evt.preventDefault();
                    closeShapeDialog();
                });
            }

            if (shapeDialogOverlay) {
                shapeDialogOverlay.addEventListener("click", evt => {
                    if (evt.target === shapeDialogOverlay) {
                        closeShapeDialog();
                    }
                });
            }

            document.addEventListener("keydown", evt => {
                if (evt.key === "Escape" && shapeDialogOverlay && shapeDialogOverlay.style.display === "flex") {
                    closeShapeDialog();
                }
            });

            document.getElementById("zoomInBtn").addEventListener("click", () => {
                scale = Math.min(maxScale, scale + scaleStep);
                container.style.transform = `scale(${scale})`;
            });
            document.getElementById("zoomOutBtn").addEventListener("click", () => {
                scale = Math.max(minScale, scale - scaleStep);
                container.style.transform = `scale(${scale})`;
            });

            // Panning
            let isPanning = false, startX = 0, startY = 0, scrollLeft = 0, scrollTop = 0;
            wrapper.addEventListener("mousedown", e => {
                if (e.target === wrapper) {
                    isPanning = true;
                    startX = e.clientX;
                    startY = e.clientY;
                    scrollLeft = wrapper.scrollLeft;
                    scrollTop = wrapper.scrollTop;
                    wrapper.style.cursor = "grabbing";
                    e.preventDefault();
                }
            });
            wrapper.addEventListener("mousemove", e => {
                if (!isPanning) return;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                wrapper.scrollLeft = scrollLeft - dx;
                wrapper.scrollTop = scrollTop - dy;
            });
            wrapper.addEventListener("mouseup", () => {
                isPanning = false;
                wrapper.style.cursor = "default";
            });
            wrapper.addEventListener("mouseleave", () => {
                isPanning = false;
                wrapper.style.cursor = "default";
            });

            document.querySelectorAll(".pal-shape").forEach(attachPaletteDragHandlers);
            container.addEventListener("dragover", e => e.preventDefault());
            container.addEventListener("drop", e => {
                e.preventDefault();
                const rect = container.getBoundingClientRect();
                let x = (e.clientX - rect.left) / scale;
                let y = (e.clientY - rect.top) / scale;
                x -= gridSize / 2;
                y -= gridSize / 2;
                if (chkSnap.checked) {
                    x = Math.round(x / gridSize) * gridSize;
                    y = Math.round(y / gridSize) * gridSize;
                }
                let payload = currentDragPayload;
                const rawJson = e.dataTransfer.getData("application/json") || e.dataTransfer.getData("text/plain");
                if (!payload && rawJson) {
                    try {
                        payload = JSON.parse(rawJson);
                    } catch {
                        const parts = rawJson.split("|");
                        if (parts.length >= 2) {
                            payload = {
                                roomId: parts[0],
                                label: parts[1],
                                shapeType: parts[2] ?? "",
                                shapeData: parts[3] ?? "",
                                multiUse: parts[4] === "true",
                                displayLabel: parts[5] ?? parts[1]
                            };
                        }
                    }
                }
                if (!payload) {
                    return;
                }
                const rid = payload.roomId ?? "0";
                const label = payload.label ?? "";
                const options = {};
                if (payload.shapeType) {
                    options.shapeType = payload.shapeType;
                }
                if (payload.shapeData) {
                    options.shapeData = payload.shapeData;
                }
                if (payload.displayLabel) {
                    options.displayLabel = payload.displayLabel;
                }
                addBox(rid, label, x, y, options);

                const multiUse = payload.multiUse === true;
                if (palette && !multiUse && rid !== "0") {
                    palette.querySelectorAll(".pal-shape").forEach(p => {
                        const rid2 = p.getAttribute("data-room-id");
                        const tileMultiUse = p.getAttribute("data-multi-use") === "true";
                        if (rid2 === rid && !tileMultiUse) {
                            p.remove();
                        }
                    });
                }
                currentDragPayload = null;
            });

            function setupBoxInteractions(div) {
                if (!(div instanceof HTMLElement) || div.dataset.initialized === "true") {
                    return;
                }

                div.dataset.initialized = "true";

                applyShapeToElement(
                    div,
                    div.getAttribute("data-shape-type") ?? "rectangle",
                    div.getAttribute("data-shape-data") ?? ""
                );

                const normalizedRotation = setTextRotation(div, getTextRotation(div));
                const rotationSelect = div.querySelector(".text-rotation-select");
                if (rotationSelect) {
                    rotationSelect.value = String(normalizedRotation);
                    rotationSelect.addEventListener("change", evt => {
                        evt.stopPropagation();
                        const selectedValue = parseInt(rotationSelect.value, 10);
                        const normalized = setTextRotation(div, selectedValue);
                        rotationSelect.value = String(normalized);
                        recordState();
                    });
                }
                const isConnector = (div.getAttribute("data-shape-type") ?? "").toLowerCase() === "connector";

                const labelSpan = div.querySelector(".room-label");
                if (labelSpan) {
                    labelSpan.addEventListener("dblclick", e => {
                        const newLabel = prompt(newLabelPromptText, labelSpan.textContent ?? "");
                        if (newLabel !== null) {
                            const trimmed = newLabel.trim();
                            labelSpan.textContent = trimmed;
                            div.setAttribute("data-room-label", trimmed);
                            div.setAttribute("data-room-display-label", trimmed);
                            recordState();
                        }
                        e.stopPropagation();
                    });
                }

                const handleRemove = () => {
                    const roomId = div.getAttribute("data-room-id") ?? "0";
                    const currentLabel = div.getAttribute("data-room-label")
                        ?? (labelSpan ? labelSpan.textContent ?? "" : "");
                    const currentDisplayLabel = div.getAttribute("data-room-display-label")
                        ?? (labelSpan ? labelSpan.textContent ?? "" : currentLabel);
                    moveBackToPalette(roomId, currentLabel, currentDisplayLabel);
                    div.remove();
                    recordState();
                };

                const customizeBtn = div.querySelector(".btn-customize-shape");
                if (customizeBtn) {
                    if (isConnector) {
                        customizeBtn.classList.add("d-none");
                    } else {
                        customizeBtn.classList.remove("d-none");
                        customizeBtn.addEventListener("click", evt => {
                            evt.preventDefault();
                            evt.stopPropagation();
                            openShapeDialog(div);
                        });
                    }
                }

                const moveBackBtn = div.querySelector(".btn-move-back");
                if (moveBackBtn) {
                    moveBackBtn.addEventListener("click", evt => {
                        evt.stopPropagation();
                        handleRemove();
                    });
                }

                const deleteBtn = div.querySelector(".btn-delete-shape");
                if (deleteBtn) {
                    deleteBtn.addEventListener("click", evt => {
                        evt.stopPropagation();
                        handleRemove();
                    });
                }

                div.addEventListener("mousedown", startDrag);
            }

            function addBox(roomId, roomLabel, x, y, options) {
                const opts = options ?? {};
                const normalizedRoomId = String(roomId ?? "0");
                const rawLabel = typeof roomLabel === "string" ? roomLabel : "";
                let displayLabel = typeof opts.displayLabel === "string" && opts.displayLabel.trim().length > 0
                    ? opts.displayLabel
                    : rawLabel;
                const trimmedRawLabel = rawLabel.trim();
                const hasLookup = roomLabelLookup && roomLabelLookup[normalizedRoomId] && roomLabelDisplayLookup && roomLabelDisplayLookup[normalizedRoomId];
                if ((displayLabel.trim().length === 0 || displayLabel === rawLabel) && hasLookup) {
                    const lookupRaw = roomLabelLookup[normalizedRoomId];
                    if (lookupRaw === rawLabel) {
                        displayLabel = roomLabelDisplayLookup[normalizedRoomId];
                    }
                }
                if (displayLabel.trim().length === 0) {
                    displayLabel = trimmedRawLabel;
                }
                const trimmedDisplayLabel = displayLabel.trim().length > 0 ? displayLabel.trim() : trimmedRawLabel;

                const div = document.createElement("div");
                div.classList.add("room-box");
                div.setAttribute("data-room-id", normalizedRoomId);
                div.setAttribute("data-room-label", trimmedRawLabel);
                div.setAttribute("data-room-display-label", trimmedDisplayLabel);
                const layoutId = typeof opts.layoutId === "number" ? opts.layoutId : 0;
                div.setAttribute("data-layout-id", String(layoutId));

                div.style.left = x + "px";
                div.style.top = y + "px";
                const boxWidth = typeof opts.width === "number" ? opts.width : gridSize;
                const boxHeight = typeof opts.height === "number" ? opts.height : gridSize;
                div.style.width = boxWidth + "px";
                div.style.height = boxHeight + "px";
                div.style.position = "absolute";
                div.style.border = "1px solid #333";
                div.style.backgroundColor = "#cce5ff";
                div.style.zIndex = "1";
                div.style.display = "flex";
                div.style.alignItems = "center";
                div.style.justifyContent = "center";
                div.style.cursor = "move";
                div.style.setProperty("--text-rotation", "0deg");

                const span = document.createElement("span");
                span.classList.add("room-label");
                span.textContent = trimmedDisplayLabel;
                div.appendChild(span);

                const controls = document.createElement("div");
                controls.classList.add("box-controls");
                controls.style.position = "absolute";
                controls.style.right = "0";
                controls.style.bottom = "100%";
                controls.style.display = "flex";
                controls.style.marginBottom = "4px";
                const btnCustomize = document.createElement("button");
                btnCustomize.classList.add("btn", "btn-sm", "btn-light", "btn-customize-shape");
                btnCustomize.title = customizeShapeText;
                btnCustomize.setAttribute("aria-label", customizeShapeText);
                btnCustomize.textContent = shapeButtonLabel;
                controls.appendChild(btnCustomize);
                const btnMoveBack = document.createElement("button");
                btnMoveBack.classList.add("btn", "btn-sm", "btn-light", "btn-move-back");
                btnMoveBack.title = moveBackToPaletteText;
                btnMoveBack.setAttribute("aria-label", moveBackToPaletteText);
                btnMoveBack.textContent = backButtonLabel;
                controls.appendChild(btnMoveBack);
                const rotationSelect = document.createElement("select");
                rotationSelect.classList.add("form-select", "form-select-sm", "text-rotation-select");
                rotationSelect.title = rotateTextLabel;
                rotationSelect.setAttribute("aria-label", rotateTextLabel);
                [0, 45, 90, 135, 180, 225, 270, 315].forEach(deg => {
                    const opt = document.createElement("option");
                    opt.value = String(deg);
                    opt.textContent = rotationDegreesTemplate.replace("{0}", String(deg));
                    rotationSelect.appendChild(opt);
                });
                controls.appendChild(rotationSelect);
                const btnDel = document.createElement("button");
                btnDel.classList.add("btn", "btn-sm", "btn-light", "btn-delete-shape");
                btnDel.title = deleteShapeText;
                btnDel.setAttribute("aria-label", deleteShapeText);
                btnDel.textContent = deleteButtonLabel;
                controls.appendChild(btnDel);

                div.appendChild(controls);

                const rh = document.createElement("div");
                rh.classList.add("resize-handle");
                rh.style.position = "absolute";
                rh.style.right = "0";
                rh.style.bottom = "0";
                rh.style.width = "12px";
                rh.style.height = "12px";
                rh.style.background = "#333";
                rh.style.cursor = "se-resize";
                div.appendChild(rh);

                container.appendChild(div);
                applyShapeToElement(
                    div,
                    typeof opts.shapeType === "string" ? opts.shapeType : "rectangle",
                    typeof opts.shapeData === "string" ? opts.shapeData : ""
                );

                const shapeType = typeof opts.shapeType === "string" ? opts.shapeType : "rectangle";
                const shapeData = typeof opts.shapeData === "string" ? opts.shapeData : "";
                const initialRotation = typeof opts.textRotation === "number"
                    ? normalizeRotation(opts.textRotation)
                    : defaultRotationForShape(shapeType, shapeData);
                const normalizedRotation = setTextRotation(div, initialRotation);
                rotationSelect.value = String(normalizedRotation);

                setupBoxInteractions(div);
                if (!opts.skipRecord) {
                    recordState();
                }
            }

            function moveBackToPalette(roomId, roomLabel, displayLabel) {
                const pal = document.getElementById("palette");
                if (!pal) {
                    return;
                }

                const key = String(roomId);
                const normalizedRaw = typeof roomLabel === "string" ? roomLabel : "";
                const normalizedDisplay = (typeof displayLabel === "string" && displayLabel.trim().length > 0)
                    ? displayLabel
                    : normalizedRaw;
                const trimmedRaw = normalizedRaw.trim();
                const trimmedDisplay = normalizedDisplay.trim();
                paletteRoomLabels.set(key, trimmedRaw);
                paletteRoomDisplayLabels.set(key, trimmedDisplay.length > 0 ? trimmedDisplay : trimmedRaw);

                const existing = pal.querySelector(`.pal-shape[data-room-id="${roomId}"]`);
                if (existing) {
                    existing.setAttribute("data-room-label", trimmedRaw);
                    const displayValue = trimmedDisplay.length > 0 ? trimmedDisplay : trimmedRaw;
                    existing.setAttribute("data-room-display-label", displayValue);
                    existing.textContent = displayValue;
                    return;
                }

                if (roomId === "0") {
                    return;
                }

                const p = document.createElement("div");
                p.classList.add("pal-shape");
                p.setAttribute("data-room-id", roomId);
                p.setAttribute("data-room-label", trimmedRaw);
                const displayValue = trimmedDisplay.length > 0 ? trimmedDisplay : trimmedRaw;
                p.setAttribute("data-room-display-label", displayValue);
                p.draggable = true;
                p.style.width = "50px";
                p.style.height = "50px";
                p.style.border = "1px solid #333";
                p.style.marginBottom = "10px";
                p.style.display = "flex";
                p.style.alignItems = "center";
                p.style.justifyContent = "center";
                p.style.cursor = "grab";
                p.textContent = displayValue;
                attachPaletteDragHandlers(p);
                pal.appendChild(p);
            }

            container.querySelectorAll(".room-box").forEach(box => setupBoxInteractions(box));
            recordState(true);

            // Drag / Resize logic (re-use your existing handlers)
            let dragBox = null, offsetX = 0, offsetY = 0;
            let resizeBox = null, startW = 0, startH = 0, startDX = 0, startDY = 0;

            function startDrag(evt) {
                const targetEl = evt.target;
                const isResizeHandle = targetEl instanceof HTMLElement && targetEl.classList.contains("resize-handle");
                const isControlElement = targetEl instanceof HTMLElement &&
                    (targetEl.closest(".box-controls") ||
                        ["BUTTON", "SELECT", "OPTION", "TEXTAREA", "INPUT", "LABEL"].includes(targetEl.tagName));

                if (!isResizeHandle && isControlElement) {
                    return;
                }

                if (isResizeHandle) {
                    resizeBox = evt.target.parentElement;
                    startW = parseInt(window.getComputedStyle(resizeBox).width);
                    startH = parseInt(window.getComputedStyle(resizeBox).height);
                    startDX = evt.clientX;
                    startDY = evt.clientY;
                    document.addEventListener("mousemove", onResize);
                    document.addEventListener("mouseup", stopResize);
                } else {
                    dragBox = evt.currentTarget;
                    const rect = dragBox.getBoundingClientRect();
                    offsetX = (evt.clientX - rect.left) / scale;
                    offsetY = (evt.clientY - rect.top) / scale;
                    document.addEventListener("mousemove", onDrag);
                    document.addEventListener("mouseup", stopDrag);
                }
                evt.preventDefault();
                evt.stopPropagation();
            }

            function onDrag(evt) {
                if (!dragBox) return;
                const contRect = container.getBoundingClientRect();
                let x = (evt.clientX - contRect.left) / scale - offsetX;
                let y = (evt.clientY - contRect.top) / scale - offsetY;
                if (x < 0) x = 0;
                if (y < 0) y = 0;
                dragBox.style.left = x + "px";
                dragBox.style.top = y + "px";
            }

            function stopDrag(evt) {
                document.removeEventListener("mousemove", onDrag);
                document.removeEventListener("mouseup", stopDrag);
                let hadDrag = false;
                if (dragBox) {
                    hadDrag = true;
                }
                if (dragBox && chkSnap.checked) {
                    let x = parseInt(dragBox.style.left) || 0;
                    let y = parseInt(dragBox.style.top) || 0;
                    x = Math.round(x / gridSize) * gridSize;
                    y = Math.round(y / gridSize) * gridSize;
                    dragBox.style.left = x + "px";
                    dragBox.style.top = y + "px";
                }
                dragBox = null;
                if (hadDrag) {
                    recordState();
                }
            }

            function onResize(evt) {
                if (!resizeBox) return;
                let dx = (evt.clientX - startDX) / scale;
                let dy = (evt.clientY - startDY) / scale;
                let w = startW + dx;
                let h = startH + dy;
                if (w < gridSize) w = gridSize;
                if (h < gridSize) h = gridSize;
                resizeBox.style.width = w + "px";
                resizeBox.style.height = h + "px";
            }

            function stopResize(evt) {
                document.removeEventListener("mousemove", onResize);
                document.removeEventListener("mouseup", stopResize);
                let hadResize = false;
                if (resizeBox) {
                    hadResize = true;
                }
                if (resizeBox && chkSnap.checked) {
                    let w = parseInt(resizeBox.style.width) || resizeBox.offsetWidth;
                    let h = parseInt(resizeBox.style.height) || resizeBox.offsetHeight;
                    w = Math.round(w / gridSize) * gridSize;
                    h = Math.round(h / gridSize) * gridSize;
                    resizeBox.style.width = w + "px";
                    resizeBox.style.height = h + "px";
                }
                resizeBox = null;
                if (hadResize) {
                    recordState();
                }
            }

            const saveButton = document.getElementById("save-layout-btn");
            saveButton.addEventListener("click", async () => {
                if (saveButton.disabled) {
                    return;
                }
                const boxesNodeList = container.querySelectorAll(".room-box");
                const boxes = Array.from(boxesNodeList);
                const layoutDtos = [];
                boxes.forEach(b => {
                    const ridValue = b.getAttribute("data-room-id");
                    const roomId = parseInt(ridValue ?? "", 10);
                    const layoutIdValue = b.getAttribute("data-layout-id");
                    const layoutId = parseInt(layoutIdValue ?? "", 10);
                    const fl = selectedFloor;
                    const x = parseInt(b.style.left) || 0;
                    const y = parseInt(b.style.top) || 0;
                    const w = parseInt(b.style.width) || b.offsetWidth;
                    const h = parseInt(b.style.height) || b.offsetHeight;
                    const label = b.getAttribute("data-room-label") ?? "";
                    const shapeType = b.getAttribute("data-shape-type") ?? "rectangle";
                    const shapeData = b.getAttribute("data-shape-data") ?? "";
                    const textRotation = getTextRotation(b);
                    layoutDtos.push({
                        id: Number.isNaN(layoutId) ? 0 : layoutId,
                        propertyId: propertyId,
                        roomId: Number.isNaN(roomId) ? 0 : roomId,
                        floor: fl,
                        x,
                        y,
                        width: w,
                        height: h,
                        label: label,
                        shapeType: shapeType,
                        shapeData: shapeData,
                        textRotation: textRotation
                    });
                });

                const payload = {
                    propertyId: propertyId,
                    floor: selectedFloor,
                    layouts: layoutDtos
                };

                saveButton.disabled = true;
                saveButton.textContent = savingText;

                try {
                    const resp = await fetch('@Url.Action("SaveLayout", "Settings")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (!resp.ok) {
                        const errorText = await resp.text();
                        const formattedErrorText = errorText.substring(0, 200);
                        throw new Error(
                            saveFailedWithStatusTemplate
                                .replace("{0}", String(resp.status))
                                .replace("{1}", formattedErrorText)
                        );
                    }

                    const result = await resp.json();
                    if (!result || result.success !== true) {
                        throw new Error(saveFailedUnexpectedText);
                    }

                    if (Array.isArray(result.layouts)) {
                        result.layouts.forEach((layout, index) => {
                            const box = boxes[index];
                            if (!(box instanceof HTMLElement)) {
                                return;
                            }

                            if (layout && typeof layout.id === "number") {
                                box.setAttribute("data-layout-id", String(layout.id));
                            }

                            if (layout && typeof layout.label === "string") {
                                const trimmedLabel = layout.label.trim();
                                if (trimmedLabel.length > 0) {
                                    box.setAttribute("data-room-label", trimmedLabel);
                                    const normalizedRoomId = box.getAttribute("data-room-id") ?? "";
                                    let updatedDisplayLabel = trimmedLabel;
                                    if (roomLabelLookup && roomLabelLookup[normalizedRoomId] === trimmedLabel && roomLabelDisplayLookup && roomLabelDisplayLookup[normalizedRoomId]) {
                                        updatedDisplayLabel = roomLabelDisplayLookup[normalizedRoomId];
                                    }
                                    box.setAttribute("data-room-display-label", updatedDisplayLabel);
                                    const labelSpan = box.querySelector(".room-label");
                                    if (labelSpan) {
                                        labelSpan.textContent = updatedDisplayLabel;
                                    }
                                }
                            }

                            const normalizedShapeType = layout && typeof layout.shapeType === "string" && layout.shapeType.trim().length > 0
                                ? layout.shapeType.trim()
                                : (box.getAttribute("data-shape-type") ?? "rectangle");
                            const normalizedShapeData = layout && typeof layout.shapeData === "string"
                                ? layout.shapeData
                                : (box.getAttribute("data-shape-data") ?? "");
                            applyShapeToElement(box, normalizedShapeType, normalizedShapeData);

                            if (layout && typeof layout.textRotation === "number") {
                                const normalizedRotation = setTextRotation(box, layout.textRotation);
                                const rotationSelect = box.querySelector(".text-rotation-select");
                                if (rotationSelect) {
                                    rotationSelect.value = String(normalizedRotation);
                                }
                            }
                        });
                    }

                    const currentState = captureLayoutState();
                    const serialized = serializeState(currentState);
                    if (undoStack.length > 0) {
                        undoStack[undoStack.length - 1] = {
                            state: JSON.parse(JSON.stringify(currentState)),
                            serialized
                        };
                    } else {
                        undoStack.push({
                            state: JSON.parse(JSON.stringify(currentState)),
                            serialized
                        });
                    }
                    redoStack = [];
                    updateUndoRedoButtons();

                    alert(layoutSavedText);
                } catch (err) {
                    console.error(err);
                    alert(err instanceof Error ? err.message : saveErrorGenericText);
                } finally {
                    saveButton.disabled = false;
                    saveButton.textContent = saveLayoutText;
                }
            });

        })();
    </script>
}











