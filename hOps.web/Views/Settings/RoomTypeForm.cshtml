
@model hOps.web.Models.RoomType
@{
    string formAction = ViewData["FormAction"] as string ?? "CreateRoomType";
    ViewData["Title"] = formAction.Contains("Edit", System.StringComparison.OrdinalIgnoreCase)
        ? Html.Localize("Settings.RoomTypes.EditTitle", "Edit Room Type").ToString()
        : Html.Localize("Settings.RoomTypes.CreateTitle", "Create Room Type").ToString();
}

<h2>@ViewData["Title"]</h2>

<form asp-action="@formAction" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group mt-2">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success mt-3">@Html.Localize("Save")</button>
</form>
