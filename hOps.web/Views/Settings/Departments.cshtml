@model List<hOps.web.Models.Department>
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Globalization
@functions {
    private static string NormalizeColorHex(string? color)
    {
        const string fallback = "#6c757d";
        if (string.IsNullOrWhiteSpace(color))
        {
            return fallback;
        }

        var trimmed = color.Trim();
        if (!trimmed.StartsWith("#", System.StringComparison.Ordinal))
        {
            trimmed = "#" + trimmed;
        }

        if (trimmed.Length == 4)
        {
            var r = trimmed[1];
            var g = trimmed[2];
            var b = trimmed[3];
            trimmed = $"#{r}{r}{g}{g}{b}{b}";
        }

        if (trimmed.Length != 7)
        {
            return fallback;
        }

        for (var i = 1; i < trimmed.Length; i++)
        {
            var c = trimmed[i];
            var isHex = (c >= '0' && c <= '9') ||
                        (c >= 'a' && c <= 'f') ||
                        (c >= 'A' && c <= 'F');
            if (!isHex)
            {
                return fallback;
            }
        }

        return trimmed;
    }

    private static string GetTextColorForBackground(string normalizedHex)
    {
        if (string.IsNullOrEmpty(normalizedHex) || normalizedHex.Length != 7)
        {
            normalizedHex = "#6c757d";
        }

        if (!int.TryParse(normalizedHex.Substring(1, 2), System.Globalization.NumberStyles.HexNumber, System.Globalization.CultureInfo.InvariantCulture, out var r) ||
            !int.TryParse(normalizedHex.Substring(3, 2), System.Globalization.NumberStyles.HexNumber, System.Globalization.CultureInfo.InvariantCulture, out var g) ||
            !int.TryParse(normalizedHex.Substring(5, 2), System.Globalization.NumberStyles.HexNumber, System.Globalization.CultureInfo.InvariantCulture, out var b))
        {
            return "#ffffff";
        }

        var luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255.0;
        return luminance > 0.6 ? "#000000" : "#ffffff";
    }
}
@{
    ViewData["Title"] = Html.Localize("Settings.Departments.Title", "Departments").ToString();
    var filterOptions = ViewBag.PropertyFilterOptions as List<SelectListItem> ?? new List<SelectListItem>();
    string createUrl = ViewBag.CreateDepartmentUrl as string ?? Url.Action("CreateDepartment") ?? string.Empty;
    int? selectedPropertyId = ViewBag.SelectedPropertyId as int?;
    bool onlyGlobal = ViewBag.OnlyGlobal as bool? ?? false;
    string currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-lg-between gap-3 mb-3">
    <h2 class="h4 mb-0">@Html.Localize("Settings.Departments.Heading", "Departments")</h2>
    <div class="d-flex align-items-center gap-2">
        <label for="departmentPropertyFilter" class="form-label mb-0">@Html.Localize("Settings.Departments.ScopeLabel", "Scope:")</label>
        <select id="departmentPropertyFilter" class="form-select form-select-sm" style="width:auto; min-width:220px;">
            @foreach (var option in filterOptions)
            {
                <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
            }
        </select>
    </div>
    <a class="btn btn-primary" href="@createUrl">@Html.Localize("Settings.Departments.AddDepartment", "Add Department")</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Html.Localize("Settings.Departments.NameHeader", "Name")</th>
            <th>@Html.Localize("Settings.Departments.ColorHeader", "Color")</th>
            <th>@Html.Localize("Settings.Departments.AppliesToHeader", "Applies To")</th>
            <th class="text-end">@Html.Localize("Settings.Departments.ActionsHeader", "Actions")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            string scopeLabel;
            if (d.PropertyId.HasValue)
            {
                var propertyIdString = d.PropertyId.Value.ToString(CultureInfo.InvariantCulture);
                var propertyNameRaw = d.Property?.Name ?? string.Empty;
                var translatedPropertyName = await Html.DisplayTranslatedTextAsync("Property", propertyIdString, "Name", propertyNameRaw);
                var propertyName = string.IsNullOrWhiteSpace(translatedPropertyName) ? propertyNameRaw : translatedPropertyName;
                var propertyCode = d.Property?.Code;
                scopeLabel = !string.IsNullOrWhiteSpace(propertyName) && !string.IsNullOrWhiteSpace(propertyCode)
                    ? string.Format(CultureInfo.CurrentCulture, Html.Localize("Settings.Departments.PropertyWithCode", "{0} ({1})").ToString(), propertyName, propertyCode)
                    : string.Format(CultureInfo.CurrentCulture, Html.Localize("Settings.Departments.PropertyFallback", "Property #{0}").ToString(), propertyIdString);
            }
            else
            {
                scopeLabel = Html.Localize("Settings.Departments.ScopeGlobal", "Global").ToString();
            }

            var swatchColor = NormalizeColorHex(d.Color);
            var textColor = GetTextColorForBackground(swatchColor);
            var departmentNameTranslated = await Html.DisplayTranslatedTextAsync("Department", d.Id.ToString(CultureInfo.InvariantCulture), "Name", d.Name ?? string.Empty);

            <tr>
                <td>@(string.IsNullOrWhiteSpace(departmentNameTranslated) ? d.Name : departmentNameTranslated)</td>
                <td>
                    <span class="badge d-inline-flex align-items-center justify-content-center px-3"
                          style="background-color:@swatchColor; color:@textColor; border:1px solid rgba(0,0,0,0.1); min-width:4.5rem;">
                        @swatchColor
                    </span>
                </td>
                <td>@scopeLabel</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="EditDepartment" asp-route-id="@d.Id" asp-route-propertyId="@selectedPropertyId" asp-route-onlyGlobal="@onlyGlobal" asp-route-returnUrl="@currentUrl">@Html.Localize("Settings.Departments.Edit", "Edit")</a>
                    <form asp-action="DeleteDepartment" asp-route-id="@d.Id" asp-route-propertyId="@selectedPropertyId" asp-route-onlyGlobal="@onlyGlobal" asp-route-returnUrl="@currentUrl" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm(window.hopsTranslate('Settings.Departments.ConfirmDelete', 'Delete this department?'));">@Html.Localize("Settings.Departments.Delete", "Delete")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        (function () {
            const filter = document.getElementById('departmentPropertyFilter');
            if (!filter) return;
            filter.addEventListener('change', function () {
                if (this.value) {
                    window.location.href = this.value;
                }
            });
        })();
    </script>
}
