@model CalendarViewModel
@{
    ViewData["Title"] = "Calendar";
    ViewData["MainContainerClass"] = "main-inner--wide";
    var dayHeaders = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
    var disableForm = !Model.AccessibleProperties.Any();
}

<div class="calendar-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h1 class="h3 mb-0">Calendar</h1>
        <div class="d-flex align-items-center gap-2">
            <a class="btn btn-outline-secondary btn-sm"
               asp-action="Index"
               asp-route-year="@Model.PreviousMonth.Year"
               asp-route-month="@Model.PreviousMonth.Month">
                &laquo; @Model.PreviousMonth.ToString("MMM yyyy")
            </a>
            <span class="fw-semibold">@Model.CurrentMonth.ToString("MMMM yyyy")</span>
            <a class="btn btn-outline-secondary btn-sm"
               asp-action="Index"
               asp-route-year="@Model.NextMonth.Year"
               asp-route-month="@Model.NextMonth.Month">
                @Model.NextMonth.ToString("MMM yyyy") &raquo;
            </a>
        </div>
    </div>

@if (ViewBag.SuccessMessage is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <span>@successMessage</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.AccessibleProperties.Any())
{
    <div class="alert alert-warning" role="alert">
        You do not have access to any properties yet. Please contact an administrator to request access.
    </div>
}

    <div class="calendar-page__layout">
        <section class="calendar-page__calendar">
            <div class="calendar-page__calendar-surface shadow-sm border rounded overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 calendar-table">
                        <thead class="table-light">
                            <tr>
                                @foreach (var header in dayHeaders)
                                {
                                    <th scope="col" class="text-center">@header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var index = 0; index < Model.Days.Count; index += 7)
                            {
                                <tr>
                                    @for (var offset = 0; offset < 7; offset++)
                                    {
                                        var day = Model.Days[index + offset];
                                        var isToday = day.Date.Date == DateTime.Today;
                                        var cellClasses = $"calendar-day {(day.IsCurrentMonth ? string.Empty : "calendar-day--muted")}";
                                        if (isToday)
                                        {
                                            cellClasses += " calendar-day--today";
                                        }
                                        var dayIso = day.Date.ToString("yyyy-MM-dd");
                                        var ariaLabel = day.Date.ToString("dddd, MMMM d");
                                        if (!day.IsCurrentMonth)
                                        {
                                            ariaLabel += " (outside current month)";
                                        }
                                        <td class="@cellClasses">
                                            <div class="calendar-day__inner"
                                                 data-calendar-day="@dayIso"
                                                 data-calendar-day-current="@(day.IsCurrentMonth ? "true" : "false")"
                                                 tabindex="0"
                                                 role="button"
                                                 aria-pressed="false"
                                                 aria-label="@ariaLabel">
                                                <div class="calendar-day__header d-flex justify-content-between align-items-start">
                                                    <span class="fw-semibold">@day.Date.Day</span>
                                                    @if (isToday)
                                                    {
                                                        <span class="badge bg-primary">Today</span>
                                                    }
                                                </div>
                                                <div class="calendar-day-events mt-2">
                                                    @if (day.Events.Any())
                                                    {
                                                        foreach (var calendarEvent in day.Events)
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm text-start w-100 calendar-event"
                                                                    data-calendar-event="true"
                                                                    data-event-id="@calendarEvent.Id"
                                                                    data-event-title="@calendarEvent.Title"
                                                                    data-event-category="@calendarEvent.CategoryName"
                                                                    data-event-color="@calendarEvent.CategoryColor"
                                                                    data-event-date="@calendarEvent.DateDisplay"
                                                                    data-event-time="@(calendarEvent.TimeDisplay ?? string.Empty)"
                                                                    data-event-recurrence="@calendarEvent.RecurrenceDisplay"
                                                                    data-event-details="@(calendarEvent.Details ?? string.Empty)"
                                                                    data-event-properties="@calendarEvent.PropertiesDisplay"
                                                                    data-event-created-by="@calendarEvent.CreatedByDisplay"
                                                                    data-event-created-at="@TimeZoneService.ConvertToUserTime(calendarEvent.CreatedAtUtc).ToString("f")"
                                                                    data-event-edit-url="@Url.Action("Edit", "Calendar", new { id = calendarEvent.Id })">
                                                                <span class="calendar-event-indicator" style="background-color: @calendarEvent.CategoryColor"></span>
                                                                <span class="calendar-event-title">@calendarEvent.Title</span>
                                                            </button>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">No events</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <aside class="calendar-page__sidebar">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Upcoming Events</span>
                    <span class="badge bg-secondary">Next 10</span>
                </div>
                <div class="list-group list-group-flush">
                    @if (Model.UpcomingEvents.Any())
                    {
                        foreach (var upcoming in Model.UpcomingEvents)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action d-flex flex-column gap-1"
                                    data-calendar-event="true"
                                    data-event-id="@upcoming.Id"
                                    data-event-title="@upcoming.Title"
                                    data-event-category="@upcoming.CategoryName"
                                    data-event-color="@upcoming.CategoryColor"
                                    data-event-date="@upcoming.DateDisplay"
                                    data-event-time="@(upcoming.TimeDisplay ?? string.Empty)"
                                    data-event-recurrence="@upcoming.RecurrenceDisplay"
                                    data-event-details="@(upcoming.Details ?? string.Empty)"
                                    data-event-properties="@upcoming.PropertiesDisplay"
                                    data-event-created-by="@upcoming.CreatedByDisplay"
                                    data-event-created-at="@TimeZoneService.ConvertToUserTime(upcoming.CreatedAtUtc).ToString("f")"
                                    data-event-edit-url="@Url.Action("Edit", "Calendar", new { id = upcoming.Id })">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold">@upcoming.Title</span>
                                    <span class="badge" style="background-color: @upcoming.CategoryColor">@upcoming.CategoryName</span>
                                </div>
                                <small class="text-muted">@upcoming.DateDisplay</small>
                                @if (!string.IsNullOrWhiteSpace(upcoming.TimeDisplay))
                                {
                                    <small class="text-muted">@upcoming.TimeDisplay</small>
                                }
                            </button>
                        }
                    }
                    else
                    {
                        <div class="list-group-item text-muted">No upcoming events.</div>
                    }
                </div>
            </div>

            <div class="card shadow-sm calendar-page__form">
                <div class="card-header">
                    <span>Create Event</span>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="month" value="@Model.CurrentMonth.Month" />
                        <input type="hidden" name="year" value="@Model.CurrentMonth.Year" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Form.CategoryId" class="form-label"></label>
                            <select asp-for="Form.CategoryId" class="form-select" asp-items="Model.CategoryOptions"></select>
                            <span asp-validation-for="Form.CategoryId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.Title" class="form-label"></label>
                            <input asp-for="Form.Title" class="form-control" />
                            <span asp-validation-for="Form.Title" class="text-danger"></span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Form.StartDate" class="form-label"></label>
                                <input asp-for="Form.StartDate" class="form-control" />
                                <span asp-validation-for="Form.StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.StartTime" class="form-label"></label>
                                <input asp-for="Form.StartTime" class="form-control" />
                                <span class="form-text">Optional</span>
                                <span asp-validation-for="Form.StartTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Form.EndDate" class="form-label"></label>
                                <input asp-for="Form.EndDate" class="form-control" />
                                <span asp-validation-for="Form.EndDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.EndTime" class="form-label"></label>
                                <input asp-for="Form.EndTime" class="form-control" />
                                <span class="form-text">Optional</span>
                                <span asp-validation-for="Form.EndTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.Recurrence" class="form-label"></label>
                            <select asp-for="Form.Recurrence" class="form-select" asp-items="Html.GetEnumSelectList<CalendarRecurrenceType>()"></select>
                            <span asp-validation-for="Form.Recurrence" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.Details" class="form-label"></label>
                            <textarea asp-for="Form.Details" class="form-control" rows="3" data-enable-mentions="true"></textarea>
                            <span asp-validation-for="Form.Details" class="text-danger"></span>
                        </div>

                        @if (Model.ShowPropertySelection)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Properties</label>
                                <div class="row g-2">
                                    @foreach (var property in Model.AccessibleProperties)
                                    {
                                        var checkboxId = $"property_{property.Id}";
                                        <div class="col-sm-6">
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       value="@property.Id"
                                                       id="@checkboxId"
                                                       name="Form.SelectedPropertyIds"
                                                       @(Model.Form.SelectedPropertyIds.Contains(property.Id) ? "checked" : string.Empty) />
                                                <label class="form-check-label" for="@checkboxId">
                                                    <span class="d-block">@property.Name</span>
                                                    <small class="text-muted">@property.Code</small>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span asp-validation-for="Form.SelectedPropertyIds" class="text-danger"></span>
                            </div>
                        }
                        else if (Model.AccessibleProperties.Any())
                        {
                            foreach (var propertyId in Model.Form.SelectedPropertyIds)
                            {
                                <input type="hidden" name="Form.SelectedPropertyIds" value="@propertyId" />
                            }
                            var singleProperty = Model.AccessibleProperties.FirstOrDefault();
                            var propertyName = singleProperty?.Name ?? "Property";
                            var propertyCode = singleProperty?.Code ?? "N/A";
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Property</label>
                                <div class="form-control-plaintext">
                                    @propertyName <span class="text-muted">(@propertyCode)</span>
                                </div>
                            </div>
                        }

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary" @(disableForm ? "disabled" : string.Empty)>Save Event</button>
                        </div>
                    </form>
                </div>
            </div>
        </aside>
    </div>

</div>

<div class="modal fade" id="eventDetailsModal" tabindex="-1" aria-labelledby="eventDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="eventDetailsLabel" data-details="title">Event Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <span class="badge" data-details="category"></span>
                </div>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Dates</dt>
                    <dd class="col-sm-8" data-details="dates"></dd>

                    <dt class="col-sm-4">Time</dt>
                    <dd class="col-sm-8" data-details="times"></dd>

                    <dt class="col-sm-4">Recurrence</dt>
                    <dd class="col-sm-8" data-details="recurrence"></dd>

                    <dt class="col-sm-4">Properties</dt>
                    <dd class="col-sm-8" data-details="properties"></dd>

                    <dt class="col-sm-4">Details</dt>
                    <dd class="col-sm-8" data-details="details"></dd>

                    <dt class="col-sm-4">Created By</dt>
                    <dd class="col-sm-8" data-details="created-by"></dd>

                    <dt class="col-sm-4">Created On</dt>
                    <dd class="col-sm-8" data-details="created-at"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <a class="btn btn-primary d-none" data-details="edit-link" href="#">Edit Event</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .calendar-table {
            width: 100%;
            table-layout: fixed;
        }

        .calendar-table th,
        .calendar-table td {
            width: calc(100% / 7);
            min-width: 0;
        }

        .calendar-table td.calendar-day {
            height: 11rem;
            vertical-align: top;
            padding: 0;
            background-color: #fff;
        }

        .calendar-day__inner {
            height: 100%;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 0.85rem;
            background-color: inherit;
            border-radius: 0.75rem;
            cursor: pointer;
            transition: box-shadow 0.2s ease, background-color 0.2s ease;
        }

        .calendar-day__inner:hover {
            box-shadow: inset 0 0 0 2px rgba(13, 110, 253, 0.2);
        }

        .calendar-day__inner:focus-visible {
            outline: none;
            box-shadow: inset 0 0 0 2px rgba(13, 110, 253, 0.35);
        }

        .calendar-day__inner--selected {
            box-shadow: inset 0 0 0 2px rgba(13, 110, 253, 0.5), 0 0 0 4px rgba(13, 110, 253, 0.12);
            background-color: rgba(13, 110, 253, 0.08);
        }

        .calendar-table td.calendar-day .badge {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .calendar-table td.calendar-day .calendar-day-events {
            flex-grow: 1;
            overflow-y: auto;
            padding-right: 0.15rem;
        }

        .calendar-table td.calendar-day .calendar-day-events::-webkit-scrollbar {
            width: 0.35rem;
        }

        .calendar-table td.calendar-day .calendar-day-events::-webkit-scrollbar-thumb {
            background-color: rgba(13, 110, 253, 0.35);
            border-radius: 999px;
        }

        .calendar-table td.calendar-day .calendar-event + .calendar-event {
            margin-top: 0.35rem;
        }

        .calendar-table td.calendar-day .calendar-event {
            white-space: normal;
        }

        .calendar-table td.calendar-day--muted {
            background-color: #f8f9fb;
        }

        .calendar-table td.calendar-day--muted .calendar-day__inner {
            background-color: inherit;
        }

        .calendar-table td.calendar-day--today {
            box-shadow: inset 0 0 0 2px rgba(13, 110, 253, 0.35);
            border-color: rgba(13, 110, 253, 0.25);
        }

        @@media (max-width: 991.98px) {
            .calendar-table td.calendar-day {
                height: 9.5rem;
            }

            .calendar-day__inner {
                padding: 0.75rem;
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalElement = document.getElementById('eventDetailsModal');
            if (!modalElement) {
                return;
            }

            if (modalElement.parentElement !== document.body) {
                document.body.appendChild(modalElement);
            }

            const titleEl = modalElement.querySelector('[data-details="title"]');
            const categoryEl = modalElement.querySelector('[data-details="category"]');
            const datesEl = modalElement.querySelector('[data-details="dates"]');
            const timesEl = modalElement.querySelector('[data-details="times"]');
            const recurrenceEl = modalElement.querySelector('[data-details="recurrence"]');
            const propertiesEl = modalElement.querySelector('[data-details="properties"]');
            const detailsEl = modalElement.querySelector('[data-details="details"]');
            const createdByEl = modalElement.querySelector('[data-details="created-by"]');
            const createdAtEl = modalElement.querySelector('[data-details="created-at"]');
            const editButton = modalElement.querySelector('[data-details="edit-link"]');

            const getModalInstance = () => {
                if (window.bootstrap && window.bootstrap.Modal) {
                    return window.bootstrap.Modal.getOrCreateInstance(modalElement);
                }

                console.error('Bootstrap modal library is unavailable.');
                return null;
            };

            const renderDetails = (value) => {
                if (!value) {
                    return '<span class="text-muted">No additional details</span>';
                }
                return value.replace(/\n/g, '<br />');
            };

            const updateModal = (element) => {
                const modal = getModalInstance();
                if (!modal) {
                    return;
                }

                const dataset = element.dataset;
                titleEl.textContent = dataset.eventTitle || 'Event Details';
                categoryEl.textContent = dataset.eventCategory || 'Category';
                categoryEl.style.backgroundColor = dataset.eventColor || '#6c757d';
                categoryEl.style.color = '#fff';
                datesEl.textContent = dataset.eventDate || '';
                timesEl.textContent = dataset.eventTime || 'All day';
                recurrenceEl.textContent = dataset.eventRecurrence || '';
                propertiesEl.textContent = dataset.eventProperties || '';
                detailsEl.innerHTML = renderDetails(dataset.eventDetails);
                createdByEl.textContent = dataset.eventCreatedBy || 'Unknown';
                createdAtEl.textContent = dataset.eventCreatedAt || '';

                if (editButton) {
                    const editUrl = dataset.eventEditUrl;
                    if (editUrl) {
                        editButton.classList.remove('d-none');
                        editButton.setAttribute('href', editUrl);
                    } else {
                        editButton.classList.add('d-none');
                        editButton.removeAttribute('href');
                    }
                }

                modal.show();
            };

            document.querySelectorAll('[data-calendar-event]').forEach(element => {
                element.addEventListener('click', () => updateModal(element));
            });

            const creationForm = document.querySelector('.calendar-page__form form');
            const titleInput = document.getElementById('Form_Title');
            const startDateInput = document.getElementById('Form_StartDate');
            const endDateInput = document.getElementById('Form_EndDate');
            const dayElements = document.querySelectorAll('[data-calendar-day]');
            const selectedClassName = 'calendar-day__inner--selected';
            let selectedDayElement = null;

            const applySelectedState = (element) => {
                if (selectedDayElement && selectedDayElement !== element) {
                    selectedDayElement.classList.remove(selectedClassName);
                    selectedDayElement.setAttribute('aria-pressed', 'false');
                }

                selectedDayElement = element;
                if (selectedDayElement) {
                    selectedDayElement.classList.add(selectedClassName);
                    selectedDayElement.setAttribute('aria-pressed', 'true');
                }
            };

            const focusCreationField = () => {
                const focusTarget = titleInput || startDateInput;
                if (!focusTarget) {
                    return;
                }

                try {
                    focusTarget.focus({ preventScroll: true });
                } catch {
                    focusTarget.focus();
                }
            };

            const activateDay = (element) => {
                if (!creationForm || !startDateInput || !endDateInput || !element) {
                    return;
                }

                const isoDate = element.getAttribute('data-calendar-day');
                if (!isoDate) {
                    return;
                }

                startDateInput.value = isoDate;
                endDateInput.value = isoDate;

                applySelectedState(element);

                creationForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
                window.setTimeout(focusCreationField, 250);
            };

            if (creationForm && startDateInput && endDateInput) {
                const initialIso = startDateInput.value;
                if (initialIso) {
                    const preselected = document.querySelector(`[data-calendar-day="${initialIso}"]`);
                    if (preselected) {
                        applySelectedState(preselected);
                    }
                }

                dayElements.forEach(element => {
                    element.addEventListener('click', event => {
                        if (event.target.closest('[data-calendar-event]')) {
                            return;
                        }

                        event.preventDefault();
                        activateDay(element);
                    });

                    element.addEventListener('keydown', event => {
                        if (event.target.closest('[data-calendar-event]')) {
                            return;
                        }

                        if (event.key === 'Enter' || event.key === ' ') {
                            event.preventDefault();
                            activateDay(element);
                        }
                    });
                });
            }
        });
    </script>
}
