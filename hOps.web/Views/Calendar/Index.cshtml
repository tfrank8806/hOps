@model CalendarViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Calendar";
    ViewData["MainContainerClass"] = "main-inner--wide main-inner--wide-stretched";
    var dayHeaders = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
    var disableForm = !Model.AccessibleProperties.Any();
    var today = DateTime.Today;
}

<div class="calendar-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h1 class="h3 mb-0">Calendar</h1>
        <div class="d-flex align-items-center gap-2">
            <a class="btn btn-outline-secondary btn-sm"
               asp-action="Index"
               asp-route-year="@Model.PreviousMonth.Year"
               asp-route-month="@Model.PreviousMonth.Month">
                &laquo; @Model.PreviousMonth.ToString("MMM yyyy")
            </a>
            <span class="fw-semibold">@Model.CurrentMonth.ToString("MMMM yyyy")</span>
            <a class="btn btn-outline-secondary btn-sm"
               asp-action="Index"
               asp-route-year="@Model.NextMonth.Year"
               asp-route-month="@Model.NextMonth.Month">
                @Model.NextMonth.ToString("MMM yyyy") &raquo;
            </a>
            <a class="btn btn-primary btn-sm"
               asp-action="Index"
               asp-route-year="@today.Year"
               asp-route-month="@today.Month"
               title="Jump back to the current month">
                Today
            </a>
        </div>
    </div>

@if (ViewBag.SuccessMessage is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <span>@successMessage</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.AccessibleProperties.Any())
{
    <div class="alert alert-warning" role="alert">
        You do not have access to any properties yet. Please contact an administrator to request access.
    </div>
}

    <div class="calendar-page__layout row g-4 align-items-start">
        <div class="col-12 col-xxl-9 calendar-page__main">
        <section class="calendar-page__calendar">
            <div class="calendar-page__calendar-surface shadow-sm border rounded overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 calendar-table">
                        <thead class="table-light">
                            <tr>
                                @foreach (var header in dayHeaders)
                                {
                                    <th scope="col" class="text-center">@header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var index = 0; index < Model.Days.Count; index += 7)
                            {
                                <tr>
                                    @for (var offset = 0; offset < 7; offset++)
                                    {
                                        var day = Model.Days[index + offset];
                                        var isToday = day.Date.Date == DateTime.Today;
                                        var cellClasses = "calendar-day";
                                        if (!day.IsCurrentMonth)
                                        {
                                            cellClasses += " calendar-day--muted";
                                        }
                                        if (isToday)
                                        {
                                            cellClasses += " calendar-day--today";
                                        }
                                        if (day.ContinuingEvents.Any())
                                        {
                                            cellClasses += " calendar-day--has-continuation";
                                        }
                                        var dayIso = day.Date.ToString("yyyy-MM-dd");
                                        var ariaLabel = day.Date.ToString("dddd, MMMM d");
                                        if (!day.IsCurrentMonth)
                                        {
                                            ariaLabel += " (outside current month)";
                                        }
                                        <td class="@cellClasses">
                                            <div class="calendar-day__inner"
                                                 data-calendar-day="@dayIso"
                                                 data-calendar-day-current="@(day.IsCurrentMonth ? "true" : "false")"
                                                 tabindex="0"
                                                 role="button"
                                                 aria-pressed="false"
                                                 aria-label="@ariaLabel">
                                                <div class="calendar-day__header d-flex justify-content-between align-items-start">
                                                    <span class="fw-semibold">@day.Date.Day</span>
                                                    @if (isToday)
                                                    {
                                                        <span class="badge bg-primary">Today</span>
                                                    }
                                                </div>
                                                <div class="calendar-day-events mt-2">
                                                    @if (day.Events.Any())
                                                    {
                                                        foreach (var calendarEvent in day.Events)
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm text-start w-100 calendar-event"
                                                                    style="background-color:@calendarEvent.CategoryColor; color:@calendarEvent.CategoryTextColor; border-color:@calendarEvent.CategoryColor;"
                                                                    data-calendar-event="true"
                                                                    data-event-id="@calendarEvent.Id"
                                                                    data-event-title="@calendarEvent.Title"
                                                                    data-event-category="@calendarEvent.CategoryName"
                                                                    data-event-color="@calendarEvent.CategoryColor"
                                                                    data-event-text-color="@calendarEvent.CategoryTextColor"
                                                                    data-event-date="@calendarEvent.DateDisplay"
                                                                    data-event-time="@(calendarEvent.TimeDisplay ?? string.Empty)"
                                                                    data-event-recurrence="@calendarEvent.RecurrenceDisplay"
                                                                    data-event-recurrence-type="@((int)calendarEvent.Recurrence)"
                                                                    data-event-occurrence='@calendarEvent.StartDate.ToString("yyyy-MM-dd")'
                                                                    data-event-details="@(calendarEvent.Details ?? string.Empty)"
                                                                    data-event-properties="@calendarEvent.PropertiesDisplay"
                                                                    data-event-created-by="@calendarEvent.CreatedByDisplay"
                                                                    data-event-created-at="@TimeZoneService.ConvertToUserTime(calendarEvent.CreatedAtUtc).ToString("f")"
                                                                    data-event-edit-url="@Url.Action("Edit", "Calendar", new { id = calendarEvent.Id })"
                                                                    data-event-attachments='@JsonSerializer.Serialize(calendarEvent.Attachments)'>
                                                                <span class="calendar-event-title">@calendarEvent.Title</span>
                                                                @if (!string.IsNullOrWhiteSpace(calendarEvent.TimeDisplay))
                                                                {
                                                                    <span class="calendar-event-time d-block">@calendarEvent.TimeDisplay</span>
                                                                }
                                                                @if (calendarEvent.IsMultiDay)
                                                                {
                                                                    <span class="calendar-event-range d-block">@($"Ends {calendarEvent.EndDate:MMM d}")</span>
                                                                }
                                                            </button>
                                                        }
                                                    }
                                                    else if (!day.ContinuingEvents.Any())
                                                    {
                                                        <span class="text-muted small">No events</span>
                                                    }

                                                    @if (day.ContinuingEvents.Any())
                                                    {
                                                        <div class="calendar-day-continuations mt-2">
                                                            @foreach (var continuation in day.ContinuingEvents)
                                                            {
                                                                <div class="calendar-day-continuation"
                                                                     style="background-color:@continuation.CategoryColor; color:@continuation.CategoryTextColor;">
                                                                    <span class="calendar-day-continuation__badge">Continues</span>
                                                                    <span class="calendar-day-continuation__title">@continuation.Title</span>
                                                                    @if (continuation.EndDate.Date > day.Date.Date)
                                                                    {
                                                                        <span class="calendar-day-continuation__range text-white-50">through @continuation.EndDate.ToString("MMM d")</span>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

            <div class="card shadow-sm calendar-page__form mt-4">
                <div class="card-header">
                    <span>Create Event</span>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data" id="calendarCreateForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="month" value="@Model.CurrentMonth.Month" />
        <input type="hidden" name="year" value="@Model.CurrentMonth.Year" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Form.CategoryId" class="form-label"></label>
                            <select asp-for="Form.CategoryId" class="form-select" asp-items="Model.CategoryOptions"></select>
                            <span asp-validation-for="Form.CategoryId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.Title" class="form-label"></label>
                            <input asp-for="Form.Title" class="form-control" />
                            <span asp-validation-for="Form.Title" class="text-danger"></span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Form.StartDate" class="form-label"></label>
                                <input asp-for="Form.StartDate" class="form-control" />
                                <span asp-validation-for="Form.StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.StartTime" class="form-label"></label>
                                <input asp-for="Form.StartTime" class="form-control" />
                                <span class="form-text">Optional</span>
                                <span asp-validation-for="Form.StartTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Form.EndDate" class="form-label"></label>
                                <input asp-for="Form.EndDate" class="form-control" />
                                <span asp-validation-for="Form.EndDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.EndTime" class="form-label"></label>
                                <input asp-for="Form.EndTime" class="form-control" />
                                <span class="form-text">Optional</span>
                                <span asp-validation-for="Form.EndTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.Recurrence" class="form-label"></label>
                            <select asp-for="Form.Recurrence" class="form-select" asp-items="Html.GetEnumSelectList<CalendarRecurrenceType>()"></select>
                            <span asp-validation-for="Form.Recurrence" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.Details" class="form-label"></label>
                            <textarea asp-for="Form.Details"
                                      class="form-control"
                                      rows="3"
                                      data-enable-mentions="true"
                                      data-clipboard-upload-target="#Form_Attachments"></textarea>
                            <span asp-validation-for="Form.Details" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.Attachments" class="form-label fw-semibold"></label>
                            <input asp-for="Form.Attachments" class="form-control" type="file" multiple accept="image/*,.pdf" />
                            <div class="form-text">Attach up to 5 files (images or PDF, max 5&nbsp;MB each).</div>
                            <span asp-validation-for="Form.Attachments" class="text-danger"></span>
                        </div>

                        @if (Model.ShowPropertySelection)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Properties</label>
                                <div class="row g-2">
                                    @foreach (var property in Model.AccessibleProperties)
                                    {
                                        var checkboxId = $"property_{property.Id}";
                                        <div class="col-sm-6">
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       value="@property.Id"
                                                       id="@checkboxId"
                                                       name="Form.SelectedPropertyIds"
                                                       @(Model.Form.SelectedPropertyIds.Contains(property.Id) ? "checked" : string.Empty) />
                                                <label class="form-check-label" for="@checkboxId">
                                                    <span class="d-block">@property.Name</span>
                                                    <small class="text-muted">@property.Code</small>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span asp-validation-for="Form.SelectedPropertyIds" class="text-danger"></span>
                            </div>
                        }
                        else if (Model.AccessibleProperties.Any())
                        {
                            foreach (var propertyId in Model.Form.SelectedPropertyIds)
                            {
                                <input type="hidden" name="Form.SelectedPropertyIds" value="@propertyId" />
                            }
                            var singleProperty = Model.AccessibleProperties.FirstOrDefault();
                            var propertyName = singleProperty?.Name ?? "Property";
                            var propertyCode = singleProperty?.Code ?? "N/A";
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Property</label>
                                <div class="form-control-plaintext">
                                    @propertyName <span class="text-muted">(@propertyCode)</span>
                                </div>
                            </div>
                        }

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary" @(disableForm ? "disabled" : string.Empty)>Save Event</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <aside class="col-12 col-xxl-3 calendar-page__sidebar">
            <div class="calendar-upcoming-sticky">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Upcoming Events</span>
                    <span class="badge bg-secondary">Next 10</span>
                </div>
                <div class="list-group list-group-flush">
                    @if (Model.UpcomingEvents.Any())
                    {
                        foreach (var upcoming in Model.UpcomingEvents)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action calendar-upcoming-event"
                                    style="border-left: 4px solid @upcoming.CategoryColor;"
                                    data-calendar-event="true"
                                    data-event-id="@upcoming.Id"
                                    data-event-title="@upcoming.Title"
                                    data-event-category="@upcoming.CategoryName"
                                    data-event-color="@upcoming.CategoryColor"
                                    data-event-text-color="@upcoming.CategoryTextColor"
                                    data-event-date="@upcoming.DateDisplay"
                                    data-event-time="@(upcoming.TimeDisplay ?? string.Empty)"
                                    data-event-recurrence="@upcoming.RecurrenceDisplay"
                                    data-event-recurrence-type="@((int)upcoming.Recurrence)"
                                    data-event-occurrence='@upcoming.StartDate.ToString("yyyy-MM-dd")'
                                    data-event-details="@(upcoming.Details ?? string.Empty)"
                                    data-event-properties="@upcoming.PropertiesDisplay"
                                    data-event-created-by="@upcoming.CreatedByDisplay"
                                    data-event-created-at="@TimeZoneService.ConvertToUserTime(upcoming.CreatedAtUtc).ToString("f")"
                                    data-event-edit-url="@Url.Action("Edit", "Calendar", new { id = upcoming.Id })"
                                    data-event-attachments='@JsonSerializer.Serialize(upcoming.Attachments)'>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold">@upcoming.Title</span>
                                    <span class="badge" style="background-color: @upcoming.CategoryColor; color: @upcoming.CategoryTextColor">@upcoming.CategoryName</span>
                                </div>
                                <small class="text-muted">@upcoming.DateDisplay</small>
                                @if (!string.IsNullOrWhiteSpace(upcoming.TimeDisplay))
                                {
                                    <small class="text-muted">@upcoming.TimeDisplay</small>
                                }
                            </button>
                        }
                    }
                    else
                    {
                        <div class="list-group-item text-muted">No upcoming events.</div>
                    }
                </div>
            </div>
            </div>
        </aside>
    </div>

</div>

<div id="calendarEventFlyout" class="calendar-event-flyout d-none" role="dialog" aria-hidden="true" aria-live="polite">
    <div class="calendar-event-flyout__inner shadow-lg border rounded-3 bg-white">
        <button type="button" class="btn-close calendar-event-flyout__close" data-flyout-dismiss aria-label="Close"></button>
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge text-uppercase fw-semibold calendar-event-flyout__category" data-flyout="category"></span>
            <span class="small text-muted" data-flyout="date"></span>
        </div>
        <h5 class="mb-2 calendar-event-flyout__title" data-flyout="title"></h5>
        <div class="calendar-event-flyout__meta mb-2 small text-muted">
            <div data-flyout="time"></div>
            <div data-flyout="recurrence"></div>
        </div>
        <div class="calendar-event-flyout__properties small fw-semibold text-secondary" data-flyout="properties"></div>
        <div class="calendar-event-flyout__details small mt-2" data-flyout="details"></div>
        <div class="calendar-event-flyout__actions mt-3 d-flex gap-2">
            <a class="btn btn-sm btn-primary" data-flyout="edit-link" href="#">Edit</a>
        </div>
    </div>
</div>

<form asp-action="Delete" method="post" id="calendarDeleteForm" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" />
    <input type="hidden" name="scope" />
    <input type="hidden" name="occurrenceDate" />
    <input type="hidden" name="month" value="@Model.CurrentMonth.Month" />
    <input type="hidden" name="year" value="@Model.CurrentMonth.Year" />
</form>

<div class="modal fade" id="eventDeleteConfirmModal" tabindex="-1" aria-labelledby="eventDeleteConfirmLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="eventDeleteConfirmLabel">Delete Recurring Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    <span data-delete="title"></span> repeats on the calendar. Would you like to delete just this occurrence or the entire series?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-outline-danger" data-delete-scope="occurrence">Delete This Occurrence</button>
                <button type="button" class="btn btn-danger" data-delete-scope="series">Delete Entire Series</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="eventDetailsModal" tabindex="-1" aria-labelledby="eventDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="eventDetailsLabel" data-details="title">Event Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <span class="badge" data-details="category"></span>
                </div>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Dates</dt>
                    <dd class="col-sm-8" data-details="dates"></dd>

                    <dt class="col-sm-4">Time</dt>
                    <dd class="col-sm-8" data-details="times"></dd>

                    <dt class="col-sm-4">Recurrence</dt>
                    <dd class="col-sm-8" data-details="recurrence"></dd>

                    <dt class="col-sm-4">Properties</dt>
                    <dd class="col-sm-8" data-details="properties"></dd>

                    <dt class="col-sm-4">Details</dt>
                    <dd class="col-sm-8" data-details="details"></dd>

                    <dt class="col-sm-4">Attachments</dt>
                    <dd class="col-sm-8" data-details="attachments"></dd>

                    <dt class="col-sm-4">Created By</dt>
                    <dd class="col-sm-8" data-details="created-by"></dd>

                    <dt class="col-sm-4">Created On</dt>
                    <dd class="col-sm-8" data-details="created-at"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-details="delete-button">Delete</button>
                <a class="btn btn-primary d-none" data-details="edit-link" href="#">Edit Event</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .calendar-page__layout {
            margin-top: 1rem;
        }

        .calendar-page__main,
        .calendar-page__sidebar {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .calendar-upcoming-sticky {
            position: static;
        }

        @@media (min-width: 1200px) {
            .calendar-upcoming-sticky {
                position: sticky;
                top: calc(var(--main-header-height) + 1.5rem);
            }
        }

        .calendar-table {
            width: 100%;
            table-layout: fixed;
        }

        .calendar-table th,
        .calendar-table td {
            width: calc(100% / 7);
            min-width: 0;
        }

        .calendar-table td.calendar-day {
            height: 11rem;
            vertical-align: top;
            padding: 0;
            background-color: #fff;
        }

        .calendar-day__inner {
            height: 100%;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 0.85rem;
            background-color: inherit;
            border-radius: 0.75rem;
            cursor: pointer;
            transition: box-shadow 0.2s ease, background-color 0.2s ease;
        }

        .calendar-day__inner:hover {
            box-shadow: inset 0 0 0 2px rgba(13, 110, 253, 0.2);
        }

        .calendar-day__inner:focus-visible {
            outline: none;
            box-shadow: inset 0 0 0 2px rgba(13, 110, 253, 0.35);
        }

        .calendar-day__inner--selected {
            box-shadow: inset 0 0 0 2px rgba(13, 110, 253, 0.5), 0 0 0 4px rgba(13, 110, 253, 0.12);
            background-color: rgba(13, 110, 253, 0.08);
        }

        .calendar-day--has-continuation .calendar-day__inner {
            border: 1px solid rgba(13, 110, 253, 0.15);
        }

        .calendar-table td.calendar-day .badge {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .calendar-table td.calendar-day .calendar-day-events {
            flex-grow: 1;
            overflow-y: auto;
            padding-right: 0.15rem;
        }

        .calendar-table td.calendar-day .calendar-day-events::-webkit-scrollbar {
            width: 0.35rem;
        }

        .calendar-table td.calendar-day .calendar-day-events::-webkit-scrollbar-thumb {
            background-color: rgba(13, 110, 253, 0.35);
            border-radius: 999px;
        }

        .calendar-table td.calendar-day .calendar-event + .calendar-event {
            margin-top: 0.35rem;
        }

        .calendar-table td.calendar-day .calendar-event {
            white-space: normal;
            border-width: 1px;
            border-style: solid;
            border-radius: 0.5rem;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.1);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .calendar-table td.calendar-day .calendar-event:hover,
        .calendar-table td.calendar-day .calendar-event:focus {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(15, 23, 42, 0.18);
        }

        .calendar-event-title {
            font-weight: 600;
        }

        .calendar-event-time,
        .calendar-event-range {
            font-size: 0.75rem;
            opacity: 0.85;
        }

        .calendar-day-continuations {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        .calendar-day-continuation {
            border-radius: 0.5rem;
            padding: 0.35rem 0.5rem;
            font-size: 0.75rem;
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
        }

        .calendar-day-continuation__badge {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            opacity: 0.75;
        }

        .calendar-day-continuation__title {
            font-weight: 600;
        }

        .calendar-day-continuation__range {
            font-size: 0.7rem;
        }

        .calendar-table td.calendar-day--muted {
            background-color: #f8f9fb;
        }

        .calendar-table td.calendar-day--muted .calendar-day__inner {
            background-color: inherit;
        }

        .calendar-table td.calendar-day--today {
            box-shadow: inset 0 0 0 2px rgba(13, 110, 253, 0.35);
            border-color: rgba(13, 110, 253, 0.25);
        }

        .calendar-upcoming-event {
            text-align: left;
            border: 1px solid rgba(108, 117, 125, 0.15);
            border-left-width: 4px;
            border-radius: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .calendar-upcoming-event:last-child {
            margin-bottom: 0;
        }

        @@media (max-width: 991.98px) {
            .calendar-table td.calendar-day {
                height: 9.5rem;
            }

            .calendar-day__inner {
                padding: 0.75rem;
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalElement = document.getElementById('eventDetailsModal');
            const deleteModalElement = document.getElementById('eventDeleteConfirmModal');
            const flyoutElement = document.getElementById('calendarEventFlyout');
            if (!modalElement) {
                return;
            }

            if (modalElement.parentElement !== document.body) {
                document.body.appendChild(modalElement);
            }

            if (deleteModalElement && deleteModalElement.parentElement !== document.body) {
                document.body.appendChild(deleteModalElement);
            }

            if (flyoutElement && flyoutElement.parentElement !== document.body) {
                document.body.appendChild(flyoutElement);
            }

            const titleEl = modalElement.querySelector('[data-details="title"]');
            const categoryEl = modalElement.querySelector('[data-details="category"]');
            const datesEl = modalElement.querySelector('[data-details="dates"]');
            const timesEl = modalElement.querySelector('[data-details="times"]');
            const recurrenceEl = modalElement.querySelector('[data-details="recurrence"]');
            const propertiesEl = modalElement.querySelector('[data-details="properties"]');
            const detailsEl = modalElement.querySelector('[data-details="details"]');
            const createdByEl = modalElement.querySelector('[data-details="created-by"]');
            const createdAtEl = modalElement.querySelector('[data-details="created-at"]');
            const attachmentsEl = modalElement.querySelector('[data-details="attachments"]');
            const editButton = modalElement.querySelector('[data-details="edit-link"]');
            const deleteButton = modalElement.querySelector('[data-details="delete-button"]');
            const deleteForm = document.getElementById('calendarDeleteForm');
            const deleteFormIdInput = deleteForm ? deleteForm.querySelector('input[name="id"]') : null;
            const deleteFormScopeInput = deleteForm ? deleteForm.querySelector('input[name="scope"]') : null;
            const deleteFormOccurrenceInput = deleteForm ? deleteForm.querySelector('input[name="occurrenceDate"]') : null;
            const deleteModalTitleTarget = deleteModalElement ? deleteModalElement.querySelector('[data-delete="title"]') : null;
            const deleteOccurrenceButton = deleteModalElement ? deleteModalElement.querySelector('[data-delete-scope="occurrence"]') : null;
            const deleteSeriesButton = deleteModalElement ? deleteModalElement.querySelector('[data-delete-scope="series"]') : null;
            const flyoutTitleEl = flyoutElement ? flyoutElement.querySelector('[data-flyout="title"]') : null;
            const flyoutCategoryEl = flyoutElement ? flyoutElement.querySelector('[data-flyout="category"]') : null;
            const flyoutDateEl = flyoutElement ? flyoutElement.querySelector('[data-flyout="date"]') : null;
            const flyoutTimeEl = flyoutElement ? flyoutElement.querySelector('[data-flyout="time"]') : null;
            const flyoutRecurrenceEl = flyoutElement ? flyoutElement.querySelector('[data-flyout="recurrence"]') : null;
            const flyoutPropertiesEl = flyoutElement ? flyoutElement.querySelector('[data-flyout="properties"]') : null;
            const flyoutDetailsEl = flyoutElement ? flyoutElement.querySelector('[data-flyout="details"]') : null;
            const flyoutEditLink = flyoutElement ? flyoutElement.querySelector('[data-flyout="edit-link"]') : null;
            const flyoutCloseButton = flyoutElement ? flyoutElement.querySelector('[data-flyout-dismiss]') : null;

            const getModalInstance = () => {
                if (window.bootstrap && window.bootstrap.Modal) {
                    return window.bootstrap.Modal.getOrCreateInstance(modalElement);
                }

                console.error('Bootstrap modal library is unavailable.');
                return null;
            };

            const getDeleteModalInstance = () => {
                if (!deleteModalElement || !window.bootstrap || !window.bootstrap.Modal) {
                    return null;
                }

                return window.bootstrap.Modal.getOrCreateInstance(deleteModalElement);
            };

            const captureDataset = (dataset) => {
                const snapshot = {};
                if (!dataset) {
                    return snapshot;
                }

                Object.keys(dataset).forEach(key => {
                    snapshot[key] = dataset[key];
                });
                return snapshot;
            };

            let activeEventDataset = null;
            let pendingDeleteDataset = null;
            let deleteActionPendingSubmit = false;
            let flyoutActiveTrigger = null;
            let singleClickTimerId = null;

            const escapeHtml = (value) => {
                if (!value) {
                    return '';
                }
                return value
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            };

            const renderDetails = (value) => {
                if (!value) {
                    return '<span class="text-muted">No additional details</span>';
                }
                return escapeHtml(value).replace(/\n/g, '<br />');
            };

            const renderAttachments = (attachments) => {
                if (!attachments || !attachments.length) {
                    return '<span class="text-muted">None</span>';
                }

                const items = attachments
                    .map(att => {
                        const name = escapeHtml(att.displayName || att.fileName || 'Attachment');
                        const url = escapeHtml(att.downloadUrl || '#');
                        return `<li><a href="${url}" target="_blank" rel="noopener">${name}</a></li>`;
                    })
                    .join('');

                return `<ul class="list-unstyled mb-0">${items}</ul>`;
            };

            const setTextOrToggle = (element, value) => {
                if (!element) {
                    return;
                }

                const textValue = value ? value.trim() : '';
                if (textValue) {
                    element.textContent = textValue;
                    element.classList.remove('d-none');
                } else {
                    element.textContent = '';
                    element.classList.add('d-none');
                }
            };

            const hideFlyout = () => {
                if (!flyoutElement) {
                    return;
                }

                flyoutElement.classList.add('d-none');
                flyoutElement.setAttribute('aria-hidden', 'true');
                flyoutElement.style.top = '';
                flyoutElement.style.left = '';
                flyoutActiveTrigger = null;
            };

            const positionFlyout = (trigger) => {
                if (!flyoutElement || !trigger) {
                    return;
                }

                const triggerRect = trigger.getBoundingClientRect();
                const flyoutRect = flyoutElement.getBoundingClientRect();
                const spacing = 8;
                const viewportWidth = document.documentElement.clientWidth || window.innerWidth || 0;
                const viewportHeight = document.documentElement.clientHeight || window.innerHeight || 0;
                const flyoutWidth = flyoutRect.width || flyoutElement.offsetWidth || 320;
                const flyoutHeight = flyoutRect.height || flyoutElement.offsetHeight || 200;

                let left = triggerRect.left;
                let top = triggerRect.bottom + spacing;

                const maxLeft = Math.max(spacing, viewportWidth - flyoutWidth - spacing);
                if (left > maxLeft) {
                    left = maxLeft;
                }
                if (left < spacing) {
                    left = spacing;
                }

                if (top + flyoutHeight > viewportHeight - spacing) {
                    top = triggerRect.top - flyoutHeight - spacing;
                }

                if (top < spacing) {
                    top = spacing;
                }

                flyoutElement.style.left = `${left}px`;
                flyoutElement.style.top = `${top}px`;
            };

            const showFlyout = (trigger) => {
                if (!flyoutElement) {
                    updateModal(trigger);
                    return;
                }

                const dataset = trigger.dataset || {};

                if (flyoutTitleEl) {
                    flyoutTitleEl.textContent = dataset.eventTitle || 'Event Details';
                }

                if (flyoutCategoryEl) {
                    flyoutCategoryEl.textContent = dataset.eventCategory || 'Category';
                    flyoutCategoryEl.style.backgroundColor = dataset.eventColor || '#0d6efd';
                    flyoutCategoryEl.style.color = dataset.eventTextColor || '#fff';
                }

                setTextOrToggle(flyoutDateEl, dataset.eventDate || '');
                setTextOrToggle(flyoutTimeEl, dataset.eventTime || 'All day');
                setTextOrToggle(flyoutRecurrenceEl, dataset.eventRecurrence || '');

                if (flyoutPropertiesEl) {
                    const props = dataset.eventProperties || '';
                    if (props) {
                        flyoutPropertiesEl.textContent = props;
                        flyoutPropertiesEl.classList.remove('d-none');
                    } else {
                        flyoutPropertiesEl.textContent = '';
                        flyoutPropertiesEl.classList.add('d-none');
                    }
                }

                if (flyoutDetailsEl) {
                    flyoutDetailsEl.innerHTML = renderDetails(dataset.eventDetails);
                }

                if (flyoutEditLink) {
                    const editUrl = dataset.eventEditUrl;
                    if (editUrl) {
                        flyoutEditLink.classList.remove('d-none', 'disabled');
                        flyoutEditLink.setAttribute('href', editUrl);
                    } else {
                        flyoutEditLink.classList.add('d-none');
                        flyoutEditLink.removeAttribute('href');
                    }
                }

                flyoutElement.classList.remove('d-none');
                flyoutElement.setAttribute('aria-hidden', 'false');
                flyoutActiveTrigger = trigger;

                const reposition = () => positionFlyout(trigger);
                if (window.requestAnimationFrame) {
                    window.requestAnimationFrame(reposition);
                } else {
                    reposition();
                }
            };

            const submitDeleteRequest = (scope, dataset) => {
                if (!deleteForm || !deleteFormIdInput || !deleteFormScopeInput || !deleteFormOccurrenceInput) {
                    console.warn('Calendar: delete form is unavailable.');
                    return;
                }

                deleteFormIdInput.value = (dataset && dataset.eventId) || '';
                deleteFormScopeInput.value = scope;
                deleteFormOccurrenceInput.value = (dataset && dataset.eventOccurrence) || '';
                deleteForm.submit();
            };

            const updateModal = (element) => {
                const modal = getModalInstance();
                if (!modal) {
                    return;
                }

                const dataset = element.dataset;
                titleEl.textContent = dataset.eventTitle || 'Event Details';
                categoryEl.textContent = dataset.eventCategory || 'Category';
                categoryEl.style.backgroundColor = dataset.eventColor || '#6c757d';
                categoryEl.style.color = dataset.eventTextColor || '#fff';
                datesEl.textContent = dataset.eventDate || '';
                timesEl.textContent = dataset.eventTime || 'All day';
                recurrenceEl.textContent = dataset.eventRecurrence || '';
                propertiesEl.textContent = dataset.eventProperties || '';
                detailsEl.innerHTML = renderDetails(dataset.eventDetails);
                createdByEl.textContent = dataset.eventCreatedBy || 'Unknown';
                createdAtEl.textContent = dataset.eventCreatedAt || '';

                if (attachmentsEl) {
                    let attachmentsData = [];
                    if (dataset.eventAttachments) {
                        try {
                            attachmentsData = JSON.parse(dataset.eventAttachments);
                        } catch (err) {
                            console.warn('Calendar: could not parse attachments payload.', err);
                        }
                    }
                    attachmentsEl.innerHTML = renderAttachments(attachmentsData);
                }

                if (editButton) {
                    const editUrl = dataset.eventEditUrl;
                    if (editUrl) {
                        editButton.classList.remove('d-none');
                        editButton.setAttribute('href', editUrl);
                    } else {
                        editButton.classList.add('d-none');
                        editButton.removeAttribute('href');
                    }
                }

                activeEventDataset = captureDataset(dataset);

                modal.show();
            };

            const handleEventSingleClick = (element) => {
                if (singleClickTimerId) {
                    window.clearTimeout(singleClickTimerId);
                }

                singleClickTimerId = window.setTimeout(() => {
                    const isFlyoutVisible = flyoutElement && !flyoutElement.classList.contains('d-none');
                    if (isFlyoutVisible && element === flyoutActiveTrigger) {
                        hideFlyout();
                    } else {
                        showFlyout(element);
                    }
                    singleClickTimerId = null;
                }, 180);
            };

            const handleEventDoubleClick = (element) => {
                if (singleClickTimerId) {
                    window.clearTimeout(singleClickTimerId);
                    singleClickTimerId = null;
                }

                hideFlyout();
                updateModal(element);
            };

            const eventElements = document.querySelectorAll('[data-calendar-event]');
            eventElements.forEach(element => {
                element.addEventListener('click', event => {
                    event.preventDefault();
                    if (!flyoutElement) {
                        updateModal(element);
                        return;
                    }

                    handleEventSingleClick(element);
                });

                element.addEventListener('dblclick', event => {
                    event.preventDefault();
                    handleEventDoubleClick(element);
                });
            });

            if (flyoutCloseButton) {
                flyoutCloseButton.addEventListener('click', event => {
                    event.preventDefault();
                    hideFlyout();
                });
            }

            if (flyoutElement) {
                document.addEventListener('click', event => {
                    if (flyoutElement.classList.contains('d-none')) {
                        return;
                    }

                    if (event.target.closest('#calendarEventFlyout') || event.target.closest('[data-calendar-event]')) {
                        return;
                    }

                    hideFlyout();
                });

                document.addEventListener('keydown', event => {
                    if (event.key === 'Escape') {
                        hideFlyout();
                    }
                });

                window.addEventListener('scroll', () => {
                    if (!flyoutElement.classList.contains('d-none')) {
                        hideFlyout();
                    }
                }, true);

                window.addEventListener('resize', () => {
                    if (flyoutActiveTrigger && !flyoutElement.classList.contains('d-none')) {
                        positionFlyout(flyoutActiveTrigger);
                    }
                });
            }

            const handleDeleteAction = () => {
                if (!activeEventDataset) {
                    return;
                }

                const recurrenceType = parseInt(activeEventDataset.eventRecurrenceType || '0', 10) || 0;

                if (recurrenceType === 0) {
                    const title = activeEventDataset.eventTitle || 'this event';
                    const confirmed = window.confirm(`Delete "${title}"? This action cannot be undone.`);
                    if (confirmed) {
                        submitDeleteRequest('EntireSeries', activeEventDataset);
                    }
                    return;
                }

                pendingDeleteDataset = activeEventDataset;
                deleteActionPendingSubmit = false;

                const modal = getModalInstance();
                if (modal) {
                    modal.hide();
                }

                if (deleteModalTitleTarget) {
                    deleteModalTitleTarget.textContent = pendingDeleteDataset.eventTitle || 'This event';
                }

                const deleteModal = getDeleteModalInstance();
                if (deleteModal) {
                    deleteModal.show();
                } else {
                    const deleteSeries = window.confirm('Delete the entire series? Click OK for series or Cancel to delete only this occurrence.');
                    const scopeValue = deleteSeries ? 'EntireSeries' : 'SingleOccurrence';
                    submitDeleteRequest(scopeValue, pendingDeleteDataset);
                    pendingDeleteDataset = null;
                }
            };

            const handleDeleteScopeSelection = (scopeValue) => {
                if (!pendingDeleteDataset) {
                    return;
                }

                deleteActionPendingSubmit = true;
                const deleteModal = getDeleteModalInstance();
                if (deleteModal) {
                    deleteModal.hide();
                }

                submitDeleteRequest(scopeValue, pendingDeleteDataset);
                pendingDeleteDataset = null;
            };

            if (deleteButton) {
                deleteButton.addEventListener('click', handleDeleteAction);
            }

            if (deleteOccurrenceButton) {
                deleteOccurrenceButton.addEventListener('click', () => handleDeleteScopeSelection('SingleOccurrence'));
            }

            if (deleteSeriesButton) {
                deleteSeriesButton.addEventListener('click', () => handleDeleteScopeSelection('EntireSeries'));
            }

            if (deleteModalElement) {
                deleteModalElement.addEventListener('hidden.bs.modal', () => {
                    if (!deleteActionPendingSubmit && activeEventDataset) {
                        const modal = getModalInstance();
                        if (modal) {
                            modal.show();
                        }
                    }

                    pendingDeleteDataset = null;
                    deleteActionPendingSubmit = false;
                });
            }

            const creationForm = document.querySelector('.calendar-page__form form');
            const titleInput = document.getElementById('Form_Title');
            const startDateInput = document.getElementById('Form_StartDate');
            const endDateInput = document.getElementById('Form_EndDate');
            const dayElements = document.querySelectorAll('[data-calendar-day]');
            const selectedClassName = 'calendar-day__inner--selected';
            let selectedDayElement = null;

            const applySelectedState = (element) => {
                if (selectedDayElement && selectedDayElement !== element) {
                    selectedDayElement.classList.remove(selectedClassName);
                    selectedDayElement.setAttribute('aria-pressed', 'false');
                }

                selectedDayElement = element;
                if (selectedDayElement) {
                    selectedDayElement.classList.add(selectedClassName);
                    selectedDayElement.setAttribute('aria-pressed', 'true');
                }
            };

            const focusCreationField = () => {
                const focusTarget = titleInput || startDateInput;
                if (!focusTarget) {
                    return;
                }

                try {
                    focusTarget.focus({ preventScroll: true });
                } catch {
                    focusTarget.focus();
                }
            };

            const activateDay = (element) => {
                if (!creationForm || !startDateInput || !endDateInput || !element) {
                    return;
                }

                const isoDate = element.getAttribute('data-calendar-day');
                if (!isoDate) {
                    return;
                }

                startDateInput.value = isoDate;
                endDateInput.value = isoDate;

                applySelectedState(element);

                creationForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
                window.setTimeout(focusCreationField, 250);
            };

            if (creationForm && startDateInput && endDateInput) {
                const initialIso = startDateInput.value;
                if (initialIso) {
                    const preselected = document.querySelector(`[data-calendar-day="${initialIso}"]`);
                    if (preselected) {
                        applySelectedState(preselected);
                    }
                }

                dayElements.forEach(element => {
                    element.addEventListener('click', event => {
                        if (event.target.closest('[data-calendar-event]')) {
                            return;
                        }

                        event.preventDefault();
                        activateDay(element);
                    });

                    element.addEventListener('keydown', event => {
                        if (event.target.closest('[data-calendar-event]')) {
                            return;
                        }

                        if (event.key === 'Enter' || event.key === ' ') {
                            event.preventDefault();
                            activateDay(element);
                        }
                    });
                });
            }
        });
    </script>
}
