@model CalendarEventManageViewModel
@using System.Globalization
@{
    ViewData["Title"] = Html.Localize("Calendar.Heading.EditEvent", "Edit Event").ToString();
    var disableForm = !Model.AccessibleProperties.Any();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 mb-0">@Html.Localize(Model.Heading ?? "Calendar.Heading.EditEvent", "Edit Event")</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">@Html.Localize("Back to Calendar")</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Form.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input asp-for="Form.Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Form.CategoryId" class="form-label"></label>
                <select asp-for="Form.CategoryId" class="form-select" asp-items="Model.CategoryOptions"></select>
                <span asp-validation-for="Form.CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Form.Title" class="form-label"></label>
                <input asp-for="Form.Title" class="form-control" />
                <span asp-validation-for="Form.Title" class="text-danger"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label asp-for="Form.StartDate" class="form-label"></label>
                    <input asp-for="Form.StartDate" class="form-control" />
                    <span asp-validation-for="Form.StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Form.StartTime" class="form-label"></label>
                    <input asp-for="Form.StartTime" class="form-control" />
                    <span class="form-text">@Html.Localize("Optional")</span>
                    <span asp-validation-for="Form.StartTime" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label asp-for="Form.EndDate" class="form-label"></label>
                    <input asp-for="Form.EndDate" class="form-control" />
                    <span asp-validation-for="Form.EndDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Form.EndTime" class="form-label"></label>
                    <input asp-for="Form.EndTime" class="form-control" />
                    <span class="form-text">@Html.Localize("Optional")</span>
                    <span asp-validation-for="Form.EndTime" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Form.Recurrence" class="form-label"></label>
                <select asp-for="Form.Recurrence" class="form-select" asp-items="Html.GetEnumSelectList<CalendarRecurrenceType>()"></select>
                <span asp-validation-for="Form.Recurrence" class="text-danger"></span>
            </div>

        <div class="mb-3">
            <label asp-for="Form.Details" class="form-label"></label>
            <textarea asp-for="Form.Details"
                      class="form-control"
                      rows="3"
                      data-enable-mentions="true"
                      data-clipboard-upload-target="#Form_Attachments"></textarea>
            <span asp-validation-for="Form.Details" class="text-danger"></span>
        </div>

            @if (Model.Form.ExistingAttachments.Any())
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">@Html.Localize("Existing attachments")</label>
                    <div class="list-group">
                        @foreach (var attachment in Model.Form.ExistingAttachments)
                        {
                            var checkboxId = $"attachment_{attachment.FileName}";
                            var markedForRemoval = Model.Form.AttachmentsToRemove?.Contains(attachment.FileName) ?? false;
                            <label class="list-group-item d-flex align-items-center justify-content-between gap-2">
                                <span class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="@checkboxId" name="Form.AttachmentsToRemove" value="@attachment.FileName" @(markedForRemoval ? "checked" : string.Empty) />
                                    <span class="form-check-label">@attachment.DisplayName</span>
                                </span>
                                <a href="@attachment.DownloadUrl" class="small" target="_blank" rel="noopener">@Html.Localize("Download")</a>
                            </label>
                        }
                    </div>
                    <small class="text-muted d-block mt-1">@Html.Localize("Select attachments to remove when saving.")</small>
                </div>
            }

            <div class="mb-3">
                <label asp-for="Form.Attachments" class="form-label fw-semibold"></label>
                <input asp-for="Form.Attachments" class="form-control" type="file" multiple accept="image/*,.pdf" />
                <div class="form-text">@Html.Localize("Upload up to 5 files (images or PDF, max 5 MB each).")</div>
                <span asp-validation-for="Form.Attachments" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@Html.Localize("Reminders")</label>
                <div class="form-text">@Html.Localize("Select when teammates should receive reminders.")</div>
                @if (Model.ReminderOptions.Any())
                {
                    <div class="row g-2 mt-2">
                        @foreach (var option in Model.ReminderOptions)
                        {
                            var optionId = $"edit_reminder_{option.Value}";
                            <div class="col-sm-6">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="@optionId"
                                           name="Form.SelectedReminderOffsets"
                                           value="@option.Value"
                                           @(option.Selected ? "checked" : string.Empty) />
                                    <label class="form-check-label" for="@optionId">@option.Text</label>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border mt-2 mb-0">@Html.Localize("No reminder options are available.")</div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@Html.Localize("Department assignment")</label>
                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           id="editDeptAll"
                           name="Form.NotifyAllDepartments"
                           value="true"
                           data-dept-radio="edit"
                           @(Model.Form.NotifyAllDepartments ? "checked" : string.Empty) />
                    <label class="form-check-label" for="editDeptAll">@Html.Localize("All departments on selected properties")</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           id="editDeptSpecific"
                           name="Form.NotifyAllDepartments"
                           value="false"
                           data-dept-radio="edit"
                           @(Model.Form.NotifyAllDepartments ? string.Empty : "checked") />
                    <label class="form-check-label" for="editDeptSpecific">@Html.Localize("Specific department")</label>
                </div>
                <div class="mt-2">
                    @if (Model.DepartmentOptions.Any())
                    {
                        <select asp-for="Form.TargetDepartmentId"
                                class="form-select"
                                id="editDepartmentSelect"
                                asp-items="Model.DepartmentOptions"
                                            disabled="@(Model.Form.NotifyAllDepartments)">
                                        <option value="">@Html.Localize("Select a department")</option>
                                    </select>
                                }
                                else
                                {
                                    <div class="alert alert-light border mb-0">@Html.Localize("No departments are available for your selected properties.")</div>
                                }
                </div>
                <span asp-validation-for="Form.TargetDepartmentId" class="text-danger"></span>
            </div>

            @if (Model.ShowPropertySelection)
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">@Html.Localize("Properties")</label>
                    <div class="row g-2">
                        @foreach (var property in Model.AccessibleProperties)
                        {
                            var checkboxId = $"property_{property.Id}";
                            var propertyIdString = property.Id.ToString(CultureInfo.InvariantCulture);
                            var propertyDisplayName = await Html.DisplayTranslatedTextAsync("Property", propertyIdString, "Name", property.Name ?? string.Empty);
                            <div class="col-sm-6">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           value="@property.Id"
                                           id="@checkboxId"
                                           name="Form.SelectedPropertyIds"
                                           @(Model.Form.SelectedPropertyIds.Contains(property.Id) ? "checked" : string.Empty) />
                                    <label class="form-check-label" for="@checkboxId">
                                        <span class="d-block">@propertyDisplayName</span>
                                        <small class="text-muted">@property.Code</small>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Form.SelectedPropertyIds" class="text-danger"></span>
                </div>
            }
            else if (Model.AccessibleProperties.Any())
            {
                foreach (var propertyId in Model.Form.SelectedPropertyIds)
                {
                    <input type="hidden" name="Form.SelectedPropertyIds" value="@propertyId" />
                }

                var singleProperty = Model.AccessibleProperties.FirstOrDefault();
                var propertyName = singleProperty != null
                    ? await Html.DisplayTranslatedTextAsync("Property", singleProperty.Id.ToString(CultureInfo.InvariantCulture), "Name", singleProperty.Name ?? string.Empty)
                    : Html.Localize("Property").ToString();
                var propertyCode = singleProperty?.Code ?? Html.Localize("N/A").ToString();
                <div class="mb-3">
                    <label class="form-label fw-semibold">@Html.Localize("Property")</label>
                    <div class="form-control-plaintext">
                        @propertyName <span class="text-muted">(@propertyCode)</span>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-between gap-2">
                <a class="btn btn-outline-secondary" asp-action="Index">@Html.Localize("Cancel")</a>
                <button type="submit" class="btn btn-primary" @(disableForm ? "disabled" : string.Empty)>@Html.Localize("Update Event")</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const editDepartmentSelect = document.getElementById('editDepartmentSelect');
            const radios = document.querySelectorAll('[data-dept-radio="edit"]');
            if (!editDepartmentSelect || radios.length === 0) {
                return;
            }

            const sync = () => {
                const isAll = Array.from(radios).some(radio => radio.checked && radio.value === 'true');
                editDepartmentSelect.disabled = isAll;
            };

            radios.forEach(radio => radio.addEventListener('change', sync));
            sync();
        });
    </script>
}

