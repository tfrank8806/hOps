@model hOps.web.Models.Property
@{
    ViewData["Title"] = "Delete Property";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>Are you sure you want to delete this property?</h4>
    <div>
        <strong>Code:</strong> @Model.Code <br />
        <strong>Name:</strong> @Model.Name <br />
        <strong>Address:</strong> @Model.Address
    </div>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
