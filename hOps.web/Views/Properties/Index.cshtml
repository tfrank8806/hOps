@model IEnumerable<hOps.web.Models.Property>
@{
    ViewData["Title"] = Html.Localize("Properties");
}

<h2>@Html.Localize("Properties")</h2>
<p>
    <a class="btn btn-primary" asp-action="Create">@Html.Localize("Add New Property")</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.Localize("Code")</th>
            <th>@Html.Localize("Name")</th>
            <th>@Html.Localize("Address")</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var prop in Model)
        {
            <tr>
                <td>@prop.Code</td>
                <td>@prop.Name</td>
                <td>@prop.Address</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@prop.Id" class="btn btn-sm btn-warning">@Html.Localize("Edit")</a>
                    <a asp-action="Delete" asp-route-id="@prop.Id" class="btn btn-sm btn-danger">@Html.Localize("Delete")</a>
                </td>
            </tr>
        }
    </tbody>
</table>
