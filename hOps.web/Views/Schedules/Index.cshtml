@model hOps.web.ViewModels.Schedules.SchedulePageViewModel
@{
    ViewData["Title"] = "Schedules";
    var weekStartParam = Model.WeekStartDate.ToString("yyyy-MM-dd");
    var previousWeek = Model.WeekStartDate.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.WeekStartDate.AddDays(7).ToString("yyyy-MM-dd");
    string? successMessage = Model.AlertMessage;
    string? errorMessage = ViewBag.ScheduleError as string;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-0">@Model.PropertyName</h2>
        <p class="text-muted mb-0">@Model.WeekStartDate.ToString("MMM d") - @Model.WeekEndDate.ToString("MMM d, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-weekStart="@previousWeek" asp-route-sortOption="@Model.SortOption">&larr; Previous</a>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-weekStart="@nextWeek" asp-route-sortOption="@Model.SortOption">Next &rarr;</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-4 schedule-page">
    <div class="col-12 col-xl-9 col-xxl-9">
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
                    <div>
                        <h5 class="card-title mb-0">Schedule</h5>
                        @if (Model.Status.HasValue)
                        {
                            <span class="badge @(Model.Status == hOps.web.Models.ScheduleStatus.Posted ? "bg-success" : "bg-warning text-dark")">
                                @Model.Status
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No schedule</span>
                        }
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        @if (!Model.HasSchedule && Model.ShowCreateDraftAction)
                        {
                            <form asp-action="CreateDraft" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="weekStart" value="@weekStartParam" />
                                <button type="submit" class="btn btn-primary">Create Draft</button>
                            </form>
                        }
                        @if (Model.ShowPostAction && Model.ScheduleId.HasValue)
                        {
                            var postLabel = Model.WasPreviouslyPosted ? "Re-post Schedule" : "Post Schedule";
                            <form asp-action="PostSchedule" asp-controller="Schedules" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="scheduleId" value="@Model.ScheduleId" />
                                <input type="hidden" name="weekStart" value="@weekStartParam" />
                                <button type="submit" class="btn btn-success">@postLabel</button>
                            </form>
                        }
                        @if (Model.ShowUnlockAction && Model.ScheduleId.HasValue)
                        {
                            <form asp-action="UnlockSchedule" asp-controller="Schedules" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="scheduleId" value="@Model.ScheduleId" />
                                <input type="hidden" name="weekStart" value="@weekStartParam" />
                                <button type="submit" class="btn btn-warning">Edit Schedule</button>
                            </form>
                        }
                        @if (Model.HasSchedule && Model.ScheduleId.HasValue)
                        {
                            <a class="btn btn-outline-secondary"
                               asp-action="DownloadSchedule"
                               asp-route-weekStart="@weekStartParam"
                               asp-route-format="pdf">
                                Download PDF
                            </a>
                            <a class="btn btn-outline-secondary"
                               asp-action="DownloadSchedule"
                               asp-route-weekStart="@weekStartParam"
                               asp-route-format="xlsx">
                                Download Excel
                            </a>
                        }
                        @if (Model.HasSchedule && Model.SortOptions?.Any() == true)
                        {
                            <form method="get" class="d-flex align-items-center gap-2" id="scheduleSortForm">
                                <input type="hidden" name="weekStart" value="@weekStartParam" />
                                <label for="scheduleSort" class="form-label small mb-0 text-muted">Sort by</label>
                                <select id="scheduleSort" name="sortOption" class="form-select form-select-sm" onchange="this.form.submit()">
                                    @foreach (var option in Model.SortOptions)
                                    {
                                        <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                                    }
                                </select>
                            </form>
                        }
                    </div>
                </div>

                @if (Model.ShiftAlerts.Any())
                {
                    var firstAlert = Model.ShiftAlerts.First();
                    var remainingCount = Model.ShiftAlerts.Count - 1;
                    var collapseId = "shiftAlertsCollapse";
                    <div class="alert alert-warning" role="alert">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div>
                                <div class="fw-semibold">Shift alerts</div>
                                <div>
                                    @firstAlert.Message
                                    @if (remainingCount > 0)
                                    {
                                        <span class="text-muted">(+@remainingCount more)</span>
                                    }
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                View details
                            </button>
                        </div>
                        <div class="collapse mt-3" id="@collapseId">
                            <ul class="mb-0">
                                @foreach (var alert in Model.ShiftAlerts)
                                {
                                    <li>@alert.Message</li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                @if (!Model.HasSchedule)
                {
                    <p class="text-muted mb-0">No schedule exists for this week.</p>
                }
                else
                {
                    <div class="table-responsive schedule-grid-wrapper">
                        <table class="table table-bordered align-middle schedule-grid">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 180px;">Employee</th>
                                    @foreach (var day in Model.DayColumns)
                                    {
                                        <th scope="col">@day.Label</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.EmployeeRows.Any())
                                {
                                    foreach (var row in Model.EmployeeRows)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <div class="fw-semibold">@row.EmployeeName</div>
                                                        <div class="text-muted small">@row.SourceLabel @(row.IsActive ? "" : "(Inactive)")</div>
                                                    </div>
                                                    @if (Model.CanManage && Model.Status == hOps.web.Models.ScheduleStatus.Draft && Model.ScheduleId.HasValue)
                                                    {
                                                        <form asp-action="RemoveEmployeeFromSchedule"
                                                              method="post"
                                                              class="ms-2"
                                                              onsubmit="return confirm('Remove @row.EmployeeName from this schedule?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="scheduleId" value="@Model.ScheduleId" />
                                                            <input type="hidden" name="scheduleEmployeeId" value="@row.ScheduleEmployeeId" />
                                                            <input type="hidden" name="weekStart" value="@weekStartParam" />
                                                            <button type="submit"
                                                                    class="btn btn-outline-danger btn-sm px-2 py-1"
                                                                    title="Remove from this schedule"
                                                                    aria-label="Remove @row.EmployeeName from this schedule">
                                                                &times;
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                            @foreach (var day in Model.DayColumns)
                                            {
                                                var dateKey = day.Date.Date;
                                                var isoDate = dateKey.ToString("yyyy-MM-dd");
                                                row.AssignmentsByDate.TryGetValue(dateKey, out var assignments);
                                                row.TimeOffByDate.TryGetValue(dateKey, out var timeOffLabels);
                                                <td class="schedule-cell"
                                                    data-schedule-cell="true"
                                                    data-employee-id="@row.ScheduleEmployeeId"
                                                    data-date="@isoDate">
                                                    @if (assignments != null && assignments.Any())
                                                    {
                                                        foreach (var assignment in assignments)
                                                        {
                                                            var shiftStart = assignment.ShiftStartTime.HasValue
                                                                ? DateTime.Today.Add(assignment.ShiftStartTime.Value).ToString("h:mm tt")
                                                                : null;
                                                            var shiftEnd = assignment.ShiftEndTime.HasValue
                                                                ? DateTime.Today.Add(assignment.ShiftEndTime.Value).ToString("h:mm tt")
                                                                : null;
                                                            string? timeRange = null;
                                                            if (!string.IsNullOrWhiteSpace(shiftStart) && !string.IsNullOrWhiteSpace(shiftEnd))
                                                            {
                                                                timeRange = $"{shiftStart} - {shiftEnd}";
                                                            }
                                                            else if (!string.IsNullOrWhiteSpace(shiftStart))
                                                            {
                                                                timeRange = $"Starts {shiftStart}";
                                                            }
                                                            else if (!string.IsNullOrWhiteSpace(shiftEnd))
                                                            {
                                                                timeRange = $"Ends {shiftEnd}";
                                                            }
                                                            var shiftColor = string.IsNullOrWhiteSpace(assignment.ColorHex) ? null : assignment.ColorHex;
                                                            var shiftLabel = $"{row.EmployeeName} · {assignment.ShiftName} ({dateKey:MMM d})";
                                                            <div class="schedule-shift border rounded p-2 mb-2">
                                                                <div class="fw-semibold" style="color:@shiftColor">@assignment.ShiftName</div>
                                                                @if (!string.IsNullOrWhiteSpace(timeRange))
                                                                {
                                                                    <div class="text-muted small">@timeRange</div>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(assignment.Notes))
                                                                {
                                                                    <div class="small">@assignment.Notes</div>
                                                                }

                                                                @if (Model.CanManage && Model.Status == hOps.web.Models.ScheduleStatus.Draft)
                                                                {
                                                                    <div class="mt-2 d-flex flex-wrap gap-2">
                                                                        <button type="button"
                                                                                class="btn btn-outline-primary btn-sm copy-shift-btn schedule-action-btn"
                                                                                data-assignment-id="@assignment.AssignmentId"
                                                                                data-shift-label="@shiftLabel">
                                                                            Copy
                                                                        </button>
                                                                        <button class="btn btn-outline-secondary btn-sm schedule-action-btn edit-shift-btn"
                                                                                type="button"
                                                                                data-bs-toggle="modal"
                                                                                data-bs-target="#editShiftModal"
                                                                                data-assignment-id="@assignment.AssignmentId"
                                                                                data-employee-id="@row.ScheduleEmployeeId"
                                                                                data-employee-name="@row.EmployeeName"
                                                                                data-shift-date="@isoDate"
                                                                                data-date-label="@dateKey.ToString("MMM d")"
                                                                                data-shift-name="@assignment.ShiftName"
                                                                                data-shift-start="@assignment.ShiftStartTime?.ToString("hh\\:mm")"
                                                                                data-shift-end="@assignment.ShiftEndTime?.ToString("hh\\:mm")"
                                                                                data-notes="@assignment.Notes"
                                                                                data-color="@assignment.ColorHex">
                                                                            Edit
                                                                        </button>
                                                                        <form asp-action="DeleteAssignment" method="post" onsubmit="return confirm('Remove this shift?');">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="assignmentId" value="@assignment.AssignmentId" />
                                                                            <input type="hidden" name="weekStart" value="@weekStartParam" />
                                                                            <button type="submit" class="btn btn-outline-danger btn-sm schedule-action-btn">Remove</button>
                                                                        </form>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                    @if (timeOffLabels != null)
                                                    {
                                                        foreach (var badge in timeOffLabels)
                                                        {
                                                            <span class="badge bg-info text-dark">@badge.Label</span>
                                                        }
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                else
                {
                    <tr>
                        <td colspan="@((Model.DayColumns.Count + 1))" class="text-center text-muted">No employees or shifts for this week.</td>
                    </tr>
                }
            </tbody>
        </table>
                    <p class="text-muted small mt-3">Tip: Double-click a cell to pre-fill the Add Shift form. Copy a shift card to paste it into another day or teammate.</p>
    </div>
}
            </div>
        </div>

        @if (Model.CanManage && Model.Status == hOps.web.Models.ScheduleStatus.Draft && Model.ScheduleId.HasValue)
        {
            <form id="pasteShiftForm" asp-action="PasteAssignment" method="post" class="d-none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="scheduleId" value="@Model.ScheduleId" />
                <input type="hidden" name="sourceAssignmentId" />
                <input type="hidden" name="targetEmployeeId" />
                <input type="hidden" name="targetDate" />
                <input type="hidden" name="weekStart" value="@weekStartParam" />
            </form>
        }
    </div>

    <div class="col-12 col-xl-3 col-xxl-3">
        <div class="schedule-side-panel">
            <div class="card mb-4">
                <div class="card-body">
                    <h5>Add Shift</h5>
                    @if (!Model.HasSchedule)
                    {
                        <p class="text-muted mb-0">Create a schedule draft before adding shifts.</p>
                    }
                    else if (!Model.CanManage)
                    {
                        <p class="text-muted mb-0">Only managers can edit the schedule.</p>
                    }
                    else
                    {
                        <div id="scheduleClipboardStatus" class="alert alert-info small d-none"></div>
                        <form id="addShiftForm" asp-action="AddAssignment" method="post" class="row g-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="AssignmentForm.ScheduleId" />
                            <input type="hidden" asp-for="AssignmentForm.ShiftColorHex" id="shiftColorInput" />
                            <input type="hidden" name="weekStart" value="@weekStartParam" />
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="col-12">
                                <label asp-for="AssignmentForm.ScheduleEmployeeId" class="form-label"></label>
                                <select asp-for="AssignmentForm.ScheduleEmployeeId" class="form-select">
                                    <option value="">-- Select --</option>
                                    @foreach (var option in Model.EmployeeOptions)
                                    {
                                        <option value="@option.Id">@option.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label asp-for="AssignmentForm.ShiftTemplateId" class="form-label"></label>
                                <select name="AssignmentForm.ShiftTemplateId" class="form-select" id="shiftTemplateSelect">
                                    <option value="">Custom</option>
                                    @for (var i = 0; i < Model.ShiftTemplates.Count; i++)
                                    {
                                        var template = Model.ShiftTemplates[i];
                                        var templateStart = template.StartTime.ToString("hh\\:mm");
                                        var templateEnd = template.EndTime.ToString("hh\\:mm");
                                        var templateColor = string.IsNullOrWhiteSpace(template.ColorHex) ? "#3b82f6" : template.ColorHex;
                                        var templateShiftName = string.IsNullOrWhiteSpace(template.ShiftName) ? template.Name : template.ShiftName;
                                        <option value="@template.Id"
                                                data-shift-name="@templateShiftName"
                                                data-start="@templateStart"
                                                data-end="@templateEnd"
                                                data-color="@templateColor">
                                            @template.Name (@templateStart - @templateEnd)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AssignmentForm.ShiftDate" class="form-label"></label>
                                <input asp-for="AssignmentForm.ShiftDate" class="form-control" type="date" value="@Model.AssignmentForm.ShiftDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AssignmentForm.ShiftStartTime" class="form-label"></label>
                                <input asp-for="AssignmentForm.ShiftStartTime" class="form-control" type="time" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AssignmentForm.ShiftEndTime" class="form-label"></label>
                                <input asp-for="AssignmentForm.ShiftEndTime" class="form-control" type="time" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AssignmentForm.ShiftName" class="form-label"></label>
                                <input asp-for="AssignmentForm.ShiftName" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">@Html.DisplayNameFor(m => m.AssignmentForm.RepeatOnDays)</label>
                                <div class="d-flex flex-wrap gap-2" data-repeat-day-group>
                                    @{
                                        var repeatDays = Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek>().ToList();
                                        foreach (var day in repeatDays)
                                        {
                                            var checkboxId = $"repeatDay_{day}";
                                            var isChecked = Model.AssignmentForm.RepeatOnDays?.Contains(day) ?? false;
                                            var label = day.ToString().Substring(0, 3);
                                            <div class="btn-group btn-group-sm" role="group">
                                                <input class="btn-check" type="checkbox" value="@day" id="@checkboxId" name="AssignmentForm.RepeatOnDays" data-repeat-day @(isChecked ? "checked" : null) />
                                                <label class="btn btn-outline-secondary" for="@checkboxId">@label</label>
                                            </div>
                                        }
                                    }
                                </div>
                                <small class="text-muted">Select additional days in this week for this shift.</small>
                            </div>
                            <div class="col-12">
                                <label asp-for="AssignmentForm.Notes" class="form-label"></label>
                                <textarea asp-for="AssignmentForm.Notes" class="form-control"></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary w-100">Add Shift</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        <div class="card mb-4">
            <div class="card-body">
                <h5>Request Time Off</h5>
                <form asp-action="SubmitTimeOff" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="weekStart" value="@weekStartParam" />
                    <div class="mb-3">
                        <label asp-for="TimeOffForm.StartDate" class="form-label"></label>
                        <input asp-for="TimeOffForm.StartDate" class="form-control" type="date" value="@Model.TimeOffForm.StartDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="TimeOffForm.EndDate" class="form-label"></label>
                        <input asp-for="TimeOffForm.EndDate" class="form-control" type="date" value="@Model.TimeOffForm.EndDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="TimeOffForm.Reason" class="form-label"></label>
                        <textarea asp-for="TimeOffForm.Reason" class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-secondary w-100">Submit Request</button>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5>My Requests</h5>
                @if (Model.MyRequests.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var request in Model.MyRequests)
                        {
                            <li class="list-group-item px-0">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <div class="fw-semibold">@request.StartDate.ToString("MMM d") - @request.EndDate.ToString("MMM d")</div>
                                        <div class="text-muted small">@request.Reason</div>
                                    </div>
                                    <span class="badge @(request.Status == hOps.web.Models.TimeOffRequestStatus.Approved ? "bg-success" : request.Status == hOps.web.Models.TimeOffRequestStatus.Denied ? "bg-danger" : "bg-secondary")">@request.Status</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">No requests yet.</p>
                }
            </div>
        </div>

        @if (Model.CanManage)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5>Pending Requests</h5>
                    @if (Model.PendingRequests.Any())
                    {
                        foreach (var request in Model.PendingRequests)
                        {
                            <div class="border rounded p-2 mb-2">
                                <div class="fw-semibold">@request.EmployeeName</div>
                                <div class="text-muted small">@request.StartDate.ToString("MMM d") - @request.EndDate.ToString("MMM d")</div>
                                <p class="mb-2">@request.Reason</p>
                                <form asp-action="DecideRequest" method="post" class="row g-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@request.Id" />
                                    <input type="hidden" name="weekStart" value="@weekStartParam" />
                                    <div class="col-12">
                                        <input type="text" name="notes" class="form-control form-control-sm" placeholder="Notes (optional)" />
                                    </div>
                                    <div class="col-6 d-grid">
                                        <button type="submit" name="decision" value="approve" class="btn btn-success btn-sm">Approve</button>
                                    </div>
                                    <div class="col-6 d-grid">
                                        <button type="submit" name="decision" value="deny" class="btn btn-outline-danger btn-sm">Deny</button>
                                    </div>
                                </form>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No pending requests.</p>
                    }
                </div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-body">
                <h5>Schedule Settings</h5>
                <p class="mb-1"><strong>Week starts on:</strong> @Model.SettingsSummary.StartDayOfWeek</p>
                <p class="mb-2"><strong>Default shifts:</strong> @Model.SettingsSummary.ShiftTemplateCount</p>
                @if (!string.IsNullOrWhiteSpace(Model.SettingsSummary.SettingsUrl))
                {
                    <a class="btn btn-link p-0" href="@Model.SettingsSummary.SettingsUrl">Edit schedule setup</a>
                }
            </div>
        </div>

        @if (Model.CanManage)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5>Add Employee</h5>
                    <form asp-action="AddEmployee" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="weekStart" value="@weekStartParam" />
                        <div class="mb-3">
                            <label asp-for="EmployeeForm.DisplayName" class="form-label"></label>
                            <input asp-for="EmployeeForm.DisplayName" class="form-control" />
                            <span asp-validation-for="EmployeeForm.DisplayName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="EmployeeForm.Email" class="form-label"></label>
                            <input asp-for="EmployeeForm.Email" class="form-control" />
                            <span asp-validation-for="EmployeeForm.Email" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="EmployeeForm.EmailAlertsEnabled" class="form-check-input" />
                            <label asp-for="EmployeeForm.EmailAlertsEnabled" class="form-check-label"></label>
                        </div>
                        <button type="submit" class="btn btn-outline-primary w-100">Add Employee</button>
                    </form>
                </div>
            </div>
        }
        </div>
    </div>
</div>

@if (Model.CanManage && Model.Status == hOps.web.Models.ScheduleStatus.Draft)
{
    <div class="modal fade" id="editShiftModal" tabindex="-1" aria-labelledby="editShiftModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form id="editShiftForm" asp-action="UpdateAssignment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="AssignmentForm.AssignmentId" />
                    <input type="hidden" name="AssignmentForm.ScheduleId" value="@Model.ScheduleId" />
                    <input type="hidden" name="AssignmentForm.ShiftColorHex" />
                    <input type="hidden" name="weekStart" value="@weekStartParam" />
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title" id="editShiftModalLabel">Edit Shift</h5>
                            <p class="text-muted small mb-0" data-edit-shift-meta></p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Employee</label>
                                <select name="AssignmentForm.ScheduleEmployeeId" class="form-select">
                                    <option value="">-- Select --</option>
                                    @foreach (var option in Model.EmployeeOptions)
                                    {
                                        <option value="@option.Id">@option.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">Shift Date</label>
                                <input type="date" name="AssignmentForm.ShiftDate" class="form-control" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">Shift Name</label>
                                <input type="text" name="AssignmentForm.ShiftName" class="form-control" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">Start Time</label>
                                <input type="time" name="AssignmentForm.ShiftStartTime" class="form-control" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">End Time</label>
                                <input type="time" name="AssignmentForm.ShiftEndTime" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Notes</label>
                                <textarea name="AssignmentForm.Notes" class="form-control" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/schedules.js" asp-append-version="true"></script>
}
