@model hOps.web.ViewModels.Schedules.SchedulePageViewModel
@{
    ViewData["Title"] = "Schedules";
    var weekStartParam = Model.WeekStartDate.ToString("yyyy-MM-dd");
    var previousWeek = Model.WeekStartDate.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.WeekStartDate.AddDays(7).ToString("yyyy-MM-dd");
    string? successMessage = Model.AlertMessage;
    string? errorMessage = ViewBag.ScheduleError as string;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-0">@Model.PropertyName</h2>
        <p class="text-muted mb-0">@Model.WeekStartDate.ToString("MMM d") - @Model.WeekEndDate.ToString("MMM d, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-weekStart="@previousWeek">&larr; Previous</a>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-weekStart="@nextWeek">Next &rarr;</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="card-title mb-0">Schedule</h5>
                        @if (Model.Status.HasValue)
                        {
                            <span class="badge @(Model.Status == hOps.web.Models.ScheduleStatus.Posted ? "bg-success" : "bg-warning text-dark")">
                                @Model.Status
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No schedule</span>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        @if (!Model.HasSchedule && Model.ShowCreateDraftAction)
                        {
                            <form asp-action="CreateDraft" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="weekStart" value="@weekStartParam" />
                                <button type="submit" class="btn btn-primary">Create Draft</button>
                            </form>
                        }
                        @if (Model.ShowPostAction && Model.ScheduleId.HasValue)
                        {
                            <form asp-action="PostSchedule" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="scheduleId" value="@Model.ScheduleId" />
                                <input type="hidden" name="weekStart" value="@weekStartParam" />
                                <button type="submit" class="btn btn-success">Post Schedule</button>
                            </form>
                        }
                    </div>
                </div>

                @if (!Model.HasSchedule)
                {
                    <p class="text-muted mb-0">No schedule exists for this week.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle schedule-grid">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 180px;">Employee</th>
                                    @foreach (var day in Model.DayColumns)
                                    {
                                        <th scope="col">@day.Label</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.EmployeeRows.Any())
                                {
                                    foreach (var row in Model.EmployeeRows)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@row.EmployeeName</div>
                                                <div class="text-muted small">@row.SourceLabel @(row.IsActive ? "" : "(Inactive)")</div>
                                            </td>
                                            @foreach (var day in Model.DayColumns)
                                            {
                                                var dateKey = day.Date.Date;
                                                row.AssignmentsByDate.TryGetValue(dateKey, out var assignments);
                                                row.TimeOffByDate.TryGetValue(dateKey, out var timeOffLabels);
                                                <td>
                                                    @if (assignments != null && assignments.Any())
                                                    {
                                                        foreach (var assignment in assignments)
                                                        {
                                                            var shiftStart = assignment.ShiftStartTime?.ToString("hh\\:mm");
                                                            var shiftEnd = assignment.ShiftEndTime?.ToString("hh\\:mm");
                                                            var timeRange = string.IsNullOrWhiteSpace(shiftStart) && string.IsNullOrWhiteSpace(shiftEnd)
                                                                ? null
                                                                : $"{shiftStart} - {shiftEnd}";
                                                            <div class="schedule-shift border rounded p-2 mb-2">
                                                                <div class="fw-semibold">@assignment.ShiftName</div>
                                                                @if (!string.IsNullOrWhiteSpace(timeRange))
                                                                {
                                                                    <div class="text-muted small">@timeRange</div>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(assignment.Notes))
                                                                {
                                                                    <div class="small">@assignment.Notes</div>
                                                                }

                                                                @if (Model.CanManage && Model.Status == hOps.web.Models.ScheduleStatus.Draft)
                                                                {
                                                                    var collapseId = $"editShift_{assignment.AssignmentId}";
                                                                    <div class="mt-2 d-flex gap-2">
                                                                        <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">Edit</button>
                                                                        <form asp-action="DeleteAssignment" method="post" onsubmit="return confirm('Remove this shift?');">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="assignmentId" value="@assignment.AssignmentId" />
                                                                            <input type="hidden" name="weekStart" value="@weekStartParam" />
                                                                            <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                                                                        </form>
                                                                    </div>
                                                                    <div class="collapse mt-2" id="@collapseId">
                                                                            <form asp-action="UpdateAssignment" method="post">
                                                                                @Html.AntiForgeryToken()
                                                                                <input type="hidden" name="AssignmentForm.AssignmentId" value="@assignment.AssignmentId" />
                                                                                <input type="hidden" name="AssignmentForm.ScheduleId" value="@Model.ScheduleId" />
                                                                                <input type="hidden" name="weekStart" value="@weekStartParam" />
                                                                                <input type="hidden" name="AssignmentForm.RepeatDays" value="1" />
                                                                                <input type="hidden" name="AssignmentForm.RepeatSkipWeekends" value="false" />
                                                                                <div class="row g-2">
                                                                                <div class="col-12">
                                                                                    <label class="form-label small">Employee</label>
                                                                                    <select name="AssignmentForm.ScheduleEmployeeId" class="form-select form-select-sm">
                                                                                        @foreach (var option in Model.EmployeeOptions)
                                                                                        {
                                                                                            if (option.Id == row.ScheduleEmployeeId)
                                                                                            {
                                                                                                <option value="@option.Id" selected>@option.DisplayName</option>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <option value="@option.Id">@option.DisplayName</option>
                                                                                            }
                                                                                        }
                                                                                    </select>
                                                                                </div>
                                                                                <div class="col-6">
                                                                                    <label class="form-label small">Date</label>
                                                                                    <input type="date" name="AssignmentForm.ShiftDate" value="@dateKey.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                                                                                </div>
                                                                                <div class="col-6">
                                                                                    <label class="form-label small">Shift Name</label>
                                                                                    <input type="text" name="AssignmentForm.ShiftName" value="@assignment.ShiftName" class="form-control form-control-sm" />
                                                                                </div>
                                                                                <div class="col-6">
                                                                                    <label class="form-label small">Start</label>
                                                                                    <input type="time" name="AssignmentForm.ShiftStartTime" value="@assignment.ShiftStartTime?.ToString("hh\\:mm")" class="form-control form-control-sm" />
                                                                                </div>
                                                                                <div class="col-6">
                                                                                    <label class="form-label small">End</label>
                                                                                    <input type="time" name="AssignmentForm.ShiftEndTime" value="@assignment.ShiftEndTime?.ToString("hh\\:mm")" class="form-control form-control-sm" />
                                                                                </div>
                                                                                <div class="col-12">
                                                                                    <label class="form-label small">Notes</label>
                                                                                    <textarea name="AssignmentForm.Notes" class="form-control form-control-sm">@assignment.Notes</textarea>
                                                                                </div>
                                                                            </div>
                                                                            <div class="d-flex justify-content-end mt-2">
                                                                                <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                                                            </div>
                                                                        </form>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                    @if (timeOffLabels != null)
                                                    {
                                                        foreach (var badge in timeOffLabels)
                                                        {
                                                            <span class="badge bg-info text-dark">@badge.Label</span>
                                                        }
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@((Model.DayColumns.Count + 1))" class="text-center text-muted">No employees or shifts for this week.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5>Add Shift</h5>
                @if (!Model.HasSchedule)
                {
                    <p class="text-muted mb-0">Create a schedule draft before adding shifts.</p>
                }
                else if (!Model.CanManage)
                {
                    <p class="text-muted mb-0">Only managers can edit the schedule.</p>
                }
                else
                {
                    <form asp-action="AddAssignment" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="AssignmentForm.ScheduleId" />
                        <input type="hidden" name="weekStart" value="@weekStartParam" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="col-md-6">
                            <label asp-for="AssignmentForm.ScheduleEmployeeId" class="form-label"></label>
                            <select asp-for="AssignmentForm.ScheduleEmployeeId" class="form-select">
                                <option value="">-- Select --</option>
                                @foreach (var option in Model.EmployeeOptions)
                                {
                                    <option value="@option.Id">@option.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="AssignmentForm.ShiftDate" class="form-label"></label>
                            <input asp-for="AssignmentForm.ShiftDate" class="form-control" type="date" value="@Model.AssignmentForm.ShiftDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="AssignmentForm.ShiftTemplateId" class="form-label"></label>
                            <select name="AssignmentForm.ShiftTemplateId" class="form-select" id="shiftTemplateSelect">
                                <option value="">Custom</option>
                                @for (var i = 0; i < Model.ShiftTemplates.Count; i++)
                                {
                                    var template = Model.ShiftTemplates[i];
                                    var templateStart = template.StartTime.ToString("hh\\:mm");
                                    var templateEnd = template.EndTime.ToString("hh\\:mm");
                                    <option value="@template.Id"
                                            data-name="@template.Name"
                                            data-start="@templateStart"
                                            data-end="@templateEnd">
                                        @template.Name (@templateStart - @templateEnd)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssignmentForm.ShiftName" class="form-label"></label>
                            <input asp-for="AssignmentForm.ShiftName" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssignmentForm.ShiftStartTime" class="form-label"></label>
                            <input asp-for="AssignmentForm.ShiftStartTime" class="form-control" type="time" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssignmentForm.ShiftEndTime" class="form-label"></label>
                            <input asp-for="AssignmentForm.ShiftEndTime" class="form-control" type="time" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssignmentForm.RepeatDays" class="form-label"></label>
                            <input asp-for="AssignmentForm.RepeatDays" class="form-control" type="number" min="1" max="21" />
                            <small class="text-muted">Includes the first day (max 3 weeks).</small>
                        </div>
                        <div class="col-md-4 d-flex align-items-center">
                            <div class="form-check mt-4">
                                <input asp-for="AssignmentForm.RepeatSkipWeekends" class="form-check-input" />
                                <label asp-for="AssignmentForm.RepeatSkipWeekends" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="AssignmentForm.Notes" class="form-label"></label>
                            <textarea asp-for="AssignmentForm.Notes" class="form-control"></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Add Shift</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-body">
                <h5>Schedule Settings</h5>
                <p class="mb-1"><strong>Week starts on:</strong> @Model.SettingsSummary.StartDayOfWeek</p>
                <p class="mb-2"><strong>Default shifts:</strong> @Model.SettingsSummary.ShiftTemplateCount</p>
                @if (!string.IsNullOrWhiteSpace(Model.SettingsSummary.SettingsUrl))
                {
                    <a class="btn btn-link p-0" href="@Model.SettingsSummary.SettingsUrl">Edit schedule setup</a>
                }
            </div>
        </div>

        @if (Model.CanManage)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5>Add Employee</h5>
                    <form asp-action="AddEmployee" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="weekStart" value="@weekStartParam" />
                        <div class="mb-3">
                            <label asp-for="EmployeeForm.DisplayName" class="form-label"></label>
                            <input asp-for="EmployeeForm.DisplayName" class="form-control" />
                            <span asp-validation-for="EmployeeForm.DisplayName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="EmployeeForm.Email" class="form-label"></label>
                            <input asp-for="EmployeeForm.Email" class="form-control" />
                            <span asp-validation-for="EmployeeForm.Email" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="EmployeeForm.EmailAlertsEnabled" class="form-check-input" />
                            <label asp-for="EmployeeForm.EmailAlertsEnabled" class="form-check-label"></label>
                        </div>
                        <button type="submit" class="btn btn-outline-primary w-100">Add Employee</button>
                    </form>
                </div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-body">
                <h5>Request Time Off</h5>
                <form asp-action="SubmitTimeOff" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="weekStart" value="@weekStartParam" />
                    <div class="mb-3">
                        <label asp-for="TimeOffForm.StartDate" class="form-label"></label>
                        <input asp-for="TimeOffForm.StartDate" class="form-control" type="date" value="@Model.TimeOffForm.StartDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="TimeOffForm.EndDate" class="form-label"></label>
                        <input asp-for="TimeOffForm.EndDate" class="form-control" type="date" value="@Model.TimeOffForm.EndDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="TimeOffForm.Reason" class="form-label"></label>
                        <textarea asp-for="TimeOffForm.Reason" class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-secondary w-100">Submit Request</button>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5>My Requests</h5>
                @if (Model.MyRequests.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var request in Model.MyRequests)
                        {
                            <li class="list-group-item px-0">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <div class="fw-semibold">@request.StartDate.ToString("MMM d") - @request.EndDate.ToString("MMM d")</div>
                                        <div class="text-muted small">@request.Reason</div>
                                    </div>
                                    <span class="badge @(request.Status == hOps.web.Models.TimeOffRequestStatus.Approved ? "bg-success" : request.Status == hOps.web.Models.TimeOffRequestStatus.Denied ? "bg-danger" : "bg-secondary")">@request.Status</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">No requests yet.</p>
                }
            </div>
        </div>

        @if (Model.CanManage)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5>Pending Requests</h5>
                    @if (Model.PendingRequests.Any())
                    {
                        foreach (var request in Model.PendingRequests)
                        {
                            <div class="border rounded p-2 mb-2">
                                <div class="fw-semibold">@request.EmployeeName</div>
                                <div class="text-muted small">@request.StartDate.ToString("MMM d") - @request.EndDate.ToString("MMM d")</div>
                                <p class="mb-2">@request.Reason</p>
                                <form asp-action="DecideRequest" method="post" class="row g-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@request.Id" />
                                    <input type="hidden" name="weekStart" value="@weekStartParam" />
                                    <div class="col-12">
                                        <input type="text" name="notes" class="form-control form-control-sm" placeholder="Notes (optional)" />
                                    </div>
                                    <div class="col-6 d-grid">
                                        <button type="submit" name="decision" value="approve" class="btn btn-success btn-sm">Approve</button>
                                    </div>
                                    <div class="col-6 d-grid">
                                        <button type="submit" name="decision" value="deny" class="btn btn-outline-danger btn-sm">Deny</button>
                                    </div>
                                </form>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No pending requests.</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/schedules.js" asp-append-version="true"></script>
}
