@model hOps.web.ViewModels.Maintenance.MaintenanceLogTemplateEditorViewModel

@{
    var pageTitle = Model.IsEditMode ? Html.Localize("Edit Maintenance Log") : Html.Localize("Maintenance Log");
    ViewData["Title"] = pageTitle;
    var formAction = Model.IsEditMode ? "Edit" : "Create";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-0">@pageTitle</h2>
            <p class="text-muted mb-0">@Model.PropertyName</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="@formAction" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" id="logTemplateForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ScheduleType" class="form-label">@Html.Localize("Schedule")</label>
                        <select asp-for="ScheduleType" class="form-select" id="scheduleTypeSelect">
                            <option value="None">@Html.Localize("None")</option>
                            <option value="Daily">@Html.Localize("Daily")</option>
                            <option value="Weekly">@Html.Localize("Weekly")</option>
                            <option value="Monthly">@Html.Localize("Monthly")</option>
                            <option value="Quarterly">@Html.Localize("Quarterly")</option>
                            <option value="BiAnnual">@Html.Localize("Bi-Annual")</option>
                            <option value="Yearly">@Html.Localize("Annual")</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DueTimeLocal" class="form-label">@Html.Localize("Due Time (optional)")</label>
                        <input asp-for="DueTimeLocal" type="time" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="ChecklistFile">@Html.Localize("Template Checklist (CSV/XLSX)")</label>
                        <input type="file"
                               class="form-control"
                               id="ChecklistFile"
                               name="ChecklistFile"
                               accept=".csv,.xlsx" />
                        @Html.ValidationMessage("ChecklistFile", "", new { @class = "text-danger small" })
                        @if (Model.HasChecklistFile)
                        {
                            <div class="form-text mt-1">
                                @Html.Localize("Current file:")
                                @if (!string.IsNullOrWhiteSpace(Model.ChecklistFilePath))
                                {
                                    <a href="@Model.ChecklistFilePath" target="_blank" rel="noopener">
                        @(string.IsNullOrWhiteSpace(Model.ChecklistFileName) ? Html.Localize("Download Checklist") : Model.ChecklistFileName)
                                    </a>
                                }
                                else
                                {
                                    @(string.IsNullOrWhiteSpace(Model.ChecklistFileName) ? Html.Localize("Checklist file") : Model.ChecklistFileName)
                                }
                                @if (Model.ChecklistFileSizeBytes.HasValue)
                                {
                                    <span class="text-muted ms-1">
                                        (@Math.Round(Model.ChecklistFileSizeBytes.Value / 1024d, 1) KB)
                                    </span>
                                }
                            </div>
                            <div class="form-check mt-2">
                                <input asp-for="RemoveChecklistFile" class="form-check-input" />
                                <label asp-for="RemoveChecklistFile" class="form-check-label">@Html.Localize("Remove existing file")</label>
                            </div>
                        }
                        else
                        {
                            <div class="form-text">@Html.Localize("Optional upload. One CSV or Excel file per template.")</div>
                        }
                    </div>
                    <div class="col-md-6 d-none" id="weeklyDaysFieldset">
                        <label class="form-label">@Html.Localize("Weekly Days")</label>
                        <div class="d-flex flex-wrap gap-3">
                            @{
                                var dayNames = Enum.GetNames(typeof(DayOfWeek));
                                for (var i = 0; i < dayNames.Length; i++)
                                {
                                    <div class="form-check">
                                        <input type="hidden" name="WeeklyDays[@i]" value="false" />
                                        <input class="form-check-input" type="checkbox" name="WeeklyDays[@i]" value="true" @(Model.WeeklyDays.Length > i && Model.WeeklyDays[i] ? "checked" : null) id="weekday-@i" />
                                        <label class="form-check-label" for="weekday-@i">@Html.Localize(dayNames[i])</label>
                                    </div>;
                                }
                            }
                        </div>
                    </div>
                    <div class="col-md-3 d-none" id="monthlyDayFieldset">
                        <label asp-for="DayOfMonth" class="form-label">@Html.Localize("Day of Month")</label>
                        <input asp-for="DayOfMonth" type="number" min="1" max="31" class="form-control" />
                        <span asp-validation-for="DayOfMonth" class="text-danger"></span>
                        <div class="form-text">@Html.Localize("Required for Monthly, Bi-Annual, Quarterly, or Annual schedules.")</div>
                    </div>
                    <div class="col-md-3 d-flex align-items-center">
                        <div class="form-check mt-4 pt-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">@Html.Localize("Active")</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0">@Html.Localize("Columns")</h5>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="addColumnBtn">@Html.Localize("Add Column")</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="uploadColumnsBtn">@Html.Localize("Upload CSV")</button>
                        <a asp-action="DownloadTemplateCsv" class="btn btn-outline-secondary btn-sm">@Html.Localize("Download Blank CSV")</a>
                    </div>
                </div>

                <input type="file"
                       id="columnCsvInput"
                       name="TemplateCsvFile"
                       class="d-none"
                       accept=".csv,text/csv"
                       data-import-url="@Url.Action("PreviewTemplateCsv", "MaintenanceLogs")">
                <div class="text-muted small mb-3">
                    @Html.Localize("CSV columns should be ordered as: Label, Type (text, number, checkbox, select), Required, Options (comma or line break separated), Notes (yes/no), Photos (yes/no).")
                </div>
                <div class="small mb-3 d-none" id="columnCsvStatus"></div>
                @Html.ValidationMessage("TemplateCsvFile", null, new { @class = "text-danger small d-block" })

                <div id="columnsContainer">
                    @{
                        var columns = Model.Columns ?? new List<hOps.web.ViewModels.Maintenance.MaintenanceLogColumnEditorViewModel>();
                        if (columns.Count == 0)
                        {
                            columns.Add(new hOps.web.ViewModels.Maintenance.MaintenanceLogColumnEditorViewModel());
                        }
                        for (var i = 0; i < columns.Count; i++)
                        {
                            var column = columns[i];
                            <div class="border rounded p-3 mb-3 column-editor" data-index="@i">
                                <div class="row g-3">
                                    <div class="col-md-5">
                                        <label class="form-label">@Html.Localize("Label")</label>
                                        <input type="text" name="Columns[@i].Label" value="@column.Label" class="form-control" />
                                        <input type="hidden" name="Columns[@i].Key" value="@column.Key" data-key-input="true" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">@Html.Localize("Type")</label>
                                        <select name="Columns[@i].Type" class="form-select column-type-select">
                                            <option value="text" selected="@(column.Type == "text" ? "selected" : null)">@Html.Localize("Text")</option>
                                            <option value="number" selected="@(column.Type == "number" ? "selected" : null)">@Html.Localize("Number")</option>
                                            <option value="checkbox" selected="@(column.Type == "checkbox" ? "selected" : null)">@Html.Localize("Checkbox")</option>
                                            <option value="select" selected="@(column.Type == "select" ? "selected" : null)">@Html.Localize("Dropdown")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 d-flex align-items-center">
                                        <div class="form-check mt-4 pt-2">
                                            <input class="form-check-input" type="checkbox" name="Columns[@i].Required" value="true" @(column.Required ? "checked" : null) id="column-required-@i" />
                                            <label class="form-check-label" for="column-required-@i">@Html.Localize("Required")</label>
                                            <input type="hidden" name="Columns[@i].Required" value="false" />
                                        </div>
                                    </div>
                                    <div class="col-md-3 d-flex align-items-center">
                                        <div class="form-check mt-4 pt-2">
                                            <input class="form-check-input" type="checkbox" name="Columns[@i].IncludeNotes" value="true" @(column.IncludeNotes ? "checked" : null) id="column-notes-@i" />
                                            <label class="form-check-label" for="column-notes-@i">@Html.Localize("Add Notes Field")</label>
                                            <input type="hidden" name="Columns[@i].IncludeNotes" value="false" />
                                        </div>
                                    </div>
                                    <div class="col-md-2 d-flex align-items-center">
                                        <div class="form-check mt-4 pt-2">
                                            <input class="form-check-input" type="checkbox" name="Columns[@i].IncludePhotos" value="true" @(column.IncludePhotos ? "checked" : null) id="column-photos-@i" />
                                            <label class="form-check-label" for="column-photos-@i">@Html.Localize("Allow Photos")</label>
                                            <input type="hidden" name="Columns[@i].IncludePhotos" value="false" />
                                        </div>
                                    </div>
                                    <div class="col-md-12 column-options-group @(column.Type == "select" ? string.Empty : "d-none")">
                                        <label class="form-label">@Html.Localize("Dropdown Options (one per line)")</label>
                                        <textarea name="Columns[@i].OptionsText" class="form-control" rows="3">@column.OptionsText</textarea>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary move-up-btn" title="@Html.Localize("Move column up")">@Html.Localize("Move Up")</button>
                                        <button type="button" class="btn btn-outline-secondary move-down-btn" title="@Html.Localize("Move column down")">@Html.Localize("Move Down")</button>
                                    </div>
                                    <button type="button" class="btn btn-link text-danger p-0 remove-column-btn" @(columns.Count == 1 ? "disabled" : null)>@Html.Localize("Remove")</button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <template id="columnTemplate">
                    <div class="border rounded p-3 mb-3 column-editor" data-index="__index__">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label class="form-label">@Html.Localize("Label")</label>
                                <input type="text" class="form-control" data-name-template="Columns[__index__].Label" />
                                <input type="hidden" data-name-template="Columns[__index__].Key" data-key-input="true" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">@Html.Localize("Type")</label>
                                <select class="form-select column-type-select" data-name-template="Columns[__index__].Type">
                                    <option value="text" selected>@Html.Localize("Text")</option>
                                    <option value="number">@Html.Localize("Number")</option>
                                    <option value="checkbox">@Html.Localize("Checkbox")</option>
                                    <option value="select">@Html.Localize("Dropdown")</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-center">
                                <div class="form-check mt-4 pt-2">
                                    <input class="form-check-input" type="checkbox" value="true" data-name-template="Columns[__index__].Required" />
                                    <label class="form-check-label">@Html.Localize("Required")</label>
                                    <input type="hidden" value="false" data-name-template="Columns[__index__].Required" data-hidden-marker="true" />
                                </div>
                            </div>
                            <div class="col-md-3 d-flex align-items-center">
                                <div class="form-check mt-4 pt-2">
                                    <input class="form-check-input" type="checkbox" value="true" data-name-template="Columns[__index__].IncludeNotes" />
                                    <label class="form-check-label">@Html.Localize("Add Notes Field")</label>
                                    <input type="hidden" value="false" data-name-template="Columns[__index__].IncludeNotes" data-hidden-marker="true" />
                                </div>
                            </div>
                            <div class="col-md-12 column-options-group d-none">
                                <label class="form-label">@Html.Localize("Dropdown Options (one per line)")</label>
                                <textarea class="form-control" rows="3" data-name-template="Columns[__index__].OptionsText"></textarea>
                            </div>
                            <div class="col-md-12">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" value="true" data-name-template="Columns[__index__].IncludePhotos" />
                                    <label class="form-check-label">@Html.Localize("Allow Photos")</label>
                                    <input type="hidden" value="false" data-name-template="Columns[__index__].IncludePhotos" data-hidden-marker="true" />
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary move-up-btn" title="@Html.Localize("Move column up")">@Html.Localize("Move Up")</button>
                                <button type="button" class="btn btn-outline-secondary move-down-btn" title="@Html.Localize("Move column down")">@Html.Localize("Move Down")</button>
                            </div>
                            <button type="button" class="btn btn-link text-danger p-0 remove-column-btn">@Html.Localize("Remove")</button>
                        </div>
                    </div>
                </template>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">@Html.Localize("Cancel")</a>
                    <button type="submit"
                            class="btn btn-primary"
                            data-submit-btn="true"
                            data-loading-text="@(Model.IsEditMode ? Html.Localize("Saving...") : Html.Localize("Creating..."))">
                        @(Model.IsEditMode ? Html.Localize("Save changes") : Html.Localize("Save Maintenance Log"))
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const t = (key, fallback = key) => {
                if (typeof window.hopsTranslate === 'function') {
                    return window.hopsTranslate(key, fallback);
                }
                return typeof fallback === 'string' && fallback.length ? fallback : key;
            };
            const format = (template, ...values) => {
                if (typeof template !== 'string') {
                    return '';
                }
                return values.reduce((acc, value, index) => acc.replace(`{${index}}`, value), template);
            };
            const scheduleTypeSelect = document.getElementById('scheduleTypeSelect');
            const weeklyFieldset = document.getElementById('weeklyDaysFieldset');
            const monthlyFieldset = document.getElementById('monthlyDayFieldset');
            const monthlyTypes = new Set(['Monthly', 'BiAnnual', 'Quarterly', 'Yearly']);
            const updateScheduleVisibility = () => {
                const value = scheduleTypeSelect?.value ?? 'None';
                if (weeklyFieldset) {
                    weeklyFieldset.classList.toggle('d-none', value !== 'Weekly');
                }
                if (monthlyFieldset) {
                    monthlyFieldset.classList.toggle('d-none', !monthlyTypes.has(value));
                }
            };
            if (scheduleTypeSelect) {
                scheduleTypeSelect.addEventListener('change', updateScheduleVisibility);
                updateScheduleVisibility();
            }

            const formEl = document.getElementById('logTemplateForm');
            const submitBtn = formEl?.querySelector('[data-submit-btn="true"]');
            if (formEl && submitBtn) {
                const originalHtml = submitBtn.innerHTML;
                formEl.addEventListener('submit', () => {
                    if (submitBtn.disabled) {
                        return;
                    }
                    submitBtn.disabled = true;
                    const loadingText = submitBtn.dataset.loadingText || t('Saving...', 'Saving...');
                    submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>${loadingText}`;
                    submitBtn.dataset.originalHtml = originalHtml;
                });
            }

            const container = document.getElementById('columnsContainer');
            const template = document.getElementById('columnTemplate');
            const addBtn = document.getElementById('addColumnBtn');
            if (!container || !template || !addBtn) {
                return;
            }

            const refreshColumnState = () => {
                const rows = Array.from(container.children);
                rows.forEach((row, index) => {
                    row.dataset.index = String(index);
                    row.querySelectorAll('input[name], select[name], textarea[name]').forEach(input => {
                        if (!input.name) {
                            return;
                        }
                        input.name = input.name.replace(/Columns\[\d+\]/, `Columns[${index}]`);
                    });

                    const removeBtn = row.querySelector('.remove-column-btn');
                    if (removeBtn) {
                        removeBtn.disabled = rows.length <= 1;
                    }

                    const upBtn = row.querySelector('.move-up-btn');
                    if (upBtn) {
                        upBtn.disabled = index === 0;
                    }

                    const downBtn = row.querySelector('.move-down-btn');
                    if (downBtn) {
                        downBtn.disabled = index === rows.length - 1;
                    }
                });
            };

            const bindColumnRow = (row) => {
                row.querySelectorAll('.column-type-select').forEach(select => {
                    select.addEventListener('change', event => {
                        const optionsGroup = event.target.closest('.column-editor')?.querySelector('.column-options-group');
                        if (!optionsGroup) {
                            return;
                        }
                        optionsGroup.classList.toggle('d-none', event.target.value !== 'select');
                    });
                    select.dispatchEvent(new Event('change'));
                });

                const removeBtn = row.querySelector('.remove-column-btn');
                if (removeBtn) {
                    removeBtn.addEventListener('click', () => {
                        if (container.children.length <= 1) {
                            return;
                        }
                        row.remove();
                        refreshColumnState();
                    });
                }

                const moveUpBtn = row.querySelector('.move-up-btn');
                if (moveUpBtn) {
                    moveUpBtn.addEventListener('click', () => {
                        const previous = row.previousElementSibling;
                        if (previous) {
                            container.insertBefore(row, previous);
                            refreshColumnState();
                        }
                    });
                }

                const moveDownBtn = row.querySelector('.move-down-btn');
                if (moveDownBtn) {
                    moveDownBtn.addEventListener('click', () => {
                        const next = row.nextElementSibling;
                        if (next) {
                            container.insertBefore(next, row);
                            refreshColumnState();
                        }
                    });
                }
            };

            const setColumnValues = (row, data = {}) => {
                if ('label' in data) {
                    const input = row.querySelector('input[name$=".Label"]');
                    if (input) {
                        input.value = data.label ?? '';
                    }
                }

                if ('key' in data) {
                    const keyInput = row.querySelector('[data-key-input]');
                    if (keyInput) {
                        keyInput.value = data.key ?? '';
                    }
                }

                const typeSelect = row.querySelector('.column-type-select');
                if (typeSelect) {
                    if ('type' in data && data.type) {
                        typeSelect.value = data.type;
                    }
                    typeSelect.dispatchEvent(new Event('change'));
                }

                if ('required' in data) {
                    const requiredInput = row.querySelector('input[type="checkbox"][name$=".Required"]');
                    if (requiredInput) {
                        requiredInput.checked = Boolean(data.required);
                    }
                }

                if ('includeNotes' in data) {
                    const notesInput = row.querySelector('input[type="checkbox"][name$=".IncludeNotes"]');
                    if (notesInput) {
                        notesInput.checked = Boolean(data.includeNotes);
                    }
                }

                if ('includePhotos' in data) {
                    const photosInput = row.querySelector('input[type="checkbox"][name$=".IncludePhotos"]');
                    if (photosInput) {
                        photosInput.checked = Boolean(data.includePhotos);
                    }
                }

                if ('optionsText' in data) {
                    const optionsArea = row.querySelector('textarea[name$=".OptionsText"]');
                    if (optionsArea) {
                        optionsArea.value = data.optionsText ?? '';
                    }
                }
            };

            const createColumnFromTemplate = (data = {}) => {
                const fragment = template.content.cloneNode(true);
                const nextIndex = container.children.length;
                fragment.querySelectorAll('[data-name-template]').forEach(element => {
                    const templateName = element.dataset.nameTemplate;
                    if (!templateName) {
                        return;
                    }
                    element.name = templateName.replace(/__index__/g, nextIndex);
                    if (element.dataset.hiddenMarker === 'true') {
                        element.value = 'false';
                    } else if (element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement) {
                        if (element.type === 'checkbox') {
                            element.checked = false;
                        } else {
                            element.value = '';
                        }
                    }
                });

                container.appendChild(fragment);
                const newRow = container.lastElementChild;
                if (!newRow) {
                    return;
                }
                bindColumnRow(newRow);
                setColumnValues(newRow, data);
                refreshColumnState();
            };

            addBtn.addEventListener('click', () => createColumnFromTemplate());

            Array.from(container.children).forEach(row => bindColumnRow(row));
            refreshColumnState();

            const csvInput = document.getElementById('columnCsvInput');
            const uploadBtn = document.getElementById('uploadColumnsBtn');
            const statusEl = document.getElementById('columnCsvStatus');
            const showCsvStatus = (message, state = 'success') => {
                if (!statusEl) {
                    return;
                }
                statusEl.classList.remove('d-none', 'text-danger', 'text-success', 'text-muted');
                if (state === 'error') {
                    statusEl.classList.add('text-danger');
                } else if (state === 'muted') {
                    statusEl.classList.add('text-muted');
                } else {
                    statusEl.classList.add('text-success');
                }
                statusEl.textContent = message;
            };

            const getAntiforgeryToken = () => formEl?.querySelector('input[name="__RequestVerificationToken"]')?.value
                ?? document.querySelector('input[name="__RequestVerificationToken"]')?.value
                ?? '';

            const importColumns = async (file) => {
                if (!csvInput) {
                    return;
                }

                const importUrl = csvInput.dataset.importUrl;
                if (!importUrl) {
                    showCsvStatus(t('Import endpoint is unavailable.', 'Import endpoint is unavailable.'), 'error');
                    return;
                }

                const formData = new FormData();
                formData.append('csvFile', file);

                const headers = {};
                const token = getAntiforgeryToken();
                if (token) {
                    headers['RequestVerificationToken'] = token;
                }

                const defaultError = t('Unable to import the CSV file.', 'Unable to import the CSV file.');
                try {
                    showCsvStatus(t('Importing columns...', 'Importing columns...'), 'muted');
                    const response = await fetch(importUrl, {
                        method: 'POST',
                        headers,
                        body: formData
                    });

                    let payload = null;
                    try {
                        payload = await response.json();
                    } catch {
                        payload = null;
                    }

                    if (!response.ok) {
                        const errorMessage = payload?.error ? t(payload.error, payload.error) : defaultError;
                        throw new Error(errorMessage);
                    }

                    const imported = Array.isArray(payload?.columns) ? payload.columns : [];
                    if (imported.length === 0) {
                        throw new Error(t('The CSV file did not include any columns.', 'The CSV file did not include any columns.'));
                    }

                    container.innerHTML = '';
                    imported.forEach(column => createColumnFromTemplate(column));
                    refreshColumnState();
                    const importedMessage = imported.length === 1
                        ? format(t('Imported {0} column.', 'Imported {0} column.'), imported.length)
                        : format(t('Imported {0} columns.', 'Imported {0} columns.'), imported.length);
                    showCsvStatus(importedMessage);
                } catch (error) {
                    const errorMessage = (typeof error?.message === 'string' && error.message.length)
                        ? t(error.message, error.message)
                        : defaultError;
                    showCsvStatus(errorMessage, 'error');
                }
            };

            if (uploadBtn && csvInput) {
                uploadBtn.addEventListener('click', () => {
                    csvInput.value = '';
                    csvInput.click();
                });
                csvInput.addEventListener('change', () => {
                    const file = csvInput.files && csvInput.files[0];
                    if (!file) {
                        return;
                    }
                    importColumns(file);
                });
            }
        })();
    </script>
}

