@model hOps.web.ViewModels.Maintenance.MaintenanceLogTemplateEditorViewModel

@{
    var pageTitle = Model.IsEditMode ? "Edit Maintenance Log Template" : "Create Maintenance Log Template";
    ViewData["Title"] = pageTitle;
    var formAction = Model.IsEditMode ? "Edit" : "Create";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-0">@pageTitle</h2>
            <p class="text-muted mb-0">@Model.PropertyName</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="@formAction" asp-route-id="@Model.Id" method="post" id="logTemplateForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ScheduleType" class="form-label">Schedule</label>
                        <select asp-for="ScheduleType" class="form-select" id="scheduleTypeSelect">
                            <option value="None">None</option>
                            <option value="Daily">Daily</option>
                            <option value="Weekly">Weekly</option>
                            <option value="Monthly">Monthly</option>
                            <option value="Quarterly">Quarterly</option>
                            <option value="Yearly">Yearly</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DueTimeLocal" class="form-label">Due Time (optional)</label>
                        <input asp-for="DueTimeLocal" type="time" class="form-control" />
                    </div>
                    <div class="col-md-6 d-none" id="weeklyDaysFieldset">
                        <label class="form-label">Weekly Days</label>
                        <div class="d-flex flex-wrap gap-3">
                            @{
                                var dayNames = Enum.GetNames(typeof(DayOfWeek));
                                for (var i = 0; i < dayNames.Length; i++)
                                {
                                    <div class="form-check">
                                        <input type="hidden" name="WeeklyDays[@i]" value="false" />
                                        <input class="form-check-input" type="checkbox" name="WeeklyDays[@i]" value="true" @(Model.WeeklyDays.Length > i && Model.WeeklyDays[i] ? "checked" : null) id="weekday-@i" />
                                        <label class="form-check-label" for="weekday-@i">@dayNames[i]</label>
                                    </div>;
                                }
                            }
                        </div>
                    </div>
                    <div class="col-md-3 d-none" id="monthlyDayFieldset">
                        <label asp-for="DayOfMonth" class="form-label">Day of Month</label>
                        <input asp-for="DayOfMonth" type="number" min="1" max="31" class="form-control" />
                        <span asp-validation-for="DayOfMonth" class="text-danger"></span>
                        <div class="form-text">Required for Monthly, Quarterly, or Yearly schedules.</div>
                    </div>
                    <div class="col-md-3 d-flex align-items-center">
                        <div class="form-check mt-4 pt-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0">Columns</h5>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="addColumnBtn">Add Column</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="uploadColumnsBtn">Upload CSV</button>
                        <a asp-action="DownloadTemplateCsv" class="btn btn-outline-secondary btn-sm">Download Blank CSV</a>
                    </div>
                </div>

                <input type="file"
                       id="columnCsvInput"
                       class="d-none"
                       accept=".csv,text/csv"
                       data-import-url="@Url.Action("PreviewTemplateCsv", "MaintenanceLogs")">
                <div class="text-muted small mb-3">
                    CSV columns should be ordered as: Label, Key, Type (text, number, checkbox, select), Required, Options (comma or line break separated).
                </div>
                <div class="small mb-3 d-none" id="columnCsvStatus"></div>

                <div id="columnsContainer">
                    @{
                        var columns = Model.Columns ?? new List<hOps.web.ViewModels.Maintenance.MaintenanceLogColumnEditorViewModel>();
                        if (columns.Count == 0)
                        {
                            columns.Add(new hOps.web.ViewModels.Maintenance.MaintenanceLogColumnEditorViewModel());
                        }
                        for (var i = 0; i < columns.Count; i++)
                        {
                            var column = columns[i];
                            <div class="border rounded p-3 mb-3 column-editor" data-index="@i">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Label</label>
                                        <input type="text" name="Columns[@i].Label" value="@column.Label" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Key</label>
                                        <input type="text" name="Columns[@i].Key" value="@column.Key" class="form-control" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Type</label>
                                        <select name="Columns[@i].Type" class="form-select column-type-select">
                                            <option value="text" selected="@(column.Type == "text" ? "selected" : null)">Text</option>
                                            <option value="number" selected="@(column.Type == "number" ? "selected" : null)">Number</option>
                                            <option value="checkbox" selected="@(column.Type == "checkbox" ? "selected" : null)">Checkbox</option>
                                            <option value="select" selected="@(column.Type == "select" ? "selected" : null)">Dropdown</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 d-flex align-items-center">
                                        <div class="form-check mt-4 pt-2">
                                            <input class="form-check-input" type="checkbox" name="Columns[@i].Required" value="true" @(column.Required ? "checked" : null) id="column-required-@i" />
                                            <label class="form-check-label" for="column-required-@i">Required</label>
                                            <input type="hidden" name="Columns[@i].Required" value="false" />
                                        </div>
                                    </div>
                                    <div class="col-md-12 column-options-group @(column.Type == "select" ? string.Empty : "d-none")">
                                        <label class="form-label">Dropdown Options (one per line)</label>
                                        <textarea name="Columns[@i].OptionsText" class="form-control" rows="3">@column.OptionsText</textarea>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary move-up-btn" title="Move column up">Move Up</button>
                                        <button type="button" class="btn btn-outline-secondary move-down-btn" title="Move column down">Move Down</button>
                                    </div>
                                    <button type="button" class="btn btn-link text-danger p-0 remove-column-btn" @(columns.Count == 1 ? "disabled" : null)>Remove</button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <template id="columnTemplate">
                    <div class="border rounded p-3 mb-3 column-editor" data-index="__index__">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Label</label>
                                <input type="text" class="form-control" data-name-template="Columns[__index__].Label" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Key</label>
                                <input type="text" class="form-control" data-name-template="Columns[__index__].Key" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Type</label>
                                <select class="form-select column-type-select" data-name-template="Columns[__index__].Type">
                                    <option value="text" selected>Text</option>
                                    <option value="number">Number</option>
                                    <option value="checkbox">Checkbox</option>
                                    <option value="select">Dropdown</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-center">
                                <div class="form-check mt-4 pt-2">
                                    <input class="form-check-input" type="checkbox" value="true" data-name-template="Columns[__index__].Required" />
                                    <label class="form-check-label">Required</label>
                                    <input type="hidden" value="false" data-name-template="Columns[__index__].Required" data-hidden-marker="true" />
                                </div>
                            </div>
                            <div class="col-md-12 column-options-group d-none">
                                <label class="form-label">Dropdown Options (one per line)</label>
                                <textarea class="form-control" rows="3" data-name-template="Columns[__index__].OptionsText"></textarea>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary move-up-btn" title="Move column up">Move Up</button>
                                <button type="button" class="btn btn-outline-secondary move-down-btn" title="Move column down">Move Down</button>
                            </div>
                            <button type="button" class="btn btn-link text-danger p-0 remove-column-btn">Remove</button>
                        </div>
                    </div>
                </template>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit"
                            class="btn btn-primary"
                            data-submit-btn="true"
                            data-loading-text="@(Model.IsEditMode ? "Saving..." : "Creating...")">
                        @(Model.IsEditMode ? "Save Changes" : "Create Template")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const scheduleTypeSelect = document.getElementById('scheduleTypeSelect');
            const weeklyFieldset = document.getElementById('weeklyDaysFieldset');
            const monthlyFieldset = document.getElementById('monthlyDayFieldset');
            const monthlyTypes = new Set(['Monthly', 'Quarterly', 'Yearly']);
            const updateScheduleVisibility = () => {
                const value = scheduleTypeSelect?.value ?? 'None';
                if (weeklyFieldset) {
                    weeklyFieldset.classList.toggle('d-none', value !== 'Weekly');
                }
                if (monthlyFieldset) {
                    monthlyFieldset.classList.toggle('d-none', !monthlyTypes.has(value));
                }
            };
            if (scheduleTypeSelect) {
                scheduleTypeSelect.addEventListener('change', updateScheduleVisibility);
                updateScheduleVisibility();
            }

            const formEl = document.getElementById('logTemplateForm');
            const submitBtn = formEl?.querySelector('[data-submit-btn="true"]');
            if (formEl && submitBtn) {
                const originalHtml = submitBtn.innerHTML;
                formEl.addEventListener('submit', () => {
                    if (submitBtn.disabled) {
                        return;
                    }
                    submitBtn.disabled = true;
                    const loadingText = submitBtn.dataset.loadingText || 'Saving...';
                    submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>${loadingText}`;
                    submitBtn.dataset.originalHtml = originalHtml;
                });
            }

            const container = document.getElementById('columnsContainer');
            const template = document.getElementById('columnTemplate');
            const addBtn = document.getElementById('addColumnBtn');
            if (!container || !template || !addBtn) {
                return;
            }

            const refreshColumnState = () => {
                const rows = Array.from(container.children);
                rows.forEach((row, index) => {
                    row.dataset.index = String(index);
                    row.querySelectorAll('input[name], select[name], textarea[name]').forEach(input => {
                        if (!input.name) {
                            return;
                        }
                        input.name = input.name.replace(/Columns\[\d+\]/, `Columns[${index}]`);
                    });

                    const removeBtn = row.querySelector('.remove-column-btn');
                    if (removeBtn) {
                        removeBtn.disabled = rows.length <= 1;
                    }

                    const upBtn = row.querySelector('.move-up-btn');
                    if (upBtn) {
                        upBtn.disabled = index === 0;
                    }

                    const downBtn = row.querySelector('.move-down-btn');
                    if (downBtn) {
                        downBtn.disabled = index === rows.length - 1;
                    }
                });
            };

            const bindColumnRow = (row) => {
                row.querySelectorAll('.column-type-select').forEach(select => {
                    select.addEventListener('change', event => {
                        const optionsGroup = event.target.closest('.column-editor')?.querySelector('.column-options-group');
                        if (!optionsGroup) {
                            return;
                        }
                        optionsGroup.classList.toggle('d-none', event.target.value !== 'select');
                    });
                    select.dispatchEvent(new Event('change'));
                });

                const removeBtn = row.querySelector('.remove-column-btn');
                if (removeBtn) {
                    removeBtn.addEventListener('click', () => {
                        if (container.children.length <= 1) {
                            return;
                        }
                        row.remove();
                        refreshColumnState();
                    });
                }

                const moveUpBtn = row.querySelector('.move-up-btn');
                if (moveUpBtn) {
                    moveUpBtn.addEventListener('click', () => {
                        const previous = row.previousElementSibling;
                        if (previous) {
                            container.insertBefore(row, previous);
                            refreshColumnState();
                        }
                    });
                }

                const moveDownBtn = row.querySelector('.move-down-btn');
                if (moveDownBtn) {
                    moveDownBtn.addEventListener('click', () => {
                        const next = row.nextElementSibling;
                        if (next) {
                            container.insertBefore(next, row);
                            refreshColumnState();
                        }
                    });
                }
            };

            const setColumnValues = (row, data = {}) => {
                if ('label' in data) {
                    const input = row.querySelector('input[name$=".Label"]');
                    if (input) {
                        input.value = data.label ?? '';
                    }
                }

                if ('key' in data) {
                    const keyInput = row.querySelector('input[name$=".Key"]');
                    if (keyInput) {
                        keyInput.value = data.key ?? '';
                    }
                }

                const typeSelect = row.querySelector('.column-type-select');
                if (typeSelect) {
                    if ('type' in data && data.type) {
                        typeSelect.value = data.type;
                    }
                    typeSelect.dispatchEvent(new Event('change'));
                }

                if ('required' in data) {
                    const requiredInput = row.querySelector('input[type="checkbox"][name$=".Required"]');
                    if (requiredInput) {
                        requiredInput.checked = Boolean(data.required);
                    }
                }

                if ('optionsText' in data) {
                    const optionsArea = row.querySelector('textarea[name$=".OptionsText"]');
                    if (optionsArea) {
                        optionsArea.value = data.optionsText ?? '';
                    }
                }
            };

            const createColumnFromTemplate = (data = {}) => {
                const fragment = template.content.cloneNode(true);
                const nextIndex = container.children.length;
                fragment.querySelectorAll('[data-name-template]').forEach(element => {
                    const templateName = element.dataset.nameTemplate;
                    if (!templateName) {
                        return;
                    }
                    element.name = templateName.replace(/__index__/g, nextIndex);
                    if (element.dataset.hiddenMarker === 'true') {
                        element.value = 'false';
                    } else if (element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement) {
                        if (element.type === 'checkbox') {
                            element.checked = false;
                        } else {
                            element.value = '';
                        }
                    }
                });

                container.appendChild(fragment);
                const newRow = container.lastElementChild;
                if (!newRow) {
                    return;
                }
                bindColumnRow(newRow);
                setColumnValues(newRow, data);
                refreshColumnState();
            };

            addBtn.addEventListener('click', () => createColumnFromTemplate());

            Array.from(container.children).forEach(row => bindColumnRow(row));
            refreshColumnState();

            const csvInput = document.getElementById('columnCsvInput');
            const uploadBtn = document.getElementById('uploadColumnsBtn');
            const statusEl = document.getElementById('columnCsvStatus');
            const showCsvStatus = (message, state = 'success') => {
                if (!statusEl) {
                    return;
                }
                statusEl.classList.remove('d-none', 'text-danger', 'text-success', 'text-muted');
                if (state === 'error') {
                    statusEl.classList.add('text-danger');
                } else if (state === 'muted') {
                    statusEl.classList.add('text-muted');
                } else {
                    statusEl.classList.add('text-success');
                }
                statusEl.textContent = message;
            };

            const getAntiforgeryToken = () => formEl?.querySelector('input[name="__RequestVerificationToken"]')?.value
                ?? document.querySelector('input[name="__RequestVerificationToken"]')?.value
                ?? '';

            const importColumns = async (file) => {
                if (!csvInput) {
                    return;
                }

                const importUrl = csvInput.dataset.importUrl;
                if (!importUrl) {
                    showCsvStatus('Import endpoint is unavailable.', 'error');
                    return;
                }

                const formData = new FormData();
                formData.append('csvFile', file);

                const headers = {};
                const token = getAntiforgeryToken();
                if (token) {
                    headers['RequestVerificationToken'] = token;
                }

                try {
                    showCsvStatus('Importing columns...', 'muted');
                    const response = await fetch(importUrl, {
                        method: 'POST',
                        headers,
                        body: formData
                    });

                    let payload = null;
                    try {
                        payload = await response.json();
                    } catch {
                        payload = null;
                    }

                    if (!response.ok) {
                        const errorMessage = payload?.error ?? 'Unable to import the CSV file.';
                        throw new Error(errorMessage);
                    }

                    const imported = Array.isArray(payload?.columns) ? payload.columns : [];
                    if (imported.length === 0) {
                        throw new Error('The CSV file did not include any columns.');
                    }

                    container.innerHTML = '';
                    imported.forEach(column => createColumnFromTemplate(column));
                    refreshColumnState();
                    showCsvStatus(`Imported ${imported.length} column${imported.length === 1 ? '' : 's'}.`);
                } catch (error) {
                    showCsvStatus(error.message ?? 'Unable to import the CSV file.', 'error');
                } finally {
                    csvInput.value = '';
                }
            };

            if (uploadBtn && csvInput) {
                uploadBtn.addEventListener('click', () => csvInput.click());
                csvInput.addEventListener('change', () => {
                    const file = csvInput.files && csvInput.files[0];
                    if (!file) {
                        return;
                    }
                    importColumns(file);
                });
            }
        })();
    </script>
}
