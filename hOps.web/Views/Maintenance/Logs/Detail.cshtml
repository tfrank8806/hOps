@using System.Globalization
@using System.Text.Encodings.Web
@model hOps.web.ViewModels.Maintenance.MaintenanceLogCycleDetailViewModel

@{
    var templateIdString = Model.TemplateId.ToString(CultureInfo.InvariantCulture);
    var translatedTemplateName = await Html.DisplayTranslatedTextAsync("MaintenanceLogTemplate", templateIdString, "Name", Model.TemplateName);
    if (string.IsNullOrWhiteSpace(translatedTemplateName))
    {
        translatedTemplateName = Model.TemplateName;
    }

    var translatedScheduleSummary = await Html.DisplayTranslatedTextAsync("MaintenanceLogTemplate", templateIdString, "ScheduleSummary", Model.ScheduleSummary);
    if (string.IsNullOrWhiteSpace(translatedScheduleSummary))
    {
        translatedScheduleSummary = Model.ScheduleSummary;
    }

    ViewData["Title"] = string.Format(CultureInfo.InvariantCulture, "{0} {1}", translatedTemplateName, Html.Localize("Cycle"));
    var message = ViewBag.MaintenanceLogMessage as string;
    var error = ViewBag.MaintenanceLogError as string;
    var allCycles = ViewBag.AllCycles as IReadOnlyList<hOps.web.ViewModels.Maintenance.MaintenanceLogCycleHistoryItemViewModel> ?? Array.Empty<hOps.web.ViewModels.Maintenance.MaintenanceLogCycleHistoryItemViewModel>();
    var historyBlocks = ViewBag.HistoryBlocks is int hb ? hb : 0;
    var cycleWarningKey = ViewBag.CycleChangeTargetKey as string;
    var checklistReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var cycleStatusLabel = Html.Localize($"MaintenanceLog.Status.{Model.Cycle.Status}");
    if (string.IsNullOrWhiteSpace(cycleStatusLabel))
    {
        cycleStatusLabel = Model.Cycle.Status.ToString();
    }
    var deleteLatestConfirmText = JavaScriptEncoder.Default.Encode(Html.Localize("Delete the latest completion?"));
}

<div class="container-fluid py-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-0">@translatedTemplateName</h2>
            @if (!string.IsNullOrWhiteSpace(translatedScheduleSummary))
            {
                <p class="text-muted mb-0">@translatedScheduleSummary</p>
            }
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Html.Localize("Back to Logs")</a>
            @if (Model.ChecklistFilePath != null)
            {
                <a href="@Model.ChecklistFilePath" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener">@Html.Localize("Download Checklist")</a>
            }
            @if (Model.CanManage)
            {
                <a asp-action="Checklist"
                   asp-route-id="@Model.TemplateId"
                   asp-route-returnUrl="@checklistReturnUrl"
                   class="btn btn-primary btn-sm">@Html.Localize("Checklist")</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@Html.Localize(message)</div>
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@Html.Localize(error)</div>
    }
    if (!string.IsNullOrWhiteSpace(cycleWarningKey) && Model.CanManage)
    {
        <div class="alert alert-warning">
            @Html.Localize("The selected completion date belongs to cycle")
            <strong>@cycleWarningKey</strong>.
            @Html.Localize("Check")
            <em>@Html.Localize("Confirm cycle change")</em>
            @Html.Localize("and submit again if that is correct.")
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between flex-wrap gap-3">
                <div>
                    <h5 class="mb-1">@string.Format(CultureInfo.InvariantCulture, Html.Localize("Cycle {0}"), Model.Cycle.WindowKey)</h5>
                    <p class="text-muted mb-0">
                        @Model.Cycle.StartLocal.ToString("MMM d, yyyy") &ndash; @Model.Cycle.DueLocal.ToString("MMM d, yyyy")
                    </p>
                    @if (Model.Cycle.IsLate)
                    {
                        <span class="badge bg-warning text-dark mt-2">@Html.Localize("Late completion")</span>
                    }
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span class="badge @GetStatusBadgeClass(Model.Cycle.Status)">@cycleStatusLabel</span>
                    @if (Model.Cycle.LegacyEntries.Count > 0)
                    {
                        <span class="badge bg-light text-dark border">@Html.Localize("Legacy history")</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="h6">@Html.Localize("Record Completion")</h5>
                    @if (Model.CanManage)
                    {
                        <form asp-action="CreateCycleCompletion" asp-route-templateId="@Model.TemplateId" asp-route-windowKey="@Model.Cycle.WindowKey" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="history" value="@historyBlocks" />
                            <div class="mb-3">
                                <label asp-for="CompletionForm.CompletedAtLocal" class="form-label">@Html.Localize("Completed At")</label>
                                <input asp-for="CompletionForm.CompletedAtLocal" class="form-control" type="datetime-local" />
                                <span asp-validation-for="CompletionForm.CompletedAtLocal" class="text-danger small"></span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CompletionForm.DurationMinutes" class="form-label">@Html.Localize("Duration (minutes)")</label>
                                    <input asp-for="CompletionForm.DurationMinutes" class="form-control" />
                                    <span asp-validation-for="CompletionForm.DurationMinutes" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CompletionForm.Result" class="form-label">@Html.Localize("Result")</label>
                                    <select asp-for="CompletionForm.Result" class="form-select">
                                        <option value="Passed">@Html.Localize("Passed")</option>
                                        <option value="Failed">@Html.Localize("Failed")</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="CompletionForm.Notes" class="form-label">@Html.Localize("Notes")</label>
                                <textarea asp-for="CompletionForm.Notes" rows="3" class="form-control"></textarea>
                                <span asp-validation-for="CompletionForm.Notes" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="createAttachments">@Html.Localize("Attachments (max 10)")</label>
                                <input type="file" id="createAttachments" name="CompletionAttachments" class="form-control" multiple accept=".jpg,.jpeg,.png,.pdf" />
                                <small class="text-muted">@Html.Localize("JPG, PNG, or PDF files.")</small>
                                @Html.ValidationMessage("CompletionAttachments", new { @class = "text-danger small d-block" })
                            </div>
                            <div class="form-check mb-3">
                                <input asp-for="CompletionForm.ConfirmCycleChange" class="form-check-input" id="createConfirmCycle" />
                                <label class="form-check-label" for="createConfirmCycle">@Html.Localize("Confirm cycle change")</label>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">@Html.Localize("Save Completion")</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted mb-0">@Html.Localize("Only managers can record cycle completions.")</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="h6">@Html.Localize("Latest Completion")</h5>
                    @if (!Model.CanManage)
                    {
                        var latest = Model.Cycle.LatestCompletion;
                        if (latest == null)
                        {
                            <p class="text-muted mb-0">@Html.Localize("No completions recorded yet.")</p>
                        }
                        else
                        {
                            var latestResultLabel = Html.Localize(latest.Result.ToString());
                            if (string.IsNullOrWhiteSpace(latestResultLabel))
                            {
                                latestResultLabel = latest.Result.ToString();
                            }

                            var latestTimestamp = latest.CompletedAtLocal?.ToString("MMM d, h:mm tt") ?? Html.Localize("Recorded");
                            var latestCompletedBy = string.IsNullOrWhiteSpace(latest.CompletedByName)
                                ? null
                                : string.Format(CultureInfo.InvariantCulture, Html.Localize("By {0}"), latest.CompletedByName);
                            var latestNotes = await Html.DisplayTranslatedTextAsync(
                                "MaintenanceLogCompletion",
                                latest.CompletionId.ToString(CultureInfo.InvariantCulture),
                                "Notes",
                                latest.Notes ?? string.Empty);

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <div class="fw-semibold">@latestResultLabel</div>
                                    <div class="text-muted small">
                                        @latestTimestamp
                                        @if (!string.IsNullOrWhiteSpace(latestCompletedBy))
                                        {
                                            <span> @latestCompletedBy</span>
                                        }
                                    </div>
                                </div>
                                <span class="badge bg-secondary">@Html.Localize("View only")</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(latestNotes))
                            {
                                <p class="mb-0 mt-2">@latestNotes</p>
                            }
                        }
                        <p class="text-muted mt-3 mb-0">@Html.Localize("Contact a manager to update completions.")</p>
                    }
                    else if (Model.EditForm == null)
                    {
                        <p class="text-muted">@Html.Localize("No completions recorded yet.")</p>
                    }
                    else
                    {
                        <form asp-action="EditCycleCompletion" asp-route-templateId="@Model.TemplateId" asp-route-windowKey="@Model.Cycle.WindowKey" asp-route-completionId="@Model.EditForm.CompletionId" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="history" value="@historyBlocks" />
                            <div class="mb-3">
                                <label asp-for="EditForm.CompletedAtLocal" class="form-label">@Html.Localize("Completed At")</label>
                                <input asp-for="EditForm.CompletedAtLocal" class="form-control" type="datetime-local" />
                                <span asp-validation-for="EditForm.CompletedAtLocal" class="text-danger small"></span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="EditForm.DurationMinutes" class="form-label">@Html.Localize("Duration (minutes)")</label>
                                    <input asp-for="EditForm.DurationMinutes" class="form-control" />
                                    <span asp-validation-for="EditForm.DurationMinutes" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="EditForm.Result" class="form-label">@Html.Localize("Result")</label>
                                    <select asp-for="EditForm.Result" class="form-select">
                                        <option value="Passed">@Html.Localize("Passed")</option>
                                        <option value="Failed">@Html.Localize("Failed")</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="EditForm.Notes" class="form-label">@Html.Localize("Notes")</label>
                                <textarea asp-for="EditForm.Notes" rows="3" class="form-control"></textarea>
                                <span asp-validation-for="EditForm.Notes" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@Html.Localize("Existing attachments")</label>
                                @if (Model.Cycle.LatestCompletion?.Attachments.Any() == true)
                                {
                                    <ul class="list-unstyled small mb-2">
                                        @foreach (var attachment in Model.Cycle.LatestCompletion.Attachments)
                                        {
                                            <li class="d-flex align-items-center justify-content-between border rounded px-2 py-1 mb-1">
                                                <a href="@attachment.FilePath" target="_blank" rel="noopener">@attachment.OriginalFileName ?? attachment.FilePath</a>
                                                <div class="form-check ms-2">
                                                    <input class="form-check-input" type="checkbox" name="RemoveAttachmentIds" value="@attachment.AttachmentId" id="removeAttachment-@attachment.AttachmentId" />
                                                    <label class="form-check-label" for="removeAttachment-@attachment.AttachmentId">@Html.Localize("Remove")</label>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted small mb-2">@Html.Localize("No attachments.")</p>
                                }
                                <input type="file" name="EditCompletionAttachments" class="form-control" multiple accept=".jpg,.jpeg,.png,.pdf" />
                                <small class="text-muted">@Html.Localize("Add more JPG, PNG, or PDF files.")</small>
                                @Html.ValidationMessage("EditCompletionAttachments", new { @class = "text-danger small d-block" })
                            </div>
                            <div class="form-check mb-3">
                                <input asp-for="EditForm.ConfirmCycleChange" class="form-check-input" id="editConfirmCycle" />
                                <label class="form-check-label" for="editConfirmCycle">@Html.Localize("Confirm cycle change")</label>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary btn-sm">@Html.Localize("Update Completion")</button>
                            </div>
                        </form>
                        <form asp-action="DeleteCycleCompletion" asp-route-templateId="@Model.TemplateId" asp-route-windowKey="@Model.Cycle.WindowKey" asp-route-completionId="@Model.EditForm.CompletionId" method="post" class="mt-2" onsubmit="return confirm('@deleteLatestConfirmText');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="history" value="@historyBlocks" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">@Html.Localize("Delete Latest")</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="h6">@Html.Localize("Cycle Completions")</h5>
                    @if (!Model.Cycle.Completions.Any())
                    {
                        <p class="text-muted mb-0">@Html.Localize("No completions yet.")</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var completion in Model.Cycle.Completions)
                            {
                                var completionIdString = completion.CompletionId.ToString(CultureInfo.InvariantCulture);
                                var completionResultLabel = Html.Localize(completion.Result.ToString());
                                if (string.IsNullOrWhiteSpace(completionResultLabel))
                                {
                                    completionResultLabel = completion.Result.ToString();
                                }

                                var completionTimestamp = completion.CompletedAtLocal?.ToString("MMM d, h:mm tt") ?? Html.Localize("Recorded");
                                var completionCompletedBy = string.IsNullOrWhiteSpace(completion.CompletedByName)
                                    ? null
                                    : string.Format(CultureInfo.InvariantCulture, Html.Localize("By {0}"), completion.CompletedByName);
                                var completionNotes = await Html.DisplayTranslatedTextAsync(
                                    "MaintenanceLogCompletion",
                                    completionIdString,
                                    "Notes",
                                    completion.Notes ?? string.Empty);

                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <div class="fw-semibold">@completionResultLabel</div>
                                            <div class="text-muted small">
                                                @completionTimestamp
                                                @if (!string.IsNullOrWhiteSpace(completionCompletedBy))
                                                {
                                                    <span> @completionCompletedBy</span>
                                                }
                                            </div>
                                        </div>
                                        @if (completion.IsLatest)
                                        {
                                            <span class="badge bg-primary">@Html.Localize("Latest")</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(completionNotes))
                                    {
                                        <p class="mb-1 mt-2">@completionNotes</p>
                                    }
                                    @if (completion.Attachments.Any())
                                    {
                                        <div class="small text-muted mb-1">@Html.Localize("Attachments:")</div>
                                        <ul class="list-unstyled small">
                                            @foreach (var attachment in completion.Attachments)
                                            {
                                                <li><a href="@attachment.FilePath" target="_blank" rel="noopener">@attachment.OriginalFileName ?? attachment.FilePath</a></li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="h6">@Html.Localize("Legacy History")</h5>
                    @if (!Model.Cycle.LegacyEntries.Any())
                    {
                        <p class="text-muted mb-0">@Html.Localize("No legacy records for this cycle.")</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var legacy in Model.Cycle.LegacyEntries.OrderByDescending(l => l.CreatedAtUtc))
                            {
                                <li class="list-group-item">
                                    <div class="fw-semibold">@legacy.CreatedAtLocal.ToString("MMM d, h:mm tt")</div>
                                    <div class="text-muted small">@legacy.CreatedByName</div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="h6">@Html.Localize("Cycle History")</h5>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var cycle in allCycles.OrderByDescending(c => c.StartLocal))
                {
                    <a asp-action="Cycle" asp-route-templateId="@Model.TemplateId" asp-route-windowKey="@cycle.WindowKey" asp-route-history="@historyBlocks" class="badge @(cycle.WindowKey == Model.Cycle.WindowKey ? "bg-primary" : "bg-light text-dark border")">
                        @cycle.WindowKey
                    </a>
                }
            </div>
            <div class="mt-3">
                <form asp-action="Cycle" method="get" class="d-inline">
                    <input type="hidden" name="templateId" value="@Model.TemplateId" />
                    <input type="hidden" name="windowKey" value="@Model.Cycle.WindowKey" />
                    <input type="hidden" name="history" value="@(historyBlocks + 1)" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm">@Html.Localize("Load older cycles")</button>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    private static string GetStatusBadgeClass(hOps.web.Models.MaintenanceLogCycleStatusKind status) => status switch
    {
        hOps.web.Models.MaintenanceLogCycleStatusKind.Passed => "badge bg-success",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Failed => "badge bg-danger",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Overdue => "badge bg-danger",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Due => "badge bg-warning text-dark",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Upcoming => "badge bg-secondary",
        _ => "badge bg-secondary"
    };
}
