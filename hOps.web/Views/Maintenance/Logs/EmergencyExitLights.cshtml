@model hOps.web.ViewModels.Maintenance.EmergencyLightTestingIndexViewModel
@using System.Globalization
@{
    ViewData["Title"] = Html.Localize("Emergency / Exit Light Testing Log");
    var message = ViewBag.EmergencyLightLogMessage as string;
    var error = ViewBag.EmergencyLightLogError as string;
    var localNow = ViewBag.LocalNow is DateTime dt ? dt : TimeZoneService.ConvertToUserTime(DateTime.UtcNow);
    var defaultDate = localNow.ToString("yyyy-MM-dd");
    var propertyIdString = Model.PropertyId.ToString(CultureInfo.InvariantCulture);
    string BuildLocationEntityId(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? $"{propertyIdString}:Location"
            : $"{propertyIdString}:{value.Trim()}";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-0">@Html.Localize("Emergency / Exit Light Testing Log")</h2>
            <p class="text-muted mb-0 small">
                @Model.PropertyName &mdash; @Html.Localize("Record monthly validations for each location.")
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Html.Localize("Back to Maintenance Logs")</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@Html.Localize(message)</div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@Html.Localize(error)</div>
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong class="mb-0">@Html.Localize("Record Testing")</strong>
            <small class="text-muted">@Html.Localize("Capture the tested location and the date the inspection was completed.")</small>
        </div>
        <div class="card-body">
            <form asp-action="RecordEmergencyExitLightTest" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <fieldset @(Model.CanRecord ? null : "disabled")>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="emergencyLocation" class="form-label">
                                @Html.Localize("Location") <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="emergencyLocation"
                                   name="Location"
                                   list="emergencyLocationOptions"
                                   maxlength="160"
                                   required />
                            <div class="form-text">@Html.Localize("Enter the public-area location that was tested (lobby, corridor, stairwell, etc.).")</div>
                            @if (Model.SavedLocations.Count > 0)
                            {
                                <datalist id="emergencyLocationOptions">
                                    @foreach (var savedLocation in Model.SavedLocations)
                                    {
                                        <option value="@savedLocation"></option>
                                    }
                                </datalist>
                                <div class="form-text">@Html.Localize("Previously logged locations appear as suggestions.")</div>
                            }
                        </div>
                        <div class="col-md-3 col-xl-2">
                            <label for="emergencyTestDate" class="form-label">
                                @Html.Localize("Testing date") <span class="text-danger">*</span>
                            </label>
                            <input type="date"
                                   class="form-control"
                                   id="emergencyTestDate"
                                   name="TestDate"
                                   value="@defaultDate"
                                   required />
                        </div>
                        <div class="col-12 d-flex gap-2 align-items-center">
                            <button type="submit" class="btn btn-primary">@Html.Localize("Record Test")</button>
                            @if (!Model.CanRecord)
                            {
                                <small class="text-muted">@Html.Localize("Only managers can record testing.")</small>
                            }
                        </div>
                    </div>
                </fieldset>
            </form>
        </div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong class="mb-0">@Html.Localize("Location Status")</strong>
            <small class="text-muted">@Html.Localize("Each location should be tested at least once every 30 days.")</small>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.Localize("Location")</th>
                        <th>@Html.Localize("Last tested")</th>
                        <th>@Html.Localize("Last tester")</th>
                        <th>@Html.Localize("Status")</th>
                        <th>@Html.Localize("Next due")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.LocationStatuses.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                @Html.Localize("No testing has been recorded for this property yet.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var status in Model.LocationStatuses)
                        {
                            var badgeClass = status.IsOverdue
                                ? "badge bg-danger"
                                : status.IsDueSoon
                                    ? "badge bg-warning text-dark"
                                    : "badge bg-success";
                            var badgeText = status.IsOverdue
                                ? Html.Localize("Overdue")
                                : status.IsDueSoon
                                    ? Html.Localize("Due soon")
                                    : Html.Localize("Current");
                            <tr>
                                <td class="fw-semibold">
                                    @await Html.DisplayTranslatedTextAsync(
                                        "EmergencyLightTest",
                                        BuildLocationEntityId(status.Location),
                                        "Location",
                                        status.Location ?? string.Empty)
                                </td>
                                <td>
                                    @if (status.LastTestDate.HasValue)
                                    {
                                        <span>@status.LastTestDate.Value.ToString("MMM d, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>
                                <td>@(status.LastTestedBy ?? "--")</td>
                                <td><span class="@badgeClass">@badgeText</span></td>
                                <td>
                                    @if (status.NextDueDate.HasValue)
                                    {
                                        <span>@status.NextDueDate.Value.ToString("MMM d, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong class="mb-0">@Html.Localize("Recent Tests")</strong>
            <small class="text-muted">@Html.Localize("Latest 50 records.")</small>
        </div>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.Localize("Location")</th>
                        <th>@Html.Localize("Tested on")</th>
                        <th>@Html.Localize("Logged by")</th>
                        <th>@Html.Localize("Logged at")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentEntries.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                @Html.Localize("No tests have been logged yet.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var entry in Model.RecentEntries)
                        {
                            var testedLocal = TimeZoneService.ConvertToUserTime(entry.TestDate).ToString("MMM d, yyyy");
                            var loggedLocal = TimeZoneService.ConvertToUserTime(entry.CreatedAtUtc).ToString("MMM d, h:mm tt");
                            <tr>
                                <td class="fw-semibold">
                                    @await Html.DisplayTranslatedTextAsync(
                                        "EmergencyLightTest",
                                        BuildLocationEntityId(entry.Location),
                                        "Location",
                                        entry.Location ?? string.Empty)
                                </td>
                                <td>@testedLocal</td>
                                <td>@(entry.CreatedByName ?? "--")</td>
                                <td>@loggedLocal</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
