@model hOps.web.ViewModels.Maintenance.EmergencyLightTestingIndexViewModel
@{
    ViewData["Title"] = "Emergency / Exit Light Testing Log";
    var message = ViewBag.EmergencyLightLogMessage as string;
    var error = ViewBag.EmergencyLightLogError as string;
    var localNow = ViewBag.LocalNow is DateTime dt ? dt : TimeZoneService.ConvertToUserTime(DateTime.UtcNow);
    var defaultDate = localNow.ToString("yyyy-MM-dd");
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-0">Emergency / Exit Light Testing Log</h2>
            <p class="text-muted mb-0 small">@Model.PropertyName — record monthly validations for each location.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Maintenance Logs</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong class="mb-0">Record Testing</strong>
            <small class="text-muted">Capture the tested location and the date the inspection was completed.</small>
        </div>
        <div class="card-body">
            <form asp-action="RecordEmergencyExitLightTest" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <fieldset @(Model.CanRecord ? null : "disabled")>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="emergencyRoomSelect" class="form-label">Room shortcut</label>
                            <select id="emergencyRoomSelect" name="SelectedRoomNumber" class="form-select">
                                <option value="">-- Optional: select room --</option>
                                @foreach (var option in Model.RoomOptions)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                            <div class="form-text">Selecting a room fills in the location field.</div>
                        </div>
                        <div class="col-md-4">
                            <label for="emergencyLocation" class="form-label">Location *</label>
                            <input type="text"
                                   class="form-control"
                                   id="emergencyLocation"
                                   name="Location"
                                   maxlength="160"
                                   required />
                            <div class="form-text">Enter the exact location that was tested.</div>
                        </div>
                        <div class="col-md-4">
                            <label for="emergencyTestDate" class="form-label">Testing date *</label>
                            <input type="date"
                                   class="form-control"
                                   id="emergencyTestDate"
                                   name="TestDate"
                                   value="@defaultDate"
                                   required />
                        </div>
                        <div class="col-12 d-flex gap-2 align-items-center">
                            <button type="submit" class="btn btn-primary">Record Test</button>
                            @if (!Model.CanRecord)
                            {
                                <small class="text-muted">Only managers can record testing.</small>
                            }
                        </div>
                    </div>
                </fieldset>
            </form>
        </div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong class="mb-0">Location Status</strong>
            <small class="text-muted">Each location should be tested at least once every 30 days.</small>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Location</th>
                        <th>Last tested</th>
                        <th>Last tester</th>
                        <th>Status</th>
                        <th>Next due</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.LocationStatuses.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No testing has been recorded for this property yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var status in Model.LocationStatuses)
                        {
                            var badgeClass = status.IsOverdue
                                ? "badge bg-danger"
                                : status.IsDueSoon
                                    ? "badge bg-warning text-dark"
                                    : "badge bg-success";
                            var badgeText = status.IsOverdue
                                ? "Overdue"
                                : status.IsDueSoon
                                    ? "Due soon"
                                    : "Current";
                            <tr>
                                <td class="fw-semibold">@status.Location</td>
                                <td>
                                    @if (status.LastTestDate.HasValue)
                                    {
                                        <span>@status.LastTestDate.Value.ToString("MMM d, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>
                                <td>@(status.LastTestedBy ?? "--")</td>
                                <td><span class="@badgeClass">@badgeText</span></td>
                                <td>
                                    @if (status.NextDueDate.HasValue)
                                    {
                                        <span>@status.NextDueDate.Value.ToString("MMM d, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong class="mb-0">Recent Tests</strong>
            <small class="text-muted">Latest 50 records.</small>
        </div>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Location</th>
                        <th>Tested on</th>
                        <th>Logged by</th>
                        <th>Logged at</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentEntries.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No tests have been logged yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var entry in Model.RecentEntries)
                        {
                            var testedLocal = TimeZoneService.ConvertToUserTime(entry.TestDate).ToString("MMM d, yyyy");
                            var loggedLocal = TimeZoneService.ConvertToUserTime(entry.CreatedAtUtc).ToString("MMM d, h:mm tt");
                            <tr>
                                <td class="fw-semibold">@entry.Location</td>
                                <td>@testedLocal</td>
                                <td>@(entry.CreatedByName ?? "--")</td>
                                <td>@loggedLocal</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const select = document.getElementById('emergencyRoomSelect');
            const input = document.getElementById('emergencyLocation');
            if (!select || !input) {
                return;
            }

            select.addEventListener('change', () => {
                if (select.value && (!input.value || input.value.trim().length === 0)) {
                    input.value = select.value;
                    input.focus();
                }
            });
        })();
    </script>
}
