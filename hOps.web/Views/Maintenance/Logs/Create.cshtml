@model hOps.web.ViewModels.Maintenance.MaintenanceLogCreateViewModel

@{
    ViewData["Title"] = "Create Maintenance Log";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-0">Create Maintenance Log</h2>
            <p class="text-muted mb-0">@Model.PropertyName</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Logs</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Log Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ScheduleType" class="form-label">Cycle Type</label>
                        <select asp-for="ScheduleType" class="form-select" id="scheduleTypeSelect">
                            <option value="Daily">Daily</option>
                            <option value="Weekly">Weekly</option>
                            <option value="Monthly">Monthly</option>
                            <option value="Quarterly">Quarterly</option>
                            <option value="Yearly">Annual</option>
                        </select>
                        <span asp-validation-for="ScheduleType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DueTimeLocal" class="form-label">Due Time (optional)</label>
                        <input asp-for="DueTimeLocal" class="form-control" type="time" />
                        <span asp-validation-for="DueTimeLocal" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-12 d-none" id="weeklyDaysFieldset">
                        <label class="form-label">Weekly Days</label>
                        <div class="d-flex flex-wrap gap-3">
                            @{
                                var dayNames = Enum.GetNames(typeof(DayOfWeek));
                                for (var i = 0; i < dayNames.Length; i++)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="WeeklyDays[i]" id="weekly-day-@i" />
                                        <label class="form-check-label" for="weekly-day-@i">@dayNames[i]</label>
                                    </div>
                                }
                            }
                        </div>
                        <span asp-validation-for="WeeklyDays" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 d-none" id="dayOfMonthField">
                        <label asp-for="DayOfMonth" class="form-label">Due Day</label>
                        <input asp-for="DayOfMonth" class="form-control" type="number" min="1" max="31" />
                        <div class="form-text">1-31, used for monthly, quarterly, or annual cycles.</div>
                        <span asp-validation-for="DayOfMonth" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Create Log</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const scheduleSelect = document.getElementById('scheduleTypeSelect');
            const weeklyFieldset = document.getElementById('weeklyDaysFieldset');
            const dayOfMonthField = document.getElementById('dayOfMonthField');

            const updateVisibility = () => {
                const value = scheduleSelect?.value ?? 'Daily';
                const showWeekly = value === 'Weekly';
                const showDayOfMonth = value === 'Monthly' || value === 'Quarterly' || value === 'Yearly';

                if (weeklyFieldset) {
                    weeklyFieldset.classList.toggle('d-none', !showWeekly);
                }

                if (dayOfMonthField) {
                    dayOfMonthField.classList.toggle('d-none', !showDayOfMonth);
                }
            };

            scheduleSelect?.addEventListener('change', updateVisibility);
            updateVisibility();
        })();
    </script>
}
