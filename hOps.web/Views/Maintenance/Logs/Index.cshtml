@using Microsoft.AspNetCore.Html
@model hOps.web.ViewModels.Maintenance.MaintenanceLogsIndexViewModel

@{
    ViewData["Title"] = "Maintenance Logs";
    var message = ViewBag.MaintenanceLogMessage as string;
    var error = ViewBag.MaintenanceLogError as string;
    var groups = new (string Title, IReadOnlyList<hOps.web.ViewModels.Maintenance.MaintenanceLogTemplateListItemViewModel> Items)[]
    {
        ("Daily Logs", Model.DailyTemplates),
        ("Weekly Logs", Model.WeeklyTemplates),
        ("Monthly Logs", Model.MonthlyTemplates),
        ("Bi-Annual Logs", Model.BiAnnualTemplates),
        ("Quarterly Logs", Model.QuarterlyTemplates),
        ("Annual Logs", Model.AnnualTemplates)
    };
    var checklistReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<style>
    .cycle-card { transition: box-shadow .2s ease; }
    .cycle-grid { display: flex; flex-wrap: wrap; gap: .75rem; }
    .cycle-cell { border: 1px solid #dee2e6; border-radius: .5rem; padding: .75rem; min-width: 160px; text-decoration: none; color: inherit; }
    .cycle-cell:hover { text-decoration: none; }
    .cycle-cell.status-overdue { border-color: #dc3545; }
    .cycle-cell.status-due { border-color: #ffc107; }
    .cycle-cell.status-passed { border-color: #28a745; }
    .cycle-cell.status-failed { border-color: #dc3545; }
    .cycle-cell.status-upcoming { opacity: .7; cursor: not-allowed; }
    .cycle-cell .status-label { font-size: .8rem; font-weight: 600; }
    .cycle-cell .cycle-range { font-size: .8rem; color: #6c757d; }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-0">Maintenance Logs</h2>
            <p class="text-muted mb-0">@Model.PropertyName</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="EmergencyExitLights" class="btn btn-outline-primary btn-sm">Emergency/Exit Light Log</a>
            @if (Model.CanManage)
            {
                <a asp-action="Create" class="btn btn-primary btn-sm">Create New Log</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@message</div>
    }
    if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    <form method="get" class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label" for="scheduleFilter">Schedule</label>
                    <select class="form-select" id="scheduleFilter" name="schedule">
                        <option value="">All schedules</option>
                        <option value="Daily" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.Daily ? "selected" : null)">Daily</option>
                        <option value="Weekly" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.Weekly ? "selected" : null)">Weekly</option>
                        <option value="Monthly" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.Monthly ? "selected" : null)">Monthly</option>
                        <option value="BiAnnual" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.BiAnnual ? "selected" : null)">Bi-Annual</option>
                        <option value="Quarterly" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.Quarterly ? "selected" : null)">Quarterly</option>
                        <option value="Yearly" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.Yearly ? "selected" : null)">Annual</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="statusFilter">Status</label>
                    <select class="form-select" id="statusFilter" name="status">
                        <option value="">All statuses</option>
                        <option value="Passed" selected="@(Model.Filters.StatusFilter?.Equals("Passed", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">Passed</option>
                        <option value="Failed" selected="@(Model.Filters.StatusFilter?.Equals("Failed", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">Failed</option>
                        <option value="Due" selected="@(Model.Filters.StatusFilter?.Equals("Due", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">Due</option>
                        <option value="Overdue" selected="@(Model.Filters.StatusFilter?.Equals("Overdue", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">Overdue</option>
                        <option value="Upcoming" selected="@(Model.Filters.StatusFilter?.Equals("Upcoming", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">Upcoming</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="completionFilter">Completion</label>
                    <select class="form-select" id="completionFilter" name="completion">
                        <option value="">Completed &amp; pending</option>
                        <option value="completed" selected="@(Model.Filters.CompletionFilter?.Equals("completed", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">Completed cycles</option>
                        <option value="notcompleted" selected="@(Model.Filters.CompletionFilter?.Equals("notcompleted", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">Due or overdue</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="nameFilter">Template</label>
                    <input type="text" id="nameFilter" name="name" value="@Model.Filters.NameQuery" class="form-control" placeholder="Search by name" />
                </div>
            </div>
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </div>
    </form>

    @if (!Model.DailyTemplates.Any() && !Model.WeeklyTemplates.Any() && !Model.MonthlyTemplates.Any() && !Model.OtherTemplates.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <p class="mb-0 text-muted">No maintenance log templates match the current filters.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var group in groups)
        {
            if (!group.Items.Any())
            {
                continue;
            }

            <section class="mb-4">
                <h4 class="h5 mb-3">@group.Title</h4>
                @foreach (var template in group.Items)
                {
                    var latestCycle = template.VisibleCycles.FirstOrDefault();
                    <div class="card shadow-sm mb-3 cycle-card @(template.IsOverdue ? "border-danger" : null)">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                <div>
                                    <h5 class="mb-1">@template.Name</h5>
                                    <p class="text-muted mb-0">@template.ScheduleSummary</p>
                                </div>
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <span class="badge @GetStatusBadgeClass(template.LatestStatus)">@template.LatestStatus</span>
                                    @if (template.IsOverdue)
                                    {
                                        <span class="badge bg-danger">Overdue</span>
                                    }
                                    else if (latestCycle?.IsLate == true)
                                    {
                                        <span class="badge bg-warning text-dark">Late</span>
                                    }
                                    <div class="d-flex gap-2 flex-wrap">
                                        @if (template.HasChecklistFile)
                                        {
                                            <a href="@template.ChecklistFilePath" class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener">Download Checklist</a>
                                        }
                                        @if (Model.CanManage)
                                        {
                                            <a asp-action="Checklist"
                                               asp-route-id="@template.TemplateId"
                                               asp-route-returnUrl="@checklistReturnUrl"
                                               class="btn btn-outline-primary btn-sm">Checklist</a>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="cycle-grid">
                                @foreach (var cycle in template.VisibleCycles)
                                {
                                    var cellClass = $"cycle-cell status-{cycle.Status.ToString().ToLowerInvariant()}";
                                    var routeValues = new { templateId = template.TemplateId, windowKey = cycle.WindowKey };
                                    if (cycle.Status == hOps.web.Models.MaintenanceLogCycleStatusKind.Upcoming)
                                    {
                                        <div class="@cellClass">
                                            @CycleCellContent(cycle)
                                        </div>
                                    }
                                    else
                                    {
                                        <a class="@cellClass" asp-action="Cycle" asp-route-templateId="@template.TemplateId" asp-route-windowKey="@cycle.WindowKey">
                                            @CycleCellContent(cycle)
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        @if (Model.OtherTemplates.Any())
        {
            <section class="mb-4">
                <h4 class="h5 mb-3">Other Schedules</h4>
                @foreach (var template in Model.OtherTemplates)
                {
                    <div class="card shadow-sm mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-1">@template.Name</h5>
                                    <p class="text-muted mb-0">@template.ScheduleSummary</p>
                                </div>
                                <span class="badge bg-secondary">Legacy schedule</span>
                            </div>
                            <p class="text-muted mt-3 mb-0 small">Cycle history will be available once this template moves to a supported schedule (daily/weekly/monthly/bi-annual/quarterly/annual).</p>
                        </div>
                    </div>
                }
            </section>
        }
    }

    <div class="d-flex justify-content-end mt-4">
        <form method="get" class="d-inline">
            <input type="hidden" name="schedule" value="@Model.Filters.ScheduleFilter" />
            <input type="hidden" name="status" value="@Model.Filters.StatusFilter" />
            <input type="hidden" name="completion" value="@Model.Filters.CompletionFilter" />
            <input type="hidden" name="name" value="@Model.Filters.NameQuery" />
            <input type="hidden" name="history" value="@(Model.AdditionalHistoryBlocks + 1)" />
            <button type="submit" class="btn btn-outline-secondary btn-sm" @(Model.CanLoadMoreHistory ? null : "disabled")>Load older history</button>
        </form>
    </div>
</div>

@functions {
    private static string GetStatusBadgeClass(hOps.web.Models.MaintenanceLogCycleStatusKind status) => status switch
    {
        hOps.web.Models.MaintenanceLogCycleStatusKind.Passed => "badge bg-success",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Failed => "badge bg-danger",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Overdue => "badge bg-danger",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Due => "badge bg-warning text-dark",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Upcoming => "badge bg-secondary",
        _ => "badge bg-secondary"
    };

    private static IHtmlContent CycleCellContent(hOps.web.ViewModels.Maintenance.MaintenanceLogCycleHistoryItemViewModel cycle)
    {
        var builder = new System.Text.StringBuilder();
        builder.Append("<div class='cycle-range'>")
            .Append(cycle.StartLocal.ToString("MMM d"))
            .Append(" &ndash; ")
            .Append(cycle.DueLocal.ToString("MMM d"))
            .Append("</div>");
        builder.Append("<div class='status-label'>").Append(cycle.Status).Append("</div>");
        if (cycle.LatestCompletion != null)
        {
            var timestamp = cycle.LatestCompletion.CompletedAtLocal?.ToString("MMM d, h:mm tt") ?? "Recorded";
            builder.Append("<div class='small text-muted'>Completed ")
                .Append(timestamp)
                .Append("</div>");
        }
        else if (cycle.LegacyEntries.Count > 0)
        {
            builder.Append("<div class='small text-muted'>Legacy records</div>");
        }
        else
        {
            builder.Append("<div class='small text-muted'>No completion</div>");
        }

        if (cycle.IsLate)
        {
            builder.Append("<div class='badge bg-warning text-dark mt-2'>Late</div>");
        }

        if (cycle.LegacyEntries.Count > 0)
        {
            builder.Append("<div class='badge bg-light text-dark border mt-2'>Legacy</div>");
        }

        return new HtmlString(builder.ToString());
    }
}
