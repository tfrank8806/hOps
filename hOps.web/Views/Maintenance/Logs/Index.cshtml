@using System.Globalization
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Html
@model hOps.web.ViewModels.Maintenance.MaintenanceLogsIndexViewModel

@{
    var pageTitle = Html.Localize("Maintenance Logs");
    ViewData["Title"] = pageTitle;
    var message = ViewBag.MaintenanceLogMessage as string;
    var error = ViewBag.MaintenanceLogError as string;
    var groups = new (string Title, IReadOnlyList<hOps.web.ViewModels.Maintenance.MaintenanceLogTemplateListItemViewModel> Items)[]
    {
        (Html.Localize("Daily Logs"), Model.DailyTemplates),
        (Html.Localize("Weekly Logs"), Model.WeeklyTemplates),
        (Html.Localize("Monthly Logs"), Model.MonthlyTemplates),
        (Html.Localize("Bi-Annual Logs"), Model.BiAnnualTemplates),
        (Html.Localize("Quarterly Logs"), Model.QuarterlyTemplates),
        (Html.Localize("Annual Logs"), Model.AnnualTemplates)
    };
    var hasAnyTemplates = Model.DailyTemplates.Any()
        || Model.WeeklyTemplates.Any()
        || Model.MonthlyTemplates.Any()
        || Model.QuarterlyTemplates.Any()
        || Model.AnnualTemplates.Any()
        || Model.BiAnnualTemplates.Any()
        || Model.OtherTemplates.Any();
    var checklistReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<style>
    .cycle-card { transition: box-shadow .2s ease; }
    .cycle-grid { display: flex; flex-wrap: wrap; gap: .75rem; }
    .cycle-cell { border: 1px solid #dee2e6; border-radius: .5rem; padding: .75rem; min-width: 160px; text-decoration: none; color: inherit; }
    .cycle-cell:hover { text-decoration: none; }
    .cycle-cell.status-overdue { border-color: #dc3545; }
    .cycle-cell.status-due { border-color: #ffc107; }
    .cycle-cell.status-passed { border-color: #28a745; }
    .cycle-cell.status-failed { border-color: #dc3545; }
    .cycle-cell.status-upcoming { opacity: .7; cursor: not-allowed; }
    .cycle-cell .status-label { font-size: .8rem; font-weight: 600; }
    .cycle-cell .cycle-range { font-size: .8rem; color: #6c757d; }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-0">@pageTitle</h2>
            <p class="text-muted mb-0">@Model.PropertyName</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="EmergencyExitLights" class="btn btn-outline-primary btn-sm">@Html.Localize("Emergency/Exit Light Log")</a>
            @if (Model.CanManage)
            {
                <a asp-action="Create" class="btn btn-primary btn-sm">@Html.Localize("Create New Log")</a>
            }
        </div>
    </div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success">@Html.Localize(message)</div>
}
@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@Html.Localize(error)</div>
}

    <form method="get" class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label" for="scheduleFilter">@Html.Localize("Schedule")</label>
                    <select class="form-select" id="scheduleFilter" name="schedule">
                        <option value="">@Html.Localize("All schedules")</option>
                        <option value="Daily" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.Daily ? "selected" : null)">@Html.Localize("Daily")</option>
                        <option value="Weekly" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.Weekly ? "selected" : null)">@Html.Localize("Weekly")</option>
                        <option value="Monthly" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.Monthly ? "selected" : null)">@Html.Localize("Monthly")</option>
                        <option value="BiAnnual" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.BiAnnual ? "selected" : null)">@Html.Localize("Bi-Annual")</option>
                        <option value="Quarterly" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.Quarterly ? "selected" : null)">@Html.Localize("Quarterly")</option>
                        <option value="Yearly" selected="@(Model.Filters.ScheduleFilter == hOps.web.Models.MaintenanceLogScheduleType.Yearly ? "selected" : null)">@Html.Localize("Annual")</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="statusFilter">@Html.Localize("Status")</label>
                    <select class="form-select" id="statusFilter" name="status">
                        <option value="">@Html.Localize("All statuses")</option>
                        <option value="Passed" selected="@(Model.Filters.StatusFilter?.Equals("Passed", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">@Html.Localize("Passed")</option>
                        <option value="Failed" selected="@(Model.Filters.StatusFilter?.Equals("Failed", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">@Html.Localize("Failed")</option>
                        <option value="Due" selected="@(Model.Filters.StatusFilter?.Equals("Due", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">@Html.Localize("Due")</option>
                        <option value="Overdue" selected="@(Model.Filters.StatusFilter?.Equals("Overdue", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">@Html.Localize("Overdue")</option>
                        <option value="Upcoming" selected="@(Model.Filters.StatusFilter?.Equals("Upcoming", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">@Html.Localize("Upcoming")</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="completionFilter">@Html.Localize("Completion")</label>
                    <select class="form-select" id="completionFilter" name="completion">
                        <option value="">@Html.Localize("Completed & pending")</option>
                        <option value="completed" selected="@(Model.Filters.CompletionFilter?.Equals("completed", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">@Html.Localize("Completed cycles")</option>
                        <option value="notcompleted" selected="@(Model.Filters.CompletionFilter?.Equals("notcompleted", StringComparison.OrdinalIgnoreCase) == true ? "selected" : null)">@Html.Localize("Due or overdue")</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="nameFilter">@Html.Localize("Template")</label>
                    <input type="text" id="nameFilter" name="name" value="@Model.Filters.NameQuery" class="form-control" placeholder="@Html.Localize("Search by name")" />
                </div>
            </div>
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button type="submit" class="btn btn-primary btn-sm">@Html.Localize("Apply Filters")</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Html.Localize("Clear")</a>
            </div>
        </div>
    </form>

    @if (!hasAnyTemplates)
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <p class="mb-0 text-muted">No maintenance log templates match the current filters.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var group in groups)
        {
            if (!group.Items.Any())
            {
                continue;
            }

            <section class="mb-4">
                <h4 class="h5 mb-3">@group.Title</h4>
                @foreach (var template in group.Items)
                {
                    var latestCycle = template.VisibleCycles.FirstOrDefault();
                    var templateIdString = template.TemplateId.ToString(CultureInfo.InvariantCulture);
                    var translatedTemplateName = await Html.DisplayTranslatedTextAsync("MaintenanceLogTemplate", templateIdString, "Name", template.Name);
                    if (string.IsNullOrWhiteSpace(translatedTemplateName))
                    {
                        translatedTemplateName = template.Name;
                    }

                    var translatedScheduleSummary = await Html.DisplayTranslatedTextAsync("MaintenanceLogTemplate", templateIdString, "ScheduleSummary", template.ScheduleSummary);
                    if (string.IsNullOrWhiteSpace(translatedScheduleSummary))
                    {
                        translatedScheduleSummary = template.ScheduleSummary;
                    }

                    var latestStatusLabel = Html.Localize($"MaintenanceLog.Status.{template.LatestStatus}");
                    if (string.IsNullOrWhiteSpace(latestStatusLabel))
                    {
                        latestStatusLabel = template.LatestStatus.ToString();
                    }

                    <div class="card shadow-sm mb-3 cycle-card @(template.IsOverdue ? "border-danger" : null)">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                <div>
                                    <h5 class="mb-1">@translatedTemplateName</h5>
                                    @if (!string.IsNullOrWhiteSpace(translatedScheduleSummary))
                                    {
                                        <p class="text-muted mb-0">@translatedScheduleSummary</p>
                                    }
                                </div>
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <span class="badge @GetStatusBadgeClass(template.LatestStatus)">@latestStatusLabel</span>
                                    @if (template.IsOverdue)
                                    {
                                        <span class="badge bg-danger">@Html.Localize("Overdue")</span>
                                    }
                                    else if (latestCycle?.IsLate == true)
                                    {
                                        <span class="badge bg-warning text-dark">@Html.Localize("Late")</span>
                                    }
                                    <div class="d-flex gap-2 flex-wrap">
                                        @if (template.HasChecklistFile)
                                        {
                                            <a href="@template.ChecklistFilePath" class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener">@Html.Localize("Download Checklist")</a>
                                        }
                                        @if (Model.CanManage)
                                        {
                                            <a asp-action="Checklist"
                                               asp-route-id="@template.TemplateId"
                                               asp-route-returnUrl="@checklistReturnUrl"
                                               class="btn btn-outline-primary btn-sm">@Html.Localize("Checklist")</a>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="cycle-grid">
                                @foreach (var cycle in template.VisibleCycles)
                                {
                                    var cellClass = $"cycle-cell status-{cycle.Status.ToString().ToLowerInvariant()}";
                                    if (cycle.Status == hOps.web.Models.MaintenanceLogCycleStatusKind.Upcoming)
                                    {
                                        <div class="@cellClass">
                                            @CycleCellContent(cycle)
                                        </div>
                                    }
                                    else
                                    {
                                        <a class="@cellClass" asp-action="Cycle" asp-route-templateId="@template.TemplateId" asp-route-windowKey="@cycle.WindowKey">
                                            @CycleCellContent(cycle)
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        @if (Model.OtherTemplates.Any())
        {
            <section class="mb-4">
                <h4 class="h5 mb-3">@Html.Localize("Other Schedules")</h4>
                @foreach (var template in Model.OtherTemplates)
                {
                    var templateIdString = template.TemplateId.ToString(CultureInfo.InvariantCulture);
                    var translatedTemplateName = await Html.DisplayTranslatedTextAsync("MaintenanceLogTemplate", templateIdString, "Name", template.Name);
                    if (string.IsNullOrWhiteSpace(translatedTemplateName))
                    {
                        translatedTemplateName = template.Name;
                    }

                    var translatedScheduleSummary = await Html.DisplayTranslatedTextAsync("MaintenanceLogTemplate", templateIdString, "ScheduleSummary", template.ScheduleSummary);
                    if (string.IsNullOrWhiteSpace(translatedScheduleSummary))
                    {
                        translatedScheduleSummary = template.ScheduleSummary;
                    }

                    <div class="card shadow-sm mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-1">@translatedTemplateName</h5>
                                    @if (!string.IsNullOrWhiteSpace(translatedScheduleSummary))
                                    {
                                        <p class="text-muted mb-0">@translatedScheduleSummary</p>
                                    }
                                </div>
                                <span class="badge bg-secondary">@Html.Localize("Legacy schedule")</span>
                            </div>
                            <p class="text-muted mt-3 mb-0 small">@Html.Localize("Cycle history will be available once this template moves to a supported schedule (daily/weekly/monthly/bi-annual/quarterly/annual).")</p>
                        </div>
                    </div>
                }
            </section>
        }
    }

    <div class="d-flex justify-content-end mt-4">
        <form method="get" class="d-inline">
            <input type="hidden" name="schedule" value="@Model.Filters.ScheduleFilter" />
            <input type="hidden" name="status" value="@Model.Filters.StatusFilter" />
            <input type="hidden" name="completion" value="@Model.Filters.CompletionFilter" />
            <input type="hidden" name="name" value="@Model.Filters.NameQuery" />
            <input type="hidden" name="history" value="@(Model.AdditionalHistoryBlocks + 1)" />
            <button type="submit" class="btn btn-outline-secondary btn-sm" @(Model.CanLoadMoreHistory ? null : "disabled")>@Html.Localize("Load older history")</button>
        </form>
    </div>
</div>

@functions {
    private static string GetStatusBadgeClass(hOps.web.Models.MaintenanceLogCycleStatusKind status) => status switch
    {
        hOps.web.Models.MaintenanceLogCycleStatusKind.Passed => "badge bg-success",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Failed => "badge bg-danger",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Overdue => "badge bg-danger",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Due => "badge bg-warning text-dark",
        hOps.web.Models.MaintenanceLogCycleStatusKind.Upcoming => "badge bg-secondary",
        _ => "badge bg-secondary"
    };

    private IHtmlContent CycleCellContent(hOps.web.ViewModels.Maintenance.MaintenanceLogCycleHistoryItemViewModel cycle)
    {
        var builder = new System.Text.StringBuilder();
        var encoder = HtmlEncoder.Default;
        var rangeStart = cycle.StartLocal.ToString("MMM d");
        var rangeEnd = cycle.DueLocal.ToString("MMM d");
        builder.Append("<div class='cycle-range'>")
            .Append(encoder.Encode(rangeStart))
            .Append(" &ndash; ")
            .Append(encoder.Encode(rangeEnd))
            .Append("</div>");
        var statusLabel = Html.Localize($"MaintenanceLog.Status.{cycle.Status}");
        if (string.IsNullOrWhiteSpace(statusLabel))
        {
            statusLabel = cycle.Status.ToString();
        }
        builder.Append("<div class='status-label'>").Append(encoder.Encode(statusLabel)).Append("</div>");
        if (cycle.LatestCompletion != null)
        {
            var timestamp = cycle.LatestCompletion.CompletedAtLocal?.ToString("MMM d, h:mm tt") ?? Html.Localize("Recorded");
            var completionText = string.Format(CultureInfo.InvariantCulture, Html.Localize("Completed {0}"), timestamp);
            builder.Append("<div class='small text-muted'>")
                .Append(encoder.Encode(completionText));
            if (!string.IsNullOrWhiteSpace(cycle.LatestCompletion.CompletedByName))
            {
                var completedBy = string.Format(CultureInfo.InvariantCulture, Html.Localize("By {0}"), cycle.LatestCompletion.CompletedByName);
                builder.Append("<span class='ms-1'>")
                    .Append(encoder.Encode(completedBy))
                    .Append("</span>");
            }
            builder.Append("</div>");
        }
        else if (cycle.LegacyEntries.Count > 0)
        {
            builder.Append("<div class='small text-muted'>")
                .Append(encoder.Encode(Html.Localize("Legacy records")))
                .Append("</div>");
        }
        else
        {
            builder.Append("<div class='small text-muted'>")
                .Append(encoder.Encode(Html.Localize("No completion")))
                .Append("</div>");
        }

        if (cycle.IsLate)
        {
            builder.Append("<div class='badge bg-warning text-dark mt-2'>")
                .Append(encoder.Encode(Html.Localize("Late")))
                .Append("</div>");
        }

        if (cycle.LegacyEntries.Count > 0)
        {
            builder.Append("<div class='badge bg-light text-dark border mt-2'>")
                .Append(encoder.Encode(Html.Localize("Legacy")))
                .Append("</div>");
        }

        return new HtmlString(builder.ToString());
    }
}
