@model hOps.web.ViewModels.Maintenance.MaintenancePmChecklistsPageViewModel
@{
    ViewData["Title"] = "PM Checklists";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-0">Preventive Maintenance Checklists</h2>
        <p class="text-muted mb-0 small">Create and organize reusable PM templates for each property.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="PreventiveMaintenance" asp-action="Index" asp-route-checklistId="@Model.ChecklistEditor?.Id" class="btn btn-outline-secondary btn-sm">Back to PMs</a>
    </div>
</div>

@if (ViewBag.PmChecklistError is string error && !string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-warning">@error</div>
}

@if (ViewBag.PmChecklistMessage is string message && !string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success">@message</div>
}

@if (Model.AccessibleProperties.Count > 1)
{
    <form method="get" asp-action="PmChecklists" class="mb-4">
        <label for="propertySelect" class="form-label">Property</label>
        <select class="form-select" id="propertySelect" name="propertyId" onchange="this.form.submit()">
            @foreach (var property in Model.AccessibleProperties)
            {
                <option value="@property.Id" selected="@(property.Id == Model.PropertyId ? "selected" : null)">@property.Name (@property.Code)</option>
            }
        </select>
        @if (Model.ChecklistEditor?.Id is int editorChecklistId)
        {
            <input type="hidden" name="checklistId" value="@editorChecklistId" />
        }
    </form>
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="SaveChecklistSettings" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="propertyId" value="@Model.PropertyId" />
            <div class="col-md-4 col-sm-6">
                <label for="pmFrequencyInput" class="form-label">PM frequency per year</label>
                <input type="number"
                       class="form-control"
                       id="pmFrequencyInput"
                       name="frequencyPerYear"
                       value="@(Model.FrequencyPerYear > 0 ? Model.FrequencyPerYear : 4)"
                       min="1"
                       max="52"
                       required />
                @if (Model.FrequencyPerYear > 0)
                {
                    <div class="form-text">Currently set to <strong>@Model.FrequencyPerYear</strong> PM cycles each year.</div>
                }
                else
                {
                    <div class="form-text">Set how many PM cycles each room should complete annually (default is 4).</div>
                }
            </div>
            <div class="col-md-3 col-sm-6">
                <button type="submit" class="btn btn-primary mt-2 mt-sm-0">Save Frequency</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h5 class="mb-0">Import checklist from CSV</h5>
                <div class="text-muted small">Upload tasks in bulk or start with the blank template.</div>
            </div>
            <a asp-action="DownloadChecklistTemplateCsv" class="btn btn-outline-secondary btn-sm">Download blank CSV</a>
        </div>
        <form asp-action="UploadChecklistTemplate" method="post" enctype="multipart/form-data" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TemplateUpload.PropertyId" value="@Model.PropertyId" />
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="col-md-6">
                <label asp-for="TemplateUpload.Name" class="form-label"></label>
                <input asp-for="TemplateUpload.Name" class="form-control" />
                <span asp-validation-for="TemplateUpload.Name" class="text-danger small"></span>
            </div>
            <div class="col-md-3 col-sm-6">
                <label asp-for="TemplateUpload.ChecklistType" class="form-label"></label>
                <select asp-for="TemplateUpload.ChecklistType" class="form-select">
                    <option value="Room">Room-based</option>
                    <option value="Area">Area-based</option>
                </select>
                <span asp-validation-for="TemplateUpload.ChecklistType" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="TemplateUpload.AreaOptionsText" class="form-label"></label>
                <textarea asp-for="TemplateUpload.AreaOptionsText" class="form-control" rows="2" placeholder="Lobby, Pool Deck, Fitness Center"></textarea>
                <div class="form-text">Only used for area checklists. Separate values with commas.</div>
                <span asp-validation-for="TemplateUpload.AreaOptionsText" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TemplateUpload.CsvFile" class="form-label"></label>
                <input asp-for="TemplateUpload.CsvFile" type="file" class="form-control" accept=".csv,text/csv" />
                <div class="form-text">Columns: Task, Description. Up to 500 rows.</div>
                <span asp-validation-for="TemplateUpload.CsvFile" class="text-danger small"></span>
            </div>
            <div class="col-md-3 col-sm-6 align-self-end">
                <button type="submit" class="btn btn-primary w-100">Import Checklist</button>
            </div>
        </form>
    </div>
</div>

<div class="row gy-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header">
                <strong>@(Model.ChecklistEditor?.Id.HasValue == true ? "Edit Checklist" : "Create Checklist")</strong>
            </div>
            <div class="card-body">
                <form asp-action="SaveChecklist" method="post" class="vstack gap-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@Model.PropertyId" />
                    <input type="hidden" name="Id" value="@(Model.ChecklistEditor?.Id)" />
                    <div>
                        <label asp-for="ChecklistEditor.Name" class="form-label">Checklist name</label>
                        <input asp-for="ChecklistEditor.Name" name="Name" class="form-control" maxlength="160" required />
                        <span asp-validation-for="ChecklistEditor.Name" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="ChecklistEditor.ChecklistType" class="form-label">Checklist type</label>
                        <select class="form-select" name="ChecklistType" id="checklistTypeSelect" @(Model.ChecklistEditor?.CanChangeType == false ? "disabled" : null)>
                            <option value="Room" selected="@(Model.ChecklistEditor?.ChecklistType == PreventiveMaintenanceChecklistType.Room ? "selected" : null)">Room-based</option>
                            <option value="Area" selected="@(Model.ChecklistEditor?.ChecklistType == PreventiveMaintenanceChecklistType.Area ? "selected" : null)">Area-based</option>
                        </select>
                        @if (Model.ChecklistEditor?.CanChangeType == false)
                        {
                            <input type="hidden" name="ChecklistType" value="@Model.ChecklistEditor?.ChecklistType" />
                            <div class="form-text text-warning">Checklist type can’t be changed because sessions already exist.</div>
                        }
                    </div>
                    <div id="areaOptionsWrapper">
                        <label class="form-label">Suggested areas</label>
                        <textarea class="form-control" name="AreaOptionsText" id="areaOptionsText" rows="4" placeholder="e.g. Kitchen&#10;Laundry&#10;Patio">@Model.ChecklistEditor?.AreaOptionsText</textarea>
                        <div class="form-text">Enter one area per line or separate using commas.</div>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="checklistActive" @(Model.ChecklistEditor?.IsActive != false ? "checked" : null) />
                        <label class="form-check-label" for="checklistActive">Checklist is active</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@((Model.ChecklistEditor?.Id.HasValue ?? false) ? "Save Changes" : "Create Checklist")</button>
                        @if (Model.ChecklistEditor?.Id.HasValue == true)
                        {
                            <a asp-action="PmChecklists" asp-route-propertyId="@Model.PropertyId" class="btn btn-outline-secondary">Start New</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Checklists</strong>
                <span class="text-muted small">@Model.Checklists.Count @((Model.Checklists.Count == 1) ? "checklist" : "checklists")</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Checklists.Any())
                {
                    <div class="p-4 text-center text-muted">No checklists yet. Use the form to create one.</div>
                }
                else
                {
                    <div class="px-4 py-2 border-bottom small text-muted">
                        Drag the handle to reorder checklists. Order also controls the PM checklist dropdown on the Preventive Maintenance page.
                    </div>
                    <div id="pmChecklistOrderStatus" class="px-4 py-2 border-bottom small text-muted" hidden></div>
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:40px;"></th>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Tasks</th>
                                    <th>Sessions</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="pmChecklistTableBody" data-property-id="@Model.PropertyId">
                                @foreach (var checklist in Model.Checklists)
                                {
                                    <tr class="pm-checklist-row" data-checklist-id="@checklist.Id" draggable="true">
                                        <td class="text-center text-muted">
                                            <span class="pm-checklist-drag-handle" title="Drag to reorder" style="cursor: move;">&#x2630;</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@checklist.Name</div>
                                            @if (checklist.ChecklistType == PreventiveMaintenanceChecklistType.Area && checklist.AreaOptions.Any())
                                            {
                                                <div class="text-muted small">Areas: @string.Join(", ", checklist.AreaOptions)</div>
                                            }
                                        </td>
                                        <td>@(checklist.ChecklistType == PreventiveMaintenanceChecklistType.Area ? "Area" : "Room")</td>
                                        <td>@checklist.TaskCount</td>
                                        <td>@checklist.SessionCount</td>
                                        <td>
                                            @if (checklist.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="PmChecklists" asp-route-propertyId="@Model.PropertyId" asp-route-checklistId="@checklist.Id" class="btn btn-outline-secondary">Edit</a>
                                                <a asp-action="ChecklistTasks" asp-route-checklistId="@checklist.Id" asp-route-propertyId="@Model.PropertyId" class="btn btn-outline-primary">Tasks</a>
                                                <form asp-action="ToggleChecklist" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                                                    <input type="hidden" name="isActive" value="@(!checklist.IsActive)" />
                                                    <input type="hidden" name="id" value="@checklist.Id" />
                                                    <button type="submit" class="btn btn-outline-secondary">@((checklist.IsActive ? "Deactivate" : "Activate"))</button>
                                                </form>
                                                <form asp-action="DeleteChecklist"
                                                      asp-route-id="@checklist.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Delete this checklist? This cannot be undone.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                                                    <input type="hidden" name="id" value="@checklist.Id" />
                                                    <button type="submit" class="btn btn-outline-danger">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const typeSelect = document.getElementById('checklistTypeSelect');
            const areaWrapper = document.getElementById('areaOptionsWrapper');

            function syncAreaVisibility() {
                if (!typeSelect || !areaWrapper) {
                    return;
                }
                areaWrapper.hidden = typeSelect.value !== 'Area';
            }

            if (typeSelect) {
                typeSelect.addEventListener('change', syncAreaVisibility);
                syncAreaVisibility();
            }
        })();

        (function () {
            const tableBody = document.getElementById('pmChecklistTableBody');
            if (!tableBody) {
                return;
            }

            const propertyId = parseInt(tableBody.dataset.propertyId ?? '0', 10);
            if (!propertyId) {
                return;
            }

            const reorderEndpoint = '@Url.Action("ReorderChecklists", "Maintenance")';
            const statusBar = document.getElementById('pmChecklistOrderStatus');
            let statusHideTimer;
            let saveTimer;
            let lastSavedOrderJson = JSON.stringify(getCurrentOrder());

            bindRows();

            tableBody.addEventListener('dragover', (event) => {
                event.preventDefault();
                const dragging = tableBody.querySelector('.pm-checklist-row.dragging');
                if (!dragging) {
                    return;
                }
                const targetRow = event.target.closest('.pm-checklist-row');
                if (!targetRow || targetRow === dragging) {
                    return;
                }
                const rect = targetRow.getBoundingClientRect();
                const offset = event.clientY - rect.top;
                if (offset > rect.height / 2) {
                    targetRow.after(dragging);
                } else {
                    targetRow.before(dragging);
                }
            });

            function bindRows() {
                tableBody.querySelectorAll('.pm-checklist-row').forEach(row => {
                    if (row.dataset.dragBound === '1') {
                        return;
                    }
                    row.dataset.dragBound = '1';
                    row.addEventListener('dragstart', (event) => {
                        row.classList.add('dragging');
                        if (event.dataTransfer) {
                            event.dataTransfer.effectAllowed = 'move';
                        }
                    });
                    row.addEventListener('dragend', () => {
                        row.classList.remove('dragging');
                        scheduleOrderSave();
                    });
                });
            }

            function getCurrentOrder() {
                return Array.from(tableBody.querySelectorAll('.pm-checklist-row'))
                    .map(row => parseInt(row.dataset.checklistId ?? '0', 10))
                    .filter(id => !Number.isNaN(id) && id > 0);
            }

            function scheduleOrderSave() {
                const serialized = JSON.stringify(getCurrentOrder());
                if (serialized === lastSavedOrderJson) {
                    return;
                }

                if (saveTimer) {
                    clearTimeout(saveTimer);
                }

                saveTimer = setTimeout(() => {
                    const order = getCurrentOrder();
                    const refreshedSerialized = JSON.stringify(order);
                    if (refreshedSerialized === lastSavedOrderJson || order.length === 0) {
                        return;
                    }
                    persistOrder(order, refreshedSerialized);
                }, 200);
            }

            function getAntiForgeryToken() {
                const field = document.querySelector('input[name="__RequestVerificationToken"]');
                return field?.value ?? null;
            }

            async function persistOrder(order, serializedOrder) {
                const token = getAntiForgeryToken();
                if (!token) {
                    setStatus('Missing security token. Refresh and try again.', 'error');
                    return;
                }

                setStatus('Saving order…', 'pending');
                try {
                    const response = await fetch(reorderEndpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            propertyId: propertyId,
                            checklistIds: order
                        })
                    });

                    if (!response.ok) {
                        let errorMessage = 'Unable to save order.';
                        try {
                            const errorPayload = await response.json();
                            if (errorPayload?.error) {
                                errorMessage = errorPayload.error;
                            }
                        } catch {
                            // ignore parsing errors
                        }
                        throw new Error(errorMessage);
                    }

                    const payload = await response.json();
                    if (!payload || payload.success !== true) {
                        throw new Error('Unable to save order.');
                    }

                    lastSavedOrderJson = serializedOrder;
                    setStatus('Order saved.', 'success');
                } catch (error) {
                    console.error(error);
                    setStatus(error?.message ?? 'Unable to save order.', 'error');
                }
            }

            function setStatus(message, state) {
                if (!statusBar) {
                    return;
                }

                statusBar.hidden = false;
                statusBar.textContent = message;
                statusBar.classList.remove('text-muted', 'text-success', 'text-danger');
                if (state === 'success') {
                    statusBar.classList.add('text-success');
                }
                else if (state === 'error') {
                    statusBar.classList.add('text-danger');
                }
                else {
                    statusBar.classList.add('text-muted');
                }

                if (statusHideTimer) {
                    clearTimeout(statusHideTimer);
                }

                if (state === 'pending') {
                    return;
                }

                if (state === 'success') {
                    statusHideTimer = setTimeout(() => {
                        statusBar.hidden = true;
                    }, 2000);
                }
            }
        })();
    </script>
}
