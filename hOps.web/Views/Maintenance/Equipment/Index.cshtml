@model hOps.web.ViewModels.Maintenance.MaintenanceEquipmentIndexViewModel

@{
    ViewData["Title"] = "Maintenance Equipment";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="mb-0">Equipment Inventory</h2>
            <p class="text-muted mb-0">@Model.PropertyName</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Export" class="btn btn-outline-secondary btn-sm">
                Export CSV
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                Add Equipment
            </a>
        </div>
    </div>

    @{
        var message = ViewBag.EquipmentMessage as string;
        var error = ViewBag.EquipmentError as string;
    }
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@message</div>
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (!Model.Items.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <p class="mb-0 text-muted">No equipment records found for this property.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Brand / Model</th>
                            <th>Serial #</th>
                            <th>Installed</th>
                            <th>Warranty Ends</th>
                            <th>Updated</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id">@item.Name</a>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.Category) ? "—" : item.Category)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Location) ? "—" : item.Location)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Brand) || !string.IsNullOrWhiteSpace(item.Model))
                                    {
                                        <span>@($"{item.Brand} {item.Model}".Trim())</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.SerialNumber) ? "—" : item.SerialNumber)</td>
                                <td>@(item.InstalledOn.HasValue ? item.InstalledOn.Value.ToString("MMM d, yyyy") : "—")</td>
                                <td>@(item.WarrantyEndsOn.HasValue ? item.WarrantyEndsOn.Value.ToString("MMM d, yyyy") : "—")</td>
                                <td>@TimeZoneService.ConvertToUserTime(item.UpdatedAtUtc).ToString("g")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">View</a>
                                        @if (Model.CanManage)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Edit</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
