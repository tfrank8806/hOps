@using System.Globalization
@model EditUserPropertiesViewModel

@{
ViewData["Title"] = Html.Localize("Edit User Properties & Roles");
}

<h2>@string.Format(CultureInfo.InvariantCulture, Html.Localize("Edit Properties & Roles for {0}").ToString(), Model.Email ?? string.Empty)</h2>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">@Html.Localize(successMessage, successMessage)</div>
}

<form asp-action="EditUserProperties" method="post">
    <input type="hidden" asp-for="UserId" />

    <div class="form-group">
        <label>@Html.Localize("Properties")</label>
        <div>
            @foreach (var prop in Model.PropertyList)
            {
                bool selected = Model.SelectedPropertyIds?.Contains(prop.Id) ?? false;
                var propertyName = await Html.DisplayTranslatedTextAsync("Property", prop.Id.ToString(), "Name", prop.Name ?? string.Empty);
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedPropertyIds"
                           value="@prop.Id" id="prop_@prop.Id" @(selected ? "checked" : "") />
                    <label class="form-check-label" for="prop_@prop.Id">@propertyName (@prop.Code)</label>
                </div>
            }
        </div>
    </div>

    <div class="form-group mt-3">
        <label>@Html.Localize("Roles")</label>
        <div>
            @foreach (var role in Model.AllRoles)
            {
                bool selected = Model.SelectedRoles?.Contains(role) ?? false;
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedRoles"
                           value="@role" id="role_@role" @(selected ? "checked" : "") />
                    <label class="form-check-label" for="role_@role">@Html.Localize(role, role)</label>
                </div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-4">@Html.Localize("Save")</button>
    <a asp-action="Users" class="btn btn-secondary">@Html.Localize("Cancel")</a>
</form>

