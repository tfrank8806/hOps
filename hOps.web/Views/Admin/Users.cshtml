@using System.Text.Encodings.Web
@using System.Globalization
@model hOps.web.ViewModels.Admin.AdminUsersPageViewModel

@{
    ViewData["Title"] = Html.Localize("Manage Users");
    var propertyLookup = Model.PropertyNameLookup ?? new Dictionary<int, string>();
    var selectedPropertyIds = new HashSet<int>(Model.CreateUser.PropertyIds ?? new List<int>());
    var selectedRoles = new HashSet<string>(Model.CreateUser.SelectedRoles ?? new List<string>(), StringComparer.OrdinalIgnoreCase);
    var showCreateErrors = !ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("CreateUser", StringComparison.OrdinalIgnoreCase));
    var sortDirection = string.Equals(Model.SortDirection, "desc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";
    Func<string, string> getNextDirection = column =>
    {
        var isCurrent = string.Equals(Model.SortBy, column, StringComparison.OrdinalIgnoreCase);
        return isCurrent && sortDirection == "asc" ? "desc" : "asc";
    };
    Func<string, string> getSortIndicator = column =>
    {
        if (!string.Equals(Model.SortBy, column, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        return sortDirection == "desc" ? "↓" : "↑";
    };
    var sortLinkClass = "text-reset text-decoration-none d-inline-flex align-items-center gap-1";
    var sortableColumns = new[]
    {
        new { Key = "email", LabelKey = "Email", ThClass = "" },
        new { Key = "firstname", LabelKey = "First Name", ThClass = "" },
        new { Key = "lastname", LabelKey = "Last Name", ThClass = "" },
        new { Key = "status", LabelKey = "Status", ThClass = "" },
        new { Key = "roles", LabelKey = "Roles", ThClass = "" },
        new { Key = "properties", LabelKey = "Properties", ThClass = "" },
        new { Key = "lastlogin", LabelKey = "Last Login", ThClass = "text-nowrap" }
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@Html.Localize("Users")</h2>
    <button type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#createUserModal">
        @Html.Localize("Create User")
    </button>
</div>

@if (TempData["AdminUsersMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Html.Localize(successMessage, successMessage)
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Html.Localize("Close")"></button>
    </div>
}

@if (TempData["AdminUsersError"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Html.Localize(errorMessage, errorMessage)
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Html.Localize("Close")"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                @foreach (var column in sortableColumns)
                {
                    var indicator = getSortIndicator(column.Key);
                    var nextDirection = getNextDirection(column.Key);
                    var thClass = string.IsNullOrEmpty(column.ThClass) ? null : column.ThClass;
                    var isCurrentSort = string.Equals(Model.SortBy, column.Key, StringComparison.OrdinalIgnoreCase);
                    var ariaSort = isCurrentSort ? (sortDirection == "desc" ? "descending" : "ascending") : null;
                    <th class="@thClass" aria-sort="@ariaSort">
                        <a asp-action="Users"
                           asp-route-sortBy="@column.Key"
                           asp-route-sortDirection="@nextDirection"
                           class="@sortLinkClass">
                            @Html.Localize(column.LabelKey)
                            @if (!string.IsNullOrEmpty(indicator))
                            {
                                <span class="sort-indicator">@indicator</span>
                            }
                        </a>
                    </th>
                }
                <th class="text-nowrap">@Html.Localize("Actions")</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Users.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-4">@Html.Localize("No users found.")</td>
                </tr>
            }
            else
            {
                foreach (var user in Model.Users)
                {
                    var propertyNames = new List<string>();
                    if (user.PropertyIds != null && user.PropertyIds.Any())
                    {
                        foreach (var pid in user.PropertyIds)
                        {
                            var fallbackName = propertyLookup.TryGetValue(pid, out var name)
                                ? name ?? string.Empty
                                : pid.ToString(CultureInfo.InvariantCulture);
                            var translatedName = await Html.DisplayTranslatedTextAsync(
                                "Property",
                                pid.ToString(CultureInfo.InvariantCulture),
                                "Name",
                                fallbackName);
                            propertyNames.Add(translatedName.ToString());
                        }
                    }
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge text-bg-success-subtle">@Html.Localize("Active")</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">@Html.Localize("Inactive")</span>
                            }
                        </td>
                        <td>
                            @{
                                var localizedRoles = user.Roles?.Select(role => Html.Localize(role, role).ToString()).ToList() ?? new List<string>();
                            }
                            @string.Join(", ", localizedRoles)
                        </td>
                        <td>
                            @if (propertyNames.Any())
                            {
                                @string.Join(", ", propertyNames)
                            }
                            else
                            {
                                <em>@Html.Localize("None")</em>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (user.LastLoginAtUtc.HasValue)
                            {
                                @TimeZoneService.ConvertToUserTime(user.LastLoginAtUtc.Value).ToString("g", CultureInfo.CurrentCulture)
                            }
                            else
                            {
                                <em>@Html.Localize("Never")</em>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="EditUserProperties"
                                   asp-controller="Admin"
                                   asp-route-userId="@user.Id"
                                   class="btn btn-sm btn-info">
                                    @Html.Localize("Assign Properties")
                                </a>
                                @if (user.CanResetPassword)
                                {
                                    <form asp-action="ResetUserPassword" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-warning"
                                                onclick="return confirm(window.hopsTranslate('Admin.Users.ResetPasswordConfirm', 'Send a new temporary password to {0}?').replace('{0}', '@JavaScriptEncoder.Default.Encode(user.Email ?? string.Empty)'));">
                                            @Html.Localize("Reset Password")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-warning" disabled>
                                        @Html.Localize("Reset Password")
                                    </button>
                                }
                                @if (user.IsActive)
                                {
                                    if (user.CanDeactivate)
                                    {
                                        <form asp-action="DeactivateUser" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning"
                                                    onclick="return confirm(window.hopsTranslate('Admin.Users.DeactivateConfirm', 'Deactivate user {0}? They will no longer be able to sign in.').replace('{0}', '@JavaScriptEncoder.Default.Encode(user.Email ?? string.Empty)'));">
                                                @Html.Localize("Deactivate")
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning" disabled>
                                            @Html.Localize("Deactivate")
                                        </button>
                                    }
                                }
                                else
                                {
                                    if (user.CanReactivate)
                                    {
                                        <form asp-action="ReactivateUser" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    onclick="return confirm(window.hopsTranslate('Admin.Users.ReactivateConfirm', 'Reactivate user {0}? They will be able to sign in again.').replace('{0}', '@JavaScriptEncoder.Default.Encode(user.Email ?? string.Empty)'));">
                                                @Html.Localize("Reactivate")
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" disabled>
                                            @Html.Localize("Reactivate")
                                        </button>
                                    }
                                }
                                @if (user.CanDelete)
                                {
                                    <form asp-action="DeleteUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm(window.hopsTranslate('Admin.Users.DeleteConfirm', 'Delete user {0}? This action cannot be undone.').replace('{0}', '@JavaScriptEncoder.Default.Encode(user.Email ?? string.Empty)'));">
                                            @Html.Localize("Delete")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-danger" disabled>
                                        @Html.Localize("Delete")
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="modal fade"
     id="createUserModal"
     tabindex="-1"
     aria-labelledby="createUserModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createUserModalLabel">@Html.Localize("Create User")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Html.Localize("Close")"></button>
            </div>
            <form asp-action="CreateUser" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CreateUser.FirstName" class="form-label"></label>
                            <input asp-for="CreateUser.FirstName" class="form-control" />
                            <span asp-validation-for="CreateUser.FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CreateUser.LastName" class="form-label"></label>
                            <input asp-for="CreateUser.LastName" class="form-control" />
                            <span asp-validation-for="CreateUser.LastName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CreateUser.Email" class="form-label"></label>
                            <input asp-for="CreateUser.Email" class="form-control" type="email" />
                            <span asp-validation-for="CreateUser.Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CreateUser.MobilePhone" class="form-label"></label>
                            <input asp-for="CreateUser.MobilePhone" class="form-control" />
                            <span asp-validation-for="CreateUser.MobilePhone" class="text-danger"></span>
                        </div>
                        @if (Model.AvailableRoles.Any())
                        {
                            <div class="col-12">
                                <label asp-for="CreateUser.SelectedRoles" class="form-label">@Html.Localize("Roles")</label>
                                <select asp-for="CreateUser.SelectedRoles"
                                        class="form-select"
                                        multiple
                                        size="@(Math.Min(Model.AvailableRoles.Count, 6))">
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        <option value="@role" selected="@(selectedRoles.Contains(role) ? "selected" : null)">
                                            @Html.Localize(role, role)
                                        </option>
                                    }
                                </select>
                                <div class="form-text">@Html.Localize("Leave blank to assign the default User role.")</div>
                                <span asp-validation-for="CreateUser.SelectedRoles" class="text-danger"></span>
                            </div>
                        }
                        @if (Model.AvailableProperties.Any())
                        {
                            <div class="col-12">
                                <label class="form-label">@Html.Localize("Properties")</label>
                                <div class="row g-2">
                                    @foreach (var property in Model.AvailableProperties)
                                    {
                                        var translatedPropertyName = await Html.DisplayTranslatedTextAsync(
                                            "Property",
                                            property.Id.ToString(CultureInfo.InvariantCulture),
                                            "Name",
                                            property.Name ?? string.Empty);
                                        var propertyLabel = string.IsNullOrWhiteSpace(property.Code)
                                            ? translatedPropertyName.ToString()
                                            : string.Format(CultureInfo.InvariantCulture, "{0} ({1})", translatedPropertyName, property.Code);
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="CreateUser.PropertyIds"
                                                       value="@property.Id"
                                                       id="createUserProperty_@property.Id"
                                                       @(selectedPropertyIds.Contains(property.Id) ? "checked" : null) />
                                                <label class="form-check-label" for="createUserProperty_@property.Id">
                                                    @propertyLabel
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span asp-validation-for="CreateUser.PropertyIds" class="text-danger"></span>
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <div class="alert alert-warning mb-0">
                                    @Html.Localize("You currently do not have property access to assign. You can still create the user without properties.")
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Html.Localize("Cancel")</button>
                    <button type="submit" class="btn btn-primary">@Html.Localize("Create User")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (showCreateErrors)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalElement = document.getElementById('createUserModal');
                if (modalElement) {
                    var modal = new bootstrap.Modal(modalElement);
                    modal.show();
                }
            });
        </script>
    }
}






