@model IEnumerable<hOps.web.Models.UserWithAccessViewModel>

@{
    ViewData["Title"] = "Manage Users";
}

<h2>Users</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Roles</th>
            <th>Properties</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@string.Join(", ", user.Roles)</td>
                <td>
                    @if (user.PropertyIds != null && user.PropertyIds.Any())
                    {
                        @string.Join(", ", user.PropertyIds)
                    }
                    else
                    {
                        <em>None</em>
                    }
                </td>
                <td>
                    <a asp-action="EditUserProperties" asp-controller="Admin" asp-route-userId="@user.Id" class="btn btn-sm btn-info">
                        Assign Properties
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
