@model IEnumerable<hOps.web.Models.ApplicationUser>

@{
    ViewData["Title"] = "Manage Users";
}
<h2>Users</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Roles</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>--</td> <!-- TODO: Add roles later -->
            </tr>
        }
    </tbody>
</table>
