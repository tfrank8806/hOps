@model List<hOps.web.Models.UserAccessRequest>

@{
    ViewData["Title"] = "Access Requests";
}

<h2>Pending Access Requests</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <p>No pending access requests.</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Property Code</th>
                <th>Requested At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var req in Model)
            {
                <tr>
                    <td>@req.FirstName @req.LastName</td>
                    <td>@req.Email</td>
                    <td>@req.MobilePhone</td>
                    <td>@req.PropertyCode</td>
                    <td>@req.RequestedAt.ToString("g")</td>
                    <td>
                        <form asp-action="Approve" asp-controller="Admin" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@req.Id" />
                            <div class="mb-2">
                                <label class="form-label small mb-1" for="approveComments_@req.Id">Comments (optional)</label>
                                <textarea class="form-control form-control-sm"
                                          id="approveComments_@req.Id"
                                          name="comments"
                                          rows="2"
                                          placeholder="Included in approval email"></textarea>
                            </div>
                            <button type="submit" class="btn btn-success btn-sm w-100">Approve</button>
                        </form>
                        <form asp-action="Reject" asp-controller="Admin" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@req.Id" />
                            <div class="mb-2">
                                <label class="form-label small mb-1" for="rejectComments_@req.Id">Comments (optional)</label>
                                <textarea class="form-control form-control-sm"
                                          id="rejectComments_@req.Id"
                                          name="comments"
                                          rows="2"
                                          placeholder="Included in rejection email"></textarea>
                            </div>
                            <button type="submit" class="btn btn-danger btn-sm w-100">Reject</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
