@using System.Globalization
@model hOps.web.ViewModels.Admin.AccessRequestsPageViewModel

@{
    ViewData["Title"] = Html.Localize("Access Requests");
}

<h2>@Html.Localize("Pending Access Requests")</h2>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">@Html.Localize(successMessage, successMessage)</div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger">@Html.Localize(errorMessage, errorMessage)</div>
}

@if (!Model.Requests.Any())
{
    <p>@Html.Localize("No pending access requests.")</p>
}
else
{
    <form asp-action="ProcessAccessRequests" asp-controller="Admin" method="post" id="accessRequestsForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="page" value="@Model.PageNumber" />
        <div class="card mb-3">
            <div class="card-body row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label" for="bulkComments">@Html.Localize("Comments (optional)")</label>
                    <textarea class="form-control"
                              id="bulkComments"
                              name="comments"
                              rows="3"
                              placeholder="@Html.Localize("Included in the approval/denial email for each selected request")"></textarea>
                </div>
                <div class="col-md-4 d-flex flex-wrap gap-2 justify-content-md-end">
                    <button type="submit"
                            class="btn btn-success flex-grow-1"
                            name="actionType"
                            value="approve"
                            disabled>
                        @Html.Localize("Approve Selected")
                    </button>
                    <button type="submit"
                            class="btn btn-danger flex-grow-1"
                            name="actionType"
                            value="reject"
                            disabled>
                        @Html.Localize("Reject Selected")
                    </button>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
            <div class="text-muted small">
                @string.Format(
                    CultureInfo.InvariantCulture,
                    Html.Localize("Showing page {0} of {1} ({2} total requests)").ToString(),
                    Model.PageNumber,
                    Model.TotalPages,
                    Model.TotalCount)
            </div>
            @if (Model.TotalPages > 1)
            {
                <div class="btn-group btn-group-sm" role="group" aria-label="@Html.Localize("Pagination controls")">
                    <a class="btn btn-outline-secondary @(Model.HasPreviousPage ? string.Empty : "disabled")"
                       asp-action="AccessRequests"
                       asp-route-page="@(Model.PreviousPage)">
                        @Html.Localize("Previous")
                    </a>
                    <a class="btn btn-outline-secondary @(Model.HasNextPage ? string.Empty : "disabled")"
                       asp-action="AccessRequests"
                       asp-route-page="@(Model.NextPage)">
                        @Html.Localize("Next")
                    </a>
                </div>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead>
                    <tr>
                        <th style="width: 40px;">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="selectAllRequests" />
                        </th>
                        <th>@Html.Localize("Name")</th>
                        <th>@Html.Localize("Email")</th>
                        <th>@Html.Localize("Phone")</th>
                        <th>@Html.Localize("Property Code")</th>
                        <th>@Html.Localize("Requested At")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model.Requests)
                    {
                        <tr>
                            <td>
                                <input type="checkbox"
                                       class="form-check-input request-checkbox"
                                       name="selectedRequestIds"
                                       value="@req.Id" />
                            </td>
                            <td>@req.FirstName @req.LastName</td>
                            <td>@req.Email</td>
                            <td>@req.MobilePhone</td>
                            <td>@req.PropertyCode</td>
                            <td>@req.RequestedAt.ToString("g", CultureInfo.CurrentCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
}

@section Scripts {
    <script>
        (() => {
            const selectAll = document.getElementById('selectAllRequests');
            const checkboxes = Array.from(document.querySelectorAll('.request-checkbox'));
            const actionButtons = Array.from(document.querySelectorAll('#accessRequestsForm button[type="submit"]'));

            const updateButtonState = () => {
                const hasSelection = checkboxes.some(cb => cb.checked);
                actionButtons.forEach(btn => btn.disabled = !hasSelection);
            };

            if (selectAll) {
                selectAll.addEventListener('change', () => {
                    checkboxes.forEach(cb => cb.checked = selectAll.checked);
                    updateButtonState();
                });
            }

            checkboxes.forEach(cb => cb.addEventListener('change', () => {
                if (!cb.checked && selectAll) {
                    selectAll.checked = false;
                }
                updateButtonState();
            }));
        })();
    </script>
}
