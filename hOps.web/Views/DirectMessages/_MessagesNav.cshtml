@{
    var activeTab = (ViewData["ActiveMessagesTab"] as string ?? "conversations").ToLowerInvariant();
    var headerTitle = ViewData["MessagesHeaderTitle"] as string;
    if (string.IsNullOrWhiteSpace(headerTitle))
    {
        headerTitle = "Messages";
    }
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="h3 mb-0">@headerTitle</h1>
    <div class="btn-group" role="group" aria-label="@($"{headerTitle} navigation")">
        <a class="btn btn-outline-primary @(activeTab == "conversations" ? "active" : string.Empty)"
           asp-controller="DirectMessages"
           asp-action="Index">
            Conversations
        </a>
        <a class="btn btn-outline-primary @(activeTab == "alerts" ? "active" : string.Empty)"
           asp-controller="DirectMessages"
           asp-action="Alerts">
            Alerts
        </a>
    </div>
</div>
