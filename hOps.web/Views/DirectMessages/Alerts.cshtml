@using System.Collections.Generic
@using System.Linq
@using hOps.web.ViewModels.Messages
@using hOps.web.Utilities
@model hOps.web.ViewModels.Messages.AlertsPageViewModel
@{
    ViewData["Title"] = "Alerts";
    ViewData["MainContainerClass"] = "main-inner--wide";
    ViewData["ContentSurfaceClass"] = "content-surface--flush";
    var categories = Model.Categories ?? new List<AlertCategoryViewModel>();
    var hasAlerts = Model.Alerts.Any();
    var displayCategories = categories.Any()
        ? categories.OrderBy(c => c.SortOrder).ThenBy(c => c.Label).ToList()
        : new List<AlertCategoryViewModel>
        {
            new AlertCategoryViewModel
            {
                Key = AlertCategoryHelper.OtherKey,
                Label = "Alerts",
                Alerts = Model.Alerts
            }
        };
}

@section Styles {
    <style>
        .alert-category-grid {
            align-items: stretch;
        }

        .alert-category-card .alert-list {
            max-height: 16rem;
            overflow-y: auto;
        }

        .alert-category-card .alert-item + .alert-item {
            border-top: 1px solid #e9ecef;
            margin-top: 0.75rem;
            padding-top: 0.75rem;
        }

        .alert-category-card .alert-item p {
            font-size: 0.95rem;
        }

        .alert-list-section {
            padding: 1rem;
            border-radius: 0.5rem;
        }

        .alert-list-section--unread {
            background-color: #fff8e1;
            border: 1px solid rgba(255, 193, 7, 0.35);
        }

        .alert-list-section--read {
            background-color: #f8f9fa;
            border: 1px solid #e9ecef;
        }
    </style>
}

@await Html.PartialAsync("_MessagesNav")

<div class="card shadow-sm">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 class="h5 mb-0">Alerts</h2>
            <small class="text-muted">
                @(Model.UnreadAlertCount == 0
                    ? "All caught up"
                    : $"{Model.UnreadAlertCount} unread")
            </small>
        </div>
        <div class="d-flex gap-2">
            <form asp-controller="Notifications" asp-action="MarkAllRead" method="post" class="d-inline-flex">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-secondary btn-sm"
                        @(Model.UnreadAlertCount == 0 ? "disabled" : null)>
                    Mark all as read
                </button>
            </form>
            <form asp-controller="Notifications" asp-action="DeleteAll" method="post" class="d-inline-flex">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger btn-sm"
                        @(hasAlerts ? null : "disabled")>
                    Delete all
                </button>
            </form>
        </div>
    </div>
    <div class="card-body">
        @if (!hasAlerts)
        {
            <p class="text-muted mb-0">No alerts yet. New mentions and notifications will show up here.</p>
        }
        else
        {
            <div class="alert-category-grid row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var category in displayCategories)
                {
                    var unread = category.Alerts
                        .Where(a => !a.IsRead)
                        .OrderByDescending(a => a.CreatedAt)
                        .ToList();
                    var read = category.Alerts
                        .Where(a => a.IsRead)
                        .OrderByDescending(a => a.CreatedAt)
                        .ToList();
                    var statusBadgeClass = category.UnreadCount > 0 ? "badge bg-warning text-dark" : "badge bg-secondary-subtle text-secondary";
                    var statusText = category.UnreadCount > 0 ? $"{category.UnreadCount} unread" : "All read";
                    var categoryHasUnread = category.UnreadCount > 0;
                    var categoryHasAlerts = category.TotalCount > 0;
                    <div class="col" data-alert-category="@category.Key">
                        <div class="card alert-category-card h-100">
                            <div class="card-header bg-light border-bottom">
                                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                    <div>
                                        <div class="fw-semibold">@category.Label</div>
                                        <small class="text-muted">
                                            @(category.TotalCount == 1 ? "1 alert" : $"{category.TotalCount} alerts")
                                        </small>
                                    </div>
                                    <span class="@statusBadgeClass">@statusText</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <form asp-controller="Notifications"
                                          asp-action="MarkCategoryRead"
                                          method="post"
                                          class="d-inline-flex">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="categoryKey" value="@category.Key" />
                                        <button type="submit"
                                                class="btn btn-outline-secondary btn-sm"
                                                @(categoryHasUnread ? null : "disabled")>
                                            Mark all read
                                        </button>
                                    </form>
                                    <form asp-controller="Notifications"
                                          asp-action="DeleteCategory"
                                          method="post"
                                          class="d-inline-flex">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="categoryKey" value="@category.Key" />
                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                @(categoryHasAlerts ? null : "disabled")>
                                            Delete all
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div class="card-body d-flex flex-column gap-4">
                                <div class="alert-list-section alert-list-section--unread">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-uppercase small text-muted">Unread</span>
                                        <span class="badge bg-warning-subtle text-warning">@unread.Count</span>
                                    </div>
                                    @if (!unread.Any())
                                    {
                                        <p class="text-muted small mb-0">No unread alerts.</p>
                                    }
                                    else
                                    {
                                        <div class="alert-list">
                                            @foreach (var alert in unread)
                                            {
                                                var badgeClass = "bg-primary text-white";
                                                <div class="alert-item" data-alert-id="@alert.Id">
                                                    <div class="d-flex justify-content-between flex-wrap gap-2">
                                                        <div>
                                                            <div class="fw-semibold">@alert.Title</div>
                                                            <div class="text-muted small">@alert.CreatedAt.ToString("g")</div>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                                                            <span class="badge rounded-pill @badgeClass">@((alert.Type ?? "alert").ToUpperInvariant())</span>
                                                            <span class="badge bg-warning text-dark">Unread</span>
                                                            <div class="d-flex align-items-center gap-2">
                                                                @if (!string.IsNullOrWhiteSpace(alert.LinkUrl))
                                                                {
                                                                    <form asp-controller="Notifications"
                                                                          asp-action="Open"
                                                                          asp-route-id="@alert.Id"
                                                                          method="post"
                                                                          class="d-inline">
                                                                        @Html.AntiForgeryToken()
                                                                        <button type="submit" class="btn btn-outline-primary btn-sm">Open</button>
                                                                    </form>
                                                                }
                                                                <form asp-controller="Notifications"
                                                                      asp-action="Delete"
                                                                      asp-route-id="@alert.Id"
                                                                      method="post"
                                                                      class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(alert.Content))
                                                    {
                                                        <p class="text-muted mb-0 mt-2">@alert.Content</p>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="alert-list-section alert-list-section--read mt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-uppercase small text-muted">Read</span>
                                        <span class="badge bg-secondary-subtle text-secondary">@read.Count</span>
                                    </div>
                                    @if (!read.Any())
                                    {
                                        <p class="text-muted small mb-0">No read alerts.</p>
                                    }
                                    else
                                    {
                                        <div class="alert-list">
                                            @foreach (var alert in read)
                                            {
                                                var badgeClass = "bg-secondary-subtle text-secondary";
                                                <div class="alert-item" data-alert-id="@alert.Id">
                                                    <div class="d-flex justify-content-between flex-wrap gap-2">
                                                        <div>
                                                            <div class="fw-semibold">@alert.Title</div>
                                                            <div class="text-muted small">@alert.CreatedAt.ToString("g")</div>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                                                            <span class="badge rounded-pill @badgeClass">@((alert.Type ?? "alert").ToUpperInvariant())</span>
                                                            <span class="badge bg-secondary text-white">Read</span>
                                                            <div class="d-flex align-items-center gap-2">
                                                                @if (!string.IsNullOrWhiteSpace(alert.LinkUrl))
                                                                {
                                                                    <form asp-controller="Notifications"
                                                                          asp-action="Open"
                                                                          asp-route-id="@alert.Id"
                                                                          method="post"
                                                                          class="d-inline">
                                                                        @Html.AntiForgeryToken()
                                                                        <button type="submit" class="btn btn-outline-primary btn-sm">Open</button>
                                                                    </form>
                                                                }
                                                                <form asp-controller="Notifications"
                                                                      asp-action="Delete"
                                                                      asp-route-id="@alert.Id"
                                                                      method="post"
                                                                      class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(alert.Content))
                                                    {
                                                        <p class="text-muted mb-0 mt-2">@alert.Content</p>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
