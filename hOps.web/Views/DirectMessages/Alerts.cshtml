@using System.Linq
@using hOps.web.ViewModels.Messages
@model hOps.web.ViewModels.Messages.AlertsPageViewModel
@{
    ViewData["Title"] = "Alerts";
    ViewData["MainContainerClass"] = "main-inner--wide";
    ViewData["ContentSurfaceClass"] = "content-surface--flush";
    var categories = Model.Categories ?? new List<AlertCategoryViewModel>();
    var hasAlerts = Model.Alerts.Any();
    var unreadAlertsCount = Model.Alerts.Count(a => !a.IsRead);
    var readAlertsCount = Model.Alerts.Count(a => a.IsRead);
    var categorySummaries = categories.Where(c => c.TotalCount > 0).ToList();
    var unreadGroups = categories
        .Select(c => new
        {
            Category = c,
            Alerts = c.Alerts
                .Where(a => !a.IsRead)
                .OrderByDescending(a => a.CreatedAt)
                .ToList()
        })
        .Where(group => group.Alerts.Count > 0)
        .ToList();
    var readGroups = categories
        .Select(c => new
        {
            Category = c,
            Alerts = c.Alerts
                .Where(a => a.IsRead)
                .OrderByDescending(a => a.CreatedAt)
                .ToList()
        })
        .Where(group => group.Alerts.Count > 0)
        .ToList();
}

@await Html.PartialAsync("_MessagesNav")

<div class="card shadow-sm">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 class="h5 mb-0">Alerts</h2>
            <small class="text-muted">
                @(Model.UnreadAlertCount == 0
                    ? "All caught up"
                    : $"{Model.UnreadAlertCount} unread")
            </small>
        </div>
        <div class="d-flex gap-2">
            <form asp-controller="Notifications" asp-action="MarkAllRead" method="post" class="d-inline-flex">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-secondary btn-sm"
                        @(Model.UnreadAlertCount == 0 ? "disabled" : null)>
                    Mark all as read
                </button>
            </form>
            <form asp-controller="Notifications" asp-action="DeleteAll" method="post" class="d-inline-flex">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger btn-sm"
                        @(hasAlerts ? null : "disabled")>
                    Delete all
                </button>
            </form>
        </div>
    </div>
    <div class="card-body">
        @if (!hasAlerts)
        {
            <p class="text-muted mb-0">No alerts yet. New mentions and notifications will show up here.</p>
        }
        else
        {
            if (categorySummaries.Any())
            {
                <div class="d-flex flex-wrap gap-3 mb-4">
                    @foreach (var summary in categorySummaries)
                    {
                        var summaryBadgeClass = summary.UnreadCount > 0
                            ? "badge bg-warning text-dark"
                            : "badge bg-secondary-subtle text-secondary";
                        var summaryStatus = summary.UnreadCount > 0
                            ? $"{summary.UnreadCount} unread"
                            : "All read";
                        <div class="border rounded px-3 py-2 small" data-alert-category="@summary.Key">
                            <div class="fw-semibold">@summary.Label</div>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="h5 mb-0">@summary.TotalCount</span>
                                <span class="@summaryBadgeClass">@summaryStatus</span>
                            </div>
                        </div>
                    }
                </div>
            }
            <div class="accordion" id="alertsAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="alertsUnreadHeading">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#alertsUnreadCollapse"
                                aria-expanded="true" aria-controls="alertsUnreadCollapse">
                            Unread (@unreadAlertsCount)
                        </button>
                    </h2>
                    <div id="alertsUnreadCollapse" class="accordion-collapse collapse show" data-bs-parent="#alertsAccordion">
                        <div class="accordion-body p-0">
                            @if (!unreadGroups.Any())
                            {
                                <div class="text-muted small px-3 py-3">No unread alerts.</div>
                            }
                            else
                            {
                                @foreach (var group in unreadGroups)
                                {
                                    var countLabel = group.Alerts.Count == 1 ? "alert" : "alerts";
                                    <div class="border-top" data-alert-category="@group.Category.Key">
                                        <div class="px-3 py-2 bg-light border-bottom d-flex justify-content-between align-items-center">
                                            <div class="fw-semibold text-uppercase small text-muted">@group.Category.Label</div>
                                            <span class="badge bg-secondary-subtle text-secondary">@group.Alerts.Count @countLabel</span>
                                        </div>
                                        <div class="list-group list-group-flush">
                                            @foreach (var alert in group.Alerts)
                                            {
                                                var badgeClass = "bg-primary text-white";
                                                <div class="list-group-item px-0" data-alert-category="@group.Category.Key">
                                                    <div class="d-flex justify-content-between flex-wrap gap-2">
                                                        <div>
                                                            <div class="fw-semibold">@alert.Title</div>
                                                            <div class="text-muted small">@alert.CreatedAt.ToString("g")</div>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                                                            <span class="badge rounded-pill @badgeClass">@((alert.Type ?? "alert").ToUpperInvariant())</span>
                                                            <span class="badge bg-warning text-dark">Unread</span>
                                                            <div class="d-flex align-items-center gap-2">
                                                                @if (!string.IsNullOrWhiteSpace(alert.LinkUrl))
                                                                {
                                                                    <form asp-controller="Notifications"
                                                                          asp-action="Open"
                                                                          asp-route-id="@alert.Id"
                                                                          method="post"
                                                                          class="d-inline">
                                                                        @Html.AntiForgeryToken()
                                                                        <button type="submit" class="btn btn-outline-primary btn-sm">Open</button>
                                                                    </form>
                                                                }
                                                                <form asp-controller="Notifications"
                                                                      asp-action="Delete"
                                                                      asp-route-id="@alert.Id"
                                                                      method="post"
                                                                      class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(alert.Content))
                                                    {
                                                        <p class="text-muted mb-0 mt-2">@alert.Content</p>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="alertsReadHeading">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#alertsReadCollapse"
                                aria-expanded="false" aria-controls="alertsReadCollapse">
                            Read (@readAlertsCount)
                        </button>
                    </h2>
                    <div id="alertsReadCollapse" class="accordion-collapse collapse" data-bs-parent="#alertsAccordion">
                        <div class="accordion-body p-0">
                            @if (!readGroups.Any())
                            {
                                <div class="text-muted small px-3 py-3">No read alerts yet.</div>
                            }
                            else
                            {
                                @foreach (var group in readGroups)
                                {
                                    var countLabel = group.Alerts.Count == 1 ? "alert" : "alerts";
                                    <div class="border-top" data-alert-category="@group.Category.Key">
                                        <div class="px-3 py-2 bg-light border-bottom d-flex justify-content-between align-items-center">
                                            <div class="fw-semibold text-uppercase small text-muted">@group.Category.Label</div>
                                            <span class="badge bg-secondary-subtle text-secondary">@group.Alerts.Count @countLabel</span>
                                        </div>
                                        <div class="list-group list-group-flush">
                                            @foreach (var alert in group.Alerts)
                                            {
                                                var badgeClass = "bg-secondary-subtle text-secondary";
                                                <div class="list-group-item px-0" data-alert-category="@group.Category.Key">
                                                    <div class="d-flex justify-content-between flex-wrap gap-2">
                                                        <div>
                                                            <div class="fw-semibold">@alert.Title</div>
                                                            <div class="text-muted small">@alert.CreatedAt.ToString("g")</div>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                                                            <span class="badge rounded-pill @badgeClass">@((alert.Type ?? "alert").ToUpperInvariant())</span>
                                                            <div class="d-flex align-items-center gap-2">
                                                                @if (!string.IsNullOrWhiteSpace(alert.LinkUrl))
                                                                {
                                                                    <form asp-controller="Notifications"
                                                                          asp-action="Open"
                                                                          asp-route-id="@alert.Id"
                                                                          method="post"
                                                                          class="d-inline">
                                                                        @Html.AntiForgeryToken()
                                                                        <button type="submit" class="btn btn-outline-primary btn-sm">Open</button>
                                                                    </form>
                                                                }
                                                                <form asp-controller="Notifications"
                                                                      asp-action="Delete"
                                                                      asp-route-id="@alert.Id"
                                                                      method="post"
                                                                      class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(alert.Content))
                                                    {
                                                        <p class="text-muted mb-0 mt-2">@alert.Content</p>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
