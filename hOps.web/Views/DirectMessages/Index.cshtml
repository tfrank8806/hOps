@using System.Globalization
@using hOps.web.Utilities
@model hOps.web.ViewModels.Messages.DirectMessagePageViewModel

@{
    ViewData["Title"] = Html.Localize("DirectMessages.Title", "Messages").ToString();
    ViewData["MainContainerClass"] = "main-inner--wide";
    ViewData["ContentSurfaceClass"] = "content-surface--flush";
    var showNewConversation = Model.ShowNewConversation;
}

@await Html.PartialAsync("_MessagesNav")

<div class="row g-4 direct-messages-page align-items-stretch flex-grow-1">
    <div class="col-lg-4 col-xl-3 col-xxl-3 d-flex">
        <div class="card shadow-sm flex-fill">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h2 class="h5 mb-0">@Html.Localize("DirectMessages.Conversations.Heading", "Conversations")</h2>
                <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#newConversationForm" aria-expanded="@(showNewConversation ? "true" : "false")" aria-controls="newConversationForm" @(Model.AvailableRecipients.Any() ? string.Empty : "disabled")>
                    @Html.Localize("DirectMessages.Conversations.NewMessage", "New Message")
                </button>
            </div>
            <div class="card-body p-0 d-flex flex-column">
                <div class="collapse border-bottom @(showNewConversation ? "show" : string.Empty)" id="newConversationForm" data-dm-new-conversation="true">
                    @if (Model.AvailableRecipients.Any())
                    {
                        <form asp-action="Start" method="post" class="p-3" data-dm-existing-url="@Url.Action("Index", "DirectMessages")">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="newConversationRecipient" class="form-label">@Html.Localize("DirectMessages.Conversations.RecipientLabel", "Recipient")</label>
                                <select class="form-select" id="newConversationRecipient" name="RecipientUserId" required>
                                    <option value="" selected disabled>@Html.Localize("DirectMessages.Conversations.SelectTeammate", "Select a teammate")</option>
                                    @foreach (var option in Model.AvailableRecipients)
                                    {
                                        var isSelected = !string.IsNullOrEmpty(Model.NewConversation.RecipientUserId)
                                            && string.Equals(Model.NewConversation.RecipientUserId, option.UserId, StringComparison.OrdinalIgnoreCase);
                                        <option value="@option.UserId" data-conversation-id="@option.ConversationId" selected="@(isSelected ? "selected" : null)">@option.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="newConversationBody" class="form-label">@Html.Localize("DirectMessages.Conversations.MessageLabel", "Message")</label>
                                <textarea class="form-control" id="newConversationBody" name="Body" rows="3" maxlength="2000" required data-enable-mentions="true" placeholder='@Html.Localize("DirectMessages.Conversations.MessagePlaceholder", "Type a message...")'></textarea>
                            </div>
                            <div class="d-flex justify-content-end gap-2 align-items-center">
                                <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#newConversationForm">@Html.Localize("Cancel")</button>
                                <button class="btn btn-primary btn-sm" type="submit">@Html.Localize("DirectMessages.Conversations.Send", "Send")</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="p-3 text-muted small">
                            @Html.Localize("DirectMessages.Conversations.NoRecipients", "Messaging is limited to teammates assigned to the same properties as you. Once you share a property with someone, they will appear here.")
                        </div>
                    }
                </div>
                <div class="direct-messages-conversation-list flex-grow-1 overflow-auto"
                     data-dm-conversation-list
                     data-dm-conversation-list-url="@Url.Action("ConversationListPartial")"
                     data-dm-active-conversation-id="@(Model.ActiveConversation?.ConversationId ?? 0)">
                    @await Html.PartialAsync("_ConversationItems", Model)
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8 col-xl-9 col-xxl-9 d-flex">
        <div class="card shadow-sm flex-fill">
            <div class="card-header">
                @if (Model.ActiveConversation != null)
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 mb-0">@Model.ActiveConversation.ParticipantName</h2>
                            <small class="text-muted">@Html.Localize("DirectMessages.Conversations.DetailLabel", "Direct messages")</small>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.ActiveConversation.ParticipantEmail))
                        {
                            <a class="btn btn-outline-secondary btn-sm" href="mailto:@Model.ActiveConversation.ParticipantEmail">@Html.Localize("DirectMessages.Conversations.EmailButton", "Email")</a>
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary btn-sm" type="button" disabled title='@Html.Localize("DirectMessages.Conversations.EmailUnavailable", "Email address unavailable")'>@Html.Localize("DirectMessages.Conversations.EmailButton", "Email")</button>
                        }
                    </div>
                }
                else
                {
                    <h2 class="h5 mb-0">@Html.Localize("DirectMessages.Conversations.SelectHeading", "Select a conversation")</h2>
                }
            </div>
            <div class="card-body d-flex flex-column gap-3">
                @if (TempData["DirectMessageMessage"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @Html.Localize(successMessage, successMessage)
                        <button class="btn-close" type="button" data-bs-dismiss="alert" aria-label='@Html.Localize("Close")'></button>
                    </div>
                }
                @if (TempData["DirectMessageError"] is string errorMessage)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @Html.Localize(errorMessage, errorMessage)
                        <button class="btn-close" type="button" data-bs-dismiss="alert" aria-label='@Html.Localize("Close")'></button>
                    </div>
                }

                @if (Model.ActiveConversation == null)
                {
                    <div class="direct-message-placeholder text-center text-muted py-5">
                        <p class="fw-semibold mb-1">@Html.Localize("DirectMessages.Conversations.NoneSelected", "No conversation selected")</p>
                        <p class="mb-0">@Html.Localize("DirectMessages.Conversations.SelectPrompt", "Choose a conversation from the left or start a new one.")</p>
                    </div>
                }
                else
                {
                    var participantName = Model.ActiveConversation.ParticipantName ?? Html.Localize("DirectMessages.Conversations.DefaultParticipant", "Conversation").ToString();
                    var participantEmail = Model.ActiveConversation.ParticipantEmail;
                    var initial = participantName.Trim().Length > 0
                        ? participantName.Trim()[0].ToString().ToUpperInvariant()
                        : "?";
                    <div class="direct-messages-widget__summary direct-messages-summary mb-2">
                        <div class="direct-messages-widget__summary-avatar">@initial</div>
                        <div class="direct-messages-widget__summary-body">
                            <span class="direct-messages-widget__summary-name">@participantName</span>
                            <span class="direct-messages-widget__summary-meta">@Html.Localize("DirectMessages.Conversations.DetailLabel", "Direct messages")</span>
                        </div>
                        <div class="d-flex flex-column gap-2 align-items-stretch">
                            @if (!string.IsNullOrWhiteSpace(participantEmail))
                            {
                                <a class="btn btn-outline-primary btn-sm" href="mailto:@participantEmail">@Html.Localize("DirectMessages.Conversations.EmailButton", "Email")</a>
                            }
                            else
                            {
                                <button class="btn btn-outline-primary btn-sm" type="button" disabled title='@Html.Localize("DirectMessages.Conversations.EmailUnavailable", "Email address unavailable")'>@Html.Localize("DirectMessages.Conversations.EmailButton", "Email")</button>
                            }
                            <form asp-action="Delete" method="post" onsubmit="return confirm(window.hopsTranslate('DirectMessages.Conversations.ConfirmDelete', 'Delete this conversation? This cannot be undone.'));">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="conversationId" value="@Model.ActiveConversation.ConversationId" />
                                <button class="btn btn-outline-danger btn-sm w-100" type="submit">@Html.Localize("DirectMessages.Conversations.Delete", "Delete")</button>
                            </form>
                        </div>
                    </div>

                    <div class="direct-message-thread flex-grow-1"
                         data-dm-thread
                         data-dm-thread-url="@Url.Action("ConversationMessagesPartial")"
                         data-dm-active-conversation-id="@(Model.ActiveConversation.ConversationId)">
                        <div class="direct-message-scroll" id="directMessageScroll" data-dm-thread-scroll>
                            @await Html.PartialAsync("_ConversationMessages", Model.ActiveConversation)
                        </div>
                    </div>

                    <form asp-action="Send" method="post" class="direct-message-composer mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Form.ConversationId" value="@Model.ActiveConversation.ConversationId" />
                        <div class="direct-message-composer__controls">
                            <textarea class="form-control flex-grow-1" asp-for="Form.Body" rows="2" maxlength="2000" placeholder='@Html.Localize("DirectMessages.Conversations.MessagePlaceholder", "Type a message...")' required data-enable-mentions="true"></textarea>
                            <button class="btn btn-primary flex-shrink-0" type="submit">@Html.Localize("DirectMessages.Conversations.Send", "Send")</button>
                        </div>
                        <span asp-validation-for="Form.Body" class="text-danger small"></span>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .direct-messages-conversation-list {
            display: flex;
            flex-direction: column;
        }

        .direct-messages-conversation-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            text-decoration: none;
            color: inherit;
            border-bottom: 1px solid rgba(148, 163, 184, 0.2);
            transition: background-color 0.15s ease, box-shadow 0.15s ease;
        }

        .direct-messages-conversation-item:last-child {
            border-bottom: none;
        }

        .direct-messages-conversation-item:hover {
            background-color: rgba(13, 110, 253, 0.08);
        }

        .direct-messages-conversation-item.active {
            background: linear-gradient(135deg, #0d6efd 0%, #2575fc 100%);
            color: #fff;
            box-shadow: 0 8px 16px rgba(13, 110, 253, 0.25);
        }

        .direct-messages-conversation-item__avatar {
            flex-shrink: 0;
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 50%;
            background: rgba(13, 110, 253, 0.12);
            color: #0d6efd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            text-transform: uppercase;
        }

        .direct-messages-conversation-item.active .direct-messages-conversation-item__avatar {
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
        }

        .direct-messages-conversation-item__body {
            flex: 1 1 auto;
            min-width: 0;
        }

        .direct-messages-conversation-item__row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .direct-messages-conversation-item__name {
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: normal;
            word-break: break-word;
        }

        .direct-messages-conversation-item__time {
            margin-left: auto;
            font-size: 0.75rem;
            color: rgba(15, 46, 97, 0.55);
        }

        .direct-messages-conversation-item.active .direct-messages-conversation-item__time {
            color: rgba(255, 255, 255, 0.75);
        }

        .direct-messages-conversation-item__preview {
            font-size: 0.85rem;
            color: rgba(15, 46, 97, 0.75);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .direct-messages-conversation-item__preview--unread {
            font-weight: 600;
            color: #0d6efd;
        }

        .direct-messages-conversation-item.active .direct-messages-conversation-item__preview {
            color: rgba(255, 255, 255, 0.85);
        }

        .direct-messages-conversation-item__badge {
            margin-left: 0.5rem;
            align-self: flex-start;
        }

        .direct-messages-conversation-list__empty {
            border-top: 1px solid rgba(148, 163, 184, 0.2);
        }

        .direct-message-thread {
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
        }

        .direct-message-scroll {
            flex: 1 1 auto;
            max-height: 500px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding-right: 0.25rem;
        }

        .message-bubble {
            max-width: 75%;
            padding: 0.75rem 1rem;
            border-radius: 1rem;
            box-shadow: 0 4px 12px rgba(15, 46, 97, 0.12);
        }

        .message-bubble.message-incoming {
            align-self: flex-start;
            background-color: #ffffff;
            border: 1px solid rgba(148, 163, 184, 0.35);
        }

        .message-bubble.message-outgoing {
            align-self: flex-end;
            background: linear-gradient(135deg, #0d6efd 0%, #4f8aff 100%);
            color: #fff;
        }

        .message-bubble .message-meta {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            margin-bottom: 0.35rem;
        }

        .message-bubble.message-outgoing .message-meta {
            color: rgba(255, 255, 255, 0.85);
        }

        .message-bubble.message-outgoing .message-body {
            color: #fff;
        }

        .direct-message-composer .form-control {
            resize: vertical;
        }

        @@media (max-width: 991.98px) {
            .message-bubble {
                max-width: 100%;
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/directMessages.js"></script>
}



