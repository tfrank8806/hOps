@using hOps.web.Utilities
@model hOps.web.ViewModels.Messages.DirectMessagePageViewModel

@{
    ViewData["Title"] = "Messages";
    ViewData["MainContainerClass"] = "main-inner--wide";
    var showNewConversation = Model.ShowNewConversation;
}

<div class="row g-4 direct-messages-page align-items-stretch flex-grow-1">
    <div class="col-lg-3 col-xl-3 col-xxl-2 d-flex">
        <div class="card shadow-sm flex-fill">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h2 class="h5 mb-0">Conversations</h2>
                <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#newConversationForm" aria-expanded="@(showNewConversation ? "true" : "false")" aria-controls="newConversationForm" @(Model.AvailableRecipients.Any() ? string.Empty : "disabled")>
                    New Message
                </button>
            </div>
            <div class="card-body p-0 d-flex flex-column">
                <div class="collapse border-bottom @(showNewConversation ? "show" : string.Empty)" id="newConversationForm" data-dm-new-conversation="true">
                    @if (Model.AvailableRecipients.Any())
                    {
                        <form asp-action="Start" method="post" class="p-3" data-dm-existing-url="@Url.Action("Index", "DirectMessages")">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="newConversationRecipient" class="form-label">Recipient</label>
                                <select class="form-select" id="newConversationRecipient" name="RecipientUserId" required>
                                    <option value="" selected disabled>Select a teammate</option>
                                    @foreach (var option in Model.AvailableRecipients)
                                    {
                                        var isSelected = !string.IsNullOrEmpty(Model.NewConversation.RecipientUserId)
                                            && string.Equals(Model.NewConversation.RecipientUserId, option.UserId, StringComparison.OrdinalIgnoreCase);
                                        <option value="@option.UserId" data-conversation-id="@option.ConversationId" selected="@(isSelected ? "selected" : null)">@option.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="newConversationBody" class="form-label">Message</label>
                                <textarea class="form-control" id="newConversationBody" name="Body" rows="3" maxlength="2000" required data-enable-mentions="true"></textarea>
                            </div>
                            <div class="d-flex justify-content-end gap-2 align-items-center">
                                <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#newConversationForm">Cancel</button>
                                <button class="btn btn-primary btn-sm" type="submit">Send</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="p-3 text-muted small">
                            Messaging is limited to teammates assigned to the same properties as you. Once you share a property with someone, they will appear here.
                        </div>
                    }
                </div>
                <div class="direct-messages-conversation-list flex-grow-1 overflow-auto">
                    @if (!Model.Conversations.Any())
                    {
                        <div class="direct-messages-conversation-list__empty text-muted small px-3 py-4">
                            No conversations yet.
                        </div>
                    }
                    else
                    {
                        foreach (var conversation in Model.Conversations)
                        {
                            var url = Url.Action("Index", new { conversationId = conversation.ConversationId });
                            var displayName = string.IsNullOrWhiteSpace(conversation.ParticipantName)
                                ? (!string.IsNullOrWhiteSpace(conversation.ParticipantEmail) ? conversation.ParticipantEmail : "Teammate")
                                : conversation.ParticipantName;
                            var participantInitial = string.IsNullOrWhiteSpace(displayName)
                                ? "?"
                                : displayName.Trim()[0].ToString().ToUpperInvariant();
                            var lastTimestamp = conversation.LastMessageAt.HasValue
                                ? TimeZoneService.ConvertToUserTime(conversation.LastMessageAt.Value)
                                : (DateTime?)null;
                            var isActive = Model.ActiveConversation?.ConversationId == conversation.ConversationId;
                            <a href="@url" class="direct-messages-conversation-item @(isActive ? "active" : string.Empty)">
                                <div class="direct-messages-conversation-item__avatar">@participantInitial</div>
                                <div class="direct-messages-conversation-item__body">
                                    <div class="direct-messages-conversation-item__row">
                                        <span class="direct-messages-conversation-item__name">@displayName</span>
                                        @if (lastTimestamp.HasValue)
                                        {
                                            <time datetime="@lastTimestamp.Value.ToString("o")" class="direct-messages-conversation-item__time">@lastTimestamp.Value.ToString("g")</time>
                                        }
                                    </div>
                                    <div class="direct-messages-conversation-item__preview @(conversation.HasUnread ? "direct-messages-conversation-item__preview--unread" : string.Empty)">
                                        @(string.IsNullOrWhiteSpace(conversation.LastMessagePreview) ? "…" : conversation.LastMessagePreview)
                                    </div>
                                </div>
                                @if (conversation.HasUnread)
                                {
                                    <span class="badge rounded-pill bg-primary direct-messages-conversation-item__badge">@conversation.UnreadCount</span>
                                }
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-9 col-xl-9 col-xxl-10 d-flex">
        <div class="card shadow-sm flex-fill">
            <div class="card-header">
                @if (Model.ActiveConversation != null)
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 mb-0">@Model.ActiveConversation.ParticipantName</h2>
                            <small class="text-muted">Direct messages</small>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.ActiveConversation.ParticipantEmail))
                        {
                            <a class="btn btn-outline-secondary btn-sm" href="mailto:@Model.ActiveConversation.ParticipantEmail">Email</a>
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary btn-sm" type="button" disabled title="Email address unavailable">Email</button>
                        }
                    </div>
                }
                else
                {
                    <h2 class="h5 mb-0">Select a conversation</h2>
                }
            </div>
            <div class="card-body d-flex flex-column gap-3">
                @if (TempData["DirectMessageMessage"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @successMessage
                        <button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["DirectMessageError"] is string errorMessage)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @errorMessage
                        <button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (Model.ActiveConversation == null)
                {
                    <div class="direct-message-placeholder text-center text-muted py-5">
                        <p class="fw-semibold mb-1">No conversation selected</p>
                        <p class="mb-0">Choose a conversation from the left or start a new one.</p>
                    </div>
                }
                else
                {
                    var participantName = Model.ActiveConversation.ParticipantName ?? "Conversation";
                    var participantEmail = Model.ActiveConversation.ParticipantEmail;
                    var initial = participantName.Trim().Length > 0
                        ? participantName.Trim()[0].ToString().ToUpperInvariant()
                        : "?";
                    <div class="direct-messages-widget__summary direct-messages-summary mb-2">
                        <div class="direct-messages-widget__summary-avatar">@initial</div>
                        <div class="direct-messages-widget__summary-body">
                            <span class="direct-messages-widget__summary-name">@participantName</span>
                            <span class="direct-messages-widget__summary-meta">Direct messages</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(participantEmail))
                        {
                            <a class="btn btn-outline-primary btn-sm" href="mailto:@participantEmail">Email</a>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary btn-sm" type="button" disabled title="Email address unavailable">Email</button>
                        }
                    </div>

                    <div class="direct-message-thread flex-grow-1">
                        <div class="direct-message-scroll" id="directMessageScroll">
                            @foreach (var message in Model.ActiveConversation.Messages)
                            {
                                <div class="message-bubble @(message.IsOwnMessage ? "message-outgoing" : "message-incoming")">
                                    <div class="message-meta">
                                        <span class="message-sender">@message.SenderName</span>
                                        <span class="message-time text-muted">@message.SentAt.ToString("g")</span>
                                    </div>
                                    <div class="message-body">@Html.Raw(MentionMarkupFormatter.ToHtml(message.Body))</div>
                                </div>
                            }
                        </div>
                    </div>

                    <form asp-action="Send" method="post" class="direct-message-composer mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Form.ConversationId" value="@Model.ActiveConversation.ConversationId" />
                        <div class="direct-message-composer__controls">
                            <textarea class="form-control flex-grow-1" asp-for="Form.Body" rows="2" maxlength="2000" placeholder="Type a message..." required data-enable-mentions="true"></textarea>
                            <button class="btn btn-primary flex-shrink-0" type="submit">Send</button>
                        </div>
                        <span asp-validation-for="Form.Body" class="text-danger small"></span>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .direct-messages-conversation-list {
            display: flex;
            flex-direction: column;
        }

        .direct-messages-conversation-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            text-decoration: none;
            color: inherit;
            border-bottom: 1px solid rgba(148, 163, 184, 0.2);
            transition: background-color 0.15s ease, box-shadow 0.15s ease;
        }

        .direct-messages-conversation-item:last-child {
            border-bottom: none;
        }

        .direct-messages-conversation-item:hover {
            background-color: rgba(13, 110, 253, 0.08);
        }

        .direct-messages-conversation-item.active {
            background: linear-gradient(135deg, #0d6efd 0%, #2575fc 100%);
            color: #fff;
            box-shadow: 0 8px 16px rgba(13, 110, 253, 0.25);
        }

        .direct-messages-conversation-item__avatar {
            flex-shrink: 0;
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 50%;
            background: rgba(13, 110, 253, 0.12);
            color: #0d6efd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            text-transform: uppercase;
        }

        .direct-messages-conversation-item.active .direct-messages-conversation-item__avatar {
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
        }

        .direct-messages-conversation-item__body {
            flex: 1 1 auto;
            min-width: 0;
        }

        .direct-messages-conversation-item__row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .direct-messages-conversation-item__name {
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .direct-messages-conversation-item__time {
            margin-left: auto;
            font-size: 0.75rem;
            color: rgba(15, 46, 97, 0.55);
        }

        .direct-messages-conversation-item.active .direct-messages-conversation-item__time {
            color: rgba(255, 255, 255, 0.75);
        }

        .direct-messages-conversation-item__preview {
            font-size: 0.85rem;
            color: rgba(15, 46, 97, 0.75);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .direct-messages-conversation-item__preview--unread {
            font-weight: 600;
            color: #0d6efd;
        }

        .direct-messages-conversation-item.active .direct-messages-conversation-item__preview {
            color: rgba(255, 255, 255, 0.85);
        }

        .direct-messages-conversation-item__badge {
            margin-left: 0.5rem;
            align-self: flex-start;
        }

        .direct-messages-conversation-list__empty {
            border-top: 1px solid rgba(148, 163, 184, 0.2);
        }

        .direct-message-thread {
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
        }

        .direct-message-scroll {
            flex: 1 1 auto;
            max-height: 500px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding-right: 0.25rem;
        }

        .message-bubble {
            max-width: 75%;
            padding: 0.75rem 1rem;
            border-radius: 1rem;
            box-shadow: 0 4px 12px rgba(15, 46, 97, 0.12);
        }

        .message-bubble.message-incoming {
            align-self: flex-start;
            background-color: #ffffff;
            border: 1px solid rgba(148, 163, 184, 0.35);
        }

        .message-bubble.message-outgoing {
            align-self: flex-end;
            background: linear-gradient(135deg, #0d6efd 0%, #4f8aff 100%);
            color: #fff;
        }

        .message-bubble .message-meta {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            margin-bottom: 0.35rem;
        }

        .message-bubble.message-outgoing .message-meta {
            color: rgba(255, 255, 255, 0.85);
        }

        .message-bubble.message-outgoing .message-body {
            color: #fff;
        }

        .direct-message-composer .form-control {
            resize: vertical;
        }

        @@media (max-width: 991.98px) {
            .message-bubble {
                max-width: 100%;
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/directMessages.js"></script>
}


