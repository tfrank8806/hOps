@using System.Text.Json
@using System.Linq
@using System.Net
@model hOps.web.ViewModels.PreventiveMaintenance.PreventiveMaintenanceIndexViewModel
@{
    ViewData["Title"] = "PMs";
    var localNow = ViewBag.LocalNow is DateTime dt ? dt : TimeZoneService.ConvertToUserTime(DateTime.UtcNow);
    var initialSessionJson = Model.ActiveSession != null
        ? JsonSerializer.Serialize(Model.ActiveSession, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase })
        : "null";
}

<div id="pmApp"
     data-start-url="@Url.Action("StartSession", "PreventiveMaintenance")"
     data-update-url="@Url.Action("UpdateTask", "PreventiveMaintenance")"
     data-pause-url="@Url.Action("PauseSession", "PreventiveMaintenance")"
     data-resume-url="@Url.Action("ResumeSession", "PreventiveMaintenance")"
     data-finish-url="@Url.Action("FinishSession", "PreventiveMaintenance")"
     data-active-session-url="@Url.Action("ActiveSessionStatus", "PreventiveMaintenance")"
     data-has-checklist="@Model.HasChecklist.ToString().ToLowerInvariant()"
     data-requires-area="@Model.RequiresArea.ToString().ToLowerInvariant()"
     data-checklist-id="@Model.SelectedChecklistId">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <h2 class="mb-0">Preventative Maintenance (PMs)</h2>
            <p class="text-muted mb-0 small">Log PM sessions, track durations, and stay ahead of upcoming rooms.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Maintenance"
               asp-action="PmChecklists"
               asp-route-propertyId="@Model.PropertyId"
               asp-route-checklistId="@Model.SelectedChecklistId"
               class="btn btn-outline-secondary btn-sm">Edit Checklist</a>
            <a asp-controller="PreventiveMaintenance" asp-action="Archive" class="btn btn-outline-secondary btn-sm">View Archive</a>
            <button type="button" class="btn btn-primary" id="pmStartToggle">Start new PM</button>
        </div>
    </div>

    @if (ViewBag.PmError is string pmError && !string.IsNullOrWhiteSpace(pmError))
    {
        <div class="alert alert-warning">@pmError</div>
    }

    @if (ViewBag.PmMessage is string pmMessage && !string.IsNullOrWhiteSpace(pmMessage))
    {
        <div class="alert alert-success">@pmMessage</div>
    }

    @if (Model.FrequencyPerYear > 0)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                PM frequency: <strong>@Model.FrequencyPerYear</strong> per year
            </span>
            <span class="text-muted small">Current time: @localNow.ToString("f")</span>
        </div>
    }

    <div id="pmAlert"></div>

    @if (Model.Checklists.Any())
    {
        <div class="card mb-3">
            <div class="card-body py-3">
                <form method="get"
                      action="@Url.Action("Index", "PreventiveMaintenance")"
                      class="row g-2 align-items-center"
                      id="pmChecklistForm">
                    <div class="col-auto">
                        <label for="pmChecklistSelect" class="col-form-label col-form-label-sm mb-0">Checklist</label>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <select id="pmChecklistSelect" name="checklistId" class="form-select form-select-sm">
                            @foreach (var checklist in Model.Checklists)
                            {
                                var typeBadge = checklist.ChecklistType == hOps.web.Models.PreventiveMaintenanceChecklistType.Area
                                    ? "Area"
                                    : "Room";
                                var isSelected = checklist.Id == Model.SelectedChecklistId;
                                <option value="@checklist.Id" selected="@(isSelected ? "selected" : null)">
                                    @checklist.Name (@typeBadge)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <small class="text-muted">Switch checklists to start a different PM type.</small>
                    </div>
                </form>
            </div>
        </div>
    }

    <div id="pmStartPanel" class="card mb-4" hidden>
        <div class="card-body">
            <form id="pmStartForm" class="row g-3">
                @Html.AntiForgeryToken()
                @if (Model.RequiresArea)
                {
                    <div class="col-md-6">
                        <label for="pmAreaSelect" class="form-label">Select an area</label>
                        <select id="pmAreaSelect" class="form-select">
                            <option value="">-- Select area --</option>
                            @foreach (var area in Model.AreaOptions)
                            {
                                <option value="@area">@area</option>
                            }
                        </select>
                        <div class="form-text">Choose a configured area to auto-fill the field on the right.</div>
                    </div>
                    <div class="col-md-6">
                        <label for="pmAreaInput" class="form-label">Area name *</label>
                        <input type="text" class="form-control" id="pmAreaInput" maxlength="160" required />
                    </div>
                }
                else
                {
                    <div class="col-md-4">
                        <label for="pmRoomSelect" class="form-label">Select a room</label>
                        <select id="pmRoomSelect" class="form-select">
                            <option value="">-- Select room --</option>
                            @foreach (var option in Model.RoomOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                        <div class="form-text">Optional shortcut to auto-fill the room number.</div>
                    </div>
                    <div class="col-md-4">
                        <label for="pmRoomNumber" class="form-label">Room number *</label>
                        <input type="text" class="form-control" id="pmRoomNumber" required maxlength="32" />
                    </div>
                }
                <div class="col-md-4">
                    <label for="pmStartTime" class="form-label">Start date &amp; time</label>
                    <input type="datetime-local" class="form-control" id="pmStartTime" />
                    <div class="form-text">Defaults to the current time. Adjust if you began earlier.</div>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="pmStartButton">Start PM</button>
                    <button type="button" class="btn btn-outline-secondary" id="pmStartCancel">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.CanRecordManualCompletion is bool canRecordManual && canRecordManual)
    {
        <div class="card mb-4">
            <div class="card-header">
                <strong>Record Manual Completion (Managers)</strong>
            </div>
            <div class="card-body">
                <form asp-action="RecordManualCompletion" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ChecklistId" value="@Model.SelectedChecklistId" />
                    <div class="col-md-4">
                        <label for="pmManualRoomSelect" class="form-label">Select a room (optional)</label>
                        <select id="pmManualRoomSelect" name="RoomId" class="form-select">
                            <option value="">-- Select room --</option>
                            @foreach (var option in Model.RoomOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="pmManualRoomNumber" class="form-label">Room number *</label>
                        <input type="text" class="form-control" id="pmManualRoomNumber" name="RoomNumber" required maxlength="64" />
                    </div>
                    <div class="col-md-4">
                        <label for="pmManualCompletedAt" class="form-label">Completion date &amp; time *</label>
                        <input type="datetime-local" class="form-control" id="pmManualCompletedAt" name="CompletedAtLocal" value="@localNow.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="col-md-3">
                        <label for="pmManualDuration" class="form-label">Duration (minutes)</label>
                        <input type="number" class="form-control" id="pmManualDuration" name="DurationMinutes" min="0" max="1440" value="60" />
                    </div>
                    <div class="col-12">
                        <label for="pmManualComments" class="form-label">Comments</label>
                        <textarea class="form-control" id="pmManualComments" name="Comments" rows="3" maxlength="2000" placeholder="Add context or any issues noted during this manual PM."></textarea>
                        <div class="form-text">Optional. These notes are shared on the PM logs for future reference.</div>
                    </div>
                    <div class="col-12">
                        <small class="text-muted">Use this when a PM was completed outside the checklist.</small>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-primary">Record Manual PM</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div id="pmSessionContainer" class="mb-4" data-collapsed="false">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong class="mb-0">Active PM Session</strong>
                    <div class="text-muted small">Manage tasks without leaving this page.</div>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="pmSessionToggleBtn">
                    Collapse
                </button>
            </div>
            <div class="card-body" id="pmSessionContent">
                <div class="text-muted">
                    <p class="mb-0">Start a PM to load the checklist.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <strong class="mb-0">Room PM Log</strong>
                        <span class="text-muted small">Due status is based on the property frequency.</span>
                    </div>
                    <div class="btn-group" role="group" aria-label="Cycle room log year">
                        @if (Model.RoomLogPreviousYear.HasValue)
                        {
                            <a class="btn btn-outline-secondary btn-sm"
                               asp-action="Index"
                               asp-route-checklistId="@Model.SelectedChecklistId"
                               asp-route-roomYear="@Model.RoomLogPreviousYear"
                               asp-route-areaYear="@(Model.RequiresArea ? Model.AreaLogSelectedYear : null)"
                               title="View @Model.RoomLogPreviousYear">
                                &larr;
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled>&larr;</button>
                        }
                        <span class="btn btn-light btn-sm disabled fw-semibold">@Model.RoomLogSelectedYear</span>
                        @if (Model.RoomLogNextYear.HasValue)
                        {
                            <a class="btn btn-outline-secondary btn-sm"
                               asp-action="Index"
                               asp-route-checklistId="@Model.SelectedChecklistId"
                               asp-route-roomYear="@Model.RoomLogNextYear"
                               asp-route-areaYear="@(Model.RequiresArea ? Model.AreaLogSelectedYear : null)"
                               title="View @Model.RoomLogNextYear">
                                &rarr;
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled>&rarr;</button>
                        }
                    </div>
                </div>
            </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Room</th>
                        <th>Last PM completed</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th>Next due</th>
                        @if (Model.CycleDefinitions.Any())
                        {
                            foreach (var cycle in Model.CycleDefinitions)
                            {
                                <th class="text-nowrap">
                                    Cycle @cycle.Index
                                    <div class="small text-muted">@cycle.DueDate.ToString("MMM d")</div>
                                </th>
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RoomLogs.Any())
                    {
                        var totalColumns = 5 + Model.CycleDefinitions.Count;
                        <tr>
                            <td colspan="@totalColumns" class="text-center text-muted py-4">
                                No rooms found for this property. Add rooms first to begin logging PMs.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in Model.RoomLogs)
                        {
                            var statusLabel = log.IsOverdue ? "Overdue" : log.IsDue ? "Due soon" : "Current";
                            var statusClass = log.IsOverdue ? "bg-danger" : log.IsDue ? "bg-warning text-dark" : "bg-success";
                            string FormatDuration(double? seconds)
                            {
                                if (!seconds.HasValue || seconds.Value <= 0)
                                {
                                    return "--";
                                }

                                var ts = TimeSpan.FromSeconds(seconds.Value);
                                if (ts.TotalHours >= 1)
                                {
                                    return $"{(int)ts.TotalHours}h {ts.Minutes}m";
                                }
                                if (ts.TotalMinutes >= 1)
                                {
                                    return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
                                }
                                return $"{ts.Seconds}s";
                            }

                            <tr>
                                <td>@log.RoomNumber</td>
                                <td>
                                    @if (log.LastCompletedAtUtc.HasValue)
                                    {
                                        var localCompleted = TimeZoneService.ConvertToUserTime(log.LastCompletedAtUtc.Value);
                                        <div>@localCompleted.ToString("g")</div>
                                        if (!string.IsNullOrWhiteSpace(log.CompletedByName))
                                        {
                                            <div class="text-muted small">by @log.CompletedByName</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Never</span>
                                    }
                                </td>
                                <td>@FormatDuration(log.LastDurationSeconds)</td>
                                <td>
                                    <span class="badge @statusClass">@statusLabel</span>
                                </td>
                                <td>
                                    @if (log.NextDueAtUtc.HasValue)
                                    {
                                        var nextDueLocal = TimeZoneService.ConvertToUserTime(log.NextDueAtUtc.Value);
                                        @nextDueLocal.ToString("g")
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>
                                @if (Model.CycleDefinitions.Any())
                                {
                                    foreach (var cycle in Model.CycleDefinitions)
                                    {
                                        var status = log.CycleStatuses.FirstOrDefault(s => s.Index == cycle.Index);
                                        <td>
                                            @if (status?.CompletedAt.HasValue == true)
                                            {
                                                var completedLocal = TimeZoneService.ConvertToUserTime(status.CompletedAt.Value);
                                                var modalDate = completedLocal.ToString("MMMM d, yyyy h:mm tt");
                                                var normalizedNotes = (status.Notes ?? string.Empty).Replace("\r\n", "\n").Replace("\r", "\n");
                                                var encodedNotes = WebUtility.HtmlEncode(normalizedNotes).Replace("\n", "&#10;");
                                                <button type="button"
                                                        class="btn btn-link btn-sm p-0 text-decoration-none cycle-notes-trigger"
                                                        data-cycle-room="@log.RoomNumber"
                                                        data-cycle-date="@modalDate"
                                                        data-cycle-notes="@Html.Raw(encodedNotes)">
                                                    <span>@completedLocal.ToString("MMM d")</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted">--</span>
                                            }
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.RequiresArea)
    {
        <div class="card mb-4">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <strong class="mb-0">Area PM Log</strong>
                        <span class="text-muted small">Tracks the most recent PM for each configured area.</span>
                    </div>
                    <div class="btn-group" role="group" aria-label="Cycle area log year">
                        @if (Model.AreaLogPreviousYear.HasValue)
                            {
                                <a class="btn btn-outline-secondary btn-sm"
                                   asp-action="Index"
                                   asp-route-checklistId="@Model.SelectedChecklistId"
                                   asp-route-areaYear="@Model.AreaLogPreviousYear"
                                   asp-route-roomYear="@Model.RoomLogSelectedYear"
                                   title="View @Model.AreaLogPreviousYear">
                                    &larr;
                                </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled>&larr;</button>
                        }
                        <span class="btn btn-light btn-sm disabled fw-semibold">@Model.AreaLogSelectedYear</span>
                        @if (Model.AreaLogNextYear.HasValue)
                            {
                                <a class="btn btn-outline-secondary btn-sm"
                                   asp-action="Index"
                                   asp-route-checklistId="@Model.SelectedChecklistId"
                                   asp-route-areaYear="@Model.AreaLogNextYear"
                                   asp-route-roomYear="@Model.RoomLogSelectedYear"
                                   title="View @Model.AreaLogNextYear">
                                    &rarr;
                                </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled>&rarr;</button>
                        }
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Area</th>
                            <th>Last PM completed</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th>Next due</th>
                            @if (Model.AreaCycleDefinitions.Any())
                            {
                                foreach (var cycle in Model.AreaCycleDefinitions)
                                {
                                    <th class="text-nowrap">
                                        Cycle @cycle.Index
                                        <div class="small text-muted">@cycle.DueDate.ToString("MMM d")</div>
                                    </th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.AreaLogs.Any())
                        {
                            var totalColumns = 5 + Model.AreaCycleDefinitions.Count;
                            <tr>
                                <td colspan="@totalColumns" class="text-center text-muted py-4">
                                    No areas configured yet. Add area options on the checklist to begin logging PMs.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var log in Model.AreaLogs)
                            {
                                var statusLabel = log.IsOverdue ? "Overdue" : log.IsDue ? "Due soon" : "Current";
                                var statusClass = log.IsOverdue ? "bg-danger" : log.IsDue ? "bg-warning text-dark" : "bg-success";
                                string FormatDuration(double? seconds)
                                {
                                    if (!seconds.HasValue || seconds.Value <= 0)
                                    {
                                        return "--";
                                    }

                                    var ts = TimeSpan.FromSeconds(seconds.Value);
                                    if (ts.TotalHours >= 1)
                                    {
                                        return $"{(int)ts.TotalHours}h {ts.Minutes}m";
                                    }
                                    if (ts.TotalMinutes >= 1)
                                    {
                                        return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
                                    }
                                    return $"{ts.Seconds}s";
                                }

                                <tr>
                                    <td>@log.AreaLabel</td>
                                    <td>
                                        @if (log.LastCompletedAtUtc.HasValue)
                                        {
                                            var localCompleted = TimeZoneService.ConvertToUserTime(log.LastCompletedAtUtc.Value);
                                            <div>@localCompleted.ToString("g")</div>
                                            if (!string.IsNullOrWhiteSpace(log.CompletedByName))
                                            {
                                                <div class="text-muted small">by @log.CompletedByName</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                    <td>@FormatDuration(log.LastDurationSeconds)</td>
                                    <td>
                                        <span class="badge @statusClass">@statusLabel</span>
                                    </td>
                                    <td>
                                        @if (log.NextDueAtUtc.HasValue)
                                        {
                                            var nextDueLocal = TimeZoneService.ConvertToUserTime(log.NextDueAtUtc.Value);
                                            @nextDueLocal.ToString("g")
                                        }
                                        else
                                        {
                                            <span class="text-muted">--</span>
                                        }
                                    </td>
                                    @if (Model.AreaCycleDefinitions.Any())
                                    {
                                        foreach (var cycle in Model.AreaCycleDefinitions)
                                        {
                                            var status = log.CycleStatuses.FirstOrDefault(s => s.Index == cycle.Index);
                                            <td>
                                                @if (status?.CompletedAt.HasValue == true)
                                                {
                                                    var completedLocal = TimeZoneService.ConvertToUserTime(status.CompletedAt.Value);
                                                    <span>@completedLocal.ToString("MMM d")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">--</span>
                                                }
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="pmCycleNotesModal" tabindex="-1" aria-labelledby="pmCycleNotesTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pmCycleNotesTitle">PM Comments</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-muted small mb-2">
                    <span data-role="cycle-room">Room</span>
                    <span class="mx-1">•</span>
                    <span data-role="cycle-date"></span>
                </div>
                <pre class="mb-0" data-role="cycle-notes-body">No comments provided for this completion.</pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="pmInitialSession">
@Html.Raw(initialSessionJson)
</script>

@section Scripts {
    <script>
        (function () {
            const appEl = document.getElementById('pmApp');
            if (!appEl) {
                return;
            }

            const startPanel = document.getElementById('pmStartPanel');
            const startToggle = document.getElementById('pmStartToggle');
            const startForm = document.getElementById('pmStartForm');
            const roomSelect = document.getElementById('pmRoomSelect');
            const roomNumberInput = document.getElementById('pmRoomNumber');
            const areaSelect = document.getElementById('pmAreaSelect');
            const areaInput = document.getElementById('pmAreaInput');
            const startTimeInput = document.getElementById('pmStartTime');
            const startCancel = document.getElementById('pmStartCancel');
            const manualRoomSelect = document.getElementById('pmManualRoomSelect');
            const manualRoomNumberInput = document.getElementById('pmManualRoomNumber');
            const alertContainer = document.getElementById('pmAlert');
            const sessionContainer = document.getElementById('pmSessionContainer');
            const sessionContent = document.getElementById('pmSessionContent');
            const sessionToggleBtn = document.getElementById('pmSessionToggleBtn');
            const hasChecklist = appEl.dataset.hasChecklist === 'true';
            const requiresArea = appEl.dataset.requiresArea === 'true';
            const checklistId = parseInt(appEl.dataset.checklistId || '0', 10) || 0;
            const checklistSelect = document.getElementById('pmChecklistSelect');
            const urls = {
                start: appEl.dataset.startUrl,
                update: appEl.dataset.updateUrl,
                pause: appEl.dataset.pauseUrl,
                resume: appEl.dataset.resumeUrl,
                finish: appEl.dataset.finishUrl
            };
            const activeSessionUrl = appEl.dataset.activeSessionUrl;

            const initialSession = (() => {
                try {
                    const script = document.getElementById('pmInitialSession');
                    return script ? JSON.parse(script.textContent || 'null') : null;
                } catch {
                    return null;
                }
            })();

            let sessionState = null;
            let timerInterval = null;
            let sessionCollapsed = sessionContainer?.dataset.collapsed === 'true';

            function setSessionCollapsed(collapsed) {
                sessionCollapsed = collapsed;
                if (sessionContainer) {
                    sessionContainer.dataset.collapsed = collapsed ? 'true' : 'false';
                }
                if (sessionContent) {
                    sessionContent.classList.toggle('d-none', collapsed);
                }
                if (sessionToggleBtn) {
                    sessionToggleBtn.textContent = collapsed ? 'Expand' : 'Collapse';
                }
            }

            setSessionCollapsed(sessionCollapsed);

            if (sessionToggleBtn) {
                sessionToggleBtn.addEventListener('click', () => setSessionCollapsed(!sessionCollapsed));
            }

            function syncSession(session, shouldRender = true) {
                if (session) {
                    sessionState = {
                        ...session,
                        tasks: Array.isArray(session.tasks) ? session.tasks.map(t => ({ ...t })) : [],
                        syncedAt: Date.now()
                    };
                } else {
                    sessionState = null;
                    stopTimer();
                }

                if (shouldRender) {
                    renderSession();
                } else {
                    if (sessionState && sessionState.status === 'InProgress') {
                        startTimer();
                    } else {
                        stopTimer();
                        updateTimerDisplay();
                    }
                    updateActionButtons();
                }
            }

            function formatLocalInput(date) {
                const pad = (value) => value.toString().padStart(2, '0');
                return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
            }

            function setStartDefaults() {
                const now = new Date();
                if (startTimeInput) {
                    startTimeInput.value = formatLocalInput(now);
                }

                if (requiresArea) {
                    if (areaSelect) {
                        areaSelect.value = '';
                    }
                    if (areaInput) {
                        areaInput.value = '';
                    }
                } else {
                    if (roomSelect) {
                        roomSelect.value = '';
                    }
                    if (roomNumberInput) {
                        roomNumberInput.value = '';
                        delete roomNumberInput.dataset.selectedRoomId;
                        delete roomNumberInput.dataset.selectedRoomLabel;
                    }
                }
            }

            function toggleStartPanel(show) {
                if (!startPanel) {
                    return;
                }
                const shouldShow = typeof show === 'boolean' ? show : startPanel.hasAttribute('hidden');
                if (shouldShow) {
                    startPanel.removeAttribute('hidden');
                    setStartDefaults();
                } else {
                    startPanel.setAttribute('hidden', 'hidden');
                }
            }

            if (startToggle && !hasChecklist) {
                startToggle.classList.add('disabled');
                startToggle.setAttribute('title', 'Add tasks on the PM Setup page before starting a PM.');
            }

            if (startToggle) {
                startToggle.addEventListener('click', async () => {
                    if (!hasChecklist) {
                        showAlert('warning', 'Add tasks on the PM Setup page before starting a PM.');
                        return;
                    }

                    if (sessionState) {
                        await refreshActiveSession();
                        if (sessionState) {
                            showAlert('info', 'Finish or pause your current PM before starting another.');
                            return;
                        }
                    }

                    toggleStartPanel(true);
                });
            }

            if (startCancel) {
                startCancel.addEventListener('click', () => toggleStartPanel(false));
            }

            if (!requiresArea && roomSelect && roomNumberInput) {
                roomSelect.addEventListener('change', () => {
                    const option = roomSelect.selectedOptions[0];
                    if (option && option.value) {
                        roomNumberInput.value = option.textContent || option.value;
                        roomNumberInput.dataset.selectedRoomId = option.value;
                        roomNumberInput.dataset.selectedRoomLabel = (option.textContent || option.value).trim();
                    } else {
                        delete roomNumberInput.dataset.selectedRoomId;
                        delete roomNumberInput.dataset.selectedRoomLabel;
                    }
                });
            }

            if (manualRoomSelect && manualRoomNumberInput) {
                manualRoomSelect.addEventListener('change', () => {
                    const option = manualRoomSelect.selectedOptions[0];
                    if (option && option.value) {
                        manualRoomNumberInput.value = (option.textContent || option.value).trim();
                    }
                });
            }

            if (!requiresArea && roomNumberInput) {
                roomNumberInput.addEventListener('input', () => {
                    if (!roomNumberInput.dataset.selectedRoomLabel) {
                        return;
                    }

                    if (roomNumberInput.value.trim() !== roomNumberInput.dataset.selectedRoomLabel) {
                        delete roomNumberInput.dataset.selectedRoomId;
                        delete roomNumberInput.dataset.selectedRoomLabel;
                        if (roomSelect) {
                            roomSelect.value = '';
                        }
                    }
                });
            }

            if (requiresArea && areaSelect && areaInput) {
                areaSelect.addEventListener('change', () => {
                    const option = areaSelect.selectedOptions[0];
                    if (option && option.value) {
                        areaInput.value = option.value;
                    } else {
                        areaInput.value = '';
                    }
                });
            }

            if (checklistSelect && checklistSelect.form) {
                checklistSelect.addEventListener('change', () => {
                    checklistSelect.form.submit();
                });
            }

            function showAlert(type, message) {
                if (!alertContainer) {
                    return;
                }
                alertContainer.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
            }

            function getRequestVerificationToken() {
                const tokenInput = appEl.querySelector('input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : '';
            }

            async function postJson(url, payload) {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getRequestVerificationToken()
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    let message = 'An unexpected error occurred.';
                    try {
                        const data = await response.json();
                        if (data?.message) {
                            message = data.message;
                        }
                    } catch {
                        // ignore
                    }
                    throw new Error(message);
                }

                return response.json();
            }

            async function refreshActiveSession() {
                if (!activeSessionUrl) {
                    return sessionState;
                }

                try {
                    const response = await fetch(activeSessionUrl, { headers: { 'Accept': 'application/json' } });
                    if (!response.ok) {
                        return sessionState;
                    }

                    const data = await response.json();
                    syncSession(data.session || null);
                    return data.session || null;
                } catch {
                    return sessionState;
                }
            }

            function handleSessionNotFound(error) {
                if (error && typeof error.message === 'string' &&
                    error.message.toLowerCase().includes('session not found')) {
                    syncSession(null);
                    showAlert('info', 'Your PM session could not be found and has been cleared.');
                    return true;
                }

                return false;
            }

            if (startForm) {
                startForm.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    let roomNumberValue = '';
                    let selectedRoomId = null;
                    let areaLabelValue = null;

                    if (requiresArea) {
                        const areaLabel = (areaInput?.value || '').trim();
                        if (!areaLabel) {
                            if (areaInput) {
                                areaInput.focus();
                            }
                            showAlert('warning', 'Enter an area before starting the PM.');
                            return;
                        }
                        roomNumberValue = areaLabel;
                        areaLabelValue = areaLabel;
                    } else {
                        if (!roomNumberInput) {
                            return;
                        }
                        const roomNumber = roomNumberInput.value.trim();
                        if (!roomNumber) {
                            roomNumberInput.focus();
                            return;
                        }
                        roomNumberValue = roomNumber;
                        selectedRoomId = roomNumberInput.dataset.selectedRoomId ? Number(roomNumberInput.dataset.selectedRoomId) : null;
                    }

                    if (sessionState) {
                        await refreshActiveSession();
                        if (sessionState) {
                            showAlert('info', 'Finish or pause your current PM before starting another.');
                            return;
                        }
                    }

                    const payload = {
                        checklistId,
                        roomNumber: roomNumberValue,
                        startedAtUtc: new Date((startTimeInput && startTimeInput.value) || new Date().toISOString()).toISOString(),
                        roomId: selectedRoomId,
                        areaLabel: areaLabelValue
                    };

                    try {
                        const data = await postJson(urls.start, payload);
                        syncSession(data.session);
                        toggleStartPanel(false);
                        showAlert('success', 'PM started.');
                    } catch (error) {
                        if (!handleSessionNotFound(error)) {
                            showAlert('danger', error.message || 'Unable to start the PM.');
                        }
                    }
                });
            }

            function renderSession() {
                if (!sessionContent) {
                    return;
                }

                if (!sessionState) {
                    sessionContent.innerHTML = `<div class="text-muted">
                        <p class="mb-0">Start a PM to load the checklist.</p>
                    </div>`;
                    stopTimer();
                    setSessionCollapsed(sessionCollapsed);
                    return;
                }

                const taskRows = (sessionState.tasks || []).map(task => `
                    <tr data-task-id="${task.id}">
                        <td>
                            <div class="fw-semibold">${escapeHtml(task.title)}</div>
                            <div class="text-muted small">${escapeHtml(task.description || '')}</div>
                        </td>
                        <td class="w-25">
                            <select class="form-select form-select-sm pm-task-status" data-task-id="${task.id}">
                                ${buildStatusOptions(task.status)}
                            </select>
                        </td>
                        <td class="w-25">
                            <textarea class="form-control form-control-sm pm-task-notes" data-task-id="${task.id}" rows="2" placeholder="Notes about this task">${escapeHtml(task.notes || '')}</textarea>
                        </td>
                    </tr>`).join('');

                sessionContent.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <div>
                            <div class="fw-semibold mb-0">Room ${escapeHtml(sessionState.roomLabel || sessionState.roomNumber)}</div>
                            <div class="text-muted small">Started ${formatRelativeTime(sessionState.startedAtUtc)}</div>
                        </div>
                        <div class="text-end">
                            <div id="pmTimer" class="fs-4 fw-semibold">--:--</div>
                            <div class="text-muted small" id="pmStatusLabel">${sessionState.status}</div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mb-3 flex-wrap">
                        <button type="button" class="btn btn-outline-secondary" id="pmPauseButton">${sessionState.status === 'Paused' ? 'Resume' : 'Pause'}</button>
                        <button type="button" class="btn btn-success" id="pmFinishButton" disabled title="Update each task before finishing">Finish</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Task</th>
                                    <th style="width:180px;">Status</th>
                                    <th style="width:220px;">Notes</th>
                                </tr>
                            </thead>
                            <tbody>${taskRows}</tbody>
                        </table>
                    </div>`;

                bindTaskEvents();
                updateActionButtons();
                if (sessionState.status === 'InProgress') {
                    startTimer();
                } else {
                    stopTimer();
                    updateTimerDisplay();
                }
                setSessionCollapsed(sessionCollapsed);
            }

            function stopTimer() {
                if (timerInterval) {
                    window.clearInterval(timerInterval);
                    timerInterval = null;
                }
            }

            function startTimer() {
                stopTimer();
                updateTimerDisplay();
                timerInterval = window.setInterval(updateTimerDisplay, 1000);
            }

            function updateTimerDisplay() {
                if (!sessionState) {
                    return;
                }

                const timerEl = document.getElementById('pmTimer');
                if (!timerEl) {
                    return;
                }

                const status = sessionState.status;
                let baseSeconds = sessionState.durationSeconds || 0;
                if (status === 'InProgress') {
                    const elapsedSinceSync = Date.now() - (sessionState.syncedAt || Date.now());
                    baseSeconds += Math.max(0, elapsedSinceSync / 1000);
                }

                timerEl.textContent = formatDuration(baseSeconds);
            }

            function bindTaskEvents() {
                document.querySelectorAll('.pm-task-status').forEach(select => {
                    select.addEventListener('change', (event) => {
                        handleTaskUpdate(event.currentTarget.dataset.taskId, event.currentTarget.value, null);
                    });
                });

                document.querySelectorAll('.pm-task-notes').forEach(textarea => {
                    textarea.addEventListener('change', (event) => {
                        handleTaskUpdate(event.currentTarget.dataset.taskId, null, event.currentTarget.value);
                    });
                });
            }

            async function handleTaskUpdate(taskId, statusValue, notesValue) {
                if (!sessionState) {
                    return;
                }

                const payload = {
                    sessionId: sessionState.id,
                    taskId: Number(taskId),
                    status: statusValue ? statusValue : getTaskStatus(taskId),
                    notes: notesValue ?? getTaskNotes(taskId)
                };

                try {
                    const data = await postJson(urls.update, payload);
                    syncSession(data.session, false);
                } catch (error) {
                    showAlert('danger', error.message || 'Unable to save the task update.');
                }
            }

            function getTaskStatus(taskId) {
                const select = document.querySelector(`.pm-task-status[data-task-id="${taskId}"]`);
                return select ? select.value : 'NotStarted';
            }

            function getTaskNotes(taskId) {
                const textarea = document.querySelector(`.pm-task-notes[data-task-id="${taskId}"]`);
                return textarea ? textarea.value : '';
            }

            function updateActionButtons() {
                const finishButton = document.getElementById('pmFinishButton');
                const pauseButton = document.getElementById('pmPauseButton');
                const statusLabel = document.getElementById('pmStatusLabel');

                if (!sessionState) {
                    if (finishButton) finishButton.setAttribute('disabled', 'disabled');
                    if (pauseButton) pauseButton.setAttribute('disabled', 'disabled');
                    return;
                }

                if (statusLabel) {
                    statusLabel.textContent = sessionState.status === 'Paused' ? 'Paused' : 'In progress';
                }

                if (pauseButton) {
                    pauseButton.textContent = sessionState.status === 'Paused' ? 'Resume' : 'Pause';
                    pauseButton.disabled = false;
                    pauseButton.onclick = async () => {
                        try {
                            const targetUrl = sessionState.status === 'Paused' ? urls.resume : urls.pause;
                            const data = await postJson(targetUrl, { sessionId: sessionState.id });
                            syncSession(data.session);
                            showAlert('info', sessionState.status === 'Paused' ? 'PM paused.' : 'PM resumed.');
                        } catch (error) {
                            showAlert('danger', error.message || 'Unable to update the PM status.');
                        }
                    };
                }

                const canFinish = (sessionState.tasks || []).every(task => task.status === 'Complete' || task.status === 'ReportIssue');
                if (finishButton) {
                    finishButton.disabled = !canFinish;
                    finishButton.title = canFinish ? 'Finish PM' : 'Update all tasks before finishing';
                    finishButton.onclick = async () => {
                        if (!canFinish) {
                            showAlert('warning', 'Update all tasks before finishing.');
                            return;
                        }

                        try {
                            const data = await postJson(urls.finish, { sessionId: sessionState.id });
                            syncSession(null);
                            showAlert('success', data.issuesLogged > 0
                                ? `PM completed. Created ${data.issuesLogged} work order(s) for issues.`
                                : 'PM completed.');
                        } catch (error) {
                            showAlert('danger', error.message || 'Unable to finish the PM.');
                        }
                    };
                }
            }

            function buildStatusOptions(selectedValue) {
                const options = [
                    { value: 'NotStarted', label: 'Not Started' },
                    { value: 'Complete', label: 'Complete' },
                    { value: 'ReportIssue', label: 'Report an Issue' },
                    { value: 'Incomplete', label: 'Incomplete' }
                ];

                return options.map(opt => `<option value="${opt.value}" ${opt.value === selectedValue ? 'selected' : ''}>${opt.label}</option>`).join('');
            }

            function formatRelativeTime(iso) {
                const date = new Date(iso);
                return date.toLocaleString();
            }

            function escapeHtml(text) {
                if (!text) {
                    return '';
                }

                return text
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            function formatDuration(seconds) {
                const totalSeconds = Math.max(0, Math.floor(seconds || 0));
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                const secs = totalSeconds % 60;
                if (hours > 0) {
                    return `${hours}h ${minutes}m`;
                }
                if (minutes > 0) {
                    return `${minutes}m ${secs}s`;
                }
                return `${secs}s`;
            }

            function initCycleNotesModal() {
                const modalEl = document.getElementById('pmCycleNotesModal');
                if (!modalEl || typeof bootstrap === 'undefined' || !bootstrap.Modal) {
                    return;
                }

                const modal = new bootstrap.Modal(modalEl);
                const roomField = modalEl.querySelector('[data-role="cycle-room"]');
                const dateField = modalEl.querySelector('[data-role="cycle-date"]');
                const notesField = modalEl.querySelector('[data-role="cycle-notes-body"]');
                const triggers = document.querySelectorAll('.cycle-notes-trigger');

                triggers.forEach(button => {
                    button.addEventListener('click', () => {
                        if (roomField) {
                            roomField.textContent = button.dataset.cycleRoom || 'Room';
                        }
                        if (dateField) {
                            dateField.textContent = button.dataset.cycleDate || '';
                        }
                        if (notesField) {
                            const rawNotes = button.dataset.cycleNotes || '';
                            const normalizedNotes = rawNotes
                                .replace(/&#10;/g, '\n')
                                .replace(/&#13;/g, '\n')
                                .trim();
                            notesField.textContent = normalizedNotes
                                ? normalizedNotes
                                : 'No comments provided for this completion.';
                        }
                        modal.show();
                    });
                });
            }

            initCycleNotesModal();
            syncSession(initialSession);
        })();
    </script>
}
