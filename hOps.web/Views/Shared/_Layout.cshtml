@using Microsoft.AspNetCore.Identity
@using hOps.web.Models
@using hOps.web.Utilities
@using hOps.web.ViewModels
@using hOps.web.ViewModels.WorkOrders
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var maintenanceActive = string.Equals(currentController, "PreventiveMaintenance", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(currentController, "Maintenance", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(currentController, "MaintenanceEquipment", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(currentController, "MaintenanceLogs", StringComparison.OrdinalIgnoreCase);
    var housekeepingActive =
        string.Equals(currentController, "DeepCleans", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "Housekeeping", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentController, "LinenInventory", StringComparison.OrdinalIgnoreCase);
    var siteVisitActive = string.Equals(currentController, "SiteVisit", StringComparison.OrdinalIgnoreCase);
    var supportActive = string.Equals(currentController, "Support", StringComparison.OrdinalIgnoreCase);
    var mainContainerClass = ViewData["MainContainerClass"] as string ?? string.Empty;
    var contentSurfaceClass = ViewData["ContentSurfaceClass"] as string ?? string.Empty;
    var unreadDirectMessageCount = ViewBag.UnreadDirectMessageCount is int count ? count : 0;
    var unreadDirectMessageBadgeText = unreadDirectMessageCount > 99 ? "99+" : unreadDirectMessageCount.ToString();
    var unreadAlertCount = ViewBag.UnreadAlertCount is int alertCount ? alertCount : 0;
    var unreadAlertBadgeText = unreadAlertCount > 99 ? "99+" : unreadAlertCount.ToString();
    var totalUnreadMessageCenterCount = ViewBag.UnreadMessageCenterCount is int total ? total : unreadDirectMessageCount + unreadAlertCount;
    var totalUnreadMessageCenterBadgeText = totalUnreadMessageCenterCount > 99 ? "99+" : totalUnreadMessageCenterCount.ToString();
    string? latestMessageParticipant = ViewBag.LatestDirectMessageParticipant as string;
    latestMessageParticipant = string.IsNullOrWhiteSpace(latestMessageParticipant) ? null : latestMessageParticipant.Trim();
    string latestMessageBody = ViewBag.LatestDirectMessageBody as string ?? string.Empty;
    DateTime? latestMessageSentAt = ViewBag.LatestDirectMessageSentAt is DateTime sentAt ? sentAt : (DateTime?)null;
    int? latestConversationId = ViewBag.LatestDirectMessageConversationId is int conversationIdValue ? conversationIdValue : (int?)null;
    string latestMessageInitial = "M";
    if (!string.IsNullOrWhiteSpace(latestMessageParticipant))
    {
        latestMessageInitial = latestMessageParticipant.Trim()[0].ToString().ToUpperInvariant();
    }
    string? latestMessageTimestamp = latestMessageSentAt.HasValue
        ? TimeZoneService.ConvertToUserTime(latestMessageSentAt.Value).ToString("g")
        : null;
    string? latestMessageSnippet = null;
    if (!string.IsNullOrWhiteSpace(latestMessageBody))
    {
        latestMessageSnippet = RichTextRenderer.ToPlainText(latestMessageBody);
        if (!string.IsNullOrWhiteSpace(latestMessageSnippet) && latestMessageSnippet.Length > 80)
        {
            latestMessageSnippet = latestMessageSnippet.Substring(0, 80) + "...";
        }
    }
    var toDoData = ViewBag.ToDoSidebarData as ToDoSidebarViewModel ?? new ToDoSidebarViewModel();
    var toDoMessage = TempData["ToDoMessage"] as string;
    var toDoError = TempData["ToDoError"] as string;
    var showTodoSidebar = SignInManager.IsSignedIn(User);
    var currentUrl = (Context?.Request?.Path.Value ?? string.Empty) + (Context?.Request?.QueryString.Value ?? string.Empty);
    if (string.IsNullOrWhiteSpace(currentUrl))
    {
        currentUrl = Url.Action("Index", "Home") ?? "/";
    }
    var rawAvatarModel = ViewBag.CurrentUserAvatar as UserAvatarViewModel;
    var fallbackProfileName = rawAvatarModel?.Name ?? (User?.Identity?.Name ?? "My Profile");
    var todayDisplay = TimeZoneService.ConvertToUserTime(DateTime.UtcNow).ToString("dddd, MMM d");
    var profileAvatarModel = rawAvatarModel != null
        ? new UserAvatarViewModel
        {
            ImageUrl = rawAvatarModel.ImageUrl,
            Initials = rawAvatarModel.Initials,
            Name = rawAvatarModel.Name,
            Size = "sm",
            AdditionalCssClasses = rawAvatarModel.AdditionalCssClasses
        }
        : UserAvatarHelper.Build(null, null, null, fallbackProfileName, "sm");
    if (profileAvatarModel != null)
    {
        profileAvatarModel.Size = "sm";
        var extraClasses = "me-2";
        profileAvatarModel.AdditionalCssClasses = string.IsNullOrWhiteSpace(profileAvatarModel.AdditionalCssClasses)
            ? extraClasses
            : $"{profileAvatarModel.AdditionalCssClasses} {extraClasses}";
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - GuestQuest</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/favicon.png" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
@{
    var userAuthenticated = User?.Identity?.IsAuthenticated == true ? "true" : "false";
}
<body data-user-authenticated="@userAuthenticated" data-sidebar-managed="true">
    <div class="ui-scale-wrapper">
    <a class="skip-link" href="#mainContent">Skip to main content</a>
    @if (SignInManager.IsSignedIn(User))
    {
        <form id="globalAntiforgeryForm" method="post" class="d-none">
            @Html.AntiForgeryToken()
        </form>
    }
    <header class="main-header">
        <div class="container-fluid py-2">
            <div class="main-header__top d-flex align-items-center justify-content-between gap-3 flex-wrap">
                <div class="main-header__identity d-flex align-items-center gap-3 flex-wrap">
                    <a class="brand-lockup text-decoration-none" href="@Url.Action("Index", "Home")">
                        <img src="~/favicon.png" alt="GuestQuest logo" class="brand-lockup__mark" asp-append-version="true" />
                        <span class="brand-lockup__text">
                            <span class="brand-lockup__title">GuestQuest</span>
                            <span class="brand-lockup__subtitle">GuestQuest</span>
                        </span>
                    </a>
                    <div class="page-title">
                        <span class="text-uppercase text-muted small">Hotel Operations</span>
                        <h1 class="h5 mb-0 fw-semibold">@(ViewData["Title"] as string ?? "HotelOps")</h1>
                    </div>
                </div>
                <ul class="nav align-items-center">
                <li class="nav-item me-3 text-muted small d-none d-lg-block">
                    @todayDisplay
                </li>
                @if (SignInManager.IsSignedIn(User))
                {
                    var userProps = ViewBag.UserProperties as List<Property>;
                    var currentProp = ViewBag.CurrentProperty as Property;


                    if (userProps != null && userProps.Count > 1)
                    {
                        <li class="nav-item dropdown me-2">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @(currentProp?.Name ?? "Select Property")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @foreach (var prop in userProps)
                                {
                                    var propertyLabel = string.IsNullOrWhiteSpace(prop.Code) ? prop.Name : $"{prop.Name} ({prop.Code})";

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Home"
                                           asp-action="SwitchProperty"
                                           asp-route-propertyId="@prop.Id">
                                            @propertyLabel
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    <li class="nav-item dropdown me-2" id="bookmarkMenu">
                        <a class="nav-link position-relative bookmark-toggle" href="#" id="bookmarkMenuToggle" data-bookmark-toggle aria-expanded="false" aria-label="Quick bookmarks">
                            <svg class="bookmark-toggle-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                            </svg>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end bookmark-dropdown-menu" aria-labelledby="bookmarkMenuToggle">
                            <div class="px-3 pt-2 pb-2">
                                <button type="button" class="btn btn-sm btn-outline-primary w-100" data-all-bookmarks-toggle>
                                    All Bookmarks
                                </button>
                            </div>
                            <div class="px-3 py-2 text-muted small">Quick Bookmarks</div>
                            <div id="bookmarkMenuContent">
                                <div class="px-3 py-2 text-muted small">Loading bookmarks...</div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-controller="Bookmarks" asp-action="Index">Manage bookmarks</a>
                        </div>
                    </li>

                    <li class="nav-item dropdown me-2" id="messagesMenu">
                        <a class="nav-link dropdown-toggle position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="me-1">Messages</span>
                            <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle @(totalUnreadMessageCenterCount > 0 ? string.Empty : "d-none")" id="messagesMenuTriggerBadge">@totalUnreadMessageCenterBadgeText</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end messages-dropdown-menu">
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="DirectMessages" asp-action="Index" asp-route-startNew="true" id="messagesMenuCreate">
                                    <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis">+</span>
                                    <span>Create New Message</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center justify-content-between" asp-controller="DirectMessages" asp-action="Index" id="messagesMenuConversations">
                                    <span>Conversations</span>
                                    <span class="badge rounded-pill bg-primary @(unreadDirectMessageCount > 0 ? string.Empty : "d-none")" id="messagesMenuConversationsBadge">@unreadDirectMessageBadgeText</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center justify-content-between" asp-controller="DirectMessages" asp-action="Alerts" id="messagesMenuAlerts">
                                    <span>Alerts</span>
                                    <span class="badge rounded-pill bg-info @(unreadAlertCount > 0 ? string.Empty : "d-none")" id="messagesMenuAlertsBadge">@unreadAlertBadgeText</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item me-2">
                        <a class="nav-link d-flex align-items-center gap-2 @(currentController == "Profile" ? "active" : string.Empty)" asp-controller="Profile" asp-action="Index">
                            @if (profileAvatarModel != null)
                            {
                                <partial name="_UserAvatar" model="profileAvatarModel" />
                            }
                            <span>My Profile</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout">
                            <button type="submit" class="btn btn-link nav-link">Log Out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
                    </li>
                }
                </ul>
            </div>
            <div class="main-header__actions d-flex flex-column gap-2 mt-2">
                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap w-100">
                    <div class="d-flex align-items-center flex-shrink-0">
                        <button class="sidebar-toggle" type="button" aria-label="Toggle navigation" aria-expanded="true" data-sidebar-toggle="true">
                            <span class="sidebar-toggle-icon" aria-hidden="true">
                                <svg class="icon-collapse" viewBox="0 0 24 24" fill="currentColor">
                                    <polygon points="14 5 8 12 14 19" />
                                </svg>
                                <svg class="icon-expand" viewBox="0 0 24 24" fill="currentColor">
                                    <polygon points="10 5 16 12 10 19" />
                                </svg>
                            </span>
                            <span class="sidebar-toggle-text d-none d-md-inline">Menu</span>
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end flex-md-nowrap">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <a class="btn btn-outline-primary px-3 flex-shrink-0" asp-controller="Sales" asp-action="Index">Sales Lead</a>
                            <button type="button"
                                    class="btn btn-outline-secondary px-3 flex-shrink-0"
                                    data-hotel-layout-trigger
                                    aria-haspopup="dialog"
                                    aria-expanded="false"
                                    title="Hotel layout quick view">
                                <span class="ms-1">Layout</span>
                            </button>
                        }
                        @if (SignInManager.IsSignedIn(User) && showTodoSidebar)
                        {
                            <button type="button"
                                    class="sidebar-toggle sidebar-toggle--todo flex-shrink-0"
                                    data-todo-toggle="toggle"
                                    aria-controls="todoSidebar"
                                    aria-expanded="true"
                                    aria-label="Collapse to-do sidebar">
                                <span class="sidebar-toggle-icon" aria-hidden="true">
                                    <svg class="icon-collapse" viewBox="0 0 24 24" fill="currentColor">
                                        <polygon points="10 5 16 12 10 19" />
                                    </svg>
                                    <svg class="icon-expand" viewBox="0 0 24 24" fill="currentColor">
                                        <polygon points="14 5 8 12 14 19" />
                                    </svg>
                                </span>
                                <span class="sidebar-toggle-text d-none d-md-inline">To-Do</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </header>
    <div class="hotel-layout-panel shadow-lg" id="hotelLayoutPanel" role="dialog" aria-modal="false">
        <div class="hotel-layout-panel__content" id="hotelLayoutPanelContent">
            <div class="hotel-layout-panel__placeholder text-muted small">Loading layout…</div>
        </div>
    </div>
    <div class="layout-wrapper">
        <aside id="sidebar" class="sidebar bg-white border-end">
            <div class="sidebar-inner">
                <div class="sidebar-brand d-flex align-items-center justify-content-end mb-4">
                    <button class="sidebar-toggle d-lg-none" type="button" aria-label="Toggle navigation" aria-expanded="true" data-sidebar-toggle="true">
                        <span class="sidebar-toggle-icon" aria-hidden="true">
                            <svg class="icon-collapse" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="14 5 8 12 14 19" />
                            </svg>
                            <svg class="icon-expand" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="10 5 16 12 10 19" />
                            </svg>
                        </span>
                        <span class="sidebar-toggle-text">Menu</span>
                    </button>
                </div>
                <nav class="sidebar-menu" role="navigation" aria-label="Primary navigation">
                    <ul class="nav flex-column gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : string.Empty)" asp-controller="Home" asp-action="Index">
                                <span class="sidebar-text">Home</span>
                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            IList<string> roles = new List<string>();
                            if (user is not null)
                            {
                                roles = await UserManager.GetRolesAsync(user);
                            }

                            <li class="nav-item">
                                <a class="nav-link @(currentController == "PassOnLogs" ? "active" : string.Empty)" asp-controller="PassOnLogs" asp-action="Index">
                                    <span class="sidebar-text">Pass On Logs</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "WorkOrders" ? "active" : string.Empty)" asp-controller="WorkOrders" asp-action="Index">
                                    <span class="sidebar-text">Work Orders</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(housekeepingActive ? "active" : string.Empty)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="sidebar-text">Housekeeping</span>
                                </a>
                                <ul class="dropdown-menu" id="housekeepingMenu" data-bs-auto-close="outside">
                                    <li><a class="dropdown-item" asp-controller="DeepCleans" asp-action="Index">Deep Cleans</a></li>
                                    <li><a class="dropdown-item" asp-controller="Housekeeping" asp-action="DailyRecap">Daily Recap</a></li>
                                    <li><a class="dropdown-item" asp-controller="Housekeeping" asp-action="MprTracker">MPR Tracker</a></li>
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center justify-content-between" type="button" data-bs-toggle="collapse" data-bs-target="#housekeepingInventoryMenu" aria-expanded="false" aria-controls="housekeepingInventoryMenu">
                                            <span>Inventory</span>
                                            <span class="ms-3 small text-muted" data-collapse-icon>+</span>
                                        </button>
                                        <div class="collapse dropdown-submenu-collapse ps-3" id="housekeepingInventoryMenu" data-bs-parent="#housekeepingMenu">
                                            <ul class="list-unstyled mb-0">
                                                <li><a class="dropdown-item" asp-controller="LinenInventory" asp-action="Index">Linen Inventory</a></li>
                                                <li><a class="dropdown-item" asp-controller="LinenInventory" asp-action="Supply">Supply Inventory</a></li>
                                            </ul>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(siteVisitActive ? "active" : string.Empty)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="sidebar-text">Site Visit</span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="SiteVisit" asp-action="Index">Checklist</a></li>
                                    <li><a class="dropdown-item" asp-controller="SiteVisit" asp-action="Log">Log</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(maintenanceActive ? "active" : string.Empty)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="sidebar-text">Maintenance</span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="PreventiveMaintenance" asp-action="Index">PMs</a></li>
                                    <li><a class="dropdown-item" asp-controller="MaintenanceEquipment" asp-action="Index">Equipment</a></li>
                                    <li><a class="dropdown-item" asp-controller="MaintenanceLogs" asp-action="Index">Logs</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Calendar" ? "active" : string.Empty)" asp-controller="Calendar" asp-action="Index">
                                    <span class="sidebar-text">Calendar</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "LostAndFound" ? "active" : string.Empty)" asp-controller="LostAndFound" asp-action="Index">
                                    <span class="sidebar-text">Lost &amp; Found</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "MailLog" ? "active" : string.Empty)" asp-controller="MailLog" asp-action="Index">
                                    <span class="sidebar-text">Package &amp; Mail Log</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Phonebook" ? "active" : string.Empty)" asp-controller="Phonebook" asp-action="Index">
                                    <span class="sidebar-text">Phonebook</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Schedules" ? "active" : string.Empty)" asp-controller="Schedules" asp-action="Index">
                                    <span class="sidebar-text">Schedules</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Documents" ? "active" : string.Empty)" asp-controller="Documents" asp-action="Index">
                                    <span class="sidebar-text">Documents</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Logs" ? "active" : string.Empty)" asp-controller="Logs" asp-action="Index">
                                    <span class="sidebar-text">Custom Logs</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Reports" ? "active" : string.Empty)" asp-controller="Reports" asp-action="Index">
                                    <span class="sidebar-text">Reports</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Sales" ? "active" : string.Empty)" asp-controller="Sales" asp-action="Index">
                                    <span class="sidebar-text">Sales Lead</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(supportActive ? "active" : string.Empty)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="sidebar-text">Support</span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Support" asp-action="Index">Open Ticket</a></li>
                                    <li><a class="dropdown-item" asp-controller="Support" asp-action="Tips">FAQs</a></li>
                                </ul>
                            </li>

                            if (roles.Contains("Manager") || roles.Contains("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @(currentController == "Admin" || currentController == "Settings" || currentController == "Properties" ? "active" : string.Empty)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="sidebar-text position-relative">
                                            Admin
                                            <span id="adminMenuBadge" class="badge bg-danger ms-1 d-none"></span>
                                        </span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                        <li>
                                            <a class="dropdown-item d-flex justify-content-between align-items-center"
                                               asp-controller="Admin"
                                               asp-action="AccessRequests">
                                                Access Requests
                                                <span id="accessRequestBadge" class="badge bg-danger ms-2" style="display: none;"></span>
                                            </a>
                                        </li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Users</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li class="dropdown-header">Settings</li>
                                        <li><a class="dropdown-item" asp-controller="Settings" asp-action="Departments">Departments</a></li>
                                        <li><a class="dropdown-item" asp-controller="Settings" asp-action="WorkOrderTypes">Work Order Types</a></li>
                                        <li><a class="dropdown-item" asp-controller="Settings" asp-action="Rooms" asp-route-propertyId="@(ViewBag.CurrentProperty?.Id ?? 0)">Rooms Editor</a></li>
                                        <li><a class="dropdown-item" asp-controller="Maintenance" asp-action="PmChecklists" asp-route-propertyId="@(ViewBag.CurrentProperty?.Id ?? 0)">PM Setup</a></li>
                                        <li><a class="dropdown-item" asp-controller="Settings" asp-action="DeepCleanSetup" asp-route-propertyId="@(ViewBag.CurrentProperty?.Id ?? 0)">Deep Clean Setup</a></li>
                                        <li><a class="dropdown-item" asp-controller="Settings" asp-action="PhonebookTypes">Phonebook Types</a></li>
                                        <li><a class="dropdown-item" asp-controller="Settings" asp-action="CalendarCategories">Calendar Categories</a></li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Settings"
                                               asp-action="LayoutEditor"
                                               asp-route-propertyId="@(ViewBag.CurrentProperty?.Id ?? 0)">
                                                Edit Layout
                                            </a>
                                        </li>
                                        <li><a class="dropdown-item" asp-controller="Settings" asp-action="ScheduleSetup" asp-route-propertyId="@(ViewBag.CurrentProperty?.Id ?? 0)">Schedule Setup</a></li>
                                        @if (roles.Contains("Admin"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Properties" asp-action="Index">Properties</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                </nav>
            </div>
        </aside>
        <div class="sidebar-backdrop d-lg-none" id="sidebarBackdrop"></div>
        <button type="button"
                id="sidebarFabToggle"
                class="sidebar-fab-toggle"
                data-sidebar-toggle="true"
                aria-controls="sidebar"
                aria-expanded="true"
                aria-label="Collapse navigation sidebar">
            <span class="sidebar-fab-toggle__icon" aria-hidden="true"></span>
        </button>
        <div class="main-content flex-grow-1 d-flex flex-column">
            <main class="flex-grow-1" id="mainContent" role="main">
                <div class="main-inner container-fluid py-4 @mainContainerClass">
                    <div class="content-surface shadow-sm rounded-4 p-4 @contentSurfaceClass">
                        @RenderBody()
                    </div>
                </div>
            </main>
        </div>

        @if (SignInManager.IsSignedIn(User))
        {
            <div class="issue-report-fab" aria-live="polite">
                <button type="button"
                        class="btn btn-primary issue-report-fab__button"
                        id="issueReportFab"
                        aria-label="Report an Issue"
                        title="Report an Issue">
                    <span class="issue-report-fab__icon" aria-hidden="true">!</span>
                    <span class="issue-report-fab__label">Report an Issue</span>
                </button>
            </div>

            <div class="modal fade" id="issueReportModal" tabindex="-1" aria-labelledby="issueReportModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-end modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="issueReportModalLabel">Report an Issue</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="issueReportForm" novalidate>
                                <div class="mb-3">
                                    <label class="form-label" for="issueDetails">Details of the issue<span class="text-danger">*</span></label>
                                    <textarea class="form-control"
                                              id="issueDetails"
                                              name="details"
                                              rows="5"
                                              maxlength="4000"
                                              placeholder="Describe what happened"
                                              required></textarea>
                                    <div class="form-text">We will automatically include the page you are on and a screenshot of the current view.</div>
                                </div>
                                <div class="alert d-none" id="issueReportAlert" role="alert"></div>
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" id="issueReportSubmit" class="btn btn-primary">Submit</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (showTodoSidebar)
        {
            <button type="button"
                    id="todoSidebarRailToggle"
                    class="todo-sidebar-rail-toggle"
                    data-todo-toggle="toggle"
                    aria-controls="todoSidebar"
                    aria-expanded="true"
                    aria-label="Collapse to-do sidebar">
                <span class="todo-sidebar-rail-icon" aria-hidden="true"></span>
            </button>
            <aside id="todoSidebar" class="todo-sidebar bg-white border-start" aria-label="To-do sidebar">
                <div class="todo-sidebar-inner">
                    <div class="todo-sidebar-header">
                        <h6 class="mb-0">To-Do</h6>
                        <small class="text-muted">Your assignments &amp; reminders</small>
                    </div>
                    <div class="todo-sidebar-body">
                        @if (!string.IsNullOrWhiteSpace(toDoMessage))
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @toDoMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(toDoError))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @toDoError
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        @{
                            var departmentCollapseId = "departmentTasksCollapse";
                            var personalCollapseId = "personalTodosCollapse";
                        }
                        <section class="todo-section">
                            <div class="section-heading">
                                <button class="todo-section-toggle d-flex align-items-center justify-content-between w-100"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@departmentCollapseId"
                                        data-section-key="department"
                                        aria-expanded="true"
                                        aria-controls="@departmentCollapseId">
                                    <div class="d-flex flex-column text-start">
                                        <span class="fw-semibold">Department Work Orders</span>
                                        <small class="text-muted">Shared assignments from your departments</small>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-light text-dark">@toDoData.DepartmentTasks.Count</span>
                                        <span class="todo-section-toggle-icon" aria-hidden="true"></span>
                                    </div>
                                </button>
                            </div>
                            <div id="@departmentCollapseId" class="collapse show">
                                <div class="todo-list mt-3">
                                @if (toDoData.DepartmentTasks.Any())
                                {
                                    foreach (var task in toDoData.DepartmentTasks)
                                    {
                                        var dueDateText = task.HasDueDate
                                            ? TimeZoneService.ConvertToUserTime(task.DueDate).ToString("MMM d, yyyy")
                                            : "No due date";
                                        <div class="todo-card">
                                            <div class="w-100">
                                                <div class="fw-semibold">@task.Issue</div>
                                                <div class="small text-muted">
                                                    @task.DepartmentName
                                                    @if (!string.IsNullOrWhiteSpace(task.PropertyName))
                                                    {
                                                        <span>&middot; @task.PropertyName</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(task.Location))
                                                    {
                                                        <span>&middot; @task.Location</span>
                                                    }
                                                </div>
                                                <div class="small text-muted">Due: @dueDateText</div>
                                            </div>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <a class="btn btn-outline-secondary btn-sm" asp-controller="WorkOrders" asp-action="Edit" asp-route-id="@task.WorkOrderId">View</a>
                                                <form asp-controller="WorkOrders" asp-action="CompleteDepartmentWorkOrder" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@task.WorkOrderId" />
                                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                    <input type="hidden" name="CompletionNotes" data-completion-notes />
                                                    <button type="submit" class="btn btn-success btn-sm" data-complete-button>Complete</button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    if (!toDoData.HasDepartmentAssignments)
                                    {
                                        <p class="text-muted small mb-0">
                                            Assign yourself to departments on <a asp-controller="Profile" asp-action="Index">My Profile</a> to receive shared tasks.
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-0">No open work orders are currently assigned to your departments.</p>
                                    }
                                }
                                </div>
                            </div>
                        </section>
                        <section class="todo-section mt-4">
                            <div class="section-heading">
                                <button class="todo-section-toggle d-flex align-items-center justify-content-between w-100"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@personalCollapseId"
                                        data-section-key="personal"
                                        aria-expanded="true"
                                        aria-controls="@personalCollapseId">
                                    <div class="d-flex flex-column text-start">
                                        <span class="fw-semibold">My Personal To-Dos</span>
                                        <small class="text-muted">Quick reminders only visible to you</small>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-light text-dark">@toDoData.ActivePersonalToDos.Count</span>
                                        <span class="todo-section-toggle-icon" aria-hidden="true"></span>
                                    </div>
                                </button>
                            </div>
                            <div id="@personalCollapseId" class="collapse show">
                                <div class="todo-list mt-3">
                                @if (toDoData.ActivePersonalToDos.Any())
                                {
                                    foreach (var todo in toDoData.ActivePersonalToDos)
                                    {
                                        var createdText = TimeZoneService.ConvertToUserTime(todo.CreatedAtUtc).ToString("MMM d, h:mm tt");
                                        <div class="todo-card align-items-start">
                                            <form asp-controller="WorkOrders" asp-action="TogglePersonalTodo" method="post" class="todo-checkbox-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@todo.Id" />
                                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                <input class="form-check-input" type="checkbox" value="true" onchange="this.form.submit()" />
                                            </form>
                                            <div class="flex-grow-1">
                                                <div class="fw-semibold">@todo.Title</div>
                                                <div class="small text-muted">Added @createdText</div>
                                            </div>
                                            <form asp-controller="WorkOrders" asp-action="DeletePersonalTodo" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@todo.Id" />
                                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                <button type="submit" class="btn btn-link text-danger btn-sm p-0">Delete</button>
                                            </form>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">Add personal reminders to stay organized.</p>
                                }
                                </div>
                            </div>
                            <form asp-controller="WorkOrders" asp-action="AddPersonalTodo" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                <label class="form-label">Add a new item</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" name="title" class="form-control" maxlength="256" placeholder="e.g., Call vendor" required />
                                    <button type="submit" class="btn btn-primary">Add</button>
                                </div>
                            </form>
                            @if (toDoData.CompletedPersonalToDos.Any())
                            {
                                var collapseId = "completedTodos";
                                <div class="mt-4">
                                    <button class="btn btn-link p-0 d-flex align-items-center gap-2" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                        <span class="fw-semibold">Completed</span>
                                        <span class="badge bg-light text-dark">@toDoData.CompletedPersonalToDos.Count</span>
                                    </button>
                                    <div class="collapse mt-2" id="@collapseId">
                                        @foreach (var todo in toDoData.CompletedPersonalToDos)
                                        {
                                            var completedText = todo.CompletedAtUtc.HasValue
                                                ? TimeZoneService.ConvertToUserTime(todo.CompletedAtUtc.Value).ToString("MMM d, h:mm tt")
                                                : null;
                                            <div class="todo-card align-items-start text-muted">
                                                <form asp-controller="WorkOrders" asp-action="TogglePersonalTodo" method="post" class="todo-checkbox-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@todo.Id" />
                                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                    <input class="form-check-input" type="checkbox" value="true" checked onchange="this.form.submit()" />
                                                </form>
                                                <div class="flex-grow-1">
                                                    <div class="text-decoration-line-through">@todo.Title</div>
                                                    @if (!string.IsNullOrWhiteSpace(completedText))
                                                    {
                                                        <div class="small">Completed @completedText</div>
                                                    }
                                                </div>
                                                <form asp-controller="WorkOrders" asp-action="DeletePersonalTodo" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@todo.Id" />
                                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                    <button type="submit" class="btn btn-link text-danger btn-sm p-0">Delete</button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </section>
                    </div>
                </div>
            </aside>
        }
    </div>

    <div id="sidebarQuickMenu" class="sidebar-quick-menu" aria-hidden="true"></div>
    @if (showTodoSidebar)
    {
        <div class="todo-sidebar-backdrop d-lg-none" id="todoSidebarBackdrop" data-todo-toggle="collapse"></div>
    }

    @if (SignInManager.IsSignedIn(User))
    {
        <div class="modal fade" id="allBookmarksModal" tabindex="-1" aria-labelledby="allBookmarksModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="allBookmarksModalLabel">All Bookmarks</h1>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-add-bookmark-section>Add Section</button>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                    <div class="modal-body all-bookmarks-modal-body">
                        <div id="bookmarkOrderStatus" class="alert alert-success d-none small py-2" role="alert"></div>
                        <div id="allBookmarksContent" class="all-bookmarks-content text-center text-muted py-5">
                            Loading bookmarks...
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-outline-secondary" asp-controller="Bookmarks" asp-action="Index">Manage bookmarks</a>
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/clipboard-uploads.js" asp-append-version="true"></script>
    <script src="~/js/rich-text.js" asp-append-version="true"></script>
    <script src="~/js/mentions.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)

    <div id="pageLiveRegion" class="visually-hidden" role="status" aria-live="polite"></div>

    <script>
        (function () {
            const body = document.body;
            const antiForgeryInput = document.querySelector('#globalAntiforgeryForm input[name="__RequestVerificationToken"]');
            const antiForgeryToken = antiForgeryInput?.value || '';

            const sidebar = document.getElementById('sidebar');
            const sidebarFabToggle = document.getElementById('sidebarFabToggle');
            const sidebarToggles = Array.from(document.querySelectorAll('[data-sidebar-toggle]'));
            const sidebarBackdrop = document.getElementById('sidebarBackdrop');
            const sidebarMediaQuery = window.matchMedia('(max-width: 991.98px)');
            const quickMenu = document.getElementById('sidebarQuickMenu');
            const sidebarMenu = document.querySelector('.sidebar-menu');
            const QUICK_MENU_WIDTH = 240;
            let quickMenuHideTimer;
            const SIDEBAR_STORAGE_KEY = 'sidebarCollapsed';
            const bookmarkMenu = document.getElementById('bookmarkMenu');
            const bookmarkMenuContent = document.getElementById('bookmarkMenuContent');
            const hotelLayoutTrigger = document.querySelector('[data-hotel-layout-trigger]');
            const hotelLayoutPanel = document.getElementById('hotelLayoutPanel');
            const hotelLayoutPanelContent = document.getElementById('hotelLayoutPanelContent');
            let hotelLayoutLoaded = false;
            let hotelLayoutLoading = false;
            let hotelLayoutHideTimer;
            let hideHotelLayoutPanel = () => {};

            if (bookmarkMenu && bookmarkMenuContent) {
                const toggle = document.getElementById('bookmarkMenuToggle');
                const dropdownMenu = bookmarkMenu.querySelector('.dropdown-menu');
                let bookmarksLoaded = false;
                let bookmarksLoading = false;
                const allBookmarksButton = bookmarkMenu.querySelector('[data-all-bookmarks-toggle]');
                const allBookmarksModalElement = document.getElementById('allBookmarksModal');
                const allBookmarksContent = document.getElementById('allBookmarksContent');
                const allBookmarksModal = allBookmarksModalElement && window.bootstrap
                    ? bootstrap.Modal.getOrCreateInstance(allBookmarksModalElement)
                    : null;
                let allBookmarksLoaded = false;
                let allBookmarksLoading = false;
                let hoverHideTimer;
                const bookmarkOrderStatus = document.getElementById('bookmarkOrderStatus');
                let bookmarkOrderStatusTimer;
                let dragSourceTile = null;
                let orderSaveAbortController = null;
                let draggedSectionBlock = null;
                let sectionOrderSaveTimer;
                let sectionOrderAbortController = null;
                const addSectionButton = document.querySelector('[data-add-bookmark-section]');

                const escapeHtml = (value) => {
                    const div = document.createElement('div');
                    div.textContent = value ?? '';
                    return div.innerHTML;
                };

                const showBookmarkOrderStatus = (variant, message) => {
                    if (!bookmarkOrderStatus) {
                        return;
                    }
                    window.clearTimeout(bookmarkOrderStatusTimer);
                    bookmarkOrderStatus.textContent = message;
                    bookmarkOrderStatus.classList.remove('d-none', 'alert-success', 'alert-danger', 'alert-warning');
                    bookmarkOrderStatus.classList.add(`alert-${variant}`);
                    bookmarkOrderStatusTimer = window.setTimeout(() => {
                        bookmarkOrderStatus?.classList.add('d-none');
                    }, variant === 'danger' ? 4000 : 2000);
                };

                const getBookmarkIdsFromGrid = () => {
                    if (!allBookmarksContent) {
                        return [];
                    }
                    return Array.from(allBookmarksContent.querySelectorAll('.bookmark-tile'))
                        .map(tile => Number(tile.dataset.bookmarkId))
                        .filter(id => Number.isInteger(id) && id > 0);
                };

                const refreshQuickMenu = async () => {
                    await loadBookmarks(true);
                };

                const persistBookmarkOrder = async () => {
                    if (!allBookmarksContent) {
                        return;
                    }
                    const ids = getBookmarkIdsFromGrid();
                    if (!ids.length) {
                        return;
                    }
                    if (orderSaveAbortController) {
                        orderSaveAbortController.abort();
                        orderSaveAbortController = null;
                    }
                    const controller = new AbortController();
                    orderSaveAbortController = controller;
                    try {
                        const response = await fetch('/Bookmarks/UpdateOrder', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': antiForgeryToken || ''
                            },
                            body: JSON.stringify({ bookmarkIds: ids }),
                            signal: controller.signal
                        });
                        if (!response.ok) {
                            throw new Error('Request failed');
                        }
                        showBookmarkOrderStatus('success', 'Bookmark order saved.');
                        await refreshQuickMenu();
                    } catch (err) {
                        if (err.name === 'AbortError') {
                            return;
                        }
                        console.error('Unable to save bookmark order', err);
                        showBookmarkOrderStatus('danger', 'Unable to save bookmark order.');
                    } finally {
                        orderSaveAbortController = null;
                    }
                };

                const getSectionOrderFromDom = () => {
                    if (!allBookmarksContent) {
                        return [];
                    }
                    return Array.from(allBookmarksContent.querySelectorAll('.bookmark-section-block[data-section-id]'))
                        .map(block => Number(block.dataset.sectionId))
                        .filter(id => Number.isInteger(id) && id > 0);
                };

                const schedulePersistSectionOrder = () => {
                    window.clearTimeout(sectionOrderSaveTimer);
                    sectionOrderSaveTimer = window.setTimeout(() => {
                        sectionOrderSaveTimer = undefined;
                        persistSectionOrder();
                    }, 240);
                };

                const persistSectionOrder = async () => {
                    const sectionIds = getSectionOrderFromDom();
                    if (!sectionIds.length) {
                        return;
                    }
                    if (sectionOrderAbortController) {
                        sectionOrderAbortController.abort();
                        sectionOrderAbortController = null;
                    }
                    const controller = new AbortController();
                    sectionOrderAbortController = controller;
                    try {
                        const response = await fetch('/Bookmarks/UpdateSectionOrder', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': antiForgeryToken || ''
                            },
                            body: JSON.stringify({ sectionIds }),
                            signal: controller.signal
                        });
                        if (!response.ok) {
                            throw new Error('Request failed');
                        }
                        showBookmarkOrderStatus('success', 'Section order saved.');
                    } catch (error) {
                        if (error.name === 'AbortError') {
                            return;
                        }
                        console.error('Unable to save section order', error);
                        showBookmarkOrderStatus('danger', 'Unable to save section order.');
                    } finally {
                        sectionOrderAbortController = null;
                    }
                };

                const clearSectionDropTargets = () => {
                    allBookmarksContent?.querySelectorAll('.bookmark-section-block--drop-target')
                        .forEach(block => block.classList.remove('bookmark-section-block--drop-target'));
                };

                const handleSectionDragStart = (event) => {
                    const block = event.currentTarget;
                    if (!block?.dataset?.sectionId) {
                        event.preventDefault();
                        return;
                    }
                    draggedSectionBlock = block;
                    block.classList.add('bookmark-section-block--dragging');
                    event.dataTransfer.effectAllowed = 'move';
                    event.dataTransfer.setData('text/plain', block.dataset.sectionId);
                };

                const handleSectionDragEnd = () => {
                    if (draggedSectionBlock) {
                        draggedSectionBlock.classList.remove('bookmark-section-block--dragging');
                    }
                    draggedSectionBlock = null;
                    clearSectionDropTargets();
                };

                const handleSectionDragEnter = (event) => {
                    const target = event.currentTarget;
                    if (!draggedSectionBlock || target === draggedSectionBlock) {
                        return;
                    }
                    target.classList.add('bookmark-section-block--drop-target');
                };

                const handleSectionDragLeave = (event) => {
                    event.currentTarget.classList.remove('bookmark-section-block--drop-target');
                };

                const handleSectionDropOnBlock = (event) => {
                    event.preventDefault();
                    const target = event.currentTarget;
                    if (!draggedSectionBlock || draggedSectionBlock === target) {
                        clearSectionDropTargets();
                        return;
                    }
                    const parent = target.parentElement;
                    if (!parent) {
                        clearSectionDropTargets();
                        return;
                    }
                    const rect = target.getBoundingClientRect();
                    const shouldInsertBefore = (event.clientY - rect.top) < rect.height / 2;
                    if (shouldInsertBefore) {
                        parent.insertBefore(draggedSectionBlock, target);
                    } else {
                        parent.insertBefore(draggedSectionBlock, target.nextSibling);
                    }
                    clearSectionDropTargets();
                    schedulePersistSectionOrder();
                };

                const handleSectionWrapperDragOver = (event) => {
                    if (!draggedSectionBlock) {
                        return;
                    }
                    event.preventDefault();
                    event.dataTransfer.dropEffect = 'move';
                };

                const handleSectionWrapperDrop = (event) => {
                    if (!draggedSectionBlock) {
                        return;
                    }
                    if (event.target instanceof Element && event.target.closest('.bookmark-section-block[data-section-id]')) {
                        return;
                    }
                    event.preventDefault();
                    event.currentTarget.appendChild(draggedSectionBlock);
                    schedulePersistSectionOrder();
                };

                const initializeSectionDragAndDrop = (container) => {
                    if (!container) {
                        return;
                    }
                    const wrapper = container.querySelector('.bookmark-sections-wrapper');
                    if (!wrapper) {
                        return;
                    }
                    wrapper.addEventListener('dragover', handleSectionWrapperDragOver);
                    wrapper.addEventListener('drop', handleSectionWrapperDrop);
                    wrapper.querySelectorAll('.bookmark-section-block[data-section-id]').forEach(sectionBlock => {
                        sectionBlock.setAttribute('draggable', 'true');
                        sectionBlock.addEventListener('dragstart', handleSectionDragStart);
                        sectionBlock.addEventListener('dragend', handleSectionDragEnd);
                        sectionBlock.addEventListener('dragenter', handleSectionDragEnter);
                        sectionBlock.addEventListener('dragleave', handleSectionDragLeave);
                        sectionBlock.addEventListener('drop', handleSectionDropOnBlock);
                    });
                };

                const persistBookmarkSection = async (bookmarkId, sectionId) => {
                    try {
                        await fetch('/Bookmarks/AssignSection', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': antiForgeryToken || ''
                            },
                            body: JSON.stringify({
                                bookmarkId,
                                sectionId
                            })
                        });
                    } catch (error) {
                        console.error('Unable to update bookmark section', error);
                        showBookmarkOrderStatus('danger', 'Unable to update bookmark section.');
                    }
                };

                const persistQuickBookmarkFlag = async (bookmarkId, showInQuickMenu) => {
                    try {
                        const response = await fetch('/Bookmarks/UpdateQuickFlag', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': antiForgeryToken || ''
                            },
                            body: JSON.stringify({
                                bookmarkId,
                                showInQuickMenu
                            })
                        });
                        if (!response.ok) {
                            throw new Error('Request failed');
                        }
                        await refreshQuickMenu();
                    } catch (error) {
                        console.error('Unable to update quick bookmark', error);
                        showBookmarkOrderStatus('danger', 'Unable to update Quick Bookmarks.');
                    }
                };

                const getSectionIdFromGrid = (grid) => {
                    const value = grid?.dataset.sectionId;
                    if (!value) {
                        return null;
                    }
                    const parsed = Number(value);
                    return Number.isInteger(parsed) ? parsed : null;
                };

                const isQuickGrid = (grid) => grid?.dataset.quick === 'true';

                const getTileSectionId = (tile) => {
                    if (!(tile instanceof HTMLElement)) {
                        return null;
                    }
                    const value = tile.dataset.sectionId;
                    if (!value) {
                        return null;
                    }
                    const parsed = Number(value);
                    return Number.isInteger(parsed) ? parsed : null;
                };

                const updateTileSectionData = (tile, sectionId, isQuick = false) => {
                    if (!(tile instanceof HTMLElement)) {
                        return;
                    }
                    if (isQuick) {
                        tile.dataset.quick = 'true';
                        if (sectionId != null && !tile.dataset.sectionId) {
                            tile.dataset.sectionId = sectionId.toString();
                        }
                        return;
                    }
                    delete tile.dataset.quick;
                    if (sectionId == null) {
                        delete tile.dataset.sectionId;
                        return;
                    }
                    tile.dataset.sectionId = sectionId.toString();
                };

                const handleDragStart = (event) => {
                    const tile = event.currentTarget;
                    dragSourceTile = tile;
                    tile.classList.add('bookmark-tile--dragging');
                    if (event.dataTransfer) {
                        event.dataTransfer.effectAllowed = 'move';
                        event.dataTransfer.setData('text/plain', tile.dataset.bookmarkId || '');
                    }
                };

                const handleDragEnd = () => {
                    dragSourceTile?.classList.remove('bookmark-tile--dragging');
                    dragSourceTile = null;
                    allBookmarksContent?.querySelectorAll('.bookmark-tile--drop-target').forEach(tile => tile.classList.remove('bookmark-tile--drop-target'));
                };

                const handleDragEnter = (event) => {
                    if (event.currentTarget === dragSourceTile) {
                        return;
                    }
                    event.currentTarget.classList.add('bookmark-tile--drop-target');
                };

                const handleDragLeave = (event) => {
                    event.currentTarget.classList.remove('bookmark-tile--drop-target');
                };

                const finalizeTileMove = (grid) => {
                    if (!dragSourceTile || !(grid instanceof HTMLElement)) {
                        return;
                    }
                    const bookmarkId = Number(dragSourceTile.dataset.bookmarkId);
                    if (!Number.isInteger(bookmarkId) || bookmarkId <= 0) {
                        return;
                    }
                    const targetIsQuick = isQuickGrid(grid);
                    const sourceWasQuick = dragSourceTile.dataset.quick === 'true';
                    const sourceSectionId = getTileSectionId(dragSourceTile);
                    const gridSectionId = getSectionIdFromGrid(grid);
                    const nextSectionId = targetIsQuick ? sourceSectionId : gridSectionId;
                    updateTileSectionData(dragSourceTile, nextSectionId, targetIsQuick);
                    if (sourceWasQuick !== targetIsQuick) {
                        persistQuickBookmarkFlag(bookmarkId, targetIsQuick);
                    }
                    if (!targetIsQuick && (sourceSectionId ?? null) !== (nextSectionId ?? null)) {
                        persistBookmarkSection(bookmarkId, nextSectionId);
                    }
                    persistBookmarkOrder();
                };

                const handleDropOnTile = (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    const target = event.currentTarget;
                    target.classList.remove('bookmark-tile--drop-target');
                    if (!dragSourceTile || dragSourceTile === target) {
                        return;
                    }
                    const grid = target.parentElement;
                    if (!grid) {
                        return;
                    }
                    const rect = target.getBoundingClientRect();
                    const shouldInsertBefore = (event.clientY - rect.top) < rect.height / 2;
                    if (shouldInsertBefore) {
                        grid.insertBefore(dragSourceTile, target);
                    } else {
                        grid.insertBefore(dragSourceTile, target.nextSibling);
                    }
                    finalizeTileMove(grid);
                };

                const handleGridDrop = (event) => {
                    event.preventDefault();
                    if (!dragSourceTile) {
                        return;
                    }
                    const grid = event.currentTarget;
                    grid.appendChild(dragSourceTile);
                    finalizeTileMove(grid);
                };

                const initializeDragAndDrop = (grid) => {
                    if (!grid) {
                        return;
                    }
                    grid.addEventListener('dragover', (event) => event.preventDefault());
                    grid.addEventListener('drop', handleGridDrop);
                    grid.querySelectorAll('.bookmark-tile').forEach(tile => {
                        const bookmarkId = Number(tile.dataset.bookmarkId);
                        if (!Number.isInteger(bookmarkId) || bookmarkId <= 0) {
                            return;
                        }
                        tile.setAttribute('draggable', 'true');
                        tile.addEventListener('dragstart', handleDragStart);
                        tile.addEventListener('dragend', handleDragEnd);
                        tile.addEventListener('dragenter', handleDragEnter);
                        tile.addEventListener('dragleave', handleDragLeave);
                        tile.addEventListener('drop', handleDropOnTile);
                    });
                };

                const renderBookmarks = (items) => {
                    if (!items.length) {
                        bookmarkMenuContent.innerHTML = '<div class="px-3 py-2 text-muted small">No bookmarks yet.</div>';
                        return;
                    }

                    const list = document.createElement('ul');
                    list.className = 'mb-0 px-2 py-1';

                    items.forEach(item => {
                        const name = escapeHtml(item.name || 'Untitled bookmark');
                        const section = item.section ? escapeHtml(item.section) : '';
                        const url = item.url || '#';
                        const listItem = document.createElement('li');
                        listItem.className = 'mb-1';
                        listItem.innerHTML = `
                            <a class="dropdown-item d-flex flex-column gap-1" href="${url}" target="_blank" rel="noopener">
                                <span class="fw-semibold">${name}</span>
                                ${section ? `<small class="text-muted">${section}</small>` : ''}
                            </a>`;
                        list.appendChild(listItem);
                    });

                    bookmarkMenuContent.innerHTML = '';
                    bookmarkMenuContent.appendChild(list);
                };

                const getFaviconUrl = (rawUrl) => {
                    if (typeof rawUrl !== 'string' || !rawUrl.trim()) {
                        return null;
                    }

                    try {
                        const parsed = new URL(rawUrl, window.location.origin);
                        if (!parsed.hostname) {
                            return null;
                        }
                        return `https://www.google.com/s2/favicons?sz=128&domain_url=${encodeURIComponent(parsed.origin)}`;
                    } catch {
                        return null;
                    }
                };

                const getBookmarkInitial = (value) => {
                    if (typeof value !== 'string') {
                        return '#';
                    }
                    const trimmed = value.trim();
                    if (!trimmed) {
                        return '#';
                    }
                    const code = trimmed.codePointAt(0);
                    return code ? String.fromCodePoint(code).toUpperCase() : '#';
                };

                const createTileText = (text, className) => {
                    if (!text) {
                        return null;
                    }
                    const element = document.createElement('div');
                    element.className = className;
                    element.textContent = text;
                    return element;
                };

                const createBookmarkTile = (item) => {
                    const name = item.name || 'Untitled bookmark';
                    const section = item.section || '';
                    const description = item.description || '';
                    const url = typeof item.url === 'string' && item.url.trim() ? item.url.trim() : '#';
                    const tile = document.createElement('a');
                    tile.className = 'bookmark-tile text-decoration-none';
                    tile.href = url;
                    tile.target = '_blank';
                    tile.rel = 'noopener';
                    tile.title = `${name}${section ? ` · ${section}` : ''}`;
                    const bookmarkId = Number(item.id);
                    if (Number.isInteger(bookmarkId) && bookmarkId > 0) {
                        tile.dataset.bookmarkId = bookmarkId.toString();
                    }

                    const icon = document.createElement('div');
                    icon.className = 'bookmark-tile-icon';
                    const faviconUrl = getFaviconUrl(url);
                    const fallbackInitial = getBookmarkInitial(name);

                    if (faviconUrl) {
                        const img = document.createElement('img');
                        img.src = faviconUrl;
                        img.alt = '';
                        img.loading = 'lazy';
                        img.referrerPolicy = 'no-referrer';
                        img.addEventListener('error', () => {
                            icon.classList.add('bookmark-tile-icon--fallback');
                            icon.textContent = fallbackInitial;
                            img.remove();
                        });
                        icon.appendChild(img);
                    } else {
                        icon.classList.add('bookmark-tile-icon--fallback');
                        icon.textContent = fallbackInitial;
                    }

                    const nameElement = createTileText(name, 'bookmark-tile-name');
                    const sectionElement = createTileText(section, 'bookmark-tile-section');
                    const descriptionElement = createTileText(description, 'bookmark-tile-description');

                    tile.appendChild(icon);
                    if (nameElement) {
                        tile.appendChild(nameElement);
                    }
                    if (sectionElement) {
                        tile.appendChild(sectionElement);
                    }
                    if (descriptionElement) {
                        tile.appendChild(descriptionElement);
                    }

                    return tile;
                };

                const createBookmarkGrid = (bookmarks, sectionId, options = {}) => {
                    const isQuick = options.isQuick === true;
                    const grid = document.createElement('div');
                    grid.className = `bookmark-tiles-grid${isQuick ? ' bookmark-tiles-grid--quick' : ''}`;
                    if (isQuick) {
                        grid.dataset.quick = 'true';
                        grid.dataset.sectionId = '';
                    } else if (sectionId != null) {
                        grid.dataset.sectionId = sectionId.toString();
                    } else {
                        grid.dataset.sectionId = '';
                    }
                    bookmarks.forEach(item => {
                        const tile = createBookmarkTile(item);
                        const tileSectionId = typeof item.sectionGroupId === 'number'
                            ? item.sectionGroupId
                            : sectionId ?? null;
                        updateTileSectionData(tile, tileSectionId, isQuick);
                        grid.appendChild(tile);
                    });
                    initializeDragAndDrop(grid);
                    return grid;
                };

                const createQuickSectionBlock = (bookmarks) => {
                    const wrapper = document.createElement('section');
                    wrapper.className = 'bookmark-section-block bookmark-section-block--quick';
                    wrapper.dataset.quickSection = 'true';

                    const header = document.createElement('div');
                    header.className = 'bookmark-section-header';

                    const title = document.createElement('h3');
                    title.className = 'bookmark-section-title';
                    title.textContent = 'Quick Bookmarks';
                    header.appendChild(title);

                    wrapper.appendChild(header);

                    const helper = document.createElement('p');
                    helper.className = 'bookmark-section-helper text-muted small mb-3';
                    helper.textContent = 'Drag bookmarks here to control what appears in the Quick Bookmarks menu.';
                    wrapper.appendChild(helper);

                    if (!Array.isArray(bookmarks) || bookmarks.length === 0) {
                        const empty = document.createElement('p');
                        empty.className = 'bookmark-section-empty mb-2';
                        empty.textContent = 'No quick bookmarks yet.';
                        wrapper.appendChild(empty);
                    }

                    wrapper.appendChild(createBookmarkGrid(Array.isArray(bookmarks) ? bookmarks : [], null, { isQuick: true }));
                    return wrapper;
                };

                const createSectionBlock = (section) => {
                    const wrapper = document.createElement('section');
                    wrapper.className = 'bookmark-section-block';
                    wrapper.dataset.sectionId = section.id?.toString() || '';

                    const header = document.createElement('div');
                    header.className = 'bookmark-section-header';

                    const title = document.createElement('h3');
                    title.className = 'bookmark-section-title';
                    title.textContent = section.name || 'Section';
                    header.appendChild(title);

                    const actions = document.createElement('div');
                    actions.className = 'bookmark-section-actions';
                    const dragHandle = document.createElement('button');
                    dragHandle.type = 'button';
                    dragHandle.className = 'bookmark-section-drag-handle';
                    dragHandle.setAttribute('aria-label', 'Drag to reorder section');
                    dragHandle.title = 'Drag to reorder section';
                    const dragIcon = document.createElement('span');
                    dragIcon.className = 'bookmark-section-drag-icon';
                    dragIcon.setAttribute('aria-hidden', 'true');
                    dragHandle.appendChild(dragIcon);
                    actions.appendChild(dragHandle);
                    header.appendChild(actions);

                    wrapper.appendChild(header);

                    if (!Array.isArray(section.bookmarks) || section.bookmarks.length === 0) {
                        const empty = document.createElement('p');
                        empty.className = 'bookmark-section-empty mb-2';
                        empty.textContent = 'No bookmarks yet. Drag one here.';
                        wrapper.appendChild(empty);
                    }

                    wrapper.appendChild(createBookmarkGrid(Array.isArray(section.bookmarks) ? section.bookmarks : [], section.id));
                    return wrapper;
                };

                const createUngroupedBlock = (bookmarks) => {
                    const wrapper = document.createElement('section');
                    wrapper.className = 'bookmark-section-block';

                    const header = document.createElement('div');
                    header.className = 'bookmark-section-header';

                    const title = document.createElement('h3');
                    title.className = 'bookmark-section-title';
                    title.textContent = 'Ungrouped Bookmarks';
                    header.appendChild(title);

                    wrapper.appendChild(header);

                    if (!Array.isArray(bookmarks) || bookmarks.length === 0) {
                        const empty = document.createElement('p');
                        empty.className = 'bookmark-section-empty mb-2';
                        empty.textContent = 'Drag bookmarks here to keep them ungrouped.';
                        wrapper.appendChild(empty);
                    }

                    wrapper.appendChild(createBookmarkGrid(Array.isArray(bookmarks) ? bookmarks : [], null));
                    return wrapper;
                };

                const renderAllBookmarks = (payload) => {
                    if (!allBookmarksContent) {
                        return;
                    }

                    const sections = Array.isArray(payload?.sections) ? payload.sections : [];
                    const ungrouped = Array.isArray(payload?.ungrouped) ? payload.ungrouped : [];
                    const quick = Array.isArray(payload?.quick) ? payload.quick : [];
                    const quickIds = new Set(quick.map(item => Number(item.id)).filter(id => Number.isInteger(id)));

                    if (!sections.length && !ungrouped.length && !quick.length) {
                        bookmarkOrderStatus?.classList.add('d-none');
                        allBookmarksContent.innerHTML = '<div class="text-muted text-center py-4">No bookmarks yet.</div>';
                        return;
                    }

                    const wrapper = document.createElement('div');
                    wrapper.className = 'bookmark-sections-wrapper';
                    wrapper.appendChild(createQuickSectionBlock(quick));
                    sections.forEach(section => {
                        const filteredBookmarks = Array.isArray(section.bookmarks)
                            ? section.bookmarks.filter(item => !quickIds.has(Number(item.id)))
                            : [];
                        wrapper.appendChild(createSectionBlock({
                            id: section.id,
                            name: section.name,
                            bookmarks: filteredBookmarks
                        }));
                    });
                    const filteredUngrouped = ungrouped.filter(item => !quickIds.has(Number(item.id)));
                    wrapper.appendChild(createUngroupedBlock(filteredUngrouped));

                    allBookmarksContent.innerHTML = '';
                    allBookmarksContent.appendChild(wrapper);
                    initializeSectionDragAndDrop(allBookmarksContent);
                    bookmarkOrderStatus?.classList.add('d-none');
                };

                const loadBookmarks = async (force = false) => {
                    if ((!force && bookmarksLoaded) || bookmarksLoading) {
                        return;
                    }
                    bookmarksLoading = true;
                    try {
                        const response = await fetch('/Bookmarks/QuickList');
                        if (!response.ok) {
                            throw new Error('Request failed');
                        }
                        const data = await response.json();
                        const items = Array.isArray(data) ? data : Array.isArray(data?.items) ? data.items : [];
                        renderBookmarks(items);
                        bookmarksLoaded = true;
                    } catch (err) {
                        console.error('Unable to load bookmarks', err);
                        bookmarkMenuContent.innerHTML = '<div class="px-3 py-2 text-danger small">Unable to load bookmarks.</div>';
                    } finally {
                        bookmarksLoading = false;
                    }
                };

                const loadAllBookmarks = async (forceReload = false) => {
                    if (!allBookmarksContent || allBookmarksLoading || (!forceReload && allBookmarksLoaded)) {
                        return;
                    }

                    allBookmarksLoading = true;
                    allBookmarksContent.innerHTML = '<div class="text-muted text-center py-4">Loading bookmarks...</div>';
                    try {
                        const response = await fetch('/Bookmarks/QuickList?includeAll=true');
                        if (!response.ok) {
                            throw new Error('Request failed');
                        }
                        const data = await response.json();
                        renderAllBookmarks(data);
                        allBookmarksLoaded = true;
                    } catch (err) {
                        console.error('Unable to load all bookmarks', err);
                        allBookmarksContent.innerHTML = '<div class="text-danger text-center py-4">Unable to load bookmarks.</div>';
                    } finally {
                        allBookmarksLoading = false;
                    }
                };

                const setDropdownVisibility = (visible) => {
                    if (!dropdownMenu) {
                        return;
                    }
                    dropdownMenu.classList.toggle('show', visible);
                    bookmarkMenu.classList.toggle('show', visible);
                    toggle?.setAttribute('aria-expanded', visible ? 'true' : 'false');
                };

                const openAllBookmarksModal = async () => {
                    setDropdownVisibility(false);
                    if (allBookmarksModal) {
                        allBookmarksModal.show();
                    }
                    await loadAllBookmarks(true);
                };

                const showBookmarkDropdown = () => {
                    clearTimeout(hoverHideTimer);
                    setDropdownVisibility(true);
                    loadBookmarks();
                };

                const scheduleHideDropdown = () => {
                    clearTimeout(hoverHideTimer);
                    hoverHideTimer = setTimeout(() => {
                        if (!bookmarkMenu.matches(':hover') && document.activeElement !== toggle) {
                            setDropdownVisibility(false);
                        }
                    }, 180);
                };

            bookmarkMenu.addEventListener('mouseenter', showBookmarkDropdown);
            bookmarkMenu.addEventListener('mouseleave', scheduleHideDropdown);
            toggle?.addEventListener('focus', showBookmarkDropdown);
            toggle?.addEventListener('blur', scheduleHideDropdown);
            toggle?.addEventListener('click', async (event) => {
                    event.preventDefault();
                    await openAllBookmarksModal();
                });

                allBookmarksButton?.addEventListener('click', async (event) => {
                    event.preventDefault();
                    await openAllBookmarksModal();
                });

                addSectionButton?.addEventListener('click', async (event) => {
                    event.preventDefault();
                    const name = window.prompt('Section name');
                    if (!name || !name.trim()) {
                        return;
                    }
                    showBookmarkOrderStatus('warning', 'Creating section...');
                    try {
                        const response = await fetch('/Bookmarks/CreateSection', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': antiForgeryToken || ''
                            },
                            body: JSON.stringify({ name: name.trim() })
                        });
                        if (!response.ok) {
                            throw new Error('Request failed');
                        }
                        showBookmarkOrderStatus('success', 'Section added.');
                        await loadAllBookmarks(true);
                    } catch (error) {
                        console.error('Unable to create section', error);
                        showBookmarkOrderStatus('danger', 'Unable to create section.');
                    }
                });
            }

            function updateSidebarAria() {
                const expanded = !body.classList.contains('sidebar-collapsed');
                sidebarToggles.forEach(btn => {
                    btn.setAttribute('aria-expanded', expanded.toString());
                    if (btn === sidebarFabToggle) {
                        btn.setAttribute('aria-label', expanded ? 'Collapse navigation sidebar' : 'Expand navigation sidebar');
                        btn.classList.toggle('collapsed', !expanded);
                    }
                });
                if (sidebar) {
                    sidebar.setAttribute('aria-hidden', (!expanded).toString());
                }
            }

            function syncSidebarBackdrop() {
                if (!sidebarBackdrop) {
                    return;
                }
                const collapsed = body.classList.contains('sidebar-collapsed');
                sidebarBackdrop.classList.toggle('show', !collapsed);
            }

            function hideQuickMenu(immediate = true) {
                if (!quickMenu) {
                    return;
                }
                if (immediate) {
                    quickMenu.classList.remove('show');
                }
                quickMenu.setAttribute('aria-hidden', 'true');
            }

            function cancelHideQuickMenu() {
                if (quickMenuHideTimer) {
                    window.clearTimeout(quickMenuHideTimer);
                    quickMenuHideTimer = undefined;
                }
            }

            function scheduleHideQuickMenu() {
                if (!quickMenu) {
                    return;
                }
                cancelHideQuickMenu();
                quickMenuHideTimer = window.setTimeout(() => hideQuickMenu(true), 180);
            }

            function showQuickMenu(trigger) {
                if (!quickMenu || !sidebarMenu || !body.classList.contains('sidebar-collapsed')) {
                    return;
                }

                cancelHideQuickMenu();
                quickMenu.innerHTML = sidebarMenu.innerHTML;

                const rect = trigger.getBoundingClientRect();
                const top = rect.bottom + window.scrollY + 8;
                let left = rect.left + window.scrollX;
                const maxLeft = document.documentElement.clientWidth - QUICK_MENU_WIDTH - 16;
                left = Math.max(16, Math.min(left, maxLeft));

                quickMenu.style.top = `${top}px`;
                quickMenu.style.left = `${left}px`;
                quickMenu.classList.add('show');
                quickMenu.setAttribute('aria-hidden', 'false');
            }

            function setSidebarCollapsed(collapsed, options = { persist: true }) {
                body.classList.toggle('sidebar-collapsed', collapsed);
                if (options.persist) {
                    try {
                        localStorage.setItem(SIDEBAR_STORAGE_KEY, collapsed ? 'true' : 'false');
                    } catch (err) {
                        console.warn('Failed to store sidebar state:', err);
                    }
                }
                updateSidebarAria();
                syncSidebarBackdrop();
                if (!collapsed) {
                    hideQuickMenu(true);
                }
            }

            function toggleSidebar() {
                const currentlyCollapsed = body.classList.contains('sidebar-collapsed');
                setSidebarCollapsed(!currentlyCollapsed);
            }

            sidebarToggles.forEach(btn => {
                if (quickMenu && btn !== sidebarFabToggle) {
                    btn.addEventListener('mouseenter', () => {
                        cancelHideQuickMenu();
                        showQuickMenu(btn);
                    });
                    btn.addEventListener('mouseleave', scheduleHideQuickMenu);
                    btn.addEventListener('focus', () => {
                        cancelHideQuickMenu();
                        showQuickMenu(btn);
                    });
                    btn.addEventListener('blur', scheduleHideQuickMenu);
                }
            });

            document.addEventListener('click', (event) => {
                const sidebarTrigger = event.target.closest('[data-sidebar-toggle]');
                if (sidebarTrigger) {
                    event.preventDefault();
                    toggleSidebar();
                    return;
                }
                const todoTrigger = event.target.closest('[data-todo-toggle]');
                if (todoTrigger) {
                    event.preventDefault();
                    const action = todoTrigger.dataset.todoToggle;
                    if (action === 'collapse') {
                        toggleTodoSidebar(true);
                    } else {
                        toggleTodoSidebar();
                    }
                }
            });

            if (sidebarBackdrop) {
                sidebarBackdrop.addEventListener('click', () => setSidebarCollapsed(true));
            }

            function handleSidebarScreenChange(e) {
                if (e.matches) {
                    setSidebarCollapsed(true, { persist: false });
                } else {
                    let collapsedPreference = false;
                    try {
                        collapsedPreference = localStorage.getItem(SIDEBAR_STORAGE_KEY) === 'true';
                    } catch {
                        collapsedPreference = false;
                    }
                    setSidebarCollapsed(collapsedPreference, { persist: false });
                }
            }

            (function initialiseSidebarState() {
                let initialCollapsed = sidebarMediaQuery.matches;
                if (!sidebarMediaQuery.matches) {
                    try {
                        initialCollapsed = localStorage.getItem(SIDEBAR_STORAGE_KEY) === 'true';
                    } catch {
                        initialCollapsed = false;
                    }
                }
                setSidebarCollapsed(initialCollapsed, { persist: false });
            })();
            if (body) {
                body.dataset.sidebarReady = 'true';
            }

            if (sidebarMediaQuery.addEventListener) {
                sidebarMediaQuery.addEventListener('change', handleSidebarScreenChange);
            } else if (sidebarMediaQuery.addListener) {
                sidebarMediaQuery.addListener(handleSidebarScreenChange);
            }

            if (quickMenu) {
                quickMenu.addEventListener('mouseenter', cancelHideQuickMenu);
                quickMenu.addEventListener('mouseleave', scheduleHideQuickMenu);
                quickMenu.addEventListener('focusin', cancelHideQuickMenu);
                quickMenu.addEventListener('focusout', evt => {
                    if (!quickMenu.contains(evt.relatedTarget)) {
                        scheduleHideQuickMenu();
                    }
                });
                quickMenu.addEventListener('click', () => hideQuickMenu(true));
            }

            window.addEventListener('scroll', () => hideQuickMenu(true));
            window.addEventListener('resize', () => hideQuickMenu(true));

            document.addEventListener('keydown', evt => {
                if (evt.key === 'Escape') {
                    hideQuickMenu(true);
                    if (todoSidebar && !body.classList.contains('todo-sidebar-collapsed')) {
                        setTodoSidebarCollapsed(true);
                    }
                    hideHotelLayoutPanel();
                }
            });

            if (hotelLayoutTrigger && hotelLayoutPanel && hotelLayoutPanelContent) {
                const ensureHotelLayoutIframe = () => {
                    let iframe = hotelLayoutPanelContent.querySelector('iframe');
                    if (!iframe) {
                        iframe = document.createElement('iframe');
                        iframe.src = '/Home/HotelLayoutWidget?mode=panel';
                        iframe.className = 'hotel-layout-panel__frame';
                        iframe.title = 'Hotel layout preview';
                        iframe.loading = 'lazy';
                        iframe.setAttribute('aria-label', 'Hotel layout preview');
                        hotelLayoutPanelContent.innerHTML = '';
                        hotelLayoutPanelContent.appendChild(iframe);
                    }
                    return iframe;
                };

                const showHotelLayoutPanel = () => {
                    hotelLayoutTrigger.setAttribute('aria-expanded', 'true');
                    hotelLayoutPanel.classList.add('show');
                    positionHotelLayoutPanel();
                    cancelHotelLayoutHide();
                    ensureHotelLayoutIframe();
                };

                hideHotelLayoutPanel = () => {
                    hotelLayoutTrigger.setAttribute('aria-expanded', 'false');
                    hotelLayoutPanel.classList.remove('show');
                };

                const scheduleHotelLayoutHide = () => {
                    cancelHotelLayoutHide();
                    hotelLayoutHideTimer = window.setTimeout(() => hideHotelLayoutPanel(), 200);
                };

                const cancelHotelLayoutHide = () => {
                    if (hotelLayoutHideTimer) {
                        window.clearTimeout(hotelLayoutHideTimer);
                        hotelLayoutHideTimer = undefined;
                    }
                };

                const positionHotelLayoutPanel = () => {
                    const rect = hotelLayoutTrigger.getBoundingClientRect();
                    const viewportWidth = document.documentElement.clientWidth || window.innerWidth;
                    const viewportHeight = document.documentElement.clientHeight || window.innerHeight;
                    const panelWidth = Math.max(360, Math.min(viewportWidth - 24, 640));
                    hotelLayoutPanel.style.width = `${panelWidth}px`;
                    let left = rect.left + window.scrollX + rect.width / 2 - panelWidth / 2;
                    left = Math.max(12, Math.min(left, viewportWidth - panelWidth - 12));
                    hotelLayoutPanel.style.left = `${left}px`;

                    const maxPanelHeight = Math.max(320, Math.min(viewportHeight - 24, 760));
                    let availableBelow = viewportHeight - rect.bottom - 12;
                    let panelHeight = Math.min(maxPanelHeight, Math.max(320, availableBelow));
                    let top = rect.bottom + window.scrollY + 8;

                    if (panelHeight < 320) {
                        // Not enough space below, try positioning above the trigger
                        const availableAbove = rect.top - 12;
                        panelHeight = Math.min(maxPanelHeight, Math.max(320, availableAbove));
                        top = Math.max(window.scrollY + 12, rect.top + window.scrollY - panelHeight - 8);
                    }

                    hotelLayoutPanel.style.maxHeight = `${panelHeight}px`;
                    if (hotelLayoutPanelContent) {
                        hotelLayoutPanelContent.style.maxHeight = `${panelHeight - 12}px`;
                    }
                    hotelLayoutPanel.style.top = `${top}px`;
                };

                const handleHotelLayoutClick = event => {
                    event.preventDefault();
                    const screenWidth = Math.max(window.screen?.availWidth || 1400, 1200);
                    const screenHeight = Math.max(window.screen?.availHeight || 900, 800);
                    const popupWidth = Math.min(screenWidth - 40, 1580);
                    const popupHeight = Math.min(screenHeight - 40, 960);
                    const left = Math.max(0, ((window.screenX || window.screenLeft || 0) + (window.outerWidth - popupWidth) / 2));
                    const top = Math.max(0, ((window.screenY || window.screenTop || 0) + (window.outerHeight - popupHeight) / 2));
                    const features = [
                        `width=${Math.round(popupWidth)}`,
                        `height=${Math.round(popupHeight)}`,
                        `left=${Math.round(left)}`,
                        `top=${Math.round(top)}`,
                        'resizable=yes',
                        'scrollbars=yes'
                    ].join(',');
                    window.open('/Home/HotelLayoutWidget?mode=popup', 'HotelLayoutPopup', features);
                    hideHotelLayoutPanel();
                };

                hotelLayoutTrigger.addEventListener('mouseenter', showHotelLayoutPanel);
                hotelLayoutTrigger.addEventListener('focus', showHotelLayoutPanel);
                hotelLayoutTrigger.addEventListener('mouseleave', scheduleHotelLayoutHide);
                hotelLayoutTrigger.addEventListener('blur', scheduleHotelLayoutHide);
                hotelLayoutTrigger.addEventListener('click', handleHotelLayoutClick);

                hotelLayoutPanel.addEventListener('mouseenter', cancelHotelLayoutHide);
                hotelLayoutPanel.addEventListener('mouseleave', scheduleHotelLayoutHide);

                window.addEventListener('scroll', () => {
                    if (hotelLayoutPanel.classList.contains('show')) {
                        hideHotelLayoutPanel();
                    }
                });

                window.addEventListener('resize', () => {
                    if (hotelLayoutPanel.classList.contains('show')) {
                        positionHotelLayoutPanel();
                    }
                });

                document.addEventListener('click', event => {
                    if (!hotelLayoutPanel.classList.contains('show')) {
                        return;
                    }
                    if (event.target.closest('[data-hotel-layout-trigger]') || event.target.closest('#hotelLayoutPanel')) {
                        return;
                    }
                    hideHotelLayoutPanel();
                });
            }

            const todoSidebar = document.getElementById('todoSidebar');
            const todoRailToggle = document.getElementById('todoSidebarRailToggle');
            const todoBackdrop = document.getElementById('todoSidebarBackdrop');
            const todoMediaQuery = window.matchMedia('(max-width: 991.98px)');
            const TODO_SIDEBAR_STORAGE_KEY = 'todoSidebarCollapsed';
            const TODO_SECTION_STATE_STORAGE_KEY = 'todoSidebarSectionState';
            const todoToggleButtons = Array.from(document.querySelectorAll('[data-todo-toggle="toggle"]'));
            const todoSectionState = loadTodoSectionState();
            let todoRailDeferredSync = null;

            function updateTodoAria() {
                if (!todoSidebar) {
                    return;
                }
                const expanded = !body.classList.contains('todo-sidebar-collapsed');
                todoToggleButtons.forEach(btn => {
                    btn.setAttribute('aria-expanded', expanded.toString());
                    btn.setAttribute('aria-label', expanded ? 'Collapse to-do sidebar' : 'Expand to-do sidebar');
                    btn.classList.toggle('collapsed', !expanded);
                });
                todoSidebar.setAttribute('aria-hidden', (!expanded).toString());
            }

            function syncTodoBackdrop() {
                if (!todoBackdrop) {
                    return;
                }
                const collapsed = body.classList.contains('todo-sidebar-collapsed');
                todoBackdrop.classList.toggle('show', !collapsed && todoMediaQuery.matches);
            }

            function syncTodoRailPosition() {
                if (!todoRailToggle) {
                    return;
                }

                if (!todoSidebar || body.classList.contains('todo-sidebar-collapsed')) {
                    todoRailToggle.style.left = '';
                    todoRailToggle.style.right = '0px';
                    return;
                }

                const sidebarRect = todoSidebar.getBoundingClientRect();
                const toggleWidth = todoRailToggle.offsetWidth || 0;
                const viewportWidth = document.documentElement.clientWidth;
                const gutter = 2;

                let targetLeft = sidebarRect.left - toggleWidth + gutter;
                const maxLeft = Math.max(0, viewportWidth - toggleWidth);
                if (sidebarRect.left >= viewportWidth) {
                    targetLeft = maxLeft;
                } else {
                    targetLeft = Math.min(Math.max(targetLeft, 0), maxLeft);
                }

                todoRailToggle.style.left = `${targetLeft}px`;
                todoRailToggle.style.right = 'auto';
            }

            function setTodoSidebarCollapsed(collapsed, options = { persist: true }) {
                if (!todoSidebar) {
                    return;
                }
                body.classList.toggle('todo-sidebar-collapsed', collapsed);
                if (options.persist) {
                    try {
                        localStorage.setItem(TODO_SIDEBAR_STORAGE_KEY, collapsed ? 'true' : 'false');
                    } catch {
                        console.warn('Unable to persist to-do sidebar state');
                    }
                }
                updateTodoAria();
                syncTodoBackdrop();
                syncTodoRailPosition();
                if (!collapsed) {
                    if (todoRailDeferredSync) {
                        clearTimeout(todoRailDeferredSync);
                    }
                    todoRailDeferredSync = window.setTimeout(() => {
                        todoRailDeferredSync = null;
                        syncTodoRailPosition();
                    }, 350);
                }
            }

            function initialiseTodoSidebar() {
                if (!todoSidebar) {
                    return;
                }
                let collapsedPreference = false;
                try {
                    collapsedPreference = localStorage.getItem(TODO_SIDEBAR_STORAGE_KEY) === 'true';
                } catch {
                    collapsedPreference = false;
                }

                const initialCollapsed = todoMediaQuery.matches ? true : collapsedPreference;
                setTodoSidebarCollapsed(initialCollapsed, { persist: false });
                syncTodoRailPosition();
            }

            function handleTodoScreenChange(e) {
                if (e.matches) {
                    setTodoSidebarCollapsed(true, { persist: false });
                } else {
                    let collapsedPreference = false;
                    try {
                        collapsedPreference = localStorage.getItem(TODO_SIDEBAR_STORAGE_KEY) === 'true';
                    } catch {
                        collapsedPreference = false;
                    }
                    setTodoSidebarCollapsed(collapsedPreference, { persist: false });
                }
                syncTodoRailPosition();
            }

            function toggleTodoSidebar(forceValue) {
                const shouldCollapse = typeof forceValue === 'boolean'
                    ? forceValue
                    : !body.classList.contains('todo-sidebar-collapsed');
                setTodoSidebarCollapsed(shouldCollapse);
            }

            function loadTodoSectionState() {
                try {
                    const raw = localStorage.getItem(TODO_SECTION_STATE_STORAGE_KEY);
                    if (!raw) {
                        return {};
                    }
                    const parsed = JSON.parse(raw);
                    return parsed && typeof parsed === 'object' ? parsed : {};
                } catch {
                    return {};
                }
            }

            function persistTodoSectionState(key, isExpanded) {
                todoSectionState[key] = isExpanded;
                try {
                    localStorage.setItem(TODO_SECTION_STATE_STORAGE_KEY, JSON.stringify(todoSectionState));
                } catch {
                    // ignore storage failures
                }
            }

            function initTodoSectionPersistence() {
                if (!window.bootstrap) {
                    return;
                }

                const sectionButtons = document.querySelectorAll('.todo-section-toggle[data-section-key]');
                if (!sectionButtons.length) {
                    return;
                }

                sectionButtons.forEach(button => {
                    const key = button.dataset.sectionKey;
                    const targetSelector = button.getAttribute('data-bs-target');
                    if (!key || !targetSelector) {
                        return;
                    }
                    const target = document.querySelector(targetSelector);
                    if (!target) {
                        return;
                    }

                    const shouldExpand = todoSectionState.hasOwnProperty(key)
                        ? !!todoSectionState[key]
                        : true;

                    target.classList.toggle('show', shouldExpand);
                    target.classList.remove('collapsing');
                    target.style.height = '';
                    button.setAttribute('aria-expanded', shouldExpand.toString());

                    target.addEventListener('shown.bs.collapse', () => {
                        button.setAttribute('aria-expanded', 'true');
                        persistTodoSectionState(key, true);
                    });

                    target.addEventListener('hidden.bs.collapse', () => {
                        button.setAttribute('aria-expanded', 'false');
                        persistTodoSectionState(key, false);
                    });
                });
            }

            if (todoSidebar) {
                initialiseTodoSidebar();
                if (body) {
                    body.dataset.todoSidebarReady = 'true';
                }

                if (todoMediaQuery.addEventListener) {
                    todoMediaQuery.addEventListener('change', handleTodoScreenChange);
                } else if (todoMediaQuery.addListener) {
                    todoMediaQuery.addListener(handleTodoScreenChange);
                }

                initTodoSectionPersistence();

                todoSidebar.addEventListener('transitionend', (event) => {
                    if (body.classList.contains('todo-sidebar-collapsed')) {
                        return;
                    }
                    if (event.propertyName === 'width' ||
                        event.propertyName === 'padding' ||
                        event.propertyName === 'padding-left' ||
                        event.propertyName === 'padding-right') {
                        syncTodoRailPosition();
                    }
                });

                window.addEventListener('resize', syncTodoRailPosition);
                window.addEventListener('scroll', () => {
                    if (!body.classList.contains('todo-sidebar-collapsed')) {
                        syncTodoRailPosition();
                    }
                });
            }

            const shouldPollAccessRequests = document.body?.dataset?.userAuthenticated === 'true';

            async function fetchAccessRequestCount() {
                if (!shouldPollAccessRequests) {
                    return;
                }
                try {
                    const res = await fetch('/Admin/GetPendingAccessRequestCount');
                    const count = await res.json();
                    const badge = document.getElementById('accessRequestBadge');
                    if (badge) {
                        badge.style.display = count > 0 ? 'inline-block' : 'none';
                        if (count > 0) {
                            badge.textContent = count;
                        }
                    }

                    const adminMenuBadge = document.getElementById('adminMenuBadge');
                    if (adminMenuBadge) {
                        if (count > 0) {
                            adminMenuBadge.classList.remove('d-none');
                            adminMenuBadge.textContent = count;
                        } else {
                            adminMenuBadge.classList.add('d-none');
                            adminMenuBadge.textContent = '';
                        }
                    }

                    const dashboardBadge = document.getElementById('adminAccessRequestsBadge');
                    if (dashboardBadge) {
                        if (count > 0) {
                            dashboardBadge.classList.remove('d-none');
                            dashboardBadge.textContent = count;
                        } else {
                            dashboardBadge.classList.add('d-none');
                            dashboardBadge.textContent = '';
                        }
                    }
                } catch (err) {
                    console.error('Failed to load badge count:', err);
                }
            }

            if (shouldPollAccessRequests) {
                fetchAccessRequestCount();
                setInterval(fetchAccessRequestCount, 30000);
            }
        })();
    </script>

    @if (SignInManager.IsSignedIn(User))
    {
        <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js" crossorigin="anonymous"></script>
        <script>
            (() => {
                const fabButton = document.getElementById('issueReportFab');
                const modalEl = document.getElementById('issueReportModal');
                const form = document.getElementById('issueReportForm');
                const detailsInput = document.getElementById('issueDetails');
                const alertEl = document.getElementById('issueReportAlert');
                const submitBtn = document.getElementById('issueReportSubmit');
                const antiforgeryInput = document.querySelector('#globalAntiforgeryForm input[name="__RequestVerificationToken"]');
                let latestScreenshotDataUrl = null;
                let screenshotCapturePromise = null;

                if (!fabButton || !modalEl || !form || !window.bootstrap) {
                    return;
                }

                const modalInstance = new bootstrap.Modal(modalEl);

                const resetAlert = () => {
                    if (!alertEl) {
                        return;
                    }
                    alertEl.classList.add('d-none');
                    alertEl.classList.remove('alert-danger', 'alert-success');
                    alertEl.textContent = '';
                };

                const showAlert = (variant, message) => {
                    if (!alertEl) {
                        return;
                    }
                    alertEl.classList.remove('d-none', 'alert-danger', 'alert-success');
                    alertEl.classList.add(variant === 'success' ? 'alert-success' : 'alert-danger');
                    alertEl.textContent = message;
                };

                const captureScreenshot = async () => {
                    if (!window.html2canvas) {
                        return null;
                    }
                    try {
                        const canvas = await window.html2canvas(document.body, {
                            useCORS: true,
                            backgroundColor: '#ffffff',
                            scale: Math.min(window.devicePixelRatio || 1, 1.25)
                        });
                        return canvas.toDataURL('image/jpeg', 0.85);
                    } catch (error) {
                        console.warn('Issue reporter: screenshot capture failed', error);
                        return null;
                    }
                };

                const beginPageScreenshotCapture = () => {
                    if (screenshotCapturePromise) {
                        return screenshotCapturePromise;
                    }
                    latestScreenshotDataUrl = null;
                    // capture the page before the modal appears so admins see the pre-click state
                    screenshotCapturePromise = captureScreenshot()
                        .then(dataUrl => {
                            latestScreenshotDataUrl = dataUrl;
                            return dataUrl;
                        })
                        .catch(() => {
                            latestScreenshotDataUrl = null;
                            return null;
                        })
                        .finally(() => {
                            screenshotCapturePromise = null;
                        });
                    return screenshotCapturePromise;
                };

                fabButton.addEventListener('pointerdown', () => {
                    beginPageScreenshotCapture();
                });

                fabButton.addEventListener('click', async event => {
                    event.preventDefault();
                    try {
                        await beginPageScreenshotCapture();
                    } catch {
                        // capture failure is non-blocking
                    }
                    modalInstance.show();
                });

                modalEl.addEventListener('shown.bs.modal', () => {
                    detailsInput?.focus();
                });

                modalEl.addEventListener('hidden.bs.modal', () => {
                    form.reset();
                    resetAlert();
                    if (submitBtn) {
                        submitBtn.removeAttribute('disabled');
                        submitBtn.textContent = submitBtn.dataset.defaultText || 'Submit';
                    }
                });

                form.addEventListener('submit', async event => {
                    event.preventDefault();
                    if (!submitBtn) {
                        return;
                    }

                    const details = detailsInput?.value.trim() ?? '';
                    if (!details) {
                        showAlert('danger', 'Please describe the issue so we can investigate.');
                        detailsInput?.focus();
                        return;
                    }

                    resetAlert();
                    submitBtn.dataset.defaultText = submitBtn.dataset.defaultText || submitBtn.textContent || 'Submit';
                    submitBtn.textContent = 'Submitting...';
                    submitBtn.setAttribute('disabled', 'disabled');

                    try {
                        await screenshotCapturePromise;
                    } catch {
                        // best effort capture; failures fall back to submitting without a screenshot
                    }

                    const payload = {
                        details,
                        pageUrl: window.location.href,
                        screenshotDataUrl: latestScreenshotDataUrl
                    };

                    try {
                        const response = await fetch('@Url.Action("ReportIssue", "Support")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': antiforgeryInput?.value ?? ''
                            },
                            body: JSON.stringify(payload)
                        });

                        if (!response.ok) {
                            let errorMessage = 'Unable to submit your report right now.';
                            try {
                                const data = await response.json();
                                if (data?.message) {
                                    errorMessage = data.message;
                                }
                            } catch {
                                // ignore parse errors
                            }
                            throw new Error(errorMessage);
                        }

                        showAlert('success', 'Thanks! Your report has been sent to the admin team.');
                        window.setTimeout(() => {
                            modalInstance.hide();
                        }, 1200);
                    } catch (error) {
                        console.error('Issue reporter error', error);
                        showAlert('danger', error.message || 'Unable to submit your report right now.');
                    } finally {
                        submitBtn.removeAttribute('disabled');
                        submitBtn.textContent = submitBtn.dataset.defaultText || 'Submit';
                    }
                });
            })();
        </script>
        <script>
            (function () {
                const collapseElement = document.getElementById('housekeepingInventoryMenu');
                const toggleButton = document.querySelector('[data-bs-target="#housekeepingInventoryMenu"]');

                if (!collapseElement || !toggleButton || typeof bootstrap === 'undefined') {
                    return;
                }

                const updateInventoryIcon = (expanded) => {
                    const icon = toggleButton.querySelector('[data-collapse-icon]');
                    if (!icon) {
                        return;
                    }
                    icon.textContent = expanded ? '−' : '+';
                };

                const collapseInstance = bootstrap.Collapse.getOrCreateInstance(collapseElement, { toggle: false });

                toggleButton.addEventListener('click', (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    collapseInstance.toggle();
                });

                collapseElement.addEventListener('click', (event) => {
                    event.stopPropagation();
                });

                collapseElement.addEventListener('show.bs.collapse', () => updateInventoryIcon(true));
                collapseElement.addEventListener('hide.bs.collapse', () => updateInventoryIcon(false));
            })();
        </script>
    }

