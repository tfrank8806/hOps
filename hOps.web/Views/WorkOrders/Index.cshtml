@using System
@using System.Globalization
@using System.Linq
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Http.Extensions
@using hOps.web.Utilities
@model hOps.web.ViewModels.WorkOrders.WorkOrdersViewModel

@{
    ViewData["Title"] = "Work Orders";
    ViewData["MainContainerClass"] = "main-inner--wide";

    bool showPropertySelector = Model.PropertyOptions.Count > 1;
    var formAction = Model.IsEditing ? "Edit" : "Create";
    var formRouteId = Model.IsEditing && Model.EditingWorkOrderId.HasValue
        ? Model.EditingWorkOrderId.Value.ToString()
        : null;
    var formTitle = Model.IsEditing ? "Edit Work Order" : "Create Work Order";
    var submitLabel = Model.IsEditing ? "Update Work Order" : "Submit Work Order";

    var filterQuery = new QueryBuilder();
    filterQuery.Add("SortOrder", Model.Filters.SortOrder);

    if (!string.IsNullOrWhiteSpace(Model.Filters.RoomNumber))
    {
        filterQuery.Add("RoomNumber", Model.Filters.RoomNumber);
    }

    if (!string.IsNullOrWhiteSpace(Model.Filters.Search))
    {
        filterQuery.Add("Search", Model.Filters.Search);
    }

    foreach (var departmentId in Model.Filters.DepartmentIds)
    {
        filterQuery.Add("DepartmentIds", departmentId.ToString(CultureInfo.InvariantCulture));
    }

    foreach (var workOrderTypeId in Model.Filters.WorkOrderTypeIds)
    {
        filterQuery.Add("WorkOrderTypeIds", workOrderTypeId.ToString(CultureInfo.InvariantCulture));
    }

    foreach (var status in Model.Filters.Statuses)
    {
        filterQuery.Add("Statuses", status);
    }

    foreach (var creatorId in Model.Filters.CreatorIds)
    {
        filterQuery.Add("CreatorIds", creatorId);
    }

    foreach (var propertyId in Model.Filters.PropertyIds)
    {
        filterQuery.Add("PropertyIds", propertyId.ToString(CultureInfo.InvariantCulture));
    }

    if (Model.Filters.HideCompleted)
    {
        filterQuery.Add("HideCompleted", "true");
    }

    var filterQueryString = filterQuery.ToQueryString().ToString();
    var exportUrl = $"{Url.Action("Export")}{filterQueryString}";
    var indexUrlWithFilters = $"{Url.Action("Index")}{filterQueryString}";
    var toDoMessage = TempData["ToDoMessage"] as string;
    var toDoError = TempData["ToDoError"] as string;
}

@functions {
    private IHtmlContent SortableHeader(string label, string key)
    {
        var isAsc = string.Equals(Model.Filters.SortOrder, key, StringComparison.OrdinalIgnoreCase);
        var isDesc = string.Equals(Model.Filters.SortOrder, $"{key}_desc", StringComparison.OrdinalIgnoreCase);
        var nextSort = isAsc ? $"{key}_desc" : key;

        var builder = new QueryBuilder
        {
            { "SortOrder", nextSort }
        };

        if (!string.IsNullOrWhiteSpace(Model.Filters.RoomNumber))
        {
            builder.Add("RoomNumber", Model.Filters.RoomNumber);
        }
        if (!string.IsNullOrWhiteSpace(Model.Filters.Search))
        {
            builder.Add("Search", Model.Filters.Search);
        }
        foreach (var id in Model.Filters.DepartmentIds)
        {
            builder.Add("DepartmentIds", id.ToString(CultureInfo.InvariantCulture));
        }
        foreach (var id in Model.Filters.WorkOrderTypeIds)
        {
            builder.Add("WorkOrderTypeIds", id.ToString(CultureInfo.InvariantCulture));
        }
        foreach (var status in Model.Filters.Statuses)
        {
            builder.Add("Statuses", status);
        }
        foreach (var creatorId in Model.Filters.CreatorIds)
        {
            builder.Add("CreatorIds", creatorId);
        }
        foreach (var propertyId in Model.Filters.PropertyIds)
        {
            builder.Add("PropertyIds", propertyId.ToString(CultureInfo.InvariantCulture));
        }

        if (Model.Filters.HideCompleted)
        {
            builder.Add("HideCompleted", "true");
        }

        var url = Url.Action("Index") + builder.ToQueryString();
        var indicator = isAsc ? "↑" : isDesc ? "↓" : "·";
        var classes = $"sortable-header {(isAsc || isDesc ? "active" : string.Empty)}";

        return new HtmlString($"<a class=\"{classes}\" href=\"{url}\">{label}<span class=\"sort-indicator\">{indicator}</span></a>");
    }
}

@section Styles {
    <style>
        @@media print {
            @@page {
                size: landscape;
                margin: 0.5in;
            }

            body {
                background: #fff !important;
            }

            body * {
                visibility: hidden;
            }

            #workorders-print-area,
            #workorders-print-area * {
                visibility: visible;
            }

            #workorders-print-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                padding: 0 1.5rem;
                background: #fff;
            }

            #workorders-print-area .card {
                box-shadow: none !important;
                border: none !important;
            }

            #workorders-print-area .card-header .btn,
            #workorders-print-area .card-header a {
                display: none !important;
            }

            #workorders-print-area .card-header {
                padding: 0.75rem 0;
            }

            #workorders-print-area .table {
                width: 100%;
                table-layout: fixed;
                font-size: 0.72rem;
            }

            #workorders-print-area th,
            #workorders-print-area td {
                padding: 0.25rem 0.35rem !important;
                vertical-align: top;
                word-break: break-word;
                white-space: normal;
            }

            #workorders-print-area th:nth-child(1),
            #workorders-print-area td:nth-child(1) {
                width: 7%;
            }

            #workorders-print-area th:nth-child(2),
            #workorders-print-area td:nth-child(2) {
                width: 8%;
            }

            #workorders-print-area th:nth-child(3),
            #workorders-print-area td:nth-child(3) {
                width: 14%;
            }

            #workorders-print-area th:nth-child(4),
            #workorders-print-area td:nth-child(4) {
                width: 12%;
            }

            #workorders-print-area th:nth-child(5),
            #workorders-print-area td:nth-child(5) {
                width: 9%;
            }

            #workorders-print-area th:nth-child(6),
            #workorders-print-area td:nth-child(6) {
                width: 18%;
            }

            #workorders-print-area th:nth-child(7),
            #workorders-print-area td:nth-child(7) {
                width: 7%;
            }

            #workorders-print-area th:nth-child(8),
            #workorders-print-area td:nth-child(8) {
                width: 7%;
            }

            #workorders-print-area th:nth-child(9),
            #workorders-print-area td:nth-child(9) {
                width: 12%;
            }

            #workorders-print-area th:nth-child(10),
            #workorders-print-area td:nth-child(10) {
                width: 5%;
            }

            #workorders-print-area .badge {
                display: inline-block;
                padding: 0.15rem 0.35rem;
                font-size: 0.65rem;
            }

            #workorders-print-area small {
                font-size: 0.65rem;
            }
        }

        .workorder-action-group {
            display: inline-flex;
            gap: 0.35rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .workorder-action-group form {
            display: inline;
        }

        .workorder-progress-form button {
            white-space: nowrap;
        }

        .workorder-details {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            white-space: normal;
            word-break: break-word;
        }

        .workorder-details p {
            margin-bottom: 0;
        }

        .sortable-header {
            color: inherit;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            font-weight: 600;
        }

        .sortable-header.active {
            color: #0d6efd;
        }

        .sort-indicator {
            font-size: 0.75rem;
            opacity: 0.8;
        }
    </style>
}

<div class="row g-4 align-items-start">
    <div class="col-12 col-xl-8 col-xxl-9">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Filters</h5>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#workOrdersFiltersCollapse"
                        aria-expanded="false"
                        aria-controls="workOrdersFiltersCollapse"
                        id="toggleFiltersButton">
                    Show Filters
                </button>
            </div>
            <div id="workOrdersFiltersCollapse" class="collapse">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <input type="hidden" name="HideCompleted" value="@(Model.Filters.HideCompleted ? "true" : "false")" />
                        <div class="col-md-4">
                            <label for="SortOrder" class="form-label">Default Sort</label>
                            <select class="form-select" id="SortOrder" name="SortOrder">
                                <option value="newest" selected="@(Model.Filters.SortOrder == "newest" ? "selected" : null)">Newest First</option>
                                <option value="oldest" selected="@(Model.Filters.SortOrder == "oldest" ? "selected" : null)">Oldest First</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="RoomNumber" class="form-label">Room / Location</label>
                            <input type="text" class="form-control" id="RoomNumber" name="RoomNumber" value="@Model.Filters.RoomNumber" />
                        </div>
                        <div class="col-md-4">
                            <label for="Statuses" class="form-label">Status</label>
                            <select class="form-select js-checkbox-multiselect"
                                    id="Statuses"
                                    name="Statuses"
                                    multiple
                                    data-placeholder="All statuses"
                                    data-all-label="All statuses">
                                @foreach (var status in Model.StatusOptions)
                                {
                                    var isSelected = Model.Filters.Statuses.Any(s => string.Equals(s, status.Key, StringComparison.OrdinalIgnoreCase));
                                    <option value="@status.Key" selected="@(isSelected ? "selected" : null)">@status.Label</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="DepartmentIds" class="form-label">Department</label>
                            <select class="form-select js-checkbox-multiselect"
                                    id="DepartmentIds"
                                    name="DepartmentIds"
                                    multiple
                                    data-placeholder="All departments"
                                    data-all-label="All departments">
                                @foreach (var dept in Model.Departments)
                                {
                                    var isSelected = Model.Filters.DepartmentIds.Contains(dept.Id);
                                    <option value="@dept.Id" selected="@(isSelected ? "selected" : null)">@dept.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="WorkOrderTypeIds" class="form-label">Work Order Type</label>
                            <select class="form-select js-checkbox-multiselect"
                                    id="WorkOrderTypeIds"
                                    name="WorkOrderTypeIds"
                                    multiple
                                    data-placeholder="All types"
                                    data-all-label="All types">
                                @foreach (var type in Model.WorkOrderTypes)
                                {
                                    var isSelected = Model.Filters.WorkOrderTypeIds.Contains(type.Id);
                                    <option value="@type.Id" selected="@(isSelected ? "selected" : null)">@type.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="CreatorIds" class="form-label">Creator</label>
                            <select class="form-select js-checkbox-multiselect"
                                    id="CreatorIds"
                                    name="CreatorIds"
                                    multiple
                                    data-placeholder="All creators"
                                    data-all-label="All creators">
                                @foreach (var creator in Model.CreatorOptions)
                                {
                                    if (string.IsNullOrWhiteSpace(creator.Value))
                                    {
                                        continue;
                                    }
                                    var isSelected = Model.Filters.CreatorIds.Any(id => string.Equals(id, creator.Value, StringComparison.OrdinalIgnoreCase));
                                    <option value="@creator.Value" selected="@(isSelected ? "selected" : null)">@creator.Text</option>
                                }
                            </select>
                        </div>
                        @if (Model.PropertyFilterOptions.Count > 0)
                        {
                            <div class="col-md-4">
                                <label for="PropertyIds" class="form-label">Property</label>
                                <select class="form-select js-checkbox-multiselect"
                                        id="PropertyIds"
                                        name="PropertyIds"
                                        multiple
                                        data-placeholder="All properties"
                                        data-all-label="All properties">
                                    @foreach (var property in Model.PropertyFilterOptions)
                                    {
                                        var isSelected = property.IsFilterSelected;
                                        var propertyLabel = string.IsNullOrWhiteSpace(property.Code)
                                            ? property.Name
                                            : $"{property.Name} ({property.Code})";
                                        <option value="@property.Id" selected="@(isSelected ? "selected" : null)">@propertyLabel</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="col-md-8">
                            <label for="Search" class="form-label">Keyword Search</label>
                            <input type="text" class="form-control" id="Search" name="Search" value="@Model.Filters.Search" placeholder="Search issue, details, or location" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                            <button type="submit" class="btn btn-primary">Apply Filters</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div id="workorders-print-area">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <h5 class="mb-0">Work Orders (@Model.WorkOrders.Count)</h5>
                        <form method="get" class="d-flex align-items-center gap-2 hide-completed-form">
                            <input type="hidden" name="SortOrder" value="@Model.Filters.SortOrder" />
                            @if (!string.IsNullOrWhiteSpace(Model.Filters.RoomNumber))
                            {
                                <input type="hidden" name="RoomNumber" value="@Model.Filters.RoomNumber" />
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Filters.Search))
                            {
                                <input type="hidden" name="Search" value="@Model.Filters.Search" />
                            }
                            @foreach (var departmentId in Model.Filters.DepartmentIds)
                            {
                                <input type="hidden" name="DepartmentIds" value="@departmentId" />
                            }
                            @foreach (var workOrderTypeId in Model.Filters.WorkOrderTypeIds)
                            {
                                <input type="hidden" name="WorkOrderTypeIds" value="@workOrderTypeId" />
                            }
                            @foreach (var status in Model.Filters.Statuses)
                            {
                                <input type="hidden" name="Statuses" value="@status" />
                            }
                            @foreach (var creatorId in Model.Filters.CreatorIds)
                            {
                                <input type="hidden" name="CreatorIds" value="@creatorId" />
                            }
                            @foreach (var propertyId in Model.Filters.PropertyIds)
                            {
                                <input type="hidden" name="PropertyIds" value="@propertyId" />
                            }
                            <input type="hidden" name="HideCompleted" value="false" />
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="hideCompletedToggle" name="HideCompleted" value="true" @(Model.Filters.HideCompleted ? "checked" : null) onchange="this.form.submit()" />
                                <label class="form-check-label" for="hideCompletedToggle">Hide completed</label>
                            </div>
                        </form>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="printWorkOrdersButton">
                            Print Current List
                        </button>
                        <a href="@exportUrl" class="btn btn-outline-success btn-sm">
                            Export to Excel
                        </a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 workorders-table">
                        <colgroup>
                            <col class="col-actions" />
                            <col class="col-status" />
                            <col class="col-location" />
                            <col class="col-department" />
                            <col class="col-type" />
                            <col class="col-issue" />
                            <col class="col-due" />
                            <col class="col-created" />
                            <col class="col-creator" />
                            <col class="col-attachments" />
                        </colgroup>
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="text-center">Actions</th>
                                <th scope="col">@SortableHeader("Status", "status")</th>
                                <th scope="col">@SortableHeader("Location", "location")</th>
                                <th scope="col">@SortableHeader("Department", "department")</th>
                                <th scope="col">@SortableHeader("Type", "type")</th>
                                <th scope="col">@SortableHeader("Issue", "issue")</th>
                                <th scope="col">@SortableHeader("Due", "due")</th>
                                <th scope="col">@SortableHeader("Created", "created")</th>
                                <th scope="col">@SortableHeader("Creator", "creator")</th>
                                <th scope="col" class="text-center" aria-label="Attachments">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path fill="currentColor" d="M6.354 13.657a3.5 3.5 0 0 1-4.95-4.95l6.718-6.718a2.5 2.5 0 0 1 3.536 3.536L5.621 11.612a1.5 1.5 0 1 1-2.121-2.121l5.303-5.304a.5.5 0 1 1 .708.708L4.208 10.2a.5.5 0 0 0 .707.707l5.303-5.303a1.5 1.5 0 1 0-2.121-2.121L1.379 10.5a2.5 2.5 0 1 0 3.536 3.536l5.657-5.657a.5.5 0 0 1 .707.708l-5.657 5.657Z" />
                                    </svg>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.WorkOrders.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4">No work orders found. Adjust filters or create a new work order.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var order in Model.WorkOrders)
                                {
                                    var isPastDue = order.DueDate.Date < DateTime.Today;
                                    var isEditingRow = Model.EditingWorkOrderId.HasValue && Model.EditingWorkOrderId.Value == order.Id;
                                    var statusSequence = new[] { "New", "In Progress", "Escalated", "On Hold", "Completed", "Cancelled" };
                                    var statusIndex = Array.FindIndex(statusSequence, status =>
                                        status.Equals(order.Status, StringComparison.OrdinalIgnoreCase) ||
                                        (status.Equals("New", StringComparison.OrdinalIgnoreCase) && order.Status.Equals("Open", StringComparison.OrdinalIgnoreCase)));
                                    if (statusIndex < 0)
                                    {
                                        statusIndex = 0;
                                    }
                                    var nextStatusLabel = statusSequence[(statusIndex + 1) % statusSequence.Length];
                                    var statusDisplay = order.Status.Equals("New", StringComparison.OrdinalIgnoreCase) ? "Open" : order.Status;
                                    var nextStatusFriendlyName = nextStatusLabel.Equals("New", StringComparison.OrdinalIgnoreCase) ? "Open" : nextStatusLabel;

                                    <tr class="workorder-row @(isEditingRow ? "table-active" : string.Empty)" style="border-left: 4px solid @order.StatusColor;">
                                        <td class="col-actions text-center">
                                            <div class="workorder-action-group">
                                                <a class="btn btn-outline-primary btn-sm"
                                                   href="@($"{Url.Action("Edit", new { id = order.Id })}{filterQueryString}")">
                                                    Edit
                                                </a>
                                                @if (Model.CanManageWorkOrders)
                                                {
                                                    var advanceUrl = $"{Url.Action("AdvanceStatus", new { id = order.Id })}{filterQueryString}";
                                                    <form method="post" action="@advanceUrl" class="workorder-progress-form">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="Next status: @nextStatusFriendlyName">
                                                            Next Status
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                        <td class="col-status">
                                            <span class="badge" style="background-color:@order.StatusColor;">@statusDisplay</span>
                                        </td>
                                        <td class="col-location">
                                            <div class="fw-semibold workorder-location">@order.Location</div>
                                            @if (!string.IsNullOrWhiteSpace(order.Details))
                                            {
                                                <small class="text-muted workorder-details">@Html.Raw(MentionMarkupFormatter.ToHtml(order.Details))</small>
                                            }
                                        </td>
                                        <td class="col-department">
                                            @if (!string.IsNullOrWhiteSpace(order.Department))
                                            {
                                                <span class="badge" style="background-color:@order.DepartmentColor;">@order.Department</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Unassigned</span>
                                            }
                                        </td>
                                        <td class="col-type">@order.WorkOrderType</td>
                                        <td class="col-issue">
                                            <div class="workorder-issue">@Html.Raw(MentionMarkupFormatter.ToHtml(order.Issue))</div>
                                        </td>
                                        <td class="col-due @(isPastDue ? "fw-bold text-danger" : string.Empty)">@order.DueDate.ToString("MMM dd, yyyy")</td>
                                        @{ var createdLocal = TimeZoneService.ConvertToUserTime(order.CreatedAt); }
                                        <td class="col-created">@createdLocal.ToString("MMM dd, yyyy")</td>
                                        <td class="col-creator">@(string.IsNullOrWhiteSpace(order.Creator) ? "Unknown" : order.Creator)</td>
                                        <td class="col-attachments text-center">
                                            @if (order.Attachments.Any())
                                            {
                                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                                    @foreach (var attachment in order.Attachments)
                                                    {
                                                        <a href="@attachment.FilePath"
                                                           target="_blank"
                                                           class="attachment-link"
                                                           title="@attachment.FileName">
                                                            <span class="visually-hidden">View attachment (@attachment.FileName)</span>
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                                                <path fill="currentColor" d="M6.354 13.657a3.5 3.5 0 0 1-4.95-4.95l6.718-6.718a2.5 2.5 0 0 1 3.536 3.536L5.621 11.612a1.5 1.5 0 1 1-2.121-2.121l5.303-5.304a.5.5 0 1 1 .708.708L4.208 10.2a.5.5 0 0 0 .707.707l5.303-5.303a1.5 1.5 0 1 0-2.121-2.121L1.379 10.5a2.5 2.5 0 1 0 3.536 3.536l5.657-5.657a.5.5 0 0 1 .707.708l-5.657 5.657Z" />
                                                            </svg>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span></span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4 col-xxl-3">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@formTitle</h5>
                @if (Model.IsEditing)
                {
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <a class="btn btn-sm btn-light" href="@indexUrlWithFilters">Cancel</a>
                        @if (Model.CanManageWorkOrders && Model.Form != null && Model.Form.Id.HasValue)
                        {
                            var deleteId = Model.Form!.Id!.Value;
                            var deleteUrl = $"{Url.Action("Delete", new { id = deleteId })}{filterQueryString}";
                            <form method="post" action="@deleteUrl" onsubmit="return confirm('Are you sure you want to delete this work order?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        }
                    </div>
                }
            </div>
            <div class="card-body">
                <form asp-action="@formAction" asp-route-id="@formRouteId" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Form.Id" />
                    <div class="mb-3">
                        <label asp-for="Form.Status" class="form-label"></label>
                        <select asp-for="Form.Status" class="form-select">
                            @foreach (var status in Model.StatusOptions)
                            {
                                <option value="@status.Key" selected="@(string.Equals(Model.Form?.Status, status.Key, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@status.Label</option>
                            }
                        </select>
                        <span asp-validation-for="Form.Status" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.Location" class="form-label"></label>
                        <input asp-for="Form.Location" class="form-control" list="locationSuggestions" placeholder="Room number or location" />
                        <datalist id="locationSuggestions">
                            @foreach (var suggestion in Model.LocationSuggestions)
                            {
                                <option value="@suggestion"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Form.Location" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.WorkOrderTypeId" class="form-label"></label>
                        <select asp-for="Form.WorkOrderTypeId" class="form-select">
                            <option value="">-- Select Type --</option>
                            @foreach (var type in Model.WorkOrderTypes)
                            {
                                <option value="@type.Id" selected="@(Model.Form?.WorkOrderTypeId == type.Id ? "selected" : null)">@type.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Form.WorkOrderTypeId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.Issue" class="form-label"></label>
                        <input asp-for="Form.Issue" class="form-control" placeholder="Short description" />
                        <span asp-validation-for="Form.Issue" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.Details" class="form-label"></label>
                        <textarea asp-for="Form.Details" class="form-control" rows="3" placeholder="Additional details" data-enable-mentions="true"></textarea>
                        <span asp-validation-for="Form.Details" class="text-danger"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="Form.DueDate" class="form-label"></label>
                            <input asp-for="Form.DueDate" class="form-control" type="date" />
                            <span asp-validation-for="Form.DueDate" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Form.DepartmentId" class="form-label"></label>
                            <select asp-for="Form.DepartmentId" class="form-select">
                                <option value="">-- Unassigned --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    <option value="@dept.Id" selected="@(Model.Form?.DepartmentId == dept.Id ? "selected" : null)">@dept.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Form.DepartmentId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <label asp-for="Form.Photos" class="form-label"></label>
                        <input asp-for="Form.Photos" class="form-control" type="file" accept="image/*" multiple />
                        <span class="form-text">
                            @if (Model.IsEditing)
                            {
                                @:Upload photos to add new attachments (existing files remain available).
                            }
                            else
                            {
                                @:Upload supporting photos (optional).
                            }
                        </span>
                        <span asp-validation-for="Form.Photos" class="text-danger"></span>
                    </div>
                    @if (showPropertySelector)
                    {
                        <fieldset class="mb-3">
                            <legend class="fs-6">Properties</legend>
                            <span asp-validation-for="Form.SelectedPropertyIds" class="text-danger"></span>
                            @foreach (var property in Model.PropertyOptions)
                            {
                                <div class="form-check d-flex align-items-center gap-2 mb-2">
                                    <input class="form-check-input" type="checkbox" value="@property.Id" name="Form.SelectedPropertyIds" id="property_@property.Id" @(property.IsSelected ? "checked" : string.Empty) />
                                    <label class="form-check-label mb-0" for="property_@property.Id">@property.Name (@property.Code)</label>
                                </div>
                            }
                        </fieldset>
                    }
                    else if (Model.PropertyOptions != null && Model.PropertyOptions.Count == 1)
                    {
                        var soleProperty = Model.PropertyOptions[0];
                        <input type="hidden" name="Form.SelectedPropertyIds" value="@soleProperty.Id" />
                        <div class="alert alert-info">
                            Work order will be created for <strong>@soleProperty.Name (@soleProperty.Code)</strong>.
                        </div>
                    }
                    <button type="submit" class="btn btn-primary w-100">@submitLabel</button>
                </form>
            </div>
        </div>
        <div class="card shadow-sm mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">To Do</h5>
                <button class="btn btn-sm btn-outline-secondary"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#workOrdersTodoCollapse"
                        aria-expanded="true"
                        aria-controls="workOrdersTodoCollapse">
                    Toggle
                </button>
            </div>
            <div id="workOrdersTodoCollapse" class="collapse show">
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(toDoMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @toDoMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(toDoError))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @toDoError
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Department Work Orders</h6>
                            <span class="badge bg-light text-dark">@Model.DepartmentTasks.Count</span>
                        </div>
                        <div class="mt-3">
                            @if (Model.DepartmentTasks.Any())
                            {
                                foreach (var task in Model.DepartmentTasks)
                                {
                                    var dueDateText = task.HasDueDate
                                        ? TimeZoneService.ConvertToUserTime(task.DueDate).ToString("MMM d, yyyy")
                                        : "No due date";
                                    <div class="border rounded p-3 mb-2">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <div class="fw-semibold">@task.Issue</div>
                                                <div class="small text-muted">
                                                    @task.DepartmentName
                                                    @if (!string.IsNullOrWhiteSpace(task.PropertyName))
                                                    {
                                                        <span>&middot; @task.PropertyName</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(task.Location))
                                                    {
                                                        <span>&middot; @task.Location</span>
                                                    }
                                                </div>
                                                <div class="small text-muted">Due: @dueDateText</div>
                                            </div>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@task.WorkOrderId">View</a>
                                                <form asp-action="CompleteDepartmentWorkOrder" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@task.WorkOrderId" />
                                                    <button type="submit" class="btn btn-success btn-sm">Mark Complete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small mb-0">No open work orders are currently assigned to your departments.</p>
                            }
                        </div>
                    </div>
                    <hr />
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">My Personal To-Dos</h6>
                            <span class="badge bg-light text-dark">@Model.PersonalToDos.Count</span>
                        </div>
                        <div>
                            @if (Model.PersonalToDos.Any())
                            {
                                foreach (var todo in Model.PersonalToDos)
                                {
                                    var createdText = TimeZoneService.ConvertToUserTime(todo.CreatedAtUtc).ToString("MMM d, h:mm tt");
                                    <div class="d-flex align-items-start gap-2 border rounded p-2 mb-2">
                                        <form asp-action="TogglePersonalTodo" method="post" class="mt-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@todo.Id" />
                                            <input class="form-check-input" type="checkbox" value="true" @(todo.IsCompleted ? "checked" : null) onchange="this.form.submit()" />
                                        </form>
                                        <div class="flex-grow-1">
                                            <div class="@(todo.IsCompleted ? "text-decoration-line-through text-muted" : "fw-semibold")">@todo.Title</div>
                                            <div class="small text-muted">Added @createdText</div>
                                            @if (todo.CompletedAtUtc.HasValue && todo.IsCompleted)
                                            {
                                                var completedText = TimeZoneService.ConvertToUserTime(todo.CompletedAtUtc.Value).ToString("MMM d, h:mm tt");
                                                <div class="small text-muted">Completed @completedText</div>
                                            }
                                        </div>
                                        <form asp-action="DeletePersonalTodo" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@todo.Id" />
                                            <button type="submit" class="btn btn-link text-danger btn-sm p-0">Delete</button>
                                        </form>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small">Add personal reminders to stay organized.</p>
                            }
                        </div>
                        <form asp-action="AddPersonalTodo" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <label class="form-label">Add a new item</label>
                            <div class="input-group">
                                <input type="text" name="title" class="form-control" maxlength="256" placeholder="e.g., Call vendor" required />
                                <button type="submit" class="btn btn-primary">Add</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const printButton = document.getElementById('printWorkOrdersButton');
            if (printButton) {
                printButton.addEventListener('click', function () {
                    window.print();
                });
            }

            const filtersCollapse = document.getElementById('workOrdersFiltersCollapse');
            const filtersToggleButton = document.getElementById('toggleFiltersButton');
            if (filtersCollapse && filtersToggleButton) {
                const updateToggleText = () => {
                    const isExpanded = filtersCollapse.classList.contains('show');
                    filtersToggleButton.textContent = isExpanded ? 'Hide Filters' : 'Show Filters';
                };
                filtersCollapse.addEventListener('shown.bs.collapse', updateToggleText);
                filtersCollapse.addEventListener('hidden.bs.collapse', updateToggleText);
                updateToggleText();
            }
        })();
    </script>
}
