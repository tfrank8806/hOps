<div class="row g-4 workorders-layout-row">
    <div class="col-12 col-xl-8 col-xxl-9 order-2 order-xl-1">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@filtersHeading</h5>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#workOrdersFiltersCollapse"
                        aria-expanded="false"
                        aria-controls="workOrdersFiltersCollapse"
                        id="toggleFiltersButton">
                    @filterToggleText
                </button>
            </div>
            <div id="workOrdersFiltersCollapse" class="collapse">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <input type="hidden" name="HideCompleted" value="@(Model.Filters.HideCompleted ? "true" : "false")" />
                        <div class="col-md-4">
                            <label for="SortOrder" class="form-label">@defaultSortLabel</label>
                            <select class="form-select" id="SortOrder" name="SortOrder">
                                <option value="newest" selected="@(Model.Filters.SortOrder == "newest" ? "selected" : null)">@newestFirstLabel</option>
                                <option value="oldest" selected="@(Model.Filters.SortOrder == "oldest" ? "selected" : null)">@oldestFirstLabel</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="RoomNumber" class="form-label">@roomLocationLabel</label>
                            <input type="text" class="form-control" id="RoomNumber" name="RoomNumber" value="@Model.Filters.RoomNumber" />
                        </div>
                        <div class="col-md-4">
                            <label for="Statuses" class="form-label">@statusLabel</label>
                            <select class="form-select js-checkbox-multiselect"
                                    id="Statuses"
                                    name="Statuses"
                                    multiple
                                    data-placeholder="@allStatusesLabel"
                                    data-all-label="@allStatusesLabel">
                                @foreach (var status in Model.StatusOptions)
                                {
                                    var isSelected = Model.Filters.Statuses.Any(s => string.Equals(s, status.Key, StringComparison.OrdinalIgnoreCase));
                                    <option value="@status.Key" selected="@(isSelected ? "selected" : null)">@Html.Localize($"WorkOrders.Status.{status.Key}", status.Label)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="DepartmentIds" class="form-label">@departmentLabel</label>
                            <select class="form-select js-checkbox-multiselect"
                                    id="DepartmentIds"
                                    name="DepartmentIds"
                                    multiple
                                    data-placeholder="@allDepartmentsLabel"
                                    data-all-label="@allDepartmentsLabel">
                                @foreach (var dept in Model.Departments)
                                {
                                    var isSelected = Model.Filters.DepartmentIds.Contains(dept.Id);
                                    var deptIdString = dept.Id.ToString(CultureInfo.InvariantCulture);
                                    var translatedDepartmentName = await Html.DisplayTranslatedTextAsync("Department", deptIdString, "Name", dept.Name ?? string.Empty);
                                    var departmentOptionLabel = string.IsNullOrWhiteSpace(translatedDepartmentName) ? dept.Name : translatedDepartmentName;
                                    <option value="@dept.Id" selected="@(isSelected ? "selected" : null)">@departmentOptionLabel</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="WorkOrderTypeIds" class="form-label">@workOrderTypeLabel</label>
                            <select class="form-select js-checkbox-multiselect"
                                    id="WorkOrderTypeIds"
                                    name="WorkOrderTypeIds"
                                    multiple
                                    data-placeholder="@allTypesLabel"
                                    data-all-label="@allTypesLabel">
                                @foreach (var type in Model.WorkOrderTypes)
                                {
                                    var isSelected = Model.Filters.WorkOrderTypeIds.Contains(type.Id);
                                    var typeIdString = type.Id.ToString(CultureInfo.InvariantCulture);
                                    var translatedTypeName = await Html.DisplayTranslatedTextAsync("WorkOrderType", typeIdString, "Name", type.Name ?? string.Empty);
                                    var workOrderTypeOptionLabel = string.IsNullOrWhiteSpace(translatedTypeName) ? type.Name : translatedTypeName;
                                    <option value="@type.Id" selected="@(isSelected ? "selected" : null)">@workOrderTypeOptionLabel</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="CreatorIds" class="form-label">@creatorLabel</label>
                            <select class="form-select js-checkbox-multiselect"
                                    id="CreatorIds"
                                    name="CreatorIds"
                                    multiple
                                    data-placeholder="@allCreatorsLabel"
                                    data-all-label="@allCreatorsLabel">
                                @foreach (var creator in Model.CreatorOptions)
                                {
                                    if (string.IsNullOrWhiteSpace(creator.Value))
                                    {
                                        continue;
                                    }
                                    var isSelected = Model.Filters.CreatorIds.Any(id => string.Equals(id, creator.Value, StringComparison.OrdinalIgnoreCase));
                                    <option value="@creator.Value" selected="@(isSelected ? "selected" : null)">@creator.Text</option>
                                }
                            </select>
                        </div>
                        @if (Model.PropertyFilterOptions.Count > 0)
                        {
                            <div class="col-md-4">
                                <label for="PropertyIds" class="form-label">@propertyLabel</label>
                                <select class="form-select js-checkbox-multiselect"
                                        id="PropertyIds"
                                        name="PropertyIds"
                                        multiple
                                        data-placeholder="@allPropertiesLabel"
                                        data-all-label="@allPropertiesLabel">
                                    @foreach (var property in Model.PropertyFilterOptions)
                                    {
                                        var isSelected = property.IsFilterSelected;
                                        var propertyIdString = property.Id.ToString(CultureInfo.InvariantCulture);
                                        var translatedPropertyName = await Html.DisplayTranslatedTextAsync("Property", propertyIdString, "Name", property.Name ?? string.Empty);
                                        var propertyNameDisplay = string.IsNullOrWhiteSpace(translatedPropertyName) ? property.Name : translatedPropertyName;
                                        var propertyOptionLabel = string.IsNullOrWhiteSpace(property.Code)
                                            ? propertyNameDisplay
                                            : string.Format(CultureInfo.CurrentCulture, "{0} ({1})", propertyNameDisplay, property.Code);
                                        <option value="@property.Id" selected="@(isSelected ? "selected" : null)">@propertyOptionLabel</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="col-md-8">
                            <label for="Search" class="form-label">@keywordSearchLabel</label>
                            <input type="text" class="form-control" id="Search" name="Search" value="@Model.Filters.Search" placeholder="@searchPlaceholderText" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">@resetFiltersLabel</a>
                            <button type="submit" class="btn btn-primary">@applyFiltersLabel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div id="workorders-print-area">
            @if (Model.DepartmentSummaries.Any())
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <h5 class="mb-0">@openByDepartmentHeading</h5>
                            <span class="text-muted small">@statusExcludesHint</span>
                        </div>
                        <div class="workorder-department-summary-grid">
                            @foreach (var summary in Model.DepartmentSummaries)
                            {
                                var deptColor = string.IsNullOrWhiteSpace(summary.DepartmentColor)
                                    ? "#0d6efd"
                                    : summary.DepartmentColor;
                                <div class="workorder-department-summary" style="--dept-color:@deptColor">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="workorder-department-summary__dot"></span>
                                        <span class="workorder-department-summary__label">@summary.DepartmentName</span>
                                    </div>
                                    <div class="workorder-department-summary__count">@summary.OpenCount</div>
                            <div class="text-muted small">@openWorkOrdersLabel</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <h5 class="mb-0">@workOrdersHeading (@Model.WorkOrders.Count)</h5>
                        <form method="get" class="d-flex align-items-center gap-2 hide-completed-form">
                            <input type="hidden" name="HideCompleted" value="false" data-hide-completed-hidden @(Model.Filters.HideCompleted ? "disabled" : null) />
                            <input type="hidden" name="SortOrder" value="@Model.Filters.SortOrder" />
                            @if (!string.IsNullOrWhiteSpace(Model.Filters.RoomNumber))
                            {
                                <input type="hidden" name="RoomNumber" value="@Model.Filters.RoomNumber" />
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Filters.Search))
                            {
                                <input type="hidden" name="Search" value="@Model.Filters.Search" />
                            }
                            @foreach (var departmentId in Model.Filters.DepartmentIds)
                            {
                                <input type="hidden" name="DepartmentIds" value="@departmentId" />
                            }
                            @foreach (var workOrderTypeId in Model.Filters.WorkOrderTypeIds)
                            {
                                <input type="hidden" name="WorkOrderTypeIds" value="@workOrderTypeId" />
                            }
                            @foreach (var status in Model.Filters.Statuses)
                            {
                                <input type="hidden" name="Statuses" value="@status" />
                            }
                            @foreach (var creatorId in Model.Filters.CreatorIds)
                            {
                                <input type="hidden" name="CreatorIds" value="@creatorId" />
                            }
                            @foreach (var propertyId in Model.Filters.PropertyIds)
                            {
                                <input type="hidden" name="PropertyIds" value="@propertyId" />
                            }
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="hideCompletedToggle"
                                       name="HideCompleted"
                                       value="true"
                                       @(Model.Filters.HideCompleted ? "checked" : null)
                                       onchange="const hidden=this.form.querySelector('[data-hide-completed-hidden]'); if(hidden){hidden.disabled=this.checked;} this.form.submit();" />
                                <label class="form-check-label" for="hideCompletedToggle">@hideCompletedLabel</label>
                            </div>
                        </form>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="printWorkOrdersButton">
                            Print Current List
                        </button>
                        <a href="@exportUrl" class="btn btn-outline-success btn-sm">
                            Export to Excel
                        </a>
                    </div>
                </div>
                <div class="table-responsive workorders-table-wrapper">
                    <table class="table table-hover table-sm align-middle mb-0 workorders-table">
                        <colgroup>
                            <col class="col-actions" />
                            <col class="col-status" />
                <col class="col-location" />
                <col class="col-department" />
                <col class="col-type" />
                <col class="col-issue" />
                <col class="col-details" />
                <col class="col-due" />
                <col class="col-created" />
                <col class="col-attachments" />
                </colgroup>
                <thead class="table-light">
                            <tr>
                                <th scope="col" class="text-center">@actionsHeaderLabel</th>
                            <th scope="col">@SortableHeader(statusHeaderLabel, "status")</th>
                            <th scope="col">@SortableHeader(locationHeaderLabel, "location")</th>
                            <th scope="col">@SortableHeader(departmentHeaderLabel, "department")</th>
                            <th scope="col">@assignedHeaderLabel</th>
                            <th scope="col">@SortableHeader(typeHeaderLabel, "type")</th>
                                <th scope="col">@SortableHeader(issueHeaderLabel, "issue")</th>
                                <th scope="col">@SortableHeader(detailsHeaderLabel, "details")</th>
                                <th scope="col">@SortableHeader(dueHeaderLabel, "due")</th>
                                <th scope="col">@SortableHeader(createdHeaderLabel, "created")</th>
                                <th scope="col" class="text-center" aria-label="@attachmentsHeaderLabel">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path fill="currentColor" d="M6.354 13.657a3.5 3.5 0 0 1-4.95-4.95l6.718-6.718a2.5 2.5 0 0 1 3.536 3.536L5.621 11.612a1.5 1.5 0 1 1-2.121-2.121l5.303-5.304a.5.5 0 1 1 .708.708L4.208 10.2a.5.5 0 0 0 .707.707l5.303-5.303a1.5 1.5 0 1 0-2.121-2.121L1.379 10.5a2.5 2.5 0 1 0 3.536 3.536l5.657-5.657a.5.5 0 0 1 .707.708l-5.657 5.657Z" />
                                    </svg>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.WorkOrders.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4">@emptyTableMessage</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var order in Model.WorkOrders)
                                {
                                    var isPastDue = order.DueDate.Date < DateTime.Today;
                                    var isEditingRow = Model.EditingWorkOrderId.HasValue && Model.EditingWorkOrderId.Value == order.Id;
                                    var statusSequence = new[] { "New", "In Progress", "Escalated", "On Hold", "Completed", "Cancelled" };
                                    var statusIndex = Array.FindIndex(statusSequence, status =>
                                        status.Equals(order.Status, StringComparison.OrdinalIgnoreCase) ||
                                        (status.Equals("New", StringComparison.OrdinalIgnoreCase) && order.Status.Equals("Open", StringComparison.OrdinalIgnoreCase)));
                                    if (statusIndex < 0)
                                    {
                                        statusIndex = 0;
                                    }
                                    var nextStatusLabel = statusSequence[(statusIndex + 1) % statusSequence.Length];
                                    var statusLabelRaw = !string.IsNullOrWhiteSpace(order.Status) && order.Status.Equals("New", StringComparison.OrdinalIgnoreCase)
                                        ? "Open"
                                        : order.Status ?? string.Empty;
                                    var rawStatusLabel = string.IsNullOrWhiteSpace(order.StatusLabel)
                                        ? statusLabelRaw
                                        : order.StatusLabel;
                                    var statusDisplay = string.IsNullOrWhiteSpace(order.TranslatedStatusLabel)
                                        ? Html.Localize(rawStatusLabel).ToString()
                                        : order.TranslatedStatusLabel!;
                                    var nextStatusFriendlyNameRaw = nextStatusLabel.Equals("New", StringComparison.OrdinalIgnoreCase) ? "Open" : nextStatusLabel;
                                    var nextStatusFriendlyName = Html.Localize(nextStatusFriendlyNameRaw);
                                    var createdLocal = TimeZoneService.ConvertToUserTime(order.CreatedAt);
                                    var attachmentsPayload = order.Attachments.Select(att =>
                                    {
                                        var fileLabel = string.IsNullOrWhiteSpace(att.FileName)
                                            ? System.IO.Path.GetFileName(att.FilePath ?? string.Empty)
                                            : att.FileName;
                                        var rawPath = att.FilePath ?? string.Empty;
                                        var resolvedUrl = string.IsNullOrWhiteSpace(rawPath) ? string.Empty : Url.Content(rawPath);
                                        var imageCandidate = !string.IsNullOrWhiteSpace(att.FileName) ? att.FileName : rawPath;
                                        return new
                                        {
                                            name = string.IsNullOrWhiteSpace(fileLabel) ? attachmentFallbackLabel : fileLabel,
                                            url = resolvedUrl,
                                            isImage = IsImageAttachment(imageCandidate)
                                        };
                                    }).ToList();
                                    var originalDepartmentName = order.Department ?? string.Empty;
                                    var departmentDisplayText = string.IsNullOrWhiteSpace(order.TranslatedDepartment)
                                        ? unassignedLabel.ToString()
                                        : order.TranslatedDepartment!;
                                    var assignedToDisplay = string.IsNullOrWhiteSpace(order.TranslatedAssignedTo)
                                        ? (string.IsNullOrWhiteSpace(order.AssignedToName) ? unassignedLabel.ToString() : order.AssignedToName!)
                                        : order.TranslatedAssignedTo;
                                    var originalAssignedTo = string.IsNullOrWhiteSpace(order.AssignedToName) ? string.Empty : order.AssignedToName!;
                                    var orderIdString = order.Id.ToString(CultureInfo.InvariantCulture);
                                    var originalIssue = order.Issue ?? string.Empty;
                                    var translatedIssue = string.IsNullOrWhiteSpace(order.TranslatedIssue) ? originalIssue : order.TranslatedIssue!;
                                    var translatedIssueHtml = string.IsNullOrWhiteSpace(translatedIssue) ? string.Empty : MentionMarkupFormatter.ToHtml(translatedIssue);
                                    var originalIssueHtml = string.IsNullOrWhiteSpace(originalIssue) ? string.Empty : MentionMarkupFormatter.ToHtml(originalIssue);
                                    var originalDetails = order.Details ?? string.Empty;
                                    var translatedDetails = string.IsNullOrWhiteSpace(order.TranslatedDetails) ? originalDetails : order.TranslatedDetails!;
                                    var translatedDetailsHtml = string.IsNullOrWhiteSpace(translatedDetails) ? string.Empty : MentionMarkupFormatter.ToHtml(translatedDetails);
                                    var originalDetailsHtml = string.IsNullOrWhiteSpace(originalDetails) ? string.Empty : MentionMarkupFormatter.ToHtml(originalDetails);
                                    var originalCompletionNotes = order.CompletionNotes ?? string.Empty;
                                    var translatedCompletionNotes = string.IsNullOrWhiteSpace(order.TranslatedCompletionNotes) ? originalCompletionNotes : order.TranslatedCompletionNotes!;
                                    var translatedCompletionNotesHtml = string.IsNullOrWhiteSpace(translatedCompletionNotes) ? string.Empty : MentionMarkupFormatter.ToHtml(translatedCompletionNotes);
                                    var originalCompletionNotesHtml = string.IsNullOrWhiteSpace(originalCompletionNotes) ? string.Empty : MentionMarkupFormatter.ToHtml(originalCompletionNotes);
                                    var originalLocation = order.Location ?? string.Empty;
                                    var translatedLocation = string.IsNullOrWhiteSpace(order.TranslatedLocation) ? originalLocation : order.TranslatedLocation!;
                                    var workOrderTypeRaw = order.WorkOrderType ?? unspecifiedTypeLabel;
                                    var workOrderTypeTranslated = string.IsNullOrWhiteSpace(order.TranslatedWorkOrderType) ? workOrderTypeRaw : order.TranslatedWorkOrderType;
                                    var propertyDisplayNames = order.TranslatedProperties != null && order.TranslatedProperties.Count > 0
                                        ? new List<string>(order.TranslatedProperties)
                                        : (order.TranslatedPropertyNames != null && order.TranslatedPropertyNames.Count > 0
                                            ? new List<string>(order.TranslatedPropertyNames)
                                            : new List<string>());
                                    var rawPropertyDisplayNames = new List<string>();
                                    if (order.Properties != null)
                                    {
                                        foreach (var property in order.Properties)
                                        {
                                            string? BuildEntry(string? value) =>
                                                string.IsNullOrWhiteSpace(value)
                                                    ? null
                                                    : (string.IsNullOrWhiteSpace(property.Code)
                                                        ? value
                                                        : string.Format(CultureInfo.CurrentCulture, "{0} ({1})", value, property.Code));

                                            var rawEntry = BuildEntry(property.Name);
                                            if (!string.IsNullOrWhiteSpace(rawEntry))
                                            {
                                                rawPropertyDisplayNames.Add(rawEntry);
                                            }

                                            if (propertyDisplayNames.Count == 0)
                                            {
                                                var translatedEntry = BuildEntry(property.TranslatedName);
                                                if (!string.IsNullOrWhiteSpace(translatedEntry))
                                                {
                                                    propertyDisplayNames.Add(translatedEntry);
                                                }
                                            }
                                        }
                                    }
                                    var propertiesDisplay = string.Join(", ", propertyDisplayNames);
                                    var workOrderPayload = new
                                    {
                                        id = order.Id,
                                        issue = translatedIssue,
                                        translatedIssue = translatedIssue,
                                        rawIssue = originalIssue,
                                        issueHtml = translatedIssueHtml,
                                        translatedIssueHtml = translatedIssueHtml,
                                        rawIssueHtml = originalIssueHtml,
                                        details = translatedDetails,
                                        translatedDetails = translatedDetails,
                                        rawDetails = originalDetails,
                                        detailsHtml = translatedDetailsHtml,
                                        translatedDetailsHtml = translatedDetailsHtml,
                                        rawDetailsHtml = originalDetailsHtml,
                                        completionNotes = translatedCompletionNotes,
                                        translatedCompletionNotes = translatedCompletionNotes,
                                        rawCompletionNotes = originalCompletionNotes,
                                        completionNotesHtml = translatedCompletionNotesHtml,
                                        translatedCompletionNotesHtml = translatedCompletionNotesHtml,
                                        rawCompletionNotesHtml = originalCompletionNotesHtml,
                                        location = translatedLocation,
                                        translatedLocation = translatedLocation,
                                        rawLocation = originalLocation,
                                        status = order.Status,
                                        statusLabel = statusDisplay,
                                        translatedStatusLabel = statusDisplay,
                                        rawStatusLabel = rawStatusLabel,
                                        statusColor = order.StatusColor,
                                        workOrderType = workOrderTypeTranslated,
                                        translatedWorkOrderType = workOrderTypeTranslated,
                                        workOrderTypeRaw = workOrderTypeRaw,
                                        department = departmentDisplayText,
                                        translatedDepartment = departmentDisplayText,
                                        rawDepartment = originalDepartmentName,
                                        departmentColor = order.DepartmentColor,
                                        assignedTo = assignedToDisplay,
                                        translatedAssignedTo = assignedToDisplay,
                                        rawAssignedTo = originalAssignedTo,
                                        assignedToId = order.AssignedToId,
                                        dueDateText = order.DueDate.ToString("d", CultureInfo.CurrentCulture),
                                        createdAtText = createdLocal.ToString("g", CultureInfo.CurrentCulture),
                                        creator = string.IsNullOrWhiteSpace(order.Creator) ? unknownUserLabel : order.Creator,
                                        createdByLabel = createdByPrefix,
                                        properties = propertyDisplayNames,
                                        translatedProperties = propertyDisplayNames,
                                        rawProperties = rawPropertyDisplayNames,
                                        propertiesEmptyText = notAssignedPropertyText,
                                        attachments = attachmentsPayload,
                                        attachmentFallbackLabel = attachmentFallbackLabel,
                                        priority = order.PriorityLabel,
                                        priorityClass = order.PriorityClass,
                                        slaStatus = order.SlaStatus,
                                        slaSummary = order.SlaSummary
                                    };
                                    var workOrderPayloadJson = JsonSerializer.Serialize(workOrderPayload);

                <tr class="workorder-row @(isEditingRow ? "table-active" : string.Empty) @(order.IsOverdue ? "workorder-row--overdue" : string.Empty)"
                    style="border-left: 4px solid @order.StatusColor;"
                    data-workorder="@workOrderPayloadJson">
                    <td class="col-actions text-center">
                        <div class="workorder-action-group">
                            <a class="btn btn-outline-primary btn-sm"
                               href="@($"{Url.Action("Edit", new { id = order.Id })}{filterQueryString}")">
                                @editLabel
                            </a>
                            @if (Model.CanUpdateWorkOrderStatus)
                            {
                                var advanceUrl = $"{Url.Action("AdvanceStatus", new { id = order.Id })}{filterQueryString}";
                                <form method="post" action="@advanceUrl" class="workorder-progress-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="CompletionNotes" value="@order.CompletionNotes" data-completion-notes />
                                    <label class="visually-hidden" for="workorder_status_@order.Id">@updateStatusLabel</label>
                                    <select id="workorder_status_@order.Id"
                                            class="form-select form-select-sm workorder-status-select"
                                            name="Status"
                                            title="@updateStatusTitle">
                                        @foreach (var statusOption in Model.StatusOptions)
                                        {
                                            var isSelected = statusOption.Key.Equals(order.Status, StringComparison.OrdinalIgnoreCase) ||
                                                (statusOption.Key.Equals("New", StringComparison.OrdinalIgnoreCase) && order.Status.Equals("Open", StringComparison.OrdinalIgnoreCase));
                                            <option value="@statusOption.Key" selected="@(isSelected ? "selected" : null)">
                                                @Html.Localize(statusOption.Label)
                                            </option>
                                        }
                                    </select>
                                </form>
                            }
                        </div>
                    </td>
                    <td class="col-status">
                        <div class="d-flex flex-column gap-1">
                            <span class="badge" style="background-color:@order.StatusColor;">@statusDisplay</span>
                            <span class="@order.PriorityClass">@order.PriorityLabel</span>
                        </div>
                    </td>
                    <td class="col-location">
                        <div class="fw-semibold workorder-location">@translatedLocation</div>
                    </td>
                    <td class="col-department">
                        @if (!string.IsNullOrWhiteSpace(order.TranslatedDepartment))
                        {
                            <span class="badge" style="background-color:@order.DepartmentColor;">@departmentDisplayText</span>
                        }
                        else
                        {
                            <span class="text-muted">@unassignedLabel</span>
                        }
                    </td>
                    <td class="col-assigned">
                        <div class="fw-semibold text-uppercase small text-muted">@Html.Localize("Assigned To")</div>
                        @if (!string.IsNullOrWhiteSpace(originalAssignedTo))
                        {
                            <div>@assignedToDisplay</div>
                        }
                        else
                        {
                            <span class="text-muted">@assignedToDisplay</span>
                        }
                    </td>
                    <td class="col-type">@(
                        string.IsNullOrWhiteSpace(workOrderTypeTranslated)
                            ? Html.Localize("Unspecified")
                            : workOrderTypeTranslated
                        )</td>
                    <td class="col-issue">
                        <div class="workorder-issue">@Html.Raw(translatedIssueHtml)</div>
                    </td>
                    <td class="col-details">
                        @if (!string.IsNullOrWhiteSpace(order.Details))
                        {
                            <div class="workorder-details js-workorder-details" data-details-trigger="true">
                                @Html.Raw(translatedDetailsHtml)
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">@Html.Localize("No details")</span>
                        }
                    </td>
                    <td class="col-due @(isPastDue ? "fw-bold text-danger" : string.Empty)">
                        @order.DueDate.ToString("MM-dd-yy")
                        <div class="@order.SlaStatusClass">@order.SlaSummary</div>
                    </td>
                    <td class="col-created">@createdLocal.ToString("MM-dd-yy")</td>
                    <td class="col-attachments text-center">
                        @if (order.Attachments.Any())
                        {
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2"
                                    data-workorder-trigger="attachments">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path fill="currentColor" d="M12 7c4.418 0 8 3.239 8 5s-3.582 5-8 5-8-3.239-8-5 3.582-5 8-5Zm0-2C6.477 5 2 8.582 2 12s4.477 7 10 7 10-3.582 10-7-4.477-7-10-7Zm0 4a3 3 0 1 0 0 6a3 3 0 0 0 0-6Zm0 2a1 1 0 1 1 0 2a1 1 0 0 1 0-2Z" />
                                </svg>
                                <span>@previewLabel</span>
                                <span class="badge bg-light text-dark">@order.Attachments.Count</span>
                            </button>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
        }
    }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4 col-xxl-3 workorders-form-column order-1 order-xl-2">
        <div class="workorders-form-wrapper">
            <div class="card shadow-sm workorders-form-card" id="workOrdersForm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@formTitle</h5>
                    @if (Model.IsEditing)
                    {
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <a class="btn btn-sm btn-light" href="@indexUrlWithFilters">@Html.Localize("Cancel", "Cancel")</a>
                            @if (Model.CanManageWorkOrders && Model.Form != null && Model.Form.Id.HasValue)
                            {
                                var deleteId = Model.Form!.Id!.Value;
                                var deleteUrl = $"{Url.Action("Delete", new { id = deleteId })}{filterQueryString}";
                                <form method="post" action="@deleteUrl" onsubmit="return confirm('Are you sure you want to delete this work order?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">@deleteLabel</button>
                                </form>
                            }
                        </div>
                    }
                </div>
                <div class="card-body">
                    <form asp-action="@formAction" asp-route-id="@formRouteId" method="post" enctype="multipart/form-data" class="workorders-form">
                        @Html.AntiForgeryToken()
                        <div class="workorders-form-fields">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="Form.Id" />
                        <div class="mb-3">
                            <label asp-for="Form.Status" class="form-label"></label>
                            <select asp-for="Form.Status" class="form-select">
                                @foreach (var status in Model.StatusOptions)
                                {
                                    <option value="@status.Key" selected="@(string.Equals(Model.Form?.Status, status.Key, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@status.Label</option>
                                }
                            </select>
                            <span asp-validation-for="Form.Status" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Form.Location" class="form-label"></label>
                            <input asp-for="Form.Location" class="form-control" list="locationSuggestions" placeholder="Room number or location" />
                            <datalist id="locationSuggestions">
                                @foreach (var suggestion in Model.LocationSuggestions)
                                {
                                    <option value="@suggestion"></option>
                                }
                            </datalist>
                            <span asp-validation-for="Form.Location" class="text-danger"></span>
                            @if (canAddAdditionalLocations)
                            {
                                var additionalLocations = Model.Form?.AdditionalLocations ?? new List<string>();
                                <div class="mt-3">
                                    <div class="d-flex flex-column gap-2" data-additional-locations>
                                        @for (var i = 0; i < additionalLocations.Count; i++)
                                        {
                                            var locationValue = additionalLocations[i];
                                            <div class="input-group additional-location-entry">
                                                <input type="text"
                                                       class="form-control"
                                                       name="Form.AdditionalLocations[@i]"
                                                       value="@locationValue"
                                                       placeholder="Room number or location"
                                                       list="locationSuggestions" />
                                                <button type="button"
                                                        class="btn btn-outline-secondary"
                                                        data-remove-additional-location
                                                        title="@removeLocationLabel">
                                                    <span aria-hidden="true">&times;</span>
                                                    <span class="visually-hidden">@removeLocationLabel</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <button type="button"
                                            class="btn btn-link px-0 mt-2"
                                            data-add-location-btn>
                                        + Add Additional Location
                                    </button>
                                    <template id="additionalLocationTemplate">
                                        <div class="input-group additional-location-entry">
                                            <input type="text"
                                                   class="form-control"
                                                   name=""
                                                   placeholder="Room number or location"
                                                   list="locationSuggestions" />
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    data-remove-additional-location
                                                    title="@removeLocationLabel">
                                                <span aria-hidden="true">&times;</span>
                                                <span class="visually-hidden">@removeLocationLabel</span>
                                            </button>
                                        </div>
                                    </template>
                                </div>
                            }
                        </div>
                        <div class="mb-3">
                            <label asp-for="Form.WorkOrderTypeId" class="form-label"></label>
                            <select asp-for="Form.WorkOrderTypeId" class="form-select">
                                <option value="">-- Select Type --</option>
                                @foreach (var type in Model.WorkOrderTypes)
                                {
                                    <option value="@type.Id" selected="@(Model.Form?.WorkOrderTypeId == type.Id ? "selected" : null)">@type.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Form.WorkOrderTypeId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Form.Issue" class="form-label"></label>
                            <input asp-for="Form.Issue" class="form-control" placeholder="Short description" />
                            <span asp-validation-for="Form.Issue" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Form.Details" class="form-label"></label>
                            <textarea asp-for="Form.Details"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Additional details"
                                      data-enable-mentions="true"
                                      data-clipboard-upload-target="#Form_Photos"></textarea>
                            <span asp-validation-for="Form.Details" class="text-danger"></span>
                        </div>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="Form.DueDate" class="form-label"></label>
                                <input asp-for="Form.DueDate" class="form-control" type="date" />
                                <span asp-validation-for="Form.DueDate" class="text-danger"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Form.DepartmentId" class="form-label"></label>
                                <select asp-for="Form.DepartmentId" class="form-select">
                                    <option value="">-- @unassignedLabel --</option>
                                    @foreach (var dept in Model.Departments)
                                    {
                                        <option value="@dept.Id" selected="@(Model.Form?.DepartmentId == dept.Id ? "selected" : null)">@dept.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="Form.DepartmentId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3" data-searchable-select>
                            <label asp-for="Form.AssignedUserId" class="form-label"></label>
                            <input type="search"
                                   class="form-control form-control-sm mb-2"
                                   placeholder="@searchTeammatesPlaceholder"
                                   data-searchable-select-input
                                   @(hasAssigneeOptions ? null : "disabled") />
                            <select asp-for="Form.AssignedUserId"
                                    class="form-select"
                                    data-searchable-select-target>
                                <option value="">@notAssignedOptionLabel</option>
                                @if (Model.AssigneeOptions != null)
                                {
                                    foreach (var option in Model.AssigneeOptions)
                                    {
                                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                                    }
                                }
                            </select>
                            @if (!hasAssigneeOptions)
                            {
                                <span class="form-text">@noEligibleTeammatesText</span>
                            }
                            else
                            {
                                <span class="form-text">@startTypingHelpText</span>
                            }
                            <span asp-validation-for="Form.AssignedUserId" class="text-danger"></span>
                        </div>
                        <div class="mb-3 mt-3">
                            <label asp-for="Form.Photos" class="form-label"></label>
                            <input asp-for="Form.Photos" class="form-control" type="file" accept="image/*" multiple />
                            <span class="form-text">
                                @if (Model.IsEditing)
                                {
                                    @uploadPhotosEditingText
                                }
                                else
                                {
                                    @uploadPhotosCreatingText
                                }
                            </span>
                            <span asp-validation-for="Form.Photos" class="text-danger"></span>
                        </div>
                        @if (showPropertySelector)
                        {
                            <fieldset class="mb-3">
                                <legend class="fs-6">@propertiesLegendLabel</legend>
                                <span asp-validation-for="Form.SelectedPropertyIds" class="text-danger"></span>
                                @foreach (var property in Model.PropertyOptions)
                                {
                                    var propertyIdString = property.Id.ToString(CultureInfo.InvariantCulture);
                                    var translatedPropertyName = await Html.DisplayTranslatedTextAsync("Property", propertyIdString, "Name", property.Name ?? string.Empty);
                                    var propertyNameDisplay = string.IsNullOrWhiteSpace(translatedPropertyName) ? property.Name : translatedPropertyName;
                                    var propertyOptionLabel = string.IsNullOrWhiteSpace(property.Code)
                                        ? propertyNameDisplay
                                        : string.Format(CultureInfo.CurrentCulture, "{0} ({1})", propertyNameDisplay, property.Code);
                                    <div class="form-check d-flex align-items-center gap-2 mb-2">
                                        <input class="form-check-input" type="checkbox" value="@property.Id" name="Form.SelectedPropertyIds" id="property_@property.Id" @(property.IsSelected ? "checked" : string.Empty) />
                                        <label class="form-check-label mb-0" for="property_@property.Id">@propertyOptionLabel</label>
                                    </div>
                                }
                            </fieldset>
                        }
                        else if (Model.PropertyOptions != null && Model.PropertyOptions.Count == 1)
                        {
                            var soleProperty = Model.PropertyOptions[0];
                            <input type="hidden" name="Form.SelectedPropertyIds" value="@soleProperty.Id" />
                        }
                        </div>
                        <div class="workorders-form-actions">
                            <button type="submit" class="btn btn-primary w-100">@submitLabel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="workOrderDetailsModal" tabindex="-1" aria-labelledby="workOrderDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header flex-wrap gap-2">
                <div>
                    <h5 class="modal-title mb-0" id="workOrderDetailsLabel" data-workorder-field="title">@workOrderModalTitle</h5>
                    <div class="text-muted small" data-workorder-field="meta"></div>
                </div>
                <div class="d-flex align-items-center gap-2 ms-auto flex-wrap">
                    <span class="badge" data-workorder-field="status"></span>
                    <span class="badge bg-light text-dark border" data-workorder-field="type"></span>
                </div>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="fw-semibold text-uppercase small text-muted">@locationModalLabel</div>
                        <div data-workorder-field="location"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-uppercase small text-muted">@departmentModalLabel</div>
                        <div data-workorder-field="department"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-uppercase small text-muted">@assignedToModalLabel</div>
                        <div data-workorder-field="assignee"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-uppercase small text-muted">@dueDateModalLabel</div>
                        <div data-workorder-field="dueDate"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-uppercase small text-muted">@createdModalLabel</div>
                        <div data-workorder-field="created"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-uppercase small text-muted">@creatorModalLabel</div>
                        <div data-workorder-field="creator" class="text-body"></div>
                    </div>
                    <div class="col-12">
                        <div class="fw-semibold text-uppercase small text-muted">@propertiesModalLabel</div>
                        <div data-workorder-field="properties"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="fw-semibold text-uppercase small text-muted">@issueModalLabel</div>
                    <div data-workorder-field="issue"></div>
                </div>
                <div class="mb-3">
                    <div class="fw-semibold text-uppercase small text-muted">@detailsModalLabel</div>
                    <div data-workorder-field="details" class="text-body"></div>
                </div>
                <div class="mb-3 d-none" data-completion-notes-container>
                    <div class="fw-semibold text-uppercase small text-muted">@completionNotesModalLabel</div>
                    <div data-workorder-field="completionNotes" class="text-body"></div>
                </div>
                <div class="mb-2" data-workorder-attachments-section>
                    <div class="fw-semibold text-uppercase small text-muted">@attachmentsModalLabel</div>
                    <div class="row g-3 workorder-modal-attachments" data-workorder-attachments></div>
                    <p class="text-muted small mb-0" data-workorder-attachments-empty>@attachmentsEmptyText</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@closeModalLabel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="workOrderAttachmentsModal" tabindex="-1" aria-labelledby="workOrderAttachmentsLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="workOrderAttachmentsLabel" data-attachments-modal-title>@attachmentsModalTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3" data-attachments-modal-body></div>
                <p class="text-muted mb-0 d-none" data-attachments-modal-empty>@attachmentsModalEmptyText</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="completeWorkOrderModal" tabindex="-1" aria-labelledby="completeWorkOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="completeWorkOrderModalLabel">@completionNotesModalTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2">@completionNotesModalDescription</p>
                <textarea class="form-control" rows="4" data-complete-notes-input placeholder="Enter completion notes (optional)"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Html.Localize("Cancel")</button>
                <button type="button" class="btn btn-primary" data-complete-submit>@markCompleteLabel</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/workorders.js" asp-append-version="true"></script>
    <script>
        (function () {
            const printButton = document.getElementById('printWorkOrdersButton');
            if (printButton) {
                printButton.addEventListener('click', function () {
                    window.print();
                });
            }

            const filtersCollapse = document.getElementById('workOrdersFiltersCollapse');
            const filtersToggleButton = document.getElementById('toggleFiltersButton');
            if (filtersCollapse && filtersToggleButton) {
                const hideText = @JsonSerializer.Serialize(hideFiltersText);
                const showText = @JsonSerializer.Serialize(showFiltersText);
                const updateToggleText = () => {
                    const isExpanded = filtersCollapse.classList.contains('show');
                    filtersToggleButton.textContent = isExpanded ? hideText : showText;
                };
                filtersCollapse.addEventListener('shown.bs.collapse', updateToggleText);
                filtersCollapse.addEventListener('hidden.bs.collapse', updateToggleText);
                updateToggleText();
            }
        })();
    </script>
}

