@using System
@using System.Collections.Generic
@using System.Globalization
@using System.IO
@using System.Linq
@using System.Text.Json
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Http.Extensions
@using hOps.web.Utilities
@model hOps.web.ViewModels.WorkOrders.WorkOrdersViewModel

@{
    ViewData["Title"] = "Work Orders";
    ViewData["MainContainerClass"] = "main-inner--wide main-inner--wide-stretched";
    ViewData["ContentSurfaceClass"] = "content-surface--flush";

    bool showPropertySelector = Model.PropertyOptions.Count > 1;
    var formAction = Model.IsEditing ? "Edit" : "Create";
    var formRouteId = Model.IsEditing && Model.EditingWorkOrderId.HasValue
        ? Model.EditingWorkOrderId.Value.ToString()
        : null;
    var formTitle = Model.IsEditing ? "Edit Work Order" : "Create Work Order";
    var submitLabel = Model.IsEditing ? "Update Work Order" : "Submit Work Order";
    var canAddAdditionalLocations = !Model.IsEditing;

    var filterQuery = new QueryBuilder();
    filterQuery.Add("SortOrder", Model.Filters.SortOrder);

    if (!string.IsNullOrWhiteSpace(Model.Filters.RoomNumber))
    {
        filterQuery.Add("RoomNumber", Model.Filters.RoomNumber);
    }

    if (!string.IsNullOrWhiteSpace(Model.Filters.Search))
    {
        filterQuery.Add("Search", Model.Filters.Search);
    }

    foreach (var departmentId in Model.Filters.DepartmentIds)
    {
        filterQuery.Add("DepartmentIds", departmentId.ToString(CultureInfo.InvariantCulture));
    }

    foreach (var workOrderTypeId in Model.Filters.WorkOrderTypeIds)
    {
        filterQuery.Add("WorkOrderTypeIds", workOrderTypeId.ToString(CultureInfo.InvariantCulture));
    }

    foreach (var status in Model.Filters.Statuses)
    {
        filterQuery.Add("Statuses", status);
    }

    foreach (var creatorId in Model.Filters.CreatorIds)
    {
        filterQuery.Add("CreatorIds", creatorId);
    }

    foreach (var propertyId in Model.Filters.PropertyIds)
    {
        filterQuery.Add("PropertyIds", propertyId.ToString(CultureInfo.InvariantCulture));
    }

    if (!Model.Filters.HideCompleted)
    {
        filterQuery.Add("HideCompleted", "false");
    }

    var filterQueryString = filterQuery.ToQueryString().ToString();
    var exportUrl = $"{Url.Action("Export")}{filterQueryString}";
    var indexUrlWithFilters = $"{Url.Action("Index")}{filterQueryString}";
    var hasAssigneeOptions = Model.AssigneeOptions != null && Model.AssigneeOptions.Count > 0;
}

@functions {
    private IHtmlContent SortableHeader(string label, string key)
    {
        var isAsc = string.Equals(Model.Filters.SortOrder, key, StringComparison.OrdinalIgnoreCase);
        var isDesc = string.Equals(Model.Filters.SortOrder, $"{key}_desc", StringComparison.OrdinalIgnoreCase);
        var nextSort = isAsc ? $"{key}_desc" : key;

        var builder = new QueryBuilder
        {
            { "SortOrder", nextSort }
        };

        if (!string.IsNullOrWhiteSpace(Model.Filters.RoomNumber))
        {
            builder.Add("RoomNumber", Model.Filters.RoomNumber);
        }
        if (!string.IsNullOrWhiteSpace(Model.Filters.Search))
        {
            builder.Add("Search", Model.Filters.Search);
        }
        foreach (var id in Model.Filters.DepartmentIds)
        {
            builder.Add("DepartmentIds", id.ToString(CultureInfo.InvariantCulture));
        }
        foreach (var id in Model.Filters.WorkOrderTypeIds)
        {
            builder.Add("WorkOrderTypeIds", id.ToString(CultureInfo.InvariantCulture));
        }
        foreach (var status in Model.Filters.Statuses)
        {
            builder.Add("Statuses", status);
        }
        foreach (var creatorId in Model.Filters.CreatorIds)
        {
            builder.Add("CreatorIds", creatorId);
        }
        foreach (var propertyId in Model.Filters.PropertyIds)
        {
            builder.Add("PropertyIds", propertyId.ToString(CultureInfo.InvariantCulture));
        }

        if (!Model.Filters.HideCompleted)
        {
            builder.Add("HideCompleted", "false");
        }

        var url = Url.Action("Index") + builder.ToQueryString();
        var indicator = isAsc ? "↑" : isDesc ? "↓" : string.Empty;
        var classes = $"sortable-header {(isAsc || isDesc ? "active" : string.Empty)}";
        var indicatorMarkup = string.IsNullOrEmpty(indicator)
            ? string.Empty
            : $"<span class=\"sort-indicator\">{indicator}</span>";

        return new HtmlString($"<a class=\"{classes}\" href=\"{url}\">{label}{indicatorMarkup}</a>");
    }

    private static bool IsImageAttachment(string? fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName))
        {
            return false;
        }

        var extension = System.IO.Path.GetExtension(fileName).ToLowerInvariant();
        return extension is ".png" or ".jpg" or ".jpeg" or ".gif" or ".bmp" or ".webp" or ".svg";
    }
}

