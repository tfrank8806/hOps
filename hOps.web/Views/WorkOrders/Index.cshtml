@using System
@using hOps.web.Utilities
@model hOps.web.ViewModels.WorkOrders.WorkOrdersViewModel
@{ 
    ViewData["Title"] = "Work Orders";
    ViewData["MainContainerClass"] = "main-inner--wide";
    bool showPropertySelector = Model.PropertyOptions.Count > 1;
}

@section Styles {
    <style>
        @@media print {
            @@page {
                size: landscape;
                margin: 0.5in;
            }

            body {
                background: #fff !important;
            }

            body * {
                visibility: hidden;
            }

            #workorders-print-area,
            #workorders-print-area * {
                visibility: visible;
            }

            #workorders-print-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                padding: 0 1.5rem;
                background: #fff;
            }

            #workorders-print-area .card {
                box-shadow: none !important;
                border: none !important;
            }

            #workorders-print-area .card-header .btn,
            #workorders-print-area .card-header a {
                display: none !important;
            }

            #workorders-print-area .card-header {
                padding: 0.75rem 0;
            }

            #workorders-print-area .table {
                width: 100%;
                table-layout: fixed;
                font-size: 0.72rem;
            }

            #workorders-print-area th,
            #workorders-print-area td {
                padding: 0.25rem 0.35rem !important;
                vertical-align: top;
                word-break: break-word;
                white-space: normal;
            }

            #workorders-print-area th:nth-child(1),
            #workorders-print-area td:nth-child(1) {
                width: 8%;
            }

            #workorders-print-area th:nth-child(2),
            #workorders-print-area td:nth-child(2) {
                width: 14%;
            }

            #workorders-print-area th:nth-child(3),
            #workorders-print-area td:nth-child(3) {
                width: 12%;
            }

            #workorders-print-area th:nth-child(4),
            #workorders-print-area td:nth-child(4) {
                width: 10%;
            }

            #workorders-print-area th:nth-child(5),
            #workorders-print-area td:nth-child(5) {
                width: 18%;
            }

            #workorders-print-area th:nth-child(6),
            #workorders-print-area td:nth-child(6) {
                width: 7%;
            }

            #workorders-print-area th:nth-child(7),
            #workorders-print-area td:nth-child(7) {
                width: 8%;
            }

            #workorders-print-area th:nth-child(8),
            #workorders-print-area td:nth-child(8) {
                width: 8%;
            }

            #workorders-print-area th:nth-child(9),
            #workorders-print-area td:nth-child(9) {
                width: 8%;
            }

            #workorders-print-area th:nth-child(10),
            #workorders-print-area td:nth-child(10) {
                width: 7%;
            }

            #workorders-print-area .badge {
                display: inline-block;
                padding: 0.15rem 0.35rem;
                font-size: 0.65rem;
            }

            #workorders-print-area small {
                font-size: 0.65rem;
            }
        }
    </style>
}

<div class="row g-4 align-items-start">
    <div class="col-12 col-xl-8 col-xxl-9">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Filters</h5>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#workOrdersFiltersCollapse"
                        aria-expanded="false"
                        aria-controls="workOrdersFiltersCollapse"
                        id="toggleFiltersButton">
                    Show Filters
                </button>
            </div>
            <div id="workOrdersFiltersCollapse" class="collapse">
                <div class="card-body">
                    <form method="get" class="row g-3">
                    <div class="col-md-4">
                        <label for="SortOrder" class="form-label">Sort</label>
                        <select class="form-select" id="SortOrder" name="SortOrder">
                            <option value="newest" selected="@(Model.Filters.SortOrder == "newest" ? "selected" : null)">Newest First</option>
                            <option value="oldest" selected="@(Model.Filters.SortOrder == "oldest" ? "selected" : null)">Oldest First</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="RoomNumber" class="form-label">Room / Location</label>
                        <input type="text" class="form-control" id="RoomNumber" name="RoomNumber" value="@Model.Filters.RoomNumber" />
                    </div>
                    <div class="col-md-4">
                        <label for="Status" class="form-label">Status</label>
                        <select class="form-select" id="Status" name="Status">
                            <option value="">All</option>
                            @foreach (var status in Model.StatusOptions)
                            {
                                <option value="@status.Key" selected="@(string.Equals(Model.Filters.Status, status.Key, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@status.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="DepartmentId" class="form-label">Department</label>
                        <select class="form-select" id="DepartmentId" name="DepartmentId">
                            <option value="">All</option>
                            @foreach (var dept in Model.Departments)
                            {
                                <option value="@dept.Id" selected="@(Model.Filters.DepartmentId == dept.Id ? "selected" : null)">@dept.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="WorkOrderTypeId" class="form-label">Work Order Type</label>
                        <select class="form-select" id="WorkOrderTypeId" name="WorkOrderTypeId">
                            <option value="">All</option>
                            @foreach (var type in Model.WorkOrderTypes)
                            {
                                <option value="@type.Id" selected="@(Model.Filters.WorkOrderTypeId == type.Id ? "selected" : null)">@type.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="CreatorId" class="form-label">Creator</label>
                        <select class="form-select" id="CreatorId" name="CreatorId">
                            <option value="">All</option>
                            @foreach (var creator in Model.CreatorOptions)
                            {
                                <option value="@creator.Value" selected="@(Model.Filters.CreatorId == creator.Value ? "selected" : null)">@creator.Text</option>
                            }
                        </select>
                    </div>
                    @if (Model.PropertyOptions.Count > 1)
                    {
                        <div class="col-md-4">
                            <label for="PropertyId" class="form-label">Property</label>
                            <select class="form-select" id="PropertyId" name="PropertyId">
                                <option value="">All</option>
                            @foreach (var property in Model.PropertyOptions)
                            {
                                <option value="@property.Id" selected="@(Model.Filters.PropertyId == property.Id ? "selected" : null)">@property.Name (@property.Code)</option>
                            }
                            </select>
                        </div>
                    }
                    <div class="col-md-8">
                        <label for="Search" class="form-label">Keyword Search</label>
                        <input type="text" class="form-control" id="Search" name="Search" value="@Model.Filters.Search" placeholder="Search issue, details, or location" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                        <button type="submit" class="btn btn-primary">Apply Filters</button>
                    </div>
                    </form>
                </div>
            </div>
        </div>

        <div id="workorders-print-area">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <h5 class="mb-0">Work Orders (@Model.WorkOrders.Count)</h5>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="printWorkOrdersButton">
                            Print Current List
                        </button>
                        <a asp-action="Export"
                           asp-route-SortOrder="@Model.Filters.SortOrder"
                           asp-route-RoomNumber="@Model.Filters.RoomNumber"
                           asp-route-DepartmentId="@Model.Filters.DepartmentId"
                           asp-route-WorkOrderTypeId="@Model.Filters.WorkOrderTypeId"
                           asp-route-Status="@Model.Filters.Status"
                           asp-route-CreatorId="@Model.Filters.CreatorId"
                           asp-route-Search="@Model.Filters.Search"
                           asp-route-PropertyId="@Model.Filters.PropertyId"
                           class="btn btn-outline-success btn-sm">
                            Export to Excel
                        </a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Status</th>
                                <th>Location</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th>Issue</th>
                                <th>Due</th>
                                <th>Created</th>
                                <th>Creator</th>
                                <th>Property</th>
                                <th>Attachments</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.WorkOrders.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4">No work orders found. Adjust filters or create a new work order.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var order in Model.WorkOrders)
                                {
                                    var isPastDue = order.DueDate.Date < DateTime.Today;
                                    <tr style="border-left: 4px solid @order.StatusColor;">
                                        <td>
                                            <span class="badge" style="background-color:@order.StatusColor;">@order.Status</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@order.Location</div>
                                            @if (!string.IsNullOrWhiteSpace(order.Details))
                                            {
                                                <small class="text-muted">@Html.Raw(MentionMarkupFormatter.ToHtml(order.Details))</small>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(order.Department))
                                            {
                                                <span class="badge" style="background-color:@order.DepartmentColor;">@order.Department</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Unassigned</span>
                                            }
                                        </td>
                                        <td>@order.WorkOrderType</td>
                                        <td>@Html.Raw(MentionMarkupFormatter.ToHtml(order.Issue))</td>
                                        <td class="@(isPastDue ? "fw-bold text-danger" : string.Empty)">@order.DueDate.ToString("MMM dd, yyyy")</td>
                                        @{
                                            var createdLocal = TimeZoneService.ConvertToUserTime(order.CreatedAt);
                                        }
                                        <td>@createdLocal.ToString("MMM dd, yyyy")</td>
                                        <td>@(string.IsNullOrWhiteSpace(order.Creator) ? "Unknown" : order.Creator)</td>
                                        <td>
                                            @foreach (var property in order.Properties)
                                            {
                                                <div>@property</div>
                                            }
                                        </td>
                                        <td>
                                            @if (order.Attachments.Any())
                                            {
                                                foreach (var attachment in order.Attachments)
                                                {
                                                    <a href="@attachment.FilePath" target="_blank" class="d-block">@attachment.FileName</a>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">None</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4 col-xxl-3">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Create Work Order</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Form.Status" class="form-label"></label>
                        <select asp-for="Form.Status" class="form-select">
                            @foreach (var status in Model.StatusOptions)
                            {
                                <option value="@status.Key" selected="@(status.Key.Equals(Model.Form.Status, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@status.Label</option>
                            }
                        </select>
                        <span asp-validation-for="Form.Status" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Location" class="form-label"></label>
                        <input asp-for="Form.Location" class="form-control" list="locationSuggestions" placeholder="Room number or location" />
                        <datalist id="locationSuggestions">
                            @foreach (var suggestion in Model.LocationSuggestions)
                            {
                                <option value="@suggestion"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Form.Location" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.WorkOrderTypeId" class="form-label"></label>
                        <select asp-for="Form.WorkOrderTypeId" class="form-select">
                            <option value="">-- Select Type --</option>
                            @foreach (var type in Model.WorkOrderTypes)
                            {
                                <option value="@type.Id" selected="@(Model.Form.WorkOrderTypeId == type.Id ? "selected" : null)">@type.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Form.WorkOrderTypeId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Issue" class="form-label"></label>
                        <input asp-for="Form.Issue" class="form-control" placeholder="Short description" />
                        <span asp-validation-for="Form.Issue" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Details" class="form-label"></label>
                        <textarea asp-for="Form.Details" class="form-control" rows="3" placeholder="Additional details" data-enable-mentions="true"></textarea>
                        <span asp-validation-for="Form.Details" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="Form.DueDate" class="form-label"></label>
                            <input asp-for="Form.DueDate" class="form-control" type="date" />
                            <span asp-validation-for="Form.DueDate" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Form.DepartmentId" class="form-label"></label>
                            <select asp-for="Form.DepartmentId" class="form-select">
                                <option value="">-- Unassigned --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    <option value="@dept.Id" selected="@(Model.Form.DepartmentId == dept.Id ? "selected" : null)">@dept.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Form.DepartmentId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 mt-3">
                        <label asp-for="Form.Photos" class="form-label"></label>
                        <input asp-for="Form.Photos" class="form-control" type="file" accept="image/*" multiple />
                        <span class="form-text">Upload supporting photos (optional)</span>
                        <span asp-validation-for="Form.Photos" class="text-danger"></span>
                    </div>

                    @if (showPropertySelector)
                    {
                        <fieldset class="mb-3">
                            <legend class="fs-6">Properties</legend>
                            <span asp-validation-for="Form.SelectedPropertyIds" class="text-danger"></span>
                            @foreach (var property in Model.PropertyOptions)
                            {
                                <div class="form-check d-flex align-items-center gap-2 mb-2">
                                    <input class="form-check-input" type="checkbox" value="@property.Id" name="Form.SelectedPropertyIds" id="property_@property.Id" @(property.IsSelected ? "checked" : string.Empty) />
                                    <label class="form-check-label mb-0" for="property_@property.Id">@property.Name (@property.Code)</label>
                                </div>
                            }
                        </fieldset>
                    }
                    else if (Model.PropertyOptions.Count == 1)
                    {
                        <input type="hidden" name="Form.SelectedPropertyIds" value="@Model.PropertyOptions.First().Id" />
                        <div class="alert alert-info">
                            Work order will be created for <strong>@Model.PropertyOptions.First().Name (@Model.PropertyOptions.First().Code)</strong>.
                        </div>
                    }

                    <button type="submit" class="btn btn-primary w-100">Submit Work Order</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const printButton = document.getElementById('printWorkOrdersButton');
            if (printButton) {
                printButton.addEventListener('click', function () {
                    window.print();
                });
            }

            const filtersCollapse = document.getElementById('workOrdersFiltersCollapse');
            const filtersToggleButton = document.getElementById('toggleFiltersButton');

            if (filtersCollapse && filtersToggleButton) {
                const updateToggleText = () => {
                    const isExpanded = filtersCollapse.classList.contains('show');
                    filtersToggleButton.textContent = isExpanded ? 'Hide Filters' : 'Show Filters';
                };

                filtersCollapse.addEventListener('shown.bs.collapse', updateToggleText);
                filtersCollapse.addEventListener('hidden.bs.collapse', updateToggleText);
                updateToggleText();
            }
        })();
    </script>
}
