@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq
@model hOps.web.ViewModels.Documents.DocumentsIndexViewModel
@inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper<dynamic> Html
@{
    ViewData["Title"] = "Documents";
    ViewData["MainContainerClass"] = "main-inner--wide";
    var hasPropertyAccess = Model.HasPropertyAccess;
    var propertySelectList = Model.PropertyOptions
        .Select(option => new SelectListItem($"{option.Name} ({option.Code})", option.Id.ToString(), Model.Form.PropertyId == option.Id))
        .ToList();
    string FormatFolderLabel(hOps.web.ViewModels.Documents.DocumentFolderOptionViewModel option)
    {
        var prefix = option.Level > 0 ? $"{new string('-', option.Level * 2)} " : string.Empty;
        return $"{prefix}{option.Name}";
    }
    var folderSelectList = new List<SelectListItem>
    {
        new SelectListItem("-- No folder --", string.Empty, !Model.Form.FolderId.HasValue)
    };
    folderSelectList.AddRange(Model.FolderOptions
        .Select(option => new SelectListItem(FormatFolderLabel(option), option.Id.ToString(), option.IsSelected)));

    var parentFolderSelectList = new List<SelectListItem>
    {
        new SelectListItem("-- Top level --", string.Empty, !Model.FolderForm.ParentFolderId.HasValue)
    };
    parentFolderSelectList.AddRange(Model.FolderOptions
        .Select(option => new SelectListItem(FormatFolderLabel(option), option.Id.ToString(), Model.FolderForm.ParentFolderId == option.Id)));

    var selectedFolderId = Model.SelectedFolderId;
    var showingUnassignedOnly = Model.ShowingUnassignedOnly;
    int? currentFolderRouteValue = showingUnassignedOnly ? -1 : selectedFolderId;
    var currentFolderRouteValueString = showingUnassignedOnly ? "-1" : (selectedFolderId?.ToString() ?? string.Empty);
    var searchQuery = Model.SearchQuery ?? string.Empty;
    var hasSelectedFolder = Model.FolderSettingsForm != null;
    string SanitizeSortField(string? input)
    {
        var normalized = string.IsNullOrWhiteSpace(input) ? "uploaded" : input.Trim().ToLowerInvariant();
        return normalized switch
        {
            "name" => "name",
            "size" => "size",
            "shared" => "shared",
            "folder" => "folder",
            _ => "uploaded"
        };
    }
    string SanitizeSortDirection(string? input)
    {
        return string.Equals(input, "asc", StringComparison.OrdinalIgnoreCase) ? "asc" : "desc";
    }
    var safeSortField = SanitizeSortField(Model.SortField);
    var safeSortDirection = SanitizeSortDirection(Model.SortDirection);
    string GetNextDirection(string field) => string.Equals(Model.SortField, field, StringComparison.OrdinalIgnoreCase) && Model.SortDirection == "asc" ? "desc" : "asc";
    string GetSortIndicator(string field) => string.Equals(Model.SortField, field, StringComparison.OrdinalIgnoreCase) ? (Model.SortDirection == "asc" ? "\u25B2" : "\u25BC") : string.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Documents</h1>
</div>

@if (TempData["DocumentSuccess"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}
@if (TempData["DocumentError"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<div class="row g-4">
    <div class="col-lg-4 col-xxl-4">
        <div class="vstack gap-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Upload Document</h2>
                    <button class="btn btn-outline-secondary btn-sm"
                            type="button"
                            data-bs-toggle="collapse"
                            data-collapse-toggle="documents-upload-section"
                            data-bs-target="#documents-upload-section"
                            aria-expanded="true"
                            aria-controls="documents-upload-section">
                        <span class="collapse-toggle-text">Hide</span>
                    </button>
                </div>
                <div class="collapse show" id="documents-upload-section">
                    <div class="card-body">
                        <form asp-action="Upload" method="post" enctype="multipart/form-data" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="currentFolderId" value="@currentFolderRouteValueString" />
                            <input type="hidden" name="currentSort" value="@safeSortField" />
                            <input type="hidden" name="currentDirection" value="@safeSortDirection" />
                            <input type="hidden" name="currentSearch" value="@searchQuery" />
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="mb-3">
                                <label asp-for="Form.Title" class="form-label"></label>
                                <input asp-for="Form.Title" class="form-control" maxlength="150" />
                                <span asp-validation-for="Form.Title" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Form.File" class="form-label">File</label>
                                <input asp-for="Form.File" class="form-control" type="file" />
                                <span asp-validation-for="Form.File" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Form.Description" class="form-label"></label>
                                <textarea asp-for="Form.Description" class="form-control" rows="3" maxlength="2000"></textarea>
                                <span asp-validation-for="Form.Description" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Form.FolderId" class="form-label"></label>
                                <select asp-for="Form.FolderId" class="form-select" asp-items="folderSelectList"></select>
                                <span asp-validation-for="Form.FolderId" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label d-block">Who can download?</label>
                                <div class="vstack gap-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="Form.AccessScope" id="accessScopePropertyOnly" value="@((int)DocumentAccessScope.PropertyOnly)" @(Model.Form.AccessScope == DocumentAccessScope.PropertyOnly ? "checked" : string.Empty) @(hasPropertyAccess ? string.Empty : "disabled") />
                                        <label class="form-check-label" for="accessScopePropertyOnly">
                                            Users of a single property
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="Form.AccessScope" id="accessScopeSelected" value="@((int)DocumentAccessScope.SelectedProperties)" @(Model.Form.AccessScope == DocumentAccessScope.SelectedProperties ? "checked" : string.Empty) @(hasPropertyAccess ? string.Empty : "disabled") />
                                        <label class="form-check-label" for="accessScopeSelected">
                                            Users of selected properties
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="Form.AccessScope" id="accessScopeAll" value="@((int)DocumentAccessScope.AllUsers)" @(Model.Form.AccessScope == DocumentAccessScope.AllUsers ? "checked" : string.Empty) />
                                        <label class="form-check-label" for="accessScopeAll">
                                            All users
                                        </label>
                                    </div>
                                </div>
                                <span asp-validation-for="Form.AccessScope" class="text-danger"></span>
                                @if (!hasPropertyAccess)
                                {
                                    <div class="form-text">You do not have property access, so property-restricted options are unavailable.</div>
                                }
                            </div>

                            <div class="mb-3" id="propertyOnlyFields" style="display: none;">
                                <label asp-for="Form.PropertyId" class="form-label">Property</label>
                                <select asp-for="Form.PropertyId" class="form-select" asp-items="propertySelectList">
                                    <option value="">-- Select property --</option>
                                </select>
                                <span asp-validation-for="Form.PropertyId" class="text-danger"></span>
                            </div>

                            <div class="mb-3" id="selectedPropertiesFields" style="display: none;">
                                <span asp-validation-for="Form.SelectedPropertyIds" class="text-danger"></span>
                                @if (Model.PropertyOptions.Count == 0)
                                {
                                    <p class="text-muted mb-0">No properties available.</p>
                                }
                                else
                                {
                                    <div class="small text-muted mb-2">Select one or more properties.</div>
                                    <div class="vstack gap-2">
                                        @foreach (var option in Model.PropertyOptions)
                                        {
                                            var checkboxId = $"propertyOption_{option.Id}";
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="Form.SelectedPropertyIds" id="@checkboxId" value="@option.Id" @(option.IsSelected ? "checked" : string.Empty) />
                                                <label class="form-check-label" for="@checkboxId">@option.Name (@option.Code)</label>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Upload</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="h5 mb-0">Folders</h2>
                        <span class="badge bg-light text-dark">@Model.TotalDocumentCount</span>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm"
                            type="button"
                            data-bs-toggle="collapse"
                            data-collapse-toggle="documents-folders-section"
                            data-bs-target="#documents-folders-section"
                            aria-expanded="true"
                            aria-controls="documents-folders-section">
                        <span class="collapse-toggle-text">Hide</span>
                    </button>
                </div>
                <div class="collapse show" id="documents-folders-section">
                    <div class="card-body">
                        <div class="list-group list-group-flush mb-3">
                            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(selectedFolderId == null && !showingUnassignedOnly ? "active" : string.Empty)" asp-action="Index" asp-route-sort="@safeSortField" asp-route-direction="@safeSortDirection" asp-route-search="@searchQuery">
                                <span>All documents</span>
                                <span class="badge bg-secondary">@Model.TotalDocumentCount</span>
                            </a>
                            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(showingUnassignedOnly ? "active" : string.Empty)" asp-action="Index" asp-route-folderId="-1" asp-route-sort="@safeSortField" asp-route-direction="@safeSortDirection" asp-route-search="@searchQuery">
                                <span>No folder</span>
                                <span class="badge bg-secondary">@Model.UnassignedDocumentCount</span>
                            </a>
                            @if (Model.FolderTree.Count == 0)
                            {
                                <div class="list-group-item text-muted">No folders yet.</div>
                            }
                            else
                            {
                                foreach (var folder in Model.FolderTree)
                                {
                                    var padding = 1.5 + folder.Level * 0.75;
                                    var paddingStyle = $"{padding:0.##}rem";
                                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(folder.IsSelected ? "active" : string.Empty)"
                                       asp-action="Index"
                                       asp-route-folderId="@folder.Id"
                                       asp-route-sort="@safeSortField"
                                       asp-route-direction="@safeSortDirection"
                                       asp-route-search="@searchQuery"
                                       style="padding-left:@paddingStyle;">
                                        <span>@Html.Encode(folder.Name)</span>
                                        <span class="badge bg-secondary">@folder.DocumentCount</span>
                                    </a>
                                }
                            }
                        </div>
                        <h3 class="h6">Create Folder</h3>
                        <form asp-action="CreateFolder" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="currentFolderId" value="@currentFolderRouteValueString" />
                            <input type="hidden" name="currentSort" value="@safeSortField" />
                            <input type="hidden" name="currentDirection" value="@safeSortDirection" />
                            <input type="hidden" name="currentSearch" value="@searchQuery" />
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="mb-3">
                                <label asp-for="FolderForm.Name" class="form-label"></label>
                                <input asp-for="FolderForm.Name" class="form-control" maxlength="100" />
                                <span asp-validation-for="FolderForm.Name" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="FolderForm.ParentFolderId" class="form-label"></label>
                                <select asp-for="FolderForm.ParentFolderId" class="form-select" asp-items="parentFolderSelectList"></select>
                                <span asp-validation-for="FolderForm.ParentFolderId" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label d-block">Visibility</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="FolderForm.Visibility" id="folderVisibilityGlobal" value="@((int)hOps.web.Models.DocumentFolderVisibility.Global)" @(Model.FolderForm.Visibility == hOps.web.Models.DocumentFolderVisibility.Global ? "checked" : string.Empty) />
                                    <label class="form-check-label" for="folderVisibilityGlobal">
                                        All properties
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="FolderForm.Visibility" id="folderVisibilitySelected" value="@((int)hOps.web.Models.DocumentFolderVisibility.SelectedProperties)" @(Model.FolderForm.Visibility == hOps.web.Models.DocumentFolderVisibility.SelectedProperties ? "checked" : string.Empty) />
                                    <label class="form-check-label" for="folderVisibilitySelected">
                                        Only selected properties
                                    </label>
                                </div>
                                <span asp-validation-for="FolderForm.Visibility" class="text-danger"></span>
                            </div>
                            <div class="mb-3 @(Model.FolderForm.Visibility == hOps.web.Models.DocumentFolderVisibility.SelectedProperties ? string.Empty : "d-none")" id="folderVisibilityProperties">
                                <label class="form-label">Visible To</label>
                                @if (!Model.FolderPropertyOptions.Any())
                                {
                                    <p class="text-muted small mb-0">No accessible properties available.</p>
                                }
                                else
                                {
                                    foreach (var option in Model.FolderPropertyOptions)
                                    {
                                        var checkboxId = $"folderProperty_{option.Id}";
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="@option.Id" name="FolderForm.SelectedPropertyIds" id="@checkboxId" @(option.IsSelected ? "checked" : string.Empty) />
                                            <label class="form-check-label" for="@checkboxId">@option.Name (@option.Code)</label>
                                        </div>
                                    }
                                }
                                <span asp-validation-for="FolderForm.SelectedPropertyIds" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-outline-primary w-100">Create Folder</button>
                        </form>
                    </div>
                </div>
            </div>

            @if (hasSelectedFolder && Model.FolderSettingsForm != null)
            {
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h2 class="h5 mb-0">Manage Folder</h2>
                        <button class="btn btn-outline-secondary btn-sm"
                                type="button"
                                data-bs-toggle="collapse"
                                data-collapse-toggle="documents-manage-section"
                                data-bs-target="#documents-manage-section"
                                aria-expanded="true"
                                aria-controls="documents-manage-section">
                            <span class="collapse-toggle-text">Hide</span>
                        </button>
                    </div>
                    <div class="collapse show" id="documents-manage-section">
                        <div class="card-body">
                            <form asp-action="UpdateFolderSettings" method="post" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="FolderSettingsForm.FolderId" value="@Model.FolderSettingsForm.FolderId" />
                                <input type="hidden" name="currentFolderId" value="@currentFolderRouteValueString" />
                                <input type="hidden" name="currentSort" value="@safeSortField" />
                                <input type="hidden" name="currentDirection" value="@safeSortDirection" />
                                <input type="hidden" name="currentSearch" value="@searchQuery" />
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="mb-3">
                                    <label asp-for="FolderSettingsForm.Name" class="form-label"></label>
                                    <input asp-for="FolderSettingsForm.Name" class="form-control" />
                                    <span asp-validation-for="FolderSettingsForm.Name" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label d-block">Visibility</label>
                                    <div class="vstack gap-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="FolderSettingsForm.Visibility" id="folderSettingsVisibilityGlobal" value="@((int)DocumentFolderVisibility.Global)" @(Model.FolderSettingsForm.Visibility == DocumentFolderVisibility.Global ? "checked" : string.Empty) />
                                            <label class="form-check-label" for="folderSettingsVisibilityGlobal">Visible to all users</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="FolderSettingsForm.Visibility" id="folderSettingsVisibilitySelected" value="@((int)DocumentFolderVisibility.SelectedProperties)" @(Model.FolderSettingsForm.Visibility == DocumentFolderVisibility.SelectedProperties ? "checked" : string.Empty) />
                                            <label class="form-check-label" for="folderSettingsVisibilitySelected">Visible to selected properties</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3 @(Model.FolderSettingsForm.Visibility == DocumentFolderVisibility.SelectedProperties ? string.Empty : "d-none")" id="folderSettingsVisibilityProperties">
                                    <label class="form-label">Visible To</label>
                                    <div class="vstack gap-2">
                                        @if (!Model.SelectedFolderPropertyOptions.Any())
                                        {
                                            <p class="text-muted small mb-0">Grant yourself access to at least one property to restrict folders.</p>
                                        }
                                        else
                                        {
                                            foreach (var option in Model.SelectedFolderPropertyOptions)
                                            {
                                                var checkboxId = $"selectedFolderProperty_{option.Id}";
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" value="@option.Id" name="FolderSettingsForm.SelectedPropertyIds" id="@checkboxId" @(option.IsSelected ? "checked" : string.Empty) />
                                                    <label class="form-check-label" for="@checkboxId">@option.Name (@option.Code)</label>
                                                </div>
                                            }
                                        }
                                    </div>
                                    <span asp-validation-for="FolderSettingsForm.SelectedPropertyIds" class="text-danger"></span>
                                </div>
                                <input type="hidden" name="FolderSettingsForm.ApplyToDocuments" value="false" />
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="folderSettingsApply" name="FolderSettingsForm.ApplyToDocuments" value="true" @(Model.FolderSettingsForm.ApplyToDocuments ? "checked" : string.Empty) />
                                    <label class="form-check-label" for="folderSettingsApply">Update all documents in this folder to use this visibility</label>
                                </div>
                                <button type="submit" class="btn btn-primary w-100">Save Changes</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-8 col-xxl-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <h2 class="h5 mb-0">Available Documents</h2>
                    <span class="badge bg-light text-dark">@Model.Documents.Count document@(Model.Documents.Count == 1 ? string.Empty : "s")</span>
                </div>
                <nav aria-label="Folder path" class="flex-grow-1">
                    <ol class="breadcrumb mb-0 small">
                        @foreach (var crumb in Model.SelectedFolderBreadcrumb)
                        {
                            var routeFolderId = crumb.FolderId;
                            <li class="breadcrumb-item @(crumb.IsCurrent ? "active" : string.Empty)">
                                @if (crumb.IsCurrent)
                                {
                                    <span>@crumb.Name</span>
                                }
                                else
                                {
                                    <a asp-action="Index"
                                       asp-route-folderId="@(routeFolderId == null ? null : routeFolderId)"
                                       asp-route-sort="@safeSortField"
                                       asp-route-direction="@safeSortDirection"
                                       asp-route-search="@searchQuery">
                                        @crumb.Name
                                    </a>
                                }
                            </li>
                        }
                    </ol>
                </nav>
            </div>
            <div class="card-body">
                <form class="row g-2 align-items-center mb-3" method="get" asp-action="Index">
                    <input type="hidden" name="folderId" value="@currentFolderRouteValueString" />
                    <input type="hidden" name="sort" value="@safeSortField" />
                    <input type="hidden" name="direction" value="@safeSortDirection" />
                    <div class="col-md">
                        <label for="documentsSearch" class="form-label visually-hidden">Search documents</label>
                        <input id="documentsSearch" class="form-control" type="search" name="search" value="@searchQuery" placeholder="Search by name, description, or folder" />
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button type="submit" class="btn btn-outline-primary">Search</button>
                        @if (!string.IsNullOrWhiteSpace(searchQuery))
                        {
                            <a class="btn btn-link" asp-action="Index" asp-route-folderId="@currentFolderRouteValueString" asp-route-sort="@safeSortField" asp-route-direction="@safeSortDirection">Clear</a>
                        }
                    </div>
                </form>
                @if (Model.Documents.Count == 0 && !Model.ChildFolders.Any())
                {
                    <p class="text-muted mb-0">No documents have been uploaded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">
                                        <a asp-action="Index"
                                           asp-route-folderId="@(showingUnassignedOnly ? -1 : selectedFolderId)"
                                           asp-route-sort="name"
                                           asp-route-direction="@GetNextDirection("name")"
                                           asp-route-search="@searchQuery"
                                           class="text-decoration-none text-reset">
                                            Document
                                            <span class="ms-1 text-muted small">@GetSortIndicator("name")</span>
                                        </a>
                                    </th>
                                    <th scope="col">
                                        <a asp-action="Index"
                                           asp-route-folderId="@(showingUnassignedOnly ? -1 : selectedFolderId)"
                                           asp-route-sort="shared"
                                           asp-route-direction="@GetNextDirection("shared")"
                                           asp-route-search="@searchQuery"
                                           class="text-decoration-none text-reset">
                                            Shared With
                                            <span class="ms-1 text-muted small">@GetSortIndicator("shared")</span>
                                        </a>
                                    </th>
                                    <th scope="col" class="text-end">
                                        <a asp-action="Index"
                                           asp-route-folderId="@(showingUnassignedOnly ? -1 : selectedFolderId)"
                                           asp-route-sort="uploaded"
                                           asp-route-direction="@GetNextDirection("uploaded")"
                                           asp-route-search="@searchQuery"
                                           class="text-decoration-none text-reset">
                                            Uploaded
                                            <span class="ms-1 text-muted small">@GetSortIndicator("uploaded")</span>
                                        </a>
                                    </th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ChildFolders.Any())
                                {
                                    foreach (var child in Model.ChildFolders)
                                    {
                                        <tr class="table-light">
                                            <td colspan="2">
                                                <a asp-action="Index"
                                                   asp-route-folderId="@child.Id"
                                                   asp-route-sort="@safeSortField"
                                                   asp-route-direction="@safeSortDirection"
                                                   asp-route-search="@Html.Encode(searchQuery)"
                                                   class="text-decoration-none text-reset">
                                                    <span class="me-2" aria-hidden="true">📁</span><strong>@child.Name</strong>
                                                </a>
                                                <div class="text-muted small">@child.DisplayPath</div>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-secondary">@child.DocumentCount</span>
                                            </td>
                                            <td class="text-end">
                                                <a class="btn btn-outline-secondary btn-sm"
                                                   asp-action="Index"
                                                   asp-route-folderId="@child.Id"
                                                   asp-route-sort="@safeSortField"
                                                   asp-route-direction="@safeSortDirection"
                                                   asp-route-search="@Html.Encode(searchQuery)">
                                                    Open
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                @foreach (var doc in Model.Documents)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@doc.DisplayName</div>
                                            <div class="text-muted small">@doc.OriginalFileName</div>
                                            <div class="text-muted small">@doc.FileSizeDisplay</div>
                                            @if (!string.IsNullOrWhiteSpace(doc.FolderPath))
                                            {
                                                <div class="text-muted small">Folder: @doc.FolderPath</div>
                                            }
                                            else
                                            {
                                                <div class="text-muted small">Folder: (no folder)</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(doc.Description))
                                            {
                                                <div class="text-muted small">Notes: @doc.Description</div>
                                            }
                                        </td>
                                        <td>
                                            <div>@doc.AccessSummary</div>
                                            @if (doc.TargetProperties.Count > 0)
                                            {
                                                <ul class="list-unstyled mb-0 small text-muted">
                                                    @foreach (var propertyLabel in doc.TargetProperties)
                                                    {
                                                        <li>@propertyLabel</li>
                                                    }
                                                </ul>
                                            }
                                        </td>
                                        @{
                                            var uploadedLocal = TimeZoneService.ConvertToUserTime(doc.UploadedAtUtc);
                                        }
                                        <td class="text-end">
                                            <div>@uploadedLocal.ToString("g")</div>
                                            <div class="text-muted small">@doc.UploadedByDisplayName</div>
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-outline-primary btn-sm" asp-action="Download" asp-route-id="@doc.Id">Download</a>
                                            <form asp-action="Move"
                                                  method="post"
                                                  class="d-inline-flex align-items-center gap-2 ms-2"
                                                  style="flex-wrap: wrap;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@doc.Id" />
                                                <input type="hidden" name="currentFolderId" value="@currentFolderRouteValueString" />
                                                <input type="hidden" name="currentSort" value="@safeSortField" />
                                                <input type="hidden" name="currentDirection" value="@safeSortDirection" />
                                                <input type="hidden" name="currentSearch" value="@searchQuery" />
                                                @{
                                                    var moveFolderItems = Model.FolderOptions
                                                        .Select(option => new SelectListItem(FormatFolderLabel(option), option.Id.ToString(), doc.FolderId == option.Id))
                                                        .ToList();
                                                    moveFolderItems.Insert(0, new SelectListItem("No folder", string.Empty, !doc.FolderId.HasValue));
                                                }
                                                @Html.DropDownList("folderId", moveFolderItems, new { @class = "form-select form-select-sm w-auto" })
                                                <button type="submit" class="btn btn-outline-secondary btn-sm">Move</button>
                                            </form>
                                            <button class="btn btn-outline-secondary btn-sm mt-2" type="button" data-bs-toggle="collapse" data-bs-target="#docVisibility-@doc.Id" aria-expanded="false" aria-controls="docVisibility-@doc.Id">
                                                Edit Visibility
                                            </button>
                                            <div class="collapse mt-2 text-start" id="docVisibility-@doc.Id">
                                            <form asp-action="UpdateDocumentVisibility" method="post" class="doc-visibility-form border rounded p-2 bg-light-subtle">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="DocumentId" value="@doc.Id" />
                                                <input type="hidden" name="currentFolderId" value="@currentFolderRouteValueString" />
                                                <input type="hidden" name="currentSort" value="@safeSortField" />
                                                <input type="hidden" name="currentDirection" value="@safeSortDirection" />
                                                <input type="hidden" name="currentSearch" value="@searchQuery" />
                                                <div class="mb-2">
                                                    <label class="form-label d-block mb-1">Visibility</label>
                                                    <div class="vstack gap-1">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" name="AccessScope" id="docVisibilityAll-@doc.Id" value="@((int)DocumentAccessScope.AllUsers)" @(doc.AccessScope == DocumentAccessScope.AllUsers ? "checked" : string.Empty) />
                                                            <label class="form-check-label" for="docVisibilityAll-@doc.Id">All users</label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" name="AccessScope" id="docVisibilityProperty-@doc.Id" value="@((int)DocumentAccessScope.PropertyOnly)" @(doc.AccessScope == DocumentAccessScope.PropertyOnly ? "checked" : string.Empty) />
                                                            <label class="form-check-label" for="docVisibilityProperty-@doc.Id">Single property</label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" name="AccessScope" id="docVisibilitySelected-@doc.Id" value="@((int)DocumentAccessScope.SelectedProperties)" @(doc.AccessScope == DocumentAccessScope.SelectedProperties ? "checked" : string.Empty) />
                                                            <label class="form-check-label" for="docVisibilitySelected-@doc.Id">Selected properties</label>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mb-2 doc-visibility-single">
                                                    <label class="form-label" for="docVisibilityPropertySelect-@doc.Id">Property</label>
                                                    <select class="form-select form-select-sm" id="docVisibilityPropertySelect-@doc.Id" name="PropertyId">
                                                        <option value="">Select property</option>
                                                        @foreach (var option in Model.PropertyOptions)
                                                        {
                                                            <option value="@option.Id" selected="@(doc.AccessPropertyId == option.Id ? "selected" : null)">@option.Name (@option.Code)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="mb-2 doc-visibility-multi">
                                                    <label class="form-label" for="docVisibilityMultiSelect-@doc.Id">Visible To</label>
                                                    @if (!Model.PropertyOptions.Any())
                                                    {
                                                        <p class="text-muted small mb-0">No properties available.</p>
                                                    }
                                                    else
                                                    {
                                                        <select class="form-select form-select-sm" id="docVisibilityMultiSelect-@doc.Id" name="SelectedPropertyIds" multiple size="@(Math.Min(Model.PropertyOptions.Count, 6))">
                                                            @foreach (var option in Model.PropertyOptions)
                                                            {
                                                                <option value="@option.Id" selected="@(doc.TargetPropertyIds.Contains(option.Id) ? "selected" : null)">@option.Name (@option.Code)</option>
                                                            }
                                                        </select>
                                                    }
                                                </div>
                                                <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                            </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const propertyOnlyFields = document.getElementById('propertyOnlyFields');
            const selectedPropertiesFields = document.getElementById('selectedPropertiesFields');
            const folderVisibilityFields = document.getElementById('folderVisibilityProperties');
            const folderSettingsFields = document.getElementById('folderSettingsVisibilityProperties');

            document.querySelectorAll('[data-collapse-toggle]').forEach(button => {
                const targetId = button.getAttribute('data-collapse-toggle');
                if (!targetId) {
                    return;
                }
                const target = document.getElementById(targetId);
                if (!target) {
                    return;
                }
                const textNode = button.querySelector('.collapse-toggle-text');
                const updateLabel = () => {
                    if (!textNode) {
                        return;
                    }
                    const isExpanded = target.classList.contains('show');
                    textNode.textContent = isExpanded ? 'Hide' : 'Show';
                };
                target.addEventListener('shown.bs.collapse', updateLabel);
                target.addEventListener('hidden.bs.collapse', updateLabel);
                updateLabel();
            });

            function updateVisibility() {
                const selectedValue = document.querySelector('input[name="Form.AccessScope"]:checked')?.value;
                const scope = parseInt(selectedValue ?? '-1');

                if (propertyOnlyFields) {
                    propertyOnlyFields.style.display = scope === @((int)DocumentAccessScope.PropertyOnly) ? 'block' : 'none';
                }

                if (selectedPropertiesFields) {
                    selectedPropertiesFields.style.display = scope === @((int)DocumentAccessScope.SelectedProperties) ? 'block' : 'none';
                }
            }

            document.querySelectorAll('input[name="Form.AccessScope"]').forEach(radio => {
                radio.addEventListener('change', updateVisibility);
            });

            updateVisibility();

            const folderVisibilityRadios = document.querySelectorAll('input[name="FolderForm.Visibility"]');
            function updateFolderVisibility() {
                if (!folderVisibilityFields) {
                    return;
                }
                const selectedValue = document.querySelector('input[name="FolderForm.Visibility"]:checked')?.value;
                const visibility = parseInt(selectedValue ?? '-1');
                if (visibility === @((int)hOps.web.Models.DocumentFolderVisibility.SelectedProperties)) {
                    folderVisibilityFields.classList.remove('d-none');
                } else {
                    folderVisibilityFields.classList.add('d-none');
                }
            }

            folderVisibilityRadios.forEach(radio => radio.addEventListener('change', updateFolderVisibility));
            updateFolderVisibility();

            function updateFolderSettingsVisibility() {
                if (!folderSettingsFields) {
                    return;
                }
                const selectedValue = document.querySelector('input[name="FolderSettingsForm.Visibility"]:checked')?.value;
                const visibility = parseInt(selectedValue ?? '-1');
                if (visibility === @((int)hOps.web.Models.DocumentFolderVisibility.SelectedProperties)) {
                    folderSettingsFields.classList.remove('d-none');
                } else {
                    folderSettingsFields.classList.add('d-none');
                }
            }

            document.querySelectorAll('input[name="FolderSettingsForm.Visibility"]').forEach(radio => {
                radio.addEventListener('change', updateFolderSettingsVisibility);
            });
            updateFolderSettingsVisibility();

            const docScopeProperty = '@((int)DocumentAccessScope.PropertyOnly)';
            const docScopeSelected = '@((int)DocumentAccessScope.SelectedProperties)';

            function toggleField(element, shouldShow) {
                if (!element) {
                    return;
                }
                if (shouldShow) {
                    element.classList.remove('d-none');
                } else {
                    element.classList.add('d-none');
                }
            }

            document.querySelectorAll('.doc-visibility-form').forEach(form => {
                const singleField = form.querySelector('.doc-visibility-single');
                const multiField = form.querySelector('.doc-visibility-multi');
                const radios = form.querySelectorAll('input[name="AccessScope"]');

                const updateDocVisibilityFields = () => {
                    const selectedValue = form.querySelector('input[name="AccessScope"]:checked')?.value;
                    toggleField(singleField, selectedValue === docScopeProperty);
                    toggleField(multiField, selectedValue === docScopeSelected);
                };

                radios.forEach(radio => radio.addEventListener('change', updateDocVisibilityFields));
                updateDocVisibilityFields();
            });
        })();
    </script>
}
