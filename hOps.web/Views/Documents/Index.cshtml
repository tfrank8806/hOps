@using Microsoft.AspNetCore.Mvc.Rendering
@model hOps.web.ViewModels.Documents.DocumentsIndexViewModel
@inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper<dynamic> Html
@{
    ViewData["Title"] = "Documents";
    ViewData["MainContainerClass"] = "main-inner--wide";
    var hasPropertyAccess = Model.HasPropertyAccess;
    var propertySelectList = Model.PropertyOptions
        .Select(option => new SelectListItem($"{option.Name} ({option.Code})", option.Id.ToString(), Model.Form.PropertyId == option.Id))
        .ToList();
    string FormatFolderLabel(hOps.web.ViewModels.Documents.DocumentFolderOptionViewModel option)
    {
        var prefix = option.Level > 0 ? $"{new string('-', option.Level * 2)} " : string.Empty;
        return $"{prefix}{option.Name}";
    }
    var folderSelectList = new List<SelectListItem>
    {
        new SelectListItem("-- No folder --", string.Empty, !Model.Form.FolderId.HasValue)
    };
    folderSelectList.AddRange(Model.FolderOptions
        .Select(option => new SelectListItem(FormatFolderLabel(option), option.Id.ToString(), option.IsSelected)));

    var parentFolderSelectList = new List<SelectListItem>
    {
        new SelectListItem("-- Top level --", string.Empty, !Model.FolderForm.ParentFolderId.HasValue)
    };
    parentFolderSelectList.AddRange(Model.FolderOptions
        .Select(option => new SelectListItem(FormatFolderLabel(option), option.Id.ToString(), Model.FolderForm.ParentFolderId == option.Id)));

    var selectedFolderId = Model.SelectedFolderId;
    var showingUnassignedOnly = Model.ShowingUnassignedOnly;
    int? currentFolderRouteValue = showingUnassignedOnly ? -1 : selectedFolderId;
    string GetNextDirection(string field) => string.Equals(Model.SortField, field, StringComparison.OrdinalIgnoreCase) && Model.SortDirection == "asc" ? "desc" : "asc";
    string GetSortIndicator(string field) => string.Equals(Model.SortField, field, StringComparison.OrdinalIgnoreCase) ? (Model.SortDirection == "asc" ? "\u25B2" : "\u25BC") : string.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Documents</h1>
</div>

@if (TempData["DocumentSuccess"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}
@if (TempData["DocumentError"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<div class="row g-4">
    <div class="col-xxl-4">
        <div class="vstack gap-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Folders</h2>
                    <span class="badge bg-light text-dark">@Model.TotalDocumentCount</span>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush mb-3">
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(selectedFolderId == null && !showingUnassignedOnly ? "active" : string.Empty)" asp-action="Index" asp-route-sort="@Model.SortField" asp-route-direction="@Model.SortDirection">
                            <span>All documents</span>
                            <span class="badge bg-secondary">@Model.TotalDocumentCount</span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(showingUnassignedOnly ? "active" : string.Empty)" asp-action="Index" asp-route-folderId="-1" asp-route-sort="@Model.SortField" asp-route-direction="@Model.SortDirection">
                            <span>No folder</span>
                            <span class="badge bg-secondary">@Model.UnassignedDocumentCount</span>
                        </a>
                        @if (Model.FolderTree.Count == 0)
                        {
                            <div class="list-group-item text-muted">No folders yet.</div>
                        }
                        else
                        {
                            foreach (var folder in Model.FolderTree)
                            {
                                var padding = 1.5 + folder.Level * 0.75;
                                var paddingStyle = $"{padding:0.##}rem";
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(folder.IsSelected ? "active" : string.Empty)"
                                   asp-action="Index"
                                   asp-route-folderId="@folder.Id"
                                   asp-route-sort="@Model.SortField"
                                   asp-route-direction="@Model.SortDirection"
                                   style="padding-left:@paddingStyle;">
                                    <span>@Html.Encode(folder.Name)</span>
                                    <span class="badge bg-secondary">@folder.DocumentCount</span>
                                </a>
                            }
                        }
                    </div>
                    <h3 class="h6">Create Folder</h3>
                    <form asp-action="CreateFolder" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="currentFolderId" value="@(showingUnassignedOnly ? "-1" : (selectedFolderId?.ToString() ?? string.Empty))" />
                        <input type="hidden" name="currentSort" value="@Model.SortField" />
                        <input type="hidden" name="currentDirection" value="@Model.SortDirection" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="FolderForm.Name" class="form-label"></label>
                            <input asp-for="FolderForm.Name" class="form-control" maxlength="100" />
                            <span asp-validation-for="FolderForm.Name" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="FolderForm.ParentFolderId" class="form-label"></label>
                            <select asp-for="FolderForm.ParentFolderId" class="form-select" asp-items="parentFolderSelectList"></select>
                            <span asp-validation-for="FolderForm.ParentFolderId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-block">Visibility</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="FolderForm.Visibility" id="folderVisibilityGlobal" value="@((int)hOps.web.Models.DocumentFolderVisibility.Global)" @(Model.FolderForm.Visibility == hOps.web.Models.DocumentFolderVisibility.Global ? "checked" : string.Empty) />
                                <label class="form-check-label" for="folderVisibilityGlobal">
                                    All properties
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="FolderForm.Visibility" id="folderVisibilitySelected" value="@((int)hOps.web.Models.DocumentFolderVisibility.SelectedProperties)" @(Model.FolderForm.Visibility == hOps.web.Models.DocumentFolderVisibility.SelectedProperties ? "checked" : string.Empty) />
                                <label class="form-check-label" for="folderVisibilitySelected">
                                    Only selected properties
                                </label>
                            </div>
                            <span asp-validation-for="FolderForm.Visibility" class="text-danger"></span>
                        </div>
                        <div class="mb-3 @(Model.FolderForm.Visibility == hOps.web.Models.DocumentFolderVisibility.SelectedProperties ? string.Empty : "d-none")" id="folderVisibilityProperties">
                            <label class="form-label">Visible To</label>
                            @if (!Model.FolderPropertyOptions.Any())
                            {
                                <p class="text-muted small mb-0">No accessible properties available.</p>
                            }
                            else
                            {
                                foreach (var option in Model.FolderPropertyOptions)
                                {
                                    var checkboxId = $"folderProperty_{option.Id}";
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="@option.Id" name="FolderForm.SelectedPropertyIds" id="@checkboxId" @(option.IsSelected ? "checked" : string.Empty) />
                                        <label class="form-check-label" for="@checkboxId">@option.Name (@option.Code)</label>
                                    </div>
                                }
                            }
                            <span asp-validation-for="FolderForm.SelectedPropertyIds" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-outline-primary w-100">Create Folder</button>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h2 class="h5 mb-0">Upload Document</h2>
                </div>
                <div class="card-body">
                    <form asp-action="Upload" method="post" enctype="multipart/form-data" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="currentFolderId" value="@(showingUnassignedOnly ? "-1" : (selectedFolderId?.ToString() ?? string.Empty))" />
                        <input type="hidden" name="currentSort" value="@Model.SortField" />
                        <input type="hidden" name="currentDirection" value="@Model.SortDirection" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Form.Title" class="form-label"></label>
                            <input asp-for="Form.Title" class="form-control" maxlength="150" />
                            <span asp-validation-for="Form.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.File" class="form-label">File</label>
                            <input asp-for="Form.File" class="form-control" type="file" />
                            <span asp-validation-for="Form.File" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.Description" class="form-label"></label>
                            <textarea asp-for="Form.Description" class="form-control" rows="3" maxlength="2000"></textarea>
                            <span asp-validation-for="Form.Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.FolderId" class="form-label"></label>
                            <select asp-for="Form.FolderId" class="form-select" asp-items="folderSelectList"></select>
                            <span asp-validation-for="Form.FolderId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-block">Who can download?</label>
                            <div class="vstack gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="Form.AccessScope" id="accessScopePropertyOnly" value="@((int)DocumentAccessScope.PropertyOnly)" @(Model.Form.AccessScope == DocumentAccessScope.PropertyOnly ? "checked" : string.Empty) @(hasPropertyAccess ? string.Empty : "disabled") />
                                    <label class="form-check-label" for="accessScopePropertyOnly">
                                        Users of a single property
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="Form.AccessScope" id="accessScopeSelected" value="@((int)DocumentAccessScope.SelectedProperties)" @(Model.Form.AccessScope == DocumentAccessScope.SelectedProperties ? "checked" : string.Empty) @(hasPropertyAccess ? string.Empty : "disabled") />
                                    <label class="form-check-label" for="accessScopeSelected">
                                        Users of selected properties
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="Form.AccessScope" id="accessScopeAll" value="@((int)DocumentAccessScope.AllUsers)" @(Model.Form.AccessScope == DocumentAccessScope.AllUsers ? "checked" : string.Empty) />
                                    <label class="form-check-label" for="accessScopeAll">
                                        All users
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Form.AccessScope" class="text-danger"></span>
                            @if (!hasPropertyAccess)
                            {
                                <div class="form-text">You do not have property access, so property-restricted options are unavailable.</div>
                            }
                        </div>

                        <div class="mb-3" id="propertyOnlyFields" style="display: none;">
                            <label asp-for="Form.PropertyId" class="form-label">Property</label>
                            <select asp-for="Form.PropertyId" class="form-select" asp-items="propertySelectList">
                                <option value="">-- Select property --</option>
                            </select>
                            <span asp-validation-for="Form.PropertyId" class="text-danger"></span>
                        </div>

                        <div class="mb-3" id="selectedPropertiesFields" style="display: none;">
                            <span asp-validation-for="Form.SelectedPropertyIds" class="text-danger"></span>
                            @if (Model.PropertyOptions.Count == 0)
                            {
                                <p class="text-muted mb-0">No properties available.</p>
                            }
                            else
                            {
                                <div class="small text-muted mb-2">Select one or more properties.</div>
                                <div class="vstack gap-2">
                                    @foreach (var option in Model.PropertyOptions)
                                    {
                                        var checkboxId = $"propertyOption_{option.Id}";
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="Form.SelectedPropertyIds" id="@checkboxId" value="@option.Id" @(option.IsSelected ? "checked" : string.Empty) />
                                            <label class="form-check-label" for="@checkboxId">@option.Name (@option.Code)</label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Upload</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Available Documents</h2>
                <span class="badge bg-light text-dark">@Model.Documents.Count document@(Model.Documents.Count == 1 ? string.Empty : "s")</span>
            </div>
            <div class="card-body">
                @if (Model.Documents.Count == 0 && !Model.ChildFolders.Any())
                {
                    <p class="text-muted mb-0">No documents have been uploaded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">
                                        <a asp-action="Index"
                                           asp-route-folderId="@(showingUnassignedOnly ? -1 : selectedFolderId)"
                                           asp-route-sort="name"
                                           asp-route-direction="@GetNextDirection("name")"
                                           class="text-decoration-none text-reset">
                                            Document
                                            <span class="ms-1 text-muted small">@GetSortIndicator("name")</span>
                                        </a>
                                    </th>
                                    <th scope="col">
                                        <a asp-action="Index"
                                           asp-route-folderId="@(showingUnassignedOnly ? -1 : selectedFolderId)"
                                           asp-route-sort="shared"
                                           asp-route-direction="@GetNextDirection("shared")"
                                           class="text-decoration-none text-reset">
                                            Shared With
                                            <span class="ms-1 text-muted small">@GetSortIndicator("shared")</span>
                                        </a>
                                    </th>
                                    <th scope="col" class="text-end">
                                        <a asp-action="Index"
                                           asp-route-folderId="@(showingUnassignedOnly ? -1 : selectedFolderId)"
                                           asp-route-sort="uploaded"
                                           asp-route-direction="@GetNextDirection("uploaded")"
                                           class="text-decoration-none text-reset">
                                            Uploaded
                                            <span class="ms-1 text-muted small">@GetSortIndicator("uploaded")</span>
                                        </a>
                                    </th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ChildFolders.Any())
                                {
                                    foreach (var child in Model.ChildFolders)
                                    {
                                        <tr class="table-light">
                                            <td colspan="2">
                                                <a asp-action="Index"
                                                   asp-route-folderId="@child.Id"
                                                   asp-route-sort="@Html.Encode(Model.SortField)"
                                                   asp-route-direction="@Html.Encode(Model.SortDirection)"
                                                   class="text-decoration-none text-reset">
                                                    <span class="me-2" aria-hidden="true">📁</span><strong>@child.Name</strong>
                                                </a>
                                                <div class="text-muted small">@child.DisplayPath</div>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-secondary">@child.DocumentCount</span>
                                            </td>
                                            <td class="text-end">
                                                <a class="btn btn-outline-secondary btn-sm"
                                                   asp-action="Index"
                                                   asp-route-folderId="@child.Id"
                                                   asp-route-sort="@Html.Encode(Model.SortField)"
                                                   asp-route-direction="@Html.Encode(Model.SortDirection)">
                                                    Open
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                @foreach (var doc in Model.Documents)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@doc.DisplayName</div>
                                            <div class="text-muted small">@doc.OriginalFileName</div>
                                            <div class="text-muted small">@doc.FileSizeDisplay</div>
                                            @if (!string.IsNullOrWhiteSpace(doc.FolderPath))
                                            {
                                                <div class="text-muted small">Folder: @doc.FolderPath</div>
                                            }
                                            else
                                            {
                                                <div class="text-muted small">Folder: (no folder)</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(doc.Description))
                                            {
                                                <div class="text-muted small">Notes: @doc.Description</div>
                                            }
                                        </td>
                                        <td>
                                            <div>@doc.AccessSummary</div>
                                            @if (doc.TargetProperties.Count > 0)
                                            {
                                                <ul class="list-unstyled mb-0 small text-muted">
                                                    @foreach (var propertyLabel in doc.TargetProperties)
                                                    {
                                                        <li>@propertyLabel</li>
                                                    }
                                                </ul>
                                            }
                                        </td>
                                        @{
                                            var uploadedLocal = TimeZoneService.ConvertToUserTime(doc.UploadedAtUtc);
                                        }
                                        <td class="text-end">
                                            <div>@uploadedLocal.ToString("g")</div>
                                            <div class="text-muted small">@doc.UploadedByDisplayName</div>
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-outline-primary btn-sm" asp-action="Download" asp-route-id="@doc.Id">Download</a>
                                            <form asp-action="Move"
                                                  method="post"
                                                  class="d-inline-flex align-items-center gap-2 ms-2"
                                                  style="flex-wrap: wrap;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@doc.Id" />
                                                <input type="hidden" name="currentFolderId" value="@(currentFolderRouteValue?.ToString() ?? string.Empty)" />
                                                <input type="hidden" name="currentSort" value="@Model.SortField" />
                                                <input type="hidden" name="currentDirection" value="@Model.SortDirection" />
                                                @{
                                                    var moveFolderItems = Model.FolderOptions
                                                        .Select(option => new SelectListItem(FormatFolderLabel(option), option.Id.ToString(), doc.FolderId == option.Id))
                                                        .ToList();
                                                    moveFolderItems.Insert(0, new SelectListItem("No folder", string.Empty, !doc.FolderId.HasValue));
                                                }
                                                @Html.DropDownList("folderId", moveFolderItems, new { @class = "form-select form-select-sm w-auto" })
                                                <button type="submit" class="btn btn-outline-secondary btn-sm">Move</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const propertyOnlyFields = document.getElementById('propertyOnlyFields');
            const selectedPropertiesFields = document.getElementById('selectedPropertiesFields');
            const folderVisibilityFields = document.getElementById('folderVisibilityProperties');

            function updateVisibility() {
                const selectedValue = document.querySelector('input[name="Form.AccessScope"]:checked')?.value;
                const scope = parseInt(selectedValue ?? '-1');

                if (scope === @((int)DocumentAccessScope.PropertyOnly)) {
                    propertyOnlyFields.style.display = 'block';
                } else {
                    propertyOnlyFields.style.display = 'none';
                }

                if (scope === @((int)DocumentAccessScope.SelectedProperties)) {
                    selectedPropertiesFields.style.display = 'block';
                } else {
                    selectedPropertiesFields.style.display = 'none';
                }
            }

            document.querySelectorAll('input[name="Form.AccessScope"]').forEach(radio => {
                radio.addEventListener('change', updateVisibility);
            });

            updateVisibility();

            const folderVisibilityRadios = document.querySelectorAll('input[name="FolderForm.Visibility"]');
            function updateFolderVisibility() {
                if (!folderVisibilityFields) {
                    return;
                }
                const selectedValue = document.querySelector('input[name="FolderForm.Visibility"]:checked')?.value;
                const visibility = parseInt(selectedValue ?? '-1');
                if (visibility === @((int)hOps.web.Models.DocumentFolderVisibility.SelectedProperties)) {
                    folderVisibilityFields.classList.remove('d-none');
                } else {
                    folderVisibilityFields.classList.add('d-none');
                }
            }

            folderVisibilityRadios.forEach(radio => radio.addEventListener('change', updateFolderVisibility));
            updateFolderVisibility();
        })();
    </script>
}
