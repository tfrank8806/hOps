
{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=hOps.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  "EmailSettings": {
    "SMTPHost": "smtp.gmail.com",
    "SMTPPort": 587,
    "SMTPUser": "<DEV_SMTP_USERNAME>",
    "SMTPPass": "<DEV_SMTP_PASSWORD>",
    "FromEmail": "<DEV_SMTP_FROM_EMAIL>",
    "FromName": "hOps Support",
    "UseSSL": true
  },
  "WorkOrders": {
    "DefaultStatus": "New"
  },
  "Captcha": {
    "Enabled": false,
    "SiteKey": "",
    "SecretKey": ""
  }


}
