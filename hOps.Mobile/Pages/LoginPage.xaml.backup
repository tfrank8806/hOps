<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:hOps.Mobile.ViewModels"
             x:Class="hOps.Mobile.Pages.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="Sign In">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="18">
                <Label Text="Welcome back"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Entry Placeholder="Email or username"
                       Text="{Binding UsernameOrEmail}"
                       Keyboard="Email"
                       ClearButtonVisibility="WhileEditing" />

                <Entry Placeholder="Password"
                       Text="{Binding Password}"
                       IsPassword="True"
                       ClearButtonVisibility="WhileEditing" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="Red"
                       IsVisible="{Binding HasError}" />

                <Button Text="Sign In"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"
                        SemanticProperties.Hint="Authenticate with your account" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
