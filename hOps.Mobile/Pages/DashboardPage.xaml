<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:hOps.Mobile.ViewModels"
             xmlns:models="clr-namespace:hOps.Mobile.Models"
             x:Class="hOps.Mobile.Pages.DashboardPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title="Dashboard">

    <ContentPage.Content>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Pass On Logs"
                   FontSize="24"
                   FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Logs}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PassOnLogListItem">
                        <Frame Padding="12" Margin="0,6" CornerRadius="10" HasShadow="True">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding CreatorName}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Preview}" FontSize="13" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Work Orders"
                   FontSize="24"
                   FontAttributes="Bold"
                   Margin="0,24,0,0" />

            <CollectionView ItemsSource="{Binding WorkOrders}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkOrderListItem">
                        <Frame Padding="12" Margin="0,6" CornerRadius="10" HasShadow="True">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Issue}" FontAttributes="Bold" />
                                <Label Text="{Binding Department}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Status}" FontSize="13" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Logout"
                    Command="{Binding LogoutCommand}"
                    Margin="0,24,0,0" />
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>
