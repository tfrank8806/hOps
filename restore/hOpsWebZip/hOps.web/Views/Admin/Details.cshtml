@model hOps.web.Models.UserAccessRequest
@{
    ViewData["Title"] = "Access Request Details";
}

<h2>Request Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.FirstName @Model.LastName</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">Mobile Phone</dt>
        <dd class="col-sm-10">@Model.MobilePhone</dd>
        <dt class="col-sm-2">Property Code</dt>
        <dd class="col-sm-10">@Model.PropertyCode</dd>
        <dt class="col-sm-2">Requested At</dt>
        <dd class="col-sm-10">@Model.RequestedAt.ToLocalTime()</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">
            @if (Model.IsApproved)
            {
                <span class="text-success">Approved</span>
            }
            else if (Model.IsRejected)
            {
                <span class="text-danger">Rejected</span>
            }
            else
            {
                <span class="text-warning">Pending</span>
            }
        </dd>
    </dl>
</div>

<div>
    <form asp-action="Approve" method="post" style="display:inline">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-success">Approve</button>
    </form>
    <form asp-action="Reject" method="post" style="display:inline">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Reject</button>
    </form>
    <a asp-action="AccessRequests" class="btn btn-secondary">Back to List</a>
</div>
