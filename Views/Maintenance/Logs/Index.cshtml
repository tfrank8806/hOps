@model hOps.web.ViewModels.Maintenance.MaintenanceLogsIndexViewModel

@{
    ViewData["Title"] = "Maintenance Logs";
    var message = ViewBag.MaintenanceLogMessage as string;
    var error = ViewBag.MaintenanceLogError as string;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-0">Maintenance Logs</h2>
            <p class="text-muted mb-0">@Model.PropertyName</p>
        </div>
        @if (Model.CanManage)
        {
            <a asp-action="Create" class="btn btn-primary btn-sm">Create Template</a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@message</div>
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (!Model.Templates.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <p class="mb-0 text-muted">No maintenance log templates yet.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Schedule</th>
                            <th>Status</th>
                            <th>Entries</th>
                            <th>Last Entry</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in Model.Templates)
                        {
                            <tr>
                                <td>@template.Name</td>
                                <td>@template.ScheduleSummary</td>
                                <td>
                                    @if (template.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@template.EntryCount</td>
                                <td>@(template.LastEntryDate?.ToString("MMM d, yyyy") ?? "—")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Detail" asp-route-id="@template.Id" class="btn btn-outline-secondary">Open</a>
                                        @if (Model.CanManage)
                                        {
                                            <a asp-action="Edit" asp-route-id="@template.Id" class="btn btn-outline-secondary">Edit</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
